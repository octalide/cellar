# the registry of pattern file formats, and loading and saving through them
#
# a format is a cellar.format.Format record. to add one, write its module under
# cellar/formats, give it a make function, and list it in at(). nothing else
# changes: lookup, detection and the load and save here work on any record.
#
# bytes go in and out, not files, so a file, the clipboard and a drop all read
# and write through the same calls. the destination of a load is a Sink and the
# origin of a save a Source, see cellar.formats.adapt for ones onto patterns and
# the world.

use cellar.format;
use cellar.formats.adapt;
use cellar.formats.custom;
use cellar.formats.life;
use cellar.formats.macrocell;
use cellar.formats.plaintext;
use cellar.formats.rle;
use cellar.hashlife;
use cellar.pattern;
use cellar.rule;
use cellar.sim;
use cellar.space;
use cellar.topology;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# number of formats reachable through at()
pub val COUNT: usize = 5;

# the i-th registered format, for i in [0, COUNT)
pub fun at(i: usize) format.Format {
    if (i == 1) { ret custom.make(); }
    if (i == 2) { ret plaintext.make(); }
    if (i == 3) { ret life.make(); }
    if (i == 4) { ret macrocell.make(); }
    ret rle.make();
}

# find a format by its id
# ---
# id:  the id, compared exactly
# out: receives the record
# ret: whether one has that id
pub fun by_id(id: str, out: *format.Format) bool {
    var i: usize = 0;
    for (i < COUNT) {
        val f: format.Format = at(i);
        if (string.str_equals(f.id, id)) {
            @out = f;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# find the format that owns a file's extension
# ---
# path: a file name or path, whose last '.' starts the extension
# out:  receives the record
# ret:  whether one owns it
pub fun by_path(path: str, out: *format.Format) bool {
    val n:   usize = string.str_len(path);
    var dot: usize = n;
    var i:   usize = 0;
    for (i < n) {
        if (path[i] == '.')                    { dot = i; }
        if (path[i] == '/' || path[i] == '\\') { dot = n; }
        i = i + 1;
    }
    if (dot >= n) { ret false; }
    i = 0;
    for (i < COUNT) {
        var f: format.Format = at(i);
        if (format.has_ext(?f, ?path[dot + 1])) {
            @out = f;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# find the format whose sniff likes the bytes best
# ---
# p:   the bytes
# n:   how many
# out: receives the record
# ret: whether any format recognised them
pub fun by_bytes(p: *u8, n: usize, out: *format.Format) bool {
    var best: u32   = 0;
    var i:    usize = 0;
    for (i < COUNT) {
        val f: format.Format = at(i);
        val s: u32           = f.sniff(p, n);
        if (s > best) {
            best = s;
            @out = f;
        }
        i = i + 1;
    }
    ret best > 0;
}

# check that bytes are a whole valid file of a format, without applying them
# ---
# a:    allocator for the decoder's scratch
# f:    the format
# p:    the bytes
# n:    how many
# info: receives the file's metadata and bounds, with its notes settled
# ret:  ok, or why the bytes were refused
pub fun validate(a: *allo.Allocator, f: *format.Format, p: *u8, n: usize, info: *format.Info) err[format.Error] {
    var e: format.Emit;
    e.sink = nil;
    e.info = info;
    e.fits = false;
    e.tree = nil;
    val r: err[format.Error] = f.decode(a, p, n, ?e);
    if (sel r.err) { ret r; }
    format.settle(info);
    ret err[format.Error].ok{};
}

# decode bytes into a sink, validating the whole input before applying any of it
#
# the decoder runs once with no sink to validate and gather info. only when
# that passes is the sink asked to plan for the info's box and, when it fits,
# offered every run, and only once it has taken them all is it opened and
# given them. so malformed or truncated input, and a pattern the sink judges
# too large, are refused having changed nothing. a sink that neither plans nor
# fits can still refuse a valid pattern part way, for lack of room. a format
# that builds is handed the sink's tree when it offers one, which is opened in
# place of the sink and built in place of the runs, with nothing to fit. a load
# the sink planned is closed either way.
# ---
# a:    allocator for the decoder's scratch
# f:    the format
# p:    the bytes
# n:    how many
# sink: where the cells go
# info: receives the file's metadata and bounds, with its notes settled
# ret:  ok, or why the bytes were refused or not kept
pub fun load(a: *allo.Allocator, f: *format.Format, p: *u8, n: usize, sink: *format.Sink, info: *format.Info) err[format.Error] {
    val ok: err[format.Error] = validate(a, f, p, n, info);
    if (sel ok.err)                                     { ret ok; }
    if (sink.plan != nil && !sink.plan(sink.ctx, info)) { ret err[format.Error].err{format.Error.sink{}}; }
    var tree: *format.TreeSink = nil;
    if (f.builds) { tree = sink.tree; }
    var r: err[format.Error] = err[format.Error].ok{};
    if (sink.fit != nil && tree == nil) { r = pass(a, f, p, n, sink, true, nil); }
    val fits:   bool = sel r.ok;
    var opened: bool = false;
    if (fits && tree == nil) { opened = sink.open(sink.ctx, info); }
    or (fits)                { opened = tree.open(tree.ctx, info); }
    if (fits && !opened)     { r = err[format.Error].err{format.Error.sink{}}; }
    if (opened)              { r = pass(a, f, p, n, sink, false, tree); }
    val kept: bool = sink.close(sink.ctx);
    if (sel r.err) { ret r; }
    if (!kept)     { ret err[format.Error].err{format.Error.sink{}}; }
    ret err[format.Error].ok{};
}

# decode validated bytes into a sink's fit or run, or its tree when tree is
# not nil, gathering a scratch Info
fun pass(a: *allo.Allocator, f: *format.Format, p: *u8, n: usize, sink: *format.Sink, fits: bool, tree: *format.TreeSink) err[format.Error] {
    var again: format.Info;
    format.info_init(?again, a);
    var e: format.Emit;
    e.sink = sink;
    e.info = ?again;
    e.fits = fits;
    e.tree = tree;
    val r: err[format.Error] = f.decode(a, p, n, ?e);
    format.info_dnit(?again);
    ret r;
}

# encode a source to bytes
# ---
# a:    allocator for the encoder's scratch
# f:    the format
# src:  the cells to write
# info: the name, rule and comments to write
# out:  receives the file's bytes, appended
# ret:  ok, or why it could not be written
pub fun save(a: *allo.Allocator, f: *format.Format, src: *format.Source, info: *format.Info, out: *Vector[u8]) err[format.Error] {
    if (f.encode == nil) { ret err[format.Error].err{format.Error.unsupported{}}; }
    ret f.encode(a, src, info, out);
}

# whether two patterns hold the same cells, origin and text
fun same(p: *pattern.Pattern, q: *pattern.Pattern) bool {
    if (p.w != q.w || p.h != q.h || p.x != q.x || p.y != q.y) { ret false; }
    var i: usize = 0;
    for (i < p.w * p.h) {
        if (p.cells[i] != q.cells[i]) { ret false; }
        i = i + 1;
    }
    ret string.str_equals(pattern.rule(p), pattern.rule(q)) && string.str_equals(pattern.name(p), pattern.name(q)) && string.str_equals(pattern.comments(p), pattern.comments(q));
}

# write a pattern out in a format from a HashLife tree of its cells, not its
# runs, read it back, and compare
# ---
# f:    the format
# info: the text to write
# ret:  whether it came back identical
fun from_tree(a: *allo.Allocator, p: *pattern.Pattern, f: *format.Format, info: *format.Info) bool {
    var t: hashlife.Tree;
    hashlife.init(?t, a, hashlife.DEFAULT_MAX);
    if (!hashlife.make(?t)) { ret false; }
    var i: usize = 0;
    for (i < p.w * p.h) {
        if (p.cells[i] != 0) {
            val x:  i64 = p.x + (i % p.w)::i64;
            val y:  i64 = p.y + (i / p.w)::i64;
            val cx: i64 = space.chunk_of(x);
            val cy: i64 = space.chunk_of(y);
            val c:  *u8 = hashlife.chunk(?t, cx, cy, true);
            c[((y - cy * space.SIDE) * space.SIDE + x - cx * space.SIDE)::usize] = p.cells[i];
            hashlife.wrote(?t, cx, cy);
        }
        i = i + 1;
    }
    var ok:   bool           = hashlife.flush(?t);
    var src:  adapt.PatternSource;
    var q:    format.Quadtree;
    var out:  Vector[u8]     = vector.init[u8](a);
    val from: *format.Source = adapt.pattern_source(?src, p);
    from.tree = adapt.quadtree(?q, ?t);
    val w: err[format.Error] = save(a, f, from, info, ?out);
    if (sel w.err) { ok = false; }
    var back: pattern.Pattern;
    val m:    err[allo.Error] = pattern.init(?back, a, 0, 0, "");
    if (sel m.err) { ok = false; }
    var ps:  adapt.PatternSink;
    var got: format.Info;
    format.info_init(?got, a);
    if (ok) {
        val r: err[format.Error] = load(a, f, out.data, out.len, adapt.pattern_sink(?ps, ?back), ?got);
        ok = sel r.ok && same(p, ?back);
    }
    if (!(sel m.err)) { pattern.dnit(?back); }
    format.info_dnit(?got);
    vector.dnit[u8](?out);
    hashlife.dnit(?t);
    ret ok;
}

# write a pattern out in a format, read it back, and compare
# ---
# id:   the format
# wrap: the longest line allowed, 0 for any
# ret:  0 when it came back identical and was recognised as the format, else a step number
fun roundtrip(a: *allo.Allocator, p: *pattern.Pattern, id: str, wrap: usize) u32 {
    var f: format.Format;
    if (!by_id(id, ?f)) { ret 1; }
    var info: format.Info;
    format.info_init(?info, a);
    format.set_str(a, ?info.name, pattern.name(p));
    format.set_str(a, ?info.comments, pattern.comments(p));
    format.set_str(a, ?info.rule, pattern.rule(p));
    var src: adapt.PatternSource;
    var out: Vector[u8]        = vector.init[u8](a);
    val w:   err[format.Error] = save(a, ?f, adapt.pattern_source(?src, p), ?info, ?out);
    if (sel w.err) { ret 2; }

    var line: usize = 0;
    var i:    usize = 0;
    for (i < out.len) {
        if (out.data[i] == '\n')      { line = 0; }
        or                            { line = line + 1; }
        if (wrap != 0 && line > wrap) { ret 3; }
        i = i + 1;
    }
    var g: format.Format;
    if (!by_bytes(out.data, out.len, ?g) || !string.str_equals(g.id, id)) { ret 4; }

    var q: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?q, a, 0, 0, "");
    if (sel m.err) { ret 5; }
    var ps:  adapt.PatternSink;
    var got: format.Info;
    format.info_init(?got, a);
    val r: err[format.Error] = load(a, ?f, out.data, out.len, adapt.pattern_sink(?ps, ?q), ?got);
    if (sel r.err) { ret 6; }
    var ok: u32 = 0;
    if (!same(p, ?q))                                                      { ok = 7; }
    or (got.notes != 0 && got.states <= 2)                                 { ok = 8; }
    or (string.str_equals(id, "macrocell") && !from_tree(a, p, ?f, ?info)) { ok = 9; }
    pattern.dnit(?q);
    format.info_dnit(?got);
    format.info_dnit(?info);
    vector.dnit[u8](?out);
    ret ok;
}

# the gosper gun as RLE, to read and write
val GUN: str = "#N gun\nx = 36, y = 9, rule = B3/S23\n24bo$22bobo$12b2o6b2o12b2o$11bo3bo4b2o12b2o$2o8bo5bo3b2o$2o8bo3bob2o4bobo$10bo5bo7bo$11bo3bo$12b2o!\n";

test save__round_trips_the_gosper_gun {
    var a: allo.Allocator;
    page.make(?a);
    var g: pattern.Pattern;
    val b: err[allo.Error] = pattern.init(?g, ?a, 0, 0, "");
    if (sel b.err) { ret 1; }
    var info: format.Info;
    format.info_init(?info, ?a);
    if (!pattern_takes(?a, "rle", GUN, ?g, ?info)) { ret 2; }
    format.info_dnit(?info);
    if (roundtrip(?a, ?g, "rle", 70) != 0)      { ret 3; }
    if (roundtrip(?a, ?g, "macrocell", 0) != 0) { ret 4; }
    pattern.dnit(?g);
    ret 0;
}

test save__round_trips_a_soup_with_an_origin {
    var a: allo.Allocator;
    page.make(?a);
    var p: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?p, ?a, 97, 61, "soup");
    if (sel m.err) { ret 1; }
    p.x = -40;
    p.y = 12;
    pattern.set_comments(?p, "first\nsecond");
    pattern.set_rule(?p, "B36/S23");
    var seed: u32   = 12345;
    var i:    usize = 0;
    for (i < 97 * 61) {
        seed = seed * 1103515245 + 12345;
        if ((seed >> 16) % 3 == 0) { p.cells[i] = 1; }
        i = i + 1;
    }
    # the corners are live, so the box is the pattern's whole extent
    p.cells[0]           = 1;
    p.cells[97 * 61 - 1] = 1;
    if (roundtrip(?a, ?p, "rle", 70) != 0)      { ret 2; }
    if (roundtrip(?a, ?p, "macrocell", 0) != 0) { ret 3; }
    pattern.dnit(?p);
    ret 0;
}

test save__round_trips_every_state {
    var a: allo.Allocator;
    page.make(?a);
    var p: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?p, ?a, 50, 12, "states");
    if (sel m.err) { ret 1; }
    var i: usize = 0;
    for (i < 50 * 12) {
        p.cells[i] = ((i * 7) % 256)::u8;
        i          = i + 1;
    }
    p.cells[0]           = 255;
    p.cells[50 * 12 - 1] = 24;
    if (roundtrip(?a, ?p, "rle", 70) != 0)      { ret 2; }
    if (roundtrip(?a, ?p, "macrocell", 0) != 0) { ret 3; }
    pattern.dnit(?p);
    ret 0;
}

test rle__reads_a_canonical_file_and_flags_an_unknown_rule {
    var a: allo.Allocator;
    page.make(?a);
    val text: str = "#N seeds\r\n#C one\n#O two\nx = 3, y = 2, rule = B2/S\r\n2o$b2o!\n";
    var f:    format.Format;
    if (!by_id("rle", ?f)) { ret 1; }
    var q: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?q, ?a, 0, 0, "");
    if (sel m.err) { ret 2; }
    var ps:   adapt.PatternSink;
    var info: format.Info;
    format.info_init(?info, ?a);
    val r: err[format.Error] = load(?a, ?f, text::*u8, string.str_len(text), adapt.pattern_sink(?ps, ?q), ?info);
    if (sel r.err)                                                                                                      { ret 3; }
    if (!string.str_equals(format.text_of(?info.rule), "B2/S"))                                                         { ret 5; }
    if (!string.str_equals(pattern.comments(?q), "one\ntwo"))                                                           { ret 6; }
    if (!string.str_equals(pattern.name(?q), "seeds"))                                                                  { ret 7; }
    if (q.w != 3 || q.h != 2 || pattern.get(?q, 1, 0) != 1 || pattern.get(?q, 0, 1) != 0 || pattern.get(?q, 2, 1) != 1) { ret 8; }
    pattern.dnit(?q);
    format.info_dnit(?info);
    ret 0;
}

# load bytes into an empty world and report whether it took them and what it holds
# ---
# id:   the format to read them as
# live: receives the live cells the decode reported
fun world_takes(a: *allo.Allocator, s: *sim.Sim, id: str, p: *u8, n: usize, live: *u64) bool {
    var f: format.Format;
    if (!by_id(id, ?f)) { ret false; }
    var ws:   adapt.WorldSink;
    var info: format.Info;
    format.info_init(?info, a);
    val r: err[format.Error] = load(a, ?f, p, n, adapt.world_sink(?ws, s, 0, 0), ?info);
    @live = info.live;
    format.info_dnit(?info);
    ret !(sel r.err);
}

# load every prefix of a file, and the file with each byte swapped for each junk
# byte, into an empty world. refused input must leave the world empty, and
# accepted input must hold exactly the cells its decode reported, so no run
# overlapped another
# ---
# id:   the format
# text: a valid file, at most 512 bytes
# junk: the bytes to swap in
# ret:  0, or a step number
fun fuzz(a: *allo.Allocator, s: *sim.Sim, id: str, text: str, junk: *u8, jn: usize) u32 {
    val n: usize = string.str_len(text);
    if (n > 512) { ret 1; }
    var live: u64   = 0;
    var buf:  [512]u8;
    var i:    usize = 0;
    for (i <= n) {
        if (world_takes(a, s, id, text::*u8, i, ?live)) {
            if (sim.population(s)::u64 != live) { ret 2; }
            sim.clear(s);
        }
        or (sim.population(s) != 0) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        var k: usize = 0;
        for (k < jn) {
            var j: usize = 0;
            for (j < n) {
                buf[j] = text[j];
                j      = j + 1;
            }
            buf[i] = junk[k];
            if (world_takes(a, s, id, ?buf[0], n, ?live)) {
                if (sim.population(s)::u64 != live) { ret 4; }
                sim.clear(s);
            }
            or (sim.population(s) != 0) { ret 5; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test load__refuses_truncated_and_mangled_rle_without_touching_the_world {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }

    val text: str   = GUN;
    val n:    usize = string.str_len(text);
    var bang: usize = 0;
    for (text[bang] != '!') { bang = bang + 1; }

    # every cut before the terminator is refused
    var live: u64   = 0;
    var cut:  usize = 0;
    for (cut < bang) {
        if (world_takes(?a, ?s, "rle", text::*u8, cut, ?live)) { ret 2; }
        cut = cut + 1;
    }
    val junk: str = "$!oB9#,=x\0z-";
    if (fuzz(?a, ?s, "rle", text, junk::*u8, 12) != 0) { ret 3; }

    # the whole file loads
    if (!world_takes(?a, ?s, "rle", text::*u8, n, ?live)) { ret 5; }
    if (sim.population(?s) != 36)                         { ret 6; }
    sim.dnit(?s);
    ret 0;
}

test load__refuses_mangled_plaintext_life_and_macrocell_without_touching_the_world {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }

    val junk: str   = ".O*!#P-9 \n\0x";
    val jn:   usize = 12;
    if (fuzz(?a, ?s, "plaintext", "!Name: glider\n!by Guy\n.O\n..O\n\nOOO\n", junk::*u8, jn) != 0)                  { ret 2; }
    if (fuzz(?a, ?s, "life", "#Life 1.05\n#D two blocks\n#N\n#P -1 -1\n.*\n..*\n#P 0 0\n**\n", junk::*u8, jn) != 0) { ret 3; }
    if (fuzz(?a, ?s, "life", "#Life 1.06\n#R 23/3\n0 -1\n1 0\n-1 1\n0 1\n1 1\n1 1\n", junk::*u8, jn) != 0)          { ret 4; }
    val mc: str = "[M2] (golly 2.0)\n#R B3/S23\n#C two\n$$..*$...*$.***$\n1 0 3 2 0\n2 2 0 0 0\n3 0 3 0 0\n4 1 4 0 1\n5 0 0 5 0\n";
    if (fuzz(?a, ?s, "macrocell", mc, "0123459*.$#[M \n\0"::*u8, 16) != 0) { ret 5; }
    # and built into the tree from its nodes
    if (!sim.use_hashlife(?s, true))                                       { ret 6; }
    if (fuzz(?a, ?s, "macrocell", mc, "0123459*.$#[M \n\0"::*u8, 16) != 0) { ret 7; }
    sim.dnit(?s);
    ret 0;
}

# load bytes into a pattern through a format
# ---
# id:   the format
# q:    the pattern to fill
# info: receives the file's metadata
# ret:  whether it loaded
fun pattern_takes(a: *allo.Allocator, id: str, text: str, q: *pattern.Pattern, info: *format.Info) bool {
    var f: format.Format;
    if (!by_id(id, ?f)) { ret false; }
    var ps: adapt.PatternSink;
    val r:  err[format.Error] = load(a, ?f, text::*u8, string.str_len(text), adapt.pattern_sink(?ps, q), info);
    ret !(sel r.err);
}

# whether a pattern's rows read as the given '.'/'O' rows, each ended by a newline
fun looks(q: *pattern.Pattern, rows: str) bool {
    var x: usize = 0;
    var y: usize = 0;
    var i: usize = 0;
    for (rows[i] != 0) {
        if (rows[i] == '\n') {
            if (x != q.w) { ret false; }
            x = 0;
            y = y + 1;
        }
        or {
            var v: u8 = 0;
            if (rows[i] == 'O')                                    { v = 1; }
            if (x >= q.w || y >= q.h || pattern.get(q, x, y) != v) { ret false; }
            x = x + 1;
        }
        i = i + 1;
    }
    ret y == q.h;
}

test plaintext__reads_lifewiki_files_and_round_trips {
    var a: allo.Allocator;
    page.make(?a);
    var q: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?q, ?a, 0, 0, "");
    if (sel m.err) { ret 1; }
    var info: format.Info;
    format.info_init(?info, ?a);

    # as LifeWiki serves it, with short rows, CRLF and a dead row between live ones
    val glider: str = "!Name: Glider\r\n!Author: Richard K. Guy\r\n!\r\n!The smallest spaceship.\r\n.O\r\n..O\r\n\r\nOOO\r\n\r\n";
    if (!pattern_takes(?a, "plaintext", glider, ?q, ?info))                                            { ret 2; }
    if (!string.str_equals(pattern.name(?q), "Glider"))                                                { ret 3; }
    if (!string.str_equals(pattern.comments(?q), "Author: Richard K. Guy\n\nThe smallest spaceship.")) { ret 4; }
    if (!looks(?q, ".O.\n..O\n...\nOOO\n"))                                                            { ret 5; }

    format.info_dnit(?info);

    # a '*' reads as live, as Golly reads it
    format.info_init(?info, ?a);
    if (!pattern_takes(?a, "plaintext", "*.*\n", ?q, ?info) || !looks(?q, "O.O\n")) { ret 6; }
    format.info_dnit(?info);
    format.info_init(?info, ?a);
    if (pattern_takes(?a, "plaintext", ".O\nbo$\n", ?q, ?info)) { ret 7; }
    format.info_dnit(?info);

    # a written pattern reads back with its box, name and comments
    q.x = 0;
    q.y = 0;
    pattern.set_rule(?q, "");
    pattern.set_comments(?q, "first\n\nthird");
    if (roundtrip(?a, ?q, "plaintext", 0) != 0) { ret 8; }
    pattern.dnit(?q);
    ret 0;
}

test life__reads_1_05_blocks_and_1_06_cells {
    var a: allo.Allocator;
    page.make(?a);
    var q: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?q, ?a, 0, 0, "");
    if (sel m.err) { ret 1; }

    # Golly's acorn.lif
    var info: format.Info;
    format.info_init(?info, ?a);
    val acorn: str = "#Life 1.05\n#D Acorn\n#D The most vigorously growing 7-cell methuselah pattern.\n#D Found by Charles Corderman.\n#P\n.*\n...*\n**..***\n";
    if (!pattern_takes(?a, "life", acorn, ?q, ?info))                                                                                           { ret 2; }
    if (!looks(?q, ".O.....\n...O...\nOO..OOO\n") || q.x != 0 || q.y != 0)                                                                      { ret 3; }
    if (info.live != 7 || format.text_of(?info.rule)[0] != 0)                                                                                   { ret 4; }
    if (!string.str_equals(pattern.comments(?q), "Acorn\nThe most vigorously growing 7-cell methuselah pattern.\nFound by Charles Corderman.")) { ret 5; }
    format.info_dnit(?info);

    # overlapping blocks placed by #P, and the rule a #R names
    format.info_init(?info, ?a);
    val blocks: str = "#Life 1.05\n#R 23/36\n#P -2 -1\n**.*\n#P 0 -1\n**\n.*\n#P 5 5\n";
    if (!pattern_takes(?a, "life", blocks, ?q, ?info))                   { ret 6; }
    if (!looks(?q, "OOOO\n...O\n") || q.x != -2 || q.y != -1)            { ret 7; }
    if (info.live != 5 || !string.str_equals(pattern.rule(?q), "23/36")) { ret 8; }
    format.info_dnit(?info);

    # a 1.06 glider with a repeated cell, and #N naming Conway's Life
    format.info_init(?info, ?a);
    val cells: str = "#Life 1.06\r\n#N\r\n0 -1\r\n1 0\r\n-1 1\r\n0 1\r\n1 1\r\n1 0\r\n";
    if (!pattern_takes(?a, "life", cells, ?q, ?info))                     { ret 9; }
    if (!looks(?q, ".O.\n..O\nOOO\n") || q.x != -1 || q.y != -1)          { ret 10; }
    if (info.live != 5 || !string.str_equals(pattern.rule(?q), "B3/S23")) { ret 11; }
    format.info_dnit(?info);

    # a missing or mixed-up body is refused
    format.info_init(?info, ?a);
    if (pattern_takes(?a, "life", "#Life 1.07\n0 0\n", ?q, ?info)) { ret 12; }
    if (pattern_takes(?a, "life", "#Life 1.06\n.*\n", ?q, ?info))  { ret 13; }
    if (pattern_takes(?a, "life", "#Life 1.05\n0 0\n", ?q, ?info)) { ret 14; }
    if (pattern_takes(?a, "life", "#Life 1.06\n5\n", ?q, ?info))   { ret 15; }
    format.info_dnit(?info);
    pattern.dnit(?q);
    ret 0;
}

test macrocell__reads_golly_files_in_both_forms {
    var a: allo.Allocator;
    page.make(?a);
    var q: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?q, ?a, 0, 0, "");
    if (sel m.err) { ret 1; }

    # Golly's wolfram22.mc: its seed cell lands on the origin, as Golly places it
    var info: format.Info;
    format.info_init(?info, ?a);
    val seed: str = "[M2] (golly 0.9)\n#R w22\n#C Golly supports Wolfram's 1D rules.\n#C\n$$$$$$$*$\n4 0 1 0 0\n";
    if (!pattern_takes(?a, "macrocell", seed, ?q, ?info))                                         { ret 2; }
    if (!looks(?q, "O\n") || q.x != 0 || q.y != 0 || !string.str_equals(pattern.rule(?q), "w22")) { ret 3; }
    if (!string.str_equals(pattern.comments(?q), "Golly supports Wolfram's 1D rules.\n"))         { ret 4; }
    format.info_dnit(?info);

    # the multi-state form keeps its states
    format.info_init(?info, ?a);
    if (!pattern_takes(?a, "macrocell", "[M2] (golly 3.0)\n1 0 2 3 0\n2 1 0 0 0\n", ?q, ?info)) { ret 5; }
    if (q.x != -2 || q.y != -1 || q.w != 2 || q.h != 2 || info.states != 4)                     { ret 6; }
    if (pattern.get(?q, 1, 0) != 2 || pattern.get(?q, 0, 0) != 0 || pattern.get(?q, 0, 1) != 3) { ret 7; }
    format.info_dnit(?info);

    # a full leaf shared four times is a solid square, and blank lines are skipped
    format.info_init(?info, ?a);
    val full: str = "[M2]\n\n********$********$********$********$********$********$********$********$\n4 1 1 1 1\n";
    if (!pattern_takes(?a, "macrocell", full, ?q, ?info))                     { ret 8; }
    if (info.live != 256 || q.x != -8 || q.y != -7 || q.w != 16 || q.h != 16) { ret 9; }
    format.info_dnit(?info);

    # a missing header, a child out of range or of the wrong level, a state
    # past 255, a cell past a leaf's edge, and a level past MAX_LEVEL are refused
    format.info_init(?info, ?a);
    if (pattern_takes(?a, "macrocell", "$*$\n4 1 0 0 0\n", ?q, ?info))       { ret 10; }
    if (pattern_takes(?a, "macrocell", "[M2]\n$*$\n4 2 0 0 0\n", ?q, ?info)) { ret 11; }
    if (pattern_takes(?a, "macrocell", "[M2]\n$*$\n5 1 0 0 0\n", ?q, ?info)) { ret 12; }
    if (pattern_takes(?a, "macrocell", "[M2]\n1 256 0 0 0\n", ?q, ?info))    { ret 13; }
    if (pattern_takes(?a, "macrocell", "[M2]\n.........*$\n", ?q, ?info))    { ret 14; }
    if (pattern_takes(?a, "macrocell", "[M2]\n63 0 0 0 0\n", ?q, ?info))     { ret 15; }
    if (pattern_takes(?a, "macrocell", "[M2]\n4 0 0 0\n", ?q, ?info))        { ret 16; }
    format.info_dnit(?info);
    pattern.dnit(?q);
    ret 0;
}

test macrocell__writes_each_distinct_square_once {
    var a: allo.Allocator;
    page.make(?a);
    # a glider in each 8 by 8 square of a 64 by 64 pattern, placed so the
    # squares are the leaves of the root Golly would use
    var p: pattern.Pattern;
    val m: err[allo.Error] = pattern.init(?p, ?a, 64, 64, "gliders");
    if (sel m.err) { ret 1; }
    p.y = 1;
    var i: usize = 0;
    for (i < 64) {
        val x: usize = (i % 8) * 8;
        val y: usize = (i / 8) * 8;
        pattern.set(?p, x + 1, y, 1);
        pattern.set(?p, x + 2, y + 1, 1);
        pattern.set(?p, x, y + 2, 1);
        pattern.set(?p, x + 1, y + 2, 1);
        pattern.set(?p, x + 2, y + 2, 1);
        i = i + 1;
    }
    pattern.set(?p, 63, 63, 1);
    pattern.set(?p, 7, 7, 1);
    if (roundtrip(?a, ?p, "macrocell", 0) != 0) { ret 2; }

    # the two corner cells lie at the same spot of their leaves, so there are
    # two distinct leaves, three nodes at each of levels 4 and 5, one at 6 and
    # the root
    var f: format.Format;
    if (!by_id("macrocell", ?f)) { ret 3; }
    var info: format.Info;
    format.info_init(?info, ?a);
    var src: adapt.PatternSource;
    var out: Vector[u8]        = vector.init[u8](?a);
    val w:   err[format.Error] = save(?a, ?f, adapt.pattern_source(?src, ?p), ?info, ?out);
    if (sel w.err) { ret 4; }
    var nodes: usize = 0;
    i = 0;
    for (i < out.len) {
        if ((i == 0 || out.data[i - 1] == '\n') && out.data[i] != '[' && out.data[i] != '#') { nodes = nodes + 1; }
        i = i + 1;
    }
    if (nodes != 2 + 3 + 3 + 1 + 1) { ret 5; }
    vector.dnit[u8](?out);
    format.info_dnit(?info);
    pattern.dnit(?p);
    ret 0;
}

test load__judges_a_giant_macrocell_by_its_nodes {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }
    # a few hundred bytes for a solid square 2^20 on a side, 2^40 live cells
    val text: str = "[M2]\n********$********$********$********$********$********$********$********$\n4 1 1 1 1\n5 2 2 2 2\n6 3 3 3 3\n7 4 4 4 4\n8 5 5 5 5\n9 6 6 6 6\n10 7 7 7 7\n11 8 8 8 8\n12 9 9 9 9\n13 10 10 10 10\n14 11 11 11 11\n15 12 12 12 12\n16 13 13 13 13\n17 14 14 14 14\n18 15 15 15 15\n19 16 16 16 16\n20 17 17 17 17\n";
    var f:    format.Format;
    if (!by_id("macrocell", ?f)) { ret 2; }

    # validating reads the root's sums and lists no cell
    var info: format.Info;
    format.info_init(?info, ?a);
    val side: i64               = 1048576;
    val v:    err[format.Error] = validate(?a, ?f, text::*u8, string.str_len(text), ?info);
    if (sel v.err || info.live != format.LIMIT::u64 || info.states != 2)                                      { ret 3; }
    if (info.x0 != 0 - side / 2 || info.y0 != 1 - side / 2 || info.x1 != side / 2 || info.y1 != side / 2 + 1) { ret 4; }
    format.info_dnit(?info);

    # a pattern past its cell budget is refused before anything is allocated
    var q:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?q, ?a, 0, 0, "");
    if (sel made.err) { ret 5; }
    format.info_init(?info, ?a);
    if (pattern_takes(?a, "macrocell", text, ?q, ?info) || q.cells != nil || q.w != 0) { ret 6; }
    format.info_dnit(?info);
    pattern.dnit(?q);

    # and the world refuses it as it fits the first rows, untouched
    var live: u64 = 0;
    if (world_takes(?a, ?s, "macrocell", text::*u8, string.str_len(text), ?live)) { ret 7; }
    if (sim.population(?s) != 0 || s.full || s.space.live != 0)                   { ret 8; }
    # where the tree is built from the nodes, whatever the cells number
    if (!sim.use_hashlife(?s, true))                                                             { ret 9; }
    if (!world_takes(?a, ?s, "macrocell", text::*u8, string.str_len(text), ?live))               { ret 10; }
    if (sim.population(?s)::u64 != format.LIMIT::u64 || s.full)                                  { ret 11; }
    if (!sim.alive(?s, 0 - side / 2, 1 - side / 2) || sim.alive(?s, 0 - side / 2, 0 - side / 2)) { ret 12; }
    sim.dnit(?s);
    ret 0;
}

# a source over a fixed list of runs, for patterns no heap pattern could hold
# ---
# runs:   the runs, in the order a Source gives them
# n:      how many
# i:      the next one
# source: the source to hand to formats.save
rec RunSource {
    runs:   *format.Run;
    n:      usize;
    i:      usize;
    source: format.Source;
}

fun runs_rewind(ctx: *u8) err[format.Error] {
    val s: *RunSource = ctx::*RunSource;
    s.i = 0;
    ret err[format.Error].ok{};
}

fun runs_next(ctx: *u8, r: *format.Run) bool {
    val s: *RunSource = ctx::*RunSource;
    if (s.i >= s.n) { ret false; }
    @r  = s.runs[s.i];
    s.i = s.i + 1;
    ret true;
}

# write runs as a macrocell file into out
fun write_runs(a: *allo.Allocator, runs: *format.Run, n: usize, out: *Vector[u8]) bool {
    var rs: RunSource;
    rs.runs = runs;
    rs.n    = n;
    rs.i    = 0;
    val at: *RunSource = ?rs;
    rs.source.ctx    = at::*u8;
    rs.source.x0     = 0 - format.LIMIT;
    rs.source.y0     = 0 - format.LIMIT;
    rs.source.x1     = format.LIMIT;
    rs.source.y1     = format.LIMIT;
    rs.source.states = 2;
    rs.source.tree   = nil;
    rs.source.rewind = runs_rewind;
    rs.source.next   = runs_next;
    var f: format.Format;
    if (!by_id("macrocell", ?f)) { ret false; }
    var info: format.Info;
    format.info_init(?info, a);
    val w: err[format.Error] = save(a, ?f, ?rs.source, ?info, out);
    format.info_dnit(?info);
    ret !(sel w.err);
}

test load__takes_a_sparse_giant_and_refuses_what_the_world_cannot_hold {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }

    # two gliders' worth of cells 2^34 apart: far past any pattern buffer, a
    # handful of chunks in the world
    val far:  i64 = 17179869184;
    var runs: [3]format.Run;
    runs[0] = format.Run{x: -5, y: 0 - far, n: 3, v: 1};
    runs[1] = format.Run{x: far, y: 7, n: 1, v: 1};
    runs[2] = format.Run{x: far - 1, y: far, n: 2, v: 1};
    var out: Vector[u8] = vector.init[u8](?a);
    if (!write_runs(?a, ?runs[0], 3, ?out)) { ret 2; }
    var live: u64 = 0;
    if (!world_takes(?a, ?s, "macrocell", out.data, out.len, ?live))                       { ret 3; }
    if (live != 6 || sim.population(?s) != 6 || s.full)                                    { ret 4; }
    if (!sim.alive(?s, -4, 0 - far) || !sim.alive(?s, far, 7) || !sim.alive(?s, far, far)) { ret 5; }

    # a pool with room for two of the three clusters refuses the lot, leaving the world as it was
    sim.clear(?s);
    s.space.max_slots = s.space.live + 18;
    if (world_takes(?a, ?s, "macrocell", out.data, out.len, ?live)) { ret 6; }
    if (sim.population(?s) != 0 || s.full)                          { ret 7; }
    s.space.max_slots = space.HOST_SLOTS;

    # a cell past the world's reach is refused whole too
    vector.clear[u8](?out);
    runs[0] = format.Run{x: 0, y: 0, n: 1, v: 1};
    runs[1] = format.Run{x: space.REACH, y: 0, n: 1, v: 1};
    if (!write_runs(?a, ?runs[0], 2, ?out))                         { ret 8; }
    if (world_takes(?a, ?s, "macrocell", out.data, out.len, ?live)) { ret 9; }
    if (sim.population(?s) != 0 || s.full)                          { ret 10; }
    vector.dnit[u8](?out);
    sim.dnit(?s);
    ret 0;
}

# load a Macrocell file shifted by (dx, dy) into a world on the tree, built
# from its nodes or, with runs, cell by cell, and write the world back out
# ---
# runs: take the runs rather than the tree
# out:  receives the world as Macrocell
fun tree_load(a: *allo.Allocator, text: str, dx: i64, dy: i64, runs: bool, out: *Vector[u8]) bool {
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, a);
    if (sel m.err) { ret false; }
    var f:    format.Format;
    var ok:   bool = by_id("macrocell", ?f) && sim.use_hashlife(?s, true);
    var ws:   adapt.WorldSink;
    var info: format.Info;
    format.info_init(?info, a);
    val k: *format.Sink = adapt.world_sink(?ws, ?s, dx, dy);
    if (runs) { k.tree = nil; }
    if (ok) {
        val r: err[format.Error] = load(a, ?f, text::*u8, string.str_len(text), k, ?info);
        ok = sel r.ok && sim.population(?s)::u64 == info.live && !s.full;
    }
    format.info_dnit(?info);
    var src: adapt.WorldSource;
    var got: format.Info;
    format.info_init(?got, a);
    val w: res[*format.Source, format.Error] = adapt.world_source(?src, ?s, a);
    if (sel w.err) { ok = false; }
    if (sel w.ok) {
        if (ok) {
            val e: err[format.Error] = save(a, ?f, w.ok, ?got, out);
            ok = sel e.ok;
        }
    }
    adapt.world_source_dnit(?src);
    format.info_dnit(?got);
    sim.dnit(?s);
    ret ok;
}

test load__a_macrocell_built_into_the_tree_holds_the_cells_its_runs_would {
    var a: allo.Allocator;
    page.make(?a);
    # a sparse spread wide enough that the tree's squares straddle the file's
    val far:  i64 = 1000;
    var runs: [5]format.Run;
    runs[0] = format.Run{x: -40, y: -70, n: 3, v: 1};
    runs[1] = format.Run{x: -38, y: -69, n: 1, v: 1};
    runs[2] = format.Run{x: 5, y: 0, n: 20, v: 1};
    runs[3] = format.Run{x: far, y: 3, n: 1, v: 1};
    runs[4] = format.Run{x: -far, y: far, n: 2, v: 1};
    var sparse: Vector[u8] = vector.init[u8](?a);
    if (!write_runs(?a, ?runs[0], 5, ?sparse)) { ret 1; }
    val nul: res[usize, allo.Error] = vector.push[u8](?sparse, 0);
    if (sel nul.err) { ret 1; }
    var texts: [4]str;
    texts[0] = "[M2] (golly 2.0)\n#R B3/S23\n#C two\n$$..*$...*$.***$\n1 0 3 2 0\n2 2 0 0 0\n3 0 3 0 0\n4 1 4 0 1\n5 0 0 5 0\n";
    texts[1] = "[M2] (golly 3.0)\n1 0 2 3 0\n2 1 0 0 0\n";
    texts[2] = "[M2]\n**$**$\n4 1 0 0 0\n5 2 0 0 2\n6 0 3 3 0\n";
    texts[3] = sparse.data::str;
    # shifts on and off the file's grid, a row, a column and odd ones
    var dx: [6]i64 = [6]i64{0, 0, 1, -37, 5, 64};
    var dy: [6]i64 = [6]i64{0, -1, 0, 91, 3, -64};
    var t:  usize  = 0;
    for (t < 4) {
        var k: usize = 0;
        for (k < 6) {
            var built: Vector[u8] = vector.init[u8](?a);
            var cells: Vector[u8] = vector.init[u8](?a);
            if (!tree_load(?a, texts[t], dx[k], dy[k], false, ?built))                                         { ret 2; }
            if (!tree_load(?a, texts[t], dx[k], dy[k], true, ?cells))                                          { ret 3; }
            if (built.len == 0 || built.len != cells.len || !mem.equal[u8](built.data, cells.data, built.len)) { ret 4; }
            vector.dnit[u8](?built);
            vector.dnit[u8](?cells);
            k = k + 1;
        }
        t = t + 1;
    }
    vector.dnit[u8](?sparse);
    ret 0;
}

# load a Macrocell file into a world, with the rule it names, on the tree or the pool
# ---
# tree: the world is on the tree, where the file is built from its nodes
# ret:  whether it loaded, on the engine asked, with the file's rule
fun rule_load(a: *allo.Allocator, s: *sim.Sim, text: str, r: rule.Rule, tree: bool) bool {
    if (!sim.use_hashlife(s, tree)) { ret false; }
    var f: format.Format;
    if (!by_id("macrocell", ?f)) { ret false; }
    var ws:   adapt.WorldSink;
    var info: format.Info;
    format.info_init(?info, a);
    val k: *format.Sink = adapt.world_sink(?ws, s, 0, 0);
    adapt.sink_rule(?ws, r);
    val built: bool              = k.tree != nil;
    val got:   err[format.Error] = load(a, ?f, text::*u8, string.str_len(text), k, ?info);
    format.info_dnit(?info);
    ret sel got.ok && !ws.refused && built == tree && sim.on_tree(s) == tree;
}

test load__a_multi_state_macrocell_builds_into_hashlife_and_runs_as_on_the_pool {
    var a: allo.Allocator;
    page.make(?a);
    # Brian's Brain squares of live and dying cells, as Golly writes them for a
    # generations rule: 2 by 2 nodes of states
    val text: str                 = "[M2] (golly 4.0)\n#R /2/3\n1 1 2 0 0\n1 0 0 2 1\n2 1 2 0 1\n3 3 0 0 3\n";
    val bb:   res[rule.Rule, str] = rule.parse("B2/S/C3");
    if (sel bb.err) { ret 1; }
    var t:  sim.Sim;
    var p:  sim.Sim;
    val m1: err[allo.Error] = sim.init(?t, ?a);
    if (sel m1.err) { ret 1; }
    val m2: err[allo.Error] = sim.init(?p, ?a);
    if (sel m2.err)                             { ret 1; }
    if (!rule_load(?a, ?t, text, bb.ok, true))  { ret 2; }
    if (!rule_load(?a, ?p, text, bb.ok, false)) { ret 3; }
    # the root's corner is Golly's, (-4, -3): six live cells and six dying
    if (rule.state(?t.rule, sim.cell(?t, -4, -3)) != 1 || rule.state(?t.rule, sim.cell(?t, -3, -3)) != 2) { ret 4; }
    if (rule.state(?t.rule, sim.cell(?t, 3, 3)) != 2 || sim.population(?t) != 6)                          { ret 5; }
    if (!sim.same_as_tree(?p, ?t))                                                                        { ret 6; }
    var g: usize = 0;
    for (g < 64) {
        sim.step(?p);
        g = g + 1;
    }
    if (!sim.jump(?t, 64) || !sim.same_as_tree(?p, ?t)) { ret 7; }
    sim.dnit(?t);
    sim.dnit(?p);
    ret 0;
}

# the id of the format the bytes sniff as, or "" when none
fun sniffs(text: str) str {
    var f: format.Format;
    if (!by_bytes(text::*u8, string.str_len(text), ?f)) { ret ""; }
    ret f.id;
}

# an allocator that refuses any request past max bytes, over another
# ---
# base: the allocator it hands the rest to
# max:  the largest request it takes
rec Capped {
    base: *allo.Allocator;
    max:  usize;
}

fun capped_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val c: *Capped = ctx::*Capped;
    if (size > c.max) { ret opt[ptr].none{}; }
    ret c.base.fn_allocate(c.base.ctx, size, align);
}

fun capped_reallocate(ctx: ptr, p: ptr, old: usize, size: usize, align: usize) opt[ptr] {
    val c: *Capped = ctx::*Capped;
    if (size > c.max) { ret opt[ptr].none{}; }
    ret c.base.fn_reallocate(c.base.ctx, p, old, size, align);
}

fun capped_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val c: *Capped = ctx::*Capped;
    ret c.base.fn_deallocate(c.base.ctx, p, size, align);
}

# save the world as RLE, reading it through an allocator
fun save_world(a: *allo.Allocator, s: *sim.Sim, reads: *allo.Allocator, out: *Vector[u8]) err[format.Error] {
    var f: format.Format;
    if (!by_id("rle", ?f)) { ret err[format.Error].err{format.Error.unsupported{}}; }
    var info: format.Info;
    format.info_init(?info, a);
    var ws:  adapt.WorldSource;
    var r:   err[format.Error]                 = err[format.Error].ok{};
    val src: res[*format.Source, format.Error] = adapt.world_source(?ws, s, reads);
    if (sel src.err) { r = err[format.Error].err{src.err}; }
    if (sel src.ok)  { r = save(a, ?f, src.ok, ?info, out); }
    adapt.world_source_dnit(?ws);
    format.info_dnit(?info);
    ret r;
}

test save__fails_rather_than_write_a_world_short_without_the_memory_to_read_it {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }
    # a line across 20 chunks, whose row of chunks takes 80 KiB to read
    val text: str = "x = 1280, y = 1, rule = B3/S23\n1280o!\n";
    var live: u64 = 0;
    if (!world_takes(?a, ?s, "rle", text::*u8, string.str_len(text), ?live) || live != 1280) { ret 2; }
    var out: Vector[u8]        = vector.init[u8](?a);
    val all: err[format.Error] = save_world(?a, ?s, ?a, ?out);
    if (sel all.err || out.len == 0) { ret 3; }
    vector.clear[u8](?out);
    var cap:   Capped            = Capped{base: ?a, max: 32768};
    var few:   allo.Allocator    = allo.Allocator{ctx: (?cap)::ptr, fn_allocate: capped_allocate, fn_reallocate: capped_reallocate, fn_deallocate: capped_deallocate, retains: false};
    val short: err[format.Error] = save_world(?a, ?s, ?few, ?out);
    if (!(sel short.err))                        { ret 4; }
    if (sel short.err && !(sel short.err.alloc)) { ret 5; }
    vector.dnit[u8](?out);
    sim.dnit(?s);
    ret 0;
}

# a world under a strobing B0 rule on a bounded grid, stepped gens times
fun strobing(a: *allo.Allocator, s: *sim.Sim, text: str, soup: bool, gens: usize) bool {
    val m: err[allo.Error] = sim.init(s, a);
    if (sel m.err) { ret false; }
    val parsed: res[rule.Rule, str] = rule.parse(text);
    if (sel parsed.err) { ret false; }
    sim.set_rule(s, parsed.ok);
    if (soup) { sim.randomize(s, 0.3, 10); }
    var i: usize = 0;
    for (i < gens) {
        sim.step(s);
        i = i + 1;
    }
    ret true;
}

# the world as a file, loaded as a fresh world at generation 0 under the same rule
fun reloaded(a: *allo.Allocator, s: *sim.Sim, t: *sim.Sim, text: str) bool {
    var out:   Vector[u8]        = vector.init[u8](a);
    val saved: err[format.Error] = save_world(a, s, a, ?out);
    if (sel saved.err) { ret false; }
    var live: u64  = 0;
    val ok:   bool = strobing(a, t, text, false, 0) && world_takes(a, t, "rle", out.data, out.len, ?live);
    vector.dnit[u8](?out);
    ret ok && live::usize == sim.population(s);
}

# whether two worlds agree on every cell of the grid and a margin around it
fun same_cells(s: *sim.Sim, t: *sim.Sim) bool {
    var y: i64 = -7;
    for (y < 7) {
        var x: i64 = -7;
        for (x < 7) {
            if (sim.alive(s, x, y) != sim.alive(t, x, y)) { ret false; }
            x = x + 1;
        }
        y = y + 1;
    }
    ret true;
}

test save__a_finite_grid_reads_its_true_cells_at_an_odd_generation {
    var a: allo.Allocator;
    page.make(?a);
    var g: usize = 0;
    for (g < 2) {
        var text: str = "B03/S23:P10,10";
        if (g == 1) { text = "B03/S23:T10,10"; }
        var s: sim.Sim;
        if (!strobing(?a, ?s, text, false, 1) || !sim.flipped(?s)) { ret 1; }
        # the empty world's every cell is born, and none lies off the grid
        if (sim.population(?s) != 100 || !sim.alive(?s, -5, -5) || !sim.alive(?s, 4, 4)) { ret 2; }
        if (sim.alive(?s, 5, 0) || sim.alive(?s, 0, -6))                                 { ret 3; }
        val b: opt[space.Box] = sim.bounds(?s);
        if (!(sel b.some))                                                          { ret 4; }
        if (b.some.x0 != -5 || b.some.y0 != -5 || b.some.x1 != 5 || b.some.y1 != 5) { ret 4; }
        var row: [14]u8;
        if (!sim.read_begin(?s, -7, 0, 7, 1) || !sim.read_run(?s, -7, 0, 14, ?row[0]) || !sim.read_end(?s)) { ret 5; }
        var k: usize = 0;
        for (k < 14) {
            var on: u8 = 0;
            if (k >= 2 && k < 12) { on = 1; }
            if (row[k] != on)     { ret 6; }
            k = k + 1;
        }
        var t: sim.Sim;
        if (!reloaded(?a, ?s, ?t, text) || sim.population(?t) != 100 || t.generation != 0) { ret 7; }
        sim.step(?s);
        if (sim.flipped(?s) || sim.population(?s) != (4 - 4 * g::usize)) { ret 8; }
        sim.dnit(?t);
        sim.dnit(?s);
        g = g + 1;
    }
    ret 0;
}

test save__a_soup_saved_at_an_odd_generation_steps_on_as_the_world_does {
    var a: allo.Allocator;
    page.make(?a);
    var g: usize = 0;
    for (g < 3) {
        var text: str = "B03/S23:P10,10";
        if (g == 1) { text = "B03/S23:T10,10"; }
        if (g == 2) { text = "B0124-k/S1c25:P10,10"; }
        var s: sim.Sim;
        if (!strobing(?a, ?s, text, true, 1) || !sim.flipped(?s)) { ret 1; }
        var t: sim.Sim;
        if (!reloaded(?a, ?s, ?t, text) || !same_cells(?s, ?t)) { ret 2; }
        sim.step(?s);
        sim.step(?t);
        if (!same_cells(?s, ?t) || sim.population(?s) != sim.population(?t)) { ret 3; }
        sim.dnit(?t);
        sim.dnit(?s);
        g = g + 1;
    }
    ret 0;
}

test registry__finds_formats_by_id_extension_and_content {
    var f: format.Format;
    if (!by_id("rle", ?f) || by_id("nope", ?f))                               { ret 1; }
    if (!by_path("dir.d/gun.RLE", ?f) || by_path("gun", ?f))                  { ret 2; }
    if (by_path("dir.rle/gun", ?f) || by_path("w.cellar", ?f))                { ret 3; }
    if (!by_path("g.cells", ?f) || !string.str_equals(f.id, "plaintext"))     { ret 4; }
    if (!by_path("g.lif", ?f) || !string.str_equals(f.id, "life"))            { ret 5; }
    if (!by_path("g.life", ?f) || !string.str_equals(f.id, "life"))           { ret 6; }
    if (!by_path("g.MC", ?f) || !string.str_equals(f.id, "macrocell"))        { ret 16; }
    if (!string.str_equals(sniffs("\n[M2] (golly 2.0)\n$*$\n"), "macrocell")) { ret 17; }

    if (!string.str_equals(sniffs("#C x\nX = 1, y = 1\no!"), "rle"))     { ret 7; }
    if (!string.str_equals(sniffs("!Name: glider\n.O.\n"), "plaintext")) { ret 8; }
    if (!string.str_equals(sniffs("!made by hand\n.O.\n"), "plaintext")) { ret 9; }
    if (!string.str_equals(sniffs("\n.O.\n..O\nOOO\n"), "plaintext"))    { ret 10; }
    if (!string.str_equals(sniffs("#Life 1.05\n#P 0 0\n.*\n"), "life"))  { ret 11; }
    if (!string.str_equals(sniffs("#Life 1.06\n0 0\n"), "life"))         { ret 12; }
    if (!string.str_equals(sniffs("3 1\n101\n"), "custom"))              { ret 13; }
    if (!string.str_equals(sniffs("#N x\nbo$obo!"), ""))                 { ret 14; }
    if (!string.str_equals(sniffs("hello"), ""))                         { ret 15; }
    ret 0;
}

test load__a_macrocell_past_the_pool_loads_into_hashlife_and_runs {
    var a: allo.Allocator;
    page.make(?a);
    var s: sim.Sim;
    val m: err[allo.Error] = sim.init(?s, ?a);
    if (sel m.err) { ret 1; }
    # a block alone in each 128 by 128 square of one 2^15 on a side: 65536
    # blocks, each in a chunk of its own, and the pool holds 32768 chunks
    val text: str   = "[M2]\n#R B3/S23\n**$**$\n4 1 0 0 0\n5 2 0 0 0\n6 3 0 0 0\n7 4 0 0 0\n8 5 5 5 5\n9 6 6 6 6\n10 7 7 7 7\n11 8 8 8 8\n12 9 9 9 9\n13 10 10 10 10\n14 11 11 11 11\n15 12 12 12 12\n";
    val n:    usize = string.str_len(text);
    var live: u64   = 0;
    if (world_takes(?a, ?s, "macrocell", text::*u8, n, ?live)) { ret 2; }
    if (sim.population(?s) != 0 || s.full)                     { ret 3; }

    if (!sim.use_hashlife(?s, true))                              { ret 4; }
    if (!world_takes(?a, ?s, "macrocell", text::*u8, n, ?live))   { ret 5; }
    if (live != 262144 || sim.population(?s) != 262144 || s.full) { ret 6; }
    # the root's corner is Golly's, (-2^14, 1 - 2^14), and each block its square's corner
    if (!sim.alive(?s, -16384, -16383) || !sim.alive(?s, -16383, -16382))          { ret 7; }
    if (sim.alive(?s, -16382, -16383) || !sim.alive(?s, 16384 - 128, 16385 - 128)) { ret 8; }
    # blocks stand still, however far it runs
    if (!sim.jump(?s, 1000000) || sim.population(?s) != 262144) { ret 9; }
    if (!sim.alive(?s, -16384, -16383))                         { ret 10; }
    sim.dnit(?s);
    ret 0;
}
