# the unbounded world as a pool of 64 by 64 chunks with a page table
#
# only chunks that hold something, or border a chunk with a live cell, exist.
# each lives in a slot of the pool, and the slot's page-table entry names the
# slots of the 3 by 3 block of chunks around it, so a step reads a chunk's
# neighbourhood without a lookup. the entry's layout is the one the GPU's
# stages read, so the table uploads as it stands:
#
#   words 0..9  the neighbour slots, row-major with the chunk itself at 4,
#               NONE where that chunk does not exist
#   words 9, 10 the chunk's coordinates biased by BIAS, so they stay positive
#   word 11     the slot's incarnation, zero while it is free
#   words 12..21 a link word per neighbour slot, and the edge word
#
# on the unbounded plane the neighbours are the chunks around it and every
# link a move of one chunk. on a bounded grid (cellar.topology) a chunk off the
# grid never exists, the links of a chunk at the grid's edge reach across its
# seams, and the halo a live chunk asks for lands where the seams take it (see
# cellar.layout for how a step reads through them).
#
# a chunk's cells are stored in layers (cellar.layer), the set the running
# rule declares and any the view keeps, each holding every slot's span at its
# width. the pool reads a cell's state through the family's sense
# (cellar.layout.Sense), and everything outside it reads and writes cells
# through the planes and exact values below, never knowing a cell's width.
# each layer's front cells are the world; its back cells, kept only when the
# CPU steps, take the next generation. a hash over chunk coordinates finds a
# chunk's slot.
#
# settle keeps the pool the shape stepping needs: every chunk with a live cell
# has the chunks its census mask asks for, and a chunk that is empty, cold and
# asked for by no live chunk, nor on a rim the pool keeps, is freed. the mask
# has a bit per chunk of the 5 by 5 block around a chunk (see halo), so a live
# chunk can keep chunks two away, and a sparse world keeps only the chunks it
# can spread into before the next census. it works from a census, per slot the
# live count, whether anything is warm, the incarnation the count was taken
# of, the mask, and the extent of the live cells. the CPU writes one as it
# steps, asking for the adjacent chunks, since it settles every generation;
# the GPU's is read back once a frame and asks for the ring or the wide halo,
# whichever its budget runs within, and a chunk counted on the host asks for
# the same. on the unbounded plane the GPU settles its pool itself instead,
# and the pool here mirrors it (see Mirror and adopt).
#
# a grid bounded both ways whose chunks fit the pool's ceiling is held whole
# instead (cover): every chunk on it is allocated and linked when the pool takes
# the grid or is emptied, and stays, so settling neither surrounds nor frees
# anything and no census need make room before a step. its census still counts
# the live cells, and its empty chunks stay allocated.

use cellar.layer;
use cellar.layer.plane;
use cellar.layout;
use cellar.topology;
use allo: std.allocator;
use std.allocator.page;
use std.math.bits;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# side of a chunk in cells
pub val SIDE: i64 = layout.SIDE::i64;
# cells in a chunk
pub val CELLS: usize = layout.CELLS::usize;
# texels of a chunk's coverage pyramid
pub val MIP: usize = layout.MIP::usize;
# page-table words per slot
pub val ENTRY: usize = layout.ENTRY::usize;
# census words per slot: live count, warm, incarnation, halo mask, extent
pub val CENSUS: usize = 5;
# a halo mask asking for the eight adjacent chunks
pub val MASK_RING: u32 = 0x729c0;
# a halo mask asking for every chunk up to two away, the widest halo
pub val MASK_HALO: u32 = 0x1ffefff;
# a live chunk's halo, the chunks around it its live cells may spread into
# before the next census settles the pool (cellar.layout.halo)
pub val HALO_SIDE: u32 = layout.HALO_SIDE;
pub val HALO_SELF: u32 = layout.HALO_SELF;
# cells of spread the narrowest ring holds: an adjacent chunk is asked for when
# a live cell lies in the half of its chunk toward it, so a chunk left out is
# more than half a chunk away
pub val SPREAD_RING: u32 = layout.SIDE / 2;
# cells of spread the wide halo of a rule reaching no further than the
# narrowest ring holds: the adjacent chunks always, and the second chunk on a
# side when a live cell lies in the half toward it, so a chunk left out is more
# than a chunk and a half away
pub val SPREAD_WIDE: u32 = 96;

# cells of spread the ring of a rule reaching reach cells a generation holds,
# so one generation never outruns it: the narrowest ring, or reach rounded up
# to half a chunk, which at the farthest reach is every adjacent chunk
pub fun ring(reach: usize) u32 {
    val half: usize = SPREAD_RING::usize;
    var r:    usize = (reach + half - 1) / half * half;
    if (r < half) { r = half; }
    ret r::u32;
}

# cells of spread the halo of a rule reaching reach cells holds: its ring, or
# while wide a chunk more, up to every chunk two away
pub fun halo_span(reach: usize, wide: bool) u32 {
    var s: u32 = ring(reach);
    if (wide)                  { s = s + layout.SIDE; }
    if (s > layout.SPREAD_MAX) { s = layout.SPREAD_MAX; }
    ret s;
}

# the halo mask for live cells in the quadrants of a chunk quads names
# (cellar.layout.quadrant), holding span cells of spread
pub fun halo(quads: u32, span: u32) u32 {
    ret layout.halo(quads, span);
}

# the halo mask for the live cells an extent word describes
pub fun halo_of(ext: u32, span: u32) u32 {
    ret layout.halo(ext >> layout.EXTENT_QUADS, span);
}

# a neighbour that does not exist
pub val NONE: u32 = layout.NONE;
# added to chunk coordinates in the page table
pub val BIAS: i64 = 1073741824;
# the world's cells lie in [-REACH, REACH) on both axes, so every chunk and each
# of its neighbours has a coordinate the page table holds
pub val REACH: i64 = (BIAS - 1) * SIDE;
# the ceiling of a pool held on the host alone. front and back cells of a
# 32-bit layer come to 32 KiB a slot, so this is a gigabyte of them, the most
# host memory the world may take. a mirror on a device sets its own, lower where the device
# needs it
pub val HOST_SLOTS: usize = 32768;
# the slots a new pool holds
val FIRST_CAP: usize = 64;

# a slot's page-table entry changed
pub val DIRTY_ENTRY: u8 = 1;
# a slot's cells changed wholesale, and the host's are the ones to keep
pub val DIRTY_CELLS: u8 = 2;
# a slot was allocated empty, which a mirror clears on its side
pub val DIRTY_ZERO: u8 = 4;
# a slot's coverage pyramid in mips was built from its cells as they stand
pub val DIRTY_MIP: u8 = 8;

# a copy of the pool kept elsewhere, a device's, which must make room before
# the pool grows, and which may own the page table for a while
#
# a device that allocates and frees chunks itself owns the pool between the
# times the host takes it back, and own brings the host's page table level
# with the device's before anything here reads or changes it.
# ---
# ctx:     the mirror's own state, passed back to reserve and own
# reserve: make room for a pool of the given slots; false refuses the growth
# own:     hand the pool to the host, bringing its page table level first;
#          false keeps it the mirror's, as when the host could not hold it
pub rec Mirror {
    ctx:     *u8;
    reserve: fun(*u8, usize) bool;
    own:     fun(*u8) bool;
}

# the pool
# ---
# a:         allocator backing every array
# cap:       slots every array holds
# max_slots: the most slots the pool may grow to
# mirrored:  mirror holds a copy that must make room before a growth
# mirror:    that copy
# hi:        slots in use lie below this
# live:      slots in use
# table:     the page table, cap * ENTRY words
# set:       the layers the cells are stored in
# fronts:    each layer's front cells, cap spans of it (cellar.layer)
# backs:     each layer's back cells, cap spans of it, or nil when the GPU
#            steps
# cells:     the state layer's front cells, fronts[0], for code not yet
#            reading them through the planes
# back:      the state layer's back cells, backs[0]
# mips:      each slot's coverage pyramid (layout.MIP texels), cap * MIP, for a
#            draw of the cells the CPU steps, or nil
# mips_back: the pyramids of the back cells, which a step builds as it goes
# mip_box:   the chunks, x0, y0, x1, y1 inclusive, whose pyramids a step
#            builds, those a draw can see
# mip_on:    a step builds pyramids at all: the draw reads them
# census:    per slot live count, warm, incarnation, mask and extent, from the
#            last step
# dirty:     per slot DIRTY_ENTRY, DIRTY_CELLS, DIRTY_ZERO and DIRTY_MIP, for
#            a mirror to upload
# asked:     per slot whether a live chunk's mask asked for it, while settling,
#            or on a pool held whole whether it is due
# frees:     free slots below hi
# nfree:     how many frees holds
# hash:      slot per bucket, NONE when empty, linear probing
# hcap:      buckets, the power of two buckets gives for cap
# serial:    the last incarnation handed out
# stepped:   whether back is kept
# sense:     how the census reads a cell, the running rule's
# reach:     cells the running rule reaches a generation, whose ring a chunk
#            counted or painted on the host asks for (span)
# wide:      a chunk counted or painted on the host asks for the wide halo,
#            as the GPU's census does while it steps uncapped
# grid:      the grid the world runs on
# rim:       every chunk along the grid's plane edge is kept, for a rule whose
#            step reads the edge live (see keep_rim)
# whole:     every chunk on the grid is held and stays, so nothing is allocated
#            or freed while the world steps (cover)
# awake:     on a pool held whole, the slots whose cells or back cells may hold
#            something; every other slot holds zeros in both and a zero census
# nawake:    how many awake holds
# woke:      per slot whether awake holds it
# due:       on a pool held whole, the slots the CPU's step steps (plan): the
#            awake ones, the chunks their live cells may spread into and the rim
# ndue:      how many due holds
pub rec Space {
    a:         *allo.Allocator;
    cap:       usize;
    max_slots: usize;
    mirrored:  bool;
    mirror:    Mirror;
    hi:        usize;
    live:      usize;
    table:     *u32;
    set:       plane.Set;
    fronts:    [layer.LAYERS_MAX]*u32;
    backs:     [layer.LAYERS_MAX]*u32;
    cells:     *u32;
    back:      *u32;
    mips:      *u32;
    mips_back: *u32;
    mip_box:   [4]i64;
    mip_on:    bool;
    census:    *u32;
    before:    *u32;
    dirty:     *u8;
    asked:     *u8;
    frees:     *u32;
    nfree:     usize;
    hash:      *u32;
    hcap:      usize;
    serial:    u32;
    stepped:   bool;
    sense:     layout.Sense;
    reach:     usize;
    wide:      bool;
    grid:      topology.Grid;
    rim:       bool;
    whole:     bool;
    awake:     *u32;
    nawake:    usize;
    woke:      *u8;
    due:       *u32;
    ndue:      usize;
}

# one chunk's step, as a rule family's CPU step sees it
# ---
# set:  the layers the cells are stored in
# nb:   each layer's front cells of the 3 by 3 block of chunks around it:
#       layer k's span of block chunk q, row-major with the chunk itself at 4,
#       at k * 9 + q, nil where a chunk does not exist and reads as zeros
# out:  each layer's back span of the chunk, every cell of which the step
#       writes
# busy: a live cell lay in the block as the step began; when not, only the
#       chunk's own cells can change, since the pool's background steps to
#       itself under every rule
# gen:  the generation the block's cells hold
pub rec Block {
    set:  *plane.Set;
    nb:   [layer.LAYERS_MAX * 9]*u32;
    out:  [layer.LAYERS_MAX]*u32;
    busy: bool;
    gen:  u64;
}

# a block with no chunk, of a set's layers, whose spans the caller names
pub fun block(set: *plane.Set, gen: u64) Block {
    var b: Block;
    b.set  = set;
    b.busy = false;
    b.gen  = gen;
    var i: usize = 0;
    for (i < layer.LAYERS_MAX::usize * 9) {
        b.nb[i] = nil;
        i       = i + 1;
    }
    i = 0;
    for (i < layer.LAYERS_MAX::usize) {
        b.out[i] = nil;
        i        = i + 1;
    }
    ret b;
}

# layer k's span of block chunk q, row-major with the chunk itself at 4; its
# words are nil where the chunk does not exist
pub fun block_plane(b: *Block, k: usize, q: usize) plane.Plane {
    ret plane.at(b.nb[k * 9 + q], b.set.at[k].width);
}

# layer k's front span of the chunk a block steps
pub fun block_own(b: *Block, k: usize) plane.Plane {
    ret block_plane(b, k, 4);
}

# layer k's back span of the chunk a block steps, which its step writes
pub fun block_out(b: *Block, k: usize) plane.Plane {
    ret plane.at(b.out[k], b.set.at[k].width);
}

# the state layer's value of a cell of a block, in its chunk's coordinates,
# which a family's step reads every cell outside its own chunk through
# ---
# b:   the block
# x:   the column, in [-SIDE, 2 * SIDE)
# y:   the row, in [-SIDE, 2 * SIDE)
# ret: the cell, zero in a chunk that does not exist
#[inline]
pub fun block_cell(b: *Block, x: i64, y: i64) u32 {
    ret block_value(b, 0, x, y);
}

# layer k's value of a cell of a block, as block_cell reads the state layer's
#[inline]
pub fun block_value(b: *Block, k: usize, x: i64, y: i64) u32 {
    var lx: i64   = x;
    var ly: i64   = y;
    var cx: usize = 1;
    var cy: usize = 1;
    if (lx < 0) {
        lx = lx + SIDE;
        cx = 0;
    }
    or (lx >= SIDE) {
        lx = lx - SIDE;
        cx = 2;
    }
    if (ly < 0) {
        ly = ly + SIDE;
        cy = 0;
    }
    or (ly >= SIDE) {
        ly = ly - SIDE;
        cy = 2;
    }
    val src: plane.Plane = block_plane(b, k, cy * 3 + cx);
    if (src.w == nil) { ret 0; }
    ret plane.get(src, (ly * SIDE + lx)::usize);
}

# a chunk's census as its cells are written, which a step keeps while it goes
# ---
# sense: how a cell is read
# live:  live cells so far
# warm:  1 once a warm cell is written
# x0:    first column holding a live cell
# y0:    first row holding one
# x1:    last column holding one
# y1:    last row holding one
# quads: the quadrants holding one (cellar.layout.quadrant)
pub rec Tally {
    sense: layout.Sense;
    live:  u32;
    warm:  u32;
    x0:    u32;
    y0:    u32;
    x1:    u32;
    y1:    u32;
    quads: u32;
}

# an empty tally reading cells through sense
pub fun tally(sense: layout.Sense) Tally {
    ret Tally{sense: sense, live: 0, warm: 0, x0: 63, y0: 63, x1: 0, y1: 0, quads: 0};
}

# count the cell written at (x, y) of the chunk
#[inline]
pub fun note(t: *Tally, c: u32, x: u32, y: u32) {
    if (layout.live(c, t.sense.live_mask, t.sense.live_lo, t.sense.live_hi) != 0) {
        t.live  = t.live + 1;
        t.quads = t.quads | layout.quadrant(x, y);
        if (x < t.x0) { t.x0 = x; }
        if (y < t.y0) { t.y0 = y; }
        if (x > t.x1) { t.x1 = x; }
        if (y > t.y1) { t.y1 = y; }
    }
    if ((c & t.sense.warm_mask) != 0) { t.warm = 1; }
}

# count a row of the chunk written at once, as note would each of its cells
# ---
# t:    the tally
# live: the row's live cells, bit x for column x
# warm: a warm cell was written in the row
# y:    the row
pub fun note_row(t: *Tally, live: u64, warm: bool, y: u32) {
    if (warm)      { t.warm = 1; }
    if (live == 0) { ret; }
    val x0: u32 = bits.ctz(live)::u32;
    val x1: u32 = 63 - bits.clz(live)::u32;
    t.live = t.live + bits.popcount(live)::u32;
    if ((live & 0xffffffff) != 0) { t.quads = t.quads | layout.quadrant(0, y); }
    if ((live >> 32) != 0)        { t.quads = t.quads | layout.quadrant(32, y); }
    if (x0 < t.x0)                { t.x0 = x0; }
    if (y < t.y0)                 { t.y0 = y; }
    if (x1 > t.x1)                { t.x1 = x1; }
    if (y > t.y1)                 { t.y1 = y; }
}

# write a tally as a slot's census words, asking for the adjacent chunks
# ---
# t:   the tally of every cell in the chunk
# cn:  the slot's CENSUS words
# inc: the slot's incarnation
pub fun tally_census(t: *Tally, cn: *u32, inc: u32) {
    cn[0] = t.live;
    cn[1] = t.warm;
    cn[2] = inc;
    cn[3] = 0;
    cn[4] = 0;
    if (t.live != 0) {
        cn[3] = MASK_RING;
        cn[4] = layout.extent(t.x0, t.y0, t.x1, t.y1) | (t.quads << layout.EXTENT_QUADS);
    }
}

# whether a state layer's value is live, as the pool's sense reads it
pub fun live(sp: *Space, c: u32) bool {
    ret layout.live(c, sp.sense.live_mask, sp.sense.live_lo, sp.sense.live_hi) != 0;
}

# the layers the pool stores its cells in
pub fun layers(sp: *Space) *plane.Set {
    ret ?sp.set;
}

# words of a slot's span of the pool's layer k
fun span_of(sp: *Space, k: usize) usize {
    ret plane.span_words(sp.set.at[k].width);
}

# layer k's front span of slot s, the world as it stands
pub fun plane_of(sp: *Space, k: usize, s: usize) plane.Plane {
    ret plane.at(?sp.fronts[k][s * span_of(sp, k)], sp.set.at[k].width);
}

# layer k's back span of slot s, which the CPU's step writes; the pool must
# keep back cells
pub fun back_of(sp: *Space, k: usize, s: usize) plane.Plane {
    ret plane.at(?sp.backs[k][s * span_of(sp, k)], sp.set.at[k].width);
}

# the host's words of layer k from slot s's span on: on the host a layer's
# spans lie in slot order one after another, so a run of slots' spans is one
# run of words, which a mirror sends and reads back whole
pub fun span_run(sp: *Space, k: usize, s: usize) *u32 {
    ret plane_of(sp, k, s).w;
}

# the value of cell i of slot s in the state layer, which the sense reads
pub fun sensed(sp: *Space, s: usize, i: usize) u32 {
    ret plane.get(plane_of(sp, 0, s), i);
}

# whether the state and rule layers are the state layer alone, its values
# the word's low bits, so a word is the state layer's value
fun lone(sp: *Space) bool {
    ret sp.set.n == 1 || sp.set.at[1].role == layer.VIEW;
}

# the word of cell i of slot s: its exact value, its state and rule layers'
# values where each lies in it (cellar.layer)
pub fun word(sp: *Space, s: usize, i: usize) u32 {
    if (lone(sp)) { ret plane.get(plane_of(sp, 0, s), i); }
    var w: u32   = 0;
    var k: usize = 0;
    for (k < plane.exact(?sp.set)) {
        val d: *plane.Decl = ?sp.set.at[k];
        w = w | layer.give(plane.get(plane_of(sp, k, s), i), d.width, d.at);
        k = k + 1;
    }
    ret w;
}

# write the word of cell i of slot s into its state and rule layers, leaving
# its view layers alone
pub fun put_word(sp: *Space, s: usize, i: usize, w: u32) {
    var k: usize = 0;
    for (k < plane.exact(?sp.set)) {
        val d: *plane.Decl = ?sp.set.at[k];
        plane.put(plane_of(sp, k, s), i, layer.take(w, d.width, d.at));
        k = k + 1;
    }
}

# write the word w to n cells of slot s from cell i
pub fun fill_words(sp: *Space, s: usize, i: usize, n: usize, w: u32) {
    var k: usize = 0;
    for (k < plane.exact(?sp.set)) {
        val d: *plane.Decl = ?sp.set.at[k];
        plane.fill(plane_of(sp, k, s), i, n, layer.take(w, d.width, d.at));
        k = k + 1;
    }
}

# the words of n cells of slot s from cell i, into out
pub fun get_words(sp: *Space, s: usize, i: usize, n: usize, out: *u32) {
    if (lone(sp)) {
        plane.get_run(plane_of(sp, 0, s), i, n, out);
        ret;
    }
    var j: usize = 0;
    for (j < n) {
        out[j] = word(sp, s, i + j);
        j      = j + 1;
    }
}

# write n words from w to the cells of slot s from cell i
pub fun put_words(sp: *Space, s: usize, i: usize, n: usize, w: *u32) {
    if (lone(sp)) {
        plane.put_run(plane_of(sp, 0, s), i, n, w);
        ret;
    }
    var j: usize = 0;
    for (j < n) {
        put_word(sp, s, i + j, w[j]);
        j = j + 1;
    }
}

# whether any cell of slot s holds a value but 0 in any layer
pub fun any(sp: *Space, s: usize) bool {
    var k: usize = 0;
    for (k < sp.set.n) {
        if (plane.any(plane_of(sp, k, s))) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether any cell of slot s holds a word but 0
pub fun holds_word(sp: *Space, s: usize) bool {
    var k: usize = 0;
    for (k < plane.exact(?sp.set)) {
        if (plane.any(plane_of(sp, k, s))) { ret true; }
        k = k + 1;
    }
    ret false;
}

# zero every cell of slot s in every layer
pub fun clear_slot(sp: *Space, s: usize) {
    var k: usize = 0;
    for (k < sp.set.n) {
        plane.clear(plane_of(sp, k, s));
        k = k + 1;
    }
}

# zero cell i of slot s in every layer
fun clear_cell(sp: *Space, s: usize, i: usize) {
    var k: usize = 0;
    for (k < sp.set.n) {
        plane.put(plane_of(sp, k, s), i, 0);
        k = k + 1;
    }
}

# whether cell i of slot s holds a value but 0 in any layer
fun holds_cell(sp: *Space, s: usize, i: usize) bool {
    var k: usize = 0;
    for (k < sp.set.n) {
        if (plane.get(plane_of(sp, k, s), i) != 0) { ret true; }
        k = k + 1;
    }
    ret false;
}

# words of a chunk's image under the pool's layers (plane.image_words)
pub fun image_words(sp: *Space) usize {
    ret plane.image_words(?sp.set);
}

# copy slot s's image, its state and rule layers' spans in order, into out
pub fun get_image(sp: *Space, s: usize, out: *u32) {
    var at: usize = 0;
    var k:  usize = 0;
    for (k < plane.exact(?sp.set)) {
        mem.copy[u32](?out[at], plane_of(sp, k, s).w, span_of(sp, k));
        at = at + span_of(sp, k);
        k  = k + 1;
    }
}

# write an image under the pool's layers into slot s's state and rule layers
pub fun put_image(sp: *Space, s: usize, img: *u32) {
    var at: usize = 0;
    var k:  usize = 0;
    for (k < plane.exact(?sp.set)) {
        mem.copy[u32](plane_of(sp, k, s).w, ?img[at], span_of(sp, k));
        at = at + span_of(sp, k);
        k  = k + 1;
    }
}

# the word of cell i of an image under a set
pub fun image_word(set: *plane.Set, img: *u32, i: usize) u32 {
    var w:  u32   = 0;
    var at: usize = 0;
    var k:  usize = 0;
    for (k < plane.exact(set)) {
        val d: *plane.Decl = ?set.at[k];
        w  = w | layer.give(plane.get(plane.at(?img[at], d.width), i), d.width, d.at);
        at = at + plane.span_words(d.width);
        k  = k + 1;
    }
    ret w;
}

# write the word of cell i of an image under a set
pub fun put_image_word(set: *plane.Set, img: *u32, i: usize, w: u32) {
    var at: usize = 0;
    var k:  usize = 0;
    for (k < plane.exact(set)) {
        val d: *plane.Decl = ?set.at[k];
        plane.put(plane.at(?img[at], d.width), i, layer.take(w, d.width, d.at));
        at = at + plane.span_words(d.width);
        k  = k + 1;
    }
}

# swap every layer's front and back cells, as a step completes
pub fun swap(sp: *Space) {
    var k: usize = 0;
    for (k < sp.set.n) {
        val f: *u32 = sp.fronts[k];
        sp.fronts[k] = sp.backs[k];
        sp.backs[k]  = f;
        k            = k + 1;
    }
    sp.cells = sp.fronts[0];
    sp.back  = sp.backs[0];
}

# the chunk coordinate holding a cell coordinate
pub fun chunk_of(v: i64) i64 {
    ret v >> 6;
}

# a cell coordinate's offset inside its chunk
pub fun local_of(v: i64) usize {
    ret (v & 63)::usize;
}

fun bucket(sp: *Space, cx: i64, cy: i64) usize {
    val h: u64 = (cx::u64 * 0x9e3779b97f4a7c15) ^ (cy::u64 * 0xc2b2ae3d27d4eb4f);
    ret ((h ^ (h >> 29))::usize) & (sp.hcap - 1);
}

# the chunk x coordinate of a slot in use
pub fun slot_x(sp: *Space, s: usize) i64 {
    ret sp.table[s * ENTRY + 9]::i64 - BIAS;
}

# the chunk y coordinate of a slot in use
pub fun slot_y(sp: *Space, s: usize) i64 {
    ret sp.table[s * ENTRY + 10]::i64 - BIAS;
}

# whether a slot holds a chunk
pub fun used(sp: *Space, s: usize) bool {
    ret sp.table[s * ENTRY + 11] != 0;
}

# a slot's incarnation, zero while free
pub fun incarnation(sp: *Space, s: usize) u32 {
    ret sp.table[s * ENTRY + 11];
}

# the slot of the chunk at (cx, cy), or NONE
pub fun find(sp: *Space, cx: i64, cy: i64) u32 {
    var b: usize = bucket(sp, cx, cy);
    for (sp.hash[b] != NONE) {
        val s: usize = sp.hash[b]::usize;
        if (slot_x(sp, s) == cx && slot_y(sp, s) == cy) { ret s::u32; }
        b = (b + 1) & (sp.hcap - 1);
    }
    ret NONE;
}

fun hash_put(sp: *Space, s: usize) {
    var b: usize = bucket(sp, slot_x(sp, s), slot_y(sp, s));
    for (sp.hash[b] != NONE) { b = (b + 1) & (sp.hcap - 1); }
    sp.hash[b] = s::u32;
}

# remove a slot from the hash, shifting later entries of its run back so a
# probe never stops at a hole
fun hash_remove(sp: *Space, s: usize) {
    val m: usize = sp.hcap - 1;
    var b: usize = bucket(sp, slot_x(sp, s), slot_y(sp, s));
    for (sp.hash[b] != s::u32) { b = (b + 1) & m; }
    var hole: usize = b;
    var j:    usize = (b + 1) & m;
    for (sp.hash[j] != NONE) {
        val t:    usize = sp.hash[j]::usize;
        val home: usize = bucket(sp, slot_x(sp, t), slot_y(sp, t));
        # t may fill the hole unless its home lies cyclically in (hole, j]
        if (((j - home) & m) >= ((j - hole) & m)) {
            sp.hash[hole] = t::u32;
            hole          = j;
        }
        j = (j + 1) & m;
    }
    sp.hash[hole] = NONE;
}

# hash buckets for cap slots: a power of two, so a probe wraps with a mask, and
# at least four a slot
fun buckets(cap: usize) usize {
    var n: usize = 1;
    for (n < cap * 4) { n = n * 2; }
    ret n;
}

fun zwords(a: *allo.Allocator, n: usize) *u32 {
    val r: res[*u32, allo.Error] = allo.zallocate[u32](a, n);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

# make every layer of a set for cap slots, zeroed: its front cells, and its
# back cells when stepped
# ---
# ret: false when the allocator refused one, leaving none made
fun make_layers(a: *allo.Allocator, set: *plane.Set, cap: usize, stepped: bool, fronts: **u32, backs: **u32) bool {
    var ok: bool  = true;
    var k:  usize = 0;
    for (k < set.n) {
        val n: usize = cap * plane.span_words(set.at[k].width);
        fronts[k] = zwords(a, n);
        backs[k]  = nil;
        if (stepped)                                          { backs[k] = zwords(a, n); }
        if (fronts[k] == nil || (stepped && backs[k] == nil)) { ok = false; }
        k = k + 1;
    }
    if (!ok) { drop_layers(a, set, cap, fronts, backs); }
    ret ok;
}

# free every layer of a set made for cap slots
fun drop_layers(a: *allo.Allocator, set: *plane.Set, cap: usize, fronts: **u32, backs: **u32) {
    var k: usize = 0;
    for (k < set.n) {
        val n: usize = cap * plane.span_words(set.at[k].width);
        if (fronts[k] != nil) { allo.deallocate[u32](a, fronts[k], n); }
        if (backs[k] != nil)  { allo.deallocate[u32](a, backs[k], n); }
        fronts[k] = nil;
        backs[k]  = nil;
        k         = k + 1;
    }
}

fun alloc_arrays(sp: *Space, cap: usize) err[allo.Error] {
    val a:      *allo.Allocator = sp.a;
    val table:  *u32            = zwords(a, cap * ENTRY);
    var fronts: [layer.LAYERS_MAX]*u32;
    var backs:  [layer.LAYERS_MAX]*u32;
    val made:   bool            = make_layers(a, ?sp.set, cap, sp.stepped, ?fronts[0], ?backs[0]);
    val pyr:    bool            = sp.mips != nil;
    var mips:   *u32            = nil;
    var mback:  *u32            = nil;
    if (pyr) {
        mips  = zwords(a, cap * MIP);
        mback = zwords(a, cap * MIP);
    }
    val census: *u32                 = zwords(a, cap * CENSUS);
    val before: *u32                 = zwords(a, cap * CENSUS);
    val frees:  *u32                 = zwords(a, cap);
    val hcap:   usize                = buckets(cap);
    val hash:   *u32                 = zwords(a, hcap);
    var dirty:  *u8                  = nil;
    val rd:     res[*u8, allo.Error] = allo.zallocate[u8](a, cap);
    if (sel rd.ok) { dirty = rd.ok; }
    var asked: *u8                  = nil;
    val ra:    res[*u8, allo.Error] = allo.zallocate[u8](a, cap);
    if (sel ra.ok) { asked = ra.ok; }
    var woke: *u8                  = nil;
    val rw:   res[*u8, allo.Error] = allo.zallocate[u8](a, cap);
    if (sel rw.ok) { woke = rw.ok; }
    val awake: *u32 = zwords(a, cap);
    val due:   *u32 = zwords(a, cap);
    if (table == nil || !made || census == nil
        || before == nil || frees == nil || hash == nil || dirty == nil || asked == nil
        || woke == nil || awake == nil || due == nil || (pyr && (mips == nil || mback == nil))) {
        if (table != nil)  { allo.deallocate[u32](a, table, cap * ENTRY); }
        if (made)          { drop_layers(a, ?sp.set, cap, ?fronts[0], ?backs[0]); }
        if (mips != nil)   { allo.deallocate[u32](a, mips, cap * MIP); }
        if (mback != nil)  { allo.deallocate[u32](a, mback, cap * MIP); }
        if (census != nil) { allo.deallocate[u32](a, census, cap * CENSUS); }
        if (before != nil) { allo.deallocate[u32](a, before, cap * CENSUS); }
        if (frees != nil)  { allo.deallocate[u32](a, frees, cap); }
        if (hash != nil)   { allo.deallocate[u32](a, hash, hcap); }
        if (dirty != nil)  { allo.deallocate[u8](a, dirty, cap); }
        if (asked != nil)  { allo.deallocate[u8](a, asked, cap); }
        if (woke != nil)   { allo.deallocate[u8](a, woke, cap); }
        if (awake != nil)  { allo.deallocate[u32](a, awake, cap); }
        if (due != nil)    { allo.deallocate[u32](a, due, cap); }
        ret err[allo.Error].err{allo.Error.exhausted{}};
    }
    # carry the old pool over, then rebuild the hash at its new size
    if (sp.cap != 0) {
        mem.copy[u32](table, sp.table, sp.hi * ENTRY);
        var k: usize = 0;
        for (k < sp.set.n) {
            mem.copy[u32](fronts[k], sp.fronts[k], sp.hi * span_of(sp, k));
            if (backs[k] != nil) { mem.copy[u32](backs[k], sp.backs[k], sp.hi * span_of(sp, k)); }
            k = k + 1;
        }
        if (pyr) { mem.copy[u32](mips, sp.mips, sp.hi * MIP); }
        mem.copy[u32](census, sp.census, sp.hi * CENSUS);
        mem.copy[u8](dirty, sp.dirty, sp.hi);
        mem.copy[u8](asked, sp.asked, sp.hi);
        mem.copy[u8](woke, sp.woke, sp.hi);
        mem.copy[u32](awake, sp.awake, sp.nawake);
        mem.copy[u32](due, sp.due, sp.ndue);
        mem.copy[u32](frees, sp.frees, sp.nfree);
        free_arrays(sp);
    }
    sp.table = table;
    var k: usize = 0;
    for (k < sp.set.n) {
        sp.fronts[k] = fronts[k];
        sp.backs[k]  = backs[k];
        k            = k + 1;
    }
    sp.cells     = sp.fronts[0];
    sp.back      = sp.backs[0];
    sp.mips      = mips;
    sp.mips_back = mback;
    sp.census    = census;
    sp.before    = before;
    sp.dirty     = dirty;
    sp.asked     = asked;
    sp.woke      = woke;
    sp.awake     = awake;
    sp.due       = due;
    sp.frees     = frees;
    sp.hash      = hash;
    sp.cap       = cap;
    sp.hcap      = hcap;
    mem.fill[u32](sp.hash, NONE, sp.hcap);
    var s: usize = 0;
    for (s < sp.hi) {
        if (used(sp, s)) { hash_put(sp, s); }
        s = s + 1;
    }
    ret err[allo.Error].ok{};
}

fun free_arrays(sp: *Space) {
    val a: *allo.Allocator = sp.a;
    allo.deallocate[u32](a, sp.table, sp.cap * ENTRY);
    drop_layers(a, ?sp.set, sp.cap, ?sp.fronts[0], ?sp.backs[0]);
    sp.cells = nil;
    sp.back  = nil;
    if (sp.mips != nil) {
        allo.deallocate[u32](a, sp.mips, sp.cap * MIP);
        allo.deallocate[u32](a, sp.mips_back, sp.cap * MIP);
    }
    allo.deallocate[u32](a, sp.census, sp.cap * CENSUS);
    allo.deallocate[u32](a, sp.before, sp.cap * CENSUS);
    allo.deallocate[u8](a, sp.dirty, sp.cap);
    allo.deallocate[u8](a, sp.asked, sp.cap);
    allo.deallocate[u8](a, sp.woke, sp.cap);
    allo.deallocate[u32](a, sp.awake, sp.cap);
    allo.deallocate[u32](a, sp.due, sp.cap);
    allo.deallocate[u32](a, sp.frees, sp.cap);
    allo.deallocate[u32](a, sp.hash, sp.hcap);
}

# an empty pool
# ---
# sp:      pool to initialize
# a:       allocator backing it
# stepped: keep back cells, for the CPU to step into
# ret:     ok, or the allocator's refusal
pub fun init(sp: *Space, a: *allo.Allocator, stepped: bool) err[allo.Error] {
    sp.a         = a;
    sp.cap       = 0;
    sp.max_slots = HOST_SLOTS;
    sp.mirrored  = false;
    sp.hi        = 0;
    sp.live      = 0;
    sp.nfree     = 0;
    sp.serial    = 0;
    sp.stepped   = stepped;
    sp.mips      = nil;
    sp.mips_back = nil;
    sp.mip_on    = false;
    mem.zero[u8]((?sp.sense)::*u8, $size_of(layout.Sense));
    sp.reach  = 1;
    sp.wide   = false;
    sp.grid   = topology.open();
    sp.rim    = false;
    sp.whole  = false;
    sp.nawake = 0;
    sp.ndue   = 0;
    # a 32-bit state layer until a rule names its own (relayer)
    sp.set = plane.state("cells", layer.WIDTH_MAX);
    var k: usize = 0;
    for (k < layer.LAYERS_MAX::usize) {
        sp.fronts[k] = nil;
        sp.backs[k]  = nil;
        k            = k + 1;
    }
    ret alloc_arrays(sp, FIRST_CAP);
}

# a word turned into another, for relayer
pub def Remap: fun(*u8, u32) u32;

# store the pool's cells in another set of layers, every cell's word turned
# into its word under it
#
# a view layer of the new set keeps its cells where the old set held one of
# the same name and width, and starts at zero otherwise. the back cells start
# at zero, as a pool's do. every slot in use is touched once anything moved.
# ---
# sp:  the pool
# set: the layers, holding to the contract (plane.holds)
# map: (ctx, word under the old layers) its word under the new, or nil to
#      keep every word as it is
# ctx: passed back to map
# ret: ok, or the allocator's refusal, which leaves the pool as it was
pub fun relayer(sp: *Space, set: *plane.Set, map: Remap, ctx: *u8) err[allo.Error] {
    var old: plane.Set = sp.set;
    if (plane.same_shape(?old, set) && plane.same_words(?old, set)) {
        sp.set = @set;
        if (map == nil) { ret err[allo.Error].ok{}; }
        var buf: [4096]u32;
        var s:   usize = 0;
        for (s < sp.hi) {
            if (used(sp, s)) {
                get_words(sp, s, 0, CELLS, ?buf[0]);
                var i: usize = 0;
                for (i < CELLS) {
                    buf[i] = map(ctx, buf[i]);
                    i      = i + 1;
                }
                put_words(sp, s, 0, CELLS, ?buf[0]);
                touch(sp, s);
            }
            s = s + 1;
        }
        ret err[allo.Error].ok{};
    }
    var fronts: [layer.LAYERS_MAX]*u32;
    var backs:  [layer.LAYERS_MAX]*u32;
    if (!make_layers(sp.a, set, sp.cap, sp.stepped, ?fronts[0], ?backs[0])) { ret err[allo.Error].err{allo.Error.exhausted{}}; }
    var was:  [layer.LAYERS_MAX]*u32;
    var wasb: [layer.LAYERS_MAX]*u32;
    var k:    usize = 0;
    for (k < layer.LAYERS_MAX::usize) {
        was[k]  = sp.fronts[k];
        wasb[k] = sp.backs[k];
        k       = k + 1;
    }
    var buf: [4096]u32;
    var s:   usize = 0;
    for (s < sp.hi) {
        if (used(sp, s)) {
            get_words(sp, s, 0, CELLS, ?buf[0]);
            var i: usize = 0;
            for (map != nil && i < CELLS) {
                buf[i] = map(ctx, buf[i]);
                i      = i + 1;
            }
            # the new layers, read and written as the pool's for the while
            sp.set = @set;
            k      = 0;
            for (k < set.n) {
                sp.fronts[k] = fronts[k];
                k            = k + 1;
            }
            put_words(sp, s, 0, CELLS, ?buf[0]);
            k = plane.exact(set);
            for (k < set.n) {
                val kept: opt[usize] = plane.find(?old, set.at[k].name);
                if (sel kept.some) {
                    if (old.at[kept.some].role == layer.VIEW && old.at[kept.some].width == set.at[k].width) {
                        mem.copy[u32](plane_of(sp, k, s).w, ?was[kept.some][s * plane.span_words(set.at[k].width)], span_of(sp, k));
                    }
                }
                k = k + 1;
            }
            sp.set = old;
            k      = 0;
            for (k < layer.LAYERS_MAX::usize) {
                sp.fronts[k] = was[k];
                k            = k + 1;
            }
            touch(sp, s);
        }
        s = s + 1;
    }
    drop_layers(sp.a, ?old, sp.cap, ?was[0], ?wasb[0]);
    sp.set = @set;
    k      = 0;
    for (k < layer.LAYERS_MAX::usize) {
        sp.fronts[k] = fronts[k];
        sp.backs[k]  = backs[k];
        if (k >= set.n) {
            sp.fronts[k] = nil;
            sp.backs[k]  = nil;
        }
        k = k + 1;
    }
    sp.cells = sp.fronts[0];
    sp.back  = sp.backs[0];
    ret err[allo.Error].ok{};
}

# hand the pool a mirror that must make room before it grows, and the ceiling
# the mirror holds it to (limit)
# ---
# sp:        the pool, holding no more than max_slots
# m:         the mirror, already holding the pool's capacity
# max_slots: the most slots the mirror can hold
pub fun set_mirror(sp: *Space, m: Mirror, max_slots: usize) {
    limit(sp, max_slots);
    sp.mirror   = m;
    sp.mirrored = true;
}

# hold the pool to a ceiling of slots, where that is below its own, ahead of a
# mirror that holds no more
#
# a grid held whole with more chunks than that lets them go: its empty chunks
# are freed, its live ones counted and surrounded and its rim kept as on any
# grid that does not fit, and the arrays shrink to what is left. a pool whose
# chunks in use still do not fit keeps its capacity, which a mirror then
# refuses.
# ---
# sp:    the pool
# slots: the ceiling
pub fun limit(sp: *Space, slots: usize) {
    if (slots < sp.max_slots)                               { sp.max_slots = slots; }
    if (!sp.whole || grid_chunks(?sp.grid) <= sp.max_slots) { ret; }
    if (!own(sp))                                           { ret; }
    sp.whole = false;
    var s: usize = 0;
    for (s < sp.hi) {
        if (used(sp, s)) {
            if (any(sp, s)) { recount(sp, s); }
            or              { release(sp, s); }
        }
        s = s + 1;
    }
    compact(sp);
    settle(sp, sp.census, sp.hi, false);
    var cap: usize = FIRST_CAP;
    for (cap < sp.hi) { cap = cap * 2; }
    if (cap > sp.max_slots)           { cap = sp.max_slots; }
    if (cap < sp.cap && sp.hi <= cap) { alloc_arrays(sp, cap); }
}

# release every array
pub fun dnit(sp: *Space) {
    if (sp.cap == 0) { ret; }
    free_arrays(sp);
    sp.cap  = 0;
    sp.hi   = 0;
    sp.live = 0;
}

# drop or take up the back cells, for a change of who steps
# ---
# sp:      the pool
# stepped: keep back cells
# ret:     ok, or the allocator's refusal, which leaves the pool as it was
pub fun set_stepped(sp: *Space, stepped: bool) err[allo.Error] {
    if (stepped == sp.stepped) { ret err[allo.Error].ok{}; }
    var k: usize = 0;
    if (!stepped) {
        for (k < sp.set.n) {
            allo.deallocate[u32](sp.a, sp.backs[k], sp.cap * span_of(sp, k));
            sp.backs[k] = nil;
            k           = k + 1;
        }
        sp.back    = nil;
        sp.stepped = false;
        ret err[allo.Error].ok{};
    }
    var backs: [layer.LAYERS_MAX]*u32;
    for (k < sp.set.n) {
        backs[k] = zwords(sp.a, sp.cap * span_of(sp, k));
        if (backs[k] == nil) {
            var j: usize = 0;
            for (j < k) {
                allo.deallocate[u32](sp.a, backs[j], sp.cap * span_of(sp, j));
                j = j + 1;
            }
            ret err[allo.Error].err{allo.Error.exhausted{}};
        }
        k = k + 1;
    }
    k = 0;
    for (k < sp.set.n) {
        sp.backs[k] = backs[k];
        k           = k + 1;
    }
    sp.back    = sp.backs[0];
    sp.stepped = true;
    ret err[allo.Error].ok{};
}

# keep each slot's coverage pyramid, built as the CPU steps, for a draw of the
# pool that reads it, or stop keeping them
# ---
# sp:  the pool
# on:  keep them
# ret: ok, or the allocator's refusal, which leaves the pool as it was
pub fun set_pyramids(sp: *Space, on: bool) err[allo.Error] {
    if (on == (sp.mips != nil)) { ret err[allo.Error].ok{}; }
    if (!on) {
        allo.deallocate[u32](sp.a, sp.mips, sp.cap * MIP);
        allo.deallocate[u32](sp.a, sp.mips_back, sp.cap * MIP);
        sp.mips      = nil;
        sp.mips_back = nil;
        ret err[allo.Error].ok{};
    }
    val rf: res[*u32, allo.Error] = allo.zallocate[u32](sp.a, sp.cap * MIP);
    if (sel rf.err) { ret err[allo.Error].err{rf.err}; }
    val rb: res[*u32, allo.Error] = allo.zallocate[u32](sp.a, sp.cap * MIP);
    if (sel rb.err) {
        allo.deallocate[u32](sp.a, rf.ok, sp.cap * MIP);
        ret err[allo.Error].err{rb.err};
    }
    sp.mips      = rf.ok;
    sp.mips_back = rb.ok;
    # none of them is built yet
    var s: usize = 0;
    for (s < sp.hi) {
        sp.dirty[s] = (sp.dirty[s] | DIRTY_CELLS) & ~DIRTY_MIP;
        s           = s + 1;
    }
    ret err[allo.Error].ok{};
}

# a chunk's coverage pyramid built from its cells, as the GPU's reduce stage
# builds it: each level's texel holds the live count, the greatest heat and
# the mean age of the live cells of its square, the counts and the sum of the
# ages carried up from the level below, so every level is exactly what its
# cells give
# ---
# cells: the chunk's span of its state layer
# sn:    how a cell is read, the rule's sense
# out:   receives MIP texels
pub fun pyramid(cells: plane.Plane, sn: layout.Sense, out: *u32) {
    var live: [1024]u32;
    var heat: [1024]u32;
    var ages: [1024]u32;
    val side: u32 = layout.SIDE;
    var t:    u32 = 0;
    # level 1 from the cells, two by two
    val s1: u32 = layout.mip_side(1);
    for (t < s1 * s1) {
        val ox: u32 = (t % s1) * 2;
        val oy: u32 = (t / s1) * 2;
        var l:  u32 = 0;
        var h:  u32 = 0;
        var g:  u32 = 0;
        var i:  u32 = 0;
        for (i < 4) {
            val c: u32 = plane.get(cells, ((oy + i / 2) * side + ox + i % 2)::usize);
            if (layout.live(c, sn.live_mask, sn.live_lo, sn.live_hi) != 0) {
                l = l + 1;
                g = g + layout.texel_age(c, sn.age_shift, sn.age_mask);
            }
            val ch: u32 = layout.texel_heat(c, sn.heat_shift, sn.heat_mask);
            if (ch > h) { h = ch; }
            i = i + 1;
        }
        live[t::usize] = l;
        heat[t::usize] = h;
        ages[t::usize] = g;
        out[t::usize]  = layout.texel(l, h, g);
        t              = t + 1;
    }
    # each further level from the one below, in place
    var lv: u32 = 2;
    for (lv <= layout.LEVELS) {
        val n:  u32 = layout.mip_side(lv);
        val m:  u32 = n * 2;
        val at: u32 = layout.mip_at(lv);
        t = 0;
        for (t < n * n) {
            val x: u32 = (t % n) * 2;
            val y: u32 = (t / n) * 2;
            var l: u32 = 0;
            var h: u32 = 0;
            var g: u32 = 0;
            var i: u32 = 0;
            for (i < 4) {
                val k: usize = ((y + i / 2) * m + x + i % 2)::usize;
                l = l + live[k];
                g = g + ages[k];
                if (heat[k] > h) { h = heat[k]; }
                i = i + 1;
            }
            out[(at + t)::usize] = layout.texel(l, h, g);
            live[t::usize]       = l;
            heat[t::usize]       = h;
            ages[t::usize]       = g;
            t                    = t + 1;
        }
        lv = lv + 1;
    }
}

# say which chunks' pyramids a step builds: those in the box, while on
# ---
# sp:  the pool
# on:  build any, since a draw reads them
# box: chunk columns and rows x0, y0, x1, y1, inclusive
pub fun aim_pyramids(sp: *Space, on: bool, box: *i64) {
    sp.mip_on = on && sp.mips != nil;
    var i: usize = 0;
    for (i < 4) {
        sp.mip_box[i] = box[i];
        i             = i + 1;
    }
}

# whether a step builds the pyramid of a slot
pub fun builds_pyramid(sp: *Space, s: usize) bool {
    if (!sp.mip_on) { ret false; }
    val x: i64 = slot_x(sp, s);
    val y: i64 = slot_y(sp, s);
    ret x >= sp.mip_box[0] && x <= sp.mip_box[2] && y >= sp.mip_box[1] && y <= sp.mip_box[3];
}

# mark a slot's cells changed outside a step, so a mirror sends them again and
# its pyramid is no longer the one they give
pub fun touch(sp: *Space, s: usize) {
    sp.dirty[s] = (sp.dirty[s] | DIRTY_CELLS) & ~DIRTY_MIP;
    wake(sp, s);
}

# note that a slot of a pool held whole may hold something now, so the CPU's
# step takes it up (awake)
pub fun wake(sp: *Space, s: usize) {
    if (!sp.whole || sp.woke[s] != 0) { ret; }
    sp.woke[s]          = 1;
    sp.awake[sp.nawake] = s::u32;
    sp.nawake           = sp.nawake + 1;
}

# bring a view of the pool level with it: the pool's slots, page table, cells
# and pyramids as they stand, for a mirror to send from while the pool steps on
# (cellar.runner)
#
# the page table is copied whole, and the cells and pyramids of the chunks in
# box that changed since the last stage, whose dirty marks move from the pool
# to the view, for the mirror to clear. a chunk out of box keeps its marks
# until a stage finds it in box, so a mirror that sends only what a draw can
# see sends no more than before. full copies every slot and marks every one
# dirty, for a view that held anything else. a view is read through its page
# table alone: nothing finds, allocates or frees in it.
# ---
# dst:  the view, a pool without back cells
# src:  the pool
# full: copy every slot
# box:  chunk columns and rows x0, y0, x1, y1, inclusive, or nil for every
#       chunk
# ret:  false when the view could not be grown to hold the pool, leaving it
#       and the pool's dirty marks as they were
pub fun stage(dst: *Space, src: *Space, full: bool, box: *i64) bool {
    var all: bool = full;
    if (!plane.same(?dst.set, ?src.set)) {
        val laid: err[allo.Error] = relayer(dst, ?src.set, nil, nil);
        if (sel laid.err) { ret false; }
        all = true;
    }
    if ((src.mips != nil) != (dst.mips != nil)) {
        val made: err[allo.Error] = set_pyramids(dst, src.mips != nil);
        if (sel made.err) { ret false; }
        all = true;
    }
    if (dst.cap < src.cap) {
        val grown: err[allo.Error] = alloc_arrays(dst, src.cap);
        if (sel grown.err) { ret false; }
    }
    # every slot either side used since the last stage, or every slot at all
    var top: usize = src.hi;
    if (dst.hi > top) { top = dst.hi; }
    if (all)          { top = dst.cap; }
    var n: usize = top;
    if (n > src.cap) { n = src.cap; }
    mem.copy[u32](dst.table, src.table, n * ENTRY);
    if (top > n) { mem.zero[u32](?dst.table[n * ENTRY], (top - n) * ENTRY); }
    val kept: u8    = DIRTY_CELLS | DIRTY_ZERO | DIRTY_MIP;
    var s:    usize = 0;
    for (s < top) {
        var d: u8 = 0;
        if (s < n) {
            d            = src.dirty[s];
            src.dirty[s] = 0;
            if (!all && box != nil && s < src.hi && used(src, s)) {
                val x: i64 = slot_x(src, s);
                val y: i64 = slot_y(src, s);
                if (x < box[0] || x > box[2] || y < box[1] || y > box[3]) {
                    src.dirty[s] = d & kept;
                    d            = d & ~kept;
                }
            }
        }
        if (all) { d = d | DIRTY_ENTRY; }
        if (s < src.hi) {
            if (all) { d = d | DIRTY_CELLS; }
            if ((d & (DIRTY_CELLS | DIRTY_ZERO)) != 0) {
                var k: usize = 0;
                for (k < src.set.n) {
                    plane.copy(plane_of(dst, k, s), plane_of(src, k, s));
                    k = k + 1;
                }
                dst.dirty[s] = dst.dirty[s] & ~DIRTY_MIP;
            }
            if ((d & DIRTY_MIP) != 0 && src.mips != nil) { mem.copy[u32](?dst.mips[s * MIP], ?src.mips[s * MIP], MIP); }
        }
        dst.dirty[s] = dst.dirty[s] | d;
        s            = s + 1;
    }
    dst.hi    = src.hi;
    dst.live  = src.live;
    dst.sense = src.sense;
    dst.grid  = src.grid;
    ret true;
}

# free every slot, keeping the capacity, and on a grid held whole hold every
# chunk again, empty
pub fun reset(sp: *Space) {
    if (!own(sp)) { ret; }
    mem.zero[u32](sp.table, sp.hi * ENTRY);
    mem.zero[u32](sp.census, sp.hi * CENSUS);
    mem.fill[u32](sp.hash, NONE, sp.hcap);
    var s: usize = 0;
    for (s < sp.hi) {
        sp.dirty[s] = DIRTY_ENTRY;
        s           = s + 1;
    }
    sp.live  = 0;
    sp.nfree = 0;
    sp.hi    = 0;
    cover(sp);
}

# whether a slot's chunk is read through its links (cellar.layout.seamed)
pub fun seamed(sp: *Space, s: usize) bool {
    ret layout.seamed(sp.table[s * ENTRY + layout.EDGE_AT::usize]) != 0;
}

# whether the cell at (x, y) is on the world's grid
pub fun holds(sp: *Space, x: i64, y: i64) bool {
    ret topology.holds(?sp.grid, x, y);
}

# whether the chunk at (cx, cy) has a cell on the world's grid
pub fun on_grid(sp: *Space, cx: i64, cy: i64) bool {
    ret topology.inside(?sp.grid, cx, cy);
}

# set every neighbour slot, link word and the edge word of a slot's entry from
# the grid, and mark it dirty
fun link(sp: *Space, s: usize) {
    val e:  *u32 = ?sp.table[s * ENTRY];
    val cx: i64  = slot_x(sp, s);
    val cy: i64  = slot_y(sp, s);
    var k:  u32  = 0;
    for (k < 9) {
        val at: usize = layout.LINK_AT::usize + k::usize;
        if (k == 4) {
            e[4]  = s::u32;
            e[at] = layout.plain_link(4);
        }
        or {
            val l: topology.Link = topology.link(?sp.grid, cx, cy, k);
            e[at]       = l.word;
            e[k::usize] = NONE;
            if (l.any) { e[k::usize] = find(sp, l.cx, l.cy); }
        }
        k = k + 1;
    }
    e[layout.EDGE_AT::usize] = topology.edge_word(?sp.grid, cx, cy);
    sp.dirty[s]              = sp.dirty[s] | DIRTY_ENTRY;
}

# relink every seamed chunk that may link to the chunk at (cx, cy) across a
# seam: those around it, and around each chunk its own links reach. a link
# across a seam need not be returned by one the other way, so a chunk made or
# freed by a seam tells them this way.
fun relink_near(sp: *Space, cx: i64, cy: i64) {
    var k: u32 = 0;
    for (k < 9) {
        var l: topology.Link = topology.Link{any: true, cx: cx, cy: cy, word: 0};
        if (k != 4) { l = topology.link(?sp.grid, cx, cy, k); }
        var j: i64 = 0;
        for (l.any && j < 9) {
            val n: u32 = find(sp, l.cx + j % 3 - 1, l.cy + j / 3 - 1);
            if (n != NONE && seamed(sp, n::usize)) { link(sp, n::usize); }
            j = j + 1;
        }
        k = k + 1;
    }
}

# clip the run of cells [x0, x1) of row y to the world's grid
# ---
# ret: false when nothing of the run is on the grid
pub fun clip(sp: *Space, y: i64, x0: *i64, x1: *i64) bool {
    ret topology.clip(?sp.grid, y, x0, x1);
}

# zero a slot's cells that lie off the grid, marking them dirty when any was set
pub fun mask(sp: *Space, s: usize) {
    val e: u32   = sp.table[s * ENTRY + layout.EDGE_AT::usize];
    var i: usize = 0;
    for (i < CELLS) {
        if (layout.edge_side(e, (i & 63)::i32, (i >> 6)::i32) != 4 && holds_cell(sp, s, i)) {
            clear_cell(sp, s, i);
            touch(sp, s);
        }
        i = i + 1;
    }
}

# put the world on a grid: the chunks off it are freed, every other chunk is
# relinked and its cells off it cleared, and a grid that fits the pool is held
# whole (cover). the census is left as it was, for the caller to recount.
# ---
# sp: the pool
# g:  the grid
pub fun set_grid(sp: *Space, g: topology.Grid) {
    if (!own(sp)) { ret; }
    sp.grid = g;
    var s: usize = 0;
    for (s < sp.hi) {
        if (used(sp, s) && !topology.inside(?sp.grid, slot_x(sp, s), slot_y(sp, s))) { release(sp, s); }
        s = s + 1;
    }
    s = 0;
    for (s < sp.hi) {
        if (used(sp, s)) {
            link(sp, s);
            mask(sp, s);
        }
        s = s + 1;
    }
    compact(sp);
    cover(sp);
}

# the chunks holding a cell of a grid bounded both ways, 0 for any other grid
pub fun grid_chunks(g: *topology.Grid) usize {
    if (!topology.finite(g)) { ret 0; }
    val w: i64 = chunk_of(topology.left(g) + g.w - 1) - chunk_of(topology.left(g)) + 1;
    val h: i64 = chunk_of(topology.top(g) + g.h - 1) - chunk_of(topology.top(g)) + 1;
    ret (w * h)::usize;
}

# hold every chunk of a grid bounded both ways, when they fit the pool's
# ceiling, so stepping it never allocates or frees one (whole)
#
# the pool grows once to the grid's chunks, the mirror making room first, each
# chunk missing is allocated empty, and every slot is linked through the seams.
# a grid with an unbounded axis or more chunks than the ceiling, or a growth
# either side refuses, is left to allocate around its live cells.
fun cover(sp: *Space) {
    # a settle on another grid may have left slots asked for
    sp.whole = false;
    mem.zero[u8](sp.woke, sp.cap);
    mem.zero[u8](sp.asked, sp.cap);
    sp.nawake = 0;
    sp.ndue   = 0;
    val g: *topology.Grid = ?sp.grid;
    val n: usize          = grid_chunks(g);
    if (n == 0 || n > sp.max_slots || !grow(sp, n)) { ret; }
    # a chunk held before may hold anything, in either cells; a new one holds zeros
    var s: usize = 0;
    for (s < sp.hi) {
        if (used(sp, s)) {
            sp.woke[s]          = 1;
            sp.awake[sp.nawake] = s::u32;
            sp.nawake           = sp.nawake + 1;
        }
        s = s + 1;
    }
    val cx0: i64 = chunk_of(topology.left(g));
    val cx1: i64 = chunk_of(topology.left(g) + g.w - 1);
    val cy0: i64 = chunk_of(topology.top(g));
    val cy1: i64 = chunk_of(topology.top(g) + g.h - 1);
    var cy:  i64 = cy0;
    for (cy <= cy1) {
        var cx: i64 = cx0;
        for (cx <= cx1) {
            if (find(sp, cx, cy) == NONE) { quiet(sp, claim(sp, cx, cy)::usize); }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    s = 0;
    for (s < sp.hi) {
        if (used(sp, s)) { link(sp, s); }
        s = s + 1;
    }
    sp.whole = true;
}

# zero what a slot just claimed for a pool held whole holds beyond its cells,
# so it need not be awake: its back cells and pyramid, and the census a step
# began from
fun quiet(sp: *Space, s: usize) {
    mem.zero[u32](?sp.before[s * CENSUS], CENSUS);
    var k: usize = 0;
    for (sp.stepped && k < sp.set.n) {
        plane.clear(back_of(sp, k, s));
        k = k + 1;
    }
    if (sp.mips_back != nil) { mem.zero[u32](?sp.mips_back[s * MIP], MIP); }
}

# layer k's value of the cell at (x, y) of a slot's frame, taken through the
# links where it lies outside the window (cellar.layout), zero where no chunk
# holds it, and past a plane's dead edge past, the value the rule holds the
# edge as in that layer (cellar.rule.outside)
pub fun resolve(sp: *Space, k: usize, s: usize, x: i32, y: i32, past: u32) u32 {
    var sl: usize = s;
    var px: i32   = x;
    var py: i32   = y;
    var h:  u32   = 0;
    for (true) {
        val e: *u32 = ?sp.table[sl * ENTRY];
        val q: u32  = layout.edge_side(e[layout.EDGE_AT::usize], px, py);
        if (q == 4) { ret plane.get(plane_of(sp, k, sl), (py * 64 + px)::usize); }
        val t: u32 = e[layout.LINK_AT::usize + q::usize];
        if (e[q::usize] == NONE && (t & layout.LINK_EDGE) != 0) { ret past; }
        if (h == layout.HOPS || e[q::usize] == NONE)            { ret 0; }
        val nx: i32 = layout.hop_x(t, px, py);
        py = layout.hop_y(t, px, py);
        px = nx;
        sl = e[q::usize]::usize;
        h  = h + 1;
    }
    ret 0;
}

# take the pool back from a mirror that owns it, so the host's page table is
# the one to read and change
# ---
# ret: false when the mirror keeps it, and nothing here may read or change it
pub fun own(sp: *Space) bool {
    if (!sp.mirrored) { ret true; }
    ret sp.mirror.own(sp.mirror.ctx);
}

# the incarnation bits a mirror's census carries
pub val TAG: u32 = 0x3ffff;

# take up a page table a mirror wrote into the first n slots' entries, as the
# pool from now on
#
# every slot at or past n is free. hi, the count, the hash and the free slots
# follow the table, and a slot's census is kept where its incarnation is the
# one counted, else taken from the mirror's census when its incarnation bits
# (TAG) name it, else zeroed. nothing is dirty, since the mirror holds the
# table as it stands.
# ---
# sp:     the pool, whose table holds the mirror's entries below n
# n:      slots the mirror's table covers, at most the capacity
# landed: CENSUS words per slot below n from the mirror's last census, or nil
pub fun adopt(sp: *Space, n: usize, landed: *u32) {
    if (sp.hi > n) { mem.zero[u32](?sp.table[n * ENTRY], (sp.hi - n) * ENTRY); }
    sp.hi   = n;
    sp.live = 0;
    mem.fill[u32](sp.hash, NONE, sp.hcap);
    var s: usize = 0;
    for (s < n) {
        val c: *u32 = ?sp.census[s * CENSUS];
        if (!used(sp, s)) { mem.zero[u32](c, CENSUS); }
        or {
            sp.live = sp.live + 1;
            hash_put(sp, s);
            val inc: u32 = incarnation(sp, s);
            if (c[2] != inc) {
                mem.zero[u32](c, CENSUS);
                if (landed != nil && landed[s * CENSUS + 2] == (inc & TAG)) {
                    mem.copy[u32](c, ?landed[s * CENSUS], CENSUS);
                    c[2] = inc;
                }
            }
        }
        sp.dirty[s] = 0;
        s           = s + 1;
    }
    compact(sp);
}

# grow the pool to hold cap slots, the mirror making room first
# ---
# ret: false when cap is past the pool's ceiling or either side refused
pub fun grow(sp: *Space, cap: usize) bool {
    if (cap <= sp.cap)                                         { ret true; }
    if (cap > sp.max_slots)                                    { ret false; }
    if (sp.mirrored && !sp.mirror.reserve(sp.mirror.ctx, cap)) { ret false; }
    val grown: err[allo.Error] = alloc_arrays(sp, cap);
    ret sel grown.ok;
}

# the slot of the chunk at (cx, cy), allocating it empty when it does not exist
#
# a new chunk is linked into its neighbours' entries, and its own entry and
# cells and each changed neighbour entry are marked dirty.
# ---
# sp:  the pool
# cx:  chunk column
# cy:  chunk row
# ret: the slot, or NONE when the chunk lies off the grid or the pool is at its
#      ceiling, the allocator or the mirror refused to grow it, or the mirror
#      keeps the pool (own)
pub fun alloc(sp: *Space, cx: i64, cy: i64) u32 {
    if (!own(sp)) { ret NONE; }
    val have: u32 = find(sp, cx, cy);
    if (have != NONE) { ret have; }
    val bounded: bool = topology.bounded(?sp.grid);
    if (bounded && !topology.inside(?sp.grid, cx, cy)) { ret NONE; }
    val t: u32 = claim(sp, cx, cy);
    if (t == NONE) { ret NONE; }
    val s: usize = t::usize;
    val e: *u32  = ?sp.table[s * ENTRY];
    if (bounded) {
        link(sp, s);
        var j: usize = 0;
        for (j < 9) {
            val n: u32 = e[j];
            if (j != 4 && n != NONE && (e[layout.LINK_AT::usize + j] & layout.LINK_SEAM) == 0) {
                sp.table[n::usize * ENTRY + 8 - j] = s::u32;
                sp.dirty[n::usize]                 = sp.dirty[n::usize] | DIRTY_ENTRY;
            }
            j = j + 1;
        }
        if (seamed(sp, s)) { relink_near(sp, cx, cy); }
        ret s::u32;
    }
    e[layout.EDGE_AT::usize] = layout.EDGE_WHOLE;
    var k: usize = 0;
    for (k < 9) {
        e[layout.LINK_AT::usize + k] = layout.plain_link(k::u32);
        val dx: i64 = (k % 3)::i64 - 1;
        val dy: i64 = (k / 3)::i64 - 1;
        var n:  u32 = s::u32;
        if (k != 4) { n = find(sp, cx + dx, cy + dy); }
        e[k] = n;
        if (n != NONE && k != 4) {
            sp.table[n::usize * ENTRY + 8 - k] = s::u32;
            sp.dirty[n::usize]                 = sp.dirty[n::usize] | DIRTY_ENTRY;
        }
        k = k + 1;
    }
    ret s::u32;
}

# take a free slot for the chunk at (cx, cy), which does not exist yet, growing
# the pool when none is free, and make it there empty and unlinked, marked dirty
# ---
# ret: the slot, or NONE when the pool is at its ceiling, or the allocator or
#      the mirror refused to grow it
fun claim(sp: *Space, cx: i64, cy: i64) u32 {
    var s: usize = 0;
    if (sp.nfree != 0) {
        sp.nfree = sp.nfree - 1;
        s        = sp.frees[sp.nfree]::usize;
    }
    or {
        if (sp.hi >= sp.max_slots) { ret NONE; }
        if (sp.hi == sp.cap) {
            var cap: usize = sp.cap * 2;
            if (cap > sp.max_slots)                                    { cap = sp.max_slots; }
            if (sp.mirrored && !sp.mirror.reserve(sp.mirror.ctx, cap)) { ret NONE; }
            val grown: err[allo.Error] = alloc_arrays(sp, cap);
            if (sel grown.err) { ret NONE; }
        }
        s     = sp.hi;
        sp.hi = sp.hi + 1;
    }
    sp.serial = sp.serial + 1;
    if (sp.serial == 0) { sp.serial = 1; }
    val e: *u32 = ?sp.table[s * ENTRY];
    e[9]  = (cx + BIAS)::u32;
    e[10] = (cy + BIAS)::u32;
    e[11] = sp.serial;
    clear_slot(sp, s);
    mem.zero[u32](?sp.census[s * CENSUS], CENSUS);
    hash_put(sp, s);
    sp.live     = sp.live + 1;
    sp.dirty[s] = DIRTY_ENTRY | DIRTY_ZERO;
    if (sp.mips != nil) {
        mem.zero[u32](?sp.mips[s * MIP], MIP);
        sp.dirty[s] = sp.dirty[s] | DIRTY_MIP;
    }
    ret s::u32;
}

# free a slot, unlinking it from its neighbours
pub fun release(sp: *Space, s: usize) {
    if (!own(sp))     { ret; }
    if (!used(sp, s)) { ret; }
    hash_remove(sp, s);
    val e:    *u32  = ?sp.table[s * ENTRY];
    val cx:   i64   = slot_x(sp, s);
    val cy:   i64   = slot_y(sp, s);
    val seam: bool  = seamed(sp, s);
    var k:    usize = 0;
    for (k < 9) {
        val n: u32 = e[k];
        if (n != NONE && k != 4 && (e[layout.LINK_AT::usize + k] & layout.LINK_SEAM) == 0) {
            sp.table[n::usize * ENTRY + 8 - k] = NONE;
            sp.dirty[n::usize]                 = sp.dirty[n::usize] | DIRTY_ENTRY;
        }
        k = k + 1;
    }
    mem.zero[u32](e, ENTRY);
    mem.zero[u32](?sp.census[s * CENSUS], CENSUS);
    sp.dirty[s]        = DIRTY_ENTRY;
    sp.frees[sp.nfree] = s::u32;
    sp.nfree           = sp.nfree + 1;
    sp.live            = sp.live - 1;
    if (seam) { relink_near(sp, cx, cy); }
}

# lower hi past the free slots at the top of the pool, and order the free
# slots so the lowest is handed out first
#
# a mirror works on every slot below hi, free or not, so a pool that once grew
# far, for a wide halo or a pattern that has since died, would otherwise cost
# as much as it did then for as long as one chunk near its top lived on.
pub fun compact(sp: *Space) {
    for (sp.hi > 0 && !used(sp, sp.hi - 1)) { sp.hi = sp.hi - 1; }
    sp.nfree = 0;
    var s: usize = sp.hi;
    for (s > 0) {
        s = s - 1;
        if (!used(sp, s)) {
            sp.frees[sp.nfree] = s::u32;
            sp.nfree           = sp.nfree + 1;
        }
    }
}

# mark a slot asked for, and on a pool held whole due
fun ask(sp: *Space, s: usize) {
    if (sp.asked[s] != 0) { ret; }
    sp.asked[s] = 1;
    if (sp.whole) {
        sp.due[sp.ndue] = s::u32;
        sp.ndue         = sp.ndue + 1;
    }
}

# the slots the CPU's next step of a pool held whole steps, into due: every
# awake one, the chunks the halo of each live one asks for, and the rim where
# it is kept. every other slot holds zeros in both cells and nothing near it
# lives, so its step would write the zeros its back cells hold already
pub fun plan(sp: *Space) {
    var i: usize = 0;
    for (i < sp.ndue) {
        sp.asked[sp.due[i]::usize] = 0;
        i                          = i + 1;
    }
    sp.ndue = 0;
    i       = 0;
    for (i < sp.nawake) {
        val s: usize = sp.awake[i]::usize;
        ask(sp, s);
        if (sp.census[s * CENSUS] != 0) { surround_by(sp, s, sp.census[s * CENSUS + 3]); }
        i = i + 1;
    }
    keep_rim(sp);
}

# after the CPU's step of a pool held whole, keep awake only the slots it
# stepped whose new cells or back cells, the old front, hold something
pub fun doze(sp: *Space) {
    var i: usize = 0;
    for (i < sp.nawake) {
        sp.woke[sp.awake[i]::usize] = 0;
        i                           = i + 1;
    }
    sp.nawake = 0;
    i         = 0;
    for (i < sp.ndue) {
        val s: usize = sp.due[i]::usize;
        val c: *u32  = ?sp.census[s * CENSUS];
        val b: *u32  = ?sp.before[s * CENSUS];
        if ((c[0] | c[1] | b[0] | b[1]) != 0) { wake(sp, s); }
        i = i + 1;
    }
}

# give a chunk the chunks a halo mask asks for, and mark each asked for; a
# pool held whole has every one already, and they are only marked due
# ---
# mask: a bit per chunk of the 5 by 5 block around it, its own ignored
# ret:  false when the pool could not hold them
pub fun surround_by(sp: *Space, s: usize, mask: u32) bool {
    if (topology.bounded(?sp.grid)) { ret surround_grid(sp, s, mask); }
    val cx: i64   = slot_x(sp, s);
    val cy: i64   = slot_y(sp, s);
    val w:  usize = HALO_SIDE::usize;
    var ok: bool  = true;
    var k:  usize = 0;
    for (k < w * w) {
        if (k != HALO_SELF::usize && ((mask >> k::u32) & 1) != 0) {
            val dx: i64 = (k % w)::i64 - (w / 2)::i64;
            val dy: i64 = (k / w)::i64 - (w / 2)::i64;
            var n:  u32 = NONE;
            # an adjacent chunk is in the entry, a further one is looked up
            if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) { n = sp.table[s * ENTRY + ((dy + 1) * 3 + dx + 1)::usize]; }
            if (n == NONE)                                  { n = alloc(sp, cx + dx, cy + dy); }
            if (n == NONE)                                  { ok = false; }
            or                                              { ask(sp, n::usize); }
        }
        k = k + 1;
    }
    ret ok;
}

# the chunks on a bounded grid holding the cells of the chunk at (cx, cy) off
# it once taken across the seams, or the chunk itself where it lies on the grid
# ---
# out: topology.IMAGES_MAX pairs of chunk column and row
# ret: the pairs written
pub fun images(sp: *Space, cx: i64, cy: i64, out: *i64) usize {
    ret topology.images(?sp.grid, cx * SIDE, cy * SIDE, (cx + 1) * SIDE, (cy + 1) * SIDE, out);
}

# surround_by on a bounded grid, where each chunk of the halo is the chunks its
# cells land in
fun surround_grid(sp: *Space, s: usize, mask: u32) bool {
    val cx: i64   = slot_x(sp, s);
    val cy: i64   = slot_y(sp, s);
    val w:  usize = HALO_SIDE::usize;
    var ok: bool  = true;
    var at: [72]i64;
    var k:  usize = 0;
    for (k < w * w) {
        if (k != HALO_SELF::usize && ((mask >> k::u32) & 1) != 0) {
            val dx: i64   = (k % w)::i64 - (w / 2)::i64;
            val dy: i64   = (k / w)::i64 - (w / 2)::i64;
            val n:  usize = images(sp, cx + dx, cy + dy, ?at[0]);
            var i:  usize = 0;
            for (i < n) {
                val t: u32 = alloc(sp, at[i * 2], at[i * 2 + 1]);
                if (t == NONE) { ok = false; }
                or             { ask(sp, t::usize); }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret ok;
}

# cells of spread the halo the host asks for holds: the running rule's ring,
# or the wide halo
pub fun span(sp: *Space) u32 {
    ret halo_span(sp.reach, sp.wide);
}

# give a chunk every chunk the halo the host asks for could ask for, whichever
# quadrants hold its live cells
# ---
# ret: false when the pool could not hold them
pub fun surround(sp: *Space, s: usize) bool {
    ret surround_by(sp, s, halo(0xf, span(sp)));
}

# give a pool keeping its rim every seamed chunk on its grid, each marked asked
#
# a rule whose step reads a plane's dead edge live (cellar.rule.rimmed)
# changes the cells along it with nothing alive near them, so every chunk a
# step reads the edge from is kept, and stepped, as seamed chunks always are.
# only a chunk within one of a chunk not whole on the grid is seamed, so the
# rim is the two chunk rows and columns at each end of a plane bounded both ways.
# a pool held whole has it already, and it is only marked due.
# ---
# ret: false when the pool could not hold them
pub fun keep_rim(sp: *Space) bool {
    if (!sp.rim) { ret true; }
    val g:   *topology.Grid = ?sp.grid;
    val cx0: i64            = chunk_of(topology.left(g));
    val cx1: i64            = chunk_of(topology.left(g) + g.w - 1);
    val cy0: i64            = chunk_of(topology.top(g));
    val cy1: i64            = chunk_of(topology.top(g) + g.h - 1);
    var cy:  i64            = cy0;
    for (cy <= cy1) {
        val across: bool = cy <= cy0 + 1 || cy >= cy1 - 1;
        var cx:     i64  = cx0;
        for (cx <= cx1) {
            if (!across && cx == cx0 + 2 && cx < cx1 - 1) { cx = cx1 - 1; }
            if (topology.seamed(g, cx, cy)) {
                val t: u32 = alloc(sp, cx, cy);
                if (t == NONE) { ret false; }
                ask(sp, t::usize);
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    ret true;
}

# whether a census entry describes the chunk the slot holds now
fun current(sp: *Space, census: *u32, n: usize, s: usize) bool {
    if (s >= n || !used(sp, s)) { ret false; }
    ret census[s * CENSUS + 2] == incarnation(sp, s);
}

# reshape the pool around what a census found
#
# every chunk the census saw holding a live cell gets the chunks its mask asks
# for. then, when frees is set, every chunk the census saw empty and cold that
# no such mask asked for is freed; a chunk allocated since the census was taken
# did not exist then, so it counts as empty. a pool keeping its rim gets it
# and keeps it (keep_rim). a pool held whole has nothing to give and frees
# nothing. the census is copied into the pool's own for the slots it describes.
# ---
# sp:     the pool
# census: CENSUS words per slot
# n:      slots the census covers
# frees:  whether empty chunks may be freed
# ret:    false when the pool could not hold a needed chunk, or the mirror
#         keeps it (own)
pub fun settle(sp: *Space, census: *u32, n: usize, frees: bool) bool {
    if (!own(sp)) { ret false; }
    if (sp.whole) { ret settle_whole(sp, census, n); }
    # the pool's own census moves when surrounding a chunk grows the pool
    val mine: bool = census == sp.census;
    var c:    *u32 = census;
    var ok:   bool = true;
    mem.zero[u8](sp.asked, sp.hi);
    var s: usize = 0;
    for (s < n && s < sp.hi) {
        if (mine) { c = sp.census; }
        if (current(sp, c, n, s) && c[s * CENSUS] != 0) {
            if (!surround_by(sp, s, c[s * CENSUS + 3])) { ok = false; }
        }
        s = s + 1;
    }
    if (!keep_rim(sp)) { ok = false; }
    if (mine)          { c = sp.census; }
    if (frees) {
        val had: usize = sp.nfree;
        s = 0;
        for (s < n && s < sp.hi) {
            if (current(sp, c, n, s) && c[s * CENSUS] == 0 && c[s * CENSUS + 1] == 0 && sp.asked[s] == 0) {
                release(sp, s);
            }
            s = s + 1;
        }
        if (sp.nfree != had) { compact(sp); }
    }
    if (mine) { ret ok; }
    s = 0;
    for (s < n && s < sp.hi) {
        if (current(sp, c, n, s)) { mem.copy[u32](?sp.census[s * CENSUS], ?c[s * CENSUS], CENSUS); }
        s = s + 1;
    }
    ret ok;
}

# settle on a pool held whole, which has every chunk and frees none: a census
# from elsewhere is taken in for the slots it describes, waking those it found
# anything in
fun settle_whole(sp: *Space, census: *u32, n: usize) bool {
    if (census == sp.census) { ret true; }
    var s: usize = 0;
    for (s < n && s < sp.hi) {
        if (current(sp, census, n, s)) {
            val c: *u32 = ?census[s * CENSUS];
            mem.copy[u32](?sp.census[s * CENSUS], c, CENSUS);
            if ((c[0] | c[1]) != 0) { wake(sp, s); }
        }
        s = s + 1;
    }
    ret true;
}

# a rectangle of cells, from (x0, y0) up to but not including (x1, y1)
pub rec Box {
    x0: i64;
    y0: i64;
    x1: i64;
    y1: i64;
}

# the smallest box holding every live cell the census counted
# ---
# sp:  the pool
# ret: the box, or none when the census counted no live cell
pub fun bounds(sp: *Space) opt[Box] {
    var b:   Box   = Box{x0: 0, y0: 0, x1: 0, y1: 0};
    var any: bool  = false;
    var i:   usize = 0;
    for (i < counted(sp)) {
        val s: usize = slot_counted(sp, i);
        val c: *u32  = ?sp.census[s * CENSUS];
        if (c[0] != 0) {
            val ox: i64 = slot_x(sp, s) * SIDE;
            val oy: i64 = slot_y(sp, s) * SIDE;
            val x0: i64 = ox + (c[4] & 63)::i64;
            val y0: i64 = oy + ((c[4] >> layout.EXTENT_Y0) & 63)::i64;
            val x1: i64 = ox + ((c[4] >> layout.EXTENT_X1) & 63)::i64 + 1;
            val y1: i64 = oy + ((c[4] >> layout.EXTENT_Y1) & 63)::i64 + 1;
            if (!any || x0 < b.x0) { b.x0 = x0; }
            if (!any || y0 < b.y0) { b.y0 = y0; }
            if (!any || x1 > b.x1) { b.x1 = x1; }
            if (!any || y1 > b.y1) { b.y1 = y1; }
            any = true;
        }
        i = i + 1;
    }
    if (!any) { ret opt[Box].none{}; }
    ret opt[Box].some{b};
}

# the live cells the census counted
pub fun population(sp: *Space) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < counted(sp)) {
        n = n + sp.census[slot_counted(sp, i) * CENSUS]::usize;
        i = i + 1;
    }
    ret n;
}

# how many slots a count of the census reads: on a pool held whole only the
# awake ones, since every other slot's census is zero
fun counted(sp: *Space) usize {
    if (sp.whole) { ret sp.nawake; }
    ret sp.hi;
}

# the slot a count of the census reads i-th
fun slot_counted(sp: *Space, i: usize) usize {
    if (sp.whole) { ret sp.awake[i]::usize; }
    ret i;
}

# count a slot's live and warm cells into its census from its front cells
pub fun recount(sp: *Space, s: usize) {
    var t: Tally       = tally(sp.sense);
    val c: plane.Plane = plane_of(sp, 0, s);
    var i: usize       = 0;
    for (i < CELLS) {
        note(?t, plane.get(c, i), (i & 63)::u32, (i >> 6)::u32);
        i = i + 1;
    }
    tally_census(?t, ?sp.census[s * CENSUS], incarnation(sp, s));
    if (t.live != 0) { sp.census[s * CENSUS + 3] = halo(t.quads, span(sp)); }
    wake(sp, s);
}

test alloc__links_neighbours_both_ways_and_release_unlinks {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    val made: err[allo.Error] = init(?sp, ?a, true);
    if (sel made.err) { ret 1; }

    val s: u32 = alloc(?sp, -1, 0);
    val t: u32 = alloc(?sp, 0, 0);
    # t is east of s: s names t at 5, t names s at 3
    if (sp.table[s::usize * ENTRY + 5] != t)                       { ret 2; }
    if (sp.table[t::usize * ENTRY + 3] != s)                       { ret 3; }
    if (find(?sp, -1, 0) != s || find(?sp, 0, 0) != t)             { ret 4; }
    if (slot_x(?sp, s::usize) != -1 || slot_y(?sp, s::usize) != 0) { ret 5; }

    release(?sp, s::usize);
    if (sp.table[t::usize * ENTRY + 3] != NONE)           { ret 6; }
    if (find(?sp, -1, 0) != NONE || find(?sp, 0, 0) != t) { ret 7; }
    dnit(?sp);
    ret 0;
}

test alloc__grows_the_pool_and_keeps_every_chunk_findable {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    val made: err[allo.Error] = init(?sp, ?a, false);
    if (sel made.err) { ret 1; }
    var i: i64 = 0;
    for (i < 300) {
        if (alloc(?sp, i % 20 - 10, i / 20 - 7) == NONE) { ret 2; }
        i = i + 1;
    }
    if (sp.live != 300 || sp.cap < 300) { ret 3; }
    # free every other chunk, then every survivor must still be found
    i = 0;
    for (i < 300) {
        if (i % 2 == 0) { release(?sp, find(?sp, i % 20 - 10, i / 20 - 7)::usize); }
        i = i + 1;
    }
    i = 0;
    for (i < 300) {
        val s: u32 = find(?sp, i % 20 - 10, i / 20 - 7);
        if ((i % 2 == 0) != (s == NONE)) { ret 4; }
        i = i + 1;
    }
    dnit(?sp);
    ret 0;
}

test halo__asks_toward_the_quadrants_holding_live_cells {
    # a live cell in the north-west quadrant: west, north and north-west, and
    # with the wide halo the 4 by 4 block reaching two chunks that way
    val wide: u32 = halo_span(1, true);
    if (halo(1, SPREAD_RING) != ((1 << 6) | (1 << 7) | (1 << 11)))             { ret 1; }
    if (wide != SPREAD_WIDE || halo(1, wide) != (0x7bdef & ~(1 << HALO_SELF))) { ret 2; }
    if (halo(0xf, SPREAD_RING) != MASK_RING)                                   { ret 3; }
    if (halo(0xf, wide) != MASK_HALO)                                          { ret 4; }
    if (halo(0, wide) != 0)                                                    { ret 5; }
    # a rule reaching past half a chunk rings every adjacent chunk whatever its
    # quadrants, and widens to every chunk two away
    if (ring(32) != SPREAD_RING || ring(33) != 64 || ring(layout.REACH_MAX::usize) != 64)      { ret 6; }
    if (halo(1, ring(33)) != MASK_RING)                                                        { ret 7; }
    if (halo_span(64, true) != layout.SPREAD_MAX || halo(1, halo_span(64, true)) != MASK_HALO) { ret 8; }
    ret 0;
}

test stage__a_view_takes_the_chunks_in_box_and_leaves_the_rest_marked {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    var view: Space;
    val made: err[allo.Error] = init(?sp, ?a, true);
    if (sel made.err) { ret 1; }
    val mv: err[allo.Error] = init(?view, ?a, false);
    if (sel mv.err) { ret 1; }
    val s:   usize = alloc(?sp, 0, 0)::usize;
    val t:   usize = alloc(?sp, 9, 9)::usize;
    var box: [4]i64;
    mem.zero[i64](?box[0], 4);
    # a full stage copies every chunk, whatever the box
    put_word(?sp, t, 0, 7);
    if (!stage(?view, ?sp, true, ?box[0]))                      { ret 2; }
    if (view.hi != sp.hi || word(?view, t, 0) != 7)             { ret 3; }
    if ((view.dirty[s] & DIRTY_CELLS) == 0 || sp.dirty[s] != 0) { ret 4; }
    if (view.table[t * ENTRY + 9] != sp.table[t * ENTRY + 9])   { ret 5; }
    mem.zero[u8](view.dirty, view.hi);
    # after it, only the chunks in box that changed, the rest keeping their marks
    put_word(?sp, s, 0, 5);
    put_word(?sp, t, 0, 6);
    touch(?sp, s);
    touch(?sp, t);
    if (!stage(?view, ?sp, false, ?box[0]))                           { ret 6; }
    if (word(?view, s, 0) != 5 || (view.dirty[s] & DIRTY_CELLS) == 0) { ret 7; }
    if (word(?view, t, 0) != 7 || (view.dirty[t] & DIRTY_CELLS) != 0) { ret 8; }
    if (sp.dirty[s] != 0 || (sp.dirty[t] & DIRTY_CELLS) == 0)         { ret 9; }
    # until a box takes them in
    box[2] = 9;
    box[3] = 9;
    if (!stage(?view, ?sp, false, ?box[0]))         { ret 10; }
    if (word(?view, t, 0) != 6 || sp.dirty[t] != 0) { ret 11; }
    dnit(?view);
    dnit(?sp);
    ret 0;
}

test compact__lowers_hi_and_hands_out_the_lowest_free_slot_first {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    val made: err[allo.Error] = init(?sp, ?a, false);
    if (sel made.err) { ret 1; }
    var i: i64 = 0;
    for (i < 6) {
        alloc(?sp, i * 10, 0);
        i = i + 1;
    }
    release(?sp, 1);
    release(?sp, 4);
    release(?sp, 5);
    compact(?sp);
    if (sp.hi != 4 || sp.nfree != 1) { ret 2; }
    release(?sp, 3);
    compact(?sp);
    if (sp.hi != 3)                            { ret 3; }
    if (alloc(?sp, 100, 100) != 1)             { ret 4; }
    if (alloc(?sp, 200, 200) != 3)             { ret 5; }
    if (find(?sp, 20, 0) != 2 || sp.live != 4) { ret 6; }
    dnit(?sp);
    ret 0;
}

test settle__gives_a_live_chunk_only_the_neighbours_its_mask_asks_for {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    val made: err[allo.Error] = init(?sp, ?a, false);
    if (sel made.err) { ret 1; }
    val s: usize = alloc(?sp, 0, 0)::usize;
    # live, warm, the chunk's incarnation, and a mask asking north-west, west
    # and two to the west
    sp.census[s * CENSUS]     = 1;
    sp.census[s * CENSUS + 1] = 1;
    sp.census[s * CENSUS + 2] = incarnation(?sp, s);
    sp.census[s * CENSUS + 3] = (1 << 6) | (1 << 11) | (1 << 10);
    if (!settle(?sp, sp.census, sp.hi, true))                                              { ret 2; }
    if (sp.live != 4)                                                                      { ret 3; }
    if (find(?sp, -1, 0) == NONE || find(?sp, -1, -1) == NONE || find(?sp, -2, 0) == NONE) { ret 4; }
    # the asked-for chunks stay while the live chunk asks, and go once it does not
    sp.census[s * CENSUS + 3] = 0;
    sp.census[s * CENSUS]     = 0;
    sp.census[s * CENSUS + 1] = 0;
    if (!settle(?sp, sp.census, sp.hi, true)) { ret 5; }
    dnit(?sp);
    ret 0;
}

test cover__holds_every_chunk_of_a_grid_that_fits_until_its_ceiling_drops {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   Space;
    val made: err[allo.Error] = init(?sp, ?a, true);
    if (sel made.err) { ret 1; }
    # a 200 by 120 torus spans 4 by 2 chunks, every one linked across the seams
    val t: res[topology.Grid, str] = topology.parse("T200,120");
    if (sel t.err) { ret 2; }
    set_grid(?sp, t.ok);
    if (!sp.whole || sp.live != 8 || grid_chunks(?sp.grid) != 8) { ret 3; }
    val w: u32 = find(?sp, -2, 0);
    if (w == NONE || sp.table[w::usize * ENTRY + 3] != find(?sp, 1, 0)) { ret 4; }
    # an empty census frees nothing, and a clear holds every chunk again
    val serial: u32 = sp.serial;
    if (!settle(?sp, sp.census, sp.hi, true) || sp.live != 8 || sp.serial != serial) { ret 5; }
    reset(?sp);
    if (!sp.whole || sp.live != 8) { ret 6; }
    # a ceiling lowered below the grid lets go of every chunk but the live one
    # and its halo, and shrinks the pool to it
    sp.sense.live_mask = 1;
    sp.sense.live_lo   = 1;
    sp.sense.live_hi   = 1;
    sp.sense.warm_mask = 1;
    put_word(?sp, find(?sp, 0, 0)::usize, 65, 1);
    limit(?sp, 7);
    val o: u32 = find(?sp, 0, 0);
    if (sp.whole || sp.live >= 8 || sp.cap != 7 || o == NONE || word(?sp, o::usize, 65) != 1) { ret 7; }
    # a grid past the ceiling, or with an unbounded axis, is not held whole
    set_grid(?sp, t.ok);
    if (sp.whole) { ret 10; }
    sp.max_slots = HOST_SLOTS;
    val p: res[topology.Grid, str] = topology.parse("P200,0");
    if (sel p.err) { ret 8; }
    set_grid(?sp, p.ok);
    if (sp.whole || grid_chunks(?sp.grid) != 0) { ret 9; }
    dnit(?sp);
    ret 0;
}
