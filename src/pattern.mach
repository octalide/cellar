# fixed-capacity cell patterns and stamping them onto the world
#
# the library holds the built-in patterns and the user-drawn custom one. a pattern is a small dense w x h grid of 0/1 cells held in a fixed [CAP] buffer,
# so any pattern with w*h <= CAP fits regardless of its side lengths. the built-ins
# are described as rows of '#'/'.' text and parsed once on demand; stamping places
# a pattern's live cells onto the unbounded world, centered on a target cell.

use cellar.sim;
use allo: std.allocator;
use std.allocator.page;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

# cell-buffer capacity; a pattern is valid while w*h <= CAP
pub val CAP: usize = 1024;

# number of patterns reachable through builtin()/builtin_name()
pub val BUILTIN_COUNT: usize = 7;

# a small dense grid of 0/1 cells with a display name
# ---
# cells: row-major 0/1 cells, length w*h, capacity CAP
# w:     width in cells
# h:     height in cells, with w*h <= CAP
# name:  short display label
pub rec Pattern {
    cells: [1024]u8;
    w:     usize;
    h:     usize;
    name:  str;
}

# set a pattern's dimensions and name and zero its cells
# ---
# p:    pattern to initialize
# w:    width in cells
# h:    height in cells (w*h must not exceed CAP)
# name: display label
pub fun init(p: *Pattern, w: usize, h: usize, name: str) {
    p.w    = w;
    p.h    = h;
    p.name = name;
    clear(p);
}

# zero every cell, preserving the pattern's dimensions and name
# ---
# p: pattern to clear
pub fun clear(p: *Pattern) {
    val n: usize = p.w * p.h;
    var i: usize = 0;
    for (i < n) {
        p.cells[i] = 0;
        i          = i + 1;
    }
}

# the cell at (x, y). caller guarantees x < w and y < h
# ---
# p:   pattern
# x:   column in [0, w)
# y:   row in [0, h)
# ret: 0 or 1
pub fun get(p: *Pattern, x: usize, y: usize) u8 {
    ret p.cells[y * p.w + x];
}

# write v to the cell at (x, y)
# ---
# p: pattern
# x: column in [0, w)
# y: row in [0, h)
# v: new value (0 or 1)
pub fun set(p: *Pattern, x: usize, y: usize, v: u8) {
    p.cells[y * p.w + x] = v;
}

# build a pattern from h row strings of w chars each, '#' live and any
# other char dead.
# ---
# name: display label
# w:    width in cells
# h:    height in cells
# rows: pointer to an array of h row strings (pass ?arr[0])
# ret:  the parsed pattern
fun from_rows(name: str, w: usize, h: usize, rows: *str) Pattern {
    var p: Pattern;
    p.w    = w;
    p.h    = h;
    p.name = name;
    var y: usize = 0;
    for (y < h) {
        val row: str   = rows[y];
        var x:   usize = 0;
        for (x < w) {
            var v: u8 = 0;
            if (row[x] == '#') { v = 1; }
            p.cells[y * w + x] = v;
            x                  = x + 1;
        }
        y = y + 1;
    }
    ret p;
}

# the classic 3x3 diagonal spaceship
fun glider() Pattern {
    var r: [3]str;
    r[0] = ".#.";
    r[1] = "..#";
    r[2] = "###";
    ret from_rows("glider", 3, 3, ?r[0]);
}

# the period-two 3x1 oscillator
fun blinker() Pattern {
    var r: [1]str;
    r[0] = "###";
    ret from_rows("blinker", 3, 1, ?r[0]);
}

# the 2x2 still life
fun block() Pattern {
    var r: [2]str;
    r[0] = "##";
    r[1] = "##";
    ret from_rows("block", 2, 2, ?r[0]);
}

# the 4x3 still life
fun beehive() Pattern {
    var r: [3]str;
    r[0] = ".##.";
    r[1] = "#..#";
    r[2] = ".##.";
    ret from_rows("beehive", 4, 3, ?r[0]);
}

# the lightweight spaceship, a 5x4 orthogonal glider
fun lwss() Pattern {
    var r: [4]str;
    r[0] = ".#..#";
    r[1] = "#....";
    r[2] = "#...#";
    r[3] = "####.";
    ret from_rows("lwss", 5, 4, ?r[0]);
}

# the 13x13 period-three oscillator
fun pulsar() Pattern {
    var r: [13]str;
    r[0]  = "..###...###..";
    r[1]  = ".............";
    r[2]  = "#....#.#....#";
    r[3]  = "#....#.#....#";
    r[4]  = "#....#.#....#";
    r[5]  = "..###...###..";
    r[6]  = ".............";
    r[7]  = "..###...###..";
    r[8]  = "#....#.#....#";
    r[9]  = "#....#.#....#";
    r[10] = "#....#.#....#";
    r[11] = ".............";
    r[12] = "..###...###..";
    ret from_rows("pulsar", 13, 13, ?r[0]);
}

# the Gosper glider gun, a 36x9 emitter of gliders
fun gun() Pattern {
    var r: [9]str;
    r[0] = "........................#...........";
    r[1] = "......................#.#...........";
    r[2] = "............##......##............##";
    r[3] = "...........#...#....##............##";
    r[4] = "##........#.....#...##..............";
    r[5] = "##........#...#.##....#.#...........";
    r[6] = "..........#.....#.......#...........";
    r[7] = "...........#...#....................";
    r[8] = "............##......................";
    ret from_rows("gosper gun", 36, 9, ?r[0]);
}

# the i-th built-in pattern, for i in [0, BUILTIN_COUNT)
# ---
# i:   built-in index
# ret: the pattern (the gun for any out-of-range index)
pub fun builtin(i: usize) Pattern {
    if (i == 0) { ret glider(); }
    if (i == 1) { ret blinker(); }
    if (i == 2) { ret block(); }
    if (i == 3) { ret beehive(); }
    if (i == 4) { ret lwss(); }
    if (i == 5) { ret pulsar(); }
    ret gun();
}

# the display label of the i-th built-in, for dropdown options
# ---
# i:   built-in index
# ret: the label
pub fun builtin_name(i: usize) str {
    if (i == 0) { ret "glider"; }
    if (i == 1) { ret "blinker"; }
    if (i == 2) { ret "block"; }
    if (i == 3) { ret "beehive"; }
    if (i == 4) { ret "lwss"; }
    if (i == 5) { ret "pulsar"; }
    ret "gosper gun";
}

# place a pattern's live cells onto the world, centered on cell (cx, cy)
#
# the pattern's top-left lands at (cx - w/2, cy - h/2). only live pattern cells
# are written (via sim.paint, keeping age/heat consistent); dead pattern cells
# leave the world untouched, so a stamp overlays rather than erases.
# ---
# s:  simulation to stamp onto
# p:  pattern to place
# cx: target column the pattern is centered on
# cy: target row the pattern is centered on
pub fun stamp(s: *sim.Sim, p: *Pattern, cx: i64, cy: i64) {
    val ox: i64   = cx - (p.w / 2)::i64;
    val oy: i64   = cy - (p.h / 2)::i64;
    var y:  usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            if (get(p, x, y) != 0) { sim.paint(s, ox + x::i64, oy + y::i64, 1); }
            x = x + 1;
        }
        y = y + 1;
    }
}

test stamp__places_a_glider_centered {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }

    var g: Pattern = glider();
    # centered on (0, 0): top-left at (-1, -1), across four chunks
    stamp(?s, ?g, 0, 0);

    # the glider's live offsets, shifted by (-1, -1)
    if (!sim.alive(?s, 0, -1)) { ret 1; }
    if (!sim.alive(?s, 1, 0))  { ret 1; }
    if (!sim.alive(?s, -1, 1)) { ret 1; }
    if (!sim.alive(?s, 0, 1))  { ret 1; }
    if (!sim.alive(?s, 1, 1))  { ret 1; }

    # a dead pattern cell leaves the world clear, and the live count is exactly five
    if (sim.alive(?s, -1, -1))   { ret 1; }
    if (sim.population(?s) != 5) { ret 1; }

    sim.dnit(?s);
    ret 0;
}

test set__toggles_custom_cells_in_place {
    var p: Pattern;
    init(?p, 16, 16, "custom");
    if (get(?p, 3, 4) != 0) { ret 1; }
    set(?p, 3, 4, 1);
    if (get(?p, 3, 4) != 1) { ret 1; }
    clear(?p);
    if (get(?p, 3, 4) != 0) { ret 1; }
    # dimensions survive a clear
    if (p.w != 16 || p.h != 16) { ret 1; }
    ret 0;
}
