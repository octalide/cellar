# heap-backed cell patterns and placing them onto the world
#
# a pattern is a dense w x h grid of u8 states of any size, plus the metadata
# a pattern file carries: a name, a rule string, free comments and an origin. state 0
# is dead and any other state is live, which leaves room for multi-state rules.
# readers fill cells through set or a whole row at a time, writers walk a row as
# runs of equal states with run, and place writes a pattern onto the unbounded
# world through the simulation's bulk edit, so a large pattern costs one edit.
#
# a pattern may hold its cells' words beside their states: the words of the
# rule it names, each cell's exact values in its state and rule layers
# (cellar.layer), which its states only approximate. capture reads them from a
# world whose rule keeps words (rule.keeps_words), and place writes them back
# exactly onto a world whose rule reads them alike (rule.alike), and the
# states otherwise. a rule whose state is all its word never gives a pattern
# words, so its patterns hold states as they always have.

use rules: cellar.rule;
use cellar.sim;
use allo: std.allocator;
use std.allocator.page;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.OwnedString;
use std.types.string.str;

# the longest side a pattern may have, so w * h never overflows
pub val MAX_SIDE: usize = 1073741824;
# the most cells a pattern may hold, a byte each, so a gigabyte as the world's
# host pool is
pub val MAX_CELLS: usize = 1073741824;

# a dense grid of u8 states with metadata, owning its cells and text
# ---
# a:        allocator backing the cells and text; nil before init
# cells:    row-major states, length w*h, nil when empty
# words:    row-major words of the rule the pattern names, a cell's values
#           together, length w*h*values, nil when it holds states alone
# values:   values a word holds, its rule's state and rule layers'
#           (cellar.layer), while it holds words
# w:        width in cells
# h:        height in cells
# x:        the world column the source placed the top-left cell at, 0 when it gave none
# y:        the world row the source placed the top-left cell at, 0 when it gave none
# name:     short display label
# rule:     the rule string the source named, empty when none
# comments: free text the source carried, empty when none
# seen:     the stamp a drawing last gave the cells, 0 once they change (cellar.sketch)
pub rec Pattern {
    a:        *allo.Allocator;
    cells:    *u8;
    words:    *u32;
    values:   usize;
    w:        usize;
    h:        usize;
    x:        i64;
    y:        i64;
    name:     OwnedString;
    rule:     OwnedString;
    comments: OwnedString;
    seen:     u64;
}

# an empty-text view of an owned string
fun text_of(o: *OwnedString) str {
    if (o.data == nil) { ret ""; }
    ret o.data;
}

# replace an owned string with a copy of s
fun assign(a: *allo.Allocator, o: *OwnedString, s: str) err[allo.Error] {
    val d: res[OwnedString, allo.Error] = string.owned_dup(a, s);
    if (sel d.err) { ret err[allo.Error].err{d.err}; }
    string.owned_release(o);
    @o = d.ok;
    ret err[allo.Error].ok{};
}

# make a pattern of w x h dead cells with a name
# ---
# p:    pattern to initialize; it owns what it allocates until dnit
# a:    allocator for the cells and text, which must outlive the pattern
# w:    width in cells, see holds
# h:    height in cells, see holds
# name: display label, copied
# ret:  ok, or the allocator's refusal, leaving p empty
pub fun init(p: *Pattern, a: *allo.Allocator, w: usize, h: usize, name: str) err[allo.Error] {
    p.a        = a;
    p.cells    = nil;
    p.words    = nil;
    p.values   = 0;
    p.w        = 0;
    p.h        = 0;
    p.seen     = 0;
    p.x        = 0;
    p.y        = 0;
    p.name     = string.owned_adopt(a, nil, 0, 0);
    p.rule     = string.owned_adopt(a, nil, 0, 0);
    p.comments = string.owned_adopt(a, nil, 0, 0);
    val e: err[allo.Error] = resize(p, w, h);
    if (sel e.err) { ret e; }
    val n: err[allo.Error] = set_name(p, name);
    if (sel n.err) {
        dnit(p);
        ret n;
    }
    ret err[allo.Error].ok{};
}

# release everything a pattern owns
pub fun dnit(p: *Pattern) {
    if (p.a == nil)     { ret; }
    if (p.cells != nil) { allo.deallocate[u8](p.a, p.cells, p.w * p.h); }
    drop_words(p);
    string.owned_release(?p.name);
    string.owned_release(?p.rule);
    string.owned_release(?p.comments);
    p.cells = nil;
    p.w     = 0;
    p.h     = 0;
    p.a     = nil;
}

# whether a pattern may be w by h: each side at most MAX_SIDE and the cells at most MAX_CELLS
pub fun holds(w: u64, h: u64) bool {
    if (w > MAX_SIDE::u64 || h > MAX_SIDE::u64) { ret false; }
    ret w == 0 || h <= MAX_CELLS::u64 / w;
}

# give a pattern new dimensions with every cell dead, holding states alone,
# keeping its metadata
# ---
# p:   pattern
# w:   new width, see holds
# h:   new height, see holds
# ret: ok, or the allocator's refusal, leaving p as it was
pub fun resize(p: *Pattern, w: usize, h: usize) err[allo.Error] {
    if (!holds(w::u64, h::u64)) { ret err[allo.Error].err{allo.Error.invalid{}}; }
    var fresh: *u8 = nil;
    if (w * h != 0) {
        val r: res[*u8, allo.Error] = allo.zallocate[u8](p.a, w * h);
        if (sel r.err) { ret err[allo.Error].err{r.err}; }
        fresh = r.ok;
    }
    if (p.cells != nil) { allo.deallocate[u8](p.a, p.cells, p.w * p.h); }
    drop_words(p);
    p.cells = fresh;
    p.w     = w;
    p.h     = h;
    p.seen  = 0;
    ret err[allo.Error].ok{};
}

# whether a pattern holds its cells' words beside their states
pub fun exact(p: *Pattern) bool {
    ret p.words != nil;
}

# give a pattern words of n values, every one 0, the quiescent background,
# unless it has words of n values already
# ---
# p:   pattern, whose cells are all dead
# n:   values a word holds, at least 1
# ret: ok, or the allocator's refusal, leaving p as it was
pub fun hold_words(p: *Pattern, n: usize) err[allo.Error] {
    if ((p.words != nil && p.values == n) || p.w * p.h == 0) { ret err[allo.Error].ok{}; }
    val r: res[*u32, allo.Error] = allo.zallocate[u32](p.a, p.w * p.h * n);
    if (sel r.err) { ret err[allo.Error].err{r.err}; }
    drop_words(p);
    p.words  = r.ok;
    p.values = n;
    ret err[allo.Error].ok{};
}

# let a pattern hold states alone
fun drop_words(p: *Pattern) {
    if (p.words != nil) { allo.deallocate[u32](p.a, p.words, p.w * p.h * p.values); }
    p.words  = nil;
    p.values = 0;
}

# copy a pattern's cells, dimensions and metadata into dst
# ---
# dst: pattern to initialize; it owns the copy until dnit
# a:   allocator for the copy
# src: pattern to copy
# ret: ok, or the allocator's refusal, leaving dst empty
pub fun clone(dst: *Pattern, a: *allo.Allocator, src: *Pattern) err[allo.Error] {
    val e: err[allo.Error] = init(dst, a, src.w, src.h, name(src));
    if (sel e.err)        { ret e; }
    if (src.cells != nil) { mem.copy[u8](dst.cells, src.cells, src.w * src.h); }
    if (src.words != nil) {
        val held: err[allo.Error] = hold_words(dst, src.values);
        if (sel held.err) {
            dnit(dst);
            ret held;
        }
        mem.copy[u32](dst.words, src.words, src.w * src.h * src.values);
    }
    dst.x = src.x;
    dst.y = src.y;
    val r: err[allo.Error] = set_rule(dst, rule(src));
    if (sel r.err) {
        dnit(dst);
        ret r;
    }
    val c: err[allo.Error] = set_comments(dst, comments(src));
    if (sel c.err) {
        dnit(dst);
        ret c;
    }
    ret err[allo.Error].ok{};
}

# the display label, empty when none
pub fun name(p: *Pattern) str {
    ret text_of(?p.name);
}

# the rule string the source named, empty when none
pub fun rule(p: *Pattern) str {
    ret text_of(?p.rule);
}

# the comments the source carried, empty when none
pub fun comments(p: *Pattern) str {
    ret text_of(?p.comments);
}

# replace the display label with a copy of s
pub fun set_name(p: *Pattern, s: str) err[allo.Error] {
    ret assign(p.a, ?p.name, s);
}

# replace the rule string with a copy of s
pub fun set_rule(p: *Pattern, s: str) err[allo.Error] {
    ret assign(p.a, ?p.rule, s);
}

# replace the comments with a copy of s
pub fun set_comments(p: *Pattern, s: str) err[allo.Error] {
    ret assign(p.a, ?p.comments, s);
}

# kill every cell, preserving the pattern's dimensions and metadata
# ---
# p: pattern to clear
pub fun clear(p: *Pattern) {
    if (p.cells != nil) { mem.zero[u8](p.cells, p.w * p.h); }
    if (p.words != nil) { mem.zero[u32](p.words, p.w * p.h * p.values); }
    p.seen = 0;
}

# the state at (x, y). caller guarantees x < w and y < h
# ---
# p:   pattern
# x:   column in [0, w)
# y:   row in [0, h)
# ret: the state, 0 when dead
pub fun get(p: *Pattern, x: usize, y: usize) u8 {
    ret p.cells[y * p.w + x];
}

# write state v to the cell at (x, y). a state alone has no word, so a pattern
# holding words holds states alone from then on
# ---
# p: pattern
# x: column in [0, w)
# y: row in [0, h)
# v: new state
pub fun set(p: *Pattern, x: usize, y: usize, v: u8) {
    drop_words(p);
    p.cells[y * p.w + x] = v;
    p.seen               = 0;
}

# the word at (x, y) of a pattern holding words, its values. caller
# guarantees x < w and y < h
pub fun word(p: *Pattern, x: usize, y: usize) *u32 {
    ret ?p.words[(y * p.w + x) * p.values];
}

# whether the word at (x, y) of a pattern holding words is the quiescent
# background's, every value 0
pub fun blank(p: *Pattern, x: usize, y: usize) bool {
    val c: *u32  = word(p, x, y);
    var k: usize = 0;
    for (k < p.values) {
        if (c[k] != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# write word c, which holds state v, to the cell at (x, y) of a pattern holding words
# ---
# p: pattern, exact
# x: column in [0, w)
# y: row in [0, h)
# c: the word's values, of the rule the pattern names
# v: the state it holds
pub fun set_word(p: *Pattern, x: usize, y: usize, c: *u32, v: u8) {
    mem.copy[u32](word(p, x, y), c, p.values);
    p.cells[y * p.w + x] = v;
    p.seen               = 0;
}

# the state at (x, y) and how many cells from there along the row share it
#
# walking a row as runs lets a writer of a run-length format, or a placement onto
# the world, handle a long stretch of equal cells at once
# ---
# p:   pattern
# x:   column in [0, w)
# y:   row in [0, h)
# n:   receives the run's length, at least 1, reaching no further than the row's end
# ret: the state the run holds
pub fun run(p: *Pattern, x: usize, y: usize, n: *usize) u8 {
    val row: *u8   = ?p.cells[y * p.w];
    val v:   u8    = row[x];
    var i:   usize = x + 1;
    for (i < p.w && row[i] == v) { i = i + 1; }
    @n = i - x;
    ret v;
}

# the word at (x, y) of a pattern holding words, and how many cells from there
# along the row hold it too
# ---
# p:   pattern, exact
# x:   column in [0, w)
# y:   row in [0, h)
# n:   receives the run's length, at least 1, reaching no further than the row's end
# ret: the word the run holds, its values
pub fun run_word(p: *Pattern, x: usize, y: usize, n: *usize) *u32 {
    val c: *u32  = word(p, x, y);
    var i: usize = x + 1;
    for (i < p.w && mem.equal[u32](word(p, i, y), c, p.values)) { i = i + 1; }
    @n = i - x;
    ret c;
}

# whether a pattern's words read alike under the world's rule, so place writes them
fun fits_words(s: *sim.Sim, p: *Pattern) bool {
    if (p.words == nil || sim.flipped(s)) { ret false; }
    val named: res[rules.Rule, str] = rules.parse(rule(p));
    if (sel named.err) { ret false; }
    ret rules.alike(?named.ok, ?s.rule);
}

# write a pattern onto the world with its top-left at (ox, oy), in one bulk edit
#
# runs of live cells are written as runs. with replace the pattern's dead cells
# erase what they cover, otherwise they leave the world untouched and the
# pattern overlays it. a state is written as live whatever its value. a
# pattern's words are written as they are where the world's rule reads them
# alike, and a cell whose word is not 0 is not dead though its state is.
# ---
# s:       simulation to write onto
# p:       pattern to place
# ox:      world column of the pattern's left edge
# oy:      world row of the pattern's top edge
# replace: dead pattern cells erase
# ret:     false when the edit could not be made or the pool could not hold it all
pub fun place(s: *sim.Sim, p: *Pattern, ox: i64, oy: i64, replace: bool) bool {
    if (p.w == 0 || p.h == 0) { ret true; }
    val words: bool = fits_words(s, p);
    if (!sim.edit_begin(s, ox, oy, ox + p.w::i64, oy + p.h::i64)) { ret false; }
    var y: usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            var n: usize = 0;
            if (words) {
                # a stretch of cells that are not 0, or the rest of the row
                var e: usize = x;
                for (e < p.w && (replace || !blank(p, e, y))) { e = e + 1; }
                if (e > x) { sim.edit_words(s, ox + x::i64, oy + y::i64, e - x, word(p, x, y)); }
                n = e - x;
                if (n == 0) { run_word(p, x, y, ?n); }
            }
            or {
                val v: u8 = run(p, x, y, ?n);
                if (v != 0 || replace) { sim.edit_run(s, ox + x::i64, oy + y::i64, n, v); }
            }
            x = x + n;
        }
        y = y + 1;
    }
    ret sim.edit_end(s);
}

# read the cells of [x0, x1) by [y0, y1) into a pattern, the reverse of place
#
# the pattern takes the area's size and its origin, keeping its metadata, and
# the cells are read through the simulation's open read, which must cover the
# area. under a rule whose words hold more than its states the words are read
# too (cellar.rule keeps_words), and the pattern names the rule they are read
# under.
# ---
# p:   pattern to fill, initialized
# s:   simulation with a read open over the area
# x0:  first column
# y0:  first row
# x1:  column after the last
# y1:  row after the last
# ret: ok, or the allocator's refusal or invalid when the area is too large or
#      no read covers it, leaving p as it was or emptied
pub fun capture(p: *Pattern, s: *sim.Sim, x0: i64, y0: i64, x1: i64, y1: i64) err[allo.Error] {
    var w: usize = 0;
    var h: usize = 0;
    if (x1 > x0 && y1 > y0) {
        if ((x1 - x0)::u64 > MAX_SIDE::u64 || (y1 - y0)::u64 > MAX_SIDE::u64) { ret err[allo.Error].err{allo.Error.invalid{}}; }
        w = (x1 - x0)::usize;
        h = (y1 - y0)::usize;
    }
    val e: err[allo.Error] = resize(p, w, h);
    if (sel e.err) { ret e; }
    p.x = x0;
    p.y = y0;
    val words: bool = rules.keeps_words(?s.rule) && !sim.flipped(s);
    if (words) {
        var text:  [rules.FORMAT_MAX + 1]u8;
        val named: err[allo.Error] = set_rule(p, rules.format(?s.rule, ?text[0]));
        if (sel named.err) { ret named; }
        val held: err[allo.Error] = hold_words(p, sim.word_len(s));
        if (sel held.err) { ret held; }
    }
    var y: usize = 0;
    for (y < h) {
        var ok: bool = sim.read_run(s, x0, y0 + y::i64, w, ?p.cells[y * w]);
        if (ok && words) { ok = sim.read_words(s, x0, y0 + y::i64, w, word(p, 0, y)); }
        if (!ok) {
            resize(p, 0, 0);
            ret err[allo.Error].err{allo.Error.invalid{}};
        }
        y = y + 1;
    }
    ret err[allo.Error].ok{};
}

# an orientation is one of the eight ways to lay a pattern down: the pattern is
# mirrored left to right when ORIENT_FLIP is set, then turned clockwise by
# (o & ORIENT_TURNS) quarter turns. 0 is the pattern as drawn.
pub val ORIENT_COUNT: u8 = 8;
pub val ORIENT_FLIP:  u8 = 4;
pub val ORIENT_TURNS: u8 = 3;

# the next orientation after a quarter turn clockwise, keeping the mirroring
pub fun orient_turn(o: u8) u8 {
    ret (o & ORIENT_FLIP) | ((o + 1) & ORIENT_TURNS);
}

# the orientation of the shape o shows, mirrored left to right
#
# the mirror composes outside the turns, so it also reverses their direction
pub fun orient_flip(o: u8) u8 {
    ret (o ^ ORIENT_FLIP) & ~ORIENT_TURNS | ((4 - (o & ORIENT_TURNS)) & ORIENT_TURNS);
}

# the width of a pattern laid down in orientation o
pub fun width(p: *Pattern, o: u8) usize {
    if ((o & 1) != 0) { ret p.h; }
    ret p.w;
}

# the height of a pattern laid down in orientation o
pub fun height(p: *Pattern, o: u8) usize {
    if ((o & 1) != 0) { ret p.w; }
    ret p.h;
}

# the state at (x, y) of a pattern laid down in orientation o
# ---
# p:   pattern
# o:   orientation, below ORIENT_COUNT
# x:   column in [0, width(p, o))
# y:   row in [0, height(p, o))
# ret: the state, 0 when dead
pub fun get_oriented(p: *Pattern, o: u8, x: usize, y: usize) u8 {
    ret p.cells[oriented(p, o, x, y)];
}

# the index into a pattern's cells of (x, y) of it laid down in orientation o
fun oriented(p: *Pattern, o: u8, x: usize, y: usize) usize {
    # undo the turns to find the cell in the mirrored pattern, then undo the mirror
    val t:  u8    = o & ORIENT_TURNS;
    var sx: usize = x;
    var sy: usize = y;
    if (t == 1) {
        sx = y;
        sy = p.h - 1 - x;
    }
    or (t == 2) {
        sx = p.w - 1 - x;
        sy = p.h - 1 - y;
    }
    or (t == 3) {
        sx = p.w - 1 - y;
        sy = x;
    }
    if ((o & ORIENT_FLIP) != 0) { sx = p.w - 1 - sx; }
    ret sy * p.w + sx;
}

# make dst the pattern p laid down in orientation o, with p's metadata and words
# ---
# dst: pattern to initialize; it owns the copy until dnit
# a:   allocator for the copy
# p:   pattern to copy
# o:   orientation, below ORIENT_COUNT
# ret: ok, or the allocator's refusal, leaving dst empty
pub fun orient(dst: *Pattern, a: *allo.Allocator, p: *Pattern, o: u8) err[allo.Error] {
    val e: err[allo.Error] = clone(dst, a, p);
    if (sel e.err) { ret e; }
    val w: usize           = width(p, o);
    val h: usize           = height(p, o);
    val r: err[allo.Error] = resize(dst, w, h);
    if (sel r.err) {
        dnit(dst);
        ret r;
    }
    if (p.words != nil) {
        val held: err[allo.Error] = hold_words(dst, p.values);
        if (sel held.err) {
            dnit(dst);
            ret held;
        }
    }
    var y: usize = 0;
    for (y < h) {
        var x: usize = 0;
        for (x < w) {
            val i: usize = oriented(p, o, x, y);
            dst.cells[y * w + x] = p.cells[i];
            if (p.words != nil) { mem.copy[u32](word(dst, x, y), ?p.words[i * p.values], p.values); }
            x = x + 1;
        }
        y = y + 1;
    }
    ret err[allo.Error].ok{};
}

# the world cell a pattern of size w x h is placed at when centered on a cell
# ---
# c: the cell's column or row
# n: the pattern's width or height there
pub fun corner(c: i64, n: usize) i64 {
    ret c - (n / 2)::i64;
}

# overlay a pattern onto the world, centered on cell (cx, cy)
#
# the pattern's top-left lands at (cx - w/2, cy - h/2). dead pattern cells leave
# the world untouched, so a stamp overlays rather than erases.
# ---
# s:  simulation to stamp onto
# p:  pattern to place
# cx: target column the pattern is centered on
# cy: target row the pattern is centered on
pub fun stamp(s: *sim.Sim, p: *Pattern, cx: i64, cy: i64) {
    place(s, p, corner(cx, p.w), corner(cy, p.h), false);
}

test stamp__places_a_glider_centered {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }

    var g: Pattern;
    val b: err[allo.Error] = init(?g, ?a, 3, 3, "glider");
    if (sel b.err) { ret 1; }
    set(?g, 1, 0, 1);
    set(?g, 2, 1, 1);
    set(?g, 0, 2, 1);
    set(?g, 1, 2, 1);
    set(?g, 2, 2, 1);
    # centered on (0, 0): top-left at (-1, -1), across four chunks
    stamp(?s, ?g, 0, 0);

    # the glider's live offsets, shifted by (-1, -1)
    if (!sim.alive(?s, 0, -1)) { ret 1; }
    if (!sim.alive(?s, 1, 0))  { ret 1; }
    if (!sim.alive(?s, -1, 1)) { ret 1; }
    if (!sim.alive(?s, 0, 1))  { ret 1; }
    if (!sim.alive(?s, 1, 1))  { ret 1; }

    # a dead pattern cell leaves the world clear, and the live count is exactly five
    if (sim.alive(?s, -1, -1))   { ret 1; }
    if (sim.population(?s) != 5) { ret 1; }

    dnit(?g);
    sim.dnit(?s);
    ret 0;
}

test stamp__writes_a_large_pattern_and_replace_erases {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }

    # 400 x 300 with every third cell live, across many chunks
    var p:   Pattern;
    val big: err[allo.Error] = init(?p, ?a, 400, 300, "big");
    if (sel big.err) { ret 2; }
    var y: usize = 0;
    for (y < 300) {
        var x: usize = 0;
        for (x < 400) {
            if ((x + y) % 3 == 0) { set(?p, x, y, 1); }
            x = x + 1;
        }
        y = y + 1;
    }
    var live: usize = 0;
    y = 0;
    for (y < 300) {
        var x: usize = 0;
        for (x < 400) {
            var n: usize = 0;
            if (run(?p, x, y, ?n) != 0) { live = live + n; }
            x = x + n;
        }
        y = y + 1;
    }

    if (!place(?s, ?p, -200, -150, false))                       { ret 3; }
    if (sim.population(?s) != live)                              { ret 4; }
    if (!sim.alive(?s, -200, -150) || sim.alive(?s, -199, -150)) { ret 5; }

    # a pattern of dead cells replaces what it covers
    var z:    Pattern;
    val zero: err[allo.Error] = init(?z, ?a, 300, 200, "hole");
    if (sel zero.err)                     { ret 6; }
    if (!place(?s, ?z, -200, -150, true)) { ret 7; }
    if (sim.alive(?s, -200, -150))        { ret 8; }
    if (sim.population(?s) >= live)       { ret 9; }

    dnit(?p);
    dnit(?z);
    sim.dnit(?s);
    ret 0;
}

test set__toggles_custom_cells_in_place {
    var a: allo.Allocator;
    page.make(?a);
    var p:    Pattern;
    val made: err[allo.Error] = init(?p, ?a, 16, 16, "custom");
    if (sel made.err)       { ret 1; }
    if (get(?p, 3, 4) != 0) { ret 1; }
    set(?p, 3, 4, 1);
    if (get(?p, 3, 4) != 1) { ret 1; }
    clear(?p);
    if (get(?p, 3, 4) != 0) { ret 1; }
    # dimensions survive a clear
    if (p.w != 16 || p.h != 16) { ret 1; }
    dnit(?p);
    ret 0;
}

test clone__copies_cells_and_metadata {
    var a: allo.Allocator;
    page.make(?a);
    var p:    Pattern;
    val made: err[allo.Error] = init(?p, ?a, 5, 2, "src");
    if (sel made.err) { ret 1; }
    set(?p, 4, 1, 7);
    set_rule(?p, "B36/S23");
    set_comments(?p, "two lines");
    p.x = -3;
    var q: Pattern;
    val c: err[allo.Error] = clone(?q, ?a, ?p);
    if (sel c.err) { ret 2; }
    dnit(?p);
    if (get(?q, 4, 1) != 7 || q.w != 5 || q.h != 2 || q.x != -3)                        { ret 3; }
    if (!string.str_equals(name(?q), "src") || !string.str_equals(rule(?q), "B36/S23")) { ret 4; }
    if (!string.str_equals(comments(?q), "two lines"))                                  { ret 5; }
    var n: usize = 0;
    if (run(?q, 0, 1, ?n) != 0 || n != 4) { ret 6; }
    dnit(?q);
    ret 0;
}

test orient__all_eight_stamp_what_get_oriented_shows {
    var a: allo.Allocator;
    page.make(?a);

    # the f-pentomino has no symmetry, so its eight orientations are all different
    var p:    Pattern;
    val made: err[allo.Error] = init(?p, ?a, 3, 3, "f");
    if (sel made.err) { ret 1; }
    set(?p, 1, 0, 1);
    set(?p, 2, 0, 1);
    set(?p, 0, 1, 1);
    set(?p, 1, 1, 1);
    set(?p, 1, 2, 1);

    var seen: [8]u32;
    var o:    u8 = 0;
    for (o < ORIENT_COUNT) {
        val w: usize = width(?p, o);
        val h: usize = height(?p, o);

        var s:  sim.Sim;
        val sm: err[allo.Error] = sim.init(?s, ?a);
        if (sel sm.err) { ret 2; }
        var q:  Pattern;
        val oe: err[allo.Error] = orient(?q, ?a, ?p, o);
        if (sel oe.err) { ret 3; }
        stamp(?s, ?q, 10, -7);
        dnit(?q);

        var sig: u32   = 0;
        var y:   usize = 0;
        for (y < h) {
            var x: usize = 0;
            for (x < w) {
                val shown: bool = get_oriented(?p, o, x, y) != 0;
                if (shown != sim.alive(?s, corner(10, w) + x::i64, corner(-7, h) + y::i64)) { ret 4; }
                if (shown)                                                                  { sig = sig | (1::u32 << (y * 3 + x)::u32); }
                x = x + 1;
            }
            y = y + 1;
        }
        if (sim.population(?s) != 5) { ret 5; }

        var k: u8 = 0;
        for (k < o) {
            if (seen[k::usize] == sig) { ret 6; }
            k = k + 1;
        }
        seen[o::usize] = sig;
        sim.dnit(?s);
        o = o + 1;
    }

    # four turns come back to the start, and a flip is its own inverse
    var t: u8 = 5;
    t = orient_turn(orient_turn(orient_turn(orient_turn(t))));
    if (t != 5 || orient_flip(orient_flip(t)) != t) { ret 7; }
    dnit(?p);
    ret 0;
}

test orient__keys_act_on_the_shape_on_screen {
    var a: allo.Allocator;
    page.make(?a);
    var p:    Pattern;
    val made: err[allo.Error] = init(?p, ?a, 3, 2, "asym");
    if (sel made.err) { ret 1; }
    set(?p, 0, 0, 1);
    set(?p, 1, 0, 1);
    set(?p, 2, 1, 1);

    var o: u8 = 0;
    for (o < ORIENT_COUNT) {
        val w: usize = width(?p, o);
        val h: usize = height(?p, o);
        val f: u8    = orient_flip(o);
        val t: u8    = orient_turn(o);
        if (width(?p, f) != w || height(?p, f) != h) { ret 2; }
        if (width(?p, t) != h || height(?p, t) != w) { ret 3; }
        var y: usize = 0;
        for (y < h) {
            var x: usize = 0;
            for (x < w) {
                # mirrored left to right
                if (get_oriented(?p, f, x, y) != get_oriented(?p, o, w - 1 - x, y)) { ret 4; }
                # turned clockwise, the new (y, h-1-x) cell is the old (x, y)
                if (get_oriented(?p, t, h - 1 - y, x) != get_oriented(?p, o, x, y)) { ret 5; }
                x = x + 1;
            }
            y = y + 1;
        }
        o = o + 1;
    }
    dnit(?p);
    ret 0;
}

test words__a_pattern_keeps_words_of_several_values_through_clone_and_orient {
    var a: allo.Allocator;
    page.make(?a);
    var p:    Pattern;
    val made: err[allo.Error] = init(?p, ?a, 3, 2, "wide");
    if (sel made.err) { ret 1; }
    # words of three 16-bit values, 48 bits a cell
    val held: err[allo.Error] = hold_words(?p, 3);
    if (sel held.err || p.values != 3) { ret 1; }
    var c: [3]u32 = [3]u32{1, 0xffff, 7};
    set_word(?p, 0, 0, ?c[0], 1);
    set_word(?p, 1, 0, ?c[0], 1);
    c[1] = 0;
    set_word(?p, 2, 1, ?c[0], 1);
    var n:   usize = 0;
    val run: *u32  = run_word(?p, 0, 0, ?n);
    if (n != 2 || run[1] != 0xffff || !blank(?p, 0, 1) || blank(?p, 2, 1)) { ret 2; }
    var q:    Pattern;
    val copy: err[allo.Error] = clone(?q, ?a, ?p);
    if (sel copy.err || q.values != 3 || word(?q, 1, 0)[1] != 0xffff || word(?q, 2, 1)[2] != 7) { ret 3; }
    # turned a quarter clockwise, (x, y) lies at (h - 1 - y, x)
    var t:    Pattern;
    val turn: err[allo.Error] = orient(?t, ?a, ?p, 1);
    if (sel turn.err || t.values != 3 || word(?t, 1, 1)[1] != 0xffff || word(?t, 0, 2)[0] != 1 || !blank(?t, 0, 0)) { ret 4; }
    dnit(?t);
    dnit(?q);
    dnit(?p);
    ret 0;
}
