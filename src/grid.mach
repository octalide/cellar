# a double-buffered dense cell grid with toroidal wrapping
#
# each cell holds 0 (dead) or 1 (alive). a back buffer receives the next
# generation so a step never reads its own writes; swap exchanges the front and
# back pointers in O(1). neighbor counts wrap at the edges, so the world is a
# torus. two position-indexed auxiliary fields track per-cell history for the
# renderer: age (generations continuously alive) and heat (a fading trail).

use allo: std.allocator;
use std.allocator.page;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# a w x h grid of u8 cells with a parallel back buffer and aux fields
# ---
# cells: front buffer, row-major, length w*h
# back:  back buffer for the next generation, same length
# age:   per-cell generations continuously alive, 0 when dead, length w*h
# heat:  per-cell trail value, 255 while alive and decaying after death, length w*h
# w:     width in cells
# h:     height in cells
# a:     allocator backing every buffer
pub rec Grid {
    cells: *u8;
    back:  *u8;
    age:   *u32;
    heat:  *u8;
    w:     usize;
    h:     usize;
    a:     *allo.Allocator;
}

# allocate a zeroed w x h grid, its back buffer, and the aux fields
#
# on a refusal nothing stays allocated and g is untouched.
# ---
# g:   grid to initialize
# a:   allocator backing every buffer
# w:   width in cells, positive
# h:   height in cells, positive
# ret: ok, or the allocator's refusal
pub fun init(g: *Grid, a: *allo.Allocator, w: usize, h: usize) err[allo.Error] {
    val n:  usize                = w * h;
    val rc: res[*u8, allo.Error] = allo.zallocate[u8](a, n);
    if (sel rc.err) { ret err[allo.Error].err{rc.err}; }
    val rb: res[*u8, allo.Error] = allo.zallocate[u8](a, n);
    if (sel rb.err) {
        allo.deallocate[u8](a, rc.ok, n);
        ret err[allo.Error].err{rb.err};
    }
    val rg: res[*u32, allo.Error] = allo.zallocate[u32](a, n);
    if (sel rg.err) {
        allo.deallocate[u8](a, rc.ok, n);
        allo.deallocate[u8](a, rb.ok, n);
        ret err[allo.Error].err{rg.err};
    }
    val rh: res[*u8, allo.Error] = allo.zallocate[u8](a, n);
    if (sel rh.err) {
        allo.deallocate[u8](a, rc.ok, n);
        allo.deallocate[u8](a, rb.ok, n);
        allo.deallocate[u32](a, rg.ok, n);
        ret err[allo.Error].err{rh.err};
    }
    g.cells = rc.ok;
    g.back  = rb.ok;
    g.age   = rg.ok;
    g.heat  = rh.ok;
    g.w     = w;
    g.h     = h;
    g.a     = a;
    ret err[allo.Error].ok{};
}

# release every buffer and nil the pointers
# ---
# g:   grid to deinitialize
# ret: ok, or the first release the allocator refused
pub fun dnit(g: *Grid) err[allo.Error] {
    val n:  usize           = g.w * g.h;
    val e0: err[allo.Error] = allo.deallocate[u8](g.a, g.cells, n);
    val e1: err[allo.Error] = allo.deallocate[u8](g.a, g.back, n);
    val e2: err[allo.Error] = allo.deallocate[u32](g.a, g.age, n);
    val e3: err[allo.Error] = allo.deallocate[u8](g.a, g.heat, n);
    g.cells = nil;
    g.back  = nil;
    g.age   = nil;
    g.heat  = nil;
    if (sel e0.err) { ret e0; }
    if (sel e1.err) { ret e1; }
    if (sel e2.err) { ret e2; }
    ret e3;
}

# reallocate every buffer to a new w x h, clearing all state
#
# the new buffers are allocated before the old ones are freed, so a refusal
# leaves the existing grid intact.
# ---
# g:   grid to resize
# w:   new width in cells, positive
# h:   new height in cells, positive
# ret: ok, or the allocator's refusal
pub fun resize(g: *Grid, w: usize, h: usize) err[allo.Error] {
    var ng: Grid;
    val e:  err[allo.Error] = init(?ng, g.a, w, h);
    if (sel e.err) { ret e; }
    dnit(g);
    @g = ng;
    ret err[allo.Error].ok{};
}

# the front-buffer cell at (x, y); the caller guarantees x < w and y < h
# ---
# g:   grid
# x:   column in [0, w)
# y:   row in [0, h)
# ret: 0 or 1
pub fun get(g: *Grid, x: usize, y: usize) u8 {
    ret g.cells[y * g.w + x];
}

# write v to the front-buffer cell at (x, y)
# ---
# g: grid
# x: column in [0, w)
# y: row in [0, h)
# v: new value, 0 or 1
pub fun set(g: *Grid, x: usize, y: usize, v: u8) {
    g.cells[y * g.w + x] = v;
}

# write v to the back-buffer cell at (x, y)
# ---
# g: grid
# x: column in [0, w)
# y: row in [0, h)
# v: new value, 0 or 1
pub fun set_back(g: *Grid, x: usize, y: usize, v: u8) {
    g.back[y * g.w + x] = v;
}

# the age of the cell at (x, y)
# ---
# g:   grid
# x:   column in [0, w)
# y:   row in [0, h)
# ret: generations the cell has been continuously alive, 0 when dead
pub fun age_at(g: *Grid, x: usize, y: usize) u32 {
    ret g.age[y * g.w + x];
}

# write the age of the cell at (x, y)
# ---
# g: grid
# x: column in [0, w)
# y: row in [0, h)
# v: new age
pub fun set_age(g: *Grid, x: usize, y: usize, v: u32) {
    g.age[y * g.w + x] = v;
}

# the heat of the cell at (x, y)
# ---
# g:   grid
# x:   column in [0, w)
# y:   row in [0, h)
# ret: trail value in [0, 255]
pub fun heat_at(g: *Grid, x: usize, y: usize) u8 {
    ret g.heat[y * g.w + x];
}

# write the heat of the cell at (x, y)
# ---
# g: grid
# x: column in [0, w)
# y: row in [0, h)
# v: new heat
pub fun set_heat(g: *Grid, x: usize, y: usize, v: u8) {
    g.heat[y * g.w + x] = v;
}

# live cells among the 8 toroidal neighbors of (x, y)
# ---
# g:   grid
# x:   column in [0, w)
# y:   row in [0, h)
# ret: a count in [0, 8]
pub fun count_neighbors(g: *Grid, x: usize, y: usize) u8 {
    val w:  usize = g.w;
    val h:  usize = g.h;
    val xm: usize = (x + w - 1) % w;
    val xp: usize = (x + 1) % w;
    val ym: usize = (y + h - 1) % h;
    val yp: usize = (y + 1) % h;
    var n:  u8    = 0;
    n = n + g.cells[ym * w + xm];
    n = n + g.cells[ym * w + x];
    n = n + g.cells[ym * w + xp];
    n = n + g.cells[y * w + xm];
    n = n + g.cells[y * w + xp];
    n = n + g.cells[yp * w + xm];
    n = n + g.cells[yp * w + x];
    n = n + g.cells[yp * w + xp];
    ret n;
}

# exchange the front and back buffers
# ---
# g: grid
pub fun swap(g: *Grid) {
    val t: *u8 = g.cells;
    g.cells = g.back;
    g.back  = t;
}

# zero every front-buffer cell and both aux fields
# ---
# g: grid
pub fun clear(g: *Grid) {
    val n: usize = g.w * g.h;
    var i: usize = 0;
    for (i < n) {
        g.cells[i] = 0;
        g.age[i]   = 0;
        g.heat[i]  = 0;
        i          = i + 1;
    }
}

test count_neighbors__wraps_at_the_corners {
    var a: allo.Allocator;
    page.make(?a);

    var g:    Grid;
    val made: err[allo.Error] = init(?g, ?a, 4, 4);
    if (sel made.err) { ret 1; }

    # a live corner cell reaches the opposite corners through the wrap
    set(?g, 0, 0, 1);
    if (count_neighbors(?g, 3, 3) != 1) { ret 2; }
    # (2, 2) is the one cell with no wrapped adjacency to the corner
    if (count_neighbors(?g, 2, 2) != 0) { ret 3; }

    dnit(?g);
    ret 0;
}

test resize__clears_the_aux_fields {
    var a: allo.Allocator;
    page.make(?a);

    var g:     Grid;
    val made2: err[allo.Error] = init(?g, ?a, 3, 3);
    if (sel made2.err) { ret 1; }

    set_age(?g, 1, 1, 7);
    set_heat(?g, 1, 1, 200);
    if (age_at(?g, 1, 1) != 7)    { ret 2; }
    if (heat_at(?g, 1, 1) != 200) { ret 3; }

    val resized: err[allo.Error] = resize(?g, 5, 2);
    if (sel resized.err)        { ret 4; }
    if (g.w != 5 || g.h != 2)   { ret 5; }
    if (age_at(?g, 1, 1) != 0)  { ret 6; }
    if (heat_at(?g, 4, 1) != 0) { ret 7; }

    dnit(?g);
    ret 0;
}
