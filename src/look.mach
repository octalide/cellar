# cellar's look on blit: its palette and metrics as a blit theme, the small
# face as a text style, and the heads-up boxes as a class
#
# the colours are theme.mach's, the one place cellar's palette is written,
# made blit's tokens and derived into every widget's style, with a few touches
# where cellar's controls draw differently from blit's defaults: section
# headings without a band, text fields sunk into the world's colour, a switch
# track that does not light under the cursor, a thin accent slider handle and
# flat notification cards. every length is unscaled, and blit scales it with
# the interface.

use blit;
use bstyle: blit.style;
use bth:    blit.theme;
use cellar.theme;
use std.types.option.opt;

# a control row's height, the space between rows and the panel's padding
pub val ROW: f32 = 28.0;
pub val GAP: f32 = 6.0;
pub val PAD: f32 = 14.0;
# the line heights of the body face and the small one
pub val BODY_PX:  f32 = 17.0;
pub val SMALL_PX: f32 = 14.0;
# a section heading's height
val HEADING: f32 = 30.0;

# what the look adds to a context beyond its theme
# ---
# small: the small text style, for headings, notes and readouts
# hud:   the class the heads-up boxes draw their chrome in
pub rec Look {
    small: u32;
    hud:   u32;
}

# an sRGB hex colour at an opacity, as blit takes colours
pub fun colour(hex: u32, alpha: f32) blit.draw.Color {
    ret blit.draw.hex(hex, alpha);
}

# cellar's palette and metrics as a theme's tokens
fun tokens(t: *bth.Theme) {
    bth.default(t);
    t.panel       = colour(theme.PANEL, 1.0);
    t.window      = colour(theme.PANEL, 1.0);
    t.dock        = colour(theme.PANEL, 1.0);
    t.header      = colour(theme.HEADER, 1.0);
    t.header_hot  = colour(theme.CONTROL_HOT, 1.0);
    t.edge        = colour(theme.PANEL_EDGE, 1.0);
    t.text        = colour(theme.TEXT, 1.0);
    t.text_dim    = colour(theme.TEXT_DIM, 1.0);
    t.text_faint  = colour(theme.TEXT_FAINT, 1.0);
    t.accent      = colour(theme.ACCENT, 1.0);
    t.accent_text = colour(theme.ACCENT_INK, 1.0);
    t.warn        = colour(theme.WARN, 1.0);
    t.control     = colour(theme.CONTROL, 1.0);
    t.control_hot = colour(theme.CONTROL_HOT, 1.0);
    t.control_on  = colour(theme.CONTROL_ON, 1.0);
    t.track       = colour(theme.CONTROL, 1.0);
    t.handle      = colour(theme.TEXT_DIM, 1.0);
    t.handle_on   = colour(theme.TEXT, 1.0);
    t.select      = colour(theme.ACCENT, 0.35);
    t.grid        = colour(theme.GRID, 1.0);
    t.row         = ROW;
    t.gap         = GAP;
    t.pad         = PAD;
    t.inset       = 5.0;
    t.handle_w    = 2.0;
    t.bar_w       = 6.0;
    t.thumb_min   = 12.0;
    t.corner      = 0.0;
    t.edge_w      = 1.0;
    t.caret_w     = 1.5;
    t.focus       = colour(theme.ACCENT, 1.0);
}

# the touches where cellar's controls draw differently from what the tokens derive
fun touches(t: *bth.Theme) {
    val clear: blit.draw.Color = blit.draw.rgba(0.0, 0.0, 0.0, 0.0);

    # a heading is its caret and title in dim ink, lit under the cursor
    val sec: *bth.Style = bth.style(t, bth.SECTION);
    bth.fill_all(sec, clear);
    sec.min_h   = HEADING;
    sec.inset.l = 1.0;
    var i: u8 = 0;
    for (i < bth.STATES) {
        sec.states[i].text = t.text_dim;
        sec.states[i].mark = t.text_dim;
        i                  = i + 1;
    }
    sec.states[bth.HOT].text    = t.text;
    sec.states[bth.HOT].mark    = t.text;
    sec.states[bth.ACTIVE].text = t.text;
    sec.states[bth.ACTIVE].mark = t.text;

    # a field is sunk into the world's colour, outlined, the accent while it types
    val fld: *bth.Style = bth.style(t, bth.FIELD);
    bth.fill_all(fld, colour(theme.WORLD, 1.0));
    fld.states[bth.HOT].fill    = t.control_hot;
    fld.states[bth.HOT].fill_to = t.control_hot;
    bth.outline_all(fld, t.control_on, 1.0);
    fld.states[bth.FOCUSED].border = t.accent;
    fld.inset.l                    = 8.0;
    fld.inset.r                    = 8.0;

    # a switch's track stays put under the cursor and takes the accent when on
    val tog: *bth.Style = bth.style(t, bth.TOGGLE);
    bth.fills(tog, t.control_on, t.control_on, t.control_on, t.accent);
    tog.pad.t = 5.0;
    tog.pad.b = 5.0;
    val knob: *bth.Style = bth.style(t, bth.TOGGLE_KNOB);
    knob.margin = bth.edges(3.0);

    # a slider's face follows the cursor and its handle is a thin accent line
    bth.fills(bth.style(t, bth.SLIDER), t.control, t.control_hot, t.control_on, t.control);
    bth.fill_all(bth.style(t, bth.SLIDER_HANDLE), t.accent);

    # a scroll bar sits close to what it scrolls
    val bar: *bth.Style = bth.style(t, bth.SCROLLBAR);
    bar.margin.l = 4.0;
    bth.fills(bth.style(t, bth.SCROLLBAR_THUMB), t.control_on, t.text_faint, t.text_faint, t.control_on);

    # the panel: its edge on the inside, room for the header above its sections
    val dock: *bth.Style = bth.style(t, bth.DOCK);
    dock.pad = bth.Edges{l: PAD, t: HEADER + 8.0, r: PAD, b: 12.0};

    # a message is a flat card
    val card: *bth.Style = bth.style(t, bth.TOAST);
    bth.fill_all(card, t.control);
    bth.outline_all(card, clear, 0.0);
    card.pad = bth.edges(PAD);
}

# the panel header's height
pub val HEADER: f32 = 48.0;

# give a context cellar's look
# ---
# ctx: the context, which keeps the theme, the style and the class
# ret: the look's text style and class, or none when the context had no room for them
pub fun apply(ctx: *blit.context.Context) opt[Look] {
    val t: *bth.Theme = blit.context.theme_of(ctx);
    tokens(t);
    bth.derive(t);
    touches(t);

    var l:     Look;
    val small: opt[u32] = blit.context.add_style(ctx, blit.font.Style{source: 0, size: SMALL_PX / BODY_PX});
    if (sel small.none) { ret opt[Look].none{}; }
    l.small = small.some;

    # the readout and the cursor's position sit on the panel's colour, edged
    val hud: opt[u32] = bstyle.add_class(ctx, "hud");
    if (sel hud.none) { ret opt[Look].none{}; }
    l.hud = hud.some;
    bstyle.set(ctx, l.hud, "overlay.*.fill", bth.of_color(colour(theme.PANEL, 1.0)));
    bstyle.set(ctx, l.hud, "overlay.*.fill_to", bth.of_color(colour(theme.PANEL, 1.0)));
    bstyle.set(ctx, l.hud, "overlay.*.border", bth.of_color(colour(theme.PANEL_EDGE, 1.0)));
    bstyle.set(ctx, l.hud, "overlay.*.border_w", bth.of_length(1.0));
    ret opt[Look].some{l};
}
