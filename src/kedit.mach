# the rule panel: presets, the rule's short form, its string, and the kernel
# editor
#
# edits a copy of the simulation's rule and submits it as a command: a preset
# quick-load for any family, and for a weighted kernel a radius stepper, its
# weights and its birth and survive sets. a small kernel, to radius SMALL, has
# a clickable weight grid where each cell cycles its integer weight, from 0 up
# to MAXW and then from -MAXW back up to 0, and a toggle for every reachable
# sum. a wider one has too many cells and sums for that: its grid zooms and
# scrolls and is painted with a brush (cellar.brush), and its sets are sum
# lists typed in place (cellar.sumlist). a paint stroke on the wide grid ends
# when the panel is not drawn (idle).

use blit;
use bctx: blit.context;
use binp: blit.input;
use bint: blit.interact;
use blay: blit.layout;
use bth:  blit.theme;
use bw:   blit.widget;
use cellar.app;
use cellar.brush;
use cellar.command;
use cellar.look;
use cellar.rule;
use kernel: cellar.rules.weighted;
use cellar.ruletext;
use cellar.sumlist;
use cellar.text;
use cellar.theme;
use cellar.world;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# weights cycle through 0..MAXW, then -MAXW..-1, on click
val MAXW: i32 = 4;
# largest unscaled weight-grid cell and sum toggle
val CELL: f32 = 28.0;
val TOG:  f32 = 26.0;
# the widest radius edited cell by cell and sum by sum
val SMALL: usize = 2;
# unscaled thickness of the wide grid's scroll bars
val BAR: f32 = 8.0;

# zero every footprint weight
fun clear_weights(k: *kernel.Kernel) {
    var i: usize = 0;
    for (i < kernel.FOOTPRINT) {
        k.weights[i] = 0;
        i            = i + 1;
    }
}

# set every non-centre footprint cell to weight 1
fun moore_ones(k: *kernel.Kernel) {
    clear_weights(k);
    val r:  i64 = k.radius::i64;
    var dy: i64 = 0 - r;
    for (dy <= r) {
        var dx: i64 = 0 - r;
        for (dx <= r) {
            if (dx != 0 || dy != 0) { kernel.set_weight(k, dx, dy, 1); }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

# the weight a click moves a cell to: up to MAXW, then over to -MAXW and up
# to 0; a weight past MAXW either way, typed in the rule string, goes to 0
fun cycle(w: i32) i32 {
    if (w == MAXW)                { ret 0 - MAXW; }
    if (w > MAXW || w < 0 - MAXW) { ret 0; }
    ret w + 1;
}

# how strongly a weight of magnitude m is shaded, up to 1 at MAXW
fun shade(m: i32) f32 {
    if (m >= MAXW) { ret 1.0; }
    ret m::f32 / MAXW::f32;
}

# a cell of a weight grid: its face, its weight's shade, the centre framed,
# and the weight in the small face when it fits
fun cell(ui: *bctx.Context, x0: f32, y0: f32, x1: f32, y1: f32, face: u32, centre: bool, wv: i32) {
    bctx.quad(ui, x0, y0, x1, y1, look.colour(face, 1.0));
    if (wv > 0) { bctx.quad(ui, x0, y0, x1, y1, look.colour(theme.ACCENT, 0.2 + 0.8 * shade(wv))); }
    or (wv < 0) { bctx.quad(ui, x0, y0, x1, y1, look.colour(theme.WARN, 0.2 + 0.8 * shade(0 - wv))); }
    if (centre) { bctx.frame(ui, x0, y0, x1, y1, bctx.px(ui, 1.0), look.colour(theme.TEXT_DIM, 1.0)); }
    var num: [24]u8;
    num[text.buf_i64(?num[0], 0, wv::i64)] = 0;
    var ink: u32 = theme.TEXT_FAINT;
    if (wv != 0) { ink = theme.ACCENT_INK; }
    # a label wider than its cell is left out, as on a wide footprint
    if (bctx.text_width(ui, ?num[0]) <= x1 - x0) { look.text_centre(ui, ?num[0], x0, y0, x1, y1, look.colour(ink, 1.0)); }
}

# the fill of a control in a state, as the theme paints a button
fun face(hot: bool, held: bool, on: bool) u32 {
    if (on)   { ret theme.ACCENT; }
    if (held) { ret theme.CONTROL_ON; }
    if (hot)  { ret theme.CONTROL_HOT; }
    ret theme.CONTROL;
}

# the clickable weight grid, centred in the column
fun weights(ui: *bctx.Context, l: look.Look, k: *kernel.Kernel) bool {
    val r:  i64       = k.radius::i64;
    val n:  i64       = 2 * r + 1;
    val av: bctx.Area = bw.avail(ui);
    val w:  f32       = av.x1 - av.x0;
    var c:  f32       = bctx.px(ui, CELL);
    if (c * n::f32 > w) { c = w / n::f32; }
    val g:  bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(c * n::f32), 0.0, c * n::f32);
    val x0: f32       = g.x0 + (w - c * n::f32) / 2.0;
    val y0: f32       = g.y0;
    val sp: f32       = bctx.px(ui, 2.0);
    var ed: bool      = false;

    bctx.push_style(ui, l.small);
    var dy: i64 = 0 - r;
    for (dy <= r) {
        var dx: i64 = 0 - r;
        for (dx <= r) {
            val cx0: f32 = x0 + (dx + r)::f32 * c;
            val cy0: f32 = y0 + (dy + r)::f32 * c;
            bctx.push_id_int(ui, ((dy + r) * n + dx + r)::u64);
            val h: bint.Hit = bint.hit(ui, bctx.id_of(ui, "weight"), cx0, cy0, cx0 + c - sp, cy0 + c - sp, binp.BUTTON_LEFT);
            bctx.pop_id(ui);
            val wv: i32 = kernel.weight_at(k, dx, dy);
            cell(ui, cx0, cy0, cx0 + c - sp, cy0 + c - sp, face(h.hot, h.held, false), dx == 0 && dy == 0, wv);
            if (h.clicked) {
                kernel.set_weight(k, dx, dy, cycle(wv));
                ed = true;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    bctx.pop_style(ui);
    ret ed;
}

# one labelled, wrapping row of sum toggles over a set
fun sums(ui: *bctx.Context, l: look.Look, label: str, m: *kernel.Sums, most: i32) bool {
    look.note(ui, l, label);
    val av:  bctx.Area = bw.avail(ui);
    val w:   f32       = av.x1 - av.x0;
    val g:   f32       = bctx.px(ui, 3.0);
    var t:   f32       = bctx.px(ui, TOG);
    var per: usize     = ((w + g) / (t + g))::usize;
    if (per < 1) { per = 1; }
    t = (w + g) / per::f32 - g;
    val count: usize     = (most + 1)::usize;
    val rows:  usize     = (count + per - 1) / per;
    val box:   bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(rows::f32 * (t + g) - g), 0.0, rows::f32 * (t + g) - g);
    var ed:    bool      = false;
    bctx.push_style(ui, l.small);
    bctx.push_id_str(ui, label);
    var i: usize = 0;
    for (i < count) {
        val x0: f32  = box.x0 + (i % per)::f32 * (t + g);
        val y0: f32  = box.y0 + (i / per)::f32 * (t + g);
        val on: bool = kernel.has(m, i) != 0;
        bctx.push_id_int(ui, i::u64);
        val h: bint.Hit = bint.hit(ui, bctx.id_of(ui, "sum"), x0, y0, x0 + t, y0 + t, binp.BUTTON_LEFT);
        bctx.pop_id(ui);
        val st: u8 = bth.pick(h.hot, h.held, on, false);
        bctx.box(ui, bth.BUTTON, st, x0, y0, x0 + t, y0 + t);
        var num: [8]u8;
        val o:   usize = text.buf_u64(?num[0], 0, i::u64);
        num[o] = 0;
        look.text_centre(ui, ?num[0], x0, y0, x0 + t, y0 + t, bctx.paint_of(ui, bth.BUTTON, st).text);
        if (h.clicked) {
            kernel.toggle(m, i);
            ed = true;
        }
        i = i + 1;
    }
    bctx.pop_id(ui);
    bctx.pop_style(ui);
    ret ed;
}

# a labelled stepper, its value between - and + buttons at the right
# ---
# ui:    the interface
# label: the label, and the stepper's key
# value: the value shown
# ret:   -1 for -, 1 for +, 0 for neither
fun stepper(ui: *bctx.Context, label: str, value: str) i32 {
    val h:   f32             = bw.control_height(ui);
    val r:   bctx.Area       = bw.place(ui, blay.fill(1.0), blay.fixed(h), 0.0, h);
    val ink: blit.draw.Color = look.colour(theme.TEXT, 1.0);
    look.text_mid(ui, label, r.x0, r.y0, r.y1, ink);
    var d: i32 = 0;
    bctx.push_id_str(ui, label);
    if (bw.button_at(ui, "+", r.x1 - h, r.y0, r.x1, r.y1, false)) { d = 1; }
    look.text_centre(ui, value, r.x1 - h * 2.0, r.y0, r.x1 - h, r.y1, ink);
    if (bw.button_at(ui, "-", r.x1 - h * 3.0, r.y0, r.x1 - h * 2.0, r.y1, false)) { d = -1; }
    bctx.pop_id(ui);
    ret d;
}

# the radius stepper
fun radius(ui: *bctx.Context, k: *kernel.Kernel) bool {
    var num: [24]u8;
    num[text.buf_u64(?num[0], 0, k.radius::u64)] = 0;
    val d: i32 = stepper(ui, "Radius", ?num[0]);
    if (d > 0 && k.radius < kernel.MAX_RADIUS) {
        kernel.set_radius(k, k.radius + 1);
        ret true;
    }
    if (d < 0 && k.radius > 1) {
        kernel.set_radius(k, k.radius - 1);
        ret true;
    }
    ret false;
}

# the wide grid's cell size in a column w wide: the footprint fitted to it,
# larger at a zoom level
fun wide_cell(ui: *bctx.Context, w: f32, zoom: usize, n: i64) f32 {
    var c: f32 = bctx.px(ui, CELL);
    if (c * n::f32 > w)                                     { c = w / n::f32; }
    if (zoom > 0 && bctx.px(ui, brush.zoom_cell(zoom)) > c) { c = bctx.px(ui, brush.zoom_cell(zoom)); }
    ret c;
}

# the column's width
fun column(ui: *bctx.Context) f32 {
    val av: bctx.Area = bw.avail(ui);
    ret av.x1 - av.x0;
}

# whether an offset is among n images
fun among(at: *brush.Offset, n: usize, dx: i64, dy: i64) bool {
    var i: usize = 0;
    for (i < n) {
        if (at[i].dx == dx && at[i].dy == dy) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a first cell and a view of shown cells clamped into n, centred on c
fun first_cell(c: i64, r: i64, shown: i64, n: i64) i64 {
    var f: i64 = c + r - shown / 2;
    if (f > n - shown) { f = n - shown; }
    if (f < 0)         { f = 0; }
    ret f;
}

# a scroll bar over the wide grid, its thumb the view's share of the
# footprint; ret where a drag on it puts the view's centre, as a fraction
# of the footprint, or none
fun bar(ui: *bctx.Context, key: str, x0: f32, y0: f32, x1: f32, y1: f32, lo: f32, hi: f32, across: bool) opt[f32] {
    val h: bint.Hit = bint.hit(ui, bctx.id_of(ui, key), x0, y0, x1, y1, binp.BUTTON_LEFT);
    bctx.box(ui, bth.SCROLLBAR, bth.NORMAL, x0, y0, x1, y1);
    val st: u8 = bth.pick(h.hot, h.held, false, false);
    if (across)  { bctx.box(ui, bth.SCROLLBAR_THUMB, st, x0 + (x1 - x0) * lo, y0, x0 + (x1 - x0) * hi, y1); }
    or           { bctx.box(ui, bth.SCROLLBAR_THUMB, st, x0, y0 + (y1 - y0) * lo, x1, y0 + (y1 - y0) * hi); }
    if (!h.held) { ret opt[f32].none{}; }
    if (across)  { ret opt[f32].some{(h.mx - x0) / (x1 - x0)}; }
    ret opt[f32].some{(h.my - y0) / (y1 - y0)};
}

# the wide weight grid: a zoomed, scrolled view of the footprint painted by
# dragging, the hovered cell's images outlined, and a readout of the cell
# ---
# ui:  the interface
# l:   cellar's look
# b:   the brush and view
# k:   the kernel, painted in place
# ret: whether a weight changed
fun wide_weights(ui: *bctx.Context, l: look.Look, b: *brush.Brush, k: *kernel.Kernel) bool {
    val r:     i64 = k.radius::i64;
    val n:     i64 = 2 * r + 1;
    val w:     f32 = column(ui);
    val bw_:   f32 = bctx.px(ui, BAR);
    val g:     f32 = bctx.px(ui, 3.0);
    val c:     f32 = wide_cell(ui, w, b.zoom, n);
    var shown: i64 = n;
    if (c * n::f32 > w + 0.5) {
        shown = ((w - bw_ - g) / c)::i64;
        if (shown < 1) { shown = 1; }
    }
    val fx: i64 = first_cell(b.cx, r, shown, n);
    val fy: i64 = first_cell(b.cy, r, shown, n);
    b.cx = fx + shown / 2 - r;
    b.cy = fy + shown / 2 - r;
    val bars: bool = shown < n;
    val side: f32  = c * shown::f32;
    var room: f32  = side;
    if (bars) { room = side + g + bw_; }
    val area: bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(room), 0.0, room);
    val x0:   f32       = area.x0 + (w - room) / 2.0;
    val y0:   f32       = area.y0;
    val h:    bint.Hit  = bint.hit(ui, bctx.id_of(ui, "grid"), x0, y0, x0 + side, y0 + side, binp.BUTTON_LEFT);
    val in:   bool      = h.mx >= x0 && h.mx < x0 + side && h.my >= y0 && h.my < y0 + side;
    val over: bool      = h.hot || (h.held && in);
    var hx:   i64       = 0;
    var hy:   i64       = 0;
    var at:   [8]brush.Offset;
    var na:   usize     = 0;
    var ed:   bool      = false;
    if (over) {
        hx = fx + ((h.mx - x0) / c)::i64 - r;
        hy = fy + ((h.my - y0) / c)::i64 - r;
        if (hx > r) { hx = r; }
        if (hy > r) { hy = r; }
        na = brush.images(hx, hy, b.sym, ?at[0]);
        if (h.held && brush.paint(k, hx, hy, b.weight, b.sym)) { ed = true; }
    }

    var gap: f32 = bctx.px(ui, 2.0);
    if (c < bctx.px(ui, 10.0)) { gap = bctx.px(ui, 1.0); }
    bctx.push_style(ui, l.small);
    var iy: i64 = 0;
    for (iy < shown) {
        var ix: i64 = 0;
        for (ix < shown) {
            val dx:  i64  = fx + ix - r;
            val dy:  i64  = fy + iy - r;
            val cx0: f32  = x0 + ix::f32 * c;
            val cy0: f32  = y0 + iy::f32 * c;
            val hot: bool = na > 0 && among(?at[0], na, dx, dy);
            cell(ui, cx0, cy0, cx0 + c - gap, cy0 + c - gap, face(hot, false, false), dx == 0 && dy == 0, kernel.weight_at(k, dx, dy));
            if (hot) { bctx.frame(ui, cx0, cy0, cx0 + c - gap, cy0 + c - gap, bctx.px(ui, 1.0), look.colour(theme.TEXT, 0.8)); }
            ix = ix + 1;
        }
        iy = iy + 1;
    }
    bctx.pop_style(ui);

    if (bars) {
        # the bars show the view's share of the footprint, and a drag on one centres the view there
        val sx: opt[f32] = bar(ui, "across", x0, y0 + side + g, x0 + side, y0 + side + g + bw_, fx::f32 / n::f32,
            (fx + shown)::f32 / n::f32, true);
        if (sel sx.some) { b.cx = (sx.some * n::f32)::i64 - r; }
        val vx: f32      = x0 + side + g;
        val sy: opt[f32] = bar(ui, "down", vx, y0, vx + bw_, y0 + side, fy::f32 / n::f32, (fy + shown)::f32 / n::f32, false);
        if (sel sy.some) { b.cy = (sy.some * n::f32)::i64 - r; }
    }

    var line: [64]u8;
    var o:    usize = 0;
    if (over) {
        o = text.buf_str(?line[0], 0, "x ");
        o = text.buf_i64(?line[0], o, hx);
        o = text.buf_str(?line[0], o, "   y ");
        o = text.buf_i64(?line[0], o, hy);
        o = text.buf_str(?line[0], o, "   weight ");
        o = text.buf_i64(?line[0], o, kernel.weight_at(k, hx, hy)::i64);
    }
    or { o = text.buf_str(?line[0], 0, "drag to paint the brush's weight"); }
    line[o] = 0;
    look.line(ui, l.small, ?line[0], theme.TEXT_DIM);
    ret ed;
}

# the zoom, brush weight and symmetry of the wide grid
fun brush_controls(ui: *bctx.Context, l: look.Look, b: *brush.Brush, k: *kernel.Kernel) {
    val n:   i64   = 2 * k.radius::i64 + 1;
    val w:   f32   = column(ui);
    val fit: f32   = wide_cell(ui, w, 0, n);
    val c:   f32   = wide_cell(ui, w, b.zoom, n);
    var num: [24]u8;
    var o:   usize = 0;
    if (b.zoom == 0) { o = text.buf_str(?num[0], 0, "fit"); }
    or {
        val m: u64 = (c * 10.0 / fit + 0.5)::u64;
        o = text.buf_u64(?num[0], 0, m / 10);
        o = text.buf_str(?num[0], o, ".");
        o = text.buf_u64(?num[0], o, m % 10);
        o = text.buf_str(?num[0], o, "x");
    }
    num[o] = 0;
    val z: i32 = stepper(ui, "Zoom", ?num[0]);
    # a level adds nothing once a cell is as large as it gets
    if (z > 0 && b.zoom < brush.ZOOMS && c < bctx.px(ui, CELL)) {
        b.zoom = b.zoom + 1;
        for (b.zoom < brush.ZOOMS && bctx.px(ui, brush.zoom_cell(b.zoom)) <= c) { b.zoom = b.zoom + 1; }
    }
    if (z < 0 && b.zoom > 0) {
        b.zoom = b.zoom - 1;
        for (b.zoom > 0 && bctx.px(ui, brush.zoom_cell(b.zoom)) <= fit) { b.zoom = b.zoom - 1; }
    }

    num[text.buf_i64(?num[0], 0, b.weight::i64)] = 0;
    val wt: i32 = stepper(ui, "Brush weight", ?num[0]);
    if (wt > 0 && b.weight < MAXW)     { b.weight = b.weight + 1; }
    if (wt < 0 && b.weight > 0 - MAXW) { b.weight = b.weight - 1; }

    var syms: [3]str;
    syms[0] = "None";
    syms[1] = "4-fold";
    syms[2] = "8-fold";
    look.note(ui, l, "Symmetry");
    bw.segmented(ui, ?syms[0], 3, ?b.sym);
}

# a labelled sum list for a wide kernel's set
# ---
# ui:   the interface
# lk:   cellar's look
# s:    the list's field
# name: "Birth" or "Survive", and the field's key
# m:    the set, replaced when a list is entered
# most: the greatest sum the kernel reaches
# ret:  whether the set was replaced
fun sum_list(ui: *bctx.Context, lk: look.Look, s: *sumlist.SumList, name: str, m: *kernel.Sums, most: usize) bool {
    var lb: [64]u8;
    var o:  usize = text.buf_str(?lb[0], 0, name);
    o     = text.buf_str(?lb[0], o, " sums, 0 to ");
    o     = text.buf_u64(?lb[0], o, most::u64);
    lb[o] = 0;
    look.note(ui, lk, ?lb[0]);
    var ed:  bool = false;
    val did: u8   = bw.text_field(ui, name, ?s.field, "none, or like 34-45, 58");
    val id:  u64  = bctx.id_of(ui, name);
    if ((did & blit.field.ENTERED) != 0) {
        val got: opt[kernel.Sums] = sumlist.enter(s, most);
        if (sel got.some) {
            if (!kernel.same_sums(?got.some, m)) {
                @m = got.some;
                ed = true;
            }
        }
        # a refused list stays in the field to be put right
        or { bctx.focus(ui, id); }
    }
    or ((did & blit.field.EDITED) != 0) { sumlist.edited(s, most); }
    # an entered set runs from the next frame, so this one leaves the field as enter set it
    if ((did & blit.field.ENTERED) == 0 && !bctx.focused(ui, id)) { sumlist.sync(s, m, most); }
    if (s.error != nil)                                           { look.line(ui, lk.small, s.error, theme.WARN); }
    ret ed;
}

# draw the rule panel and apply its edits
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown, whose kernel is edited
pub fun panel(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    # edits go to a copy, which replaces the rule when the frame applies commands
    var copy: rule.Rule = @world.rule(s);
    var ed:   bool      = false;

    val m:      opt[usize] = world.rule_preset(s);
    var labels: [rule.PRESET_COUNT]str;
    var i:      usize      = 0;
    for (i < rule.PRESET_COUNT) {
        labels[i] = rule.preset(i).label;
        i         = i + 1;
    }
    var on: usize = rule.PRESET_COUNT;
    if (sel m.some) { on = m.some; }
    val hit: usize = bw.button_grid(ui, ?labels[0], rule.PRESET_COUNT, 2, on);
    if (hit < rule.PRESET_COUNT) {
        copy = rule.preset_rule(hit);
        ed   = true;
    }

    var rb: [rule.DISPLAY_MAX + 1]u8;
    look.line(ui, blit.font.STYLE_BODY, world.rule_string(s, ?rb[0]), theme.ACCENT);
    rule_field(ui, l, a, s);

    if (sel copy.kind.weighted) {
        if (kernel_editor(ui, l, a, ?copy.kind.weighted)) { ed = true; }
    }
    if (ed) { app.submit(a, command.Command.rule{copy}); }
}

# the rule string field, and what is wrong with a string it refused
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown
fun rule_field(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    val t:   *ruletext.RuleText = ?a.rule_text;
    val did: u8                 = bw.text_field(ui, "rule string", ?t.field, "Rule, like B3/S23 or R2,C0,S2-3,B3");
    val id:  u64                = bctx.id_of(ui, "rule string");
    if ((did & blit.field.ENTERED) != 0) {
        val r: opt[rule.Rule] = ruletext.enter(t);
        if (sel r.some) { app.submit(a, command.Command.rule{r.some}); }
        # a refused string stays in the field to be put right
        or { bctx.focus(ui, id); }
    }
    or ((did & blit.field.EDITED) != 0) { ruletext.edited(t); }
    # an entered rule runs from the next frame, so this one leaves the field as enter set it
    if ((did & blit.field.ENTERED) == 0 && !bctx.focused(ui, id)) { ruletext.sync(t, world.rule(s)); }
    if (t.error != nil)                                           { look.line(ui, l.small, t.error, theme.WARN); }
}

# the weighted kernel's radius, weights and sums
# ---
# ui:  the interface
# l:   cellar's look
# a:   application state, holding the wide editor's brush and lists
# k:   the kernel, edited in place
# ret: whether anything was edited
fun kernel_editor(ui: *bctx.Context, l: look.Look, a: *app.App, k: *kernel.Kernel) bool {
    val b:  *brush.Brush = ?a.brush;
    var ed: bool         = false;
    # a stroke shows what it has painted, and applies it as one edit once the button is up
    if (b.stroke && b.pending.radius != k.radius) { b.stroke = false; }
    if (b.stroke) {
        @k = b.pending;
        if (binp.held(ui.in, binp.BUTTON_LEFT) == 0) {
            b.stroke = false;
            ed       = true;
        }
    }

    if (radius(ui, k)) { ed = true; }
    val wide: bool = k.radius > SMALL;
    if (!wide && weights(ui, l, k)) { ed = true; }
    if (wide && wide_weights(ui, l, b, k)) {
        b.stroke  = true;
        b.pending = @k;
    }
    if (wide) { brush_controls(ui, l, b, k); }
    var acts: [2]str;
    acts[0] = "Clear weights";
    acts[1] = "Moore";
    val hit: usize = bw.buttons(ui, ?acts[0], 2);
    if (hit == 0) {
        clear_weights(k);
        ed = true;
    }
    if (hit == 1) {
        moore_ones(k);
        ed = true;
    }
    val most: i32 = kernel.max_sum(k);
    if (wide) {
        if (sum_list(ui, l, ?a.birth_list, "Birth", ?k.birth, most::usize))       { ed = true; }
        if (sum_list(ui, l, ?a.survive_list, "Survive", ?k.survive, most::usize)) { ed = true; }
        ret ed;
    }
    if (sums(ui, l, "Birth", ?k.birth, most))     { ed = true; }
    if (sums(ui, l, "Survive", ?k.survive, most)) { ed = true; }
    ret ed;
}

# the rule panel is not drawn this frame, so no stroke carries on from it
pub fun idle(a: *app.App) {
    a.brush.stroke = false;
}

test cycle__runs_through_every_weight_negatives_included {
    var seen: [9]bool;
    var w:    i32   = 0;
    var i:    usize = 0;
    for (i < 9) {
        seen[(w + MAXW)::usize] = true;
        w                       = cycle(w);
        i                       = i + 1;
    }
    if (w != 0) { ret 1; }
    i = 0;
    for (i < 9) {
        if (!seen[i]) { ret 2; }
        i = i + 1;
    }
    if (cycle(MAXW) != 0 - MAXW || cycle(-1) != 0 || cycle(99) != 0) { ret 3; }
    ret 0;
}
