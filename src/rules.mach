# the rule families every build runs, registered in the order their indices
# hold (cellar.rule.family)
#
# a family's place here is its index, which a rule carries while it runs and
# nothing records, so a family added goes on the end, one line, and the
# families already here keep their places. the first family is the one a
# rule nothing has set reads as, and the one whose error a rule string no
# family claims reports

use cellar.rule.family;
use cellar.rules.generations;
use cellar.rules.lenia;
use cellar.rules.nontotalistic;
use cellar.rules.reaction;
use cellar.rules.table;
use cellar.rules.weighted;
use std.types.size.usize;

# how many families every build runs
pub val COUNT: usize = 6;

# the families, in order
# ---
# weighted:      a weighted outer-totalistic kernel, the Life family and its
#                radius, weight and range generalizations
# generations:   a Life-like rule whose cells die through dying states
# nontotalistic: a two-state rule that sees how the eight neighbours are
#                arranged, Hensel's isotropic notation and Golly's MAP strings
# table:         a rule table or tree of up to 256 states, Golly's .rule files
# lenia:         a continuous rule, Bert Chan's Lenia
# reaction:      a reaction-diffusion rule of two continuous fields, Gray-Scott's
pub val FAMILIES: [COUNT]*family.Family = [COUNT]*family.Family{
    ?weighted.FAMILY,
    ?generations.FAMILY,
    ?nontotalistic.FAMILY,
    ?table.FAMILY,
    ?lenia.FAMILY,
    ?reaction.FAMILY,
};
