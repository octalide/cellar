# a copy of the world at one moment: its chunks, its generation and its rule
#
# only chunks holding a live or warm cell are kept, each as its coordinates and
# its cells whole, so a snapshot costs what the world's front cells do and
# never a dense grid of its extent. the simulation fills one from its pool
# (sim.take) and replays one through its fill path (sim.restore). one can also
# be built a chunk at a time (add), which the undo journal keeps its chunk
# before-images in. the cells are kept as the pool holds them, the world's
# complement at the generations a rule that births on 0 holds it so, which the
# rule and generation kept beside them say, so a restore resumes in the same
# phase.

use cellar.rule;
use cellar.space;
use allo: std.allocator;
use mem:  std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# the copy
# ---
# a:          allocator behind the buffers
# held:       a copy was taken and not dropped since
# generation: the world's generation when it was taken
# rule:       the rule it ran under, whose family the cells are words of
# n:          chunks held
# cap:        chunks the buffers hold
# at:         each chunk's column and row, 2 a chunk
# cells:      each chunk's cells, space.CELLS a chunk
pub rec Snapshot {
    a:          *allo.Allocator;
    held:       bool;
    generation: u64;
    rule:       rule.Rule;
    n:          usize;
    cap:        usize;
    at:         *i64;
    cells:      *u32;
}

# an empty snapshot holding nothing
# ---
# sn: the snapshot
# a:  allocator for its buffers, outliving it
pub fun init(sn: *Snapshot, a: *allo.Allocator) {
    sn.a     = a;
    sn.held  = false;
    sn.n     = 0;
    sn.cap   = 0;
    sn.at    = nil;
    sn.cells = nil;
}

fun release(sn: *Snapshot) {
    if (sn.cap == 0) { ret; }
    allo.deallocate[i64](sn.a, sn.at, sn.cap * 2);
    allo.deallocate[u32](sn.a, sn.cells, sn.cap * space.CELLS);
    sn.at    = nil;
    sn.cells = nil;
    sn.cap   = 0;
}

# forget the copy and free its buffers
pub fun drop(sn: *Snapshot) {
    release(sn);
    sn.held = false;
    sn.n    = 0;
}

# free the buffers
pub fun dnit(sn: *Snapshot) {
    drop(sn);
}

# whether a chunk's cells hold one that is not the quiescent background
pub fun any(c: *u32) bool {
    var i: usize = 0;
    for (i < space.CELLS) {
        if (c[i] != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a slot in use holds a cell that is not the quiescent background
fun holds(sp: *space.Space, s: usize) bool {
    ret any(?sp.cells[s * space.CELLS]);
}

# the bytes the buffers take
pub fun bytes(sn: *Snapshot) usize {
    ret sn.cap * (2 * 8 + space.CELLS * 4);
}

# the index of the chunk at (cx, cy), or n when none is held
pub fun find(sn: *Snapshot, cx: i64, cy: i64) usize {
    var i: usize = 0;
    for (i < sn.n) {
        if (sn.at[i * 2] == cx && sn.at[i * 2 + 1] == cy) { ret i; }
        i = i + 1;
    }
    ret sn.n;
}

# the cells of held chunk i
pub fun cells_of(sn: *Snapshot, i: usize) *u32 {
    ret ?sn.cells[i * space.CELLS];
}

# buffers for exactly n chunks, reused when they are big enough and not more
# than twice too big
fun fit(sn: *Snapshot, n: usize) err[allo.Error] {
    if (n <= sn.cap && n * 2 >= sn.cap) { ret err[allo.Error].ok{}; }
    release(sn);
    if (n == 0) { ret err[allo.Error].ok{}; }
    val at: res[*i64, allo.Error] = allo.allocate[i64](sn.a, n * 2);
    if (sel at.err) { ret err[allo.Error].err{at.err}; }
    val cells: res[*u32, allo.Error] = allo.allocate[u32](sn.a, n * space.CELLS);
    if (sel cells.err) {
        allo.deallocate[i64](sn.a, at.ok, n * 2);
        ret err[allo.Error].err{cells.err};
    }
    sn.at    = at.ok;
    sn.cells = cells.ok;
    sn.cap   = n;
    ret err[allo.Error].ok{};
}

# start a copy built a chunk at a time with add, holding no chunks yet
# ---
# sn:         the snapshot, whose previous copy is dropped
# generation: the world's generation
# r:          the rule
pub fun open(sn: *Snapshot, generation: u64, r: *rule.Rule) {
    sn.n          = 0;
    sn.generation = generation;
    sn.rule       = @r;
    sn.held       = true;
}

# append one chunk's cells to a held copy, growing the buffers by doubling
# ---
# sn:    the snapshot, held
# cx:    the chunk's column
# cy:    the chunk's row
# cells: space.CELLS cells, row-major
# ret:   ok, or the allocator's refusal, which leaves the copy as it was
pub fun add(sn: *Snapshot, cx: i64, cy: i64, cells: *u32) err[allo.Error] {
    if (sn.n == sn.cap) {
        var cap: usize = sn.cap * 2;
        if (cap == 0) { cap = 1; }
        val at: res[*i64, allo.Error] = allo.allocate[i64](sn.a, cap * 2);
        if (sel at.err) { ret err[allo.Error].err{at.err}; }
        val cs: res[*u32, allo.Error] = allo.allocate[u32](sn.a, cap * space.CELLS);
        if (sel cs.err) {
            allo.deallocate[i64](sn.a, at.ok, cap * 2);
            ret err[allo.Error].err{cs.err};
        }
        if (sn.n != 0) {
            mem.copy[i64](at.ok, sn.at, sn.n * 2);
            mem.copy[u32](cs.ok, sn.cells, sn.n * space.CELLS);
        }
        release(sn);
        sn.at    = at.ok;
        sn.cells = cs.ok;
        sn.cap   = cap;
    }
    sn.at[sn.n * 2]     = cx;
    sn.at[sn.n * 2 + 1] = cy;
    mem.copy[u32](?sn.cells[sn.n * space.CELLS], cells, space.CELLS);
    sn.n = sn.n + 1;
    ret err[allo.Error].ok{};
}

# copy a pool's host cells, replacing whatever was held
#
# the host's cells must be current: on the GPU, sync first.
# ---
# sn:         the snapshot
# sp:         the pool
# generation: the world's generation
# r:          the rule
# ret:        ok, or the allocator's refusal, which leaves nothing held
pub fun capture(sn: *Snapshot, sp: *space.Space, generation: u64, r: *rule.Rule) err[allo.Error] {
    sn.held = false;
    sn.n    = 0;
    var n: usize = 0;
    var s: usize = 0;
    for (s < sp.hi) {
        if (space.used(sp, s) && holds(sp, s)) { n = n + 1; }
        s = s + 1;
    }
    val made: err[allo.Error] = fit(sn, n);
    if (sel made.err) { ret made; }
    s = 0;
    for (s < sp.hi) {
        if (space.used(sp, s) && holds(sp, s)) {
            sn.at[sn.n * 2]     = space.slot_x(sp, s);
            sn.at[sn.n * 2 + 1] = space.slot_y(sp, s);
            mem.copy[u32](?sn.cells[sn.n * space.CELLS], ?sp.cells[s * space.CELLS], space.CELLS);
            sn.n = sn.n + 1;
        }
        s = s + 1;
    }
    sn.generation = generation;
    sn.rule       = @r;
    sn.held       = true;
    ret err[allo.Error].ok{};
}
