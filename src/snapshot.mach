# a copy of the world at one moment: its chunks or its tree, its generation
# and its rule
#
# a world in the pool is kept as its chunks: only those holding a word but 0,
# each as its coordinates and its image, the spans of the rule's state and
# rule layers (cellar.layer), so a snapshot costs what the world's front cells
# do at their widths and never a dense grid of its extent. a world in
# the quadtree is kept as the tree's distinct nodes (hashlife.export), so it
# costs what the tree does, however large the world. the simulation fills one
# from whichever holds the world (sim.take) and replays either form into
# whichever holds it then (sim.restore). a chunk snapshot can also be built a
# chunk at a time (add), which the undo journal keeps its chunk before-images
# in. the cells are kept as the pool holds them, the world's complement at the
# generations a rule that births on 0 holds it so, which the rule and
# generation kept beside them say, so a restore resumes in the same phase.

use cellar.hashlife;
use cellar.layer.plane;
use cellar.rule;
use cellar.space;
use allo: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# the copy
# ---
# a:          allocator behind the buffers
# held:       a copy was taken and not dropped since
# generation: the world's generation when it was taken
# rule:       the rule it ran under, whose family the cells are words of
# set:        the rule's state and rule layers, which the images are of
# words:      words of a chunk's image under set
# n:          chunks held
# cap:        chunks the buffers hold
# at:         each chunk's column and row, 2 a chunk
# images:     each chunk's image, words a chunk
# treed:      the copy is a tree's, in tree rather than the chunks
# tree:       the tree's nodes as hashlife.export writes them
pub rec Snapshot {
    a:          *allo.Allocator;
    held:       bool;
    generation: u64;
    rule:       rule.Rule;
    set:        plane.Set;
    words:      usize;
    n:          usize;
    cap:        usize;
    at:         *i64;
    images:     *u32;
    treed:      bool;
    tree:       Vector[u32];
}

# an empty snapshot holding nothing
# ---
# sn: the snapshot
# a:  allocator for its buffers, outliving it
pub fun init(sn: *Snapshot, a: *allo.Allocator) {
    sn.a      = a;
    sn.held   = false;
    sn.n      = 0;
    sn.cap    = 0;
    sn.at     = nil;
    sn.images = nil;
    sn.words  = 0;
    sn.treed  = false;
    sn.tree   = vector.init[u32](a);
}

fun release(sn: *Snapshot) {
    if (sn.cap == 0) { ret; }
    allo.deallocate[i64](sn.a, sn.at, sn.cap * 2);
    allo.deallocate[u32](sn.a, sn.images, sn.cap * sn.words);
    sn.at     = nil;
    sn.images = nil;
    sn.cap    = 0;
}

# forget the copy and free its buffers
pub fun drop(sn: *Snapshot) {
    release(sn);
    sn.held  = false;
    sn.n     = 0;
    sn.treed = false;
    vector.clear[u32](?sn.tree);
}

# free the buffers
pub fun dnit(sn: *Snapshot) {
    drop(sn);
    vector.dnit[u32](?sn.tree);
}

# take up the layers of a rule's cells as the ones the images are of, dropping
# buffers of another image size
fun shape(sn: *Snapshot, r: *rule.Rule) {
    var set: plane.Set = rule.layers(r);
    set = plane.without_views(?set);
    val words: usize = plane.image_words(?set);
    if (words != sn.words) { release(sn); }
    sn.set   = set;
    sn.words = words;
}

# the bytes the buffers take, the chunks' and the tree's
pub fun bytes(sn: *Snapshot) usize {
    ret sn.cap * (2 * 8 + sn.words * 4) + sn.tree.cap * 4;
}

# the index of the chunk at (cx, cy), or n when none is held
pub fun find(sn: *Snapshot, cx: i64, cy: i64) usize {
    var i: usize = 0;
    for (i < sn.n) {
        if (sn.at[i * 2] == cx && sn.at[i * 2 + 1] == cy) { ret i; }
        i = i + 1;
    }
    ret sn.n;
}

# the image of held chunk i, its layers' spans under the snapshot's set
pub fun image_of(sn: *Snapshot, i: usize) *u32 {
    ret ?sn.images[i * sn.words];
}

# values a held chunk's word holds, its rule's state and rule layers'
pub fun word_len(sn: *Snapshot) usize {
    ret plane.exact(?sn.set);
}

# words of a held chunk's image
pub fun image_words(sn: *Snapshot) usize {
    ret sn.words;
}

# the words of held chunk i's cells, row-major
# ---
# out: receives space.CELLS words, a cell's values together
pub fun words_of(sn: *Snapshot, i: usize, out: *u32) {
    val img: *u32  = image_of(sn, i);
    val m:   usize = plane.exact(?sn.set);
    var k:   usize = 0;
    for (k < space.CELLS) {
        space.image_word(?sn.set, img, k, ?out[k * m]);
        k = k + 1;
    }
}

# buffers for exactly n chunks, reused when they are big enough and not more
# than twice too big
fun fit(sn: *Snapshot, n: usize) err[allo.Error] {
    if (n <= sn.cap && n * 2 >= sn.cap) { ret err[allo.Error].ok{}; }
    release(sn);
    if (n == 0) { ret err[allo.Error].ok{}; }
    val at: res[*i64, allo.Error] = allo.allocate[i64](sn.a, n * 2);
    if (sel at.err) { ret err[allo.Error].err{at.err}; }
    val images: res[*u32, allo.Error] = allo.allocate[u32](sn.a, n * sn.words);
    if (sel images.err) {
        allo.deallocate[i64](sn.a, at.ok, n * 2);
        ret err[allo.Error].err{images.err};
    }
    sn.at     = at.ok;
    sn.images = images.ok;
    sn.cap    = n;
    ret err[allo.Error].ok{};
}

# start a copy built a chunk at a time with add, holding no chunks yet
# ---
# sn:         the snapshot, whose previous copy is dropped
# generation: the world's generation
# r:          the rule
pub fun open(sn: *Snapshot, generation: u64, r: *rule.Rule) {
    shape(sn, r);
    sn.n     = 0;
    sn.treed = false;
    vector.clear[u32](?sn.tree);
    sn.generation = generation;
    sn.rule       = @r;
    sn.held       = true;
}

# append one chunk's cells to a held copy, growing the buffers by doubling
# ---
# sn:    the snapshot, held
# cx:    the chunk's column
# cy:    the chunk's row
# cells: space.CELLS words, row-major, a cell's values together, of the rule
#        the copy was opened with
# ret:   ok, or the allocator's refusal, which leaves the copy as it was
pub fun add(sn: *Snapshot, cx: i64, cy: i64, cells: *u32) err[allo.Error] {
    if (sn.n == sn.cap) {
        var cap: usize = sn.cap * 2;
        if (cap == 0) { cap = 1; }
        val at: res[*i64, allo.Error] = allo.allocate[i64](sn.a, cap * 2);
        if (sel at.err) { ret err[allo.Error].err{at.err}; }
        val cs: res[*u32, allo.Error] = allo.allocate[u32](sn.a, cap * sn.words);
        if (sel cs.err) {
            allo.deallocate[i64](sn.a, at.ok, cap * 2);
            ret err[allo.Error].err{cs.err};
        }
        if (sn.n != 0) {
            mem.copy[i64](at.ok, sn.at, sn.n * 2);
            mem.copy[u32](cs.ok, sn.images, sn.n * sn.words);
        }
        release(sn);
        sn.at     = at.ok;
        sn.images = cs.ok;
        sn.cap    = cap;
    }
    sn.at[sn.n * 2]     = cx;
    sn.at[sn.n * 2 + 1] = cy;
    val img: *u32 = image_of(sn, sn.n);
    mem.zero[u32](img, sn.words);
    val m: usize = plane.exact(?sn.set);
    var k: usize = 0;
    for (k < space.CELLS) {
        space.put_image_word(?sn.set, img, k, ?cells[k * m]);
        k = k + 1;
    }
    sn.n = sn.n + 1;
    ret err[allo.Error].ok{};
}

# copy a pool's host cells, replacing whatever was held
#
# the host's cells must be current: on the GPU, sync first, and stored in the
# rule's layers.
# ---
# sn:         the snapshot
# sp:         the pool
# generation: the world's generation
# r:          the rule
# ret:        ok, or the allocator's refusal, which leaves nothing held
pub fun capture(sn: *Snapshot, sp: *space.Space, generation: u64, r: *rule.Rule) err[allo.Error] {
    sn.held  = false;
    sn.n     = 0;
    sn.treed = false;
    vector.clear[u32](?sn.tree);
    shape(sn, r);
    var n: usize = 0;
    var s: usize = 0;
    for (s < sp.hi) {
        if (space.used(sp, s) && space.holds_word(sp, s)) { n = n + 1; }
        s = s + 1;
    }
    val made: err[allo.Error] = fit(sn, n);
    if (sel made.err) { ret made; }
    s = 0;
    for (s < sp.hi) {
        if (space.used(sp, s) && space.holds_word(sp, s)) {
            sn.at[sn.n * 2]     = space.slot_x(sp, s);
            sn.at[sn.n * 2 + 1] = space.slot_y(sp, s);
            space.get_image(sp, s, image_of(sn, sn.n));
            sn.n = sn.n + 1;
        }
        s = s + 1;
    }
    sn.generation = generation;
    sn.rule       = @r;
    sn.held       = true;
    ret err[allo.Error].ok{};
}

# copy a tree's world, replacing whatever was held
# ---
# sn:         the snapshot
# t:          the tree, made
# generation: the world's generation
# r:          the rule
# ret:        false when the copy could not be stored, leaving nothing held
pub fun capture_tree(sn: *Snapshot, t: *hashlife.Tree, generation: u64, r: *rule.Rule) bool {
    drop(sn);
    if (!hashlife.export(t, ?sn.tree)) {
        vector.clear[u32](?sn.tree);
        ret false;
    }
    sn.treed      = true;
    sn.generation = generation;
    sn.rule       = @r;
    sn.held       = true;
    ret true;
}
