# the test-only trace family's layers and step, one source for the host and
# its step stage (cellar.rules.trace)

# bits of the state layer, a cell's state, 0 or 1
pub val STATE_WIDTH: u32 = 8;
# bits of the trace layer, a rule layer whose values make a cell live
pub val TRACE_WIDTH: u32 = 16;

# the trace a cell holds one generation on: one less, down to zero
#[inline]
pub fun next(t: u32) u32 {
    if (t == 0) { ret 0; }
    ret t - 1;
}
