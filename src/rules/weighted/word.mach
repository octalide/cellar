# the weighted family's cell word and its window of the meta head, one source
# for the host and the family's step stage. the non-totalistic family's cells
# are this word too, run in the same forms (cellar.rules.nontotalistic)
#
# a cell is one bit in the family's state layer, 1 while it lives, so a
# 32-bit word holds a row's run of 32 cells and a step works them at once
# (cellar.layer). its display channels lie in a view layer the step keeps
# beside it while the pool holds it, which it does only while the view's
# colour mode reads them: age << 8 | heat, 255 heat while alive and fading by
# DECAY a generation once dead, and the age a live cell has lived, up to
# AGE_MAX. a cell's sensed value is the two together, the bit then the
# channels (sense), and the bit alone where the pool holds no channels, which
# read as cold and ageless.
#
# a rule that births on 0 is run as Golly runs it, so the background the pool
# holds is always dead: a generation's cells are either the world's or its
# complement, as the rule's form (PLAIN, STROBE or COMPLEMENT) and the
# generation's parity say (see inverted).

use cellar.layout;

# bits of the family's state layer (cellar.layer): a cell is one bit
pub val WIDTH: u32 = 1;
# bits of the view layer holding its display channels, age << 8 | heat
pub val SHOWN: u32 = 16;

pub val HEAT_MASK: u32 = 255;
pub val AGE_SHIFT: u32 = 8;
# the oldest age a cell records, the oldest the draw tells apart
pub val AGE_MAX: u32 = 255;
# heat a dead cell loses per generation, giving fading trails
pub val DECAY: u32 = 12;
# the display channels of a live cell painted or seeded fresh: age 1, full heat
pub val BORN: u32 = 511;

# the window's words: the radius, the rule's form, the footprint's total
# weight, the greatest sum it reaches, where sums saturate, and the words each
# set of sums takes in the rule buffer, which holds the birth set, the survive
# set and the weights (see cellar.rules.weighted pack_table)
pub val RADIUS_AT: u32 = 0;
# the rule's form, PLAIN, STROBE or COMPLEMENT
pub val FORM_AT: u32 = 1;
# the sum of every footprint weight, negatives included, as an i32's bits
pub val TOTAL_AT: u32 = 2;
pub val TOP_AT:   u32 = 3;
pub val WORDS_AT: u32 = 4;
# the path a step takes, SLICED, ROWS or GENERAL (cellar.rules.weighted path)
pub val PATH_AT: u32 = 5;
# for ROWS, 1 when the center lies inside its row's run with weight 0
pub val HOLE_AT: u32 = 6;
# for ROWS, two words a footprint row from the top, its run's first column and
# the column past its last, each biased by RADIUS_MAX, equal for a row with
# no weight
pub val RUNS_AT: u32 = 8;

# how a kernel's step is computed, chosen from the shape of its footprint
# ---
# SLICED:  unit weights on the radius-1 Moore ring, the Life-like rules: a
#          row's cells a word, the eight neighbours added bit-sliced
# ROWS:    unit weights, each row of the footprint one run of them with the
#          center perhaps left out, Larger than Life's box and HROT's diamond,
#          circle and cross at any radius: each row's count of its run
# GENERAL: any other kernel: every weight of the footprint, cell by cell
pub val SLICED:  u32 = 0;
pub val ROWS:    u32 = 1;
pub val GENERAL: u32 = 2;

# the widest radius a footprint reaches, which sizes the stage's shared tile
pub val RADIUS_MAX: u32 = 16;

# the forms a rule runs in
# ---
# PLAIN:      no birth on 0: every generation's cells are the world's
# STROBE:     birth on 0 without survival at the all-live sum: the background
#             flips each generation, so odd generations hold the complement
# COMPLEMENT: birth on 0 and survival at the all-live sum: the background
#             stays live once flipped, so every generation holds the complement
#             and the rule runs as its complement rule
pub val PLAIN:      u32 = 0;
pub val STROBE:     u32 = 1;
pub val COMPLEMENT: u32 = 2;

# 1 when the cells of a generation of this parity hold the world's complement
# ---
# form:   the rule's form
# parity: the generation's low bit
pub fun inverted(form: u32, parity: u32) u32 {
    if (form == COMPLEMENT) { ret 1; }
    if (form == STROBE)     { ret parity & 1; }
    ret 0;
}

# a cell's display channels one generation on when it is not live: its heat
# fades and it has no age
#[inline]
pub fun cool(h: u32) u32 {
    val heat: u32 = h & HEAT_MASK;
    if (heat > DECAY) { ret heat - DECAY; }
    ret 0;
}

# a cell's display channels one generation on: a generation older at full
# heat when it lives, cooled when it does not
# ---
# h:    the channels as they were, age << 8 | heat
# live: 1 when it lives one generation on, as held, else 0
#[inline]
pub fun become(h: u32, live: u32) u32 {
    if (live != 0) {
        var age: u32 = (h >> AGE_SHIFT) + 1;
        if (age > AGE_MAX) { age = AGE_MAX; }
        ret (age << AGE_SHIFT) | HEAT_MASK;
    }
    ret cool(h);
}

# 1 when a cell past a plane's dead edge is held live to a step from a
# generation of this parity: the world's dead edge, held as its complement.
# the COMPLEMENT form runs as its complement rule and shows its cells as held,
# so its edge is dead as held, as Golly's is
# ---
# form:   the rule's form
# parity: the source generation's low bit
pub fun past(form: u32, parity: u32) u32 {
    if (form == STROBE) { ret parity & 1; }
    ret 0;
}

# how the shared stages read a cell's sensed value: the live bit, then the
# display channels above it (cellar.layer sensed). a live cell is warm, as is
# a dead one whose heat has not faded
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  1,
        live_lo:    1,
        live_hi:    1,
        warm_mask:  1 | (HEAT_MASK << WIDTH),
        heat_shift: WIDTH,
        heat_mask:  HEAT_MASK,
        age_shift:  WIDTH + AGE_SHIFT,
        age_mask:   AGE_MAX,
    };
}
