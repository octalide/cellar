# the weighted family's cell word and its window of the meta head, one source
# for the host and the family's step stage
#
# a cell is age << 8 | heat: alive while its age is nonzero, 255 heat while
# alive and fading by DECAY a generation once dead.

use cellar.layout;

pub val HEAT_MASK: u32 = 255;
pub val AGE_SHIFT: u32 = 8;
# the least value of a live cell
pub val LIVE: u32 = 256;
# the oldest age a cell records
pub val AGE_MAX: u32 = 0xffffff;
# heat a dead cell loses per generation, giving fading trails
pub val DECAY: u32 = 12;
# a live cell painted or seeded fresh: age 1, full heat
pub val BORN: u32 = 511;

# the window's words: the radius, the birth and survive masks as low and high
# halves, then the footprint's weights row-major
pub val RADIUS_AT:     u32 = 0;
pub val BIRTH_LO_AT:   u32 = 1;
pub val BIRTH_HI_AT:   u32 = 2;
pub val SURVIVE_LO_AT: u32 = 3;
pub val SURVIVE_HI_AT: u32 = 4;
pub val WEIGHTS_AT:    u32 = 5;
# added to each weight so the stage reads it as unsigned
pub val WEIGHT_BIAS: u32 = 1024;

# how the shared stages read the word
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  0xffffffff,
        live_lo:    LIVE,
        live_hi:    0xffffffff,
        warm_mask:  HEAT_MASK,
        heat_shift: 0,
        heat_mask:  HEAT_MASK,
        age_shift:  AGE_SHIFT,
        age_mask:   AGE_MAX,
    };
}
