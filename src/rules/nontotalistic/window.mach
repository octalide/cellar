# the non-totalistic family's window of the meta head, one source for the host
# and the family's step stage
#
# the family's cells are the weighted family's two-state word
# (cellar.rules.weighted.word), and its rule runs in the same forms.

# the window's words: the rule's form, PLAIN, STROBE or COMPLEMENT
# (cellar.rules.weighted.word), then the map, bit i % 32 of word MAP_AT + i / 32
# the next state of a cell whose 3 by 3 block reads as neighbourhood i
pub val FORM_AT: u32 = 0;
pub val MAP_AT:  u32 = 1;
# words of the map, one bit for each of the 512 neighbourhoods
pub val MAP_WORDS: u32 = 16;
