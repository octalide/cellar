# the table family's cell value and its window of the meta head, one source for
# the host and the family's step stage
#
# a cell is one byte of the family's 8-bit state layer: its state's heat, the
# state's place in the palette, spread evenly from the first live state to the
# last. every state but 0 is live, since a rule table gives no state a meaning
# of its own. no two states of a rule share a heat, so the value names the
# state, read back with the rule's state count (state). the draw takes the
# value as the heat it shows, so the trail ramp tells the states apart and the
# draw finds a state's colour by its heat (see cellar.rule colour).

use cellar.layout;

# bits of the family's state layer (cellar.layer): a cell's heat
pub val WIDTH: u32 = 8;

pub val HEAT_MASK: u32 = 255;
# the most states a rule table may have
pub val STATES_MAX: u32 = 256;

# the window's words: the rule's number of states, the inputs a lookup reads,
# the root of the tree in the rule buffer, then per input the position it reads
# in the 3 by 3 block around the cell, row-major with the cell at 4, in the
# order the tree reads them
pub val STATES_AT: u32 = 0;
pub val INPUTS_AT: u32 = 1;
pub val ROOT_AT:   u32 = 2;
pub val AT_AT:     u32 = 3;

# the heat a cell of a state shows under a rule of n states
# ---
# state: the state
# n:     the rule's states, 2 to STATES_MAX
# ret:   0 for state 0 or a state the rule lacks, 255 for the last state, and
#        evenly between for the rest
pub fun heat(state: u32, n: u32) u32 {
    if (state >= n) { ret 0; }
    ret (state * HEAT_MASK) / (n - 1);
}

# the value of a cell of a state under a rule of n states, its heat
pub fun word(state: u32, n: u32) u32 {
    ret heat(state, n);
}

# the state a value holds under a rule of n states, the one whose heat it is:
# a state's step is 255 / (n - 1) of heat, at least one, so the state is the
# first whose heat reaches the value
# ---
# v:   a value word gives under the rule
# n:   the rule's states, 2 to STATES_MAX
# ret: the state
pub fun state(v: u32, n: u32) u32 {
    ret (v * (n - 1) + HEAT_MASK - 1) / HEAT_MASK;
}

# how the shared stages read a value: every one but 0 is live and keeps a
# chunk, and the whole value is the heat
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  HEAT_MASK,
        live_lo:    1,
        live_hi:    HEAT_MASK,
        warm_mask:  HEAT_MASK,
        heat_shift: 0,
        heat_mask:  HEAT_MASK,
        age_shift:  0,
        age_mask:   0,
    };
}
