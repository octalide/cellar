# the table family's cell word and its window of the meta head, one source for
# the host and the family's step stage
#
# a cell is heat << 8 | state. every state but 0 is live, since a rule table
# gives no state a meaning of its own. the heat is the state's place in the
# palette, spread evenly from the first live state to the last, so the trail
# ramp tells the states apart and the draw finds a state's colour by its heat
# (see cellar.rule colour).

use cellar.layout;

# bits of the family's state layer (cellar.layer): a cell is one word
pub val WIDTH: u32 = 32;

pub val STATE_MASK: u32 = 255;
pub val HEAT_SHIFT: u32 = 8;
pub val HEAT_MASK:  u32 = 255;
# the most states a rule table may have
pub val STATES_MAX: u32 = 256;

# the window's words: the rule's number of states, the inputs a lookup reads,
# the root of the tree in the rule buffer, then per input the position it reads
# in the 3 by 3 block around the cell, row-major with the cell at 4, in the
# order the tree reads them
pub val STATES_AT: u32 = 0;
pub val INPUTS_AT: u32 = 1;
pub val ROOT_AT:   u32 = 2;
pub val AT_AT:     u32 = 3;

# the heat a cell of a state shows under a rule of n states
# ---
# state: below n
# n:     the rule's states, 2 to STATES_MAX
# ret:   0 for state 0, 255 for the last state, and evenly between for the rest
pub fun heat(state: u32, n: u32) u32 {
    if (state == 0) { ret 0; }
    ret (state * HEAT_MASK) / (n - 1);
}

# the word of a cell of a state under a rule of n states
pub fun word(state: u32, n: u32) u32 {
    ret (heat(state, n) << HEAT_SHIFT) | state;
}

# how the shared stages read the word: every state but 0 is live and keeps a
# chunk, and the heat is the state's place in the palette
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  STATE_MASK,
        live_lo:    1,
        live_hi:    STATE_MASK,
        warm_mask:  STATE_MASK,
        heat_shift: HEAT_SHIFT,
        heat_mask:  HEAT_MASK,
        age_shift:  0,
        age_mask:   0,
    };
}
