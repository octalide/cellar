# a family that exists only for tests, registered at run time
# (cellar.rule.family), whose cells are live by a rule layer alone: an 8-bit
# state layer, 0 or 1, and a 16-bit trace layer declared live (cellar.layer),
# stepped on both engines, the GPU's through a stage that binds the trace
# layer beside the state layer.
#
# its rule is "trace": a cell keeps its state forever, and its trace counts
# down to zero, a generation at a time. a cell holding a trace and state 0 is
# live while the trace lasts, so the census counts it, its chunk is kept and
# asks for its halo, and its pyramid shows it, on both engines, until the
# trace runs out and the chunk, holding nothing else, is freed.

use cellar.layer.plane;
use cellar.layout;
use cellar.rule.family;
use cellar.rules.trace.word;
use cellar.space;
use cellar.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

#[embed("{artifact.stage-trace_comp.out}")]
val STAGE: [_]u8;

# the family's rule, which has nothing to choose
# ---
# states: how many states a cell can be in, 2
rec Rule {
    states: u32;
}

fun parse(s: *u8) err[str] {
    if (!string.str_equals(s, "trace")) { ret err[str].err{"not the trace family's rule"}; }
    ret err[str].ok{};
}

fun claims(s: str) bool {
    ret string.str_equals(s, "trace");
}

fun fam_parse(s: str, p: *family.Payload) err[str] {
    val e: err[str] = parse(s);
    if (sel e.err) { ret e; }
    family.view[Rule](p).states = 2;
    ret e;
}

fun fam_format(p: *family.Payload, buf: *u8) str {
    buf[text.buf_str(buf, 0, "trace")] = 0;
    ret buf;
}

fun fam_same(a: *family.Payload, b: *family.Payload) bool {
    ret true;
}

fun fam_states(p: *family.Payload) u32 {
    ret 2;
}

fun fam_layers(p: *family.Payload) plane.Set {
    var s: plane.Set = plane.state("state", word.STATE_WIDTH);
    plane.add_live(?s, "trace", word.TRACE_WIDTH);
    ret s;
}

fun fam_word_of(p: *family.Payload, state: u32) u32 {
    ret state;
}

# a fresh cell holds no trace
fun fam_rest_of(p: *family.Payload, state: u32, k: usize) u32 {
    ret 0;
}

fun state_of(c: u32) u32 {
    ret c;
}

fun fam_state_of(p: *family.Payload, c: u32) u32 {
    ret state_of(c);
}

# a cell's state, read from its state layer alone, its trace aside
fun fam_word_state(p: *family.Payload, w: *u32) u32 {
    ret state_of(w[0]);
}

fun fam_ink(p: *family.Payload) u32 {
    ret 1;
}

fun fam_slack(p: *family.Payload) u32 {
    ret 0;
}

fun sense() layout.Sense {
    ret layout.Sense{live_mask: 0xff, live_lo: 1, live_hi: 1, warm_mask: 0xff, heat_shift: 0, heat_mask: 0, age_shift: 0, age_mask: 0};
}

fun fam_radius(p: *family.Payload) usize {
    ret 1;
}

fun fam_caps(p: *family.Payload) family.Caps {
    ret family.Caps{b0: false, isotropic: true, no_tree: "a rule layer of its own", bounded: false, life_like: false, continuous: false};
}

# a cell keeps its state, and its trace counts down
fun fam_step_chunk(p: *family.Payload, b: *space.Block, t: *space.Tally) {
    val own:    *u32  = space.block_own(b, 0).w;
    val out:    *u32  = space.block_out(b, 0).w;
    val traced: *u32  = space.block_own(b, 1).w;
    val traces: *u32  = space.block_out(b, 1).w;
    var i:      usize = 0;
    for (i < layout.CELLS::usize) {
        val c: u32 = plane.load(own, word.STATE_WIDTH, i);
        val n: u32 = word.next(plane.load(traced, word.TRACE_WIDTH, i));
        plane.store(out, word.STATE_WIDTH, i, c);
        plane.store(traces, word.TRACE_WIDTH, i, n);
        space.note_with(t, c, n, (i % 64)::u32, (i / 64)::u32);
        i = i + 1;
    }
}

fun fam_next_of(p: *family.Payload, nb: *u32) u32 {
    ret nb[4];
}

fun fam_pack(p: *family.Payload, w: *u32) {
    var i: usize = 0;
    for (i < layout.RULE::usize) {
        w[i] = 0;
        i    = i + 1;
    }
}

fun fam_table_words(p: *family.Payload) usize {
    ret 0;
}

fun fam_pack_table(p: *family.Payload, w: *u32) {}

fun fam_colour(p: *family.Payload, state: u32) opt[u32] {
    ret opt[u32].none{};
}

fun stage(len: *usize) *u8 {
    @len = $length_of(STAGE);
    ret ?STAGE[0];
}

fun sample(i: usize) str {
    ret "trace";
}

# the family's record
#[testing]
pub val FAMILY: family.Family = family.Family{
    id:          "trace",
    size:        $size_of(Rule),
    parse:       fam_parse,
    claims:      claims,
    format:      fam_format,
    display:     fam_format,
    same:        fam_same,
    states:      fam_states,
    layers:      fam_layers,
    word_of:     fam_word_of,
    rest_of:     fam_rest_of,
    state_of:    fam_state_of,
    word_state:  fam_word_state,
    ink:         fam_ink,
    slack:       fam_slack,
    sense:       sense,
    radius:      fam_radius,
    caps:        fam_caps,
    step_chunk:  fam_step_chunk,
    next_of:     fam_next_of,
    pack:        fam_pack,
    table:       false,
    table_words: fam_table_words,
    pack_table:  fam_pack_table,
    colour:      fam_colour,
    stage:       stage,
    samples:     1,
    sample:      sample,
};

# register the family, for a test that runs it
#[testing]
pub fun register() {
    family.register(?FAMILY);
}
