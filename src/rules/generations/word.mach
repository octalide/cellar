# the generations family's cell word and its window of the meta head, one
# source for the host and the family's step stage
#
# a cell is heat << 8 | state. state 0 is dead, 1 alive and 2 up to the rule's
# last state dying. the heat is the state's place in the palette: full for a
# live cell, then falling evenly across the dying states, so the trail ramp
# gives every state its own colour.

use cellar.layout;

# bits of the family's state layer (cellar.layer): a cell is one word
pub val WIDTH: u32 = 32;

pub val STATE_MASK: u32 = 255;
pub val HEAT_SHIFT: u32 = 8;
pub val HEAT_MASK:  u32 = 255;
# the state that counts as a neighbour, and the only one born or surviving
pub val LIVE: u32 = 1;
# the most states a rule may have
pub val STATES_MAX: u32 = 256;

# the window's words: the birth and survive masks over the live neighbour
# count, then the rule's number of states
pub val BIRTH_AT:   u32 = 0;
pub val SURVIVE_AT: u32 = 1;
pub val STATES_AT:  u32 = 2;

# the heat a cell of a state shows under a rule of n states
# ---
# state: below n
# n:     the rule's states, at least 2
# ret:   0 for a dead cell, 255 for a live one, and between for a dying one
pub fun heat(state: u32, n: u32) u32 {
    if (state == 0)    { ret 0; }
    if (state == LIVE) { ret HEAT_MASK; }
    ret HEAT_MASK - ((state - 1) * HEAT_MASK) / (n - 1);
}

# the word of a cell of a state under a rule of n states
pub fun word(state: u32, n: u32) u32 {
    ret (heat(state, n) << HEAT_SHIFT) | state;
}

# the state after a cell's, given whether the rule births or keeps it
# ---
# state: the cell's state
# n:     the rule's states
# hit:   the rule's birth mask holds the live count for a dead cell, or its
#        survive mask for a live one
# ret:   the state one generation on
pub fun next(state: u32, n: u32, hit: u32) u32 {
    if (state == 0) {
        if (hit != 0) { ret LIVE; }
        ret 0;
    }
    if (state == LIVE && hit != 0) { ret LIVE; }
    if (state + 1 >= n)            { ret 0; }
    ret state + 1;
}

# how the shared stages read the word: only state 1 is live, and any state
# but 0 keeps a chunk
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  STATE_MASK,
        live_lo:    LIVE,
        live_hi:    LIVE,
        warm_mask:  STATE_MASK,
        heat_shift: HEAT_SHIFT,
        heat_mask:  HEAT_MASK,
        age_shift:  0,
        age_mask:   0,
    };
}
