# the generations family's cell value and its window of the meta head, one
# source for the host and the family's step stage
#
# a cell is one byte of the family's 8-bit state layer: its state's heat, the
# state's place in the palette. state 0 is dead, 1 alive and 2 up to the
# rule's last state dying. the heat is full for a live cell, then falls evenly
# across the dying states, so the trail ramp gives every state its own colour.
# no two states of a rule share a heat, so the value names the state, read
# back with the rule's state count (state), and the draw takes the value as
# the heat it shows (sense).

use cellar.layout;

# bits of the family's state layer (cellar.layer): a cell's heat
pub val WIDTH: u32 = 8;

pub val HEAT_MASK: u32 = 255;
# the state that counts as a neighbour, and the only one born or surviving
pub val LIVE: u32 = 1;
# the value a live cell holds under every rule, the full heat
pub val LIVE_VALUE: u32 = HEAT_MASK;
# the most states a rule may have
pub val STATES_MAX: u32 = 256;

# the window's words: the birth and survive masks over the live neighbour
# count, then the rule's number of states
pub val BIRTH_AT:   u32 = 0;
pub val SURVIVE_AT: u32 = 1;
pub val STATES_AT:  u32 = 2;

# the heat a cell of a state shows under a rule of n states
# ---
# state: the state
# n:     the rule's states, 2 to STATES_MAX
# ret:   0 for a dead cell or a state the rule lacks, 255 for a live one, and
#        between for a dying one
pub fun heat(state: u32, n: u32) u32 {
    if (state == 0 || state >= n) { ret 0; }
    if (state == LIVE)            { ret HEAT_MASK; }
    ret HEAT_MASK - ((state - 1) * HEAT_MASK) / (n - 1);
}

# the value of a cell of a state under a rule of n states, its heat
pub fun word(state: u32, n: u32) u32 {
    ret heat(state, n);
}

# the state a value holds under a rule of n states, the one whose heat it is
# ---
# v:   a value word gives under the rule
# n:   the rule's states, 2 to STATES_MAX
# ret: the state
pub fun state(v: u32, n: u32) u32 {
    if (v == 0)          { ret 0; }
    if (v == LIVE_VALUE) { ret LIVE; }
    # heat's inverse: the first dying state whose fall from full heat reaches
    # the value's, a state's step being 255 / (n - 1) of heat, at least one
    ret 1 + ((HEAT_MASK - v) * (n - 1) + HEAT_MASK - 1) / HEAT_MASK;
}

# the state after a cell's, given whether the rule births or keeps it
# ---
# state: the cell's state
# n:     the rule's states
# hit:   the rule's birth mask holds the live count for a dead cell, or its
#        survive mask for a live one
# ret:   the state one generation on
pub fun next(state: u32, n: u32, hit: u32) u32 {
    if (state == 0) {
        if (hit != 0) { ret LIVE; }
        ret 0;
    }
    if (state == LIVE && hit != 0) { ret LIVE; }
    if (state + 1 >= n)            { ret 0; }
    ret state + 1;
}

# how the shared stages read a value: only the live one, full heat, is live,
# any but 0 keeps a chunk, and the whole value is the heat
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  HEAT_MASK,
        live_lo:    LIVE_VALUE,
        live_hi:    LIVE_VALUE,
        warm_mask:  HEAT_MASK,
        heat_shift: 0,
        heat_mask:  HEAT_MASK,
        age_shift:  0,
        age_mask:   0,
    };
}
