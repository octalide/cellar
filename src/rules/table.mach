# the table family: rules given as a transition table or tree, Golly's
# RuleLoader .rule files
#
# a rule is a table of up to 256 states over the von Neumann, Moore or
# hexagonal neighbourhood, read by cellar.rules.table.load into a decision tree
# and kept by cellar.rules.table.store, so the rule itself is the id of a kept
# table. its rule string is the table's name, as Golly writes one, and a name
# is looked up as the store says. every state but 0 is live, a neighbourhood
# the table gives no transition for keeps the cell, and a table whose empty
# neighbourhood gives a live cell is refused, so no rule of the family births
# on 0. its cells are an 8-bit state layer of cellar.rules.table.word's values,
# its step stage table_comp,
# which walks the tree the rule buffer holds, and its palette the table's
# @COLORS, or Golly's gradient from red to yellow without them.

use cellar.layer.plane;
use cellar.layout;
use cellar.rule.family;
use cellar.rules.table.load;
use cellar.rules.table.store;
use cellar.rules.table.word;
use cellar.space;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

#[embed("{artifact.stage-table_comp.out}")]
val STAGE: [_]u8;

# a rule table
# ---
# id: the kept table (cellar.rules.table.store)
pub rec Rule {
    id: u32;
}

# read the family's rule string: the name of a rule table
# ---
# s:   NUL-terminated rule text
# ret: the rule, or what is wrong with s
pub fun parse(s: str) res[Rule, str] {
    var i: usize = 0;
    for (s[i] == ' ') { i = i + 1; }
    val got: res[u32, str] = store.resolve(?s[i]);
    if (sel got.err) { ret res[Rule, str].err{got.err}; }
    ret res[Rule, str].ok{Rule{id: got.ok}};
}

# whether a rule string is plausibly this family's, so that a string every
# family refuses reports the error of the family it meant: a bare name, one
# that does not start with a digit, as the other families' forms do, nor holds
# an '=', as the lenia family's parameters do
# ---
# s: NUL-terminated rule text
pub fun claims(s: str) bool {
    var i: usize = 0;
    for (s[i] == ' ') { i = i + 1; }
    var j: usize = i;
    for (s[j] != 0) {
        if (s[j] == '=') { ret false; }
        j = j + 1;
    }
    ret !(s[i] >= '0' && s[i] <= '9') && load.name_ok(?s[i]);
}

# the longest rule string format writes, less its NUL: a table's name
pub val FORMAT_MAX: usize = load.NAME_MAX;

# write the family's rule string, the table's name
# ---
# r:   the rule
# buf: at least FORMAT_MAX + 1 bytes
# ret: buf, which parse reads back as r while the name resolves to the table
pub fun format(r: *Rule, buf: *u8) str {
    val name: str = store.name(r.id);
    mem.copy[u8](buf, name, string.str_len(name) + 1);
    ret buf;
}

# write a rule's short form for the readout, its name
pub fun display(r: *Rule, buf: *u8) str {
    ret format(r, buf);
}

# whether two rules step alike: they hold the same kept table
pub fun same_rule(a: *Rule, b: *Rule) bool {
    ret a.id == b.id;
}

# how many states a cell of the rule can be in
pub fun states(r: *Rule) u32 {
    ret store.get(r.id).states;
}

# the value a fresh cell of a state is written as
pub fun word_of(r: *Rule, state: u32) u32 {
    ret word.word(state, states(r));
}

# the state a value holds
pub fun state_of(r: *Rule, c: u32) u32 {
    ret word.state(c, states(r));
}

# the state painted or seeded when none is chosen: the live one
pub fun ink(r: *Rule) u32 {
    ret 1;
}

# how far the engines' words for a cell may lie apart: none, the GPU stepping
# every rule of the family bit for bit as the CPU does
pub fun slack(r: *Rule) u32 {
    ret 0;
}

# the value a fresh cell of a state holds in rule layer k: none, since the
# family's cells are its state layer alone
pub fun rest_of(r: *Rule, state: u32, k: usize) u32 {
    ret 0;
}

# the layers the family's cells are stored in (cellar.layer): the state
# layer alone, word.WIDTH bits wide
pub fun layers(r: *Rule) plane.Set {
    ret plane.state("state", word.WIDTH);
}

# how shared code reads a value of the family's state layer
pub fun sense() layout.Sense {
    ret word.sense();
}

# how far one generation reaches: every neighbourhood is within a cell
pub fun radius(r: *Rule) usize {
    ret 1;
}

# what the family's capabilities come to for one rule
# b0:         a dead cell with no live neighbour is born, which the loader refuses
# isotropic:  the table's symmetries take in every rotation and reflection
# no_tree:    why a quadtree engine cannot run it, nil when it can
# bounded:    it can run on a bounded grid
# life_like:  it is a Life-like rule, which no table is taken as
# continuous: a cell's state is all it holds, in every rule
pub fun caps(r: *Rule) family.Caps {
    ret family.Caps{b0: false, isotropic: store.get(r.id).iso, no_tree: "a rule table", bounded: true, life_like: false, continuous: false};
}

# the state a cell becomes from the states of the 3 by 3 block around it
# ---
# r:   the rule
# nb:  the nine states, row-major with the cell at 4
# ret: its next state
pub fun next_of(r: *Rule, nb: *u32) u32 {
    ret load.next(store.get(r.id), nb);
}

# step one chunk on the CPU, walking the tree for every cell as the family's
# stage does
#
# a chunk with no live cell in its block holds only zeros, and the empty
# neighbourhood steps to 0, so it stays empty.
# ---
# r: the rule
# b: the chunk's block and back cells
# t: the tally of the cells written
pub fun step_chunk(r: *Rule, b: *space.Block, t: *space.Tally) {
    val out: *u32 = space.block_out(b, 0).w;
    if (!b.busy) {
        plane.clear(plane.at(out, word.WIDTH));
        ret;
    }
    val tb:   *load.Table = store.get(r.id);
    val n:    u32         = tb.states;
    val tree: *u32        = tb.tree.data;
    var dx:   [9]i64;
    var dy:   [9]i64;
    var q:    usize       = 0;
    for (q < tb.inputs::usize) {
        dx[q] = (tb.at[q] % 3)::i64 - 1;
        dy[q] = (tb.at[q] / 3)::i64 - 1;
        q     = q + 1;
    }
    var ly: i64 = 0;
    for (ly < 64) {
        var lx: i64 = 0;
        for (lx < 64) {
            var p: u32 = tb.root;
            q = 0;
            for (q < tb.inputs::usize) {
                val c: u32 = word.state(space.block_cell(b, word.WIDTH, lx + dx[q], ly + dy[q]), n);
                p = tree[(p + c)::usize];
                q = q + 1;
            }
            val v: u32 = word.word(p, n);
            plane.store(out, word.WIDTH, (ly * 64 + lx)::usize, v);
            space.note(t, v, lx::u32, ly::u32);
            lx = lx + 1;
        }
        ly = ly + 1;
    }
}

# pack a rule into the family's window of the meta head, as its stage reads it
# ---
# r: the rule
# w: layout.RULE words
pub fun pack(r: *Rule, w: *u32) {
    mem.zero[u32](w, layout.RULE::usize);
    val tb: *load.Table = store.get(r.id);
    w[word.STATES_AT] = tb.states;
    w[word.INPUTS_AT] = tb.inputs;
    w[word.ROOT_AT]   = tb.root;
    var i: u32 = 0;
    for (i < tb.inputs) {
        w[word.AT_AT + i] = tb.at[i::usize];
        i                 = i + 1;
    }
}

# the family's stage binds a rule buffer: the tree
pub val TABLE: bool = true;

# the words of the rule buffer a rule needs, its tree's
pub fun table_words(r: *Rule) usize {
    ret store.get(r.id).tree.len;
}

# pack a rule's tree into the rule buffer
# ---
# r: the rule
# w: table_words(r) words
pub fun pack_table(r: *Rule, w: *u32) {
    val tb: *load.Table = store.get(r.id);
    mem.copy[u32](w, tb.tree.data, tb.tree.len);
}

# the colour a state is drawn in, 0xrrggbb, the table's own
pub fun colour(r: *Rule, state: u32) opt[u32] {
    ret opt[u32].some{store.get(r.id).colours[state::usize]};
}

# the family's step stage, as SPIR-V
# ---
# len: receives its length in bytes
# ret: its first byte
pub fun stage(len: *usize) *u8 {
    @len = $length_of(STAGE);
    ret ?STAGE[0];
}

# rule strings that exercise the family, for the tests that run every family:
# the built-in WireWorld, Moore with its states' own transitions, and Langton's
# Loops, von Neumann with rotations
pub val SAMPLE_COUNT: usize = 2;

# the sample rule string i
pub fun sample(i: usize) str {
    if (i == 1) { ret "Langtons-Loops"; }
    ret "WireWorld";
}

# the family's record (cellar.rule.family)
pub val FAMILY: family.Family = family.Family{
    id:          "table",
    size:        $size_of(Rule),
    parse:       fam_parse,
    claims:      claims,
    format:      fam_format,
    display:     fam_display,
    same:        fam_same,
    states:      fam_states,
    layers:      fam_layers,
    word_of:     fam_word_of,
    rest_of:     fam_rest_of,
    state_of:    fam_state_of,
    ink:         fam_ink,
    slack:       fam_slack,
    sense:       sense,
    radius:      fam_radius,
    caps:        fam_caps,
    step_chunk:  fam_step_chunk,
    next_of:     fam_next_of,
    pack:        fam_pack,
    table:       TABLE,
    table_words: fam_table_words,
    pack_table:  fam_pack_table,
    colour:      fam_colour,
    stage:       stage,
    samples:     SAMPLE_COUNT,
    sample:      sample,
};

$if ($size_of(Rule) > family.PAYLOAD_BYTES || $align_of(Rule) > 8) {
    $error("the family's rule does not fit a rule's payload");
}

$if (FORMAT_MAX > family.FORMAT_MAX) {
    $error("the family's rule string is longer than a rule's");
}

# the family's operations over a payload, for its record
fun held(p: *family.Payload) *Rule {
    ret family.view[Rule](p);
}

fun fam_parse(s: str, p: *family.Payload) err[str] {
    val r: res[Rule, str] = parse(s);
    if (sel r.err) { ret err[str].err{r.err}; }
    val d: *Rule = held(p);
    @d = r.ok;
    ret err[str].ok{};
}

fun fam_format(p: *family.Payload, buf: *u8) str {
    ret format(held(p), buf);
}

fun fam_display(p: *family.Payload, buf: *u8) str {
    ret display(held(p), buf);
}

fun fam_same(a: *family.Payload, b: *family.Payload) bool {
    ret same_rule(held(a), held(b));
}

fun fam_states(p: *family.Payload) u32 {
    ret states(held(p));
}

fun fam_layers(p: *family.Payload) plane.Set {
    ret layers(held(p));
}

fun fam_word_of(p: *family.Payload, state: u32) u32 {
    ret word_of(held(p), state);
}

fun fam_rest_of(p: *family.Payload, state: u32, k: usize) u32 {
    ret rest_of(held(p), state, k);
}

fun fam_state_of(p: *family.Payload, c: u32) u32 {
    ret state_of(held(p), c);
}

fun fam_ink(p: *family.Payload) u32 {
    ret ink(held(p));
}

fun fam_slack(p: *family.Payload) u32 {
    ret slack(held(p));
}

fun fam_radius(p: *family.Payload) usize {
    ret radius(held(p));
}

fun fam_caps(p: *family.Payload) family.Caps {
    ret caps(held(p));
}

fun fam_step_chunk(p: *family.Payload, b: *space.Block, t: *space.Tally) {
    step_chunk(held(p), b, t);
}

fun fam_next_of(p: *family.Payload, nb: *u32) u32 {
    ret next_of(held(p), nb);
}

fun fam_pack(p: *family.Payload, w: *u32) {
    pack(held(p), w);
}

fun fam_table_words(p: *family.Payload) usize {
    ret table_words(held(p));
}

fun fam_pack_table(p: *family.Payload, w: *u32) {
    pack_table(held(p), w);
}

fun fam_colour(p: *family.Payload, state: u32) opt[u32] {
    ret colour(held(p), state);
}
