# a family that exists only for tests, registered at run time
# (cellar.rule.family), that holds the contract to the members furthest from
# the families every build runs: the CPU alone steps it, having no stage, and
# its word is a 16-bit state layer with rule layers of 32 and 16 bits beside
# it, 64 bits in all.
#
# its rule is "probe": a cell keeps its state, 0 or 1, forever. a live cell's
# first rule layer counts the generations it has lived, from a fresh cell's
# AGED, and its second holds MARK, both untouched while it is dead

use cellar.layer.plane;
use cellar.layout;
use cellar.rule.family;
use cellar.space;
use cellar.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# the family's rule, which has nothing to choose
# ---
# states: how many states a cell can be in, 2
rec Rule {
    states: u32;
}

# what a fresh live cell holds in its rule layers, a value of each layer's
# full width
val AGED: u32 = 0x80000001;
val MARK: u32 = 0xabcd;

# the state, count and mark layers' widths
val STATE_WIDTH: u32 = 16;
val COUNT_WIDTH: u32 = 32;
val MARK_WIDTH:  u32 = 16;

fun parse(s: *u8) err[str] {
    if (!string.str_equals(s, "probe")) { ret err[str].err{"not the probe family's rule"}; }
    ret err[str].ok{};
}

fun claims(s: str) bool {
    ret string.str_equals(s, "probe");
}

fun fam_parse(s: str, p: *family.Payload) err[str] {
    val e: err[str] = parse(s);
    if (sel e.err) { ret e; }
    family.view[Rule](p).states = 2;
    ret e;
}

fun fam_format(p: *family.Payload, buf: *u8) str {
    buf[text.buf_str(buf, 0, "probe")] = 0;
    ret buf;
}

fun fam_same(a: *family.Payload, b: *family.Payload) bool {
    ret true;
}

fun fam_states(p: *family.Payload) u32 {
    ret 2;
}

fun fam_layers(p: *family.Payload) plane.Set {
    var s: plane.Set = plane.state("probe", STATE_WIDTH);
    plane.add_rule(?s, "age", COUNT_WIDTH);
    plane.add_rule(?s, "mark", MARK_WIDTH);
    ret s;
}

fun fam_word_of(p: *family.Payload, state: u32) u32 {
    ret state;
}

fun fam_rest_of(p: *family.Payload, state: u32, k: usize) u32 {
    if (state == 0) { ret 0; }
    if (k == 1)     { ret AGED; }
    ret MARK;
}

fun state_of(c: u32) u32 {
    ret c;
}

fun fam_state_of(p: *family.Payload, c: u32) u32 {
    ret state_of(c);
}

# a cell's state, read from its state layer alone
fun fam_word_state(p: *family.Payload, w: *u32) u32 {
    ret state_of(w[0]);
}

fun fam_ink(p: *family.Payload) u32 {
    ret 1;
}

fun fam_slack(p: *family.Payload) u32 {
    ret 0;
}

fun sense() layout.Sense {
    ret layout.Sense{live_mask: 0xffff, live_lo: 1, live_hi: 1, warm_mask: 0, heat_shift: 0, heat_mask: 0, age_shift: 0, age_mask: 0};
}

fun fam_radius(p: *family.Payload) usize {
    ret 1;
}

fun fam_caps(p: *family.Payload) family.Caps {
    ret family.Caps{b0: false, isotropic: true, no_tree: nil, bounded: true, life_like: false, continuous: false};
}

# a cell keeps its state, and a live one's age counts on
fun fam_step_chunk(p: *family.Payload, b: *space.Block, t: *space.Tally) {
    val own:    *u32  = space.block_own(b, 0).w;
    val out:    *u32  = space.block_out(b, 0).w;
    val age:    *u32  = space.block_own(b, 1).w;
    val aged:   *u32  = space.block_out(b, 1).w;
    val mark:   *u32  = space.block_own(b, 2).w;
    val marked: *u32  = space.block_out(b, 2).w;
    var i:      usize = 0;
    for (i < layout.CELLS::usize) {
        val c: u32 = plane.load(own, STATE_WIDTH, i);
        var n: u32 = plane.load(age, COUNT_WIDTH, i);
        if (c != 0) { n = n + 1; }
        plane.store(out, STATE_WIDTH, i, c);
        plane.store(aged, COUNT_WIDTH, i, n);
        plane.store(marked, MARK_WIDTH, i, plane.load(mark, MARK_WIDTH, i));
        space.note(t, c, (i % 64)::u32, (i / 64)::u32);
        i = i + 1;
    }
}

fun fam_next_of(p: *family.Payload, nb: *u32) u32 {
    ret nb[4];
}

fun fam_pack(p: *family.Payload, w: *u32) {
    var i: usize = 0;
    for (i < layout.RULE::usize) {
        w[i] = 0;
        i    = i + 1;
    }
}

fun fam_table_words(p: *family.Payload) usize {
    ret 0;
}

fun fam_pack_table(p: *family.Payload, w: *u32) {}

fun fam_colour(p: *family.Payload, state: u32) opt[u32] {
    ret opt[u32].none{};
}

fun sample(i: usize) str {
    ret "probe";
}

# the family's record
#[testing]
pub val FAMILY: family.Family = family.Family{
    id:          "probe",
    size:        $size_of(Rule),
    parse:       fam_parse,
    claims:      claims,
    format:      fam_format,
    display:     fam_format,
    same:        fam_same,
    states:      fam_states,
    layers:      fam_layers,
    word_of:     fam_word_of,
    rest_of:     fam_rest_of,
    state_of:    fam_state_of,
    word_state:  fam_word_state,
    ink:         fam_ink,
    slack:       fam_slack,
    sense:       sense,
    radius:      fam_radius,
    caps:        fam_caps,
    step_chunk:  fam_step_chunk,
    next_of:     fam_next_of,
    pack:        fam_pack,
    table:       false,
    table_words: fam_table_words,
    pack_table:  fam_pack_table,
    colour:      fam_colour,
    stage:       nil,
    samples:     1,
    sample:      sample,
};

# register the family, for a test that runs it
#[testing]
pub fun register() {
    family.register(?FAMILY);
}
