# a rule family for the tests alone, whose cells hold more than one word's
# worth of values: the hardest member of the layer contract (cellar.layer)
#
# its rule string, "Probe", reads only once a test has enabled the family, so
# no world outside a test runs it. a cell is three 16-bit values, 48 bits in
# all: its state, 0 dead and 1 live, in the state layer, and two rule layers
# of memory beside it, age, the generations it has lived, and mix, a value
# stirred each generation it lives, both 0 while it is dead. the state steps as
# Conway's Life, so its patterns are Life's, and a copy, a file, the undo
# journal or a re-encoding that dropped a rule layer would show in the memory.
#
# it has no GPU stage and runs on the CPU alone, and its memory keeps it off
# the quadtree.

use cellar.layer.plane;
use cellar.layout;
use cellar.space;
use cellar.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# bits of each of its layers
pub val WIDTH: u32 = 16;
# the greatest value a layer holds
val TOP: u32 = 0xffff;
# what a fresh live cell's memory holds
pub val AGE_FRESH: u32 = 1;
pub val MIX_FRESH: u32 = 7;

# what a rule can do, as cellar.rule.Caps
pub rec Caps {
    b0:         bool;
    isotropic:  bool;
    no_tree:    str;
    bounded:    bool;
    life_like:  bool;
    continuous: bool;
}

# the rule, which has nothing to choose
pub rec Rule {
    unused: u32;
}

# whether a test has enabled the family
var enabled: bool = false;

# let the family's rule string read, for the rest of the test
#[testing]
pub fun enable() {
    enabled = true;
}

# the rule string the family reads, once enabled
val NAME: str = "Probe";

# whether s is the family's rule string, once enabled
pub fun claims(s: str) bool {
    ret enabled && string.str_equals(s, NAME);
}

# read the family's rule string, which reads only once a test has enabled it
pub fun parse(s: str) res[Rule, str] {
    if (!claims(s)) { ret res[Rule, str].err{"not the probe rule"}; }
    ret res[Rule, str].ok{Rule{unused: 0}};
}

# the longest rule string format writes, less its NUL
pub val FORMAT_MAX: usize = 5;

# write the family's rule string
pub fun format(r: *Rule, buf: *u8) str {
    val o: usize = text.buf_str(buf, 0, NAME);
    buf[o] = 0;
    ret buf;
}

# write the rule's short form, its rule string
pub fun display(r: *Rule, buf: *u8) str {
    ret format(r, buf);
}

# whether two rules step alike, as every rule of the family does
pub fun same_rule(a: *Rule, b: *Rule) bool {
    ret true;
}

# its states: dead and live
pub fun states(r: *Rule) u32 {
    ret 2;
}

# the value a fresh cell of a state holds in the state layer
pub fun word_of(r: *Rule, state: u32) u32 {
    ret state;
}

# the value a fresh cell of a state holds in rule layer k: a live cell's
# memory starts at AGE_FRESH and MIX_FRESH, a dead one's at 0
pub fun rest_of(r: *Rule, state: u32, k: usize) u32 {
    if (state == 0) { ret 0; }
    if (k == 1)     { ret AGE_FRESH; }
    ret MIX_FRESH;
}

# the state a state layer's value holds
pub fun state_of(c: u32) u32 {
    if (c != 0) { ret 1; }
    ret 0;
}

# the state painted or seeded when none is chosen
pub fun ink(r: *Rule) u32 {
    ret 1;
}

# the engines step it bit for bit, though only the CPU runs it
pub fun slack(r: *Rule) u32 {
    ret 0;
}

# the layers its cells are stored in: a 16-bit state, then its age and mix
pub fun layers(r: *Rule) plane.Set {
    var s: plane.Set = plane.state("state", WIDTH);
    plane.add_rule(?s, "age", WIDTH);
    plane.add_rule(?s, "mix", WIDTH);
    ret s;
}

# how shared code reads a value of its state layer: 1 is live, and keeps a chunk
pub fun sense() layout.Sense {
    ret layout.Sense{
        live_mask:  TOP,
        live_lo:    1,
        live_hi:    1,
        warm_mask:  TOP,
        heat_shift: 0,
        heat_mask:  0,
        age_shift:  0,
        age_mask:   0,
    };
}

# how far a generation reaches
pub fun radius(r: *Rule) usize {
    ret 1;
}

# what it can do
pub fun caps(r: *Rule) Caps {
    ret Caps{b0: false, isotropic: true, no_tree: "a rule with memory", bounded: true, life_like: false, continuous: false};
}

# Life's next state for a cell's state and its live neighbours
fun life(st: u32, count: u32) u32 {
    if (count == 3 || (count == 2 && st != 0)) { ret 1; }
    ret 0;
}

# the state a cell becomes from the states of its 3 by 3 block
pub fun next_of(r: *Rule, nb: *u32) u32 {
    var count: u32   = 0;
    var q:     usize = 0;
    for (q < 9) {
        if (q != 4) { count = count + nb[q]; }
        q = q + 1;
    }
    ret life(nb[4], count);
}

# one chunk's CPU step: Life on the state, and the memory moved on beside it
pub fun step_chunk(r: *Rule, b: *space.Block, t: *space.Tally) {
    val own: *u32 = space.block_own(b, 0).w;
    val age: *u32 = space.block_own(b, 1).w;
    val mix: *u32 = space.block_own(b, 2).w;
    val out: *u32 = space.block_out(b, 0).w;
    val oa:  *u32 = space.block_out(b, 1).w;
    val om:  *u32 = space.block_out(b, 2).w;
    var y:   i64  = 0;
    for (y < 64) {
        var x: i64 = 0;
        for (x < 64) {
            val i:     usize = (y * 64 + x)::usize;
            var count: u32   = 0;
            var dy:    i64   = -1;
            for (b.busy && dy <= 1) {
                var dx: i64 = -1;
                for (dx <= 1) {
                    if (dx != 0 || dy != 0) { count = count + state_of(space.block_cell(b, WIDTH, x + dx, y + dy)); }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            val st: u32 = life(state_of(plane.load(own, WIDTH, i)), count);
            var a:  u32 = 0;
            var m:  u32 = 0;
            if (st != 0) {
                a = plane.load(age, WIDTH, i) + 1;
                if (a > TOP) { a = TOP; }
                m = (plane.load(mix, WIDTH, i) * 5 + 7) & TOP;
            }
            plane.store(out, WIDTH, i, st);
            plane.store(oa, WIDTH, i, a);
            plane.store(om, WIDTH, i, m);
            space.note(t, st, x::u32, y::u32);
            x = x + 1;
        }
        y = y + 1;
    }
}

# its rule into the meta head, which holds nothing of it
pub fun pack(r: *Rule, w: *u32) {}

# it binds no rule buffer
pub val TABLE: bool = false;

# the words of the rule buffer it needs: none
pub fun table_words(r: *Rule) usize {
    ret 0;
}

# its rule into a rule buffer, which it has none of
pub fun pack_table(r: *Rule, w: *u32) {}

# it draws in the view's solid colour
pub fun colour(r: *Rule, state: u32) opt[u32] {
    ret opt[u32].none{};
}

# it has no step stage
pub fun stage(len: *usize) *u8 {
    @len = 0;
    ret nil;
}

# its one rule string, which reads once a test has enabled the family
pub val SAMPLE_COUNT: usize = 1;

pub fun sample(i: usize) str {
    ret NAME;
}
