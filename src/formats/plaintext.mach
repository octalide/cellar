# LifeWiki plaintext, the '.' and 'O' text pattern the Life community trades as .cells
#
# a line starting '!' is a comment, and "!Name: <name>" names the pattern. every
# other line is a row of cells, '.' a dead one and 'O' a live one. '*' reads as
# live too, as Golly reads it, for files written by tools that use it. a row may
# be shorter than the widest, a blank line between rows is a row of dead cells,
# and blank lines before the first row or after the last are ignored. the format
# has no rule, states or origin, so the pattern sits at (0, 0), its box is the
# widest row by the rows read, and every nonzero state writes as live. the
# writer puts the name and comments first and writes every row at full width,
# so the box it was given reads back unchanged.

use cellar.format;
use allo: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the most bytes the writer makes, since a dense format grows with the box's area
val MAX_TEXT: i64 = 1073741824;

fun is_blank(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\r' || b == '\n';
}

fun is_live(b: u8) bool {
    ret b == 'O' || b == '*';
}

# the end of the line starting at i, past its trailing blanks, and where the next line starts
# ---
# p:    the bytes
# n:    how many
# i:    the line's first byte
# next: receives the offset of the next line
# ret:  the offset just past the line's last byte that is not blank
fun line_at(p: *u8, n: usize, i: usize, next: *usize) usize {
    var e: usize = i;
    for (e < n && p[e] != '\n') { e = e + 1; }
    @next = e + 1;
    if (e >= n) { @next = n; }
    for (e > i && is_blank(p[e - 1])) { e = e - 1; }
    ret e;
}

# whether the bytes [i, e) begin with s
fun starts(p: *u8, i: usize, e: usize, s: str) bool {
    var k: usize = 0;
    for (s[k] != 0) {
        if (i + k >= e || p[i + k] != s[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# read one '!' line into the name or the comments
# ---
# p:    the bytes, the line [i, e) past its '!'
# com:  the comments so far, appended to
# info: receives the name
fun read_comment(a: *allo.Allocator, p: *u8, i: usize, e: usize, com: *Vector[u8], info: *format.Info) err[format.Error] {
    var s: usize = i;
    if (starts(p, s, e, "Name:")) {
        s = s + 5;
        for (s < e && (p[s] == ' ' || p[s] == '\t')) { s = s + 1; }
        val r: err[allo.Error] = format.set_text(a, ?info.name, ?p[s], e - s);
        if (sel r.err) { ret err[format.Error].err{format.Error.alloc{r.err}}; }
        ret err[format.Error].ok{};
    }
    for (s < e && (p[s] == ' ' || p[s] == '\t')) { s = s + 1; }
    if (com.len != 0) {
        val nl: res[usize, allo.Error] = vector.push[u8](com, '\n');
        if (sel nl.err) { ret err[format.Error].err{format.Error.alloc{nl.err}}; }
    }
    for (s < e) {
        val r: res[usize, allo.Error] = vector.push[u8](com, p[s]);
        if (sel r.err) { ret err[format.Error].err{format.Error.alloc{r.err}}; }
        s = s + 1;
    }
    ret err[format.Error].ok{};
}

# emit the live runs of the row [i, e) as row y
fun read_row(p: *u8, i: usize, e: usize, y: i64, em: *format.Emit) err[format.Error] {
    if ((e - i)::i64 > format.LIMIT) { ret err[format.Error].err{format.Error.range{}}; }
    var x: usize = i;
    for (x < e) {
        em.info.at = x;
        if (p[x] == '.') {
            x = x + 1;
            cnt;
        }
        if (!is_live(p[x])) { ret err[format.Error].err{format.Error.malformed{}}; }
        var k: usize = x;
        for (k < e && is_live(p[k])) { k = k + 1; }
        if (!format.emit(em, (x - i)::i64, y, k - x, 1)) { ret err[format.Error].err{format.Error.sink{}}; }
        x = k;
    }
    ret err[format.Error].ok{};
}

fun read_all(a: *allo.Allocator, p: *u8, n: usize, em: *format.Emit, com: *Vector[u8]) err[format.Error] {
    var i:       usize = 0;
    var y:       i64   = 0;
    var blanks:  i64   = 0;
    var width:   i64   = 0;
    var started: bool  = false;
    for (i < n) {
        var next: usize = 0;
        val e:    usize = line_at(p, n, i, ?next);
        em.info.at = i;
        if (p[i] == '!') {
            val c: err[format.Error] = read_comment(a, p, i + 1, e, com, em.info);
            if (sel c.err) { ret c; }
        }
        or (e == i) {
            if (started) { blanks = blanks + 1; }
        }
        or {
            if (started) { y = y + blanks + 1; }
            started = true;
            blanks  = 0;
            if (y > format.LIMIT) { ret err[format.Error].err{format.Error.range{}}; }
            val r: err[format.Error] = read_row(p, i, e, y, em);
            if (sel r.err)            { ret r; }
            if ((e - i)::i64 > width) { width = (e - i)::i64; }
        }
        i = next;
    }
    if (started && width > 0) { format.cover(em.info, 0, 0, width, y + 1); }
    val m: err[allo.Error] = format.set_text(a, ?em.info.comments, com.data, com.len);
    if (sel m.err) { ret err[format.Error].err{format.Error.alloc{m.err}}; }
    ret err[format.Error].ok{};
}

# decode a plaintext file
fun decode(a: *allo.Allocator, p: *u8, n: usize, e: *format.Emit) err[format.Error] {
    var com: Vector[u8]        = vector.init[u8](a);
    val r:   err[format.Error] = read_all(a, p, n, e, ?com);
    vector.dnit[u8](?com);
    ret r;
}

# how likely the bytes are plaintext: a "!Name:" line opens LifeWiki's files, any
# '!' line opens few others, and a first line of only cells is a bare pattern. a
# '#', a digit or an 'x' first opens the Life, custom and RLE formats instead
fun sniff(p: *u8, n: usize) u32 {
    var i: usize = 0;
    for (i < n && is_blank(p[i])) { i = i + 1; }
    if (i >= n) { ret 0; }
    var next: usize = 0;
    val e:    usize = line_at(p, n, i, ?next);
    if (p[i] == '!') {
        if (starts(p, i + 1, e, "Name:")) { ret 100; }
        ret 90;
    }
    var k: usize = i;
    for (k < e) {
        if (p[k] != '.' && !is_live(p[k])) { ret 0; }
        k = k + 1;
    }
    ret 60;
}

fun put(out: *Vector[u8], b: u8) err[format.Error] {
    val r: res[usize, allo.Error] = vector.push[u8](out, b);
    if (sel r.err) { ret err[format.Error].err{format.Error.alloc{r.err}}; }
    ret err[format.Error].ok{};
}

fun put_n(out: *Vector[u8], b: u8, n: i64) err[format.Error] {
    var i: i64 = 0;
    for (i < n) {
        val r: err[format.Error] = put(out, b);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[format.Error].ok{};
}

# write "!" and a prefix, then s up to its first newline or end, then a newline
# ---
# ret: the offset in s just past what was written and its newline
fun put_line(out: *Vector[u8], prefix: str, s: str, from: usize) res[usize, format.Error] {
    val a: err[format.Error] = put(out, '!');
    if (sel a.err) { ret res[usize, format.Error].err{a.err}; }
    var k: usize = 0;
    for (prefix[k] != 0) {
        val b: err[format.Error] = put(out, prefix[k]);
        if (sel b.err) { ret res[usize, format.Error].err{b.err}; }
        k = k + 1;
    }
    var i: usize = from;
    for (s[i] != 0 && s[i] != '\n') {
        val c: err[format.Error] = put(out, s[i]);
        if (sel c.err) { ret res[usize, format.Error].err{c.err}; }
        i = i + 1;
    }
    if (s[i] == '\n') { i = i + 1; }
    val d: err[format.Error] = put(out, '\n');
    if (sel d.err) { ret res[usize, format.Error].err{d.err}; }
    ret res[usize, format.Error].ok{i};
}

# write the source's rows, every nonzero state as 'O'
fun write_rows(out: *Vector[u8], src: *format.Source) err[format.Error] {
    var r:  format.Run;
    val rw: err[format.Error] = src.rewind(src.ctx);
    if (sel rw.err) { ret rw; }
    var have: bool = src.next(src.ctx, ?r);
    var y:    i64  = src.y0;
    for (y < src.y1) {
        var x: i64 = src.x0;
        for (have && r.y == y) {
            if (r.n == 0 || r.v == 0 || r.x < x || r.x + r.n::i64 > src.x1) { ret err[format.Error].err{format.Error.range{}}; }
            val d: err[format.Error] = put_n(out, '.', r.x - x);
            if (sel d.err) { ret d; }
            val l: err[format.Error] = put_n(out, 'O', r.n::i64);
            if (sel l.err) { ret l; }
            x    = r.x + r.n::i64;
            have = src.next(src.ctx, ?r);
        }
        if (have && r.y < y) { ret err[format.Error].err{format.Error.range{}}; }
        val t: err[format.Error] = put_n(out, '.', src.x1 - x);
        if (sel t.err) { ret t; }
        val nl: err[format.Error] = put(out, '\n');
        if (sel nl.err) { ret nl; }
        y = y + 1;
    }
    if (have) { ret err[format.Error].err{format.Error.range{}}; }
    ret err[format.Error].ok{};
}

# encode a source as a plaintext file
fun encode(a: *allo.Allocator, src: *format.Source, info: *format.Info, out: *Vector[u8]) err[format.Error] {
    val w: i64 = src.x1 - src.x0;
    val h: i64 = src.y1 - src.y0;
    if (w < 0 || h < 0 || w > format.LIMIT || h > format.LIMIT) { ret err[format.Error].err{format.Error.range{}}; }
    if (h != 0 && w + 1 > MAX_TEXT / h)                         { ret err[format.Error].err{format.Error.range{}}; }
    val name: str = format.text_of(?info.name);
    if (name[0] != 0) {
        val r: res[usize, format.Error] = put_line(out, "Name: ", name, 0);
        if (sel r.err) { ret err[format.Error].err{r.err}; }
    }
    val com: str   = format.text_of(?info.comments);
    var i:   usize = 0;
    for (com[i] != 0) {
        val r: res[usize, format.Error] = put_line(out, "", com, i);
        if (sel r.err) { ret err[format.Error].err{r.err}; }
        i = r.ok;
    }
    if (w == 0 || h == 0) { ret err[format.Error].ok{}; }
    ret write_rows(out, src);
}

# the plaintext format's registry record
pub fun make() format.Format {
    var f: format.Format;
    f.id     = "plaintext";
    f.exts   = "cells";
    f.sniff  = sniff;
    f.decode = decode;
    f.builds = false;
    f.encode = encode;
    ret f;
}
