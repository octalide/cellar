# applies the queued commands to the world and its files
#
# the one place a command's effect happens. a frame holding the world calls run
# once, between the simulation thread's steps and before it collects or records
# anything, so the world a save reads is a completed generation.
#
# it also keeps the start reset returns to. play starting from paused, by a
# toggle or a step, takes a snapshot when none is held. an edit while paused
# drops it, so the edited world is the start from then on and the next play
# takes it. an edit while running is part of the run and leaves it alone, but
# clear, randomize, and a load or open of a world begin a new world, so they
# drop it paused and retake it from the new world running.
#
# and it keeps the journal undo and redo walk (cellar.journal, which says what
# is recorded and how running and redo behave): each recorded command runs
# inside a step, and undo and redo leave the world paused as the start.
#
# play, a step or a jump from a run paused at a ceiling carries it past that
# ceiling (sim.pass), and once the commands are applied a pause at one is
# flashed once (app.note_ceiling).

use cellar.app;
use cellar.ceiling;
use cellar.command;
use cellar.format;
use cellar.formats;
use cellar.identify.worker;
use cellar.journal;
use cellar.pattern;
use cellar.persist;
use cellar.region;
use cellar.rule;
use cellar.rules.table.load;
use cellar.rules.weighted;
use cellar.saves;
use cellar.sim;
use cellar.snapshot;
use cellar.space;
use cellar.text;
use cellar.topology;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use fs: std.filesystem;
use std.sync.atomic;
use stext: std.text.string;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# what a command needs beyond the world
# ---
# a: allocator for file buffers
pub rec Deps {
    a: *allo.Allocator;
}

# the view a world file keeps, as the app holds it
fun view_of(a: *app.App) persist.View {
    ret persist.View{pan_x: a.pan_x, pan_y: a.pan_y, zoom: a.zoom, mode: a.mode::u8};
}

# show a world file's view, its zoom brought within the app's limits. the view
# is the file's own, so a framing still waiting is dropped rather than left to
# replace it on the next frame
fun take_view(a: *app.App, v: *persist.View) {
    a.refit = false;
    a.pan_x = v.pan_x;
    a.pan_y = v.pan_y;
    a.zoom  = app.clamp_zoom(a, v.zoom);
    a.mode  = v.mode::usize;
}

# the last part of a path, what a message calls the file
fun base(path: str) str {
    var b: str   = path;
    var i: usize = 0;
    for (path[i] != 0) {
        if (path[i] == '/' || path[i] == '\\') { b = ?path[i + 1]; }
        i = i + 1;
    }
    ret b;
}

# flash how a save went, and have the files list read again once one is written
fun saved(a: *app.App, path: str, e: err[persist.Error]) {
    if (sel e.err) {
        app.say_why(a, base(path), persist.error_message(e.err));
        ret;
    }
    a.saves.stale = true;
    app.say_why(a, base(path), "saved");
}

# save the world with the view
fun save_world(a: *app.App, s: *sim.Sim, d: *Deps, path: str) {
    var v: persist.View = view_of(a);
    saved(a, path, persist.save_world(d.a, s, ?v, path));
}

# how a command changed the world, which decides what becomes of the start
# ---
# none:  left it alone
# edit:  changed it in place
# fresh: replaced it with a new world
tag Change: u8 {
    none;
    edit;
    fresh;
}

# load the world and the view it was saved with, saying when its rule could not be taken
fun load_world(a: *app.App, s: *sim.Sim, d: *Deps, path: str) Change {
    var v:    persist.View                       = view_of(a);
    val done: res[persist.Loaded, persist.Error] = persist.load_world(d.a, s, ?v, path);
    if (sel done.err) {
        app.say_why(a, base(path), persist.error_message(done.err));
        ret Change.none{};
    }
    take_view(a, ?v);
    if (done.ok.foreign) {
        app.say_why(a, base(path), "loaded, but its rule is not one cellar can run; the current rule is kept");
        ret Change.fresh{};
    }
    app.say_why(a, base(path), "loaded");
    ret Change.fresh{};
}

# snapshot the world as the start, saying when it could not be kept
fun take_start(a: *app.App, s: *sim.Sim) {
    if (!sim.take(s, ?a.start)) { app.say(a, "the starting world could not be kept, so reset has nothing to return to"); }
}

# return to the start, or stay put when the world as it stands is the start. a
# start the pool can no longer hold marks the world full, which the frame reports
fun reset(a: *app.App, s: *sim.Sim) {
    if (a.start.held) { sim.restore(s, ?a.start); }
}

# put a new custom pattern in place, the journal keeping the one it replaces
fun replace_custom(a: *app.App, p: pattern.Pattern) {
    journal.keep_custom(?a.log, a.custom);
    a.custom = p;
}

# load a file into the custom pattern and select it
fun load_pattern(a: *app.App, d: *Deps, path: str) {
    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, a.alloc, 0, 0, pattern.name(?a.custom));
    if (sel made.err) {
        app.say(a, "out of memory");
        ret;
    }
    val done: err[persist.Error] = persist.load_pattern(d.a, ?p, path);
    if (sel done.err) {
        pattern.dnit(?p);
        app.say_why(a, base(path), persist.error_message(done.err));
        ret;
    }
    replace_custom(a, p);
    a.pattern_sel = app.CUSTOM;
    app.say_why(a, base(path), "loaded as the custom pattern");
}

# open a world with the view it was saved with, or stamp a pattern and frame it
fun open(a: *app.App, s: *sim.Sim, d: *Deps, path: str) Change {
    var v:    persist.View                       = view_of(a);
    val done: res[persist.Opened, persist.Error] = persist.open_file(d.a, s, ?v, path);
    if (sel done.err) {
        # a .rule file's fault is told with the line it was found on
        if (sel done.err.rule) {
            val f: load.Fault = done.err.rule;
            if (f.line > 0) {
                var why: [200]u8;
                var o:   usize = text.buf_str(?why[0], 0, "line ");
                o      = text.buf_u64(?why[0], o, f.line::u64);
                o      = text.buf_str(?why[0], o, ": ");
                o      = text.buf_str(?why[0], o, f.why);
                why[o] = 0;
                app.say_why(a, base(path), ?why[0]);
                ret Change.none{};
            }
        }
        app.say_why(a, base(path), persist.error_message(done.err));
        ret Change.none{};
    }
    var got: Change = Change.edit{};
    if (done.ok.world) {
        take_view(a, ?v);
        got = Change.fresh{};
    }
    if (sel done.ok.box.some) { app.frame_box(a, done.ok.box.some); }
    if (done.ok.foreign) {
        app.say_why(a, base(path), "opened, but its rule is not one cellar can run; the current rule is kept");
        ret got;
    }
    if (done.ok.stray) {
        app.say_why(a, base(path), "opened, but it could not be copied into the data directory, so its rule is known only until cellar closes");
        ret got;
    }
    app.say_why(a, base(path), "opened");
    ret got;
}

# put a pattern on the clipboard as RLE, with its rule, for the frame to hand
# the window
fun clip(a: *app.App, d: *Deps, p: *pattern.Pattern) bool {
    var f: format.Format;
    if (!formats.by_id("rle", ?f)) { ret false; }
    vector.clear[u8](?a.clip);
    val enc: err[persist.Error] = persist.encode_pattern(d.a, ?f, p, ?a.clip);
    if (sel enc.err) { ret false; }
    val end: res[usize, allo.Error] = vector.push[u8](?a.clip, 0);
    if (sel end.err) { ret false; }
    a.clip_ready = true;
    ret true;
}

# read the selection into a new custom pattern, cutting it with cut, and make
# that the stamp, laid down as it was read, and put it on the clipboard
fun take(a: *app.App, s: *sim.Sim, d: *Deps, b: space.Box, cut: bool) {
    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, a.alloc, 0, 0, "selection");
    if (sel made.err) {
        app.say(a, "out of memory");
        ret;
    }
    # the rule the cells were read under, set first so a refusal leaves the world alone
    var text:  [rule.FORMAT_MAX + 1]u8;
    val named: err[allo.Error] = pattern.set_rule(?p, rule.format(?s.rule, ?text[0]));
    var ok:    bool            = sel named.ok;
    if (ok && cut) { ok = region.cut(s, b, ?p); }
    or (ok)        { ok = region.copy(s, b, ?p); }
    if (!ok) {
        pattern.dnit(?p);
        app.say(a, "the selection could not be copied");
        ret;
    }
    replace_custom(a, p);
    a.pattern_sel = app.CUSTOM;
    a.orient      = 0;
    a.tool        = app.TOOL_STAMP;
    var said: str = "selection copied to the stamp";
    if (cut) { said = "selection cut to the stamp"; }
    app.say(a, said);
    if (clip(a, d, ?a.custom)) { app.say_also(a, "and to the clipboard as RLE"); }
    or                         { app.say_also(a, "the clipboard could not take it"); }
}

# read clipboard text as a pattern and make it the stamp, taking its rule when
# asked. the stamp only changes when the whole text is a pattern that fits
fun paste(a: *app.App, s: *sim.Sim, d: *Deps, c: *command.Paste) Change {
    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, a.alloc, 0, 0, "clipboard");
    if (sel made.err) {
        app.say(a, "out of memory");
        ret Change.none{};
    }
    val got: err[persist.Error] = persist.pattern_from(d.a, ?p, c.text.data, c.text.len);
    if (sel got.err) {
        pattern.dnit(?p);
        if (sel got.err.format) {
            if (sel got.err.format.malformed) {
                app.say(a, "the clipboard holds no pattern cellar can read");
                ret Change.none{};
            }
        }
        app.say_why(a, "paste", persist.error_message(got.err));
        ret Change.none{};
    }
    replace_custom(a, p);
    a.pattern_sel = app.CUSTOM;
    a.orient      = 0;
    a.tool        = app.TOOL_STAMP;
    app.say(a, "pasted to the stamp");
    val named: str = pattern.rule(?a.custom);
    if (named[0] == 0) { ret Change.none{}; }
    val k: res[rule.Rule, str] = rule.parse(named);
    if (sel k.err) {
        app.say_also(a, "its rule is not one cellar can run, so the current rule is kept");
        ret Change.none{};
    }
    if (rule.same(?s.rule, ?k.ok)) { ret Change.none{}; }
    if (!c.rule) {
        app.say_also(a, "its rule was not taken; Ctrl+Shift+V takes it");
        ret Change.none{};
    }
    val why: str = sim.refusal(s, ?k.ok);
    if (why != nil) {
        app.say_also(a, why);
        ret Change.none{};
    }
    sim.set_rule(s, k.ok);
    app.say_also(a, "its rule was taken");
    ret Change.edit{};
}

# shrink the selection to the box its live cells span, dropping it when none is alive
fun shrink(a: *app.App, s: *sim.Sim, b: space.Box) {
    var got: opt[space.Box] = opt[space.Box].none{};
    if (!region.bounds(s, b, ?got)) {
        app.say(a, "the selection could not be read");
        ret;
    }
    if (sel got.none) {
        app.deselect(a);
        app.say(a, "nothing is alive in the selection");
        ret;
    }
    a.selected = true;
    a.area     = got.some;
}

# start classifying the selection's pattern under the world's rule, off the frame
fun identify_area(a: *app.App, s: *sim.Sim, b: space.Box) {
    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, a.alloc, 0, 0, "selection");
    if (sel made.err) {
        app.say(a, "out of memory");
        ret;
    }
    fin { pattern.dnit(?p); }
    if (!region.copy(s, b, ?p)) {
        app.say(a, "the selection could not be read");
        ret;
    }
    app.identify_start(a, s.rule, ?p);
}

# apply an operation on a rectangle
fun area(c: *command.Area, a: *app.App, s: *sim.Sim, d: *Deps) {
    val b:  space.Box = c.box;
    var ok: bool      = true;
    if (c.op == command.AREA_COPY)          { take(a, s, d, b, false); }
    if (c.op == command.AREA_CUT)           { take(a, s, d, b, true); }
    if (c.op == command.AREA_CLEAR)         { ok = region.clear(s, b); }
    if (c.op == command.AREA_CLEAR_OUTSIDE) { ok = region.clear_outside(s, b); }
    if (c.op == command.AREA_FILL)          { ok = region.fill(s, b, sim.DEFAULT_DENSITY); }
    if (c.op == command.AREA_INVERT)        { ok = region.invert(s, b); }
    if (c.op == command.AREA_SHRINK)        { shrink(a, s, b); }
    if (c.op == command.AREA_IDENTIFY)      { identify_area(a, s, b); }
    if (!ok)                                { app.say(a, "the selection could not be changed"); }
}

# no journal step
val UNRECORDED: u8 = 255;

# the kind of journal step a command runs in, or UNRECORDED
fun recorded(c: *command.Command) u8 {
    if (sel c.toggle || sel c.step || sel c.jump) { ret journal.KIND_RUN; }
    if (sel c.paint || sel c.line)                { ret journal.KIND_STROKE; }
    if (sel c.area) {
        # shrink and identify only read the world
        if (c.area.op == command.AREA_SHRINK || c.area.op == command.AREA_IDENTIFY) { ret UNRECORDED; }
        ret journal.KIND_EDIT;
    }
    if (sel c.clear || sel c.randomize || sel c.stamp || sel c.rule || sel c.bounds || sel c.reset) { ret journal.KIND_EDIT; }
    if (sel c.load_world || sel c.load_pattern || sel c.open || sel c.paste || sel c.drop)          { ret journal.KIND_EDIT; }
    ret UNRECORDED;
}

# move the view and the selection with the world, so neither moves on screen
fun follow(a: *app.App, dx: i64, dy: i64) {
    a.pan_x   = a.pan_x + dx::f64;
    a.pan_y   = a.pan_y + dy::f64;
    a.area.x0 = a.area.x0 + dx;
    a.area.x1 = a.area.x1 + dx;
    a.area.y0 = a.area.y0 + dy;
    a.area.y1 = a.area.y1 + dy;
}

# put the world on a grid, translated so the box drawn for it is where the
# grid's notation puts it, the view moving with it, saying what was dropped and
# which the caller tells when the world left HashLife for it
fun bounds(a: *app.App, s: *sim.Sim, c: *command.Bounds) Change {
    var want: rule.Rule = s.rule;
    want.grid = c.grid;
    val why: opt[str] = rule.refusal(?want);
    if (sel why.some) {
        app.say_why(a, "the bounds were not set", why.some);
        ret Change.none{};
    }
    val here: str = sim.refusal(s, ?want);
    if (here != nil) {
        app.say_why(a, "the bounds were not set", here);
        ret Change.none{};
    }
    var g:  topology.Grid = c.grid;
    var dx: i64           = 0;
    var dy: i64           = 0;
    if (topology.bounded(?g) && g.w != 0)                { dx = topology.left(?g) - c.x0; }
    if (topology.bounded(?g) && g.h != 0)                { dy = topology.top(?g) - c.y0; }
    if (rule.same(?s.rule, ?want) && dx == 0 && dy == 0) { ret Change.none{}; }
    val tree: bool       = sim.on_tree(s);
    val p:    sim.Placed = sim.place(s, g, dx, dy);
    if (!p.ok && tree && sim.on_tree(s)) {
        app.say(a, "HashLife cannot run a bounded grid, and the world is too large for the chunk pool");
        ret Change.none{};
    }
    # a full pool took the world part way, which the frame reports
    if (!p.ok && !s.full) {
        app.say(a, "the bounds were not set: the GPU's cells could not be read");
        ret Change.none{};
    }
    journal.moved(?a.log, dx, dy);
    follow(a, dx, dy);
    if (topology.bounded(?g)) {
        # the suffix without its colon, as Golly writes it after the rule
        var suffix: [topology.FORMAT_MAX + 1]u8;
        topology.format(?g, ?suffix[0], 0);
        app.say_why(a, "bounds set", ?suffix[1]);
    }
    or { app.say(a, "bounds removed"); }
    if (p.dropped > 0) {
        var why: [96]u8;
        var o:   usize = text.buf_grouped(?why[0], 0, p.dropped);
        if (p.dropped == 1) { o = text.buf_str(?why[0], o, " cell outside them was dropped"); }
        or                  { o = text.buf_str(?why[0], o, " cells outside them were dropped"); }
        why[o] = 0;
        app.say_also(a, ?why[0]);
    }
    ret Change.fresh{};
}

# undo or redo, leaving the world paused as it now stands, which becomes the start
fun back(a: *app.App, s: *sim.Sim, undo: bool) {
    var went: journal.Went = journal.Went.none{};
    if (undo) { went = journal.undo(?a.log, ?a.custom); }
    or        { went = journal.redo(?a.log, ?a.custom); }
    if (sel went.none) {
        if (undo) { app.say(a, "nothing to undo"); }
        or        { app.say(a, "nothing to redo"); }
        ret;
    }
    if (sel went.done)           { follow(a, a.log.shift_x, a.log.shift_y); }
    if (sel went.lost)           { app.say(a, "the world could not be put back, so the history was cleared"); }
    or (journal.dropped(?a.log)) { app.say(a, "the history outgrew its limit and was cleared"); }
    snapshot.drop(?a.start);
}

# replace the rule, saying why when it could not be taken
fun rule_to(a: *app.App, s: *sim.Sim, r: rule.Rule) {
    var want: rule.Rule = r;
    val why:  opt[str]  = rule.refusal(?want);
    if (sel why.some) {
        app.say_why(a, "the rule was not applied", why.some);
        ret;
    }
    val here: str = sim.refusal(s, ?want);
    if (here != nil) {
        app.say_why(a, "the rule was not applied", here);
        ret;
    }
    val tree: bool = sim.on_tree(s);
    if (sim.set_rule(s, r)) { ret; }
    if (tree)               { app.say(a, "HashLife cannot run that rule, and the world is too large for the chunk pool"); }
    or                      { app.say(a, "the rule was not taken: the GPU's cells could not be read"); }
}

# move the world into the quadtree or back into the pool, saying when it cannot
fun engine(a: *app.App, s: *sim.Sim, tree: bool) {
    if (sim.use_hashlife(s, tree)) { ret; }
    if (tree)                      { app.say(a, "HashLife could not take the world"); }
    or                             { app.say(a, "the world is too large for the chunk pool"); }
}

# advance the quadtree to a generation, saying why when it cannot
fun jump(a: *app.App, s: *sim.Sim, gen: u64) {
    if (!sim.on_tree(s))                                                 { app.say(a, "only HashLife goes to a generation"); }
    or (gen < s.generation)                                              { app.say(a, "HashLife only runs forward; reset to go back"); }
    or (!sim.jump(s, gen) && !s.full && sim.tripped(s) == ceiling.COUNT) { app.say(a, "that generation is too far ahead"); }
}

# apply one command
fun apply(c: *command.Command, a: *app.App, s: *sim.Sim, d: *Deps) {
    if (sel c.undo || sel c.redo) {
        back(a, s, sel c.undo);
        ret;
    }
    val paused: bool = s.running == 0;
    # while running, everything recorded joins the run
    val kind: u8 = recorded(c);
    if (kind != UNRECORDED && !paused)                                                    { journal.begin(?a.log, journal.KIND_RUN, true); }
    or (kind != UNRECORDED)                                                               { journal.begin(?a.log, kind, kind == journal.KIND_RUN || sel c.line); }
    if ((sel c.toggle || sel c.step || sel c.jump) && paused && !s.full && !a.start.held) { take_start(a, s); }
    var change: Change = Change.none{};
    if (sel c.paint || sel c.line || sel c.stamp || sel c.rule) { change = Change.edit{}; }
    if (sel c.clear || sel c.randomize)                         { change = Change.fresh{}; }
    # copy, shrink and identify only read the world
    if (sel c.area) {
        val op: u8 = c.area.op;
        if (op != command.AREA_COPY && op != command.AREA_SHRINK && op != command.AREA_IDENTIFY) { change = Change.edit{}; }
    }

    # playing on from a ceiling carries the run past it
    if (sel c.toggle || sel c.step || sel c.jump) { sim.pass(s); }
    if (sel c.toggle)                             { world.toggle(s); }
    if (sel c.step)                               { world.step(s); }
    if (sel c.clear)                              { world.clear(s); }
    if (sel c.randomize)                          { world.randomize(s, c.randomize); }
    if (sel c.paint)                              { world.paint(s, c.paint.x, c.paint.y, c.paint.v); }
    if (sel c.line)                               { world.line(s, c.line.x0, c.line.y0, c.line.x1, c.line.y1, c.line.v); }
    if (sel c.stamp)                              { world.stamp(s, ?c.stamp.p, c.stamp.x, c.stamp.y); }
    if (sel c.rule)                               { rule_to(a, s, c.rule); }
    if (sel c.engine)                             { engine(a, s, c.engine); }
    if (sel c.exponent)                           { sim.set_exponent(s, c.exponent); }
    if (sel c.jump)                               { jump(a, s, c.jump); }
    if (sel c.ceilings)                           { sim.set_ceilings(s, c.ceilings); }
    if (sel c.area)                               { area(?c.area, a, s, d); }
    if (sel c.bounds)                             { change = bounds(a, s, ?c.bounds); }
    if (sel c.reset)                              { reset(a, s); }
    if (sel c.save_world)                         { save_world(a, s, d, command.path(?c.save_world)); }
    if (sel c.load_world)                         { change = load_world(a, s, d, command.path(?c.load_world)); }
    if (sel c.save_pattern) {
        val path: str = command.path(?c.save_pattern);
        saved(a, path, persist.save_pattern(d.a, ?a.custom, path));
    }
    if (sel c.load_pattern) { load_pattern(a, d, command.path(?c.load_pattern)); }
    if (sel c.open)         { change = open(a, s, d, command.path(?c.open)); }
    if (sel c.paste)        { change = paste(a, s, d, ?c.paste); }
    if (sel c.drop) {
        change = open(a, s, d, command.path(?c.drop.file));
        if (c.drop.ignored > 0) { app.say_also(a, "the other dropped files were ignored"); }
    }

    if (sel change.fresh && !paused)                     { take_start(a, s); }
    or (sel change.fresh || (sel change.edit && paused)) { snapshot.drop(?a.start); }

    if (kind != UNRECORDED)      { journal.end(?a.log); }
    if (journal.dropped(?a.log)) { app.say(a, "that change is too large to undo, so the history was cleared"); }
}

# say why the world left HashLife when a command moved it to the chunk engine,
# which every route to a rule it cannot run passes through. choosing the engine
# is not a rule change and says nothing of its own
fun left(a: *app.App, s: *sim.Sim, c: *command.Command, was: bool, told: u32) {
    if (!was || sim.on_tree(s) || sel c.engine) { ret; }
    var m: [160]u8;
    var o: usize = text.buf_str(?m[0], 0, "HashLife cannot run ");
    o    = text.buf_str(?m[0], o, rule.caps(?s.rule).no_tree);
    o    = text.buf_str(?m[0], o, ", so the world moved to the chunk engine");
    m[o] = 0;
    if (a.told != told) { app.say_also(a, ?m[0]); }
    or                  { app.say(a, ?m[0]); }
}

# apply every waiting command in order and empty the queue
# ---
# a: application state, which owns the queue
# s: the simulation, held by the caller between steps and not yet recorded into
# d: what the commands need
pub fun run(a: *app.App, s: *sim.Sim, d: *Deps) {
    journal.bind(?a.log, s);
    val family: usize = rule.family_of(?s.rule);
    var i:      usize = 0;
    for (i < a.queue.items.len) {
        val was:  bool = sim.on_tree(s);
        val told: u32  = a.told;
        apply(?a.queue.items.data[i], a, s, d);
        left(a, s, ?a.queue.items.data[i], was, told);
        i = i + 1;
    }
    command.clear(?a.queue);
    # any of them may have changed the rule: to another family, whose own ink
    # the pen takes up, or to one of fewer states
    if (rule.family_of(?s.rule) != family) { a.ink = rule.ink(?s.rule)::u8; }
    app.fit_ink(a, rule.states(?s.rule));
    # a step since the last frame may have paused the run at a ceiling
    var c:       ceiling.Ceilings = sim.ceilings(s);
    val k:       usize            = sim.tripped(s);
    val smaller: bool             = (k == ceiling.MEMORY || k == ceiling.STEP) && sim.on_tree(s) && sim.exponent(s) > 0;
    app.note_ceiling(a, k, ?c, smaller);
}

# a file command's copy of a path, which a test's allocator never refuses
#[testing]
fun file(ap: *app.App, path: str) command.File {
    val f: opt[command.File] = app.file(ap, path);
    if (sel f.some) { ret f.some; }
    var none: command.File;
    ret none;
}

test run__applies_in_order_and_a_save_sees_the_edits_before_it {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps = Deps{a: ?a};

    app.submit(?ap, command.Command.paint{command.Paint{x: 1, y: 2, v: 1}});
    app.submit(?ap, command.Command.line{command.Line{x0: 10, y0: 10, x1: 14, y1: 10, v: 1}});
    # the glider's five cells, stamped well clear of the rest
    app.stamp(?ap, app.chosen(?ap), 0, 100, 100);
    ap.pan_x = -40.5;
    ap.zoom  = 99.0;
    app.submit(?ap, command.Command.save_world{file(?ap, "out/test/exec/soup.cellar")});
    app.submit(?ap, command.Command.clear{});
    app.submit(?ap, command.Command.save_world{file(?ap, "out/test/exec/empty.cellar")});
    if (ap.queue.items.len != 6) { ret 2; }
    run(?ap, ?s, ?d);
    if (ap.queue.items.len != 0) { ret 3; }
    if (sim.population(?s) != 0) { ret 4; }

    ap.pan_x = 0.0;
    app.submit(?ap, command.Command.load_world{file(?ap, "out/test/exec/soup.cellar")});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 11)                       { ret 5; }
    if (!sim.alive(?s, 1, 2) || !sim.alive(?s, 14, 10)) { ret 6; }
    # the view comes back with it, its zoom within the app's limits
    if (ap.pan_x != -40.5 || ap.zoom != app.ZOOM_MAX) { ret 7; }
    # each name is its own world
    app.submit(?ap, command.Command.load_world{file(?ap, "out/test/exec/empty.cellar")});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 0) { ret 8; }

    # the custom pattern saves and loads under a name of its own too
    pattern.set(?ap.custom, 3, 4, 1);
    app.submit(?ap, command.Command.save_pattern{file(?ap, "out/test/exec/mine.rle")});
    run(?ap, ?s, ?d);
    pattern.clear(?ap.custom);
    app.submit(?ap, command.Command.load_pattern{file(?ap, "out/test/exec/mine.rle")});
    run(?ap, ?s, ?d);
    var live: usize = 0;
    var y:    usize = 0;
    for (y < ap.custom.h) {
        var x: usize = 0;
        for (x < ap.custom.w) {
            live = live + pattern.get(?ap.custom, x, y)::usize;
            x    = x + 1;
        }
        y = y + 1;
    }
    if (live != 1 || ap.pattern_sel != app.CUSTOM) { ret 9; }

    # the files list finds all three, sorted, and nothing else
    if (!ap.saves.stale) { ret 10; }
    val listed: err[fs.FsError] = saves.refresh(?ap.saves, "out/test/exec");
    if (sel listed.err || ap.saves.items.len != 3) { ret 11; }
    val first: *saves.Entry = ?ap.saves.items.data[0];
    val last:  *saves.Entry = ?ap.saves.items.data[2];
    if (!string.str_equals(first.name, "empty.cellar") || first.kind != saves.KIND_WORLD)                  { ret 12; }
    if (!string.str_equals(last.name, "soup.cellar") || ap.saves.items.data[1].kind != saves.KIND_PATTERN) { ret 13; }

    # a selection copied becomes the stamp, and shrinks to the cells it holds
    app.submit(?ap, command.Command.load_world{file(?ap, "out/test/exec/soup.cellar")});
    app.select(?ap, 15, 11, 0, 0);
    app.area(?ap, command.AREA_COPY);
    app.select(?ap, -5, -5, 49, 49);
    app.area(?ap, command.AREA_SHRINK);
    run(?ap, ?s, ?d);
    if (ap.pattern_sel != app.CUSTOM || ap.tool != app.TOOL_STAMP)                                  { ret 14; }
    if (ap.custom.w != 16 || ap.custom.h != 12 || pattern.get(?ap.custom, 1, 2) != 1)               { ret 15; }
    if (pattern.get(?ap.custom, 14, 10) != 1 || pattern.get(?ap.custom, 0, 0) != 0)                 { ret 16; }
    if (!ap.selected || ap.area.x0 != 1 || ap.area.y0 != 2 || ap.area.x1 != 15 || ap.area.y1 != 11) { ret 17; }

    fs.remove_file("out/test/exec/soup.cellar");
    fs.remove_file("out/test/exec/empty.cellar");
    fs.remove_file("out/test/exec/mine.rle");
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__opening_a_world_keeps_its_saved_camera_over_the_start_framing {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:   Deps            = Deps{a: ?a};
    val dir: err[fs.FsError] = persist.make_parent(?a, "out/test/camera/x");
    if (sel dir.err) { ret 1; }
    world.paint(?s, 3, 4, 1);
    ap.pan_x = -12.5;
    ap.pan_y = 7.25;
    ap.zoom  = 2.5;
    app.submit(?ap, command.Command.save_world{file(?ap, "out/test/camera/view.cellar")});
    run(?ap, ?s, ?d);

    # a fresh app, as a launch has it: waiting to frame the randomize area
    app.dnit(?ap);
    app.init(?ap);
    val again: err[format.Error] = app.attach(?ap, ?a);
    if (sel again.err) { ret 1; }
    if (!ap.refit) { ret 2; }
    app.submit(?ap, command.Command.open{file(?ap, "out/test/camera/view.cellar")});
    run(?ap, ?s, ?d);
    if (ap.pan_x != -12.5 || ap.pan_y != 7.25 || ap.zoom != 2.5) { ret 3; }
    if (ap.refit)                                                { ret 4; }

    fs.remove_file("out/test/camera/view.cellar");
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__opens_a_pattern_with_its_rule_and_leaves_the_world_when_a_file_fails {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:   Deps            = Deps{a: ?a};
    val dir: err[fs.FsError] = persist.make_parent(?a, "out/test/open/x");
    if (sel dir.err) { ret 1; }
    val rle:  str = "x = 3, y = 1, rule = B36/S23\n3o!\n";
    val junk: str = "this is not a pattern\n";
    fs.write_bytes("out/test/open/row.rle", rle, string.str_len(rle), persist.FILE_MODE);
    fs.write_bytes("out/test/open/junk.txt", junk, string.str_len(junk), persist.FILE_MODE);

    # a row of three centred on the origin, under HighLife
    world.paint(?s, 50, 50, 1);
    app.submit(?ap, command.Command.open{file(?ap, "out/test/open/row.rle")});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 4)                                               { ret 2; }
    if (!sim.alive(?s, -1, 0) || !sim.alive(?s, 0, 0) || !sim.alive(?s, 1, 0)) { ret 3; }
    var high: rule.Rule = rule.preset_rule(1);
    var life: rule.Rule = rule.preset_rule(0);
    if (!rule.same(?s.rule, ?high)) { ret 4; }
    # the view is asked to frame the three cells
    val fit: space.Box = app.fit_box(?ap);
    if (!ap.refit || fit.x0 != -1 || fit.x1 != 2 || fit.y0 != 0 || fit.y1 != 1) { ret 9; }

    # a file that is no pattern, and one that is not there, change nothing and say why
    sim.set_rule(?s, life);
    app.submit(?ap, command.Command.open{file(?ap, "out/test/open/junk.txt")});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 4 || !rule.same(?s.rule, ?life)) { ret 5; }
    if (!string.str_starts_with(ap.toast, "junk.txt: "))       { ret 6; }
    app.submit(?ap, command.Command.open{file(?ap, "out/test/open/missing.rle")});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 4)                            { ret 7; }
    if (!string.str_starts_with(ap.toast, "missing.rle: ")) { ret 8; }

    fs.remove_file("out/test/open/row.rle");
    fs.remove_file("out/test/open/junk.txt");
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

# clipboard text as the window hands it over, a copy the test's allocator never refuses
#[testing]
fun clipboard(ap: *app.App, text: str) str {
    val r: res[str, allo.Error] = stext.str_dup(ap.alloc, text);
    if (sel r.ok) { ret r.ok; }
    ret nil;
}

test run__pastes_a_pattern_as_the_stamp_and_a_copy_pastes_back_exactly {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:    Deps      = Deps{a: ?a};
    var life: rule.Rule = rule.preset_rule(0);
    var high: rule.Rule = rule.preset_rule(1);

    # a glider under HighLife, as LifeWiki gives it, pastes as the stamp and keeps the rule
    val glider: str = "#N Glider\nx = 3, y = 3, rule = B36/S23\nbob$2bo$3o!\n";
    app.paste(?ap, clipboard(?ap, glider), false);
    run(?ap, ?s, ?d);
    if (ap.pattern_sel != app.CUSTOM || ap.tool != app.TOOL_STAMP)                  { ret 2; }
    if (ap.custom.w != 3 || ap.custom.h != 3 || pattern.get(?ap.custom, 1, 0) != 1) { ret 3; }
    if (pattern.get(?ap.custom, 0, 0) != 0 || pattern.get(?ap.custom, 2, 1) != 1)   { ret 4; }
    if (!rule.same(?s.rule, ?life) || sim.population(?s) != 0)                      { ret 5; }
    # asked to, it takes the rule too
    app.paste(?ap, clipboard(?ap, glider), true);
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?high)) { ret 6; }

    # text that is no pattern, and an empty clipboard, leave the stamp and say so
    app.paste(?ap, clipboard(?ap, "remember to buy milk\n"), true);
    run(?ap, ?s, ?d);
    if (!string.str_equals(ap.toast, "the clipboard holds no pattern cellar can read")) { ret 7; }
    if (ap.custom.w != 3 || !rule.same(?s.rule, ?high))                                 { ret 8; }
    app.paste(?ap, clipboard(?ap, ""), false);
    if (ap.queue.items.len != 0 || !string.str_equals(ap.toast, "the clipboard holds no text")) { ret 9; }

    # a copied selection, empty margins and all, is RLE on the clipboard that
    # pastes back as the same cells in the same box
    world.paint(?s, 3, 4, 1);
    world.paint(?s, 5, 4, 1);
    world.paint(?s, 4, 6, 1);
    app.select(?ap, 2, 3, 7, 8);
    app.area(?ap, command.AREA_COPY);
    run(?ap, ?s, ?d);
    if (!ap.clip_ready || !string.str_starts_with(ap.clip.data::str, "#N selection")) { ret 10; }
    var copied: pattern.Pattern;
    val kept:   err[allo.Error] = pattern.clone(?copied, ?a, ?ap.custom);
    if (sel kept.err) { ret 1; }
    pattern.clear(?ap.custom);
    app.paste(?ap, clipboard(?ap, ap.clip.data::str), false);
    run(?ap, ?s, ?d);
    if (ap.custom.w != 6 || ap.custom.h != 6)                                               { ret 11; }
    if (ap.custom.w != copied.w || ap.custom.h != copied.h || ap.custom.x != copied.x)      { ret 12; }
    if (ap.custom.y != copied.y || !string.str_equals(pattern.rule(?ap.custom), "B36/S23")) { ret 13; }
    var i: usize = 0;
    for (i < copied.w * copied.h) {
        if (ap.custom.cells[i] != copied.cells[i]) { ret 14; }
        i = i + 1;
    }
    if (pattern.get(?ap.custom, 1, 1) != 1 || pattern.get(?ap.custom, 2, 3) != 1) { ret 15; }

    pattern.dnit(?copied);
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__applies_every_command_however_many_a_frame_holds {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps;

    var i: i64 = 0;
    for (i < 300) {
        app.submit(?ap, command.Command.paint{command.Paint{x: i, y: 0, v: 1}});
        i = i + 1;
    }
    # a later command overrides an earlier one
    app.submit(?ap, command.Command.paint{command.Paint{x: 7, y: 0, v: 0}});
    if (ap.queue.items.len != 301) { ret 2; }
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 299)                     { ret 3; }
    if (sim.alive(?s, 7, 0) || !sim.alive(?s, 299, 0)) { ret 4; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__reset_returns_to_where_play_started_and_a_paused_edit_moves_it {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps;

    # a horizontal blinker, played for three generations and reset
    app.submit(?ap, command.Command.line{command.Line{x0: -1, y0: 0, x1: 1, y1: 0, v: 1}});
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    world.step(?s);
    world.step(?s);
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (s.running != 0 || s.generation != 0)           { ret 2; }
    if (!sim.alive(?s, -1, 0) || sim.alive(?s, 0, -1)) { ret 3; }

    # a step plays from the start, and an edit while paused makes the edited
    # world the start, which a reset then keeps
    app.submit(?ap, command.Command.step{});
    app.submit(?ap, command.Command.paint{command.Paint{x: 10, y: 10, v: 1}});
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (s.generation != 1)                                                       { ret 4; }
    if (!sim.alive(?s, 0, -1) || sim.alive(?s, -1, 0) || !sim.alive(?s, 10, 10)) { ret 5; }

    # played on, with an edit while running, and reset to the edited world
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    app.submit(?ap, command.Command.paint{command.Paint{x: 20, y: 20, v: 1}});
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (s.generation != 1)                                                        { ret 6; }
    if (!sim.alive(?s, 0, -1) || !sim.alive(?s, 10, 10) || sim.alive(?s, 20, 20)) { ret 7; }
    if (sim.population(?s) != 4)                                                  { ret 8; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__undo_and_redo_walk_the_changes_across_a_rule_change_and_a_new_change_clears_redo {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:    Deps;
    var life: rule.Rule = rule.preset_rule(0);
    # Brian's Brain, of another family, so the change re-encodes every cell
    var high: rule.Rule = rule.preset_rule(4);

    # a stroke, a rule change and a second stroke are three steps
    app.submit(?ap, command.Command.paint{command.Paint{x: 1, y: 1, v: 1}});
    app.submit(?ap, command.Command.line{command.Line{x0: 1, y0: 1, x1: 4, y1: 1, v: 1}});
    run(?ap, ?s, ?d);
    val word: u32 = sim.cell(?s, 4, 1);
    app.submit(?ap, command.Command.rule{high});
    app.submit(?ap, command.Command.paint{command.Paint{x: 200, y: 200, v: 1}});
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (sim.alive(?s, 200, 200) || !sim.alive(?s, 4, 1) || !rule.same(?s.rule, ?high)) { ret 2; }
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || sim.population(?s) != 4 || sim.cell(?s, 4, 1) != word) { ret 3; }
    app.submit(?ap, command.Command.undo{});
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 0 || !string.str_equals(ap.toast, "nothing to undo")) { ret 4; }

    app.submit(?ap, command.Command.redo{});
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?high) || sim.population(?s) != 4) { ret 5; }
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (!sim.alive(?s, 200, 200) || journal.redoable(?ap.log) != 0) { ret 6; }

    # undo back over the rule change, and a new change drops what could be redone
    app.submit(?ap, command.Command.undo{});
    app.submit(?ap, command.Command.undo{});
    app.submit(?ap, command.Command.paint{command.Paint{x: -50, y: 9, v: 1}});
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || !sim.alive(?s, -50, 9) || sim.alive(?s, 200, 200)) { ret 7; }
    if (!string.str_equals(ap.toast, "nothing to redo"))                                 { ret 8; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

# the state of the world's cell at (x, y)
#[testing]
fun state_at(s: *sim.Sim, x: i64, y: i64) u32 {
    ret rule.state(?s.rule, sim.cell(s, x, y));
}

test run__undo_and_redo_keep_the_states_a_stroke_paints_and_a_rule_change_clamps_the_ink {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps;

    # Star Wars, of four states: a dying state painted is kept and undone as a live one is
    app.submit(?ap, command.Command.rule{rule.preset_rule(5)});
    app.submit(?ap, command.Command.paint{command.Paint{x: 0, y: 0, v: 3}});
    run(?ap, ?s, ?d);
    app.submit(?ap, command.Command.paint{command.Paint{x: 5, y: 0, v: 2}});
    app.submit(?ap, command.Command.line{command.Line{x0: 5, y0: 0, x1: 8, y1: 0, v: 2}});
    run(?ap, ?s, ?d);
    if (state_at(?s, 0, 0) != 3 || state_at(?s, 8, 0) != 2) { ret 2; }
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (state_at(?s, 0, 0) != 3 || state_at(?s, 5, 0) != 0 || state_at(?s, 8, 0) != 0) { ret 3; }
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (state_at(?s, 0, 0) != 0) { ret 4; }
    app.submit(?ap, command.Command.redo{});
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (state_at(?s, 0, 0) != 3 || state_at(?s, 5, 0) != 2 || state_at(?s, 8, 0) != 2) { ret 5; }

    # the ink stays within the rule's states once it changes to fewer
    ap.ink = 3;
    app.submit(?ap, command.Command.rule{rule.preset_rule(4)});
    run(?ap, ?s, ?d);
    if (ap.ink != 2) { ret 6; }
    app.submit(?ap, command.Command.rule{rule.preset_rule(0)});
    run(?ap, ?s, ?d);
    if (ap.ink != 1) { ret 7; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__undo_takes_back_a_paste_with_its_rule_and_a_dropped_file {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:   Deps            = Deps{a: ?a};
    val dir: err[fs.FsError] = persist.make_parent(?a, "out/test/undo-drop/x");
    if (sel dir.err) { ret 1; }
    val rle: str = "x = 3, y = 1, rule = B36/S23\n3o!\n";
    fs.write_bytes("out/test/undo-drop/row.rle", rle, string.str_len(rle), persist.FILE_MODE);
    var life: rule.Rule = rule.preset_rule(0);
    var high: rule.Rule = rule.preset_rule(1);
    world.paint(?s, 50, 50, 1);
    val word: u32 = sim.cell(?s, 50, 50);

    # a glider pasted taking HighLife is one step, and the dropped row another
    app.paste(?ap, clipboard(?ap, "x = 3, y = 3, rule = B36/S23\nbo$2bo$3o!\n"), true);
    run(?ap, ?s, ?d);
    if (ap.custom.w != 3 || !rule.same(?s.rule, ?high)) { ret 2; }
    var names: [1]str;
    names[0] = "out/test/undo-drop/row.rle";
    app.drop(?ap, ?names[0], 1);
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 4) { ret 3; }

    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 1 || sim.cell(?s, 50, 50) != word || ap.custom.w != 3) { ret 4; }
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || ap.custom.w != 16 || !string.str_equals(pattern.name(?ap.custom), "custom")) { ret 5; }
    app.submit(?ap, command.Command.redo{});
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?high) || ap.custom.w != 3 || sim.population(?s) != 4) { ret 6; }

    fs.remove_file("out/test/undo-drop/row.rle");
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__identifies_a_selection_off_the_frame_and_a_second_replaces_the_first {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps = Deps{a: ?a};

    # an R-pentomino, under limits so wide it runs for a long while, and a blinker
    world.paint(?s, 1, 0, 1);
    world.paint(?s, 2, 0, 1);
    world.paint(?s, 0, 1, 1);
    world.paint(?s, 1, 1, 1);
    world.paint(?s, 1, 2, 1);
    world.paint(?s, 40, 40, 1);
    world.paint(?s, 41, 40, 1);
    world.paint(?s, 42, 40, 1);
    ap.id_limits.gens = 100000;
    ap.id_limits.side = 2048;
    app.select(?ap, 0, 0, 2, 2);
    app.area(?ap, command.AREA_IDENTIFY);
    run(?ap, ?s, ?d);
    # run returned with the classification still going, and only read the world
    if (!worker.running(?ap.identifier) || atomic.load(?ap.identifier.done) != 0) { ret 2; }
    if (ap.toast != app.IDENTIFYING || sim.population(?s) != 8)                   { ret 3; }
    app.identify_poll(?ap);
    if (ap.toast != app.IDENTIFYING) { ret 4; }

    # a second Identify cancels the first and its result is the one flashed
    app.select(?ap, 40, 40, 42, 40);
    app.area(?ap, command.AREA_IDENTIFY);
    run(?ap, ?s, ?d);
    worker.wait(?ap.identifier);
    app.identify_poll(?ap);
    if (worker.running(?ap.identifier))                                          { ret 5; }
    if (!string.str_equals(ap.toast, "selection: a period 2 oscillator, xp2_7")) { ret 6; }
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__refuses_a_kernel_widened_past_a_small_torus {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:     Deps;
    val torus: res[rule.Rule, str] = rule.parse("B3/S23:T3,40");
    if (sel torus.err) { ret 2; }
    var small: rule.Rule = torus.ok;
    app.submit(?ap, command.Command.rule{small});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?small)) { ret 3; }

    # the kernel editor widens the kernel without parsing, to a radius the
    # 3 wide torus cannot hold, and the rule stays as it was
    var wide: rule.Rule = small;
    if (sel wide.kind.weighted)  { weighted.set_radius(?wide.kind.weighted, 4); }
    if (rule.radius(?wide) != 4) { ret 4; }
    app.submit(?ap, command.Command.rule{wide});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?small))                                   { ret 5; }
    if (!string.str_starts_with(ap.toast, "the rule was not applied")) { ret 6; }
    if (sim.set_rule(?s, wide) || !rule.same(?s.rule, ?small))         { ret 7; }
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__a_rule_change_off_hashlife_says_why_whichever_way_it_came {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:  Deps;
    val b0: res[rule.Rule, str] = rule.parse("B0123478/S34678");
    if (sel b0.err) { ret 2; }
    var strobe: rule.Rule = b0.ok;
    var life:   rule.Rule = rule.preset_rule(0);

    # a rule typed while HashLife holds the world
    if (!sim.use_hashlife(?s, true)) { ret 3; }
    app.submit(?ap, command.Command.rule{strobe});
    run(?ap, ?s, ?d);
    if (sim.on_tree(?s) || !string.str_equals(ap.toast, "HashLife cannot run a B0 rule, so the world moved to the chunk engine")) { ret 4; }

    # choosing the pool is the user's own move and says nothing
    app.submit(?ap, command.Command.rule{life});
    run(?ap, ?s, ?d);
    if (!sim.use_hashlife(?s, true)) { ret 5; }
    val told: u32 = ap.told;
    app.submit(?ap, command.Command.engine{false});
    run(?ap, ?s, ?d);
    if (sim.on_tree(?s) || ap.told != told) { ret 6; }

    # undo back to the rule it left
    app.submit(?ap, command.Command.engine{true});
    run(?ap, ?s, ?d);
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (rule.same(?s.rule, ?life))                                                                    { ret 7; }
    if (sim.on_tree(?s) || !string.str_ends_with(ap.toast, "so the world moved to the chunk engine")) { ret 8; }
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__undo_takes_a_world_back_off_a_bounded_grid_with_the_cells_it_dropped {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:     Deps;
    var life:  rule.Rule           = rule.preset_rule(0);
    val torus: res[rule.Rule, str] = rule.parse("B3/S23:T100,100");
    if (sel torus.err) { ret 2; }
    var small: rule.Rule = torus.ok;

    app.submit(?ap, command.Command.paint{command.Paint{x: 1, y: 1, v: 1}});
    app.submit(?ap, command.Command.paint{command.Paint{x: 200, y: 200, v: 1}});
    run(?ap, ?s, ?d);
    # the torus drops the cell off it, and undo brings back the plane and the cell
    app.submit(?ap, command.Command.rule{small});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?small) || sim.alive(?s, 200, 200) || !sim.alive(?s, 1, 1)) { ret 3; }
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || !sim.alive(?s, 200, 200) || !sim.alive(?s, 1, 1)) { ret 4; }
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?small) || sim.alive(?s, 200, 200)) { ret 5; }
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__bounds_move_the_world_and_the_view_drop_what_falls_off_and_undo_puts_both_back {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d:    Deps;
    var life: rule.Rule = rule.preset_rule(0);
    world.paint(?s, 0, 0, 1);
    world.paint(?s, 17, 8, 1);
    world.paint(?s, 100, 100, 1);
    world.paint(?s, 101, 100, 1);
    ap.pan_x = 7.0;
    ap.pan_y = 3.0;

    # a 20 by 10 plane drawn from (-2, -1) is centred, the world and the view
    # moving 8 left and 4 up with it, and the two cells off it dropped
    val plane: topology.Grid = topology.Grid{shape: topology.PLANE, w: 20, h: 10, twist_w: false};
    app.submit(?ap, command.Command.bounds{command.Bounds{grid: plane, x0: -2, y0: -1}});
    run(?ap, ?s, ?d);
    var on: topology.Grid = s.rule.grid;
    if (!topology.same(?on, ?plane) || sim.population(?s) != 2)                                { ret 2; }
    if (!sim.alive(?s, -8, -4) || !sim.alive(?s, 9, 4) || sim.alive(?s, 0, 0))                 { ret 3; }
    if (ap.pan_x != -1.0 || ap.pan_y != -1.0)                                                  { ret 4; }
    if (!string.str_equals(ap.toast, "bounds set: P20,10; 2 cells outside them were dropped")) { ret 5; }

    # undo puts back the plane, the cells and the view, and redo makes the change again
    app.submit(?ap, command.Command.undo{});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || sim.population(?s) != 4 || !sim.alive(?s, 101, 100)) { ret 6; }
    if (!sim.alive(?s, 0, 0) || ap.pan_x != 7.0 || ap.pan_y != 3.0)                        { ret 7; }
    app.submit(?ap, command.Command.redo{});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 2 || !sim.alive(?s, -8, -4) || ap.pan_x != -1.0) { ret 8; }

    # a shrunk box drops more, each shape is taken where the grid is, and the
    # bounds come off without moving anything
    val small: topology.Grid = topology.Grid{shape: topology.PLANE, w: 10, h: 10, twist_w: false};
    app.submit(?ap, command.Command.bounds{command.Bounds{grid: small, x0: -10, y0: -5}});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 1 || !sim.alive(?s, -3, -4) || ap.pan_x != 4.0) { ret 9; }
    if (!string.str_ends_with(ap.toast, "1 cell outside them was dropped"))   { ret 10; }
    val shapes: [4]u8 = [4]u8{topology.TORUS, topology.KLEIN, topology.KLEIN, topology.CROSS};
    var k:      usize = 0;
    for (k < 4) {
        val g: topology.Grid = topology.Grid{shape: shapes[k], w: 10, h: 10, twist_w: k == 1};
        app.submit(?ap, command.Command.bounds{command.Bounds{grid: g, x0: -5, y0: -5}});
        run(?ap, ?s, ?d);
        on = s.rule.grid;
        if (!topology.same(?on, ?g) || !sim.alive(?s, -3, -4) || ap.pan_x != 4.0) { ret 11 + k::i32; }
        k = k + 1;
    }
    app.submit(?ap, command.Command.bounds{command.Bounds{grid: topology.open(), x0: 0, y0: 0}});
    run(?ap, ?s, ?d);
    if (!rule.same(?s.rule, ?life) || !sim.alive(?s, -3, -4) || ap.pan_x != 4.0) { ret 15; }
    if (!string.str_equals(ap.toast, "bounds removed"))                          { ret 16; }

    # HashLife cannot run a bounded grid, so the world moves to the chunk engine
    if (!sim.use_hashlife(?s, true)) { ret 17; }
    app.submit(?ap, command.Command.bounds{command.Bounds{grid: small, x0: -5, y0: -5}});
    run(?ap, ?s, ?d);
    if (sim.on_tree(?s) || !sim.alive(?s, -3, -4))                    { ret 18; }
    if (!string.str_ends_with(ap.toast, "moved to the chunk engine")) { ret 19; }
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}
