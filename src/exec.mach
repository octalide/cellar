# applies the queued commands to the world and its files
#
# the one place a command's effect happens. the frame calls run once, before it
# collects or records anything, so the world a save reads is the world the
# command was issued against.
#
# it also keeps the start reset returns to. play starting from paused, by a
# toggle or a step, takes a snapshot when none is held. an edit while paused
# drops it, so the edited world is the start from then on and the next play
# takes it. an edit while running is part of the run and leaves it alone, but
# clear, randomize and load begin a new world, so they drop it paused and
# retake it from the new world running.

use cellar.app;
use cellar.command;
use cellar.paths;
use cellar.pattern;
use cellar.persist;
use cellar.sim;
use cellar.snapshot;
use cellar.text;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# what a command needs beyond the world
# ---
# a: allocator for file buffers
# p: the data directory
pub rec Deps {
    a: *allo.Allocator;
    p: *paths.Paths;
}

# save or load with the outcome flashed
fun report(a: *app.App, ok: str, e: err[persist.Error]) {
    if (sel e.err) {
        app.say(a, persist.error_message(e.err));
        ret;
    }
    app.say(a, ok);
}

# the view a world file keeps, as the app holds it
fun view_of(a: *app.App) persist.View {
    ret persist.View{pan_x: a.pan_x, pan_y: a.pan_y, zoom: a.zoom, mode: a.mode::u8};
}

# show a world file's view, its zoom brought within the app's limits
fun take_view(a: *app.App, v: *persist.View) {
    a.pan_x = v.pan_x;
    a.pan_y = v.pan_y;
    a.zoom  = app.clamp_zoom(v.zoom);
    a.mode  = v.mode::usize;
}

# save the world with the view
fun save_world(a: *app.App, s: *sim.Sim, d: *Deps, path: str) {
    var v: persist.View = view_of(a);
    report(a, "world saved", persist.save_world(d.a, s, ?v, path));
}

# load the world and the view it was saved with, saying when its rule could not be taken
# ---
# ret: whether the world was replaced
fun load_world(a: *app.App, s: *sim.Sim, d: *Deps, path: str) bool {
    var v:    persist.View                       = view_of(a);
    val done: res[persist.Loaded, persist.Error] = persist.load_world(d.a, s, ?v, path);
    if (sel done.err) {
        app.say(a, persist.error_message(done.err));
        ret false;
    }
    take_view(a, ?v);
    if (done.ok.foreign) {
        app.say(a, "world loaded, but its rule is not one cellar can run; the current rule is kept");
        ret true;
    }
    app.say(a, "world loaded");
    ret true;
}

# snapshot the world as the start, saying when it could not be kept
fun take_start(a: *app.App, s: *sim.Sim) {
    if (!sim.take(s, ?a.start)) { app.say(a, "the starting world could not be kept, so reset has nothing to return to"); }
}

# return to the start, or stay put when the world as it stands is the start. a
# start the pool can no longer hold marks the world full, which the frame reports
fun reset(a: *app.App, s: *sim.Sim) {
    if (a.start.held) { sim.restore(s, ?a.start); }
}

# the file a command reads or writes, or false when no directory is known
fun file(d: *Deps, name: str, out: *u8, a: *app.App) bool {
    if (!d.p.ok) {
        app.say(a, "no user data directory is known");
        ret false;
    }
    paths.file(d.p, name, out);
    ret true;
}

# apply one command
fun apply(c: *command.Command, a: *app.App, s: *sim.Sim, d: *Deps) {
    val paused: bool = !world.running(s);
    if ((sel c.toggle || sel c.step) && paused && !world.full(s) && !a.start.held) { take_start(a, s); }
    val edited: bool = sel c.paint || sel c.line || sel c.stamp || sel c.rule;
    var fresh:  bool = sel c.clear || sel c.randomize;

    if (sel c.toggle)    { world.toggle(s); }
    if (sel c.step)      { world.step(s); }
    if (sel c.clear)     { world.clear(s); }
    if (sel c.randomize) { world.randomize(s, c.randomize); }
    if (sel c.paint)     { world.paint(s, c.paint.x, c.paint.y, c.paint.v); }
    if (sel c.line)      { world.line(s, c.line.x0, c.line.y0, c.line.x1, c.line.y1, c.line.v); }
    if (sel c.stamp)     { world.stamp(s, ?c.stamp.p, c.stamp.x, c.stamp.y); }
    if (sel c.rule)      { s.kernel = c.rule; }
    if (sel c.reset)     { reset(a, s); }

    var path: [1088]u8;
    if (sel c.save_world && file(d, paths.WORLD, ?path[0], a)) { save_world(a, s, d, ?path[0]); }
    if (sel c.load_world && file(d, paths.WORLD, ?path[0], a)) { fresh = load_world(a, s, d, ?path[0]); }
    if (sel c.save_pattern && file(d, paths.CUSTOM, ?path[0], a)) {
        report(a, "custom pattern saved", persist.save_pattern(d.a, ?a.custom, ?path[0]));
    }
    if (sel c.load_pattern && file(d, paths.CUSTOM, ?path[0], a)) {
        report(a, "custom pattern loaded", persist.load_pattern(d.a, ?a.custom, ?path[0]));
        a.pattern_sel = pattern.BUILTIN_COUNT;
    }

    if (fresh && !paused)            { take_start(a, s); }
    or (fresh || (edited && paused)) { snapshot.drop(?a.start); }
}

# apply every waiting command in order and empty the queue
# ---
# a: application state, which owns the queue
# s: the simulation, locked by the caller and not yet recorded into
# d: what the commands need
pub fun run(a: *app.App, s: *sim.Sim, d: *Deps) {
    var i: usize = 0;
    for (i < a.queue.items.len) {
        apply(?a.queue.items.data[i], a, s, d);
        i = i + 1;
    }
    command.clear(?a.queue);
}

test run__applies_in_order_and_a_save_sees_the_edits_before_it {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[allo.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var p: paths.Paths;
    p.ok                                          = true;
    p.dir[text.buf_str(?p.dir[0], 0, "out/test")] = 0;
    var d: Deps = Deps{a: ?a, p: ?p};

    app.submit(?ap, command.Command.paint{command.Paint{x: 1, y: 2, v: 1}});
    app.submit(?ap, command.Command.line{command.Line{x0: 10, y0: 10, x1: 14, y1: 10, v: 1}});
    # the glider's five cells, stamped well clear of the rest
    app.stamp(?ap, ?ap.library[0], 0, 100, 100);
    ap.pan_x = -40.5;
    ap.zoom  = 99.0;
    app.submit(?ap, command.Command.save_world{});
    app.submit(?ap, command.Command.clear{});
    if (ap.queue.items.len != 5) { ret 2; }
    run(?ap, ?s, ?d);
    if (ap.queue.items.len != 0) { ret 3; }
    if (sim.population(?s) != 0) { ret 4; }

    ap.pan_x = 0.0;
    app.submit(?ap, command.Command.load_world{});
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 11)                       { ret 5; }
    if (!sim.alive(?s, 1, 2) || !sim.alive(?s, 14, 10)) { ret 6; }
    # the view comes back with it, its zoom within the app's limits
    if (ap.pan_x != -40.5 || ap.zoom != app.ZOOM_MAX) { ret 7; }

    var path: [1088]u8;
    fs.remove_file(paths.file(?p, paths.WORLD, ?path[0]));
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__applies_every_command_however_many_a_frame_holds {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[allo.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps;

    var i: i64 = 0;
    for (i < 300) {
        app.submit(?ap, command.Command.paint{command.Paint{x: i, y: 0, v: 1}});
        i = i + 1;
    }
    # a later command overrides an earlier one
    app.submit(?ap, command.Command.paint{command.Paint{x: 7, y: 0, v: 0}});
    if (ap.queue.items.len != 301) { ret 2; }
    run(?ap, ?s, ?d);
    if (sim.population(?s) != 299)                     { ret 3; }
    if (sim.alive(?s, 7, 0) || !sim.alive(?s, 299, 0)) { ret 4; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test run__reset_returns_to_where_play_started_and_a_paused_edit_moves_it {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[allo.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    var d: Deps;

    # a horizontal blinker, played for three generations and reset
    app.submit(?ap, command.Command.line{command.Line{x0: -1, y0: 0, x1: 1, y1: 0, v: 1}});
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    world.step(?s);
    world.step(?s);
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (world.running(?s) || world.generation(?s) != 0) { ret 2; }
    if (!sim.alive(?s, -1, 0) || sim.alive(?s, 0, -1))  { ret 3; }

    # a step plays from the start, and an edit while paused makes the edited
    # world the start, which a reset then keeps
    app.submit(?ap, command.Command.step{});
    app.submit(?ap, command.Command.paint{command.Paint{x: 10, y: 10, v: 1}});
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (world.generation(?s) != 1)                                               { ret 4; }
    if (!sim.alive(?s, 0, -1) || sim.alive(?s, -1, 0) || !sim.alive(?s, 10, 10)) { ret 5; }

    # played on, with an edit while running, and reset to the edited world
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    app.submit(?ap, command.Command.paint{command.Paint{x: 20, y: 20, v: 1}});
    app.submit(?ap, command.Command.toggle{});
    run(?ap, ?s, ?d);
    world.step(?s);
    app.submit(?ap, command.Command.reset{});
    run(?ap, ?s, ?d);
    if (world.generation(?s) != 1)                                                { ret 6; }
    if (!sim.alive(?s, 0, -1) || !sim.alive(?s, 10, 10) || sim.alive(?s, 20, 20)) { ret 7; }
    if (sim.population(?s) != 4)                                                  { ret 8; }

    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}
