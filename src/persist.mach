    # a 4 x 2 world from before the world was unbounded
    var body: [14]u8          = [14]u8{'4', ' ', '2', '\n', '1', '0', '0', '0', '\n', '0', '0', '0', '1', '\n'};
    val path: str             = "out/test/test_old.cellar";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 1; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 14, FILE_MODE);
    if (sel wrote.err) { ret 2; }

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 3; }
    var v:      View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val loaded: res[Loaded, Error] = load_world(?a, ?s, ?v, path);
    fs.remove_file(path);
    if (sel loaded.err)                                 { ret 4; }
    if (sim.population(?s) != 2)                        { ret 5; }
    if (!sim.alive(?s, -2, -1) || !sim.alive(?s, 1, 0)) { ret 6; }
    sim.dnit(?s);
    ret 0;
}

test load_pattern__round_trips {
    var a: allo.Allocator;
    page.make(?a);

    var p:     pattern.Pattern;
    val made5: err[allo.Error] = pattern.init(?p, ?a, 5, 3, "custom");
    if (sel made5.err) { ret 1; }
    pattern.set(?p, 0, 0, 1);
    pattern.set(?p, 4, 2, 1);
    pattern.set(?p, 2, 1, 1);

    val path:   str        = "out/test/test_pattern.rle";
    val saved4: err[Error] = save_pattern(?a, ?p, path);
    if (sel saved4.err) { ret 1; }

    var q:     pattern.Pattern;
    val made6: err[allo.Error] = pattern.init(?q, ?a, 1, 1, "custom");
    if (sel made6.err) { ret 1; }
    val loaded4: err[Error] = load_pattern(?a, ?q, path);
    if (sel loaded4.err) { ret 2; }

    if (q.w != 5 || q.h != 3) { ret 3; }
    var y: usize = 0;
    for (y < 3) {
        var x: usize = 0;
        for (x < 5) {
            if (pattern.get(?q, x, y) != pattern.get(?p, x, y)) { ret 4; }
            x = x + 1;
        }
        y = y + 1;
    }

    pattern.dnit(?p);
    pattern.dnit(?q);
    fs.remove_file(path);
    ret 0;
}

test load_pattern__reads_by_length_past_an_embedded_nul {
    var t:    alloc_testing.Testing;
    val made: err[allo.Error] = alloc_testing.make(?t);
    if (sel made.err) { ret 1; }
    val a: *allo.Allocator = alloc_testing.allocator_of(?t);

    # a NUL inside the body ended the old NUL-terminated read early
    var body: [9]u8           = [9]u8{'3', ' ', '1', '\n', '1', 0, '0', '1', '\n'};
    val path: str             = "out/test/test_nul.pattern";
    val dir:  err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    var p:     pattern.Pattern;
    val made7: err[allo.Error] = pattern.init(?p, a, 1, 1, "custom");
    if (sel made7.err) { ret 1; }
    val loaded: err[Error] = load_pattern(a, ?p, path);
    fs.remove_file(path);
    if (sel loaded.err)                                                                                     { ret 4; }
    if (p.w != 3 || pattern.get(?p, 0, 0) != 1 || pattern.get(?p, 1, 0) != 0 || pattern.get(?p, 2, 0) != 1) { ret 5; }
    pattern.dnit(?p);
    if (alloc_testing.leaked(?t)) { ret 6; }
    alloc_testing.dnit(?t);
    ret 0;
}

test load_world__short_body_leaves_the_world_intact {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.paint(?s, 2, 2, 1);

    # declares 3x3 but carries four cells
    var body: [9]u8           = [9]u8{'3', ' ', '3', '\n', '1', '1', '0', '1', '\n'};
    val path: str             = "out/test/test_short.cellar";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    var v:      View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val loaded: res[Loaded, Error] = load_world(?a, ?s, ?v, path);
    fs.remove_file(path);
    if (!sel loaded.err)           { ret 4; }
    if (!sel loaded.err.truncated) { ret 5; }
    if (sim.population(?s) != 1)   { ret 6; }
    if (!sim.alive(?s, 2, 2))      { ret 7; }
    sim.dnit(?s);
    ret 0;
}

test load_pattern__loads_an_rle_file_and_refuses_unknown_text {
    var a: allo.Allocator;
    page.make(?a);

    val dir: err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 1; }
    val path:  str             = "out/test/test_rle.pattern";
    val rle:   str             = "x = 3, y = 3, rule = B3/S23\nbob$2bo$3o!\n";
    val wrote: err[fs.FsError] = fs.write_bytes(path, rle::*u8, 40, FILE_MODE);
    if (sel wrote.err) { ret 2; }

    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, ?a, 1, 1, "custom");
    if (sel made.err) { ret 3; }
    val loaded: err[Error] = load_pattern(?a, ?p, path);
    if (sel loaded.err)                                                                   { ret 4; }
    if (p.w != 3 || p.h != 3 || pattern.get(?p, 1, 0) != 1 || pattern.get(?p, 0, 0) != 0) { ret 5; }

    # text no format recognises is refused, leaving the pattern as it was
    val junk: str             = "hello";
    val w2:   err[fs.FsError] = fs.write_bytes(path, junk::*u8, 5, FILE_MODE);
    if (sel w2.err) { ret 6; }
    val bad: err[Error] = load_pattern(?a, ?p, path);
    fs.remove_file(path);
    if (!sel bad.err || p.w != 3) { ret 7; }
    pattern.dnit(?p);
    ret 0;
}

# write bytes to a test file
#[testing]
fun put_file(a: *allo.Allocator, path: str, body: str) bool {
    val dir: err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret false; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, body::*u8, string.str_len(body), FILE_MODE);
    ret !(sel wrote.err);
}

# a chunk record at (cx, cy) whose first row starts with the given cells
#[testing]
fun chunk_text(out: *Vector[u8], rec_line: str, first: str) {
    var i: usize = 0;
    for (rec_line[i] != 0) {
        vector.push[u8](out, rec_line[i]);
        i = i + 1;
    }
    var k: usize = 0;
    for (k < space.CELLS) {
        var c: u8 = '0';
        if (k < string.str_len(first)) { c = first[k]; }
        vector.push[u8](out, c);
        if (k % 64 == 63) { vector.push[u8](out, '\n'); }
        k = k + 1;
    }
}

# load a world file of a header and one chunk at (-1, 2) whose first row starts "101"
#[testing]
fun load_versioned(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str, head: str) res[Loaded, Error] {
    ret load_cells(a, s, v, path, head, "101");
}

# load a world file of a header and one chunk at (-1, 2) whose first row starts with first
#[testing]
fun load_cells(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str, head: str, first: str) res[Loaded, Error] {
    var body: Vector[u8] = vector.init[u8](a);
    var i:    usize      = 0;
    for (head[i] != 0) {
        vector.push[u8](?body, head[i]);
        i = i + 1;
    }
    chunk_text(?body, "-1 2\n", first);
    vector.push[u8](?body, 0);
    val dir: err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret res[Loaded, Error].err{Error.fs{dir.err}}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, body.data, body.len - 1, FILE_MODE);
    vector.dnit[u8](?body);
    if (sel wrote.err) { ret res[Loaded, Error].err{Error.fs{wrote.err}}; }
    val r: res[Loaded, Error] = load_world(a, s, v, path);
    fs.remove_file(path);
    ret r;
}

test load_world__reads_cellar_2_and_every_cellar_3_header {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var v:  View      = View{pan_x: 1.5, pan_y: -2.5, zoom: 3.0, mode: render.MODE_AGE};
    var lf: rule.Rule = rule.preset_rule(0);
    var hl: rule.Rule = rule.preset_rule(1);

    # a 0.3.0 world
    val two: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v2.cellar", "cellar 2\n");
    if (sel two.err)                                         { ret 2; }
    if (sim.population(?s) != 2 || !sim.alive(?s, -64, 128)) { ret 3; }
    if (!sim.alive(?s, -62, 128) || sim.alive(?s, -63, 128)) { ret 4; }

    # a header with no keys loads the cells and leaves the rule and view alone
    s.generation = 9;
    val bare: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_bare.cellar", "cellar 3\n\n");
    if (sel bare.err)                                                           { ret 5; }
    if (bare.ok.foreign || sim.population(?s) != 2 || s.generation != 0)        { ret 5; }
    if (!rule.same(?s.rule, ?lf) || v.zoom != 3.0 || v.mode != render.MODE_AGE) { ret 5; }

    # keys are read in any case of line ending, and keys a later version adds are skipped
    val three: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3.cellar", "cellar 3\r\nrule b36/s23\r\ngeneration 12\nlater stuff\nmode glow\npan_y 7.25\n\r\n");
    if (sel three.err)                                                  { ret 6; }
    if (three.ok.foreign || !sim.alive(?s, -64, 128))                   { ret 6; }
    if (!rule.same(?s.rule, ?hl) || s.generation != 12)                 { ret 6; }
    if (v.pan_y != 7.25 || v.pan_x != 1.5 || v.mode != render.MODE_AGE) { ret 6; }

    # a rule cellar cannot run loads the world with the rule as it was
    val odd: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_odd.cellar", "cellar 3\nrule B3/S23:S20\ngeneration 3\n\n");
    if (sel odd.err)                                                      { ret 7; }
    if (!odd.ok.foreign || !rule.same(?s.rule, ?hl) || s.generation != 3) { ret 7; }

    # a whole kernel is preferred to the notation beside it, and one this
    # version cannot run is foreign even beside a rule it can
    val both: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_both.cellar", "cellar 3\nrule B3/S23\nkernel 1 64 12 1 1 1 1 0 1 1 1 1\n\n");
    if (sel both.err) { ret 12; }
    val bk: *weighted.Kernel = rule.view[weighted.Kernel](?s.rule, ?weighted.FAMILY);
    if (both.ok.foreign || bk == nil)                 { ret 12; }
    if (bk.birth.w[0] != 64 || bk.survive.w[0] != 12) { ret 12; }
    val wide: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_wide.cellar", "cellar 3\nrule B3/S23\nkernel 17 8 12 1\n\n");
    if (sel wide.err) { ret 13; }
    val wk: *weighted.Kernel = rule.view[weighted.Kernel](?s.rule, ?weighted.FAMILY);
    if (!wide.ok.foreign || wk == nil) { ret 13; }
    if (wk.birth.w[0] != 64)           { ret 13; }

    # a version from the future, a header that never ends, and a value that
    # cannot be read, are refused untouched
    val six: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v7.cellar", "cellar 7\n\n");
    if (!sel six.err)         { ret 8; }
    if (!sel six.err.version) { ret 8; }
    val open: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_open.cellar", "cellar 3\nrule B3/S23\n");
    if (!sel open.err) { ret 9; }
    val nan: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_nan.cellar", "cellar 3\nzoom nan\n\n");
    if (!sel nan.err)                                 { ret 10; }
    if (sim.population(?s) != 2 || s.generation != 0) { ret 11; }
    sim.dnit(?s);
    ret 0;
}

test migrate__moves_0_3_0_saves_off_cells {
    var a: allo.Allocator;
    page.make(?a);
    var p: paths.Paths;
    p.ok                                                  = true;
    p.dir[text.buf_str(?p.dir[0], 0, "out/test/migrate")] = 0;
    val dir: err[fs.FsError] = fs.create_dir_all(?a, paths.dir(?p), DIR_MODE);
    if (sel dir.err) { ret 1; }
    var ow: [1088]u8;
    var oc: [1088]u8;
    var nw: [1088]u8;
    var nc: [1088]u8;
    paths.file(?p, paths.LEGACY_WORLD, ?ow[0]);
    paths.file(?p, paths.LEGACY_CUSTOM, ?oc[0]);
    paths.file(?p, paths.WORLD, ?nw[0]);
    paths.file(?p, paths.CUSTOM, ?nc[0]);
    fs.remove_file(?nw[0]);
    fs.remove_file(?nc[0]);
    if (!put_file(?a, ?ow[0], "2 1\n11\n"))       { ret 2; }
    if (!put_file(?a, ?oc[0], "3 2\n010\n001\n")) { ret 3; }

    val moved: err[Error] = migrate(?a, ?p);
    if (sel moved.err)                      { ret 4; }
    if (present(?ow[0]) || present(?oc[0])) { ret 5; }

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 6; }
    var v:     View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val world: res[Loaded, Error] = load_world(?a, ?s, ?v, ?nw[0]);
    if (sel world.err)           { ret 7; }
    if (sim.population(?s) != 2) { ret 7; }

    var q:     pattern.Pattern;
    val made2: err[allo.Error] = pattern.init(?q, ?a, 1, 1, "custom");
    if (sel made2.err) { ret 8; }
    var f:  format.Format;
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, ?nc[0]);
    if (sel rr.err) { ret 9; }
    var data: Vector[u8] = rr.ok;
    if (!formats.by_bytes(data.data, data.len, ?f) || !string.str_equals(f.id, "rle")) { ret 10; }
    vector.dnit[u8](?data);
    val custom: err[Error] = load_pattern(?a, ?q, ?nc[0]);
    if (sel custom.err)                                                                         { ret 11; }
    if (q.w != 3 || q.h != 2)                                                                   { ret 11; }
    if (pattern.get(?q, 1, 0) != 1 || pattern.get(?q, 2, 1) != 1 || pattern.get(?q, 0, 0) != 0) { ret 12; }
    if (!string.str_equals(pattern.name(?q), "custom"))                                         { ret 13; }

    # a second run finds nothing left to move
    val again: err[Error] = migrate(?a, ?p);
    if (sel again.err) { ret 14; }
    fs.remove_file(?nw[0]);
    fs.remove_file(?nc[0]);
    pattern.dnit(?q);
    sim.dnit(?s);
    ret 0;
}

test load_world__reads_a_cellar_4_rule_by_its_family {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var v:  View      = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: render.MODE_SOLID};
    var hl: rule.Rule = rule.preset_rule(1);

    val four: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v4.cellar", "cellar 4\nrule B36/S23\nfamily weighted\nstates 2\n\n");
    if (sel four.err)                                         { ret 2; }
    if (four.ok.foreign || !rule.same(?s.rule, ?hl))          { ret 3; }
    if (!sim.alive(?s, -64, 128) || !sim.alive(?s, -62, 128)) { ret 4; }

    # a family this version does not run is foreign, and a state the rule
    # lacks loads live
    val later: res[Loaded, Error] = load_cells(?a, ?s, ?v, "out/test/test_v4_later.cellar", "cellar 4\nfamily lenia\nrule R13\nstates 3\n\n", "102");
    if (sel later.err)                                       { ret 5; }
    if (!later.ok.foreign || !rule.same(?s.rule, ?hl))       { ret 6; }
    if (sim.population(?s) != 2 || !sim.alive(?s, -62, 128)) { ret 7; }

    # a state past the ones declared is refused
    val bad: res[Loaded, Error] = load_cells(?a, ?s, ?v, "out/test/test_v4_bad.cellar", "cellar 4\nstates 2\n\n", "102");
    if (!sel bad.err) { ret 8; }
    val big: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v4_big.cellar", "cellar 4\nstates 300\n\n");
    if (!sel big.err) { ret 9; }
    sim.dnit(?s);
    ret 0;
}

test open_file__runs_a_rule_file_and_installs_it_where_its_name_is_looked_up {
    var a: allo.Allocator;
    page.make(?a);
    val data:  str             = "out/test/rule_open/data";
    val away:  str             = "out/test/rule_open/away";
    val made1: err[fs.FsError] = fs.create_dir_all(?a, data, DIR_MODE);
    val made2: err[fs.FsError] = fs.create_dir_all(?a, away, DIR_MODE);
    if (sel made1.err || sel made2.err) { ret 1; }
    fs.remove_file("out/test/rule_open/data/Spin.rule");
    store.search(data);

    # a live cell turns to the next of three live states, and one beside a
    # state 3 cell is born
    val text: str             = "@RULE Spin\n@TABLE\nn_states:4\nneighborhood:vonNeumann\nsymmetries:rotate4\n1,a,b,c,d,2\n2,a,b,c,d,3\n3,a,b,c,d,1\n0,3,0,0,0,1\nvar a={0,1,2,3}\n";
    val path: str             = "out/test/rule_open/away/Spin.rule";
    val w1:   err[fs.FsError] = fs.write_bytes(path, text::*u8, string.str_len(text), FILE_MODE);
    if (sel w1.err) { ret 2; }
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 3; }
    var v: View = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};

    # variables must come before the transitions naming them, so the file is
    # refused at the line that names one first, and the rule is kept
    val bad: res[Opened, Error] = open_file(?a, ?s, ?v, path);
    if (!sel bad.err || !rule.is(?s.rule, ?weighted.FAMILY)) { ret 4; }
    if (sel bad.err) {
        if (!sel bad.err.rule) { ret 5; }
        if (sel bad.err.rule) {
            if (bad.err.rule.line != 6) { ret 5; }
        }
    }

    val good: str             = "@RULE Spin\n@TABLE\nn_states:4\nneighborhood:vonNeumann\nsymmetries:rotate4\nvar a={0,1,2,3}\nvar b=a\nvar c=a\nvar d=a\n1,a,b,c,d,2\n2,a,b,c,d,3\n3,a,b,c,d,1\n0,3,0,0,0,1\n";
    val w2:   err[fs.FsError] = fs.write_bytes(path, good::*u8, string.str_len(good), FILE_MODE);
    if (sel w2.err) { ret 6; }
    val opened: res[Opened, Error] = open_file(?a, ?s, ?v, path);
    if (sel opened.err)                                          { ret 7; }
    if (opened.ok.world || opened.ok.foreign || opened.ok.stray) { ret 8; }
    var buf: [rule.FORMAT_MAX + 1]u8;
    if (!rule.is(?s.rule, ?ruletable.FAMILY) || !string.str_equals(rule.format(?s.rule, ?buf[0]), "Spin")) { ret 9; }

    # the file was copied where its name is looked up, and the name gives the
    # same rule back, as a pattern naming it takes it
    if (!present("out/test/rule_open/data/Spin.rule")) { ret 10; }
    val again: res[rule.Rule, str] = rule.parse("Spin");
    if (sel again.err)                  { ret 11; }
    if (!rule.same(?again.ok, ?s.rule)) { ret 11; }
    # on HashLife, which cannot run a table, the world moves off the tree as
    # the rule is taken, before the cells go in
    sim.set_rule(?s, rule.preset_rule(0));
    if (!sim.use_hashlife(?s, true)) { ret 15; }
    val rle: str             = "x = 2, y = 1, rule = Spin\nAC!\n";
    val pat: str             = "out/test/rule_open/away/spin.rle";
    val w3:  err[fs.FsError] = fs.write_bytes(pat, rle::*u8, string.str_len(rle), FILE_MODE);
    if (sel w3.err) { ret 12; }
    val stamped: res[Opened, Error] = open_file(?a, ?s, ?v, pat);
    if (sel stamped.err || !rule.same(?again.ok, ?s.rule)) { ret 13; }
    if (sel stamped.ok && stamped.ok.foreign)              { ret 13; }
    # the pattern's cells are written as the states of its rule, which the
    # world's rule before it lacked
    var ones:   usize = 0;
    var threes: usize = 0;
    var y:      i64   = -2;
    for (y <= 2) {
        var x: i64 = -2;
        for (x <= 2) {
            val st: u32 = rule.state(?s.rule, sim.cell(?s, x, y));
            if (st == 1) { ones = ones + 1; }
            if (st == 3) { threes = threes + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    if (sim.population(?s) != 2 || ones != 1 || threes != 1 || sim.on_tree(?s)) { ret 14; }
    sim.dnit(?s);
    fs.remove_file(path);
    fs.remove_file(pat);
    fs.remove_file("out/test/rule_open/data/Spin.rule");
    ret 0;
}

test parse_chunk__reads_a_version_6_chunk_of_words_of_several_values {
    var a: allo.Allocator;
    page.make(?a);
    # three values a word, 8 hexadecimal digits each run together, as a
    # cellar 6 file under a rule of three layers writes them
    var b:    Vector[u8]             = vector.init[u8](?a);
    val text: str                    = "0000000100fedcba0000ffff ";
    val n:    usize                  = string.str_len(text);
    val room: res[usize, allo.Error] = vector.reserve[u8](?b, n * space.CELLS);
    if (sel room.err) { ret 1; }
    var i: usize = 0;
    for (i < space.CELLS) {
        mem.raw_copy(?b.data[i * n], text, n);
        i = i + 1;
    }
    b.len = n * space.CELLS;
    var out: Vector[u32]            = vector.init[u32](?a);
    val got: res[usize, allo.Error] = vector.reserve[u32](?out, space.CELLS * 3);
    if (sel got.err) { ret 1; }
    var end: usize      = 0;
    val r:   err[Error] = parse_chunk(?b, 0, 1, 2, true, 3, out.data, ?end);
    # the last word ends a byte short of the space after it
    if (sel r.err || end != b.len - 1)                                                   { ret 2; }
    if (out.data[0] != 1 || out.data[1] != 0xfedcba || out.data[3 * 4095 + 2] != 0xffff) { ret 3; }
    # a word cut short is refused
    b.len = n * space.CELLS - 10;
    val short: err[Error] = parse_chunk(?b, 0, 1, 2, true, 3, out.data, ?end);
    if (!sel short.err) { ret 4; }
    vector.dnit[u32](?out);
    vector.dnit[u8](?b);
    ret 0;
}

# a reaction-diffusion world as 0.8.0 holds one: an inked square, and two
# cells holding u below 1, one of them with no v, inside one chunk, stepped
# 20 generations
#[testing]
fun seed_legacy_reaction(s: *sim.Sim) bool {
    val r: res[rule.Rule, str] = rule.parse("F=0.0367,k=0.0649");
    if (sel r.err)              { ret false; }
    if (!sim.set_rule(s, r.ok)) { ret false; }
    sim.fill_begin(s);
    var y: i64 = 0;
    for (y < 12) {
        var x: i64 = 0;
        for (x < 12) {
            sim.fill_cell(s, 26 + x, 26 + y, rule.ink(?s.rule));
            x = x + 1;
        }
        y = y + 1;
    }
    sim.fill_cell(s, 44, 30, 9);
    sim.fill_cell(s, 45, 30, 9 + 16 * 3);
    if (!sim.fill_end(s)) { ret false; }
    var g: usize = 0;
    for (g < 20) {
        sim.step(s);
        g = g + 1;
    }
    ret s.generation == 20;
}

# the files 0.8.0's encoders wrote for the world seed_legacy_reaction makes,
# each cell one value holding both fields
#[testing]
#[embed("../res/test/reaction-0.8.0.cellar")]
val LEGACY_WORLD: [_]u8;
#[testing]
#[embed("../res/test/reaction-0.8.0.rlw")]
val LEGACY_RLW:   [_]u8;

test load__a_reaction_world_and_pattern_0_8_0_wrote_load_both_fields_exactly {
    var a: allo.Allocator;
    page.make(?a);
    var want: sim.Sim;
    var got:  sim.Sim;
    val m1:   err[allo.Error] = sim.init(?want, ?a);
    val m2:   err[allo.Error] = sim.init(?got, ?a);
    if (sel m1.err || sel m2.err)     { ret 1; }
    if (!seed_legacy_reaction(?want)) { ret 1; }
    if (sim.word_len(?want) != 2)     { ret 1; }

    # the world file, a version 5 file of one value a cell
    var data: Vector[u8]             = vector.init[u8](?a);
    val held: res[usize, allo.Error] = vector.reserve[u8](?data, $length_of(LEGACY_WORLD));
    if (sel held.err) { ret 2; }
    mem.copy[u8](data.data, ?LEGACY_WORLD[0], $length_of(LEGACY_WORLD));
    data.len = $length_of(LEGACY_WORLD);
    var v:      View;
    val loaded: res[Loaded, Error] = world_from(?a, ?got, ?v, ?data);
    vector.dnit[u8](?data);
    if (sel loaded.err)                                                              { ret 2; }
    if (!rule.same(?got.rule, ?want.rule) || got.generation != 20 || v.zoom != 4.0)  { ret 3; }
    if (sim.population(?got) != sim.population(?want) || sim.population(?want) == 0) { ret 3; }
    var w: [layer.LAYERS_MAX]u32;
    var g: [layer.LAYERS_MAX]u32;
    var y: i64 = -64;
    for (y < 128) {
        var x: i64 = -64;
        for (x < 128) {
            sim.word_at(?want, x, y, ?w[0]);
            sim.word_at(?got, x, y, ?g[0]);
            if (w[0] != g[0] || w[1] != g[1]) { ret 4; }
            x = x + 1;
        }
        y = y + 1;
    }

    # the pattern, a version 1 RLW file of one value a cell, read as words of
    # two, each cell's state from both
    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, ?a, 0, 0, "");
    if (sel made.err) { ret 5; }
    val read: err[Error] = pattern_from(?a, ?p, ?LEGACY_RLW[0], $length_of(LEGACY_RLW));
    if (sel read.err)                                    { ret 5; }
    if (!pattern.exact(?p) || p.values != 2 || p.w == 0) { ret 6; }
    var cells: usize = 0;
    y = 0;
    for (y < p.h::i64) {
        var x: i64 = 0;
        for (x < p.w::i64) {
            sim.word_at(?want, p.x + x, p.y + y, ?w[0]);
            val pw: *u32 = pattern.word(?p, x::usize, y::usize);
            if (pw[0] != w[0] || pw[1] != w[1])                                                 { ret 7; }
            if (pattern.get(?p, x::usize, y::usize)::u32 != rule.word_state(?want.rule, ?w[0])) { ret 8; }
            if (w[0] != 0 || w[1] != 0)                                                         { cells = cells + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    if (cells == 0) { ret 9; }
    pattern.dnit(?p);
    sim.dnit(?want);
    sim.dnit(?got);
    ret 0;
}
