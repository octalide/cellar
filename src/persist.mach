# text serialization of a world or a pattern to disk
#
# a world file is sparse. its first line is "cellar 4", then a header of
# "<key> <value>" lines ended by a blank line, then for every chunk holding a
# live cell a line "<cx> <cy>" with its signed chunk coordinates and 64 lines of
# 64 cells, each its state in as many decimal digits as the rule's highest
# state takes, so '1' live and '0' dead under a two-state rule. a reader skips
# header keys it does not know, so a newer file's fields do not stop an older
# cellar from reading its cells. the keys are family (the rule family's id),
# rule (the rule string, as the family writes it), states (how many states the
# cells hold, 2 when left out), generation, pan_x and pan_y (the view's
# centre), zoom and mode (the colour mode by name). a file naming no family
# names a weighted rule. a key a file leaves out keeps what the reader already
# had.
# a "cellar 3" file is read the same, its rule B/S notation and its kernel key
# the whole weighted kernel, preferred to the rule beside it. a "cellar 2" file
# is the same without the header, and a file in the custom pattern format, what
# every world was saved as before the world became unbounded, loads centred on
# the origin. patterns are saved and loaded through
# the format registry, see cellar.formats. saves create the file's directory
# first.

use gfx: boom.graphics;
use cellar.format;
use cellar.formats;
use cellar.formats.adapt;
use cellar.paths;
use cellar.pattern;
use cellar.render;
use cellar.rule;
use cellar.rules.weighted;
use cellar.sim;
use cellar.space;
use cellar.text;
use allo: std.allocator;
use std.allocator.page;
use alloc_testing: std.allocator.testing;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use mem:      std.memory;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# directory tests write their files under
#[testing]
val TEST_DIR: str = "out/test";

# permission bits for a created data directory
pub val DIR_MODE: i32 = 0o755;
# permission bits for saved files
pub val FILE_MODE: i32 = 0o644;
# bytes reserved for a chunk's header when sizing a buffer
val HEADER_MAX: usize = 32;
# the first line of a world file, less its version digit
val MAGIC: str = "cellar ";
# the version save_world writes
val VERSION: u8 = '4';
# the oldest sparse version load_world reads
val OLDEST: u8 = '2';
# bytes reserved for a world file's first line and header
val HEAD_MAX: usize = 2048;
# the longest header value read, less its NUL: the longest rule string
val VALUE_MAX: usize = rule.FORMAT_MAX;
# the most states a world file's cells may hold
val STATES_MAX: u32 = 256;
# the family a file that names none records its rule in
val LEGACY_FAMILY: str = "weighted";

# how a world is being viewed, which a world file keeps beside its cells
# ---
# pan_x: world column at the view's centre
# pan_y: world row at the view's centre
# zoom:  zoom multiplier, render.BASE_PPC pixels per cell at 1
# mode:  colour mode, a render.MODE_*
pub rec View {
    pan_x: f64;
    pan_y: f64;
    zoom:  f32;
    mode:  u8;
}

# what opening a file did
# ---
# world:   it was a world file, which replaced the world, rather than a pattern stamped onto it
# foreign: the file names a rule this cellar cannot run, so the rule was left as it was
# box:     the cells a stamped pattern covers, none for a world or an empty pattern
pub rec Opened {
    world:   bool;
    foreign: bool;
    box:     opt[space.Box];
}

# what a world load did beyond replacing the cells
# ---
# foreign: the file names a rule this cellar cannot run, so the rule was left
#          as it was and a state it lacks loaded as state 1
pub rec Loaded {
    foreign: bool;
}

# why a save or load did not complete
# ---
# alloc:      the allocator refused a buffer
# fs:         the file or its directory could not be read or written
# dimensions: the header declares a size of zero or beyond the limit
# truncated:  the body holds fewer cells than the header declares
# version:    a settings or world file written by another format version
# gpu:        the GPU's cells could not be read back
# format:     a pattern file the registry refused, see cellar.format.Error
pub tag Error: u8 {
    alloc: allo.Error;
    fs:    fs.FsError;
    dimensions;
    truncated;
    version;
    gpu;
    format: format.Error;
}

# a one-line description of a persistence failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun error_message(e: Error) str {
    if (sel e.alloc)      { ret "out of memory"; }
    if (sel e.dimensions) { ret "bad dimensions"; }
    if (sel e.truncated)  { ret "truncated body"; }
    if (sel e.version)    { ret "version mismatch"; }
    if (sel e.gpu)        { ret "GPU read failed"; }
    if (sel e.format)     { ret format.error_message(e.format); }
    if (sel e.fs) {
        if (sel e.fs.io) { ret io_error.kind_name(e.fs.io.kind); }
    }
    ret "file error";
}

# create the directory a file path lives in, when it names one
# ---
# a:    allocator for transient parent paths
# path: a file path
# ret:  ok, or why the directory does not exist
pub fun make_parent(a: *allo.Allocator, path: str) err[fs.FsError] {
    var cut: usize = 0;
    var i:   usize = 0;
    for (path[i] != 0) {
        if (path[i] == '/' || path[i] == '\\') { cut = i; }
        i = i + 1;
    }
    if (cut == 0 || cut >= 1100) { ret err[fs.FsError].ok{}; }
    var dir: [1100]u8;
    var k:   usize = 0;
    for (k < cut) {
        dir[k] = path[k];
        k      = k + 1;
    }
    dir[cut] = 0;
    ret fs.create_dir_all(a, ?dir[0], DIR_MODE);
}

# read a run of decimal digits at off into out
# ---
# b:   the file contents
# off: where the digits start
# out: receives the value
# ret: the offset just past the digits
fun parse_uint(b: *Vector[u8], off: usize, out: *usize) usize {
    var o: usize = off;
    var v: usize = 0;
    for (text.byte_at(b.data, b.len, o) >= '0' && text.byte_at(b.data, b.len, o) <= '9') {
        v = v * 10 + (b.data[o] - '0')::usize;
        o = o + 1;
    }
    @out = v;
    ret o;
}

# the decimal digits a cell takes in a file whose cells hold states states
fun digits(states: u32) usize {
    var n: usize = 1;
    var v: u32   = states - 1;
    for (v >= 10) {
        v = v / 10;
        n = n + 1;
    }
    ret n;
}

# read a chunk's cells, each its state in w digits, skipping line ends
#
# every cell is read before the caller changes anything, so a short body is
# refused while the world it was meant for is still untouched.
# ---
# b:      the file contents
# start:  where the cells start
# w:      digits a cell takes
# states: how many states a cell may hold
# out:    receives space.CELLS states
# end:    receives the offset past the last cell
# ret:    ok, truncated when the body runs out first, or malformed for a state
#         past the ones declared
fun parse_chunk(b: *Vector[u8], start: usize, w: usize, states: u32, out: *u8, end: *usize) err[Error] {
    var p: usize = start;
    var i: usize = 0;
    for (i < space.CELLS) {
        for (p < b.len && (b.data[p] < '0' || b.data[p] > '9')) { p = p + 1; }
        var v: u32   = 0;
        var d: usize = 0;
        for (d < w) {
            val c: u8 = text.byte_at(b.data, b.len, p);
            if (c < '0' || c > '9') { ret err[Error].err{Error.truncated{}}; }
            v = v * 10 + (c - '0')::u32;
            p = p + 1;
            d = d + 1;
        }
        if (v >= states) { ret err[Error].err{Error.format{format.Error.malformed{}}}; }
        out[i] = v::u8;
        i      = i + 1;
    }
    @end = p;
    ret err[Error].ok{};
}

# append a signed decimal to buf at off
fun buf_i64(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret text.buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret text.buf_u64(buf, off, v::u64);
}

# the name a colour mode is saved as
fun mode_name(m: u8) str {
    if (m == render.MODE_HEAT) { ret "heat"; }
    if (m == render.MODE_AGE)  { ret "age"; }
    ret "solid";
}

# the colour mode a saved name stands for, or none for a name this version does not know
fun mode_of(name: str) opt[u8] {
    if (string.str_equals(name, "solid")) { ret opt[u8].some{render.MODE_SOLID}; }
    if (string.str_equals(name, "heat"))  { ret opt[u8].some{render.MODE_HEAT}; }
    if (string.str_equals(name, "age"))   { ret opt[u8].some{render.MODE_AGE}; }
    ret opt[u8].none{};
}

# write the first line and the header of a world file into buf
# ---
# buf: at least HEAD_MAX bytes
# s:   simulation whose rule and generation are written
# v:   the view to keep with it
# ret: the offset just past the blank line that ends the header
fun write_header(buf: *u8, s: *sim.Sim, v: *View) usize {
    var off: usize = text.buf_str(buf, 0, MAGIC);
    buf[off] = VERSION;
    off      = off + 1;
    buf[off] = '\n';
    off      = off + 1;
    var rb: [1101]u8;
    off = text.buf_str(buf, off, "family ");
    off = text.buf_str(buf, off, rule.family_id(rule.family_of(?s.rule)));
    off = text.buf_str(buf, off, "\nrule ");
    off = text.buf_str(buf, off, rule.format(?s.rule, ?rb[0]));
    off = text.buf_str(buf, off, "\nstates ");
    off = text.buf_u64(buf, off, rule.states(?s.rule)::u64);
    off = text.buf_str(buf, off, "\ngeneration ");
    off = text.buf_u64(buf, off, s.generation);
    off = text.buf_str(buf, off, "\npan_x ");
    off = text.buf_f64(buf, off, v.pan_x);
    off = text.buf_str(buf, off, "\npan_y ");
    off = text.buf_f64(buf, off, v.pan_y);
    off = text.buf_str(buf, off, "\nzoom ");
    off = text.buf_f64(buf, off, v.zoom::f64);
    off = text.buf_str(buf, off, "\nmode ");
    off = text.buf_str(buf, off, mode_name(v.mode));
    ret text.buf_str(buf, off, "\n\n");
}

# serialize the world's chunks that hold a state, its rule, its generation and
# the view to path
#
# on the GPU the cells are read back first, a stall.
# ---
# a:    allocator backing the transient buffer
# s:    simulation whose world is saved
# v:    the view to keep with it
# path: destination file path
# ret:  ok, or why the file was not written
pub fun save_world(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str) err[Error] {
    val synced: err[gfx.Error] = sim.sync(s);
    if (sel synced.err) { ret err[Error].err{Error.gpu{}}; }
    val made: err[fs.FsError] = make_parent(a, path);
    if (sel made.err) { ret err[Error].err{Error.fs{made.err}}; }

    val sp:   *space.Space = ?s.space;
    val r:    *rule.Rule   = ?s.rule;
    val w:    usize        = digits(rule.states(r));
    var live: usize        = 0;
    var sl:   usize        = 0;
    for (sl < sp.hi) {
        if (sim.holds_state(s, sl)) { live = live + 1; }
        sl = sl + 1;
    }
    val cap: usize                = HEAD_MAX + live * (HEADER_MAX + 64 * (64 * w + 1));
    val rb:  res[*u8, allo.Error] = allo.allocate[u8](a, cap);
    if (sel rb.err) { ret err[Error].err{Error.alloc{rb.err}}; }
    val buf: *u8   = rb.ok;
    var off: usize = write_header(buf, s, v);
    sl = 0;
    for (sl < sp.hi) {
        if (sim.holds_state(s, sl)) {
            off      = buf_i64(buf, off, space.slot_x(sp, sl));
            buf[off] = ' ';
            off      = buf_i64(buf, off + 1, space.slot_y(sp, sl));
            buf[off] = '\n';
            off      = off + 1;
            val c: *u32  = ?sp.cells[sl * space.CELLS];
            var i: usize = 0;
            for (i < space.CELLS) {
                var v: u32   = rule.state(r, c[i]);
                var d: usize = w;
                for (d > 0) {
                    buf[off + d - 1] = '0' + (v % 10)::u8;
                    v                = v / 10;
                    d                = d - 1;
                }
                off = off + w;
                if (i % 64 == 63) {
                    buf[off] = '\n';
                    off      = off + 1;
                }
                i = i + 1;
            }
        }
        sl = sl + 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, buf, off, FILE_MODE);
    allo.deallocate[u8](a, buf, cap);
    if (sel wrote.err) { ret err[Error].err{Error.fs{wrote.err}}; }
    ret err[Error].ok{};
}

# read a signed decimal at off, skipping spaces before it
# ---
# b:   the file contents
# off: where to start
# out: receives the value
# ret: the offset past the digits, or the length when none were found
fun parse_i64(b: *Vector[u8], off: usize, out: *i64) usize {
    var o: usize = off;
    for (text.byte_at(b.data, b.len, o) == ' ') { o = o + 1; }
    var neg: bool = false;
    if (text.byte_at(b.data, b.len, o) == '-') {
        neg = true;
        o   = o + 1;
    }
    val c: u8 = text.byte_at(b.data, b.len, o);
    if (c < '0' || c > '9') { ret b.len; }
    var v: usize = 0;
    o    = parse_uint(b, o, ?v);
    @out = v::i64;
    if (neg) { @out = 0 - v::i64; }
    ret o;
}

# the offset just past the line starting at p, or the length when it is the last
fun next_line(b: *Vector[u8], p: usize) usize {
    var o: usize = p;
    for (o < b.len && b.data[o] != '\n') { o = o + 1; }
    if (o < b.len) { ret o + 1; }
    ret o;
}

# the version digit of a world file's first line, or 0 when the file is not one
fun world_version(b: *Vector[u8]) u8 {
    var i: usize = 0;
    for (MAGIC[i] != 0) {
        if (text.byte_at(b.data, b.len, i) != MAGIC[i]) { ret 0; }
        i = i + 1;
    }
    val v: u8 = text.byte_at(b.data, b.len, i);
    val e: u8 = text.byte_at(b.data, b.len, i + 1);
    if (v < '0' || v > '9' || (e != 0 && e != '\n' && e != '\r')) { ret 0; }
    ret v;
}

# what a world file's header says, each field only where the file names it
# ---
# family:     the family id it names, empty when it names none
# ruled:      the file names a rule
# rule:       the rule string it names
# shaped:     the file names a whole weighted kernel, as cellar 3 wrote one
# shape:      that kernel's structure
# states:     how many states its cells hold
# generation: the generation, 0 when the file names none
# view:       the view, starting as the reader's own
rec Head {
    family:     [32]u8;
    ruled:      bool;
    rule:       [1101]u8;
    shaped:     bool;
    shape:      [1101]u8;
    states:     u32;
    generation: u64;
    view:       View;
}

# the rule a header names, or none when it names none or one this version
# cannot run: the whole kernel of a cellar 3 file before its notation, and a
# rule of the family it names, or of the weighted family when it names none
fun head_rule(h: *Head) opt[rule.Rule] {
    var id: str = ?h.family[0];
    if (h.shaped || h.family[0] == 0) { id = LEGACY_FAMILY; }
    val f: opt[usize] = rule.family_named(id);
    if (sel f.none) { ret opt[rule.Rule].none{}; }
    var src: str = ?h.rule[0];
    if (h.shaped) { src = ?h.shape[0]; }
    val r: res[rule.Rule, str] = rule.parse_as(f.some, src);
    if (sel r.err) { ret opt[rule.Rule].none{}; }
    ret opt[rule.Rule].some{r.ok};
}

# whether a header names a rule this version cannot run
fun foreign(h: *Head) bool {
    if (!h.ruled && !h.shaped && h.family[0] == 0) { ret false; }
    val r: opt[rule.Rule] = head_rule(h);
    ret sel r.none;
}

# whether a float is neither infinite nor NaN
fun finite(v: f64) bool {
    ret v - v == 0.0;
}

# read a header value as a finite float
fun value_f64(v: str, out: *f64) bool {
    val r: res[f64, parse.ParseError] = parse.parse_f64_exact(v);
    if (sel r.err)     { ret false; }
    if (!finite(r.ok)) { ret false; }
    @out = r.ok;
    ret true;
}

# take one header field into h
# ---
# key: the field's key
# v:   its value, NUL-terminated
# h:   the header read so far
# ret: false when a key this version reads holds a value it cannot
fun field(key: str, v: str, h: *Head) bool {
    if (string.str_equals(key, "family")) {
        val n: usize = string.str_len(v);
        if (n > 31) { ret false; }
        mem.raw_copy(?h.family[0], v, n + 1);
        ret true;
    }
    if (string.str_equals(key, "rule")) {
        h.ruled = true;
        mem.raw_copy(?h.rule[0], v, string.str_len(v) + 1);
        ret true;
    }
    if (string.str_equals(key, "kernel")) {
        h.shaped = true;
        mem.raw_copy(?h.shape[0], v, string.str_len(v) + 1);
        ret true;
    }
    if (string.str_equals(key, "states")) {
        val r: res[u64, parse.ParseError] = parse.parse_u64_exact(v, 10);
        if (sel r.err)                          { ret false; }
        if (r.ok < 2 || r.ok > STATES_MAX::u64) { ret false; }
        h.states = r.ok::u32;
        ret true;
    }
    if (string.str_equals(key, "generation")) {
        val r: res[u64, parse.ParseError] = parse.parse_u64_exact(v, 10);
        if (sel r.err) { ret false; }
        h.generation = r.ok;
        ret true;
    }
    if (string.str_equals(key, "pan_x")) { ret value_f64(v, ?h.view.pan_x); }
    if (string.str_equals(key, "pan_y")) { ret value_f64(v, ?h.view.pan_y); }
    if (string.str_equals(key, "zoom")) {
        var z: f64 = 0.0;
        if (!value_f64(v, ?z) || z <= 0.0) { ret false; }
        h.view.zoom = z::f32;
        ret true;
    }
    if (string.str_equals(key, "mode")) {
        # a mode a later version adds is skipped like an unknown key
        val m: opt[u8] = mode_of(v);
        if (sel m.some) { h.view.mode = m.some; }
        ret true;
    }
    ret true;
}

# read a world file's header, from its first field to the blank line that ends it
#
# every field is a line "<key> <value>" whose key starts with a letter. a key
# this version does not know is skipped.
# ---
# b:   the file contents
# p:   the offset just past the first line
# out: receives the offset of the first chunk record
# h:   receives the fields the header names
# ret: ok, truncated when the header never ends, or malformed for a line that
#      is not a field or a field whose value cannot be read
fun read_header(b: *Vector[u8], p: usize, out: *usize, h: *Head) err[Error] {
    val bad: err[Error] = err[Error].err{Error.format{format.Error.malformed{}}};
    var o:   usize      = p;
    for (true) {
        if (o >= b.len) { ret err[Error].err{Error.truncated{}}; }
        var e: usize = o;
        for (e < b.len && (b.data[e] == ' ' || b.data[e] == '\t' || b.data[e] == '\r')) { e = e + 1; }
        if (e >= b.len || b.data[e] == '\n') {
            @out = next_line(b, o);
            ret err[Error].ok{};
        }
        val k: u8 = b.data[o] | 0x20;
        if (k < 'a' || k > 'z') { ret bad; }
        var key: [32]u8;
        var n:   usize = 0;
        e = o;
        for (e < b.len && b.data[e] != ' ' && b.data[e] != '\t' && b.data[e] != '\r' && b.data[e] != '\n') {
            if (n < 31) { key[n] = b.data[e]; }
            n = n + 1;
            e = e + 1;
        }
        # no key this version reads is that long
        if (n > 31) { n = 0; }
        key[n] = 0;
        for (e < b.len && (b.data[e] == ' ' || b.data[e] == '\t')) { e = e + 1; }
        var end: usize = e;
        for (end < b.len && b.data[end] != '\n') { end = end + 1; }
        for (end > e && (b.data[end - 1] == ' ' || b.data[end - 1] == '\t' || b.data[end - 1] == '\r')) { end = end - 1; }
        var value: [1101]u8;
        var len:   usize = end - e;
        # a value too long for any field this version reads is read as none at all
        if (len > VALUE_MAX) { len = 0; }
        mem.raw_copy(?value[0], ?b.data[e], len);
        value[len] = 0;
        if (n > 0 && !field(?key[0], ?value[0], h)) { ret bad; }
        o = next_line(b, o);
    }
    ret err[Error].ok{};
}

# the chunk records of a sparse world, as coordinates and states
# ---
# b:      the file contents
# start:  the offset of the first record
# states: how many states a cell may hold
# at:     receives each chunk's coordinates, two per chunk
# cells:  receives each chunk's space.CELLS states
# max:    the most chunks the pool can hold
# ret:    ok, or why the file was refused
fun parse_sparse(b: *Vector[u8], start: usize, states: u32, at: *Vector[i64], cells: *Vector[u8], max: usize) err[Error] {
    val w: usize = digits(states);
    var p: usize = start;
    for (true) {
        for (p < b.len && (b.data[p] == '\n' || b.data[p] == '\r' || b.data[p] == ' ')) { p = p + 1; }
        if (p >= b.len) { brk; }
        var cx: i64 = 0;
        var cy: i64 = 0;
        p = parse_i64(b, p, ?cx);
        if (p >= b.len) { ret err[Error].err{Error.truncated{}}; }
        p = parse_i64(b, p, ?cy);
        if (p >= b.len) { ret err[Error].err{Error.truncated{}}; }
        if (at.len / 2 >= max || cx < 0 - space.BIAS || cx >= space.BIAS
            || cy < 0 - space.BIAS || cy >= space.BIAS) { ret err[Error].err{Error.dimensions{}}; }
        vector.push[i64](at, cx);
        vector.push[i64](at, cy);
        val base: usize                  = cells.len;
        val grow: res[usize, allo.Error] = vector.reserve[u8](cells, space.CELLS);
        if (sel grow.err) { ret err[Error].err{Error.alloc{grow.err}}; }
        cells.len = base + space.CELLS;
        val parsed: err[Error] = parse_chunk(b, p, w, states, ?cells.data[base], ?p);
        if (sel parsed.err) { ret parsed; }
    }
    ret err[Error].ok{};
}

# the persistence failure a pattern format's refusal is reported as
fun from_format(e: format.Error) Error {
    if (sel e.alloc)     { ret Error.alloc{e.alloc}; }
    if (sel e.truncated) { ret Error.truncated{}; }
    if (sel e.range)     { ret Error.dimensions{}; }
    ret Error.format{e};
}

# read a pattern's bytes into p through the format registry
#
# the whole input is validated before p changes, so a refusal leaves p as it was.
# ---
# a:    allocator for the decoder's scratch
# f:    the format to read it as
# data: the bytes
# n:    how many
# p:    pattern to populate
# ret:  ok, or why the bytes were refused
fun read_pattern(a: *allo.Allocator, f: *format.Format, data: *u8, n: usize, p: *pattern.Pattern) err[Error] {
    var ps:   adapt.PatternSink;
    var info: format.Info;
    format.info_init(?info, a);
    val r: err[format.Error] = formats.load(a, f, data, n, adapt.pattern_sink(?ps, p), ?info);
    format.info_dnit(?info);
    if (sel r.err) { ret err[Error].err{from_format(r.err)}; }
    ret err[Error].ok{};
}

# read a pattern in any registered format from bytes, such as the clipboard's
#
# the format is detected from the bytes, and the whole input is validated first,
# so a refusal leaves p as it was. a pattern too large to hold is refused before
# anything is allocated for it.
# ---
# a:    allocator for the decoder's scratch
# p:    pattern to populate, keeping its name unless the bytes name one
# data: the bytes
# n:    how many
# ret:  ok, or why the bytes were refused; malformed when no format reads them
pub fun pattern_from(a: *allo.Allocator, p: *pattern.Pattern, data: *u8, n: usize) err[Error] {
    var f: format.Format;
    if (!formats.by_bytes(data, n, ?f)) { ret err[Error].err{Error.format{format.Error.malformed{}}}; }
    ret read_pattern(a, ?f, data, n, p);
}

# read path and replace the world with what it holds
#
# the whole file is parsed before the world or the view changes, so a refusal
# leaves both as they were. the file's rule replaces the simulation's when its
# family reads it, and is otherwise left for the caller to report. the
# generation is the file's, or 0 when it names none.
# ---
# a:    allocator for the read and parse buffers
# s:    simulation to populate
# v:    the view, taking the fields the file names and keeping the rest
# path: source file path
# ret:  what the load did beyond the cells, or why the world was not loaded
pub fun load_world(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str) res[Loaded, Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret res[Loaded, Error].err{Error.fs{rr.err}}; }
    var data: Vector[u8]         = rr.ok;
    val r:    res[Loaded, Error] = world_from(a, s, v, ?data);
    vector.dnit[u8](?data);
    ret r;
}

# replace the world with what a world file's bytes hold, as load_world does
fun world_from(a: *allo.Allocator, s: *sim.Sim, v: *View, data: *Vector[u8]) res[Loaded, Error] {
    val ver: u8 = world_version(data);
    if (ver != 0) {
        var start: usize = next_line(data, 0);
        if (ver < OLDEST || ver > VERSION) { ret res[Loaded, Error].err{Error.version{}}; }
        var h: Head;
        h.family[0]  = 0;
        h.ruled      = false;
        h.rule[0]    = 0;
        h.shaped     = false;
        h.shape[0]   = 0;
        h.states     = 2;
        h.generation = 0;
        h.view       = @v;
        if (ver >= '3') {
            val head: err[Error] = read_header(data, start, ?start, ?h);
            if (sel head.err) { ret res[Loaded, Error].err{head.err}; }
        }
        var at:     Vector[i64] = vector.init[i64](a);
        var cells:  Vector[u8]  = vector.init[u8](a);
        val parsed: err[Error]  = parse_sparse(data, start, h.states, ?at, ?cells, s.space.max_slots);
        if (sel parsed.ok) {
            # the rule first, so the cells are written as its words
            val named: opt[rule.Rule] = head_rule(?h);
            if (sel named.some) { sim.set_rule(s, named.some); }
            val have: u32 = rule.states(?s.rule);
            sim.fill_begin(s);
            var k: usize = 0;
            for (k < at.len / 2) {
                val ox: i64   = at.data[k * 2] * space.SIDE;
                val oy: i64   = at.data[k * 2 + 1] * space.SIDE;
                var i:  usize = 0;
                for (i < space.CELLS) {
                    var st: u32 = cells.data[k * space.CELLS + i]::u32;
                    if (st >= have) { st = 1; }
                    if (st != 0)    { sim.fill_cell(s, ox + (i % 64)::i64, oy + (i / 64)::i64, st); }
                    i = i + 1;
                }
                k = k + 1;
            }
            sim.fill_end(s);
            s.generation = h.generation;
            @v           = h.view;
        }
        vector.dnit[i64](?at);
        vector.dnit[u8](?cells);
        if (sel parsed.err) { ret res[Loaded, Error].err{parsed.err}; }
        ret res[Loaded, Error].ok{Loaded{foreign: foreign(?h)}};
    }

    # an old dense world is a custom pattern, centred on the origin
    var old: format.Format;
    if (!formats.by_id("custom", ?old)) { ret res[Loaded, Error].err{Error.format{format.Error.unsupported{}}}; }
    var tmp:  pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?tmp, a, 0, 0, "");
    if (sel made.err) { ret res[Loaded, Error].err{Error.alloc{made.err}}; }
    val read: err[Error] = read_pattern(a, ?old, data.data, data.len, ?tmp);
    if (sel read.err) {
        pattern.dnit(?tmp);
        ret res[Loaded, Error].err{read.err};
    }
    val ox: i64 = 0 - (tmp.w / 2)::i64;
    val oy: i64 = 0 - (tmp.h / 2)::i64;
    sim.fill_begin(s);
    var y: usize = 0;
    for (y < tmp.h) {
        var x: usize = 0;
        for (x < tmp.w) {
            if (pattern.get(?tmp, x, y) != 0) { sim.fill_cell(s, ox + x::i64, oy + y::i64, 1); }
            x = x + 1;
        }
        y = y + 1;
    }
    sim.fill_end(s);
    pattern.dnit(?tmp);
    ret res[Loaded, Error].ok{Loaded{foreign: false}};
}

# stamp a pattern file's bytes onto the world centred on the origin, in the
# format the registry detects, taking its rule when a rule family reads it
fun stamp_from(a: *allo.Allocator, s: *sim.Sim, data: *Vector[u8]) res[Opened, Error] {
    var f: format.Format;
    if (!formats.by_bytes(data.data, data.len, ?f)) { ret res[Opened, Error].err{Error.format{format.Error.malformed{}}}; }
    var ws:   adapt.WorldSink;
    var info: format.Info;
    format.info_init(?info, a);
    val r:       err[format.Error] = formats.load(a, ?f, data.data, data.len, adapt.centred_sink(?ws, s), ?info);
    var foreign: bool              = false;
    var box:     opt[space.Box]    = opt[space.Box].none{};
    if (sel r.ok && info.bounded) {
        box = opt[space.Box].some{space.Box{x0: info.x0 + ws.dx, y0: info.y0 + ws.dy, x1: info.x1 + ws.dx, y1: info.y1 + ws.dy}};
    }
    if (sel r.ok) {
        val named: str = format.text_of(?info.rule);
        if (named[0] != 0) {
            val k: res[rule.Rule, str] = rule.parse(named);
            if (sel k.ok) { sim.set_rule(s, k.ok); }
            or            { foreign = true; }
        }
    }
    format.info_dnit(?info);
    if (sel r.err) { ret res[Opened, Error].err{from_format(r.err)}; }
    ret res[Opened, Error].ok{Opened{world: false, foreign: foreign, box: box}};
}

# open a file of any kind cellar reads, dispatching on its bytes
#
# a world file (its first line "cellar <version>") replaces the world and the
# view, as load_world does. anything else is read as a pattern in the format the
# registry detects and stamped onto the world centred on the origin, its rule
# replacing the simulation's when a rule family reads it. the whole file is
# validated first, so a refusal leaves the world, the rule and the view as they
# were.
# ---
# a:    allocator for the read and parse buffers
# s:    simulation to load into
# v:    the view, which a world file replaces
# path: source file path
# ret:  what the file was and did, or why nothing was loaded
pub fun open_file(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str) res[Opened, Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret res[Opened, Error].err{Error.fs{rr.err}}; }
    var data: Vector[u8]         = rr.ok;
    val r:    res[Opened, Error] = open_bytes(a, s, v, ?data);
    vector.dnit[u8](?data);
    ret r;
}

# open a file's bytes as open_file does, which is how every caller that opens
# a file into the world reads it alike
# ---
# a:    allocator for the parse buffers
# s:    simulation to load into
# v:    the view, which a world file replaces
# data: the file's bytes
# ret:  what the file was and did, or why nothing was loaded
pub fun open_bytes(a: *allo.Allocator, s: *sim.Sim, v: *View, data: *Vector[u8]) res[Opened, Error] {
    if (world_version(data) != 0) { ret opened_world(world_from(a, s, v, data)); }
    ret stamp_from(a, s, data);
}

# a world load's outcome as an open's
fun opened_world(w: res[Loaded, Error]) res[Opened, Error] {
    if (sel w.err) { ret res[Opened, Error].err{w.err}; }
    ret res[Opened, Error].ok{Opened{world: true, foreign: w.ok.foreign, box: opt[space.Box].none{}}};
}

# copy a pattern's name, rule and comments into an Info
fun describe(a: *allo.Allocator, p: *pattern.Pattern, info: *format.Info) err[allo.Error] {
    val n: err[allo.Error] = format.set_str(a, ?info.name, pattern.name(p));
    if (sel n.err) { ret n; }
    val r: err[allo.Error] = format.set_str(a, ?info.rule, pattern.rule(p));
    if (sel r.err) { ret r; }
    ret format.set_str(a, ?info.comments, pattern.comments(p));
}

# encode a pattern, with its name, rule and comments where the format keeps them
# ---
# a:   allocator for the encoder's scratch
# f:   the format to write
# p:   pattern to encode, placed at its own x and y
# out: receives the bytes, appended
# ret: ok, or why the pattern could not be encoded
pub fun encode_pattern(a: *allo.Allocator, f: *format.Format, p: *pattern.Pattern, out: *Vector[u8]) err[Error] {
    var info: format.Info;
    format.info_init(?info, a);
    val told: err[allo.Error] = describe(a, p, ?info);
    if (sel told.err) {
        format.info_dnit(?info);
        ret err[Error].err{Error.alloc{told.err}};
    }
    var src: adapt.PatternSource;
    val enc: err[format.Error] = formats.save(a, f, adapt.pattern_source(?src, p), ?info, out);
    format.info_dnit(?info);
    if (sel enc.err) { ret err[Error].err{from_format(enc.err)}; }
    ret err[Error].ok{};
}

# serialize a pattern to path in the format its extension names
# ---
# a:    allocator backing the transient buffer
# p:    pattern to save, with its name, rule and comments where the format keeps them
# path: destination file path
# ret:  ok, or why the file was not written; unsupported when no format that
#       writes owns the extension
pub fun save_pattern(a: *allo.Allocator, p: *pattern.Pattern, path: str) err[Error] {
    var f: format.Format;
    if (!formats.by_path(path, ?f)) { ret err[Error].err{Error.format{format.Error.unsupported{}}}; }
    var out: Vector[u8] = vector.init[u8](a);
    val enc: err[Error] = encode_pattern(a, ?f, p, ?out);
    if (sel enc.err) {
        vector.dnit[u8](?out);
        ret enc;
    }
    val made: err[fs.FsError] = make_parent(a, path);
    if (sel made.err) {
        vector.dnit[u8](?out);
        ret err[Error].err{Error.fs{made.err}};
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, out.data, out.len, FILE_MODE);
    vector.dnit[u8](?out);
    if (sel wrote.err) { ret err[Error].err{Error.fs{wrote.err}}; }
    ret err[Error].ok{};
}

# whether a file is there, taking a failed look as no
fun present(path: str) bool {
    val r: res[bool, io_error.Error] = fs.is_file(path);
    ret sel r.ok && r.ok;
}

# load a pattern from one file into p and save it to another
fun copy_pattern(a: *allo.Allocator, p: *pattern.Pattern, from: str, to: str) err[Error] {
    val r: err[Error] = load_pattern(a, p, from);
    if (sel r.err) { ret r; }
    ret save_pattern(a, p, to);
}

# bring the custom pattern kept as legacy over to path, in the format path names
fun convert(a: *allo.Allocator, legacy: str, path: str) err[Error] {
    var tmp:  pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?tmp, a, 0, 0, "");
    if (sel made.err) { ret err[Error].err{Error.alloc{made.err}}; }
    val r: err[Error] = copy_pattern(a, ?tmp, legacy, path);
    pattern.dnit(?tmp);
    if (sel r.err) { ret r; }
    val gone: err[io_error.Error] = fs.remove_file(legacy);
    if (sel gone.err) { ret err[Error].err{Error.fs{fs.FsError.io{gone.err}}}; }
    ret err[Error].ok{};
}

# move the world and custom pattern files 0.3.0 and earlier saved as .cells to
# their current names, paths.WORLD and paths.CUSTOM
#
# LifeWiki's plaintext owns .cells, so the old names would read as plaintext. a
# world keeps its bytes, since load_world reads every older world file, and is
# renamed. the custom pattern was cellar's own 0/1 text, so it is read and
# written again in the format paths.CUSTOM names, and the old file is removed
# only once the new one is written. nothing is moved over a file already at its
# new name.
# ---
# a:   allocator for the conversion
# p:   the resolved data directory
# ret: ok, or why a file could not be brought across, when it is left where it was
pub fun migrate(a: *allo.Allocator, p: *paths.Paths) err[Error] {
    if (!p.ok) { ret err[Error].ok{}; }
    var from: [1088]u8;
    var to:   [1088]u8;
    paths.file(p, paths.LEGACY_WORLD, ?from[0]);
    paths.file(p, paths.WORLD, ?to[0]);
    if (present(?from[0]) && !present(?to[0])) {
        val moved: err[io_error.Error] = fs.rename(?from[0], ?to[0]);
        if (sel moved.err) { ret err[Error].err{Error.fs{fs.FsError.io{moved.err}}}; }
    }
    paths.file(p, paths.LEGACY_CUSTOM, ?from[0]);
    paths.file(p, paths.CUSTOM, ?to[0]);
    if (present(?from[0]) && !present(?to[0])) { ret convert(a, ?from[0], ?to[0]); }
    ret err[Error].ok{};
}

# read path into a pattern, resizing it to what the file holds
#
# the format is detected from the bytes, so a file in any registered format
# loads, and the whole file is validated first, so a refusal leaves p as it was.
# ---
# a:    allocator for the read and parse buffers
# p:    pattern to populate, keeping its name unless the file names one
# path: source file path
# ret:  ok, or why the pattern was not loaded
pub fun load_pattern(a: *allo.Allocator, p: *pattern.Pattern, path: str) err[Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret err[Error].err{Error.fs{rr.err}}; }
    var data: Vector[u8] = rr.ok;
    val r:    err[Error] = pattern_from(a, p, data.data, data.len);
    vector.dnit[u8](?data);
    ret r;
}

# a live 2x2 block with its corner at (x, y), still under Life and HighLife alike
#[testing]
fun block(s: *sim.Sim, x: i64, y: i64) {
    sim.paint(s, x, y, 1);
    sim.paint(s, x + 1, y, 1);
    sim.paint(s, x, y + 1, 1);
    sim.paint(s, x + 1, y + 1, 1);
}

test load_world__round_trips_a_highlife_world_its_generation_and_view {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.set_rule(?s, rule.preset_rule(1));
    block(?s, 0, 0);
    block(?s, 100000, -70000);
    var i: usize = 0;
    for (i < 4) {
        sim.step(?s);
        i = i + 1;
    }
    # two rows of three give the cell between them six neighbours, born under
    # HighLife's B6 and not under Life
    var x: i64 = 49;
    for (x < 52) {
        sim.paint(?s, x, 49, 1);
        sim.paint(?s, x, 51, 1);
        x = x + 1;
    }
    var v: View = View{pan_x: -12345.678901234567, pan_y: 0.1, zoom: 2.5, mode: render.MODE_HEAT};

    val path:  str        = "out/test/test_world.cellar";
    val saved: err[Error] = save_world(?a, ?s, ?v, path);
    if (sel saved.err) { ret 2; }

    # loaded while Life is active, into another view
    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 3; }
    sim.paint(?t, 7, 7, 1);
    var w:      View               = View{pan_x: 3.0, pan_y: 4.0, zoom: 1.0, mode: render.MODE_SOLID};
    val loaded: res[Loaded, Error] = load_world(?a, ?t, ?w, path);
    fs.remove_file(path);
    if (sel loaded.err)    { ret 4; }
    if (loaded.ok.foreign) { ret 4; }

    if (sim.population(?t) != 14)                                     { ret 5; }
    if (!sim.alive(?t, 0, 0) || !sim.alive(?t, 100001, -69999))       { ret 6; }
    if (sim.alive(?t, 7, 7))                                          { ret 7; }
    if (!rule.same(?t.rule, ?s.rule) || t.generation != 4)            { ret 8; }
    if (w.pan_x != v.pan_x || w.pan_y != v.pan_y || w.zoom != v.zoom) { ret 9; }
    if (w.mode != render.MODE_HEAT)                                   { ret 10; }

    # it runs as HighLife from the saved generation
    sim.step(?t);
    if (t.generation != 5 || !sim.alive(?t, 50, 50)) { ret 11; }

    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

test load_world__round_trips_a_wide_weighted_kernel {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var k: weighted.Kernel = weighted.life();
    weighted.set_radius(?k, 2);
    weighted.set_weight(?k, -2, 0, -4);
    weighted.set_weight(?k, 1, 2, 3);
    k.birth = weighted.set_bit(k.birth, 11);
    sim.set_rule(?s, rule.Rule.weighted{k});
    block(?s, 0, 0);
    var v: View = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: render.MODE_SOLID};

    val path:  str        = "out/test/test_weighted.cellar";
    val saved: err[Error] = save_world(?a, ?s, ?v, path);
    if (sel saved.err) { ret 2; }
    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 3; }
    val loaded: res[Loaded, Error] = load_world(?a, ?t, ?v, path);
    fs.remove_file(path);
    if (sel loaded.err)                                 { ret 4; }
    if (loaded.ok.foreign || rule.radius(?t.rule) != 2) { ret 5; }
    if (!rule.same(?t.rule, ?s.rule))                   { ret 6; }
    if (sim.population(?t) != 4)                        { ret 7; }
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

test load_world__round_trips_a_generations_world_and_its_dying_cells {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.set_rule(?s, rule.preset_rule(4));
    block(?s, 0, 0);
    # a lone cell starts dying, leaving its chunk with no live cell at all
    sim.paint(?s, 1000, 1000, 1);
    # and one beside the block dies outside the live cells' box
    sim.paint(?s, 20, 20, 1);
    sim.step(?s);
    var v: View = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: render.MODE_HEAT};

    val path:  str        = "out/test/test_generations.cellar";
    val saved: err[Error] = save_world(?a, ?s, ?v, path);
    if (sel saved.err) { ret 2; }
    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 3; }
    val loaded: res[Loaded, Error] = load_world(?a, ?t, ?v, path);
    fs.remove_file(path);
    if (sel loaded.err)                                     { ret 4; }
    if (loaded.ok.foreign || !rule.same(?t.rule, ?s.rule))  { ret 5; }
    if (rule.state(?t.rule, sim.cell(?t, 1000, 1000)) != 2) { ret 6; }
    if (rule.state(?t.rule, sim.cell(?t, 20, 20)) != 2)     { ret 6; }
    var y: i64 = -2;
    for (y < 4) {
        var x: i64 = -2;
        for (x < 4) {
            if (sim.cell(?t, x, y) != sim.cell(?s, x, y)) { ret 7; }
            x = x + 1;
        }
        y = y + 1;
    }
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

test load_world__loads_an_old_dense_file_centred {
    var a: allo.Allocator;
    page.make(?a);

    # a 4 x 2 world from before the world was unbounded
    var body: [14]u8          = [14]u8{'4', ' ', '2', '\n', '1', '0', '0', '0', '\n', '0', '0', '0', '1', '\n'};
    val path: str             = "out/test/test_old.cellar";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 1; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 14, FILE_MODE);
    if (sel wrote.err) { ret 2; }

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 3; }
    var v:      View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val loaded: res[Loaded, Error] = load_world(?a, ?s, ?v, path);
    fs.remove_file(path);
    if (sel loaded.err)                                 { ret 4; }
    if (sim.population(?s) != 2)                        { ret 5; }
    if (!sim.alive(?s, -2, -1) || !sim.alive(?s, 1, 0)) { ret 6; }
    sim.dnit(?s);
    ret 0;
}

test load_pattern__round_trips {
    var a: allo.Allocator;
    page.make(?a);

    var p:     pattern.Pattern;
    val made5: err[allo.Error] = pattern.init(?p, ?a, 5, 3, "custom");
    if (sel made5.err) { ret 1; }
    pattern.set(?p, 0, 0, 1);
    pattern.set(?p, 4, 2, 1);
    pattern.set(?p, 2, 1, 1);

    val path:   str        = "out/test/test_pattern.rle";
    val saved4: err[Error] = save_pattern(?a, ?p, path);
    if (sel saved4.err) { ret 1; }

    var q:     pattern.Pattern;
    val made6: err[allo.Error] = pattern.init(?q, ?a, 1, 1, "custom");
    if (sel made6.err) { ret 1; }
    val loaded4: err[Error] = load_pattern(?a, ?q, path);
    if (sel loaded4.err) { ret 2; }

    if (q.w != 5 || q.h != 3) { ret 3; }
    var y: usize = 0;
    for (y < 3) {
        var x: usize = 0;
        for (x < 5) {
            if (pattern.get(?q, x, y) != pattern.get(?p, x, y)) { ret 4; }
            x = x + 1;
        }
        y = y + 1;
    }

    pattern.dnit(?p);
    pattern.dnit(?q);
    fs.remove_file(path);
    ret 0;
}

test load_pattern__reads_by_length_past_an_embedded_nul {
    var t:    alloc_testing.Testing;
    val made: err[allo.Error] = alloc_testing.make(?t);
    if (sel made.err) { ret 1; }
    val a: *allo.Allocator = alloc_testing.allocator_of(?t);

    # a NUL inside the body ended the old NUL-terminated read early
    var body: [9]u8           = [9]u8{'3', ' ', '1', '\n', '1', 0, '0', '1', '\n'};
    val path: str             = "out/test/test_nul.pattern";
    val dir:  err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    var p:     pattern.Pattern;
    val made7: err[allo.Error] = pattern.init(?p, a, 1, 1, "custom");
    if (sel made7.err) { ret 1; }
    val loaded: err[Error] = load_pattern(a, ?p, path);
    fs.remove_file(path);
    if (sel loaded.err)                                                                                     { ret 4; }
    if (p.w != 3 || pattern.get(?p, 0, 0) != 1 || pattern.get(?p, 1, 0) != 0 || pattern.get(?p, 2, 0) != 1) { ret 5; }
    pattern.dnit(?p);
    if (alloc_testing.leaked(?t)) { ret 6; }
    alloc_testing.dnit(?t);
    ret 0;
}

test load_world__short_body_leaves_the_world_intact {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.paint(?s, 2, 2, 1);

    # declares 3x3 but carries four cells
    var body: [9]u8           = [9]u8{'3', ' ', '3', '\n', '1', '1', '0', '1', '\n'};
    val path: str             = "out/test/test_short.cellar";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    var v:      View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val loaded: res[Loaded, Error] = load_world(?a, ?s, ?v, path);
    fs.remove_file(path);
    if (!sel loaded.err)           { ret 4; }
    if (!sel loaded.err.truncated) { ret 5; }
    if (sim.population(?s) != 1)   { ret 6; }
    if (!sim.alive(?s, 2, 2))      { ret 7; }
    sim.dnit(?s);
    ret 0;
}

test load_pattern__loads_an_rle_file_and_refuses_unknown_text {
    var a: allo.Allocator;
    page.make(?a);

    val dir: err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 1; }
    val path:  str             = "out/test/test_rle.pattern";
    val rle:   str             = "x = 3, y = 3, rule = B3/S23\nbob$2bo$3o!\n";
    val wrote: err[fs.FsError] = fs.write_bytes(path, rle::*u8, 40, FILE_MODE);
    if (sel wrote.err) { ret 2; }

    var p:    pattern.Pattern;
    val made: err[allo.Error] = pattern.init(?p, ?a, 1, 1, "custom");
    if (sel made.err) { ret 3; }
    val loaded: err[Error] = load_pattern(?a, ?p, path);
    if (sel loaded.err)                                                                   { ret 4; }
    if (p.w != 3 || p.h != 3 || pattern.get(?p, 1, 0) != 1 || pattern.get(?p, 0, 0) != 0) { ret 5; }

    # text no format recognises is refused, leaving the pattern as it was
    val junk: str             = "hello";
    val w2:   err[fs.FsError] = fs.write_bytes(path, junk::*u8, 5, FILE_MODE);
    if (sel w2.err) { ret 6; }
    val bad: err[Error] = load_pattern(?a, ?p, path);
    fs.remove_file(path);
    if (!sel bad.err || p.w != 3) { ret 7; }
    pattern.dnit(?p);
    ret 0;
}

# write bytes to a test file
#[testing]
fun put_file(a: *allo.Allocator, path: str, body: str) bool {
    val dir: err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret false; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, body::*u8, string.str_len(body), FILE_MODE);
    ret !(sel wrote.err);
}

# a chunk record at (cx, cy) whose first row starts with the given cells
#[testing]
fun chunk_text(out: *Vector[u8], rec_line: str, first: str) {
    var i: usize = 0;
    for (rec_line[i] != 0) {
        vector.push[u8](out, rec_line[i]);
        i = i + 1;
    }
    var k: usize = 0;
    for (k < space.CELLS) {
        var c: u8 = '0';
        if (k < string.str_len(first)) { c = first[k]; }
        vector.push[u8](out, c);
        if (k % 64 == 63) { vector.push[u8](out, '\n'); }
        k = k + 1;
    }
}

# load a world file of a header and one chunk at (-1, 2) whose first row starts "101"
#[testing]
fun load_versioned(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str, head: str) res[Loaded, Error] {
    ret load_cells(a, s, v, path, head, "101");
}

# load a world file of a header and one chunk at (-1, 2) whose first row starts with first
#[testing]
fun load_cells(a: *allo.Allocator, s: *sim.Sim, v: *View, path: str, head: str, first: str) res[Loaded, Error] {
    var body: Vector[u8] = vector.init[u8](a);
    var i:    usize      = 0;
    for (head[i] != 0) {
        vector.push[u8](?body, head[i]);
        i = i + 1;
    }
    chunk_text(?body, "-1 2\n", first);
    vector.push[u8](?body, 0);
    val dir: err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret res[Loaded, Error].err{Error.fs{dir.err}}; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, body.data, body.len - 1, FILE_MODE);
    vector.dnit[u8](?body);
    if (sel wrote.err) { ret res[Loaded, Error].err{Error.fs{wrote.err}}; }
    val r: res[Loaded, Error] = load_world(a, s, v, path);
    fs.remove_file(path);
    ret r;
}

test load_world__reads_cellar_2_and_every_cellar_3_header {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var v:  View      = View{pan_x: 1.5, pan_y: -2.5, zoom: 3.0, mode: render.MODE_AGE};
    var lf: rule.Rule = rule.preset_rule(0);
    var hl: rule.Rule = rule.preset_rule(1);

    # a 0.3.0 world
    val two: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v2.cellar", "cellar 2\n");
    if (sel two.err)                                         { ret 2; }
    if (sim.population(?s) != 2 || !sim.alive(?s, -64, 128)) { ret 3; }
    if (!sim.alive(?s, -62, 128) || sim.alive(?s, -63, 128)) { ret 4; }

    # a header with no keys loads the cells and leaves the rule and view alone
    s.generation = 9;
    val bare: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_bare.cellar", "cellar 3\n\n");
    if (sel bare.err)                                                           { ret 5; }
    if (bare.ok.foreign || sim.population(?s) != 2 || s.generation != 0)        { ret 5; }
    if (!rule.same(?s.rule, ?lf) || v.zoom != 3.0 || v.mode != render.MODE_AGE) { ret 5; }

    # keys are read in any case of line ending, and keys a later version adds are skipped
    val three: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3.cellar", "cellar 3\r\nrule b36/s23\r\ngeneration 12\nlater stuff\nmode glow\npan_y 7.25\n\r\n");
    if (sel three.err)                                                  { ret 6; }
    if (three.ok.foreign || !sim.alive(?s, -64, 128))                   { ret 6; }
    if (!rule.same(?s.rule, ?hl) || s.generation != 12)                 { ret 6; }
    if (v.pan_y != 7.25 || v.pan_x != 1.5 || v.mode != render.MODE_AGE) { ret 6; }

    # a rule cellar cannot run loads the world with the rule as it was
    val odd: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_odd.cellar", "cellar 3\nrule B3/S23:T20,30\ngeneration 3\n\n");
    if (sel odd.err)                                                      { ret 7; }
    if (!odd.ok.foreign || !rule.same(?s.rule, ?hl) || s.generation != 3) { ret 7; }

    # a whole kernel is preferred to the notation beside it, and one this
    # version cannot run is foreign even beside a rule it can
    val both: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_both.cellar", "cellar 3\nrule B3/S23\nkernel 1 64 12 1 1 1 1 0 1 1 1 1\n\n");
    if (sel both.err)                            { ret 12; }
    if (both.ok.foreign || !sel s.rule.weighted) { ret 12; }
    if (sel s.rule.weighted) {
        if (s.rule.weighted.birth != 64 || s.rule.weighted.survive != 12) { ret 12; }
    }
    val wide: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_wide.cellar", "cellar 3\nrule B3/S23\nkernel 9 8 12 1\n\n");
    if (sel wide.err)                             { ret 13; }
    if (!wide.ok.foreign || !sel s.rule.weighted) { ret 13; }
    if (sel s.rule.weighted) {
        if (s.rule.weighted.birth != 64) { ret 13; }
    }

    # a version from the future, a header that never ends, and a value that
    # cannot be read, are refused untouched
    val five: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v5.cellar", "cellar 5\n\n");
    if (!sel five.err)         { ret 8; }
    if (!sel five.err.version) { ret 8; }
    val open: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_open.cellar", "cellar 3\nrule B3/S23\n");
    if (!sel open.err) { ret 9; }
    val nan: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v3_nan.cellar", "cellar 3\nzoom nan\n\n");
    if (!sel nan.err)                                 { ret 10; }
    if (sim.population(?s) != 2 || s.generation != 0) { ret 11; }
    sim.dnit(?s);
    ret 0;
}

test migrate__moves_0_3_0_saves_off_cells {
    var a: allo.Allocator;
    page.make(?a);
    var p: paths.Paths;
    p.ok                                                  = true;
    p.dir[text.buf_str(?p.dir[0], 0, "out/test/migrate")] = 0;
    val dir: err[fs.FsError] = fs.create_dir_all(?a, paths.dir(?p), DIR_MODE);
    if (sel dir.err) { ret 1; }
    var ow: [1088]u8;
    var oc: [1088]u8;
    var nw: [1088]u8;
    var nc: [1088]u8;
    paths.file(?p, paths.LEGACY_WORLD, ?ow[0]);
    paths.file(?p, paths.LEGACY_CUSTOM, ?oc[0]);
    paths.file(?p, paths.WORLD, ?nw[0]);
    paths.file(?p, paths.CUSTOM, ?nc[0]);
    fs.remove_file(?nw[0]);
    fs.remove_file(?nc[0]);
    if (!put_file(?a, ?ow[0], "2 1\n11\n"))       { ret 2; }
    if (!put_file(?a, ?oc[0], "3 2\n010\n001\n")) { ret 3; }

    val moved: err[Error] = migrate(?a, ?p);
    if (sel moved.err)                      { ret 4; }
    if (present(?ow[0]) || present(?oc[0])) { ret 5; }

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 6; }
    var v:     View               = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: 0};
    val world: res[Loaded, Error] = load_world(?a, ?s, ?v, ?nw[0]);
    if (sel world.err)           { ret 7; }
    if (sim.population(?s) != 2) { ret 7; }

    var q:     pattern.Pattern;
    val made2: err[allo.Error] = pattern.init(?q, ?a, 1, 1, "custom");
    if (sel made2.err) { ret 8; }
    var f:  format.Format;
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, ?nc[0]);
    if (sel rr.err) { ret 9; }
    var data: Vector[u8] = rr.ok;
    if (!formats.by_bytes(data.data, data.len, ?f) || !string.str_equals(f.id, "rle")) { ret 10; }
    vector.dnit[u8](?data);
    val custom: err[Error] = load_pattern(?a, ?q, ?nc[0]);
    if (sel custom.err)                                                                         { ret 11; }
    if (q.w != 3 || q.h != 2)                                                                   { ret 11; }
    if (pattern.get(?q, 1, 0) != 1 || pattern.get(?q, 2, 1) != 1 || pattern.get(?q, 0, 0) != 0) { ret 12; }
    if (!string.str_equals(pattern.name(?q), "custom"))                                         { ret 13; }

    # a second run finds nothing left to move
    val again: err[Error] = migrate(?a, ?p);
    if (sel again.err) { ret 14; }
    fs.remove_file(?nw[0]);
    fs.remove_file(?nc[0]);
    pattern.dnit(?q);
    sim.dnit(?s);
    ret 0;
}

test load_world__reads_a_cellar_4_rule_by_its_family {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var v:  View      = View{pan_x: 0.0, pan_y: 0.0, zoom: 1.0, mode: render.MODE_SOLID};
    var hl: rule.Rule = rule.preset_rule(1);

    val four: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v4.cellar", "cellar 4\nrule B36/S23\nfamily weighted\nstates 2\n\n");
    if (sel four.err)                                         { ret 2; }
    if (four.ok.foreign || !rule.same(?s.rule, ?hl))          { ret 3; }
    if (!sim.alive(?s, -64, 128) || !sim.alive(?s, -62, 128)) { ret 4; }

    # a family this version does not run is foreign, and a state the rule
    # lacks loads live
    val later: res[Loaded, Error] = load_cells(?a, ?s, ?v, "out/test/test_v4_later.cellar", "cellar 4\nfamily lenia\nrule R13\nstates 3\n\n", "102");
    if (sel later.err)                                       { ret 5; }
    if (!later.ok.foreign || !rule.same(?s.rule, ?hl))       { ret 6; }
    if (sim.population(?s) != 2 || !sim.alive(?s, -62, 128)) { ret 7; }

    # a state past the ones declared is refused
    val bad: res[Loaded, Error] = load_cells(?a, ?s, ?v, "out/test/test_v4_bad.cellar", "cellar 4\nstates 2\n\n", "102");
    if (!sel bad.err) { ret 8; }
    val big: res[Loaded, Error] = load_versioned(?a, ?s, ?v, "out/test/test_v4_big.cellar", "cellar 4\nstates 300\n\n");
    if (!sel big.err) { ret 9; }
    sim.dnit(?s);
    ret 0;
}
