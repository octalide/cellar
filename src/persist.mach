# text serialization of a world or a pattern to disk
#
# a pattern is a header line "<w> <h>\n" followed by h lines of w characters,
# '1' for a live cell and '0' for a dead one. a world is sparse: a first line
# "cellar 2", then for every chunk holding a live cell a line "<cx> <cy>" with
# its signed chunk coordinates and 64 lines of 64 cells. a world file in the
# pattern format, what every world was saved as before the world became
# unbounded, still loads, centred on the origin. both are deliberately trivial
# to read and write. saves create the file's directory first.

use gfx: boom.graphics;
use cellar.pattern;
use cellar.sim;
use cellar.space;
use cellar.text;
use allo: std.allocator;
use std.allocator.page;
use alloc_testing: std.allocator.testing;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use mem:      std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# directory tests write their files under
#[testing]
val TEST_DIR: str = "out/test";

# permission bits for a created data directory
pub val DIR_MODE: i32 = 0o755;
# permission bits for saved files
pub val FILE_MODE: i32 = 0o644;
# bytes reserved for the "<w> <h>\n" header when sizing a buffer
val HEADER_MAX: usize = 32;
# largest world side an old dense file may declare, bounding the allocation a
# corrupt or hand-edited header can request
val MAX_DIM: usize = 4096;
# the first line of a sparse world file
val MAGIC: str = "cellar 2";
# bytes of one chunk record past its coordinate line
val CHUNK_TEXT: usize = 64 * 65;

# why a save or load did not complete
# ---
# alloc:      the allocator refused a buffer
# fs:         the file or its directory could not be read or written
# dimensions: the header declares a size of zero or beyond the limit
# truncated:  the body holds fewer cells than the header declares
# version:    a settings file written by another format version
# gpu:        the GPU's cells could not be read back
pub tag Error: u8 {
    alloc: allo.Error;
    fs:    fs.FsError;
    dimensions;
    truncated;
    version;
    gpu;
}

# a one-line description of a persistence failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun error_message(e: Error) str {
    if (sel e.alloc)      { ret "out of memory"; }
    if (sel e.dimensions) { ret "bad dimensions"; }
    if (sel e.truncated)  { ret "truncated body"; }
    if (sel e.version)    { ret "version mismatch"; }
    if (sel e.gpu)        { ret "GPU read failed"; }
    if (sel e.fs) {
        if (sel e.fs.io) { ret io_error.kind_name(e.fs.io.kind); }
    }
    ret "file error";
}

# format a w x h field of row-major cells into buf as the header and rows
# ---
# buf:   destination, at least HEADER_MAX + h * (w + 1) bytes
# cells: row-major 0/1 cells, length w*h
# w:     field width
# h:     field height
# ret:   the byte count written
fun write_cells(buf: *u8, cells: *u8, w: usize, h: usize) usize {
    var off: usize = text.buf_u64(buf, 0, w::u64);
    buf[off] = ' ';
    off      = text.buf_u64(buf, off + 1, h::u64);
    buf[off] = '\n';
    off      = off + 1;
    var y: usize = 0;
    for (y < h) {
        var x: usize = 0;
        for (x < w) {
            var ch: u8 = '0';
            if (cells[y * w + x] != 0) { ch = '1'; }
            buf[off] = ch;
            off      = off + 1;
            x        = x + 1;
        }
        buf[off] = '\n';
        off      = off + 1;
        y        = y + 1;
    }
    ret off;
}

# create the directory a file path lives in, when it names one
# ---
# a:    allocator for transient parent paths
# path: a file path
# ret:  ok, or why the directory does not exist
pub fun make_parent(a: *allo.Allocator, path: str) err[fs.FsError] {
    var cut: usize = 0;
    var i:   usize = 0;
    for (path[i] != 0) {
        if (path[i] == '/' || path[i] == '\\') { cut = i; }
        i = i + 1;
    }
    if (cut == 0 || cut >= 1100) { ret err[fs.FsError].ok{}; }
    var dir: [1100]u8;
    var k:   usize = 0;
    for (k < cut) {
        dir[k] = path[k];
        k      = k + 1;
    }
    dir[cut] = 0;
    ret fs.create_dir_all(a, ?dir[0], DIR_MODE);
}

# format a w x h field of row-major cells and write it to path
# ---
# a:     allocator backing the transient buffer
# cells: row-major 0/1 cells, length w*h
# w:     field width
# h:     field height
# path:  destination file path
# ret:   ok, or why the file was not written
fun save_buffer(a: *allo.Allocator, cells: *u8, w: usize, h: usize, path: str) err[Error] {
    val made: err[fs.FsError] = make_parent(a, path);
    if (sel made.err) { ret err[Error].err{Error.fs{made.err}}; }

    val cap: usize                = HEADER_MAX + h * (w + 1);
    val rb:  res[*u8, allo.Error] = allo.allocate[u8](a, cap);
    if (sel rb.err) { ret err[Error].err{Error.alloc{rb.err}}; }

    val len:   usize           = write_cells(rb.ok, cells, w, h);
    val wrote: err[fs.FsError] = fs.write_bytes(path, rb.ok, len, FILE_MODE);
    allo.deallocate[u8](a, rb.ok, cap);
    if (sel wrote.err) { ret err[Error].err{Error.fs{wrote.err}}; }
    ret err[Error].ok{};
}

# read a run of decimal digits at off into out
# ---
# b:   the file contents
# off: where the digits start
# out: receives the value
# ret: the offset just past the digits
fun parse_uint(b: *Vector[u8], off: usize, out: *usize) usize {
    var o: usize = off;
    var v: usize = 0;
    for (text.byte_at(b.data, b.len, o) >= '0' && text.byte_at(b.data, b.len, o) <= '9') {
        v = v * 10 + (b.data[o] - '0')::usize;
        o = o + 1;
    }
    @out = v;
    ret o;
}

# skip any non-cell bytes from p to the next '0' or '1'
# ---
# b:   the file contents
# p:   where to start
# ret: the offset of the cell, or the length when none remains
fun next_cell(b: *Vector[u8], p: usize) usize {
    var o: usize = p;
    for (o < b.len && b.data[o] != '0' && b.data[o] != '1') { o = o + 1; }
    ret o;
}

# read "<w> <h>" from the start of the file
# ---
# b:   the file contents
# w:   receives the width
# h:   receives the height
# ret: the offset past the header
fun parse_header(b: *Vector[u8], w: *usize, h: *usize) usize {
    var i: usize = parse_uint(b, 0, w);
    for (text.byte_at(b.data, b.len, i) == ' ') { i = i + 1; }
    ret parse_uint(b, i, h);
}

# parse the w x h cells after the header into out, row-major as 0 or 1
#
# every cell is read before the caller changes anything, so a short body is
# refused while the world or pattern it was meant for is still untouched.
# ---
# b:     the file contents
# start: the offset just past the header
# w:     declared width
# h:     declared height
# out:   receives w*h cells
# ret:   ok, or truncated when the body runs out first
fun parse_body(b: *Vector[u8], start: usize, w: usize, h: usize, out: *u8) err[Error] {
    var p: usize = start;
    var i: usize = 0;
    for (i < w * h) {
        p = next_cell(b, p);
        if (p >= b.len) { ret err[Error].err{Error.truncated{}}; }
        out[i] = 0;
        if (b.data[p] == '1') { out[i] = 1; }
        p = p + 1;
        i = i + 1;
    }
    ret err[Error].ok{};
}

# append a signed decimal to buf at off
fun buf_i64(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret text.buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret text.buf_u64(buf, off, v::u64);
}

# serialize the world's live chunks to path
#
# on the GPU the cells are read back first, a stall.
# ---
# a:    allocator backing the transient buffer
# s:    simulation whose world is saved
# path: destination file path
# ret:  ok, or why the file was not written
pub fun save_world(a: *allo.Allocator, s: *sim.Sim, path: str) err[Error] {
    val synced: err[gfx.Error] = sim.sync(s);
    if (sel synced.err) { ret err[Error].err{Error.gpu{}}; }
    val made: err[fs.FsError] = make_parent(a, path);
    if (sel made.err) { ret err[Error].err{Error.fs{made.err}}; }

    val sp:   *space.Space = ?s.space;
    var live: usize        = 0;
    var sl:   usize        = 0;
    for (sl < sp.hi) {
        if (space.used(sp, sl)) {
            space.recount(sp, sl);
            if (sp.census[sl * space.CENSUS] != 0) { live = live + 1; }
        }
        sl = sl + 1;
    }
    val cap: usize                = HEADER_MAX + live * (HEADER_MAX + CHUNK_TEXT);
    val rb:  res[*u8, allo.Error] = allo.allocate[u8](a, cap);
    if (sel rb.err) { ret err[Error].err{Error.alloc{rb.err}}; }
    val buf: *u8   = rb.ok;
    var off: usize = text.buf_str(buf, 0, MAGIC);
    buf[off] = '\n';
    off      = off + 1;
    sl       = 0;
    for (sl < sp.hi) {
        if (space.used(sp, sl) && sp.census[sl * space.CENSUS] != 0) {
            off      = buf_i64(buf, off, space.slot_x(sp, sl));
            buf[off] = ' ';
            off      = buf_i64(buf, off + 1, space.slot_y(sp, sl));
            buf[off] = '\n';
            off      = off + 1;
            val c: *u32  = ?sp.cells[sl * space.CELLS];
            var i: usize = 0;
            for (i < space.CELLS) {
                var ch: u8 = '0';
                if (c[i] >= 256) { ch = '1'; }
                buf[off] = ch;
                off      = off + 1;
                if (i % 64 == 63) {
                    buf[off] = '\n';
                    off      = off + 1;
                }
                i = i + 1;
            }
        }
        sl = sl + 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, buf, off, FILE_MODE);
    allo.deallocate[u8](a, buf, cap);
    if (sel wrote.err) { ret err[Error].err{Error.fs{wrote.err}}; }
    ret err[Error].ok{};
}

# read a signed decimal at off, skipping spaces before it
# ---
# b:   the file contents
# off: where to start
# out: receives the value
# ret: the offset past the digits, or the length when none were found
fun parse_i64(b: *Vector[u8], off: usize, out: *i64) usize {
    var o: usize = off;
    for (text.byte_at(b.data, b.len, o) == ' ') { o = o + 1; }
    var neg: bool = false;
    if (text.byte_at(b.data, b.len, o) == '-') {
        neg = true;
        o   = o + 1;
    }
    val c: u8 = text.byte_at(b.data, b.len, o);
    if (c < '0' || c > '9') { ret b.len; }
    var v: usize = 0;
    o    = parse_uint(b, o, ?v);
    @out = v::i64;
    if (neg) { @out = 0 - v::i64; }
    ret o;
}

# whether the file starts with the sparse world's first line
fun is_sparse(b: *Vector[u8]) bool {
    var i: usize = 0;
    for (MAGIC[i] != 0) {
        if (text.byte_at(b.data, b.len, i) != MAGIC[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the chunk records of a sparse world, as coordinates and 0/1 cells
# ---
# b:     the file contents
# at:    receives each chunk's coordinates, two per chunk
# cells: receives each chunk's space.CELLS cells
# ret:   ok, or why the file was refused
fun parse_sparse(b: *Vector[u8], at: *Vector[i64], cells: *Vector[u8]) err[Error] {
    var p: usize = 0;
    for (p < b.len && b.data[p] != '\n') { p = p + 1; }
    for (true) {
        for (p < b.len && (b.data[p] == '\n' || b.data[p] == '\r' || b.data[p] == ' ')) { p = p + 1; }
        if (p >= b.len) { brk; }
        var cx: i64 = 0;
        var cy: i64 = 0;
        p = parse_i64(b, p, ?cx);
        if (p >= b.len) { ret err[Error].err{Error.truncated{}}; }
        p = parse_i64(b, p, ?cy);
        if (p >= b.len) { ret err[Error].err{Error.truncated{}}; }
        if (at.len / 2 >= space.MAX_SLOTS || cx < 0 - space.BIAS || cx >= space.BIAS
            || cy < 0 - space.BIAS || cy >= space.BIAS) { ret err[Error].err{Error.dimensions{}}; }
        vector.push[i64](at, cx);
        vector.push[i64](at, cy);
        val base: usize                  = cells.len;
        val grow: res[usize, allo.Error] = vector.reserve[u8](cells, space.CELLS);
        if (sel grow.err) { ret err[Error].err{Error.alloc{grow.err}}; }
        cells.len = base + space.CELLS;
        val parsed: err[Error] = parse_body(b, p, 64, 64, ?cells.data[base]);
        if (sel parsed.err) { ret parsed; }
        # step past the cells just read
        var n: usize = 0;
        for (n < space.CELLS) {
            p = next_cell(b, p) + 1;
            n = n + 1;
        }
    }
    ret err[Error].ok{};
}

# read path and replace the world with what it holds
#
# the whole file is parsed before the world changes, so a refusal leaves the
# world as it was.
# ---
# a:    allocator for the read and parse buffers
# s:    simulation to populate
# path: source file path
# ret:  ok, or why the world was not loaded
pub fun load_world(a: *allo.Allocator, s: *sim.Sim, path: str) err[Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret err[Error].err{Error.fs{rr.err}}; }
    var data: Vector[u8] = rr.ok;

    if (is_sparse(?data)) {
        var at:     Vector[i64] = vector.init[i64](a);
        var cells:  Vector[u8]  = vector.init[u8](a);
        val parsed: err[Error]  = parse_sparse(?data, ?at, ?cells);
        vector.dnit[u8](?data);
        if (sel parsed.ok) {
            sim.fill_begin(s);
            var k: usize = 0;
            for (k < at.len / 2) {
                val ox: i64   = at.data[k * 2] * space.SIDE;
                val oy: i64   = at.data[k * 2 + 1] * space.SIDE;
                var i:  usize = 0;
                for (i < space.CELLS) {
                    if (cells.data[k * space.CELLS + i] != 0) { sim.fill_cell(s, ox + (i % 64)::i64, oy + (i / 64)::i64); }
                    i = i + 1;
                }
                k = k + 1;
            }
            sim.fill_end(s);
        }
        vector.dnit[i64](?at);
        vector.dnit[u8](?cells);
        ret parsed;
    }

    # an old dense world, centred on the origin
    var w:     usize = 0;
    var h:     usize = 0;
    val start: usize = parse_header(?data, ?w, ?h);
    if (w == 0 || h == 0 || w > MAX_DIM || h > MAX_DIM) {
        vector.dnit[u8](?data);
        ret err[Error].err{Error.dimensions{}};
    }
    val rc: res[*u8, allo.Error] = allo.allocate[u8](a, w * h);
    if (sel rc.err) {
        vector.dnit[u8](?data);
        ret err[Error].err{Error.alloc{rc.err}};
    }
    val cells:  *u8        = rc.ok;
    val parsed: err[Error] = parse_body(?data, start, w, h, cells);
    vector.dnit[u8](?data);
    if (sel parsed.err) {
        allo.deallocate[u8](a, cells, w * h);
        ret parsed;
    }
    val ox: i64 = 0 - (w / 2)::i64;
    val oy: i64 = 0 - (h / 2)::i64;
    sim.fill_begin(s);
    var y: usize = 0;
    for (y < h) {
        var x: usize = 0;
        for (x < w) {
            if (cells[y * w + x] != 0) { sim.fill_cell(s, ox + x::i64, oy + y::i64); }
            x = x + 1;
        }
        y = y + 1;
    }
    sim.fill_end(s);
    allo.deallocate[u8](a, cells, w * h);
    ret err[Error].ok{};
}

# serialize a pattern to path
#
# the file holds dead and live cells only, so every nonzero state is written live.
# ---
# a:    allocator backing the transient buffer
# p:    pattern to save
# path: destination file path
# ret:  ok, or why the file was not written
pub fun save_pattern(a: *allo.Allocator, p: *pattern.Pattern, path: str) err[Error] {
    ret save_buffer(a, p.cells, p.w, p.h, path);
}

# read path into a pattern, resizing it to the stored dimensions
#
# the file is parsed into a scratch buffer first, so a refusal leaves p as it was.
# ---
# a:    allocator for the read and parse buffers
# p:    pattern to populate, keeping its name
# path: source file path
# ret:  ok, or why the pattern was not loaded
pub fun load_pattern(a: *allo.Allocator, p: *pattern.Pattern, path: str) err[Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret err[Error].err{Error.fs{rr.err}}; }
    var data: Vector[u8] = rr.ok;

    var w:     usize = 0;
    var h:     usize = 0;
    val start: usize = parse_header(?data, ?w, ?h);
    if (w == 0 || h == 0 || w > MAX_DIM || h > MAX_DIM) {
        vector.dnit[u8](?data);
        ret err[Error].err{Error.dimensions{}};
    }

    val rc: res[*u8, allo.Error] = allo.allocate[u8](a, w * h);
    if (sel rc.err) {
        vector.dnit[u8](?data);
        ret err[Error].err{Error.alloc{rc.err}};
    }
    val parsed: err[Error] = parse_body(?data, start, w, h, rc.ok);
    vector.dnit[u8](?data);
    if (sel parsed.err) {
        allo.deallocate[u8](a, rc.ok, w * h);
        ret parsed;
    }
    val sized: err[allo.Error] = pattern.resize(p, w, h);
    if (sel sized.err) {
        allo.deallocate[u8](a, rc.ok, w * h);
        ret err[Error].err{Error.alloc{sized.err}};
    }
    mem.copy[u8](p.cells, rc.ok, w * h);
    allo.deallocate[u8](a, rc.ok, w * h);
    ret err[Error].ok{};
}

test load_world__round_trips_a_sparse_world {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.paint(?s, 0, 0, 1);
    sim.paint(?s, -5, 3, 1);
    sim.paint(?s, 100000, -70000, 1);

    val path:  str        = "out/test/test_world.cells";
    val saved: err[Error] = save_world(?a, ?s, path);
    if (sel saved.err) { ret 2; }

    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 3; }
    sim.paint(?t, 7, 7, 1);
    val loaded: err[Error] = load_world(?a, ?t, path);
    if (sel loaded.err) { ret 4; }

    if (sim.population(?t) != 3)                               { ret 5; }
    if (!sim.alive(?t, 0, 0) || !sim.alive(?t, -5, 3))         { ret 6; }
    if (!sim.alive(?t, 100000, -70000) || sim.alive(?t, 7, 7)) { ret 7; }

    fs.remove_file(path);
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

test load_world__loads_an_old_dense_file_centred {
    var a: allo.Allocator;
    page.make(?a);

    # a 4 x 2 world from before the world was unbounded
    var body: [14]u8          = [14]u8{'4', ' ', '2', '\n', '1', '0', '0', '0', '\n', '0', '0', '0', '1', '\n'};
    val path: str             = "out/test/test_old.cells";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 1; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 14, FILE_MODE);
    if (sel wrote.err) { ret 2; }

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 3; }
    val loaded: err[Error] = load_world(?a, ?s, path);
    fs.remove_file(path);
    if (sel loaded.err)                                 { ret 4; }
    if (sim.population(?s) != 2)                        { ret 5; }
    if (!sim.alive(?s, -2, -1) || !sim.alive(?s, 1, 0)) { ret 6; }
    sim.dnit(?s);
    ret 0;
}

test load_pattern__round_trips {
    var a: allo.Allocator;
    page.make(?a);

    var p:     pattern.Pattern;
    val made5: err[allo.Error] = pattern.init(?p, ?a, 5, 3, "custom");
    if (sel made5.err) { ret 1; }
    pattern.set(?p, 0, 0, 1);
    pattern.set(?p, 4, 2, 1);
    pattern.set(?p, 2, 1, 1);

    val path:   str        = "out/test/test_pattern.cells";
    val saved4: err[Error] = save_pattern(?a, ?p, path);
    if (sel saved4.err) { ret 1; }

    var q:     pattern.Pattern;
    val made6: err[allo.Error] = pattern.init(?q, ?a, 1, 1, "custom");
    if (sel made6.err) { ret 1; }
    val loaded4: err[Error] = load_pattern(?a, ?q, path);
    if (sel loaded4.err) { ret 2; }

    if (q.w != 5 || q.h != 3) { ret 3; }
    var y: usize = 0;
    for (y < 3) {
        var x: usize = 0;
        for (x < 5) {
            if (pattern.get(?q, x, y) != pattern.get(?p, x, y)) { ret 4; }
            x = x + 1;
        }
        y = y + 1;
    }

    pattern.dnit(?p);
    pattern.dnit(?q);
    fs.remove_file(path);
    ret 0;
}

test load_pattern__reads_by_length_past_an_embedded_nul {
    var t:    alloc_testing.Testing;
    val made: err[allo.Error] = alloc_testing.make(?t);
    if (sel made.err) { ret 1; }
    val a: *allo.Allocator = alloc_testing.allocator_of(?t);

    # a NUL inside the body ended the old NUL-terminated read early
    var body: [9]u8           = [9]u8{'3', ' ', '1', '\n', '1', 0, '0', '1', '\n'};
    val path: str             = "out/test/test_nul.cells";
    val dir:  err[fs.FsError] = fs.create_dir_all(a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    var p:     pattern.Pattern;
    val made7: err[allo.Error] = pattern.init(?p, a, 1, 1, "custom");
    if (sel made7.err) { ret 1; }
    val loaded: err[Error] = load_pattern(a, ?p, path);
    fs.remove_file(path);
    if (sel loaded.err)                                                                                     { ret 4; }
    if (p.w != 3 || pattern.get(?p, 0, 0) != 1 || pattern.get(?p, 1, 0) != 0 || pattern.get(?p, 2, 0) != 1) { ret 5; }
    pattern.dnit(?p);
    if (alloc_testing.leaked(?t)) { ret 6; }
    alloc_testing.dnit(?t);
    ret 0;
}

test load_world__short_body_leaves_the_world_intact {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    sim.paint(?s, 2, 2, 1);

    # declares 3x3 but carries four cells
    var body: [9]u8           = [9]u8{'3', ' ', '3', '\n', '1', '1', '0', '1', '\n'};
    val path: str             = "out/test/test_short.cells";
    val dir:  err[fs.FsError] = fs.create_dir_all(?a, TEST_DIR, DIR_MODE);
    if (sel dir.err) { ret 2; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?body[0], 9, FILE_MODE);
    if (sel wrote.err) { ret 3; }

    val loaded: err[Error] = load_world(?a, ?s, path);
    fs.remove_file(path);
    if (!sel loaded.err)           { ret 4; }
    if (!sel loaded.err.truncated) { ret 5; }
    if (sim.population(?s) != 1)   { ret 6; }
    if (!sim.alive(?s, 2, 2))      { ret 7; }
    sim.dnit(?s);
    ret 0;
}
