# the rule a world runs, as a family and its rule, and the preset table
#
# a family is a kind of rule: its own rule string, cell word, the layers it
# stores its cells in (cellar.layer), CPU step and GPU step stage. a family
# declares a record of its operations over its rule (cellar.rule.family), and
# a rule is the index of its family and its family's rule, opaque to all but
# the family. the families every build runs are cellar.rules's, in their
# order, and the families registered at run time follow them. the rest of
# cellar reaches a rule only through this module, which reaches it only
# through its family's record, so it never learns what a family's rule holds
# or what its cell word means, and a family added changes nothing here.
#
# the states and their words belong to the rule, not only its family: a
# generations rule has as many states as its string names, and its words show
# where each state lies among them. a cell's state is its family's to read
# from its word, the values of all its state and rule layers (cellar.layer),
# which is what keeps it exactly (word_state), and for a family whose state
# layer alone says it, from that layer's value too (state). a cell is live by
# its state layer's value through the sense or by a value in a rule layer its
# family declares live.
#
# changing a world's rule to one whose words differ, one of another family or
# of the same family with other states, re-encodes its cells: each word becomes
# the new rule's fresh word for the state the old rule reads in it, fresh(new,
# state(old, c)), and a state the new rule lacks becomes state 0, the quiescent
# background, the one mapping safe between any two rules. a family that needs
# a smarter mapping can later offer adopt(state, from) u32 as the extension
# point. sim.set_rule does this, moving the cells into the new rule's layers as
# it goes (cellar.space.relayer). word zero is always the quiescent background
# (see cellar.layout), and a family's step keeps it: a chunk of zeros with none
# live around it steps to zeros under every rule. a rule that births on 0 would
# flip the unbounded background, so its family holds the world's complement on
# the generations it flips, and says so through caps.b0: the draw shows those
# generations inverted and the simulation's edits and reads see the world
# through them. the edge of the world's boundary is then held live on those
# generations (outside), and the family's step reads it so.
#
# a rule also names the grid it runs on (cellar.topology), written as Golly
# does, after a colon: "B3/S23:T100,100". a plane names the world's
# boundary, the rectangle the pool holds it inside (cellar.sim,
# cellar.boundary), and a grid that wraps names the seams the pool links. the
# grid belongs to the rule rather than to a family, since every family's step
# reads through the same page table, and rather than to the world beside the
# rule, since the rule string is what world files, settings, batch jobs and
# pattern files record: kept in the rule, the grid travels everywhere the rule
# string does. a family that cannot run on a bounded grid says so in its caps,
# and parse refuses the pair.
#
# a rule buffer holds what does not fit a family's window of the meta head: a
# wide kernel's weights and sums, or a rule table's transitions. a family with
# table set has its stage bind one more storage buffer than the two every
# step stage binds, at layout.TABLE_BINDING (layout.Table), and a family
# without it binds none and gives table_words 0. the rule buffer is its
# family's alone, sized by table_words for the rule running, and packed and
# uploaded only when the rule changes, never each frame, so a rule table of
# megabytes costs its upload once. the window keeps what the stage reads for
# every cell and changes with the rule alone, a radius or a state count, and
# the buffer's layout is the family's own, as the window's is. a device whose
# dispatches bind too few storage buffers for a family's stage
# (bindings(i) against boom's max_dispatch_bindings) cannot step that family's
# rules on the GPU, nor can any device a family without a stage, and the
# simulation refuses them there (see cellar.sim).

use cellar.layer;
use cellar.layer.plane;
use cellar.layout;
use cellar.rule.family;
use cellar.rules;
#[testing]
use cellar.rules.probe;
#[testing]
use cellar.rules.weighted;
use cellar.space;
use cellar.topology;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use mem: std.memory;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

fwd family.Caps;

# a rule: a family's rule and the grid it runs on
# ---
# family: the family's index among families()
# data:   the family's rule, which its record alone reads
# grid:   the grid, the unbounded plane unless the rule string names one
pub rec Rule {
    family: usize;
    data:   family.Payload;
    grid:   topology.Grid;
}

# the most families a run holds: the ones every build runs and as many as can
# be registered beside them
pub val FAMILIES_MAX: usize = rules.COUNT + family.ADDED_MAX;

# the longest rule string any family's format writes, less its NUL
val FAMILY_MAX: usize = family.FORMAT_MAX;
# the longest rule string format writes, grid included, less its NUL
pub val FORMAT_MAX: usize = FAMILY_MAX + topology.FORMAT_MAX;

# rule families this run holds, the ones every build runs and then the ones
# registered at run time
pub fun families() usize {
    ret rules.COUNT + family.added_count();
}

# family i's record
fun at(i: usize) *family.Family {
    if (i < rules.COUNT) { ret rules.FAMILIES[i]; }
    ret family.added_at(i - rules.COUNT);
}

# a rule's family's record
#[inline]
fun of(r: *Rule) *family.Family {
    ret at(r.family);
}

# the index of a family's record
# ---
# f:   the record
# ret: its index, or none for a family not registered
pub fun index_of(f: *family.Family) opt[usize] {
    var i: usize = 0;
    for (i < families()) {
        if (at(i) == f) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether a rule is a family's
pub fun is(r: *Rule, f: *family.Family) bool {
    ret at(r.family) == f;
}

# a family's rule on the unbounded plane, from the rule as its family's own type
# ---
# f:   the family's record, registered, whose rule is of type T
# v:   the rule
# ret: the rule
pub fun make[T](f: *family.Family, v: T) Rule {
    val i: opt[usize] = index_of(f);
    if (sel i.none || $size_of(T) != f.size) { panic.panic("cellar.rule: a rule made of a family not registered, or not of its type"); }
    var r: Rule;
    if (sel i.some) { r.family = i.some; }
    r.grid = topology.open();
    mem.raw_copy(?r.data, ?v, $size_of(T));
    ret r;
}

# a rule's family's rule, as its family's own type, to read or change
# ---
# r:   the rule
# f:   the family's record, whose rule is of type T
# ret: the rule within r, or nil when r is not f's
pub fun view[T](r: *Rule, f: *family.Family) *T {
    if (!is(r, f) || $size_of(T) != f.size) { ret nil; }
    ret family.view[T](?r.data);
}

# the id family i's rule strings are recorded under, in world and settings files
pub fun family_id(i: usize) str {
    ret at(i).id;
}

# the family a recorded id names
# ---
# id:  the id, as family_id gave it
# ret: the family, or none for one this version does not run
pub fun family_named(id: str) opt[usize] {
    var i: usize = 0;
    for (i < families()) {
        if (string.str_equals(family_id(i), id)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# the family a rule belongs to
pub fun family_of(r: *Rule) usize {
    ret r.family;
}

# family i's step stage, as SPIR-V
# ---
# i:   the family
# len: receives its length in bytes, 0 for none
# ret: its first byte, or nil for a family the CPU alone steps
pub fun stage(i: usize, len: *usize) *u8 {
    val f: *family.Family = at(i);
    if (f.stage == nil) {
        @len = 0;
        ret nil;
    }
    ret f.stage(len);
}

# whether family i's step stage binds a rule buffer
pub fun table(i: usize) bool {
    ret at(i).table;
}

# the storage buffers family i's step stage binds
pub fun bindings(i: usize) usize {
    if (table(i)) { ret layout.STEP_BINDINGS::usize + 1; }
    ret layout.STEP_BINDINGS::usize;
}

# how many sample rule strings family i gives its tests
pub fun sample_count(i: usize) usize {
    ret at(i).samples;
}

# family i's sample rule string n
pub fun sample(i: usize, n: usize) str {
    ret at(i).sample(n);
}

# split a rule string at its first colon: the family's part, less trailing
# spaces, into head, and the grid the rest names, the unbounded plane without one
# ---
# s:    NUL-terminated rule text
# head: at least FAMILY_MAX + 1 bytes
# ret:  the grid, or what is wrong with it
fun split(s: str, head: *u8) res[topology.Grid, str] {
    var n: usize = 0;
    for (s[n] != 0 && s[n] != ':') {
        if (n == FAMILY_MAX) { ret res[topology.Grid, str].err{"the rule is too long"}; }
        head[n] = s[n];
        n       = n + 1;
    }
    var e: usize = n;
    for (e > 0 && head[e - 1] == ' ') { e = e - 1; }
    head[e] = 0;
    if (s[n] == 0) { ret res[topology.Grid, str].ok{topology.open()}; }
    ret topology.parse(?s[n + 1]);
}

# read family i's part of a rule string into r, which takes the family
# ---
# i:   the family
# s:   the family's part
# r:   the rule, left as it was on a refusal
# ret: what is wrong with s, if anything
fun parse_family(i: usize, s: str, r: *Rule) err[str] {
    val e: err[str] = at(i).parse(s, ?r.data);
    if (sel e.ok) { r.family = i; }
    ret e;
}

# a rule on a grid, or why it cannot run there
fun placed(r: *Rule, g: topology.Grid) res[Rule, str] {
    r.grid = g;
    val why: opt[str] = refusal(r);
    if (sel why.some) { ret res[Rule, str].err{why.some}; }
    ret res[Rule, str].ok{@r};
}

# why a rule cannot run as it stands, its family's rule on its grid, or none
# when it can. parse refuses such a rule, and sim.set_rule one built any other
# way, such as a kernel edited wider than a small grid
pub fun refusal(r: *Rule) opt[str] {
    if (!topology.bounded(?r.grid))            { ret opt[str].none{}; }
    if (!family_caps(r).bounded)               { ret opt[str].some{"the rule cannot run on a bounded grid"}; }
    if (!topology.reaches(?r.grid, radius(r))) { ret opt[str].some{"a joined edge of the grid is shorter than the rule reaches"}; }
    # a plane's edge a flipping background holds live is stepped along its
    # whole length (cellar.space keep_rim), which an unbounded axis does not end
    if (r.grid.shape == topology.PLANE && family_caps(r).b0 && (r.grid.w == 0 || r.grid.h == 0)) { ret opt[str].some{"a rule that births on 0 cannot run on a plane unbounded along an axis"}; }
    ret opt[str].none{};
}

# read a rule string as family i's, with its grid
# ---
# i:   the family
# s:   NUL-terminated rule text
# ret: the rule, or what is wrong with s
pub fun parse_as(i: usize, s: str) res[Rule, str] {
    var head: [FAMILY_MAX + 1]u8;
    val g:    res[topology.Grid, str] = split(s, ?head[0]);
    if (sel g.err) { ret res[Rule, str].err{g.err}; }
    var r: Rule;
    val e: err[str] = parse_family(i, ?head[0], ?r);
    if (sel e.err) { ret res[Rule, str].err{e.err}; }
    ret placed(?r, g.ok);
}

# read a rule string as whichever family's it is, trying each in turn, with its grid
# ---
# s:   NUL-terminated rule text
# ret: the rule, or what the family whose syntax s plausibly is found wrong
#      with it, the first family's when none claims it
pub fun parse(s: str) res[Rule, str] {
    var head: [FAMILY_MAX + 1]u8;
    val g:    res[topology.Grid, str] = split(s, ?head[0]);
    if (sel g.err) { ret res[Rule, str].err{g.err}; }
    var r:     Rule;
    val first: err[str] = parse_family(0, ?head[0], ?r);
    if (sel first.ok) { ret placed(?r, g.ok); }
    var i: usize = 1;
    for (i < families()) {
        val e: err[str] = parse_family(i, ?head[0], ?r);
        if (sel e.ok) { ret placed(?r, g.ok); }
        i = i + 1;
    }
    i = 0;
    for (i < families()) {
        if (at(i).claims(?head[0])) {
            val e: err[str] = parse_family(i, ?head[0], ?r);
            if (sel e.err) { ret res[Rule, str].err{e.err}; }
        }
        i = i + 1;
    }
    ret res[Rule, str].err{first.err};
}

# write a rule's string in its family's form, which parse_as reads back as it
# ---
# r:   the rule
# buf: at least FORMAT_MAX + 1 bytes
# ret: buf
pub fun format(r: *Rule, buf: *u8) str {
    of(r).format(?r.data, buf);
    topology.format(?r.grid, buf, string.str_len(buf));
    ret buf;
}

# the most bytes display writes, grid included, less its NUL
pub val DISPLAY_MAX: usize = family.DISPLAY_MAX + topology.FORMAT_MAX;

# write a rule's short form for the readout, which need not name it whole
# ---
# r:   the rule
# buf: at least DISPLAY_MAX + 1 bytes
# ret: buf
pub fun display(r: *Rule, buf: *u8) str {
    of(r).display(?r.data, buf);
    topology.format(?r.grid, buf, string.str_len(buf));
    ret buf;
}

# whether two rules step alike, families and grids included
pub fun same(a: *Rule, b: *Rule) bool {
    if (a.family != b.family) { ret false; }
    ret of(a).same(?a.data, ?b.data) && topology.same(?a.grid, ?b.grid);
}

# whether two rules store their cells in layers of the same widths and write
# every state as the same word, so cells of one read alike under the other: a
# cell's word, not only its state, carries between them
pub fun alike(a: *Rule, b: *Rule) bool {
    if (family_of(a) != family_of(b) || states(a) != states(b)) { ret false; }
    var la: plane.Set = layers(a);
    var lb: plane.Set = layers(b);
    if (!plane.same_words(?la, ?lb)) { ret false; }
    var wa: [layer.LAYERS_MAX]u32;
    var wb: [layer.LAYERS_MAX]u32;
    var st: u32 = 0;
    for (st < states(a)) {
        fresh(a, st, ?wa[0]);
        fresh(b, st, ?wb[0]);
        var k: usize = 0;
        for (k < plane.exact(?la)) {
            if (wa[k] != wb[k]) { ret false; }
            k = k + 1;
        }
        st = st + 1;
    }
    ret true;
}

# how many states a cell of the rule can be in
pub fun states(r: *Rule) u32 {
    ret of(r).states(?r.data);
}

# the value a fresh cell of a state holds in the rule's state layer, the one
# a cell's state is read from
# ---
# r:     the rule
# state: below states(r)
# ret:   the value
pub fun value(r: *Rule, state: u32) u32 {
    ret of(r).word_of(?r.data, state);
}

# the sensed value (cellar.layer) of a fresh cell of a state: its value in the
# state layer, with the value a fresh one holds in the rule's shown layer
# above it, where its family declares one, which is what shared code reads
# the cell's display channels from
pub fun sensed(r: *Rule, state: u32) u32 {
    val f:   *family.Family = of(r);
    var set: plane.Set      = viewed(r);
    val v:   u32            = f.word_of(?r.data, state);
    val k:   opt[usize]     = plane.shown(?set);
    if (sel k.none) { ret v; }
    ret layer.sensed(v, f.rest_of(?r.data, state, k.some), set.at[0].width);
}

# the value a cell an edit leaves live starts at in the rule's shown layer, a
# fresh cell's of the fully live state (cellar.space lit), 0 where its family
# declares none
pub fun lit(r: *Rule) u32 {
    var set: plane.Set  = viewed(r);
    val k:   opt[usize] = plane.shown(?set);
    if (sel k.none) { ret 0; }
    ret of(r).rest_of(?r.data, ink(r), k.some);
}

# whether a cell's word holds more than its state under the rule, so a copy,
# a pattern and a file that can keep words keep them: a continuous rule's
# value only approximated by its state, or the values of rule layers beside
# the state layer
pub fun keeps_words(r: *Rule) bool {
    ret caps(r).continuous || word_len(r) > 1;
}

# values a cell's word holds under the rule, its state and rule layers'
pub fun word_len(r: *Rule) usize {
    var set: plane.Set = layers(r);
    ret plane.exact(?set);
}

# the word a fresh cell of a state is written as: its value in each of the
# rule's state and rule layers (cellar.layer)
# ---
# r:     the rule
# state: below states(r)
# out:   receives word_len(r) values
pub fun fresh(r: *Rule, state: u32, out: *u32) {
    val f: *family.Family = of(r);
    out[0] = f.word_of(?r.data, state);
    val n: usize = word_len(r);
    var k: usize = 1;
    for (k < n) {
        out[k] = f.rest_of(?r.data, state, k);
        k      = k + 1;
    }
}

# the state a cell's value in the state layer holds, its display channels
# aside, for a family whose state layer alone says it
pub fun state(r: *Rule, c: u32) u32 {
    ret of(r).state_of(?r.data, c);
}

# the state a cell's word holds, its values in every state and rule layer
# ---
# r:   the rule
# w:   word_len(r) values
# ret: the state, below states(r)
pub fun word_state(r: *Rule, w: *u32) u32 {
    ret of(r).word_state(?r.data, w);
}

# a cell's word as the rule's family records it now, from a word of n values
# an older version recorded (Family adopt)
# ---
# r:    the rule
# from: n values
# n:    the values from holds
# out:  receives word_len(r) values
# ret:  false when the family never recorded a word of n values
pub fun adopt(r: *Rule, from: *u32, n: usize, out: *u32) bool {
    val m: usize = word_len(r);
    if (n == m) {
        mem.copy[u32](out, from, m);
        ret true;
    }
    val f: *family.Family = of(r);
    if (f.adopt == nil || n == 0 || n > layer.LAYERS_MAX::usize) { ret false; }
    ret f.adopt(?r.data, from, n, out);
}

# whether the rule's family takes words of n values, its own or an older
# version's (adopt)
pub fun adopts(r: *Rule, n: usize) bool {
    var zero: [layer.LAYERS_MAX]u32;
    var out:  [layer.LAYERS_MAX]u32;
    ret adopt(r, ?zero[0], n, ?out[0]);
}

# whether a cell's word is live under the rule: its state layer's value
# through the sense, or a value but zero in a live rule layer (cellar.layer)
pub fun live_word(r: *Rule, w: *u32) bool {
    var set: plane.Set = layers(r);
    ret plane.live_word(?set, sense(r), w);
}

# whether a fresh cell of a state is live under the rule (live_word)
pub fun live_state(r: *Rule, state: u32) bool {
    var w: [layer.LAYERS_MAX]u32;
    fresh(r, state, ?w[0]);
    ret live_word(r, ?w[0]);
}

# the state painted or seeded when none is chosen: the fully live one
pub fun ink(r: *Rule) u32 {
    ret of(r).ink(?r.data);
}

# how far apart the GPU's and the CPU's words for a cell may lie a generation
# on from the same cells, in the word's units: 0 for a family whose engines
# step bit for bit, which a continuous family's floating point need not. a
# difference within it is not carried on: a chaotic rule amplifies any, so the
# engines are held to it one generation at a time (cellar.sim Rig)
pub fun slack(r: *Rule) u32 {
    ret of(r).slack(?r.data);
}

# the layers a rule's cells are stored in (cellar.layer): its family's state
# layer and the rule layers its step needs, which a cell's word is. the view
# layer its family can keep its display channels in is held only while the
# view's colour mode reads it (viewed)
pub fun layers(r: *Rule) plane.Set {
    var set: plane.Set = of(r).layers(?r.data);
    ret plane.without_views(?set);
}

# a rule's layers with the view layer its family keeps its display channels
# in, where its state layer is too narrow to hold them: the layers a pool
# holds the rule's cells in while the view's colour mode reads heat or age
pub fun viewed(r: *Rule) plane.Set {
    ret of(r).layers(?r.data);
}

# how shared code reads a value of the rule's state layer: the census, the
# pool and the draw
pub fun sense(r: *Rule) layout.Sense {
    ret of(r).sense();
}

# how far one generation reaches, in cells
pub fun radius(r: *Rule) usize {
    ret of(r).radius(?r.data);
}

# what the rule can do. a quadtree engine runs only the unbounded plane
pub fun caps(r: *Rule) Caps {
    var c: Caps = family_caps(r);
    if (topology.bounded(?r.grid)) { c.no_tree = "a bounded grid"; }
    ret c;
}

# the word a cell outside the world's boundary reads as to a step from
# generation gen, the rule's open edge: dead, and so live as held on the
# generations a flipping background (caps.b0) holds as the world's complement
# ---
# out: receives word_len(r) values
pub fun outside(r: *Rule, gen: u64, out: *u32) {
    var st: u32 = 0;
    if ((gen & 1) != 0 && family_caps(r).b0) { st = 1; }
    fresh(r, st, out);
}

# what a rule's family's rule can do, its grid aside
fun family_caps(r: *Rule) Caps {
    ret of(r).caps(?r.data);
}

# step one chunk on the CPU
# ---
# r: the rule
# b: the chunk's block and back cells
# t: the tally the step keeps of what it writes, reading cells by sense(r)
pub fun step_chunk(r: *Rule, b: *space.Block, t: *space.Tally) {
    of(r).step_chunk(?r.data, b, t);
}

# the state a cell becomes from the states of the 3 by 3 block around it
# ---
# r:   a rule whose caps(r).no_tree is nil
# nb:  nine states below states(r), row-major with the cell at 4
# ret: its next state
pub fun next(r: *Rule, nb: *u32) u32 {
    ret of(r).next_of(?r.data, nb);
}

# pack the rule into the family's window of the meta head
# ---
# r: the rule
# w: layout.RULE words
pub fun pack(r: *Rule, w: *u32) {
    of(r).pack(?r.data, w);
}

# the words of the rule buffer a rule needs, 0 for a family that keeps none
pub fun table_words(r: *Rule) usize {
    ret of(r).table_words(?r.data);
}

# pack the rule into its family's rule buffer
# ---
# r: the rule
# w: table_words(r) words
pub fun pack_table(r: *Rule, w: *u32) {
    of(r).pack_table(?r.data, w);
}

# the colour a live cell of a state is drawn in
# ---
# r:     the rule
# state: below states(r)
# ret:   0xrrggbb, or none to draw it in the view's solid colour
pub fun colour(r: *Rule, state: u32) opt[u32] {
    ret of(r).colour(?r.data, state);
}

# a built-in rule
# ---
# label:      its display name
# rulestring: its rule, as parse reads it
pub rec Preset {
    label:      str;
    rulestring: str;
}

# built-in rules
pub val PRESET_COUNT: usize = 15;

val PRESETS: [15]Preset = [15]Preset{
    Preset{label: "Life", rulestring: "B3/S23"},
    Preset{label: "HighLife", rulestring: "B36/S23"},
    Preset{label: "Seeds", rulestring: "B2/S"},
    Preset{label: "Day & Night", rulestring: "B3678/S34678"},
    Preset{label: "Brian's Brain", rulestring: "B2/S/C3"},
    Preset{label: "Star Wars", rulestring: "B2/S345/C4"},
    Preset{label: "tlife", rulestring: "B3/S2-i34q"},
    Preset{label: "Just Friends", rulestring: "B2-a/S12"},
    Preset{label: "Gray-Scott spots", rulestring: "F=0.03,k=0.062"},
    Preset{label: "Gray-Scott stripes", rulestring: "F=0.029,k=0.057"},
    Preset{label: "Gray-Scott mitosis", rulestring: "F=0.0367,k=0.0649"},
    Preset{label: "Orbium", rulestring: "R=13,T=10,b=[1],m=0.15,s=0.015,kn=1,gn=1"},
    Preset{label: "Gyrorbium", rulestring: "R=13,T=10,b=[1],m=0.156,s=0.0224,kn=1,gn=1"},
    Preset{label: "Scutium", rulestring: "R=13,T=10,b=[1],m=0.29,s=0.045,kn=1,gn=1"},
    Preset{label: "Hydrogeminium", rulestring: "R=18,T=10,b=[1/2,1,2/3],m=0.26,s=0.036,kn=1,gn=1"},
};

# built-in rule i
pub fun preset(i: usize) Preset {
    ret PRESETS[i];
}

# the rule of built-in i
pub fun preset_rule(i: usize) Rule {
    # every preset parses, which the tests hold to
    var out: Rule;
    val r:   res[Rule, str] = parse(PRESETS[i].rulestring);
    if (sel r.ok) { out = r.ok; }
    ret out;
}

# the built-in whose rule r applies, if any
pub fun match_preset(r: *Rule) opt[usize] {
    var i: usize = 0;
    for (i < PRESET_COUNT) {
        var p: Rule = preset_rule(i);
        if (same(r, ?p)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# a rule's display name: its preset's label, or "custom"
pub fun label(r: *Rule) str {
    val m: opt[usize] = match_preset(r);
    if (sel m.some) { ret PRESETS[m.some].label; }
    ret "custom";
}

test preset__every_rule_string_parses_and_round_trips {
    var b: [FORMAT_MAX + 1]u8;
    var i: usize = 0;
    for (i < PRESET_COUNT) {
        val r: res[Rule, str] = parse(PRESETS[i].rulestring);
        if (!sel r.ok) { ret 1; }
        val again: res[Rule, str] = parse_as(family_of(?r.ok), format(?r.ok, ?b[0]));
        if (!sel again.ok)           { ret 2; }
        if (!same(?again.ok, ?r.ok)) { ret 3; }
        val m: opt[usize] = match_preset(?r.ok);
        if (!sel m.some) { ret 4; }
        if (m.some != i) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test match_preset__names_a_preset_rule_and_nothing_else {
    var r: Rule = preset_rule(1);
    if (!string.str_equals(label(?r), "HighLife")) { ret 1; }
    val k: *weighted.Kernel = view[weighted.Kernel](?r, ?weighted.FAMILY);
    if (k == nil) { ret 1; }
    weighted.toggle(?k.birth, 5);
    val n: opt[usize] = match_preset(?r);
    if (sel n.some)                              { ret 2; }
    if (!string.str_equals(label(?r), "custom")) { ret 3; }
    ret 0;
}

test parse__reports_the_error_of_the_family_the_string_means {
    val table: res[Rule, str] = parse("WireWrld");
    if (sel table.ok) { ret 1; }
    if (sel table.err) {
        if (!string.str_equals(table.err, "no rule of that name was found in the data directory, in this session or among the built-ins")) { ret 1; }
    }
    val life: res[Rule, str] = parse("B3/S2x");
    if (sel life.ok) { ret 2; }
    if (sel life.err) {
        if (!string.str_equals(life.err, "a neighbour count is beyond 8")) { ret 2; }
    }
    val gen: res[Rule, str] = parse("B2/S/C99999");
    if (sel gen.ok) { ret 3; }
    if (sel gen.err) {
        if (!string.str_equals(gen.err, "the state count is not 2 to 256")) { ret 3; }
    }
    # hensel's letters and a MAP string, base64 slashes and all, are the
    # non-totalistic family's
    val hen: res[Rule, str] = parse("B2-x/S12");
    if (sel hen.ok) { ret 4; }
    if (sel hen.err) {
        if (!string.str_equals(hen.err, "a minus needs letters after it")) { ret 4; }
    }
    val eight: res[Rule, str] = parse("B3/S1e8c");
    if (sel eight.ok) { ret 5; }
    if (sel eight.err) {
        if (!string.str_equals(eight.err, "a letter names no arrangement of that many neighbours")) { ret 5; }
    }
    val short: res[Rule, str] = parse("MAPAB/C/D");
    if (sel short.ok) { ret 6; }
    if (sel short.err) {
        if (!string.str_equals(short.err, "a MAP rule holds 86 base64 characters, one bit for each neighbourhood of the Moore neighbourhood")) { ret 6; }
    }
    ret 0;
}

test dispatch__every_function_handles_every_family {
    # a release build runs the families cellar.rules lists, and a test-only
    # family registered beside them runs through the same table
    if (families() != rules.COUNT) { ret 1; }
    probe.register();
    probe.register();
    if (families() != rules.COUNT + 1) { ret 1; }
    var len: usize          = 0;
    val pr:  res[Rule, str] = parse("probe");
    if (sel pr.err) { ret 1; }
    var p: Rule = pr.ok;
    if (!is(?p, ?probe.FAMILY) || stage(family_of(?p), ?len) != nil) { ret 1; }
    var a: allo.Allocator;
    page.make(?a);
    var own: [layer.LAYERS_MAX * layout.CELLS]u32;
    var out: [layer.LAYERS_MAX * layout.CELLS]u32;
    var buf: [FORMAT_MAX + 1]u8;
    var win: [112]u32;
    var f:   usize = 0;
    for (f < families()) {
        val named: opt[usize] = family_named(family_id(f));
        if (sel named.none)                                                                             { ret 1; }
        if (named.some != f)                                                                            { ret 1; }
        if ((stage(f, ?len) == nil) != (len == 0))                                                      { ret 2; }
        if (bindings(f) < layout.STEP_BINDINGS::usize || bindings(f) > layout.STEP_BINDINGS::usize + 1) { ret 2; }
        var n: usize = 0;
        for (n < sample_count(f)) {
            val got: res[Rule, str] = parse_as(f, sample(f, n));
            if (sel got.err) { ret 3; }
            var r: Rule = got.ok;
            if (family_of(?r) != f || !same(?r, ?r)) { ret 4; }
            val back: res[Rule, str] = parse_as(f, format(?r, ?buf[0]));
            if (sel back.err)                 { ret 5; }
            if (!same(?back.ok, ?r))          { ret 5; }
            if (display(?r, ?buf[0])[0] == 0) { ret 6; }
            # a refusal of the quadtree engine names its reason
            val why: str = caps(?r).no_tree;
            if (why != nil && why[0] == 0) { ret 6; }
            # word 0 is the quiescent background, and every state survives a round trip
            if (states(?r) < 2 || value(?r, 0) != 0 || state(?r, 0) != 0) { ret 7; }
            # a family whose word is its state layer alone reads its state there
            var st: u32 = 0;
            for (word_len(?r) == 1 && st < states(?r)) {
                if (state(?r, value(?r, st)) != st) { ret 8; }
                st = st + 1;
            }
            # its layers hold to the contract, with no view layer but the one
            # it shows its display channels from, and every state's fresh word
            # fits its layers' widths, the empty state's all zeros, as does
            # what a fresh live cell shows
            var ls: plane.Set = viewed(?r);
            if (!plane.holds(?ls) || plane.views(?ls) > 1 || word_len(?r) != plane.exact(?ls)) { ret 16; }
            if ((lit(?r) & ~layer.mask(plane.shown_width(?ls))) != 0)                          { ret 16; }
            var fw: [layer.LAYERS_MAX]u32;
            var lk: usize = 0;
            var sw: u32   = 0;
            for (sw < states(?r)) {
                fresh(?r, sw, ?fw[0]);
                lk = 0;
                for (lk < plane.exact(?ls)) {
                    if ((fw[lk] & ~layer.mask(ls.at[lk].width)) != 0 || (sw == 0 && fw[lk] != 0)) { ret 16; }
                    lk = lk + 1;
                }
                # and its state is read back from its whole word
                if (word_state(?r, ?fw[0]) != sw) { ret 17; }
                sw = sw + 1;
            }
            val sn: layout.Sense = sense(?r);
            if (layout.live(0, sn.live_mask, sn.live_lo, sn.live_hi) != 0) { ret 9; }
            # the ink is a live state
            if (ink(?r) == 0 || ink(?r) >= states(?r))                                      { ret 9; }
            if (layout.live(value(?r, ink(?r)), sn.live_mask, sn.live_lo, sn.live_hi) == 0) { ret 9; }
            slack(?r);
            if (radius(?r) == 0) { ret 10; }
            caps(?r);
            pack(?r, ?win[0]);
            # a family with a rule buffer packs its rule there, and one without packs none
            val words: usize = table_words(?r);
            if (table(f) != (words != 0)) { ret 13; }
            var tab:  Vector[u32]            = vector.init[u32](?a);
            val room: res[usize, allo.Error] = vector.ensure[u32](?tab, words + 1);
            if (sel room.err) { ret 14; }
            tab.data[words] = 0xdeadbeef;
            pack_table(?r, tab.data);
            if (tab.data[words] != 0xdeadbeef) { ret 14; }
            vector.dnit[u32](?tab);
            label(?r);
            match_preset(?r);
            colour(?r, states(?r) - 1);
            if (string.str_len(format(?r, ?buf[0])) > FAMILY_MAX) { ret 15; }
            # a busy step of an empty chunk alone leaves it empty, at either
            # parity. the chunk's cells and its back cells are images, its
            # layers' spans one after another, a view layer's last
            var img: usize = 0;
            lk = 0;
            for (lk < ls.n) {
                img = img + plane.span_words(ls.at[lk].width);
                lk  = lk + 1;
            }
            var i: usize = 0;
            for (i < img) {
                own[i] = 0;
                out[i] = 0xffffffff;
                i      = i + 1;
            }
            var b: space.Block;
            space.block(?b, ?ls, 0);
            var at: usize = 0;
            lk = 0;
            for (lk < ls.n) {
                b.nb[lk * 9 + 4] = ?own[at];
                b.out[lk]        = ?out[at];
                at               = at + plane.span_words(ls.at[lk].width);
                lk               = lk + 1;
            }
            b.busy = true;
            var p: u64 = 0;
            for (p < 2) {
                b.gen = p;
                var t: space.Tally = space.tally(sn);
                step_chunk(?r, ?b, ?t);
                i = 0;
                for (i < img) {
                    if (out[i] != 0) { ret 11; }
                    i = i + 1;
                }
                if (t.live != 0) { ret 12; }
                p = p + 1;
            }
            # next, which a quadtree steps by, steps a row of three as the chunk
            # step does, for every rule a quadtree can run
            if (caps(?r).no_tree == nil) {
                i = 0;
                for (i < img) {
                    own[i] = 0;
                    i      = i + 1;
                }
                fresh(?r, 1, ?fw[0]);
                space.put_image_word(?ls, ?own[0], 10 * 64 + 10, ?fw[0]);
                space.put_image_word(?ls, ?own[0], 10 * 64 + 11, ?fw[0]);
                space.put_image_word(?ls, ?own[0], 10 * 64 + 12, ?fw[0]);
                b.gen = 0;
                var tb: space.Tally = space.tally(sn);
                step_chunk(?r, ?b, ?tb);
                var nb: [9]u32;
                var y:  usize = 8;
                for (y < 13) {
                    var x: usize = 8;
                    for (x < 15) {
                        var q: usize = 0;
                        for (q < 9) {
                            space.image_word(?ls, ?own[0], (y + q / 3 - 1) * 64 + x + q % 3 - 1, ?fw[0]);
                            nb[q] = state(?r, fw[0]);
                            q     = q + 1;
                        }
                        space.image_word(?ls, ?out[0], y * 64 + x, ?fw[0]);
                        if (next(?r, ?nb[0]) != state(?r, fw[0])) { ret 13; }
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }
            n = n + 1;
        }
        f = f + 1;
    }
    ret 0;
}

test parse__carries_a_grid_suffix_through_format {
    var b:     [FORMAT_MAX + 1]u8;
    val texts: [5]str = [5]str{"B3/S23:T100,100", "B2/S/C3:K64*,48", "B3/S23:P30,20", "B36/S23:C9,11", "B3/S23:T0,40"};
    var i:     usize  = 0;
    for (i < 5) {
        val r: res[Rule, str] = parse(texts[i]);
        if (sel r.err) { ret 1; }
        var got: Rule = r.ok;
        if (!topology.bounded(?got.grid))                      { ret 2; }
        if (!string.str_equals(format(?got, ?b[0]), texts[i])) { ret 3; }
        val again: res[Rule, str] = parse_as(family_of(?got), ?b[0]);
        if (sel again.err)             { ret 4; }
        if (!same(?again.ok, ?got))    { ret 5; }
        if (caps(?got).no_tree == nil) { ret 6; }
        i = i + 1;
    }
    # the grid is part of what steps alike, and a grid too short for the rule's
    # reach, or a bad suffix, is refused
    val life:  res[Rule, str] = parse("B3/S23");
    val torus: res[Rule, str] = parse("B3/S23:T100,100");
    if (sel life.err)  { ret 7; }
    if (sel torus.err) { ret 7; }
    var l: Rule = life.ok;
    var t: Rule = torus.ok;
    if (same(?l, ?t) || topology.bounded(?l.grid)) { ret 8; }
    val narrow: res[Rule, str] = parse("R4,C0,M1,S2..3,B3..3,NM:T3,40");
    if (sel narrow.ok) { ret 9; }
    val shifted: res[Rule, str] = parse("B3/S23:T10+1,10");
    if (sel shifted.ok) { ret 10; }
    # a flipping background runs on a plane whose edge ends, but not along an
    # unbounded axis, where the edge it holds live never does
    val b0: res[Rule, str] = parse("B0123/S123:P40,40");
    if (sel b0.err) { ret 11; }
    val b0t: res[Rule, str] = parse("B0123/S123:T40,40");
    if (sel b0t.err) { ret 12; }
    val b0s: res[Rule, str] = parse("B0123/S123:P0,40");
    if (sel b0s.ok) { ret 13; }
    val comp: res[Rule, str] = parse("B0123478/S01234678:P0,40");
    if (sel comp.err) { ret 14; }
    ret 0;
}
