# the world's bounds: the tool that draws its boundary or drags out a grid,
# picks a region of the boundary to move, delete or clear, and the controls
# that set a grid by value
#
# a shape drawn in the world (cellar.gesture) adds to, subtracts from or
# intersects the world's boundary (cellar.domain), and a shape added to a
# world without one becomes it. a rectangle is one of those shapes, and on a
# world without a boundary it makes the plane the rule names, as a box for any
# other grid does. a box dragged in the world, or a grid's edges dragged to
# new places, becomes the grid the world runs on, a plane unless another
# topology is chosen. the box stays where it was drawn on screen: the command
# it makes translates the world so the box is where the grid's notation
# centres it (cellar.exec). the topologies are the grids cellar.topology runs,
# a Klein bottle twisted either way, and only a plane holds a drawn boundary.

use blit;
use bctx: blit.context;
use blay: blit.layout;
use bov:  blit.overlay;
use bw:   blit.widget;
use cellar.app;
use cellar.boundary;
use cellar.command;
use cellar.gesture;
use cellar.hud;
use cellar.look;
use cellar.paint;
use cellar.render;
use cellar.shade;
use cellar.space;
use cellar.text;
use cellar.theme;
use cellar.topology;
use cellar.world;
use allo: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

# a plane of dead edges
pub val SHAPE_PLANE: usize = 0;
# a torus
pub val SHAPE_TORUS: usize = 1;
# a cross-surface
pub val SHAPE_CROSS: usize = 2;
# a Klein bottle, its top and bottom edges twisted (Golly's w*)
pub val SHAPE_KLEIN_W: usize = 3;
# a Klein bottle, its left and right edges twisted (Golly's h*)
pub val SHAPE_KLEIN_H: usize = 4;
# number of shapes
pub val SHAPE_COUNT: usize = 5;

# the grid's left edge, dragged
pub val EDGE_LEFT: u8 = 1;
# its right edge
pub val EDGE_RIGHT: u8 = 2;
# its top edge
pub val EDGE_TOP: u8 = 4;
# its bottom edge
pub val EDGE_BOTTOM: u8 = 8;

# unscaled pixels from a grid's edge that a press grabs it within
val GRAB: f32 = 6.0;

# the grid of a shape, w by h
pub fun grid_of(shape: usize, w: i64, h: i64) topology.Grid {
    var g: topology.Grid = topology.Grid{shape: topology.PLANE, w: w, h: h, twist_w: false};
    if (shape == SHAPE_TORUS) { g.shape = topology.TORUS; }
    if (shape == SHAPE_CROSS) { g.shape = topology.CROSS; }
    if (shape == SHAPE_KLEIN_W || shape == SHAPE_KLEIN_H) {
        g.shape   = topology.KLEIN;
        g.twist_w = shape == SHAPE_KLEIN_W;
    }
    ret g;
}

# the shape of a bounded grid
pub fun shape_of(g: *topology.Grid) usize {
    if (g.shape == topology.TORUS) { ret SHAPE_TORUS; }
    if (g.shape == topology.CROSS) { ret SHAPE_CROSS; }
    if (g.shape == topology.KLEIN) {
        if (g.twist_w) { ret SHAPE_KLEIN_W; }
        ret SHAPE_KLEIN_H;
    }
    ret SHAPE_PLANE;
}

# the cells of a bounded grid, half-open, an unbounded axis left empty
fun box_of(g: *topology.Grid) space.Box {
    var b: space.Box = space.Box{x0: 0, y0: 0, x1: 0, y1: 0};
    if (g.w != 0) {
        b.x0 = topology.left(g);
        b.x1 = b.x0 + g.w;
    }
    if (g.h != 0) {
        b.y0 = topology.top(g);
        b.y1 = b.y0 + g.h;
    }
    ret b;
}

# ask to put the world on a grid, the grid's box drawn with its top-left cell
# at (x0, y0) in the world as it stands
pub fun ask(a: *app.App, g: topology.Grid, x0: i64, y0: i64) {
    app.submit(a, command.Command.bounds{command.Bounds{grid: g, x0: x0, y0: y0}});
}

# ask to put the world on a grid where its notation puts it, moving nothing
pub fun ask_centred(a: *app.App, g: topology.Grid) {
    var c: topology.Grid = g;
    ask(a, g, topology.left(?c), topology.top(?c));
}

# ask to take the bounds away
pub fun remove(a: *app.App) {
    ask(a, topology.open(), 0, 0);
}

# the edges of the grid a press at screen (mx, my) grabs, 0 for none
fun grabbed(g: *topology.Grid, cam: render.Camera, mx: f32, my: f32, m: f32) u8 {
    if (!topology.bounded(g)) { ret 0; }
    val b:  space.Box   = box_of(g);
    val r:  render.Span = render.span(cam, b);
    var x0: f32         = r.x0 - m;
    var x1: f32         = r.x1 + m;
    var y0: f32         = r.y0 - m;
    var y1: f32         = r.y1 + m;
    if (g.w == 0) {
        x0 = mx;
        x1 = mx;
    }
    if (g.h == 0) {
        y0 = my;
        y1 = my;
    }
    if (mx < x0 || mx > x1 || my < y0 || my > y1) { ret 0; }
    var e: u8 = 0;
    if (g.w != 0) {
        val dl: f32 = abs(mx - r.x0);
        val dr: f32 = abs(mx - r.x1);
        if (dl <= m && dl <= dr) { e = e | EDGE_LEFT; }
        or (dr <= m)             { e = e | EDGE_RIGHT; }
    }
    if (g.h != 0) {
        val dt: f32 = abs(my - r.y0);
        val db: f32 = abs(my - r.y1);
        if (dt <= m && dt <= db) { e = e | EDGE_TOP; }
        or (db <= m)             { e = e | EDGE_BOTTOM; }
    }
    ret e;
}

fun abs(v: f32) f32 {
    if (v < 0.0) { ret 0.0 - v; }
    ret v;
}

# the box dragged so far, from the press's cell to (cx, cy) or the grabbed
# edges moved to it, at least a cell across
fun dragged(a: *app.App, cx: i64, cy: i64) {
    if (a.edges == 0) {
        a.sized = space.Box{x0: min(a.anchor_x, cx), y0: min(a.anchor_y, cy), x1: max(a.anchor_x, cx) + 1, y1: max(a.anchor_y, cy) + 1};
        ret;
    }
    val b: *space.Box = ?a.sized;
    if ((a.edges & EDGE_LEFT) != 0)   { b.x0 = min(cx, b.x1 - 1); }
    if ((a.edges & EDGE_RIGHT) != 0)  { b.x1 = max(cx + 1, b.x0 + 1); }
    if ((a.edges & EDGE_TOP) != 0)    { b.y0 = min(cy, b.y1 - 1); }
    if ((a.edges & EDGE_BOTTOM) != 0) { b.y1 = max(cy + 1, b.y0 + 1); }
}

fun min(a: i64, b: i64) i64 {
    if (a < b) { ret a; }
    ret b;
}

fun max(a: i64, b: i64) i64 {
    if (a > b) { ret a; }
    ret b;
}

# drag a grid: a press grabs the grid's edges near it or starts a new box, a
# drag moves them, and the release asks for the bounds
fun sizing(a: *app.App, g: *topology.Grid, cam: render.Camera, scale: f32, mx: f32, my: f32, pressed: bool, held: bool) {
    var cx: i64 = 0;
    var cy: i64 = 0;
    render.cell_at(cam, mx, my, ?cx, ?cy);
    if (pressed) {
        a.sizing   = true;
        a.edges    = grabbed(g, cam, mx, my, GRAB * scale);
        a.anchor_x = cx;
        a.anchor_y = cy;
        a.sized    = box_of(g);
        if (a.edges == 0) { a.sized = space.Box{x0: cx, y0: cy, x1: cx + 1, y1: cy + 1}; }
    }
    if (!a.sizing) { ret; }
    if (held) {
        dragged(a, cx, cy);
        ret;
    }
    a.sizing = false;
    val b: space.Box = a.sized;
    # a click with nothing dragged is no box
    if (a.edges == 0 && cx == a.anchor_x && cy == a.anchor_y) { ret; }
    if (a.edges == 0) {
        ask(a, grid_of(a.grid_shape, b.x1 - b.x0, b.y1 - b.y0), b.x0, b.y0);
        ret;
    }
    # an unbounded axis stays so
    var w: i64 = 0;
    var h: i64 = 0;
    if (g.w != 0) { w = b.x1 - b.x0; }
    if (g.h != 0) { h = b.y1 - b.y0; }
    ask(a, grid_of(shape_of(g), w, h), b.x0, b.y0);
}

# whether a press makes a grid rather than a boundary shape: a box for a grid
# that wraps, a grab of a grid's edges, or a rectangle added to a world
# without a boundary, which makes the plane
fun grids(a: *app.App, g: *topology.Grid, cam: render.Camera, scale: f32, mx: f32, my: f32) bool {
    if (a.shape.kind != gesture.RECT)                                      { ret false; }
    if (a.grid_shape != SHAPE_PLANE)                                       { ret true; }
    if (topology.bounded(g) && grabbed(g, cam, mx, my, GRAB * scale) != 0) { ret true; }
    ret !a.dom_on && a.bound_op != boundary.SUBTRACT;
}

# ask to combine the shape just drawn into the world's boundary
fun drawn(a: *app.App) {
    var c:      command.Domain  = command.Domain{op: command.DOMAIN_SHAPE, shape: boundary.init(a.alloc), how: a.bound_op, x: 0, y: 0, dx: 0, dy: 0};
    val copied: err[allo.Error] = boundary.copy(?c.shape, ?a.shape.shape);
    if (sel copied.err) {
        boundary.dnit(?c.shape);
        app.say(a, "out of memory");
        ret;
    }
    app.submit(a, command.Command.domain{c});
}

# ask for an edit of the picked region
fun ask_part(a: *app.App, op: u8, dx: i64, dy: i64) {
    if (!a.part_on) { ret; }
    app.submit(a, command.Command.domain{command.Domain{op: op, shape: boundary.init(a.alloc), how: boundary.ADD, x: a.part_x, y: a.part_y, dx: dx, dy: dy}});
}

# pick a region: a press on the picked one starts dragging it, a press
# anywhere else picks the region there or none, and the release of a drag
# asks to move it
fun choose(a: *app.App, cam: render.Camera, mx: f32, my: f32, pressed: bool, held: bool) {
    var cx: i64 = 0;
    var cy: i64 = 0;
    render.cell_at(cam, mx, my, ?cx, ?cy);
    if (pressed) {
        if (a.part_on && boundary.contains(?a.part, cx, cy)) {
            a.moving   = true;
            a.anchor_x = cx;
            a.anchor_y = cy;
            a.move_dx  = 0;
            a.move_dy  = 0;
        }
        or { app.pick_part(a, cx, cy); }
        ret;
    }
    if (!a.moving) { ret; }
    a.move_dx = cx - a.anchor_x;
    a.move_dy = cy - a.anchor_y;
    if (held) { ret; }
    a.moving = false;
    if (a.move_dx != 0 || a.move_dy != 0) { ask_part(a, command.DOMAIN_MOVE, a.move_dx, a.move_dy); }
    a.move_dx = 0;
    a.move_dy = 0;
}

# use the tool: pick a region, drag a grid, or draw a boundary shape
# ---
# a:       application state
# g:       the grid the world is on
# cam:     the camera
# scale:   the interface scale
# mx:      the pointer's column on screen
# my:      the pointer's row on screen
# pressed: a press began on the world this frame
# held:    the button is held
pub fun tool(a: *app.App, g: *topology.Grid, cam: render.Camera, scale: f32, mx: f32, my: f32, pressed: bool, held: bool) {
    if (a.sizing) {
        sizing(a, g, cam, scale, mx, my, false, held);
        ret;
    }
    if (a.choosing) {
        choose(a, cam, mx, my, pressed, held);
        ret;
    }
    if (pressed && !a.shape.active && grids(a, g, cam, scale, mx, my)) {
        sizing(a, g, cam, scale, mx, my, true, held);
        ret;
    }
    if (pressed && !a.shape.active && a.grid_shape != SHAPE_PLANE) {
        app.say(a, "a grid that wraps is a rectangle: choose Plane to draw a boundary");
        ret;
    }
    if (gesture.track(?a.shape, cam, scale, mx, my, pressed, held)) { drawn(a); }
}

# end a polygon being drawn, asking for it
pub fun close(a: *app.App) {
    if (gesture.close(?a.shape)) { drawn(a); }
}

# whether the tool is in the middle of something escape stops
pub fun busy(a: *app.App) bool {
    ret a.sizing || a.shape.active || a.moving;
}

# stop dragging the bounds, drawing a shape or moving a region, asking for nothing
pub fun cancel(a: *app.App) {
    a.sizing  = false;
    a.moving  = false;
    a.move_dx = 0;
    a.move_dy = 0;
    gesture.cancel(?a.shape);
}

# the world's domain, its outside shaded and its edge outlined, and the
# region a region fill takes marked, under everything else drawn over the world
pub fun domain(d: *paint.Paint, a: *app.App, cam: render.Camera) {
    if (!a.dom_on) { ret; }
    var w: shade.Draw = shade.Draw{r: ?a.domain, dx: 0, dy: 0, tmp: ?a.shade_tmp};
    shade.domain(d, ?w, cam);
    # the region a region fill takes, while that is what randomize fills
    if (a.fill_target != app.FILL_REGION || boundary.empty(?a.fill_part)) { ret; }
    w.r = ?a.fill_part;
    shade.fill(d, ?w, cam, theme.CHOSEN, 0.12);
    shade.outline(d, ?w, cam, 2.0, theme.CHOSEN, 0.95);
}

# what the tool is doing, over the world: the bounds being dragged, an
# unbounded axis across the screen, the shape being drawn, and the picked
# region where it is and where it is being dragged to
pub fun overlay(d: *paint.Paint, a: *app.App, cam: render.Camera) {
    gesture.overlay(d, ?a.shape, cam, ?a.shade_tmp);
    if (a.part_on) {
        var w: shade.Draw = shade.Draw{r: ?a.part, dx: 0, dy: 0, tmp: ?a.shade_tmp};
        shade.outline(d, ?w, cam, 2.0, theme.ACCENT, 0.9);
        if (a.moving) {
            w.dx = a.move_dx;
            w.dy = a.move_dy;
            shade.fill(d, ?w, cam, theme.ACCENT, 0.2);
            shade.outline(d, ?w, cam, 1.0, theme.ACCENT, 0.9);
        }
    }
    if (!a.sizing) { ret; }
    val r:  render.Span = render.span(cam, a.sized);
    var x0: f32         = r.x0;
    var x1: f32         = r.x1;
    var y0: f32         = r.y0;
    var y1: f32         = r.y1;
    if (a.sized.x1 <= a.sized.x0) {
        x0 = cam.x0 - 2.0;
        x1 = cam.x0 + cam.sw + 2.0;
    }
    if (a.sized.y1 <= a.sized.y0) {
        y0 = cam.y0 - 2.0;
        y1 = cam.y0 + cam.sh + 2.0;
    }
    paint.frame(d, x0 - 2.0, y0 - 2.0, x1 + 2.0, y1 + 2.0, 2.0, theme.ACCENT, 0.9);
}

# write a size, an unbounded one as such
fun size(buf: *u8, off: usize, v: i64) usize {
    if (v == 0) { ret text.buf_str(buf, off, "unbounded"); }
    ret text.buf_u64(buf, off, v::u64);
}

# the size of the bounds being dragged, over their top-left corner
pub fun label(ui: *bctx.Context, l: look.Look, a: *app.App, cam: render.Camera, pt: render.Port) {
    if (!a.sizing) { ret; }
    var b: [64]u8;
    var o: usize = size(?b[0], 0, a.sized.x1 - a.sized.x0);
    o    = text.buf_str(?b[0], o, " x ");
    o    = size(?b[0], o, a.sized.y1 - a.sized.y0);
    b[o] = 0;
    hud.tag(ui, l, "bounds", ?b[0], render.span(cam, a.sized), pt);
}

# the shape's name, as the section says what the world is on
fun shape_name(shape: usize) str {
    if (shape == SHAPE_TORUS)   { ret "Torus"; }
    if (shape == SHAPE_CROSS)   { ret "Cross-surface"; }
    if (shape == SHAPE_KLEIN_W) { ret "Klein bottle, top and bottom twisted"; }
    if (shape == SHAPE_KLEIN_H) { ret "Klein bottle, sides twisted"; }
    ret "Plane";
}

# a size field's value, or -1 when it is empty or past the largest size
fun typed(f: *blit.field.Field) i64 {
    val t: str   = blit.field.text(f);
    var v: i64   = 0;
    var i: usize = 0;
    for (t[i] != 0) {
        v = v * 10 + (t[i] - '0')::i64;
        if (v > topology.SIZE_MAX) { ret -1; }
        i = i + 1;
    }
    if (i == 0) { ret -1; }
    ret v;
}

# set the bounds to the typed size and the chosen shape, centred where they are
fun set_typed(a: *app.App) {
    val w: i64 = typed(?a.size_w);
    val h: i64 = typed(?a.size_h);
    if (w < 0 || h < 0) {
        app.say(a, "type a width and a height, each at most 2,000,000,000");
        ret;
    }
    val k: usize = a.grid_shape;
    if ((w == 0 || h == 0) && k != SHAPE_PLANE && k != SHAPE_TORUS) {
        app.say(a, "only a plane or a torus may be unbounded along an axis");
        ret;
    }
    ask_centred(a, grid_of(k, w, h));
}

# show the grid's size in the size fields
fun show_size(a: *app.App, g: *topology.Grid) {
    var b: [24]u8;
    var o: usize = text.buf_u64(?b[0], 0, g.w::u64);
    b[o] = 0;
    blit.field.set(?a.size_w, ?b[0]);
    o    = text.buf_u64(?b[0], 0, g.h::u64);
    b[o] = 0;
    blit.field.set(?a.size_h, ?b[0]);
}

# the bounds section: what the world is on, the shape, the size by value, and
# taking the bounds away
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown, whose rule gives the grid
pub fun section(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    look.heading(ui, l, "Bounds");
    var g:  topology.Grid = s.rule.grid;
    val on: bool          = topology.bounded(?g);
    # the fields and the shape follow the grid each time it changes
    if (!topology.same(?g, ?a.sized_grid)) {
        a.sized_grid = g;
        if (on) {
            a.grid_shape = shape_of(?g);
            show_size(a, ?g);
        }
    }
    if (a.dom_drawn) {
        var d: [96]u8;
        var o: usize = text.buf_str(?d[0], 0, "Drawn boundary, ");
        o = text.buf_u64(?d[0], o, a.dom_parts::u64);
        if (a.dom_parts == 1) { o = text.buf_str(?d[0], o, " region"); }
        or                    { o = text.buf_str(?d[0], o, " regions"); }
        d[o] = 0;
        look.note(ui, l, ?d[0]);
    }
    or (on) {
        var d: [96]u8;
        var o: usize = text.buf_str(?d[0], 0, shape_name(a.grid_shape));
        o    = text.buf_str(?d[0], o, ", ");
        o    = size(?d[0], o, g.w);
        o    = text.buf_str(?d[0], o, " x ");
        o    = size(?d[0], o, g.h);
        d[o] = 0;
        look.note(ui, l, ?d[0]);
    }
    or { look.note(ui, l, "Unbounded: the world runs on without edges"); }

    var shapes: [5]str;
    shapes[0] = "Plane";
    shapes[1] = "Torus";
    shapes[2] = "Cross";
    shapes[3] = "Klein w*";
    shapes[4] = "Klein h*";
    val hit: usize = bw.button_grid(ui, ?shapes[0], SHAPE_COUNT, 3, a.grid_shape);
    if (hit < SHAPE_COUNT && hit != a.grid_shape) {
        a.grid_shape = hit;
        # a bounded world takes the shape at once, where it is
        if (on) { ask_centred(a, grid_of(hit, g.w, g.h)); }
    }

    shapes_section(ui, l, a);

    val ew:   u8 = bw.text_field(ui, "width", ?a.size_w, "Width in cells");
    val eh:   u8 = bw.text_field(ui, "height", ?a.size_h, "Height in cells");
    var acts: [2]str;
    acts[0] = "Set bounds";
    acts[1] = "Remove";
    var n: usize = 1;
    if (on || a.dom_on) { n = 2; }
    val act: usize = bw.buttons(ui, ?acts[0], n);
    if (act == 0 || ((ew | eh) & blit.field.ENTERED) != 0) { set_typed(a); }
    if (act == 1 && (on || a.dom_on))                      { remove(a); }
}

# the boundary choice in effect: picking a region (0) or a gesture (1 and
# up) while the bounds tool is the tool, and none (gesture.COUNT + 1) while
# another is
pub fun lit(a: *app.App) usize {
    if (a.tool != app.TOOL_BOUNDS) { ret gesture.COUNT + 1; }
    if (a.choosing)                { ret 0; }
    ret a.shape.kind + 1;
}

# what a press draws and how it combines, the brush's size, and the picked
# region's edits
fun shapes_section(ui: *bctx.Context, l: look.Look, a: *app.App) {
    look.heading(ui, l, "Boundary");
    var kinds: [5]str;
    kinds[0] = "Pick";
    var k: usize = 0;
    for (k < gesture.COUNT) {
        kinds[k + 1] = gesture.name(k);
        k            = k + 1;
    }
    # the walls offer the same gestures under the same labels, so the group
    # keys its buttons apart from theirs
    val on: usize = lit(a);
    bctx.push_id_str(ui, "boundary");
    val hit: usize = bw.button_grid(ui, ?kinds[0], gesture.COUNT + 1, 3, on);
    bctx.pop_id(ui);
    if (hit <= gesture.COUNT && hit != on) {
        cancel(a);
        a.choosing = hit == 0;
        if (hit > 0) { a.shape.kind = hit - 1; }
        # a gesture chosen here draws a boundary
        app.pick_tool(a, app.TOOL_BOUNDS);
    }
    if (a.choosing) {
        if (!a.part_on) { look.note(ui, l, "Click a region to pick it, then drag it to move it"); }
        or {
            look.note(ui, l, "Drag the region to move it and its cells");
            var acts: [2]str;
            acts[0] = "Delete region";
            acts[1] = "Clear its cells";
            val act: usize = bw.buttons(ui, ?acts[0], 2);
            if (act == 0) { ask_part(a, command.DOMAIN_DELETE, 0, 0); }
            if (act == 1) { ask_part(a, command.DOMAIN_CLEAR, 0, 0); }
        }
        ret;
    }
    var ops: [3]str;
    ops[0] = "Add";
    ops[1] = "Subtract";
    ops[2] = "Intersect";
    var op: usize = a.bound_op::usize;
    if (bw.segmented(ui, ?ops[0], 3, ?op)) { a.bound_op = op::u32; }
    if (a.shape.kind == gesture.FREEHAND) {
        var rd: [24]u8;
        val o:  usize = text.buf_u64(?rd[0], 0, a.shape.radius::u64);
        rd[o] = 0;
        bw.slider(ui, "Brush radius", ?rd[0], ?a.shape.radius, 0.0, gesture.RADIUS_MAX);
    }
    if (a.shape.kind == gesture.POLYGON) { look.note(ui, l, "Click each corner, then the first or enter to close it"); }
    or                                   { look.note(ui, l, "Drag in the world to draw; a rectangle on a world without bounds makes its plane"); }
}
