# the pool's layout, one source for the host and the SPIR-V stages
#
# values are u32 because the stages have no wider word, and the host casts
# where it indexes. the records are the buffers' shapes as the stages see them.
#
# a chunk's cells are stored in layers whose width and meaning belong to the
# rule family running them and to the view (see cellar.layer, which says how a
# layer is addressed). the one thing every layer holds to is that zero is the
# quiescent background, what a chunk that does not exist reads as and what a
# chunk just made holds. everything else the shared stages and the host need to
# know about a cell, what counts as live, what keeps a chunk and what the draw
# shows, they read from its state layer's value through the family's Sense,
# and from the rule layers its family declares live (cellar.layer).

# side of a chunk in cells
pub val SIDE: u32 = 64;
# cells in a chunk
pub val CELLS: u32 = 4096;
# the farthest any rule may reach in a generation: a step reads the 3 by 3
# block of chunks around its own, so a cell reads no further than a chunk away
pub val REACH_MAX: u32 = SIDE;
# page-table words per slot (see Meta)
pub val ENTRY: u32 = 22;
# the entry's word of the slot's incarnation, zero while the slot is free
pub val INCARNATION_AT: u32 = 11;
# the entry's first link word, one per neighbour slot word in the same order
pub val LINK_AT: u32 = 12;
# the entry's edge word
pub val EDGE_AT: u32 = 21;
# the most slots any pool may hold: the stages' arrays are declared this long,
# and a pool's own ceiling, the device's or the host's, lies at or below it
pub val MAX_SLOTS: u32 = 32768;
# words of the meta buffer ahead of the page table: the shared words, then the
# rule family's window
pub val HEAD: u32 = 128;
# shared words at the head of the meta buffer: the census id, the slots in
# use, the step serial, the sense, the generation base, the strobe and the
# first slot of a step's dispatch
pub val SHARED: u32 = 16;
# words of the head a rule family packs its rule into
pub val RULE: u32 = 112;
# the word of the step serial in the meta buffer
pub val SERIAL_AT: u32 = 2;
# the word of the generation base: the generation a step's source cells hold
# is gen + serial, wrapping, and the generation the draw shows is gen + serial + 1
pub val GEN_AT: u32 = 11;
# the word of the strobe flag: 1 while the rule's background flips each
# generation, so odd generations hold the world's complement and are drawn
# inverted (rule.Caps.b0)
pub val STROBE_AT: u32 = 12;
# the word of the first entry of the active list a step's dispatch covers:
# workgroup y names the entry that many past it, so a generation can be
# dispatched in ranges of the list (Flags)
pub val BASE_AT: u32 = 13;
# the word of the state layer's width (cellar.layer), which the shared stages
# read the state layer at: the second of Meta's base words
pub val WIDTH_AT: u32 = 14;
# the word of the live rule layers' widths (cellar.layer live_add), which the
# stages that judge a cell live read them at: the third of Meta's base words
pub val LIVE_AT: u32 = 15;
# a neighbour that does not exist
pub val NONE: u32 = 0xffffffff;
# a position past a plane's dead edge, as a step stage's reach finds it
pub val PAST: u32 = 0xfffffffe;

# storage buffers every step stage binds: the source and destination cells,
# the meta buffer and the stamps, at bindings 0 to 3
pub val STEP_BINDINGS: u32 = 4;
# the binding of a rule buffer, which a family whose rule does not fit its
# window of the meta head declares (see cellar.rule), after the four above
pub val TABLE_BINDING: u32 = 4;
# the most words a rule buffer is declared to hold, the 128 MiB of storage
# every device can bind
pub val TABLE_MAX: u32 = 33554432;

# how the shared stages and the host read a cell's value in a rule family's
# state layer (cellar.layer)
# ---
# live_mask:  bits of the word the census tests
# live_lo:    least masked value of a live cell, one the census counts and
#             that can change a neighbour
# live_hi:    greatest masked value of a live cell
# warm_mask:  bits that keep a chunk from being freed while any is set
# heat_shift: where the heat display channel starts
# heat_mask:  its bits once shifted, zero when the family shows no heat
# age_shift:  where the age display channel starts
# age_mask:   its bits once shifted, zero when the family shows no age
pub rec Sense {
    live_mask:  u32;
    live_lo:    u32;
    live_hi:    u32;
    warm_mask:  u32;
    heat_shift: u32;
    heat_mask:  u32;
    age_shift:  u32;
    age_mask:   u32;
}

# 1 when a state value is live under a sense's live fields, else 0
pub fun live(c: u32, mask: u32, lo: u32, hi: u32) u32 {
    val m: u32 = c & mask;
    if (m >= lo && m <= hi) { ret 1; }
    ret 0;
}

# where a chunk's extent word keeps its live cells' first row, last column and
# last row, six bits each above the first column
pub val EXTENT_Y0: u32 = 6;
pub val EXTENT_X1: u32 = 12;
pub val EXTENT_Y1: u32 = 18;

# where the extent word keeps a bit per quadrant of the chunk holding a live
# cell, above the extent itself: north-west, north-east, south-west, south-east
pub val EXTENT_QUADS: u32 = 24;

# the quadrant bit of the cell at (x, y) inside its chunk
pub fun quadrant(x: u32, y: u32) u32 {
    ret 1 << ((y / (SIDE / 2)) * 2 + x / (SIDE / 2));
}

# a live chunk's halo, the chunks around it its live cells may spread into
# before the pool is next settled, is a mask with a bit per chunk of the 5 by 5
# block around it, row-major with the chunk itself at HALO_SELF
pub val HALO_SIDE: u32 = 5;
pub val HALO_SELF: u32 = 12;
# the most cells of spread a halo holds, every chunk two away
pub val SPREAD_MAX: u32 = 2 * SIDE;

# the halo row or column bits, the chunk's own at bit 2, a live cell in the
# low or the high half of its chunk along one axis needs to spread span cells
# either way: the chunks from its half's first cell less span to its last cell
# plus span, so a chunk left out is more than span cells away
fun halo_axis(high: u32, span: u32) u32 {
    var s: u32 = span;
    if (s > SPREAD_MAX) { s = SPREAD_MAX; }
    val first: u32 = high * (SIDE / 2) + SPREAD_MAX;
    val lo:    u32 = (first - s) / SIDE;
    var hi:    u32 = (first + SIDE / 2 - 1 + s) / SIDE;
    if (hi >= HALO_SIDE) { hi = HALO_SIDE - 1; }
    ret ((2 << hi) - 1) & ~((1 << lo) - 1);
}

# the halo mask for live cells in the quadrants of a chunk quads names
# (quadrant), which holds span cells of spread, at most SPREAD_MAX. a span of
# half a chunk asks only for the chunks the live cells lean toward, and one of
# a chunk for every adjacent chunk
pub fun halo(quads: u32, span: u32) u32 {
    var m: u32 = 0;
    var q: u32 = 0;
    for (q < 4) {
        if (((quads >> q) & 1) != 0) {
            val xs: u32 = halo_axis(q & 1, span);
            val ys: u32 = halo_axis(q >> 1, span);
            var r:  u32 = 0;
            for (r < HALO_SIDE) {
                if (((ys >> r) & 1) != 0) { m = m | (xs << (r * HALO_SIDE)); }
                r = r + 1;
            }
        }
        q = q + 1;
    }
    ret m & ~(1 << HALO_SELF);
}

# the extent word for live cells spanning columns x0 to x1 and rows y0 to y1,
# inclusive and inside the chunk
pub fun extent(x0: u32, y0: u32, x1: u32, y1: u32) u32 {
    ret x0 | (y0 << EXTENT_Y0) | (x1 << EXTENT_X1) | (y1 << EXTENT_Y1);
}

# the coverage pyramid each slot keeps for drawing below a pixel per cell.
# level l has a texel per 2^l by 2^l cells, from level 1 to LEVELS, and level 0
# is the cells themselves. a texel packs its cells' live count, their greatest
# heat above TEXEL_HEAT, and above TEXEL_AGE the mean age of the live ones,
# each age clamped to AGE_CAP. what is live, and the heat and age, are read
# through the rule family's sense, like everything else about a cell.
pub val LEVELS: u32 = 3;
# texels of every level in a slot's pyramid
pub val MIP: u32 = 1344;
# a texel's live count, and where its heat and mean age lie above it
pub val TEXEL_LIVE: u32 = 0x1fff;
pub val TEXEL_HEAT: u32 = 13;
pub val TEXEL_AGE:  u32 = 21;
# the oldest age the pyramid tells apart, the last age palette entry
pub val AGE_CAP: u32 = 255;

# texels along a side of a chunk at level l
pub fun mip_side(l: u32) u32 {
    ret SIDE >> l;
}

# the first texel of level l in a slot's pyramid, level 1 first
pub fun mip_at(l: u32) u32 {
    var at: u32 = 0;
    var k:  u32 = 1;
    for (k < l) {
        at = at + (SIDE >> k) * (SIDE >> k);
        k  = k + 1;
    }
    ret at;
}

# the greatest heat a texel tells apart, the last heat palette entry
pub val HEAT_CAP: u32 = 255;

# a live cell's age as the pyramid weighs it, read through a sense's age field
pub fun texel_age(c: u32, shift: u32, mask: u32) u32 {
    val age: u32 = (c >> shift) & mask;
    if (age > AGE_CAP) { ret AGE_CAP; }
    ret age;
}

# a cell's heat as the pyramid and the draw take it, read through a sense's
# heat field
pub fun texel_heat(c: u32, shift: u32, mask: u32) u32 {
    val heat: u32 = (c >> shift) & mask;
    if (heat > HEAT_CAP) { ret HEAT_CAP; }
    ret heat;
}

# a drawn cell of a view that stands for a square of cells (the tree's, see
# cellar.sim show_tree): the share of the square the rule counts live, in
# 255ths below SUMMARY_HEAT, and the most heat any of its cells carries above
pub val SUMMARY_LIVE: u32 = 255;
pub val SUMMARY_HEAT: u32 = 8;

# the texel over cells holding live live cells whose texel_age sum to ages,
# the hottest at heat
pub fun texel(live: u32, heat: u32, ages: u32) u32 {
    var mean: u32 = 0;
    if (live != 0) { mean = ages / live; }
    ret live | (heat << TEXEL_HEAT) | (mean << TEXEL_AGE);
}

# a layer's words as a stage binds them: every slot's span, the length a
# 32-bit layer takes, read through cellar.layer's addressing at the layer's
# width
pub rec Layer {
    v: [MAX_SLOTS * CELLS]u32;
}

# how a step reaches past a chunk, shared by the host and the step stages
#
# a chunk's frame is its own 64 by 64 cells, and a step reads cells up to a
# rule's radius outside it. the edge word gives the window of the frame that
# lies in the world, the whole frame unless a bounded grid's edge cuts through
# it. a position outside the window lies to one of the eight sides of it,
# edge_side, and the entry's neighbour slot and link word for that side say
# where it is: the slot, and the transform taking the position into that
# slot's frame. on the unbounded plane a link only moves a position by a
# chunk; across a bounded grid's seam it wraps, and on a twisted seam it also
# mirrors. a position the transform leaves outside the new frame's window is
# taken on the same way, at most HOPS times, and a missing slot on the way
# reads as zeros. a side past a plane's dead edge has no slot and its link word
# says so (LINK_EDGE), so a step can read the edge as its rule holds it, which
# is not always zero (see cellar.rule.outside).
#
# a chunk whose 3 by 3 block lies whole in the world is not seamed: its links
# only move by a chunk and every window is whole, so a step may read it the
# plain way. a seamed chunk is read through the links and its cells outside
# the window are held at zero.

# the most links a position is taken through before it is found
pub val HOPS: u32 = 4;

# a link word: the transform swaps x and y, then negates x and y as the flip
# bits say, then adds the offsets, each biased by LINK_BIAS
pub val LINK_FLIP_X: u32 = 1;
pub val LINK_FLIP_Y: u32 = 2;
pub val LINK_SWAP:   u32 = 4;
# the link crosses a bounded grid's seam, so it does not move by a chunk alone
pub val LINK_SEAM: u32 = 8;
# the side lies past a plane's dead edge, and its neighbour slot is NONE
pub val LINK_EDGE: u32 = 16;
pub val LINK_BIAS: i32 = 2048;
val     LINK_OX:   u32 = 8;
val     LINK_OY:   u32 = 20;

# the link word for flip, swap and seam bits and the offsets
pub fun link(bits: u32, ox: i32, oy: i32) u32 {
    ret bits | (((ox + LINK_BIAS)::u32 & 0xfff) << LINK_OX) | (((oy + LINK_BIAS)::u32 & 0xfff) << LINK_OY);
}

# the link word toward side k (edge_side) of an unseamed chunk, a move of one
# chunk
pub fun plain_link(k: u32) u32 {
    val dx: i32 = (k % 3)::i32 - 1;
    val dy: i32 = (k / 3)::i32 - 1;
    ret link(0, 0 - dx * SIDE::i32, 0 - dy * SIDE::i32);
}

# x of the position (x, y) taken through link word t
pub fun hop_x(t: u32, x: i32, y: i32) i32 {
    var a: i32 = x;
    if ((t & LINK_SWAP) != 0)   { a = y; }
    if ((t & LINK_FLIP_X) != 0) { a = 0 - a; }
    ret a + ((t >> LINK_OX) & 0xfff)::i32 - LINK_BIAS;
}

# y of the position (x, y) taken through link word t
pub fun hop_y(t: u32, x: i32, y: i32) i32 {
    var b: i32 = y;
    if ((t & LINK_SWAP) != 0)   { b = x; }
    if ((t & LINK_FLIP_Y) != 0) { b = 0 - b; }
    ret b + ((t >> LINK_OY) & 0xfff)::i32 - LINK_BIAS;
}

# the neighbour slot n that link word t names, as the draw sees it: the chunk
# beside on the plain lattice, NONE across a seam
pub fun beside(n: u32, t: u32) u32 {
    if ((t & LINK_SEAM) != 0) { ret NONE; }
    ret n;
}

# the edge word's seamed bit, above the window's four bounds of seven bits
pub val EDGE_SEAMED: u32 = 0x80000000;
# the edge word of a whole, unseamed chunk
pub val EDGE_WHOLE: u32 = 0x8002000;

# the edge word for the window [x0, x1) by [y0, y1) of a chunk's frame
pub fun edge(x0: u32, x1: u32, y0: u32, y1: u32, seamed: u32) u32 {
    var e: u32 = x0 | (x1 << 7) | (y0 << 14) | (y1 << 21);
    if (seamed != 0) { e = e | EDGE_SEAMED; }
    ret e;
}

# 1 when an edge word's chunk is seamed, else 0
pub fun seamed(e: u32) u32 {
    ret e >> 31;
}

# the side of an edge word's window the position (x, y) of the frame lies to,
# row-major like the neighbour slots, 4 inside it
pub fun edge_side(e: u32, x: i32, y: i32) u32 {
    var sx: u32 = 1;
    var sy: u32 = 1;
    if (x < (e & 0x7f)::i32)          { sx = 0; }
    or (x >= ((e >> 7) & 0x7f)::i32)  { sx = 2; }
    if (y < ((e >> 14) & 0x7f)::i32)  { sy = 0; }
    or (y >= ((e >> 21) & 0x7f)::i32) { sy = 2; }
    ret sy * 3 + sx;
}

# the shared words, the rule family's window, then one page-table entry per
# slot: the slots of the 3 by 3 block of chunks around it, its chunk
# coordinates biased by 2^30, its incarnation, zero while the slot is free, a
# link word per neighbour slot, and the edge word. the words from live_mask to
# age_mask are a Sense, in order, and gen, strobe and base lie at GEN_AT,
# STROBE_AT and BASE_AT. base's second word is the state layer's width, at
# WIDTH_AT, and its third the live rule layers' widths, at LIVE_AT, held in
# one field since a stage's storage block has at most 16
pub rec Meta {
    census:     u32;
    hi:         u32;
    serial:     u32;
    live_mask:  u32;
    live_lo:    u32;
    live_hi:    u32;
    warm_mask:  u32;
    heat_shift: u32;
    heat_mask:  u32;
    age_shift:  u32;
    age_mask:   u32;
    gen:        u32;
    strobe:     u32;
    base:       [3]u32;
    rule:       [RULE]u32;
    table:      [MAX_SLOTS * ENTRY]u32;
}

# the slots a stage works on, named by the host
pub rec List {
    v: [MAX_SLOTS]u32;
}

# per slot two words, each the serial of the last step that left a live cell
# and a warm one, then the active list: the slots the steps until the next
# gather may change (gather_comp), ahead of them the indirect arguments the
# steps over it are dispatched from, whose second is its length, and the
# gather's header bits in the fourth. the buffer is FLAGS_WORDS long whatever
# the pool's capacity, so the list lies where the record puts it
pub rec Flags {
    v:    [MAX_SLOTS * 2]u32;
    args: [4]u32;
    list: [MAX_SLOTS]u32;
}

# the word of the flags buffer where the list's arguments start, and the
# buffer's words
pub val FLAGS_ARGS:  u32 = MAX_SLOTS * 2;
pub val FLAGS_WORDS: u32 = MAX_SLOTS * 3 + 4;
# the gather's header bits: the GPU owns the pool, so a closed gate (Status)
# leaves the list empty, and the rule reads a plane's dead edge live on some
# generation, so every seamed chunk steps (cellar.rule.rimmed)
pub val GATHER_GATED: u32 = 1;
pub val GATHER_RIM:   u32 = 2;
# cells of spread a list holds: every slot within this many cells of a live
# one at the gather is on it, so the steps over it may spread this far before
# the next gather
pub val LIST_SPREAD: u32 = SIDE;

# a rule family's rule buffer, laid out as the family packs it
pub rec Table {
    v: [TABLE_MAX]u32;
}

# every slot's coverage pyramid
pub rec Mip {
    v: [MAX_SLOTS * MIP]u32;
}

# the status buffer: what the GPU reports to the host, and the allocator it
# keeps while it owns the pool (cellar.gpu)
#
# the head holds the control words, then the indirect arguments the pass
# stages are dispatched from. the census rows follow,
# so a readback of the head and the rows below a pool's capacity brings back
# everything the host reads each frame. the rest is the allocator's alone: the
# pass each slot was last asked for by, the slots claimed this pass, a bit per
# free slot, and a hash from chunk coordinates to slots.
#
# while the GPU owns the pool it alone writes the page table, the allocator
# words and the hash. the host writes only the words marked as its own, in
# order with the GPU's work in the frame's command stream, and takes the pool
# back only once the device is idle (see cellar.gpu take).

# words of the status head, the control words and the indirect arguments
pub val STATUS_HEAD: u32 = 24;
# the census id the frame's census was recorded under
pub val CTL_CENSUS: u32 = 0;
# nonzero once a pass could not claim every chunk it needed: no pass claims
# and no step runs after it until the host reopens it
pub val CTL_GATE: u32 = 1;
# the generations recorded before the pass that closed the gate, low bits
pub val CTL_HALT: u32 = 2;
# hash buckets a free left as tombstones
pub val CTL_TOMBS: u32 = 3;
# the last incarnation handed out
pub val CTL_SERIAL: u32 = 4;
# the host's: slots below which a pass claims, every slot the frame's stages cover
pub val CTL_TOP: u32 = 5;
# the host's: slots the pool's buffers hold
pub val CTL_CAP: u32 = 6;
# the active list's length as the census found it, which the host estimates
# the next generations' work from
pub val CTL_LISTED: u32 = 7;
# the pass header, which the host resets before every pass: slots claimed so
# far, the pass id (never 0), the serial of the step that left the front, the
# generations recorded before the pass, and the cells of spread the halo it
# leaves must hold (halo)
pub val CTL_FRESH: u32 = 8;
pub val CTL_PASS:  u32 = 9;
pub val CTL_NOW:   u32 = 10;
pub val CTL_GENS:  u32 = 11;
pub val CTL_SPAN:  u32 = 13;
# the indirect arguments of the settle stage, one workgroup per 64 slots
# claimed, and of the clear stage, one per settled slot, three words each
pub val ARGS_SETTLE: u32 = 16;
pub val ARGS_CLEAR:  u32 = 19;
# census words per slot: the packed count, the extent, and the coordinates
pub val ROW: u32 = 4;
# buckets of the GPU's hash: a power of two, four a slot
pub val HASH: u32 = MAX_SLOTS * 4;
# a hash bucket nothing ever held, which ends a probe
pub val EMPTY: u32 = 0xffffffff;
# a hash bucket whose slot was freed, which a probe passes and a claim reuses
pub val TOMB: u32 = 0xfffffffe;

pub rec Status {
    head:   [STATUS_HEAD]u32;
    rows:   [MAX_SLOTS * ROW]u32;
    asked:  [MAX_SLOTS]u32;
    fresh:  [MAX_SLOTS]u32;
    bitmap: [MAX_SLOTS / 32]u32;
    hash:   [HASH]u32;
}

# words of the status buffer
pub val STATUS_WORDS: u32 = STATUS_HEAD + MAX_SLOTS * ROW + MAX_SLOTS * 2 + MAX_SLOTS / 32 + HASH;

# the first bucket a chunk's biased coordinates probe from
pub fun bucket(bx: u32, by: u32) u32 {
    var h: u32 = (bx * 0x9e3779b1) ^ (by * 0x85ebca77);
    h = h ^ (h >> 15);
    h = h * 0x2c1b3c6d;
    h = h ^ (h >> 12);
    ret h & (HASH - 1);
}

test link__takes_a_position_through_every_transform_and_back {
    # a plain link east moves a chunk left in the neighbour's frame
    if (hop_x(plain_link(5), 65, 3) != 1 || hop_y(plain_link(5), 65, 3) != 3) { ret 1; }
    # a flip and a swap, as a sphere's seam would take
    val t: u32 = link(LINK_SWAP | LINK_FLIP_X | LINK_SEAM, 63, -64);
    if (hop_x(t, 5, 70) != -7 || hop_y(t, 5, 70) != -59)       { ret 2; }
    if (beside(3, t) != NONE || beside(3, plain_link(1)) != 3) { ret 3; }
    val e: u32 = edge(14, 64, 0, 50, 1);
    if (seamed(e) != 1 || seamed(EDGE_WHOLE) != 0)                                          { ret 4; }
    if (edge(0, 64, 0, 64, 0) != EDGE_WHOLE)                                                { ret 5; }
    if (edge_side(e, 13, 0) != 3 || edge_side(e, 14, 49) != 4 || edge_side(e, 20, 50) != 7) { ret 6; }
    if (edge_side(e, 64, -1) != 2)                                                          { ret 7; }
    ret 0;
}
