# the pool's layout, one source for the host and the SPIR-V stages
#
# values are u32 because the stages have no wider word, and the host casts
# where it indexes. the records are the buffers' shapes as the stages see them.
#
# a chunk's cells are stored in layers whose width and meaning belong to the
# rule family running them and to the view (see cellar.layer, which says how a
# layer is addressed). the one thing every layer holds to is that zero is the
# quiescent background, what a chunk that does not exist reads as and what a
# chunk just made holds. everything else the shared stages and the host need to
# know about a cell, what counts as live, what keeps a chunk and what the draw
# shows, they read from its state layer's value through the family's Sense,
# and from the rule layers its family declares live (cellar.layer).

# side of a chunk in cells
pub val SIDE: u32 = 64;
# cells in a chunk
pub val CELLS: u32 = 4096;
# the farthest any rule may reach in a generation: a step reads the 3 by 3
# block of chunks around its own, so a cell reads no further than a chunk away
pub val REACH_MAX: u32 = SIDE;
# page-table words per slot (see Meta)
pub val ENTRY: u32 = 22;
# the entry's word of the slot's incarnation, zero while the slot is free
pub val INCARNATION_AT: u32 = 11;
# the entry's first link word, one per neighbour slot word in the same order
pub val LINK_AT: u32 = 12;
# the entry's edge word
pub val EDGE_AT: u32 = 21;
# the words a stage declares a buffer it reaches or binds to hold past its
# head: the most a 32-bit word index into one buffer of 2 GiB names. a pool's
# buffers are sized at runtime, and none holds more
pub val WORDS: u32 = 536870912;
# words of the meta buffer ahead of the page table: the shared words, then the
# rule family's window
pub val HEAD: u32 = 138;
# shared words at the head of the meta buffer: the census id, the slots in
# use, the step serial, the sense, the generation base, the strobe, the base
# words and the address of the shard table (Meta)
pub val SHARED: u32 = 26;
# words of the head a rule family packs its rule into
pub val RULE: u32 = 112;
# the word of the step serial in the meta buffer
pub val SERIAL_AT: u32 = 2;
# the word of the generation base: the generation a step's source cells hold
# is gen + serial, wrapping, and the generation the draw shows is gen + serial + 1
pub val GEN_AT: u32 = 11;
# the word of the strobe flag: 1 while the rule's background flips each
# generation, so odd generations hold the world's complement and are drawn
# inverted (rule.Caps.b0)
pub val STROBE_AT: u32 = 12;
# the word of the first entry of the active list a step's dispatch covers:
# workgroup y names the entry that many past it, so a generation can be
# dispatched in ranges of the list (Flags)
pub val BASE_AT: u32 = 13;
# the word of the state layer's width (cellar.layer), which the shared stages
# read the state layer at: the second of Meta's base words
pub val WIDTH_AT: u32 = 14;
# the word of the set (cellar.layer set_word): its layers, its shown layer and
# its live rule layers, which the stages that judge a cell live read
pub val SET_AT: u32 = 15;
# the word of every layer's width (cellar.layer widths_add)
pub val WIDTHS_AT: u32 = 16;
# the word of the slots the pool's buffers hold, which the stages find the
# runtime-sized parts of the flags and status buffers by (Flags, Status)
pub val CAP_AT: u32 = 17;
# the word of the pool's shard geometry: the log2 of its largest shard's slots
# (shard_of)
pub val SHARD_AT: u32 = 18;
# the word of the value a fresh live cell holds in the set's shown layer
# (cellar.rule lit), which a shown layer the pool takes up starts from
pub val LIT_AT: u32 = 19;
# the word of the rows a dispatch folds along y (row): the device's most
# workgroups along y, which every stage finds its row by
pub val FOLD_AT: u32 = 20;
# the word of the domain flag: 1 while the world has a boundary, whose domain
# the address past it names (Domain), else 0 and the address is never read
pub val DOMAIN_ON_AT: u32 = 21;
# the words of the domain's address, past the base words (Meta)
pub val DOMAIN_AT: u32 = 22;
# the words of the shard table's address, past the domain's (Meta)
pub val SHARDS_AT: u32 = 24;
# a neighbour that does not exist
pub val NONE: u32 = 0xffffffff;

# the row of workgroups a stage's workgroup lies in, where its dispatch folds
# rows past fold along y onto z, fold rows a step along z (cellar.gpu rows). a
# dispatch's last step along z may run past the rows it covers, so a stage
# bounds the row before it reads anything the row names
pub fun row(y: u32, z: u32, fold: u32) u32 {
    ret y + z * fold;
}

# the workgroups along y of a dispatch folded as row folds it, covering rows
# up to row r: what a stage that lists rows raises indirect arguments' y to
pub fun fold_y(r: u32, fold: u32) u32 {
    if (r < fold) { ret r + 1; }
    ret fold;
}

# the workgroups along z of a dispatch covering rows up to row r, as fold_y
pub fun fold_z(r: u32, fold: u32) u32 {
    ret r / fold + 1;
}

# storage buffers every step stage binds: the meta buffer and the flags, at
# bindings 0 and 1. the cells it reaches by address (Shards)
pub val STEP_BINDINGS: u32 = 2;
# the binding of a rule buffer, which a family whose rule does not fit its
# window of the meta head declares (see cellar.rule), after the two above
pub val TABLE_BINDING: u32 = 2;
# the most words a rule buffer is declared to hold, the 128 MiB of storage
# every device can bind
pub val TABLE_MAX: u32 = 33554432;

# how the shared stages and the host read a cell's sensed value, its value in
# a rule family's state layer with its shown layer's above it (cellar.layer)
# ---
# live_mask:  bits of the word the census tests
# live_lo:    least masked value of a live cell, one the census counts and
#             that can change a neighbour
# live_hi:    greatest masked value of a live cell
# warm_mask:  bits that keep a chunk from being freed while any is set
# heat_shift: where the heat display channel starts
# heat_mask:  its bits once shifted, zero when the family shows no heat
# age_shift:  where the age display channel starts
# age_mask:   its bits once shifted, zero when the family shows no age
pub rec Sense {
    live_mask:  u32;
    live_lo:    u32;
    live_hi:    u32;
    warm_mask:  u32;
    heat_shift: u32;
    heat_mask:  u32;
    age_shift:  u32;
    age_mask:   u32;
}

# 1 when a state value is live under a sense's live fields, else 0
pub fun live(c: u32, mask: u32, lo: u32, hi: u32) u32 {
    val m: u32 = c & mask;
    if (m >= lo && m <= hi) { ret 1; }
    ret 0;
}

# where a chunk's extent word keeps its live cells' first row, last column and
# last row, six bits each above the first column
pub val EXTENT_Y0: u32 = 6;
pub val EXTENT_X1: u32 = 12;
pub val EXTENT_Y1: u32 = 18;

# where the extent word keeps a bit per quadrant of the chunk holding a live
# cell, above the extent itself: north-west, north-east, south-west, south-east
pub val EXTENT_QUADS: u32 = 24;

# the quadrant bit of the cell at (x, y) inside its chunk
pub fun quadrant(x: u32, y: u32) u32 {
    ret 1 << ((y / (SIDE / 2)) * 2 + x / (SIDE / 2));
}

# a live chunk's halo, the chunks around it its live cells may spread into
# before the pool is next settled, is a mask with a bit per chunk of the 5 by 5
# block around it, row-major with the chunk itself at HALO_SELF
pub val HALO_SIDE: u32 = 5;
pub val HALO_SELF: u32 = 12;
# the most cells of spread a halo holds, every chunk two away
pub val SPREAD_MAX: u32 = 2 * SIDE;

# the halo row or column bits, the chunk's own at bit 2, a live cell in the
# low or the high half of its chunk along one axis needs to spread span cells
# either way: the chunks from its half's first cell less span to its last cell
# plus span, so a chunk left out is more than span cells away
fun halo_axis(high: u32, span: u32) u32 {
    var s: u32 = span;
    if (s > SPREAD_MAX) { s = SPREAD_MAX; }
    val first: u32 = high * (SIDE / 2) + SPREAD_MAX;
    val lo:    u32 = (first - s) / SIDE;
    var hi:    u32 = (first + SIDE / 2 - 1 + s) / SIDE;
    if (hi >= HALO_SIDE) { hi = HALO_SIDE - 1; }
    ret ((2 << hi) - 1) & ~((1 << lo) - 1);
}

# the halo mask for live cells in the quadrants of a chunk quads names
# (quadrant), which holds span cells of spread, at most SPREAD_MAX. a span of
# half a chunk asks only for the chunks the live cells lean toward, and one of
# a chunk for every adjacent chunk
pub fun halo(quads: u32, span: u32) u32 {
    var m: u32 = 0;
    var q: u32 = 0;
    for (q < 4) {
        if (((quads >> q) & 1) != 0) {
            val xs: u32 = halo_axis(q & 1, span);
            val ys: u32 = halo_axis(q >> 1, span);
            var r:  u32 = 0;
            for (r < HALO_SIDE) {
                if (((ys >> r) & 1) != 0) { m = m | (xs << (r * HALO_SIDE)); }
                r = r + 1;
            }
        }
        q = q + 1;
    }
    ret m & ~(1 << HALO_SELF);
}

# the extent word for live cells spanning columns x0 to x1 and rows y0 to y1,
# inclusive and inside the chunk
pub fun extent(x0: u32, y0: u32, x1: u32, y1: u32) u32 {
    ret x0 | (y0 << EXTENT_Y0) | (x1 << EXTENT_X1) | (y1 << EXTENT_Y1);
}

# the coverage pyramid each slot keeps for drawing below a pixel per cell.
# level l has a texel per 2^l by 2^l cells, from level 1 to LEVELS, and level 0
# is the cells themselves. a texel packs its cells' live count, their greatest
# heat above TEXEL_HEAT, and above TEXEL_AGE the mean age of the live ones,
# each age clamped to AGE_CAP. what is live, and the heat and age, are read
# through the rule family's sense, like everything else about a cell.
pub val LEVELS: u32 = 3;
# texels of every level in a slot's pyramid
pub val MIP: u32 = 1344;
# a texel's live count, and where its heat and mean age lie above it
pub val TEXEL_LIVE: u32 = 0x1fff;
pub val TEXEL_HEAT: u32 = 13;
pub val TEXEL_AGE:  u32 = 21;
# the oldest age the pyramid tells apart, the last age palette entry
pub val AGE_CAP: u32 = 255;

# texels along a side of a chunk at level l
pub fun mip_side(l: u32) u32 {
    ret SIDE >> l;
}

# the first texel of level l in a slot's pyramid, level 1 first
pub fun mip_at(l: u32) u32 {
    var at: u32 = 0;
    var k:  u32 = 1;
    for (k < l) {
        at = at + (SIDE >> k) * (SIDE >> k);
        k  = k + 1;
    }
    ret at;
}

# the greatest heat a texel tells apart, the last heat palette entry
pub val HEAT_CAP: u32 = 255;

# a live cell's age as the pyramid weighs it, read through a sense's age field
pub fun texel_age(c: u32, shift: u32, mask: u32) u32 {
    val age: u32 = (c >> shift) & mask;
    if (age > AGE_CAP) { ret AGE_CAP; }
    ret age;
}

# a cell's heat as the pyramid and the draw take it, read through a sense's
# heat field
pub fun texel_heat(c: u32, shift: u32, mask: u32) u32 {
    val heat: u32 = (c >> shift) & mask;
    if (heat > HEAT_CAP) { ret HEAT_CAP; }
    ret heat;
}

# a drawn cell of a view that stands for a square of cells (the tree's, see
# cellar.sim show_tree): the share of the square the rule counts live, in
# 255ths below SUMMARY_HEAT, and the most heat any of its cells carries above
pub val SUMMARY_LIVE: u32 = 255;
pub val SUMMARY_HEAT: u32 = 8;

# the texel over cells holding live live cells whose texel_age sum to ages,
# the hottest at heat
pub fun texel(live: u32, heat: u32, ages: u32) u32 {
    var mean: u32 = 0;
    if (live != 0) { mean = ages / live; }
    ret live | (heat << TEXEL_HEAT) | (mean << TEXEL_AGE);
}

# where the pool's cells and pyramids lie
#
# each layer's two cells (cellar.layer) and the coverage pyramids lie in
# shards: buffers each holding the spans of a run of slots, which the stages
# reach by device address through the shard table the meta head names
# (Shards). the first shard holds SHARD_FIRST slots and each after it as many
# as every one before it, so a pool that doubles adds a shard, until a shard
# holds 2^m slots, the pool's shard geometry (SHARD_AT), and every shard after
# that holds as many. a slot's shard and its place there follow from the slot
# alone (shard_of, shard_start), the same for the host and the stages, so a
# pool grows by making shards and nothing it holds moves.

# the log2 of the first shard's slots, and the slots it holds
pub val SHARD_LOG:   u32 = 6;
pub val SHARD_FIRST: u32 = 64;
# the largest geometry: a shard of 2^17 slots of a 32-bit layer is the 2 GiB a
# stage's word index reaches (WORDS), and of the pyramids less
pub val SHARD_LOG_MAX: u32 = 17;
# the most shards a layer's cells or the pyramids lie in
pub val SHARDS_MAX: u32 = 64;
# the most layers the shard table names, cellar.layer's LAYERS_MAX
pub val SHARD_LAYERS: u32 = 8;
# addresses in the shard table: each layer's two cells' shards, then the
# pyramids'
pub val SHARD_TABLE: u32 = (SHARD_LAYERS * 2 + 1) * SHARDS_MAX;

# the bit of x's highest set bit, x nonzero
pub fun msb(x: u32) u32 {
    var n: u32 = 0;
    var v: u32 = x;
    if (v >= 0x10000) {
        n = n + 16;
        v = v >> 16;
    }
    if (v >= 0x100) {
        n = n + 8;
        v = v >> 8;
    }
    if (v >= 0x10) {
        n = n + 4;
        v = v >> 4;
    }
    if (v >= 0x4) {
        n = n + 2;
        v = v >> 2;
    }
    if (v >= 0x2) { n = n + 1; }
    ret n;
}

# the shard holding slot s under geometry m
pub fun shard_of(s: u32, m: u32) u32 {
    if (s < SHARD_FIRST) { ret 0; }
    if ((s >> m) < 2)    { ret msb(s) - SHARD_LOG + 1; }
    ret (s >> m) + m - SHARD_LOG;
}

# the first slot of shard k under geometry m
pub fun shard_start(k: u32, m: u32) u32 {
    if (k == 0)                 { ret 0; }
    if (k <= m - SHARD_LOG + 1) { ret 1 << (k + SHARD_LOG - 1); }
    ret (k + SHARD_LOG - m) << m;
}

# the shard table's entry for shard j of layer k's cells c, 0 or 1
pub fun cells_entry(k: u32, c: u32, j: u32) u32 {
    ret (k * 2 + c) * SHARDS_MAX + j;
}

# the shard table's entry for shard j of the pyramids
pub fun mip_entry(j: u32) u32 {
    ret SHARD_LAYERS * 2 * SHARDS_MAX + j;
}

# a shard's words, as a stage reaches them by address
pub rec Words {
    v: [WORDS]u32;
}

# the shard table: the address of every shard made, by entry (cells_entry,
# mip_entry), and nothing past them
pub rec Shards {
    v: [SHARD_TABLE]*Words;
}

# where a slot's span lies: its shard, and the word of it the span starts at
pub rec Span {
    p:  *Words;
    at: u32;
}

# a slot's place in the shards: the shard holding it, the same in every
# layer, and its index among the shard's slots
pub rec Where {
    shard: u32;
    index: u32;
}

# where slot lies under geometry m
pub fun where(slot: u32, m: u32) Where {
    val j: u32 = shard_of(slot, m);
    ret Where{shard: j, index: slot - shard_start(j, m)};
}

# where a slot's pyramid lies, the slot found by where
pub fun mip_span(sh: *Shards, at: Where) Span {
    ret Span{p: sh.v[mip_entry(at.shard)], at: at.index * MIP};
}

# how a step reaches past a chunk, shared by the host and the step stages
#
# a chunk's frame is its own 64 by 64 cells, and a step reads cells up to a
# rule's radius outside it. the edge word gives the window of the frame that
# lies in the world, the whole frame unless the edge of a grid that wraps cuts
# through it. a position outside the window lies to one of the eight sides of
# it, edge_side, and the entry's neighbour slot and link word for that side
# say where it is: the slot, and the transform taking the position into that
# slot's frame. on the unbounded plane a link only moves a position by a
# chunk; across a grid's seam it wraps, and on a twisted seam it also
# mirrors. a position the transform leaves outside the new frame's window is
# taken on the same way, at most HOPS times, and a missing slot on the way
# reads as zeros. a plane has no seams: it is a boundary (Domain), whose
# chunks are linked as the unbounded plane's are.
#
# a chunk whose 3 by 3 block lies whole in the world is not seamed: its links
# only move by a chunk and every window is whole, so a step may read it the
# plain way. a seamed chunk is read through the links and its cells outside
# the window are held at zero.

# the most links a position is taken through before it is found
pub val HOPS: u32 = 4;

# a link word: the transform swaps x and y, then negates x and y as the flip
# bits say, then adds the offsets, each biased by LINK_BIAS
pub val LINK_FLIP_X: u32 = 1;
pub val LINK_FLIP_Y: u32 = 2;
pub val LINK_SWAP:   u32 = 4;
# the link crosses a bounded grid's seam, so it does not move by a chunk alone
pub val LINK_SEAM: u32 = 8;
pub val LINK_BIAS: i32 = 2048;
val     LINK_OX:   u32 = 8;
val     LINK_OY:   u32 = 20;

# the link word for flip, swap and seam bits and the offsets
pub fun link(bits: u32, ox: i32, oy: i32) u32 {
    ret bits | (((ox + LINK_BIAS)::u32 & 0xfff) << LINK_OX) | (((oy + LINK_BIAS)::u32 & 0xfff) << LINK_OY);
}

# the link word toward side k (edge_side) of an unseamed chunk, a move of one
# chunk
pub fun plain_link(k: u32) u32 {
    val dx: i32 = (k % 3)::i32 - 1;
    val dy: i32 = (k / 3)::i32 - 1;
    ret link(0, 0 - dx * SIDE::i32, 0 - dy * SIDE::i32);
}

# x of the position (x, y) taken through link word t
pub fun hop_x(t: u32, x: i32, y: i32) i32 {
    var a: i32 = x;
    if ((t & LINK_SWAP) != 0)   { a = y; }
    if ((t & LINK_FLIP_X) != 0) { a = 0 - a; }
    ret a + ((t >> LINK_OX) & 0xfff)::i32 - LINK_BIAS;
}

# y of the position (x, y) taken through link word t
pub fun hop_y(t: u32, x: i32, y: i32) i32 {
    var b: i32 = y;
    if ((t & LINK_SWAP) != 0)   { b = x; }
    if ((t & LINK_FLIP_Y) != 0) { b = 0 - b; }
    ret b + ((t >> LINK_OY) & 0xfff)::i32 - LINK_BIAS;
}

# the neighbour slot n that link word t names, as the draw sees it: the chunk
# beside on the plain lattice, NONE across a seam
pub fun beside(n: u32, t: u32) u32 {
    if ((t & LINK_SEAM) != 0) { ret NONE; }
    ret n;
}

# the edge word's seamed bit, above the window's four bounds of seven bits
pub val EDGE_SEAMED: u32 = 0x80000000;
# the edge word's walled bit: the chunk holds a wall in the wall layer
# (cellar.layer WALL). it rides in the entry so it moves, is uploaded and is
# freed with the chunk, and a stage or the host reads a chunk's walls only
# where it is set. a chunk that holds a wall is never freed
pub val WALLED: u32 = 0x40000000;
# the edge word of a whole, unseamed chunk
pub val EDGE_WHOLE: u32 = 0x8002000;

# the edge word for the window [x0, x1) by [y0, y1) of a chunk's frame
pub fun edge(x0: u32, x1: u32, y0: u32, y1: u32, seamed: u32) u32 {
    var e: u32 = x0 | (x1 << 7) | (y0 << 14) | (y1 << 21);
    if (seamed != 0) { e = e | EDGE_SEAMED; }
    ret e;
}

# 1 when an edge word's chunk is seamed, else 0
pub fun seamed(e: u32) u32 {
    ret e >> 31;
}

# 1 when an edge word's chunk holds a wall, else 0
pub fun walled(e: u32) u32 {
    ret (e >> 30) & 1;
}

# the side of an edge word's window the position (x, y) of the frame lies to,
# row-major like the neighbour slots, 4 inside it
pub fun edge_side(e: u32, x: i32, y: i32) u32 {
    var sx: u32 = 1;
    var sy: u32 = 1;
    if (x < (e & 0x7f)::i32)          { sx = 0; }
    or (x >= ((e >> 7) & 0x7f)::i32)  { sx = 2; }
    if (y < ((e >> 14) & 0x7f)::i32)  { sy = 0; }
    or (y >= ((e >> 21) & 0x7f)::i32) { sy = 2; }
    ret sy * 3 + sx;
}

# the shared words, the rule family's window, then one page-table entry per
# slot of the pool's capacity: the slots of the 3 by 3 block of chunks around
# it, its chunk coordinates biased by 2^30, its incarnation, zero while the
# slot is free, a link word per neighbour slot, and the edge word. sense
# holds the running rule's, and gen, strobe and base lie at GEN_AT, STROBE_AT
# and BASE_AT. base's words are the first entry of a step's dispatch, then
# the words at WIDTH_AT, SET_AT, WIDTHS_AT, CAP_AT, SHARD_AT, LIT_AT, FOLD_AT
# and DOMAIN_ON_AT. domain, at DOMAIN_AT, is the address of the world's
# boundary where it has one, and shards, at SHARDS_AT, the address of the
# shard table. a stage's storage block has at most 16 fields, so these are
# gathered rather than one each
pub rec Meta {
    census: u32;
    hi:     u32;
    serial: u32;
    sense:  Sense;
    gen:    u32;
    strobe: u32;
    base:   [DOMAIN_AT - BASE_AT]u32;
    domain: *Domain;
    shards: *Shards;
    rule:   [RULE]u32;
    table:  [WORDS]u32;
}

# a world's boundary as the stages read it (cellar.boundary)
#
# a world with a boundary keeps two words a slot, from dom_at: the block word,
# which says which chunks of its 3 by 3 block, in the page table's neighbour
# order, lie wholly outside the boundary (DOM_OUT) and which cross its edge
# (DOM_EDGE), and the mask word, which names the chunk's mask where it
# crosses the edge itself, 0 where it lies wholly inside. a slot of a chunk
# wholly outside never exists. a mask is the chunk's cells the boundary
# holds, a bit a cell as a 1-bit layer holds them (cellar.layer), MASK words
# from mask_at. only a chunk across the edge has one, so the boundary costs
# the masks of the chunks along its edge and two words a slot, and a world
# without one costs nothing: its head's domain flag is 0 and no stage reads
# past it. a chunk that does not exist reads as zeros either way, and one of
# the block outside reads as the rule's open edge (cellar.space Block).
pub rec Domain {
    v: [WORDS]u32;
}

# the domain's head: the word its masks start at
pub val DOM_HEAD: u32 = 1;
# the domain's words a slot
pub val DOM_WORDS: u32 = 2;
# the block word's bits: block chunk q lies wholly outside at bit q, and
# crosses the edge at bit DOM_EDGE + q
pub val DOM_EDGE: u32 = 9;
# words of a chunk's mask
pub val MASK: u32 = CELLS / 32;

# the word of the domain holding slot s's block word, its mask word past it
#[inline]
pub fun dom_at(s: u32) u32 {
    ret DOM_HEAD + s * DOM_WORDS;
}

# the first word of mask m, from 1, in a domain whose masks start at first
#[inline]
pub fun mask_at(first: u32, m: u32) u32 {
    ret first + (m - 1) * MASK;
}

# 1 when a block word's chunk q lies wholly outside, else 0
#[inline]
pub fun dom_out(w: u32, q: u32) u32 {
    ret (w >> q) & 1;
}

# the slots the clear stage empties, n of them, named by the host or listed by
# the settle stage. a compaction's moves use it too (cellar.gpu compact): n
# free slots from v[0], and the slots moving into them from the far end of a
# pool of cap slots (mover_at), so the two lists never meet
pub rec List {
    n: u32;
    v: [WORDS]u32;
}

# the words of a list buffer for cap slots
pub fun list_words(cap: u32) u32 {
    ret 1 + cap;
}

# the word of a list buffer for cap slots holding the j-th slot a compaction
# moves
pub fun mover_at(cap: u32, j: u32) u32 {
    ret cap - 1 - j;
}

# the indirect arguments the steps over the active list are dispatched from,
# folded to cover its length (row), the gather's header bits, and the list's
# length, then per slot of the pool's capacity two words, each the serial of
# the last step that left a live cell and a warm one, then the active list:
# the slots the steps until the next gather may change (gather_comp), from
# list_at of the capacity on (CAP_AT)
pub rec Flags {
    args: [3]u32;
    bits: u32;
    n:    u32;
    pad:  [3]u32;
    v:    [WORDS]u32;
}

# words of a flags buffer ahead of its stamps
pub val FLAGS_HEAD: u32 = 8;

# the word of the flags buffer where the list's arguments start
pub val FLAGS_ARGS: u32 = 0;

# where the active list starts in a flags buffer's words past its arguments,
# for cap slots
pub fun list_at(cap: u32) u32 {
    ret cap * 2;
}

# the words of a flags buffer for cap slots
pub fun flags_words(cap: u32) u32 {
    ret FLAGS_HEAD + cap * 3;
}

# the gather's header bits: the GPU owns the pool, so a closed gate (Status)
# leaves the list empty, and the rule reads the edge of the world's boundary
# live on some generation, so every chunk whose block reaches it steps
# (cellar.space keep_rim)
pub val GATHER_GATED: u32 = 1;
pub val GATHER_RIM:   u32 = 2;
# cells of spread a list holds: every slot within this many cells of a live
# one at the gather is on it, so the steps over it may spread this far before
# the next gather
pub val LIST_SPREAD: u32 = SIDE;

# a rule family's rule buffer, laid out as the family packs it
pub rec Table {
    v: [TABLE_MAX]u32;
}

# painted cells of layers narrower than a word, which the edit stage writes
# into the front cells on the GPU (cellar.gpu): n edits, which cells of each
# layer are the front, 0 or 1, then each edit as four words, the slot, its
# layer above EDIT_LAYER and the word of the slot's span the cell lies in
# below, the bits the cell takes there and its value placed in them. the
# buffer holds as many as a frame paints, and the record is declared at the
# most a stage may bind
pub rec Edits {
    n:     u32;
    front: u32;
    pad:   [2]u32;
    v:     [EDITS_MAX * 4]u32;
}

# where an edit's second word holds its layer, a byte, and its guard bit: a
# guarded edit is a cell edit (cellar.sim EDIT_CELLS), which the edit stage
# drops where the cell is a wall (cellar.layer WALL)
pub val EDIT_LAYER: u32 = 16;
pub val EDIT_GUARD: u32 = 0x80000000;

# the most edits a stage's record declares
pub val EDITS_MAX: u32 = 8388608;

# the status buffer: what the GPU reports to the host, and the allocator it
# keeps while it owns the pool (cellar.gpu)
#
# the head holds the control words, then the indirect arguments the pass
# stages are dispatched from. the census rows follow,
# so a readback of the head and the rows below a pool's capacity brings back
# everything the host reads each frame. the rest is the allocator's alone: the
# pass each slot was last asked for by, the slots claimed this pass, a bit per
# free slot, and a hash from chunk coordinates to slots, each sized for the
# pool's capacity (CAP_AT) and found from it (asked_at, fresh_at, bitmap_at,
# hash_at).
#
# while the GPU owns the pool it alone writes the page table, the allocator
# words and the hash. the host writes only the words marked as its own, in
# order with the GPU's work in the frame's command stream, and takes the pool
# back only once the device is idle (see cellar.gpu take).

# words of the status head, the control words and the indirect arguments
pub val STATUS_HEAD: u32 = 24;
# the census id the frame's census was recorded under
pub val CTL_CENSUS: u32 = 0;
# nonzero once a pass could not claim every chunk it needed: no pass claims
# and no step runs after it until the host reopens it
pub val CTL_GATE: u32 = 1;
# the generations recorded before the pass that closed the gate, low bits
pub val CTL_HALT: u32 = 2;
# hash buckets a free left as tombstones
pub val CTL_TOMBS: u32 = 3;
# the last incarnation handed out
pub val CTL_SERIAL: u32 = 4;
# the host's: slots below which a pass claims, every slot the frame's stages cover
pub val CTL_TOP: u32 = 5;
# the active list's length as the census found it, which the host estimates
# the next generations' work from
pub val CTL_LISTED: u32 = 7;
# the pass header, which the host resets before every pass: slots claimed so
# far, the pass id (never 0), the serial of the step that left the front, the
# generations recorded before the pass, and the cells of spread the halo it
# leaves must hold (halo)
pub val CTL_FRESH: u32 = 8;
pub val CTL_PASS:  u32 = 9;
pub val CTL_NOW:   u32 = 10;
pub val CTL_GENS:  u32 = 11;
pub val CTL_SPAN:  u32 = 13;
# the indirect arguments of the settle stage, a row of one workgroup per 64
# slots claimed, and of the clear stage, a row per settled slot, three words
# each, folded (row). a compaction's move stage takes the clear's, a row per
# slot moving, before any pass of the frame resets them
pub val ARGS_SETTLE: u32 = 16;
pub val ARGS_CLEAR:  u32 = 19;
# the capacity a compaction packs the pool below (cellar.gpu compact): the
# host's before the pack stage, then once the relink stage has run, the same
# where every chunk lies below it, which a pass then claims below, else 0. 0
# is no compaction, as a buffer made zeroed holds, and the host writes it
# whenever it seeds the hash again
pub val CTL_TRIM: u32 = 22;
# slots at or past CTL_TRIM in use that a compaction's pack stage listed to
# move, or the host's moves (cellar.gpu relocate)
pub val CTL_MOVES: u32 = 23;
# census words per slot: the packed count, the extent, and the coordinates
pub val ROW: u32 = 4;
# a hash bucket nothing ever held, which ends a probe
pub val EMPTY: u32 = 0xffffffff;
# a hash bucket whose slot was freed, which a probe passes and a claim reuses
pub val TOMB: u32 = 0xfffffffe;

# the head, then the census rows, ROW words a slot, and past them the
# allocator's words, each from the word its function names on
pub rec Status {
    head: [STATUS_HEAD]u32;
    v:    [WORDS]u32;
}

# where the pass each slot was last asked for by starts, a word a slot, in a
# status buffer for cap slots
pub fun asked_at(cap: u32) u32 {
    ret cap * ROW;
}

# where the slots claimed this pass start, a word each
pub fun fresh_at(cap: u32) u32 {
    ret cap * (ROW + 1);
}

# where the free bits start, a bit a slot
pub fun bitmap_at(cap: u32) u32 {
    ret cap * (ROW + 2);
}

# where the hash's buckets start
pub fun hash_at(cap: u32) u32 {
    ret bitmap_at(cap) + (cap + 31) / 32;
}

# buckets of the GPU's hash for cap slots: a power of two, at least four a slot
pub fun buckets(cap: u32) u32 {
    if (cap <= 1) { ret 4; }
    ret 1 << (msb(cap - 1) + 3);
}

# words of a status buffer past its head for cap slots
pub fun status_words(cap: u32) u32 {
    ret hash_at(cap) + buckets(cap);
}

# the first bucket a chunk's biased coordinates probe from, of n, a power of two
pub fun bucket(bx: u32, by: u32, n: u32) u32 {
    var h: u32 = (bx * 0x9e3779b1) ^ (by * 0x85ebca77);
    h = h ^ (h >> 15);
    h = h * 0x2c1b3c6d;
    h = h ^ (h >> 12);
    ret h & (n - 1);
}

test link__takes_a_position_through_every_transform_and_back {
    # a plain link east moves a chunk left in the neighbour's frame
    if (hop_x(plain_link(5), 65, 3) != 1 || hop_y(plain_link(5), 65, 3) != 3) { ret 1; }
    # a flip and a swap, as a sphere's seam would take
    val t: u32 = link(LINK_SWAP | LINK_FLIP_X | LINK_SEAM, 63, -64);
    if (hop_x(t, 5, 70) != -7 || hop_y(t, 5, 70) != -59)       { ret 2; }
    if (beside(3, t) != NONE || beside(3, plain_link(1)) != 3) { ret 3; }
    val e: u32 = edge(14, 64, 0, 50, 1);
    if (seamed(e) != 1 || seamed(EDGE_WHOLE) != 0)                                          { ret 4; }
    if (walled(e | WALLED) != 1 || walled(e) != 0 || seamed(e | WALLED) != 1)               { ret 8; }
    if (edge_side(e | WALLED, 14, 49) != 4)                                                 { ret 9; }
    if (edge(0, 64, 0, 64, 0) != EDGE_WHOLE)                                                { ret 5; }
    if (edge_side(e, 13, 0) != 3 || edge_side(e, 14, 49) != 4 || edge_side(e, 20, 50) != 7) { ret 6; }
    if (edge_side(e, 64, -1) != 2)                                                          { ret 7; }
    ret 0;
}

test fold__covers_every_row_and_runs_past_the_last_by_less_than_a_fold {
    val folds: [3]u32 = [3]u32{1, 7, 65535};
    val rows:  [5]u32 = [5]u32{0, 6, 7, 65535, 200000};
    var i:     u32    = 0;
    for (i < 3) {
        var j: u32 = 0;
        for (j < 5) {
            val f: u32 = folds[i];
            val r: u32 = rows[j];
            val y: u32 = fold_y(r, f);
            val z: u32 = fold_z(r, f);
            # the last workgroup's row is at or past r, and every row below it
            # is some workgroup's: y holds a whole fold wherever z steps
            val top: u32 = row(y - 1, z - 1, f);
            if (y > f || top < r || top - r >= f) { ret 1; }
            if (z > 1 && y != f)                  { ret 2; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test shard__finds_every_slot_in_the_shard_that_holds_it {
    var m: u32 = SHARD_LOG;
    for (m <= SHARD_LOG_MAX) {
        # each shard starts where the last ends, doubling up to the geometry
        if (shard_start(0, m) != 0 || shard_start(1, m) != SHARD_FIRST) { ret 1; }
        var k: u32 = 1;
        for (k < SHARDS_MAX) {
            val lo:  u32 = shard_start(k, m);
            val hi:  u32 = shard_start(k + 1, m);
            val big: u32 = 1 << m;
            if (hi <= lo || hi - lo > big)                                            { ret 2; }
            if (lo >= big && hi - lo != big)                                          { ret 3; }
            if (shard_of(lo, m) != k || shard_of(hi - 1, m) != k)                     { ret 4; }
            if (shard_of(lo + (hi - lo) / 2, m) != k || shard_of(lo - 1, m) != k - 1) { ret 5; }
            k = k + 1;
        }
        m = m + 1;
    }
    if (shard_of(0, 10) != 0 || shard_of(SHARD_FIRST - 1, 10) != 0) { ret 6; }
    # a pool that doubles from the first shard adds one a doubling
    if (shard_start(3, 12) != 256 || shard_start(7, 12) != 4096 || shard_start(8, 12) != 8192 || shard_start(9, 12) != 12288) { ret 7; }
    if (msb(1) != 0 || msb(0x80000000) != 31 || msb(4095) != 11)                                                              { ret 8; }
    # a status buffer's parts follow one another, the hash a power of two
    if (buckets(64) != 256 || buckets(65) != 512 || hash_at(64) != 64 * 6 + 2) { ret 9; }
    ret 0;
}
