# every allocated chunk as one quad, placed from its page-table entry
#
# instance n is slot n. a free slot collapses to a point. the view block holds
# the chunk the camera centre lies in, biased like the table's coordinates, the
# centre's offset inside it in cells, the pixels per cell and half the
# viewport, so positions stay exact however far the camera travels.

# the camera and the colours; the vertex stage reads the camera
rec View {
    base_cx: u32;
    base_cy: u32;
    mode:    u32;
    gutter:  u32;
    frac_x:  f32;
    frac_y:  f32;
    ppc:     f32;
    half_w:  f32;
    half_h:  f32;
    win_w:   f32;
    pad1:    u32;
    pad2:    u32;
    solid:   f32x4;
    back:    f32x4;
    heat:    [256]f32x4;
    age:     [256]f32x4;
}

use cellar.layout;
use cellar.layout.Meta;

#[storage(1, 1, "readonly")]
var meta: Meta;
#[storage(1, 2, "readonly")]
var view: View;

#[builtin("vertex_index")]
var vertex:   u32;
#[builtin("instance_index")]
var instance: u32;
#[builtin("position")]
var position: f32x4;

#[output(0)]
var out_local: f32x2;
#[output(1)]
var out_slot:  u32;

#[stage("vertex")]
fun vert_main() {
    val base: u32 = instance * layout.ENTRY;
    out_slot = instance;
    if (meta.table[base + 11] == 0) {
        out_local = f32x2{0.0, 0.0};
        position  = f32x4{2.0, 2.0, 0.5, 1.0};
        ret;
    }
    var ux: f32 = 0.0;
    var uy: f32 = 0.0;
    if (vertex == 1 || vertex == 2 || vertex == 4) { ux = 64.0; }
    if (vertex == 2 || vertex == 4 || vertex == 5) { uy = 64.0; }
    val cx: i32 = meta.table[base + 9]::i32 - view.base_cx::i32;
    val cy: i32 = meta.table[base + 10]::i32 - view.base_cy::i32;
    val wx: f32 = (cx * 64)::f32 + ux - view.frac_x;
    val wy: f32 = (cy * 64)::f32 + uy - view.frac_y;
    out_local = f32x2{ux, uy};
    # the view is the window's left half_w * 2 pixels, so x is placed in window pixels
    position = f32x4{(wx * view.ppc + view.half_w) * 2.0 / view.win_w - 1.0, wy * view.ppc / view.half_h, 0.5, 1.0};
}
