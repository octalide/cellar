# write painted cells into a layer narrower than a word, on the GPU
#
# a cell painted while the GPU steps goes up as an edit (cellar.layout.Edits):
# the word of the layer it lies in, the bits it takes there and its value in
# them. an invocation applies one, clearing the cell's bits and setting its
# value with atomics on the word, so edits of cells that share a word, applied
# at once by other invocations, leave each other alone, and the host need not
# hold the word's other cells as the GPU holds them. the host sends a cell's
# last edit alone, and a dispatch for each layer edits it.

use cellar.layout.Edits;
use cellar.layout.Layer;
use at: shader.atomic;
use sy: shader.sync;

#[storage(1, 0)]
var cells: Layer;
#[storage(1, 1, "readonly")]
var edits: Edits;

#[builtin("global_invocation")]
var gid: u32x3;

val DEV: u32 = sy.SCOPE_DEVICE;
val RX:  u32 = sy.SEMANTICS_RELAXED;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val i: u32 = gid[0];
    if (i >= edits.n) { ret; }
    val w: u32 = edits.v[i * 3];
    val m: u32 = edits.v[i * 3 + 1];
    at.atomic_and_u32(?cells.v[w], DEV, RX, ~m);
    at.atomic_or_u32(?cells.v[w], DEV, RX, edits.v[i * 3 + 2] & m);
}
