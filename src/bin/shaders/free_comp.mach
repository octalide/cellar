# free every chunk no pass needs any more, while the GPU owns the pool
#
# runs once a frame, in its first pass, after the mark stage. an invocation is
# one slot below the top: a chunk the step left nothing warm in at the front,
# that no live chunk asked for this pass, is freed as space.release frees one.
# a stamp of the next serial, left by a generation an edit started over,
# keeps a chunk too, as the census counts it.
# its bucket in the hash becomes a tombstone, each neighbour stops naming it,
# its entry is zeroed and its free bit set. a neighbour freed alongside writes
# into an entry being zeroed, which is free either way.

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.layout.Status;
use at: shader.atomic;
use sy: shader.sync;

#[storage(1, 0)]
var meta:   Meta;
#[storage(1, 1)]
var status: Status;
#[storage(1, 2, "readonly")]
var flags:  Flags;

#[builtin("global_invocation")]
var gid: u32x3;

val DEV: u32 = sy.SCOPE_DEVICE;
val BUF: u32 = sy.SEMANTICS_UNIFORM_MEMORY;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val s: u32 = gid[0];
    val e: u32 = s * layout.ENTRY;
    if (s >= status.head[layout.CTL_TOP] || meta.table[e + layout.INCARNATION_AT] == 0) { ret; }
    # while the gate is closed the steps since it closed were voided, and the
    # stamps are older than the serial in the header, so nothing is freed
    if (status.head[layout.CTL_GATE] != 0) { ret; }
    val cap: u32 = meta.base[layout.CAP_AT - layout.BASE_AT];
    val now: u32 = status.head[layout.CTL_NOW];
    if (status.v[layout.asked_at(cap) + s] == status.head[layout.CTL_PASS]) { ret; }
    val a: u32 = flags.v[s * 2];
    val w: u32 = flags.v[s * 2 + 1];
    if (a == now || a == now + 1 || w == now || w == now + 1) { ret; }
    val bx: u32 = meta.table[e + 9];
    val by: u32 = meta.table[e + 10];
    val n:  u32 = layout.buckets(cap);
    val h:  u32 = layout.hash_at(cap);
    var b:  u32 = layout.bucket(bx, by, n);
    for (at.atomic_load_u32(?status.v[h + b], DEV, sy.SEMANTICS_ACQUIRE | BUF) != s) { b = (b + 1) & (n - 1); }
    at.atomic_store_u32(?status.v[h + b], DEV, sy.SEMANTICS_RELEASE | BUF, layout.TOMB);
    at.atomic_add_u32(?status.head[layout.CTL_TOMBS], DEV, sy.SEMANTICS_RELAXED, 1);
    var k: u32 = 0;
    for (k < 9) {
        val n: u32 = meta.table[e + k];
        if (k != 4 && n != layout.NONE) { meta.table[n * layout.ENTRY + 8 - k] = layout.NONE; }
        k = k + 1;
    }
    k = 0;
    for (k < layout.ENTRY) {
        meta.table[e + k] = 0;
        k                 = k + 1;
    }
    at.atomic_or_u32(?status.v[layout.bitmap_at(cap) + s / 32], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF, 1 << (s % 32));
}
