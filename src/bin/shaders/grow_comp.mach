# carry the stamps into another pool's flags buffer: the cells lie in shards
# that a growth only adds to and a compaction only lets go past every chunk
# (cellar.layout, cellar.gpu compact), so the stamps are all that move. an
# invocation is a slot of the smaller pool's capacity, a row of 64 of them a
# workgroup (cellar.layout row), both found in the smaller pool's meta head.

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;

#[storage(1, 0, "readonly")]
var fsrc: Flags;
#[storage(1, 1)]
var fdst: Flags;
#[storage(1, 2, "readonly")]
var meta: Meta;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]) * 64 + gid[0];
    if (slot >= meta.base[layout.CAP_AT - layout.BASE_AT]) { ret; }
    fdst.v[slot * 2]     = fsrc.v[slot * 2];
    fdst.v[slot * 2 + 1] = fsrc.v[slot * 2 + 1];
}
