# carry the stamps into a larger pool's flags buffer: the cells lie in shards
# that a growth only adds to (cellar.layout), so the stamps are all that move.
# an invocation is a slot below the top, rounded up to whole workgroups, which
# a capacity of whole shards of SHARD_FIRST slots holds.

use cellar.layout.Flags;

#[storage(1, 0, "readonly")]
var fsrc: Flags;
#[storage(1, 1)]
var fdst: Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[0];
    fdst.v[slot * 2]     = fsrc.v[slot * 2];
    fdst.v[slot * 2 + 1] = fsrc.v[slot * 2 + 1];
}
