# carry the world into a larger pool: every slot's cells from the old front
# pool into the new one, and its stamps. the new back pool starts at zero,
# which is what the step expects of a chunk it has been skipping.

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Layer;

#[storage(1, 0, "readonly")]
var src:  Layer;
#[storage(1, 1)]
var dst:  Layer;
#[storage(1, 2, "readonly")]
var fsrc: Flags;
#[storage(1, 3)]
var fdst: Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[1];
    val i:    u32 = gid[0];
    dst.v[slot * layout.CELLS + i] = src.v[slot * layout.CELLS + i];
    if (i < 2) { fdst.v[slot * 2 + i] = fsrc.v[slot * 2 + i]; }
}
