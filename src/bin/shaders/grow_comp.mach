# carry the world into a larger pool: every slot's span of one layer from the
# old front pool into the new one, and its stamps. the new back pool starts at
# zero, which is what the step expects of a chunk it has been skipping.
#
# workgroup y names the slot and x a run of 64 words of its span (cellar.layer),
# so the dispatch's workgroups along x cover a span and say how wide the layer
# is. a dispatch for each layer carries it.

use cellar.layer;
use cellar.layout.Flags;
use cellar.layout.Layer;

#[storage(1, 0, "readonly")]
var src:  Layer;
#[storage(1, 1)]
var dst:  Layer;
#[storage(1, 2, "readonly")]
var fsrc: Flags;
#[storage(1, 3)]
var fdst: Flags;

#[builtin("global_invocation")]
var gid:    u32x3;
#[builtin("num_workgroups")]
var groups: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot:  u32 = gid[1];
    val i:     u32 = gid[0];
    val width: u32 = layer.width_of(groups[0] * 64);
    val at:    u32 = layer.span_at(width, slot) + i;
    dst.v[at] = src.v[at];
    if (i < 2) { fdst.v[slot * 2 + i] = fsrc.v[slot * 2 + i]; }
}
