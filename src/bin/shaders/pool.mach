# how the shared stages read a cell beside its state layer: through the live
# rule layers and the shown layer the meta head's set word names
# (cellar.layer), each reached by address through the shard table, so a set
# holds as many as cellar.layer allows whatever the device binds

use cellar.layer;
use cellar.layout;

# the live rule layers' values of cell i of the slot at, in their cells c, or'd:
# zero where none makes it live
# ---
# sh:     the shard table
# set:    the meta head's set word
# widths: the meta head's widths word
# c:      the cells read, 0 or 1
# at:     where the slot lies
# i:      the cell
pub fun more(sh: *layout.Shards, set: u32, widths: u32, c: u32, at: layout.Where, i: u32) u32 {
    var v:    u32 = 0;
    var rest: u32 = layer.set_lives(set) >> 1;
    var k:    u32 = 1;
    for (rest != 0) {
        if ((rest & 1) != 0) {
            val w: u32         = layer.width_in(widths, k);
            val s: layout.Span = layer.span(sh, k, c, at, w);
            v = v | layer.read(s.p.v[s.at + layer.cell_word(w, i)], w, i);
        }
        rest = rest >> 1;
        k    = k + 1;
    }
    ret v;
}

# the sensed value (cellar.layer sensed) of cell i of the slot at, whose state
# layer's value is v, read at width w, through its shown layer's cells c
pub fun sensed(sh: *layout.Shards, set: u32, widths: u32, c: u32, at: layout.Where, v: u32, w: u32, i: u32) u32 {
    val k: u32 = layer.set_shown(set);
    var s: u32 = v;
    if (k != 0) {
        val hw: u32         = layer.width_in(widths, k);
        val h:  layout.Span = layer.span(sh, k, c, at, hw);
        s = layer.sensed(v, layer.read(h.p.v[h.at + layer.cell_word(hw, i)], hw, i), w);
    }
    ret s;
}

# a slot's 3 by 3 block of chunks in one layer's cells, in the page table's
# neighbour order: each one's shard, as its entry in the shard table, and the
# word its span starts at there, held where a step reads its neighbours a
# cell at a time. the arrays lie in a record, as the SPIR-V target asks of an
# array a loop indexes, and hold no address, which a local could only start
# from as a 64-bit integer
pub rec Block {
    e:  [9]u32;
    at: [9]u32;
}

# the block of a slot whose neighbours are nb, in layer k's cells c at a
# width under the pool's geometry m; a neighbour that does not exist is left
# unset, and never read
pub fun block(m: u32, nb: Nine, k: u32, c: u32, width: u32) Block {
    var b: Block;
    var j: u32 = 0;
    for (j < 9) {
        val n: u32 = nb.v[j];
        b.e[j]  = 0;
        b.at[j] = 0;
        if (n != layout.NONE) {
            val at: layout.Where = layout.where(n, m);
            b.e[j]  = layout.cells_entry(k, c, at.shard);
            b.at[j] = at.index * layer.span_words(width);
        }
        j = j + 1;
    }
    ret b;
}

# a slot's nine neighbour slots, itself in the middle, as its page-table entry
# names them
pub rec Nine {
    v: [9]u32;
}

# cell i's value in neighbour j of a block, at a width, the block's shards
# named by the shard table sh
pub fun read(sh: *layout.Shards, b: Block, j: u32, width: u32, i: u32) u32 {
    val p: *layout.Words = sh.v[b.e[j]];
    ret layer.read(p.v[b.at[j] + layer.cell_word(width, i)], width, i);
}

# the cell a step reaches past its chunk: its slot, NONE where no chunk holds
# it, and the cell there
pub rec Spot {
    slot: u32;
    i:    u32;
}

# cell i's value in slot's span of layer k's cells c, at a width
pub fun cell(sh: *layout.Shards, m: u32, k: u32, c: u32, slot: u32, width: u32, i: u32) u32 {
    val s: layout.Span = layer.span(sh, k, c, layout.where(slot, m), width);
    ret layer.read(s.p.v[s.at + layer.cell_word(width, i)], width, i);
}

# a slot's part of the world's boundary as the stages read it
# (layout.Domain): its block word, 0 where its block lies wholly inside or the
# world has no boundary, and the first word of its mask, 0 where it has none
pub rec Dom {
    block: u32;
    mask:  u32;
}

# a slot's part of the boundary, where the head's domain flag on says the
# world has one
pub fun dom_of(d: *layout.Domain, on: u32, slot: u32) Dom {
    var o: Dom = Dom{block: 0, mask: 0};
    if (on != 0) {
        val at: u32 = layout.dom_at(slot);
        o.block = d.v[at];
        val k: u32 = d.v[at + 1];
        if (k != 0) { o.mask = layout.mask_at(d.v[0], k); }
    }
    ret o;
}

# word w of the mask from word mask, a row's first or second, every cell
# inside where mask is 0
pub fun dom_word(d: *layout.Domain, mask: u32, w: u32) u32 {
    var v: u32 = 0xffffffff;
    if (mask != 0) { v = d.v[mask + w]; }
    ret v;
}

# the cells of word w of block chunk q inside the boundary, of a block whose
# block word is block: none where q lies wholly outside, every one where its
# slot n is NONE, since a chunk across the edge that a step reads exists
pub fun dom_bits(d: *layout.Domain, on: u32, block: u32, q: u32, n: u32, w: u32) u32 {
    var v: u32 = 0xffffffff;
    if (layout.dom_out(block, q) != 0) { v = 0; }
    or (n != layout.NONE) {
        val o: Dom = dom_of(d, on, n);
        v = dom_word(d, o.mask, w);
    }
    ret v;
}

# 1 when cell i of block chunk q lies inside the boundary, as dom_bits
pub fun dom_in(d: *layout.Domain, on: u32, block: u32, q: u32, n: u32, i: u32) u32 {
    ret (dom_bits(d, on, block, q, n, i / 32) >> (i % 32)) & 1;
}

# 1 when cell i of a chunk whose mask starts at word mask lies inside the
# boundary, every cell where mask is 0
pub fun dom_cell(d: *layout.Domain, mask: u32, i: u32) u32 {
    ret (dom_word(d, mask, i / 32) >> (i % 32)) & 1;
}
