# what each chunk holds after the frame's last generation, for the host
#
# the warm stamp says which chunks the last step or upload left warm, and a
# live chunk is always warm, so only those are counted. a generation the host
# split across frames may be part way through the next step, whose serial is
# one past and which leaves the stamp of a chunk it keeps warm at its own, so
# a stamp of either serial counts; the next step's stamp on a chunk cold here
# only has its zeros counted.
#
# an invocation is one slot. it counts the chunk's live cells, notes whether
# any cell is still warm, both as the rule family's sense in the meta head reads
# a cell, records the columns and rows the live cells span and the quadrants
# they lie in, from which the host works out the halo they need
# (cellar.space.halo), and copies the slot's
# incarnation so the host can tell a report about a slot it has since freed and
# reused. every invocation also writes the census id the host set, the same
# value from each, so the host knows which census a readback carries.

# the census id, then two words per slot: live cells in bits 0 to 12, warm in
# bit 13 and the low 18 bits of the incarnation above, then the live cells'
# extent (cellar.layout.extent) and the quadrants they lie in
rec Status {
    head: [4]u32;
    v:    [layout.MAX_SLOTS * 2]u32;
}

use cellar.layout;
use cellar.layout.Cells;
use cellar.layout.Flags;
use cellar.layout.Meta;

#[storage(1, 0, "readonly")]
var cells:  Cells;
#[storage(1, 1, "readonly")]
var meta:   Meta;
#[storage(1, 2)]
var status: Status;
#[storage(1, 3, "readonly")]
var flags:  Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[0];
    status.head[0] = meta.census;
    if (slot >= meta.hi) { ret; }
    val inc:   u32 = meta.table[slot * layout.ENTRY + layout.INCARNATION_AT];
    var live:  u32 = 0;
    var warm:  u32 = 0;
    var quads: u32 = 0;
    var x0:    u32 = 63;
    var y0:    u32 = 63;
    var x1:    u32 = 0;
    var y1:    u32 = 0;
    # a chunk no step or upload has stamped with the current serial, or the
    # next step's, is cold and empty, and needs no count
    val f: u32 = flags.v[slot * 2 + 1];
    if (inc != 0 && (f == meta.serial || f == meta.serial + 1)) {
        var i: u32 = 0;
        for (i < layout.CELLS) {
            val c: u32 = cells.v[slot * layout.CELLS + i];
            if (layout.live(c, meta.live_mask, meta.live_lo, meta.live_hi) != 0) {
                live = live + 1;
                val x: u32 = i & (layout.SIDE - 1);
                val y: u32 = i / layout.SIDE;
                quads = quads | layout.quadrant(x, y);
                if (x < x0) { x0 = x; }
                if (y < y0) { y0 = y; }
                if (x > x1) { x1 = x; }
                if (y > y1) { y1 = y; }
            }
            if ((c & meta.warm_mask) != 0) { warm = 1; }
            i = i + 1;
        }
    }
    var ext: u32 = 0;
    if (live != 0) { ext = layout.extent(x0, y0, x1, y1) | (quads << layout.EXTENT_QUADS); }
    status.v[slot * 2]     = live | (warm << 13) | ((inc & 0x3ffff) << 14);
    status.v[slot * 2 + 1] = ext;
}
