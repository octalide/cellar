# what each chunk holds after the frame's last generation, for the host
#
# the warm stamp says which chunks the last step or upload left warm, and a
# live chunk is always warm, so only those are counted. a generation the host
# split across frames may be part way through the next step, whose serial is
# one past and which leaves the stamp of a chunk it keeps warm at its own, so
# a stamp of either serial counts; the next step's stamp on a chunk cold here
# only has its zeros counted.
#
# a workgroup is one slot. an invocation reads four cells of a row at once,
# sixteen invocations side by side cover a row, and the workgroup four rows a
# step. an invocation counts its live cells, notes whether any cell is still
# warm, both as the rule family's sense in the meta head reads a cell, and the
# columns and rows its live cells span and the quadrants they lie in. the
# workgroup reduces those in shared memory with atomics, which every vulkan
# device has, so the census needs no device feature. the first invocation
# then writes the slot's row: the count, the extent and its quadrants, from
# which the host works out the halo they need (cellar.space.halo), and the
# slot's incarnation and its chunk's coordinates, so the host can tell a
# report about a slot it has since freed and reused, and place a chunk the GPU
# allocated without reading its page table. every workgroup also writes the census id
# the host set, the same value from each, so the host knows which census a
# readback carries, and the active list's length, which the host estimates the
# next generations' work from.
#
# a slot's row (cellar.layout.ROW words): live cells in bits 0 to 12, warm in
# bit 13 and the low 18 bits of the incarnation above, then the live cells'
# extent (cellar.layout.extent) and the quadrants they lie in, then the chunk's
# biased coordinates

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.layout.Status;
use at: shader.atomic;
use sy: shader.sync;

# the cells four at a time
rec Quads {
    v: [layout.MAX_SLOTS * layout.CELLS / 4]u32x4;
}

#[storage(1, 0, "readonly")]
var cells:  Quads;
#[storage(1, 1, "readonly")]
var meta:   Meta;
#[storage(1, 2)]
var status: Status;
#[storage(1, 3, "readonly")]
var flags:  Flags;

# the workgroup's sums as its invocations reduce them
rec Tally {
    live:  u32;
    warm:  u32;
    quads: u32;
    x0:    u32;
    y0:    u32;
    x1:    u32;
    y1:    u32;
}

#[shared]
var tally: Tally;

#[builtin("workgroup_id")]
var wid: u32x3;
#[builtin("local_invocation_index")]
var lid: u32;

val WG: u32 = sy.SCOPE_WORKGROUP;
val RX: u32 = sy.SEMANTICS_RELAXED;

# 1 where a cell is live, as the rule family's sense in the meta head reads it
fun alive(c: u32) u32 {
    ret layout.live(c, meta.live_mask, meta.live_lo, meta.live_hi);
}

# the lowest and highest set bit of a nonzero 4-bit mask
fun low(m: u32) u32 {
    if ((m & 1) != 0) { ret 0; }
    if ((m & 2) != 0) { ret 1; }
    if ((m & 4) != 0) { ret 2; }
    ret 3;
}

fun high(m: u32) u32 {
    if ((m & 8) != 0) { ret 3; }
    if ((m & 4) != 0) { ret 2; }
    if ((m & 2) != 0) { ret 1; }
    ret 0;
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = wid[1];
    if (lid == 0) {
        status.head[layout.CTL_CENSUS] = meta.census;
        status.head[layout.CTL_LISTED] = flags.args[1];
    }
    if (slot >= meta.hi) { ret; }
    val inc:   u32 = meta.table[slot * layout.ENTRY + layout.INCARNATION_AT];
    var live:  u32 = 0;
    var warm:  u32 = 0;
    var quads: u32 = 0;
    var x0:    u32 = 63;
    var y0:    u32 = 63;
    var x1:    u32 = 0;
    var y1:    u32 = 0;
    # a chunk no step or upload has stamped with the current serial, or the
    # next step's, is cold and empty, and needs no count
    val f: u32 = flags.v[slot * 2 + 1];
    if (inc != 0 && (f == meta.serial || f == meta.serial + 1)) {
        val cx:   u32 = (lid & 15) * 4;
        val base: u32 = (slot * layout.CELLS + cx) / 4;
        var y:    u32 = lid >> 4;
        for (y < layout.SIDE) {
            val q: u32x4 = cells.v[base + y * (layout.SIDE / 4)];
            val m: u32   = alive(q[0]) | (alive(q[1]) << 1) | (alive(q[2]) << 2) | (alive(q[3]) << 3);
            if (m != 0) {
                live  = live + (m & 1) + ((m >> 1) & 1) + ((m >> 2) & 1) + ((m >> 3) & 1);
                quads = quads | layout.quadrant(cx, y);
                val lo: u32 = cx + low(m);
                val hi: u32 = cx + high(m);
                if (lo < x0) { x0 = lo; }
                if (hi > x1) { x1 = hi; }
                if (y < y0)  { y0 = y; }
                y1 = y;
            }
            if (((q[0] | q[1] | q[2] | q[3]) & meta.warm_mask) != 0) { warm = 1; }
            y = y + 4;
        }
    }
    if (lid == 0) {
        tally.live  = 0;
        tally.warm  = 0;
        tally.quads = 0;
        tally.x0    = 63;
        tally.y0    = 63;
        tally.x1    = 0;
        tally.y1    = 0;
    }
    sy.workgroup_barrier();
    if (live != 0) {
        at.atomic_add_u32(?tally.live, WG, RX, live);
        at.atomic_or_u32(?tally.quads, WG, RX, quads);
        at.atomic_min_u32(?tally.x0, WG, RX, x0);
        at.atomic_min_u32(?tally.y0, WG, RX, y0);
        at.atomic_max_u32(?tally.x1, WG, RX, x1);
        at.atomic_max_u32(?tally.y1, WG, RX, y1);
    }
    if (warm != 0) { at.atomic_or_u32(?tally.warm, WG, RX, 1); }
    sy.workgroup_barrier();
    if (lid == 0) {
        val n:   u32 = tally.live;
        var ext: u32 = 0;
        if (n != 0) { ext = layout.extent(tally.x0, tally.y0, tally.x1, tally.y1) | (tally.quads << layout.EXTENT_QUADS); }
        val row: u32 = slot * layout.ROW;
        status.rows[row]     = n | (tally.warm << 13) | ((inc & 0x3ffff) << 14);
        status.rows[row + 1] = ext;
        status.rows[row + 2] = meta.table[slot * layout.ENTRY + 9];
        status.rows[row + 3] = meta.table[slot * layout.ENTRY + 10];
    }
}
