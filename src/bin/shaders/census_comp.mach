# what each chunk holds after the frame's last generation, for the host
#
# the warm stamp says which chunks the last step or upload left warm, and a
# live chunk is always warm, so only those are counted. a generation the host
# split across frames may be part way through the next step, whose serial is
# one past and which leaves the stamp of a chunk it keeps warm at its own, so
# a stamp of either serial counts; the next step's stamp on a chunk cold here
# only has its zeros counted.
#
# a workgroup is one slot, its row (cellar.layout row). a cell is its sensed value, its value in the state
# layer with its shown layer's above it, at the widths the meta head holds
# (cellar.layer), every layer read at the front by address. an invocation
# reads four words of
# the slot's span at a time, the workgroup 256 words a step, and a word of
# zeros holds nothing to count but where a live rule layer may hold more. an
# invocation counts its live cells, notes whether any cell is still warm,
# both as the rule family's sense in the meta head reads a cell and as its
# live rule layers make one live (cellar.layer), and the columns and rows its
# live cells span and the quadrants they lie in. the workgroup reduces those
# in shared memory with atomics, which every vulkan device has, so the census
# needs no device feature. the first invocation
# then writes the slot's row: the count, the extent and its quadrants, from
# which the host works out the halo they need (cellar.space.halo), and the
# slot's incarnation and its chunk's coordinates, so the host can tell a
# report about a slot it has since freed and reused, and place a chunk the GPU
# allocated without reading its page table. every workgroup also writes the census id
# the host set, the same value from each, so the host knows which census a
# readback carries, and the active list's length, which the host estimates the
# next generations' work from.
#
# a slot's row (cellar.layout.ROW words): live cells in bits 0 to 12, warm in
# bit 13 and the low 18 bits of the incarnation above, then the live cells'
# extent (cellar.layout.extent) and the quadrants they lie in, then the chunk's
# biased coordinates

use cellar.bin.shaders.pool;
use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.layout.Status;
use at: shader.atomic;
use sy: shader.sync;

#[storage(1, 0, "readonly")]
var meta:   Meta;
#[storage(1, 1)]
var status: Status;
#[storage(1, 2, "readonly")]
var flags:  Flags;

# the workgroup's sums as its invocations reduce them
rec Tally {
    live:  u32;
    warm:  u32;
    quads: u32;
    x0:    u32;
    y0:    u32;
    x1:    u32;
    y1:    u32;
}

#[shared]
var tally: Tally;

#[builtin("workgroup_id")]
var wid: u32x3;
#[builtin("local_invocation_index")]
var lid: u32;

val WG: u32 = sy.SCOPE_WORKGROUP;
val RX: u32 = sy.SEMANTICS_RELAXED;

# 1 where a cell is live, as the rule family's sense in the meta head reads it
fun alive(c: u32) u32 {
    ret layout.live(c, meta.sense.live_mask, meta.sense.live_lo, meta.sense.live_hi);
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = layout.row(wid[1], wid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]);
    if (lid == 0) {
        status.head[layout.CTL_CENSUS] = meta.census;
        status.head[layout.CTL_LISTED] = flags.n;
    }
    if (slot >= meta.hi) { ret; }
    val inc:   u32 = meta.table[slot * layout.ENTRY + layout.INCARNATION_AT];
    var live:  u32 = 0;
    var warm:  u32 = 0;
    var quads: u32 = 0;
    var x0:    u32 = 63;
    var y0:    u32 = 63;
    var x1:    u32 = 0;
    var y1:    u32 = 0;
    # a chunk no step or upload has stamped with the current serial, or the
    # next step's, is cold and empty, and needs no count
    val f: u32 = flags.v[slot * 2 + 1];
    if (inc != 0 && (f == meta.serial || f == meta.serial + 1)) {
        val w:      u32            = meta.base[layout.WIDTH_AT - layout.BASE_AT];
        val set:    u32            = meta.base[layout.SET_AT - layout.BASE_AT];
        val widths: u32            = meta.base[layout.WIDTHS_AT - layout.BASE_AT];
        val front:  u32            = meta.serial & 1;
        val sh:     *layout.Shards = meta.shards;
        val place:  layout.Where   = layout.where(slot, meta.base[layout.SHARD_AT - layout.BASE_AT]);
        val cells:  layout.Span    = layer.span(sh, 0, front, place, w);
        val per:    u32            = layer.per_word(w);
        val words:  u32            = layer.span_words(w);
        # a word of zeros in the state layer holds nothing to count where no
        # other layer may make a cell live or warm
        var lives: u32 = 0;
        if (layer.set_lives(set) != 0 || layer.set_shown(set) != 0) { lives = 1; }
        var q: u32 = lid * 4;
        for (q < words) {
            var e: u32 = 0;
            for (e < 4) {
                val word: u32 = cells.p.v[cells.at + q + e];
                if (word != 0 || lives != 0) {
                    val first: u32 = (q + e) * per;
                    val y:     u32 = first / layout.SIDE;
                    var k:     u32 = 0;
                    for (k < per) {
                        val i: u32 = first + k;
                        val c: u32 = pool.sensed(sh, set, widths, front, place, layer.read(word, w, i), w, i);
                        val m: u32 = pool.more(sh, set, widths, front, place, i);
                        if (alive(c) != 0 || m != 0) {
                            val x: u32 = i % layout.SIDE;
                            live  = live + 1;
                            quads = quads | layout.quadrant(x, y);
                            if (x < x0) { x0 = x; }
                            if (x > x1) { x1 = x; }
                            if (y < y0) { y0 = y; }
                            if (y > y1) { y1 = y; }
                        }
                        if ((c & meta.sense.warm_mask) != 0 || m != 0) { warm = 1; }
                        k = k + 1;
                    }
                }
                e = e + 1;
            }
            q = q + 256;
        }
    }
    if (lid == 0) {
        tally.live  = 0;
        tally.warm  = 0;
        tally.quads = 0;
        tally.x0    = 63;
        tally.y0    = 63;
        tally.x1    = 0;
        tally.y1    = 0;
    }
    sy.workgroup_barrier();
    if (live != 0) {
        at.atomic_add_u32(?tally.live, WG, RX, live);
        at.atomic_or_u32(?tally.quads, WG, RX, quads);
        at.atomic_min_u32(?tally.x0, WG, RX, x0);
        at.atomic_min_u32(?tally.y0, WG, RX, y0);
        at.atomic_max_u32(?tally.x1, WG, RX, x1);
        at.atomic_max_u32(?tally.y1, WG, RX, y1);
    }
    if (warm != 0) { at.atomic_or_u32(?tally.warm, WG, RX, 1); }
    sy.workgroup_barrier();
    if (lid == 0) {
        val n:   u32 = tally.live;
        var ext: u32 = 0;
        if (n != 0) { ext = layout.extent(tally.x0, tally.y0, tally.x1, tally.y1) | (tally.quads << layout.EXTENT_QUADS); }
        val row: u32 = slot * layout.ROW;
        status.v[row]     = n | (tally.warm << 13) | ((inc & 0x3ffff) << 14);
        status.v[row + 1] = ext;
        status.v[row + 2] = meta.table[slot * layout.ENTRY + 9];
        status.v[row + 3] = meta.table[slot * layout.ENTRY + 10];
    }
}
