# what each chunk holds after the frame's last generation, for the host
#
# the warm stamp says which chunks the last step or upload left warm, and a
# live chunk is always warm, so only those are counted.
#
# an invocation is one slot. it counts the chunk's live cells, notes whether
# any cell is still warm, and sets a bit for each neighbour a live cell lies
# near enough to reach within the reach the host budgets, and copies the slot's
# incarnation so the host can
# tell a report about a slot it has since freed and reused. every invocation
# also writes the census id the host set, the same value from each, so the host
# knows which census a readback carries.

rec Cells {
    v: [134217728]u32;
}

rec Meta {
    radius:     u32;
    birth_lo:   u32;
    birth_hi:   u32;
    survive_lo: u32;
    survive_hi: u32;
    census:     u32;
    hi:         u32;
    serial:     u32;
    weights:    [88]u32;
    table:      [393216]u32;
}

# per slot: the serial of the last step that left it alive, and warm
rec Flags {
    v: [65536]u32;
}

# the census id, then two words per slot: live cells in bits 0 to 12, warm in
# bit 13 and the low 18 bits of the incarnation above, then the neighbour mask
rec Status {
    head: [4]u32;
    v:    [65536]u32;
}

#[storage(1, 0, "readonly")]
var cells:  Cells;
#[storage(1, 1, "readonly")]
var meta:   Meta;
#[storage(1, 2)]
var status: Status;
#[storage(1, 3, "readonly")]
var flags:  Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[0];
    status.head[0] = meta.census;
    if (slot >= meta.hi) { ret; }
    val inc:  u32 = meta.table[slot * 12 + 11];
    var live: u32 = 0;
    var warm: u32 = 0;
    var mask: u32 = 0;
    # a chunk no step or upload has stamped with the current serial is cold
    # and empty, and needs no count
    val f: u32 = flags.v[slot * 2 + 1];
    if (inc != 0 && f == meta.serial) {
        var i: u32 = 0;
        for (i < 4096) {
            val c: u32 = cells.v[slot * 4096 + i];
            if (c >= 256) {
                live = live + 1;
                val x:  u32 = i & 63;
                val y:  u32 = i >> 6;
                var wl: u32 = 0;
                var er: u32 = 0;
                var nt: u32 = 0;
                var sb: u32 = 0;
                if (x < 32)  { wl = 1; }
                if (x >= 32) { er = 1; }
                if (y < 32)  { nt = 1; }
                if (y >= 32) { sb = 1; }
                # the bits are the page-table entry's neighbour words
                mask = mask | (wl << 3) | (er << 5) | (nt << 1) | (sb << 7);
                mask = mask | (wl * nt) | ((er * nt) << 2) | ((wl * sb) << 6) | ((er * sb) << 8);
            }
            if ((c & 255) != 0) { warm = 1; }
            i = i + 1;
        }
    }
    status.v[slot * 2]     = live | (warm << 13) | ((inc & 0x3ffff) << 14);
    status.v[slot * 2 + 1] = mask;
}
