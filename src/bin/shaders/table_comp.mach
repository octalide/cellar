# one generation of the chunks on the active list, under the table family
# (cellar.rules.table)
#
# a cell is its value in the family's state layer, read and written at the
# width the family declares (word.WIDTH, cellar.layer), and an invocation
# builds the words its run of cells fills before it writes them.
#
# an invocation is a run of 8 cells in a row, and 8 workgroups of 64 cover a
# chunk; workgroup y names the chunk's slot through the active list
# (cellar.layout.Flags). a cell's next state is found by walking the rule's
# decision tree in the rule buffer at layout.TABLE_BINDING: from the root, take
# the child for the state of each input in turn, the positions the window of the
# meta head lists, and the last child is the next state. the neighbourhood is
# read straight from the source pool through the chunk's page-table entry, so a
# chunk that does not exist reads as state 0. a cell is heat << 8 | state, and
# every state but 0 is live.
#
# each step stamps, per slot, the step's serial into an alive and a warm word
# when the chunk's result holds a live cell, as the other families' stages do.
# a chunk with no live cell in its 3 by 3 block holds only zeros and steps to
# zeros, since the empty neighbourhood steps to 0 under every table, and one
# cold the step before too already holds zeros in both pools and is skipped.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Layer;
use cellar.layout.Meta;
use cellar.layout.Table;
use cellar.rules.table.word;

#[storage(1, 0, "readonly")]
var src:   Layer;
#[storage(1, 1)]
var dst:   Layer;
#[storage(1, 2, "readonly")]
var meta:  Meta;
#[storage(1, 3)]
var flags: Flags;
#[storage(1, 4, "readonly")]
var table: Table;

#[builtin("global_invocation")]
var gid: u32x3;

# the source's value of the cell at address a in the family's state layer
# (cellar.layer)
fun cell_of(a: u32) u32 {
    ret layer.read(src.v[layer.addr_word(word.WIDTH, a)], word.WIDTH, a);
}

# the address (cellar.layer) of the cell at (x, y) of a slot's frame, taken
# through the links where it lies outside the window (cellar.layout), or NONE
# where no chunk holds it
fun reach(slot: u32, x: i32, y: i32) u32 {
    var sl: u32 = slot;
    var px: i32 = x;
    var py: i32 = y;
    var at: u32 = layout.NONE;
    var h:  u32 = 0;
    for (h <= layout.HOPS) {
        val b: u32 = sl * layout.ENTRY;
        val k: u32 = layout.edge_side(meta.table[b + layout.EDGE_AT], px, py);
        val n: u32 = meta.table[b + k];
        if (k == 4) {
            at = layer.addr(sl, (py * layout.SIDE::i32 + px)::u32);
            h  = layout.HOPS;
        }
        or (n == layout.NONE) { h = layout.HOPS; }
        or {
            val t:  u32 = meta.table[b + layout.LINK_AT + k];
            val nx: i32 = layout.hop_x(t, px, py);
            py = layout.hop_y(t, px, py);
            px = nx;
            sl = n;
        }
        h = h + 1;
    }
    ret at;
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    # workgroup y names an entry of the active list past the dispatch's base,
    # and a dispatch may run past the list's end
    val entry: u32 = gid[1] + meta.base[0];
    if (entry >= flags.args[1]) { ret; }
    val slot: u32 = flags.list[entry];
    val ly:   i32 = (gid[0] / 8)::i32;
    val x0:   u32 = (gid[0] % 8) * 8;
    val base: u32 = slot * layout.ENTRY;
    val row:  u32 = layer.addr(slot, (ly * layout.SIDE::i32)::u32);
    var acc:  u32 = 0;
    if (meta.table[base + layout.INCARNATION_AT] == 0) { ret; }
    # a seamed chunk reads its block through its links, and holds its cells
    # off the grid at zero
    val edge:   u32 = meta.table[base + layout.EDGE_AT];
    val seamed: u32 = layout.seamed(edge);

    # the serial that produced the source, or this step's where a stamp this
    # step already wrote replaced it
    val last: u32 = meta.serial - 1;
    val now:  u32 = meta.serial;
    var busy: u32 = 0;
    var k:    u32 = 0;
    for (k < 9) {
        val nb: u32 = meta.table[base + k];
        if (nb != layout.NONE) {
            val f: u32 = flags.v[nb * 2];
            if (f == last || f == now) { busy = 1; }
        }
        k = k + 1;
    }
    if (seamed != 0) { busy = 1; }
    var x: u32 = x0;
    if (busy == 0) {
        val warm: u32 = flags.v[slot * 2 + 1];
        if (warm != last && warm != now) {
            # all zeros at the source; if it was a step earlier too, the
            # destination already holds zeros
            if (warm != last - 1) { ret; }
            for (x < x0 + 8) {
                dst.v[layer.addr_word(word.WIDTH, row + x)] = 0;
                x                                           = x + 1;
            }
            ret;
        }
    }

    val n:      u32 = meta.rule[word.STATES_AT];
    val inputs: u32 = meta.rule[word.INPUTS_AT];
    val root:   u32 = meta.rule[word.ROOT_AT];
    var live:   u32 = 0;
    for (x < x0 + 8) {
        var p: u32 = root;
        var i: u32 = 0;
        for (i < inputs) {
            val pos: u32 = meta.rule[word.AT_AT + i];
            val dx:  i32 = (pos % 3)::i32 - 1;
            val dy:  i32 = (pos / 3)::i32 - 1;
            var y:   i32 = ly + dy;
            var cy:  u32 = 1;
            if (y < 0) {
                y  = y + layout.SIDE::i32;
                cy = 0;
            }
            or (y >= layout.SIDE::i32) {
                y  = y - layout.SIDE::i32;
                cy = 2;
            }
            var xx: i32 = x::i32 + dx;
            var cx: u32 = 1;
            if (xx < 0) {
                xx = xx + layout.SIDE::i32;
                cx = 0;
            }
            or (xx >= layout.SIDE::i32) {
                xx = xx - layout.SIDE::i32;
                cx = 2;
            }
            var at: u32 = layout.NONE;
            if (seamed != 0) { at = reach(slot, x::i32 + dx, ly + dy); }
            or {
                val nb: u32 = meta.table[base + cy * 3 + cx];
                if (nb != layout.NONE) { at = layer.addr(nb, (y * layout.SIDE::i32 + xx)::u32); }
            }
            var st: u32 = 0;
            if (at != layout.NONE) { st = cell_of(at) & word.STATE_MASK; }
            p = table.v[p + st];
            i = i + 1;
        }
        var next: u32 = p;
        if (seamed != 0 && layout.edge_side(edge, x::i32, ly) != 4) { next = 0; }
        if (next != 0)                                              { live = 1; }
        acc = acc | layer.place(word.WIDTH, row + x, word.word(next, n));
        if (layer.ends(word.WIDTH, row + x) != 0) {
            dst.v[layer.addr_word(word.WIDTH, row + x)] = acc;
            acc                                         = 0;
        }
        x = x + 1;
    }
    if (live != 0) {
        flags.v[slot * 2]     = now;
        flags.v[slot * 2 + 1] = now;
    }
}
