# the cell under each pixel of a chunk's quad, coloured by the view's mode
#
# the colours arrive already in the space the target stores, so the stage only
# picks one: the backdrop for a dead cold cell, the solid colour or the age
# palette for a live one, and the fire ramp over heat for trails. with grid
# lines on and cells large enough, the last pixel of each cell shows the
# backdrop.

rec Cells {
    v: [134217728]u32;
}

rec View {
    base_cx: u32;
    base_cy: u32;
    mode:    u32;
    gutter:  u32;
    frac_x:  f32;
    frac_y:  f32;
    ppc:     f32;
    half_w:  f32;
    half_h:  f32;
    win_w:   f32;
    pad1:    u32;
    pad2:    u32;
    solid:   f32x4;
    back:    f32x4;
    heat:    [256]f32x4;
    age:     [256]f32x4;
}

#[storage(1, 0, "readonly")]
var cells: Cells;
#[storage(1, 2, "readonly")]
var view:  View;

#[input(0)]
var in_local: f32x2;
#[input(1)]
var in_slot:  u32;

#[output(0)]
var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    var lx: u32 = in_local[0]::u32;
    var ly: u32 = in_local[1]::u32;
    if (lx > 63) { lx = 63; }
    if (ly > 63) { ly = 63; }
    val c:    u32 = cells.v[in_slot * 4096 + ly * 64 + lx];
    val age:  u32 = c >> 8;
    val heat: u32 = c & 255;

    var col: f32x4 = view.back;
    if (view.mode == 1) {
        if (heat != 0) { col = view.heat[heat]; }
    }
    or (age != 0) {
        col = view.solid;
        if (view.mode == 2) {
            # the palette runs over the first 255 generations and holds after
            var k: u32 = age;
            if (k > 255) { k = 255; }
            col = view.age[k];
        }
    }
    if (view.gutter != 0 && view.ppc >= 4.0) {
        val fx: f32 = (in_local[0] - lx::f32) * view.ppc;
        val fy: f32 = (in_local[1] - ly::f32) * view.ppc;
        if (fx > view.ppc - 1.0 || fy > view.ppc - 1.0) { col = view.back; }
    }
    out_colour = col;
}
