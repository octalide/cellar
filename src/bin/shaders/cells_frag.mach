# a chunk's quad, coloured by the view's mode
#
# the colours arrive already in the space the target stores, so the stage only
# picks one: the backdrop for a dead cold cell, the solid colour or the age
# palette for a live one, and the fire ramp over heat for trails. a rule with
# colours of its own (the view's ink flag) draws a live cell in the solid mode
# in its rule palette's colour for the cell's heat, which is the state's place
# in the palette. a cell is its sensed value, its value in the pool's state
# layer with its value in the shown layer above it, each read at the width the
# meta head holds (cellar.layer), and what is live and where the heat and age
# channels lie in it, the rule family's sense in the meta head says.
#
# at a pixel per cell or more a pixel shows the cell under its centre, and with
# grid lines on and cells large enough, the last pixel of each cell shows the
# backdrop. a drawn cell that stands for a square of cells (the view's shift)
# holds the share of them alive and the hottest heat among them
# (layout.SUMMARY_LIVE), and shows them as a pixel's footprint of cells would
# be shown. below that a pixel shows every cell its footprint covers: it reads
# the coarsest level of the coverage pyramid (cellar.layout.Mip) whose texels
# are no wider than a pixel, and takes each texel whose centre lies inside the
# pixel, reaching into neighbouring chunks through the page table. every texel
# then belongs to exactly one pixel, so a pattern never falls between pixels as
# it moves. live cells are drawn over the backdrop by their density, never
# fainter than a lone cell, in the solid colour or the mean age's; trails show
# the hottest cell's colour.
#
# a generation whose cells hold the world's complement (cellar.layout's strobe
# flag, on an odd generation) is drawn inverted in every mode: a held dead cell
# and every cell of a chunk that does not exist show the solid colour, and a
# held live one the backdrop, since heat and age mean nothing for the cells
# the complement holds.

# the look, then the palettes: the trail ramp over heat at 0, the age palette
# at 256 and the rule palette over heat at 512. port holds the port's left and
# top in the window, and the window's width and height
rec View {
    base_cx: u32;
    base_cy: u32;
    mode:    u32;
    gutter:  u32;
    frac_x:  f32;
    frac_y:  f32;
    ppc:     f32;
    half_w:  f32;
    half_h:  f32;
    shift:   u32;
    ink:     u32;
    pad:     u32;
    port:    f32x4;
    solid:   f32x4;
    back:    f32x4;
    pal:     [768]f32x4;
}

use cellar.layer;
use cellar.layout;
use cellar.layout.Layer;
use cellar.layout.Meta;
use cellar.layout.Mip;

#[storage(1, 0, "readonly")]
var cells: Layer;
#[storage(1, 1, "readonly")]
var meta:  Meta;
#[storage(1, 2, "readonly")]
var view:  View;
#[storage(1, 3, "readonly")]
var mip:   Mip;
#[storage(1, 4, "readonly")]
var shown: Layer;

#[builtin("frag_coord")]
var frag: f32x4;

#[input(0)]
var in_local: f32x2;
#[input(1)]
var in_slot:  u32;

#[output(0)]
var out_colour: f32x4;

# the least share of the live colour a pixel with any live cell shows
val FLOOR: f32 = 0.45;
# how quickly the share rises with density: half way at this density
val KNEE: f32 = 0.2;

fun floor_i(x: f32) i32 {
    val t: i32 = x::i32;
    if (t::f32 > x) { ret t - 1; }
    ret t;
}

# a over b, rounded down, for b positive
fun div_down(a: i32, b: i32) i32 {
    val q: i32 = a / b;
    if (a < 0 && q * b != a) { ret q - 1; }
    ret q;
}

# the sensed value of cell i of a slot, at the widths the meta head holds
# (cellar.layer)
fun cell(slot: u32, i: u32) u32 {
    val w:  u32 = meta.base[layout.WIDTH_AT - layout.BASE_AT];
    val hw: u32 = layer.live_width(meta.base[layout.LIVE_AT - layout.BASE_AT], layer.SHOWN_SLOT);
    val v:  u32 = layer.read(cells.v[layer.cell_at(w, slot, i)], w, i);
    if (hw == 0) { ret v; }
    ret layer.sensed(v, layer.read(shown.v[layer.cell_at(hw, slot, i)], hw, i), w);
}

# the share of the live colour for cells this dense
fun cover(d: f32) f32 {
    ret FLOOR + (1.0 - FLOOR) * d * (1.0 + KNEE) / (d + KNEE);
}

# 1 when the cells hold the world's complement: the rule strobes and the
# generation drawn, one past the last step's source, is odd
fun flipped() u32 {
    if (meta.strobe == 0) { ret 0; }
    ret (meta.gen + meta.serial + 1) & 1;
}

# the colour of cells summarised as the draw below a pixel per cell takes them
# ---
# share: the part of them alive, 0 to 1
# heat:  the most heat any carries
# age:   the live ones' mean texel age
fun summed(share: f32, heat: u32, age: u32) f32x4 {
    if (view.mode == 1) {
        if (heat != 0) { ret view.pal[heat]; }
        ret view.back;
    }
    if (share <= 0.0) { ret view.back; }
    var col: f32x4 = view.solid;
    if (view.ink != 0)  { col = view.pal[512 + heat]; }
    if (view.mode == 2) { col = view.pal[256 + age]; }
    val a: f32 = cover(share);
    ret view.back + (col - view.back) * f32x4{a, a, a, 1.0};
}

# the colour of a pixel at a pixel per cell or more
fun sample() f32x4 {
    var lx: u32 = in_local[0]::u32;
    var ly: u32 = in_local[1]::u32;
    if (lx > layout.SIDE - 1) { lx = layout.SIDE - 1; }
    if (ly > layout.SIDE - 1) { ly = layout.SIDE - 1; }
    val c: u32 = cell(in_slot, ly * layout.SIDE + lx);
    if (view.shift != 0) {
        # a square of cells summarised, the share of them alive and the hottest
        val share: f32 = (c & layout.SUMMARY_LIVE)::f32 / layout.SUMMARY_LIVE::f32;
        ret summed(share, (c >> layout.SUMMARY_HEAT) & layout.HEAT_CAP, 0);
    }
    val heat: u32 = layout.texel_heat(c, meta.heat_shift, meta.heat_mask);

    var col: f32x4 = view.back;
    if (flipped() != 0) {
        if (layout.live(c, meta.live_mask, meta.live_lo, meta.live_hi) == 0) { col = view.solid; }
    }
    or (view.mode == 1) {
        if (heat != 0) { col = view.pal[heat]; }
    }
    or (layout.live(c, meta.live_mask, meta.live_lo, meta.live_hi) != 0) {
        col = view.solid;
        if (view.ink != 0) { col = view.pal[512 + heat]; }
        # the palette runs over the first 255 generations and holds after
        if (view.mode == 2) { col = view.pal[256 + layout.texel_age(c, meta.age_shift, meta.age_mask)]; }
    }
    if (view.gutter != 0 && view.ppc >= 4.0) {
        val fx: f32 = (in_local[0] - lx::f32) * view.ppc;
        val fy: f32 = (in_local[1] - ly::f32) * view.ppc;
        if (fx > view.ppc - 1.0 || fy > view.ppc - 1.0) { col = view.back; }
    }
    ret col;
}

# the colour of a pixel below a pixel per cell, from what its footprint covers
fun coverage() f32x4 {
    # the level whose texels, s cells wide, are the widest no wider than a pixel
    val f: f32 = 1.0 / view.ppc;
    var l: u32 = 0;
    var s: i32 = 1;
    for (l < layout.LEVELS && (s * 2)::f32 <= f) {
        l = l + 1;
        s = s * 2;
    }
    val side: i32 = layout.mip_side(l)::i32;
    val at:   u32 = layout.mip_at(l);

    # the pixel's edges in cells from the corner of the camera's chunk. a pixel
    # centre lies half way between whole pixels, and the next pixel's edge is
    # worked out from the same whole number, so pixels meet exactly
    val kx:  f32 = frag[0] - 0.5 - view.port[0];
    val ky:  f32 = frag[1] - 0.5 - view.port[1];
    val x0:  f32 = (kx - view.half_w) / view.ppc + view.frac_x;
    val x1:  f32 = (kx + 1.0 - view.half_w) / view.ppc + view.frac_x;
    val y0:  f32 = (ky - view.half_h) / view.ppc + view.frac_y;
    val y1:  f32 = (ky + 1.0 - view.half_h) / view.ppc + view.frac_y;
    val tx0: i32 = floor_i(x0 / s::f32);
    val ty0: i32 = floor_i(y0 / s::f32);

    val base: u32 = in_slot * layout.ENTRY;
    val cx:   i32 = meta.table[base + 9]::i32 - view.base_cx::i32;
    val cy:   i32 = meta.table[base + 10]::i32 - view.base_cy::i32;
    val half: f32 = s::f32 * 0.5;
    var live: u32 = 0;
    var heat: u32 = 0;
    var ages: u32 = 0;
    var seen: u32 = 0;
    var ty:   i32 = ty0;
    for ((ty * s)::f32 + half < y1) {
        val my: f32 = (ty * s)::f32 + half;
        if (my >= y0) {
            val qy: i32 = div_down(ty, side);
            val ly: i32 = ty - qy * side;
            var tx: i32 = tx0;
            for ((tx * s)::f32 + half < x1) {
                val mx: f32 = (tx * s)::f32 + half;
                if (mx >= x0) {
                    val qx: i32 = div_down(tx, side);
                    val lx: i32 = tx - qx * side;
                    seen = seen + (s * s)::u32;
                    # the chunk holding the texel is this one or a neighbour,
                    # since a pixel is narrower than a chunk
                    val dx: i32 = qx - cx;
                    val dy: i32 = qy - cy;
                    var n:  u32 = layout.NONE;
                    if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) {
                        val k: u32 = ((dy + 1) * 3 + dx + 1)::u32;
                        n = layout.beside(meta.table[base + k], meta.table[base + layout.LINK_AT + k]);
                    }
                    if (n != layout.NONE) {
                        var t: u32 = 0;
                        if (l == 0) {
                            val c: u32 = cell(n, (ly * side + lx)::u32);
                            val a: u32 = layout.live(c, meta.live_mask, meta.live_lo, meta.live_hi);
                            t = layout.texel(a, layout.texel_heat(c, meta.heat_shift, meta.heat_mask),
                                a * layout.texel_age(c, meta.age_shift, meta.age_mask));
                        }
                        or { t = mip.v[n * layout.MIP + at + (ly * side + lx)::u32]; }
                        val tl: u32 = t & layout.TEXEL_LIVE;
                        val th: u32 = (t >> layout.TEXEL_HEAT) & layout.HEAT_CAP;
                        live = live + tl;
                        ages = ages + tl * (t >> layout.TEXEL_AGE);
                        if (th > heat) { heat = th; }
                    }
                }
                tx = tx + 1;
            }
        }
        ty = ty + 1;
    }

    if (flipped() != 0) {
        # every cell the pixel covers that is not held live is live, those of
        # chunks that do not exist included
        if (seen == 0)    { ret view.solid; }
        if (live >= seen) { ret view.back; }
        val on: f32 = cover((seen - live)::f32 / seen::f32);
        ret view.back + (view.solid - view.back) * f32x4{on, on, on, 1.0};
    }
    var share: f32 = 0.0;
    var age:   u32 = 0;
    if (seen != 0) { share = live::f32 / seen::f32; }
    if (live != 0) { age = ages / live; }
    ret summed(share, heat, age);
}

#[stage("fragment")]
fun frag_main() {
    if (view.ppc >= 1.0) { out_colour = sample(); }
    or                   { out_colour = coverage(); }
}
