# list the slots the steps until the next gather may change, the active list
# the step stages are dispatched over (cellar.layout.Flags)
#
# an invocation is one slot below the head's top, a row of 64 of them a
# workgroup (cellar.layout row). the host resets the list's length and
# arguments and sets the header bits before each gather, and sets the meta
# serial to the next step's, so the stamps are read as that step reads them. a
# slot is listed when it was warm at the front or the step before it, so it
# cools or is cleared, when a slot its step reads holds a live cell, or when it
# is seamed under a rule that reads a plane's dead edge live, or holds a wall
# under a rule whose background flips, which holds it as its complement anew
# each step (cellar.layer WALL). a step reads the
# 3 by 3 block of its chunk through the entry, and a seamed chunk through its
# links too, which can pass through a chunk not whole on the grid into the one
# beyond, so a seamed slot looks at its neighbours' neighbours as well. a live
# cell then lies more than a chunk away from every slot left off, so no step
# changes one of those before the spread since the gather passes
# layout.LIST_SPREAD: each of them holds zeros in both cells, as it would step
# to. while the GPU owns the pool, a closed gate leaves the list empty, since
# the steps after it were voided (mark_comp).

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.layout.Status;
use at: shader.atomic;
use sy: shader.sync;

#[storage(1, 0, "readonly")]
var meta:   Meta;
#[storage(1, 1)]
var flags:  Flags;
#[storage(1, 2, "readonly")]
var status: Status;

#[builtin("global_invocation")]
var gid: u32x3;

# 1 when slot n exists and a step left a live cell in it at the front, or the
# next step already did
fun alive(n: u32) u32 {
    var on: u32 = 0;
    if (n != layout.NONE) {
        val f: u32 = flags.v[n * 2];
        if (f == meta.serial - 1 || f == meta.serial) { on = 1; }
    }
    ret on;
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val fold: u32 = meta.base[layout.FOLD_AT - layout.BASE_AT];
    val s:    u32 = layout.row(gid[1], gid[2], fold) * 64 + gid[0];
    if (s >= meta.hi) { ret; }
    val e: u32 = s * layout.ENTRY;
    if (meta.table[e + layout.INCARNATION_AT] == 0) { ret; }
    val bits: u32 = flags.bits;
    if ((bits & layout.GATHER_GATED) != 0) {
        if (status.head[layout.CTL_GATE] != 0) { ret; }
    }
    val last:   u32 = meta.serial - 1;
    val warm:   u32 = flags.v[s * 2 + 1];
    val edge:   u32 = meta.table[e + layout.EDGE_AT];
    val seamed: u32 = layout.seamed(edge);
    var busy:   u32 = 0;
    if (warm == last || warm == meta.serial || warm == last - 1) { busy = 1; }
    if (meta.strobe != 0 && layout.walled(edge) != 0)            { busy = 1; }
    if (seamed != 0) {
        if ((bits & layout.GATHER_RIM) != 0) { busy = 1; }
    }
    # as is a chunk whose block reaches the world's boundary
    if ((bits & layout.GATHER_RIM) != 0) {
        if (meta.base[layout.DOMAIN_ON_AT - layout.BASE_AT] != 0) {
            val dom: *layout.Domain = meta.domain;
            if (dom.v[layout.dom_at(s)] != 0) { busy = 1; }
        }
    }
    var k: u32 = 0;
    for (k < 9) {
        val n: u32 = meta.table[e + k];
        busy = busy | alive(n);
        if (seamed != 0) {
            if (n != layout.NONE) {
                var j: u32 = 0;
                for (j < 9) {
                    busy = busy | alive(meta.table[n * layout.ENTRY + j]);
                    j    = j + 1;
                }
            }
        }
        k = k + 1;
    }
    if (busy != 0) {
        # the steps' arguments are raised to cover the entry, folded as they
        # fold an entry's row
        val i: u32 = at.atomic_add_u32(?flags.n, sy.SCOPE_DEVICE, sy.SEMANTICS_RELAXED, 1);
        flags.v[layout.list_at(meta.base[layout.CAP_AT - layout.BASE_AT]) + i] = s;
        at.atomic_max_u32(?flags.args[1], sy.SCOPE_DEVICE, sy.SEMANTICS_RELAXED, layout.fold_y(i, fold));
        at.atomic_max_u32(?flags.args[2], sy.SCOPE_DEVICE, sy.SEMANTICS_RELAXED, layout.fold_z(i, fold));
    }
}
