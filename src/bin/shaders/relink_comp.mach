# rename the chunks a compaction moved in every entry naming them, while the
# GPU owns the pool (cellar.gpu compact), and say whether the pool now lies
# below the capacity it packed into
#
# an invocation is one slot below the top, a row of 64 of them a workgroup
# (cellar.layout row). a slot in use names the chunk itself at word 4 of its
# entry, and a slot a chunk moved out of names the slot it moved to there
# (move_comp), so each neighbour a slot in use names is renamed to the slot
# its entry names at word 4, which is itself unless it moved. the first
# invocation then leaves the capacity in layout.CTL_TRIM where every slot
# moving found a free one, so every chunk lies below it and a pass claims
# below it (mark_comp), else 0.

use cellar.layout;
use cellar.layout.List;
use cellar.layout.Meta;
use cellar.layout.Status;

#[storage(1, 0)]
var meta:   Meta;
#[storage(1, 1)]
var status: Status;
#[storage(1, 2, "readonly")]
var list:   List;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val s: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]) * 64 + gid[0];
    if (s == 0 && status.head[layout.CTL_MOVES] > list.n) { status.head[layout.CTL_TRIM] = 0; }
    if (s >= status.head[layout.CTL_TOP])                 { ret; }
    val e: u32 = s * layout.ENTRY;
    if (meta.table[e + layout.INCARNATION_AT] == 0) { ret; }
    var k: u32 = 0;
    for (k < 9) {
        val n: u32 = meta.table[e + k];
        if (k != 4 && n != layout.NONE) { meta.table[e + k] = meta.table[n * layout.ENTRY + 4]; }
        k = k + 1;
    }
}
