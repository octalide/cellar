# zero the frame's steps while the gate is closed
#
# the host uploads the arguments of every step a frame records before
# recording them, not knowing whether a pass of an earlier frame still in
# flight closed the gate (see mark_comp). this runs first, so while the gate is
# closed no step of the frame runs, until the host reopens it.

use cellar.layout;
use cellar.layout.Status;

#[storage(1, 0)]
var status: Status;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    if (status.head[layout.CTL_GATE] == 0) { ret; }
    var i: u32 = gid[0];
    for (i < layout.STEP_CALLS * 3) {
        status.head[layout.ARGS_STEP + i] = 0;
        i                                 = i + 64;
    }
}
