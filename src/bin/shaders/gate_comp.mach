# empty the active list while the gate is closed
#
# the steps a frame records over a list gathered by an earlier frame are
# recorded not knowing whether a pass of a frame still in flight closed the
# gate (see mark_comp). this runs first, so while the gate is closed no step of
# the frame finds a slot to step, until the host reopens it; a gather after a
# pass that closes it leaves the list empty itself (gather_comp).

use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Status;

#[storage(1, 0, "readonly")]
var status: Status;
#[storage(1, 1)]
var flags:  Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    if (gid[0] != 0)                       { ret; }
    if (status.head[layout.CTL_GATE] != 0) { flags.args[1] = 0; }
}
