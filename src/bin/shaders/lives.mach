# the live rule layers of the running rule (cellar.layer), as the variants of
# the stages that judge a cell live read them beside the state layer: the
# census's, the mark's and the reduce's built for a rule whose family declares
# any. each is bound at its source buffer from layer.LIVE_BINDING on, a buffer
# bound past the last live one being any the stage may read and never read,
# and the meta head's live word names their widths (cellar.layout.LIVE_AT)

use cellar.layer;
use cellar.layout.Layer;

$if (layer.LIVE_MAX != 3 || layer.LIVE_BINDING != 4) {
    $error("the live rule layers' bindings below are not the contract's");
}

#[storage(1, 4, "readonly")]
var live0: Layer;
#[storage(1, 5, "readonly")]
var live1: Layer;
#[storage(1, 6, "readonly")]
var live2: Layer;

# the live rule layers' values of the cell at address a (cellar.layer addr),
# or'd: zero where none makes it live
# ---
# code: the meta head's live word
# a:    the cell's address
pub fun more(code: u32, a: u32) u32 {
    var v:  u32 = 0;
    val w0: u32 = layer.live_width(code, 0);
    val w1: u32 = layer.live_width(code, 1);
    val w2: u32 = layer.live_width(code, 2);
    if (w0 != 0) { v = v | layer.read(live0.v[layer.addr_word(w0, a)], w0, a); }
    if (w1 != 0) { v = v | layer.read(live1.v[layer.addr_word(w1, a)], w1, a); }
    if (w2 != 0) { v = v | layer.read(live2.v[layer.addr_word(w2, a)], w2, a); }
    ret v;
}
