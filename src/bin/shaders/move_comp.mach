# move chunks into free slots below the capacity a compaction packs the pool
# into (cellar.gpu compact, relocate): the j-th slot of the move list's movers
# into its j-th free slot (layout.List, layout.mover_at), every word of the
# slot going with it. a mover past the free slots listed stays where it is.
#
# the workgroup's row (cellar.layout row) names a mover, and x a run of 64
# words, the dispatch's workgroups along x covering the widest span and the
# pyramid (layout.MIP). each layer's two cells are copied, reached by address,
# and the pyramid, so the chunk reads at its new slot as it did at its old
# one, whatever a step left in either cells. the first invocation copies the
# slot's stamps, the pass that last asked for it and its page-table entry,
# which names the new slot as the chunk itself, and leaves the old entry free
# with only that word kept, the slot the chunk moved to, which the relink
# stage follows to rename it in every entry naming it.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.List;
use cellar.layout.Meta;
use cellar.layout.Status;

#[storage(1, 0)]
var meta:   Meta;
#[storage(1, 1)]
var status: Status;
#[storage(1, 2, "readonly")]
var list:   List;
#[storage(1, 3)]
var flags:  Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val j: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]);
    if (j >= status.head[layout.CTL_MOVES] || j >= list.n) { ret; }
    val cap:    u32          = meta.base[layout.CAP_AT - layout.BASE_AT];
    val m:      u32          = meta.base[layout.SHARD_AT - layout.BASE_AT];
    val from:   u32          = list.v[layout.mover_at(cap, j)];
    val to:     u32          = list.v[j];
    val widths: u32          = meta.base[layout.WIDTHS_AT - layout.BASE_AT];
    val n:      u32          = layer.set_layers(meta.base[layout.SET_AT - layout.BASE_AT]);
    val src:    layout.Where = layout.where(from, m);
    val dst:    layout.Where = layout.where(to, m);
    val x:      u32          = gid[0];
    var k:      u32          = 0;
    for (k < n) {
        val width: u32 = layer.width_in(widths, k);
        if (x < layer.span_words(width)) {
            var c: u32 = 0;
            for (c < 2) {
                val a: layout.Span = layer.span(meta.shards, k, c, src, width);
                val b: layout.Span = layer.span(meta.shards, k, c, dst, width);
                b.p.v[b.at + x] = a.p.v[a.at + x];
                c               = c + 1;
            }
        }
        k = k + 1;
    }
    if (x < layout.MIP) {
        val a: layout.Span = layout.mip_span(meta.shards, src);
        val b: layout.Span = layout.mip_span(meta.shards, dst);
        b.p.v[b.at + x] = a.p.v[a.at + x];
    }
    if (x == 0) {
        flags.v[to * 2]     = flags.v[from * 2];
        flags.v[to * 2 + 1] = flags.v[from * 2 + 1];
        val asked: u32 = layout.asked_at(cap);
        status.v[asked + to] = status.v[asked + from];
        val e: u32 = from * layout.ENTRY;
        val d: u32 = to * layout.ENTRY;
        var i: u32 = 0;
        for (i < layout.ENTRY) {
            meta.table[d + i] = meta.table[e + i];
            meta.table[e + i] = 0;
            i                 = i + 1;
        }
        meta.table[d + 4] = to;
        meta.table[e + 4] = to;
    }
}
