# one generation of the chunks on the active list, under the test-only trace
# family (cellar.rules.trace): a cell keeps its state, and its trace counts
# down to zero
#
# the state layer is bound at bindings 0 and 1 and the trace layer, its one
# rule layer, at its own (cellar.layer binding). an invocation is a run of 8
# cells of a row, building the words of each layer they fill, and 8 workgroups
# of 64 cover a chunk; workgroup y names the chunk's slot through the active
# list (cellar.layout.Flags). a cell reads no neighbour, so a chunk is stepped
# from its own cells alone, and one whose result holds a live cell, by its
# state or its trace, is stamped live and warm.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Layer;
use cellar.layout.Meta;
use cellar.rules.trace.word;

#[storage(1, 0, "readonly")]
var src:    Layer;
#[storage(1, 1)]
var dst:    Layer;
#[storage(1, 2, "readonly")]
var meta:   Meta;
#[storage(1, 3)]
var flags:  Flags;
#[storage(1, 4, "readonly")]
var traced: Layer;
#[storage(1, 5)]
var traces: Layer;

$if (layout.STEP_BINDINGS != 4) {
    $error("the trace layer's bindings are not the contract's (cellar.layer binding)");
}

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    # workgroup y names an entry of the active list past the dispatch's base,
    # and a dispatch may run past the list's end
    val entry: u32 = gid[1] + meta.base[0];
    if (entry >= flags.args[1]) { ret; }
    val slot: u32 = flags.list[entry];
    if (meta.table[slot * layout.ENTRY + layout.INCARNATION_AT] == 0) { ret; }
    val ly:   u32 = gid[0] / 8;
    val x0:   u32 = (gid[0] % 8) * 8;
    val row:  u32 = layer.addr(slot, ly * layout.SIDE);
    var sacc: u32 = 0;
    var tacc: u32 = 0;
    var live: u32 = 0;
    var x:    u32 = x0;
    for (x < x0 + 8) {
        val a: u32 = row + x;
        val c: u32 = layer.read(src.v[layer.addr_word(word.STATE_WIDTH, a)], word.STATE_WIDTH, a);
        val t: u32 = word.next(layer.read(traced.v[layer.addr_word(word.TRACE_WIDTH, a)], word.TRACE_WIDTH, a));
        if (c != 0 || t != 0) { live = 1; }
        sacc = sacc | layer.place(word.STATE_WIDTH, a, c);
        tacc = tacc | layer.place(word.TRACE_WIDTH, a, t);
        if (layer.ends(word.STATE_WIDTH, a) != 0) {
            dst.v[layer.addr_word(word.STATE_WIDTH, a)] = sacc;
            sacc                                        = 0;
        }
        if (layer.ends(word.TRACE_WIDTH, a) != 0) {
            traces.v[layer.addr_word(word.TRACE_WIDTH, a)] = tacc;
            tacc                                           = 0;
        }
        x = x + 1;
    }
    if (live != 0) {
        flags.v[slot * 2]     = meta.serial;
        flags.v[slot * 2 + 1] = meta.serial;
    }
}
