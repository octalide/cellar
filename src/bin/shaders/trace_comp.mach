# one generation of the chunks on the active list, under the test-only trace
# family (cellar.rules.trace): a cell keeps its state, and its trace counts
# down to zero
#
# the state layer and the trace layer, its one rule layer, layer 1 of its set,
# are reached by address (cellar.layer). an invocation is a run of 8
# cells of a row, building the words of each layer they fill, and 8 workgroups
# of 64 cover a chunk; the workgroup's row (cellar.layout row) names the
# chunk's slot through the active list (cellar.layout.Flags). a cell reads no neighbour, so a chunk is stepped
# from its own cells alone, and one whose result holds a live cell, by its
# state or its trace, is stamped live and warm.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.rules.trace.word;

#[storage(1, 0, "readonly")]
var meta:  Meta;
#[storage(1, 1)]
var flags: Flags;

# the trace layer's place in the family's set
val TRACE: u32 = 1;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    # the workgroup's row names an entry of the active list past the
    # dispatch's base, and a dispatch may run past the list's end
    val entry: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]) + meta.base[0];
    if (entry >= flags.n) { ret; }
    val slot: u32 = flags.v[layout.list_at(meta.base[layout.CAP_AT - layout.BASE_AT]) + entry];
    if (meta.table[slot * layout.ENTRY + layout.INCARNATION_AT] == 0) { ret; }
    # the source cells are the last step's, the destination this one's
    val place:  layout.Where = layout.where(slot, meta.base[layout.SHARD_AT - layout.BASE_AT]);
    val src:    u32          = (meta.serial - 1) & 1;
    val dst:    u32          = meta.serial & 1;
    val ssrc:   layout.Span  = layer.span(meta.shards, 0, src, place, word.STATE_WIDTH);
    val sdst:   layout.Span  = layer.span(meta.shards, 0, dst, place, word.STATE_WIDTH);
    val traced: layout.Span  = layer.span(meta.shards, TRACE, src, place, word.TRACE_WIDTH);
    val traces: layout.Span  = layer.span(meta.shards, TRACE, dst, place, word.TRACE_WIDTH);
    val ly:     u32          = gid[0] / 8;
    val x0:     u32          = (gid[0] % 8) * 8;
    val row:    u32          = ly * layout.SIDE;
    var sacc:   u32          = 0;
    var tacc:   u32          = 0;
    var live:   u32          = 0;
    var x:      u32          = x0;
    for (x < x0 + 8) {
        val a: u32 = row + x;
        val c: u32 = layer.read(ssrc.p.v[ssrc.at + layer.cell_word(word.STATE_WIDTH, a)], word.STATE_WIDTH, a);
        val t: u32 = word.next(layer.read(traced.p.v[traced.at + layer.cell_word(word.TRACE_WIDTH, a)], word.TRACE_WIDTH, a));
        if (c != 0 || t != 0) { live = 1; }
        sacc = sacc | layer.place(word.STATE_WIDTH, a, c);
        tacc = tacc | layer.place(word.TRACE_WIDTH, a, t);
        if (layer.ends(word.STATE_WIDTH, a) != 0) {
            sdst.p.v[sdst.at + layer.cell_word(word.STATE_WIDTH, a)] = sacc;
            sacc                                                     = 0;
        }
        if (layer.ends(word.TRACE_WIDTH, a) != 0) {
            traces.p.v[traces.at + layer.cell_word(word.TRACE_WIDTH, a)] = tacc;
            tacc                                                         = 0;
        }
        x = x + 1;
    }
    if (live != 0) {
        flags.v[slot * 2]     = meta.serial;
        flags.v[slot * 2 + 1] = meta.serial;
    }
}
