# carry the pool the GPU owns into other buffers, larger for a growth or
# smaller for a compaction that packed every chunk below their capacity
# (cellar.gpu compact): its page table, and the
# words of the status head that outlive a growth, the gate, where it closed
# and the last incarnation handed out. the host's mirror of them may be stale,
# so it plays no part. the cells stay in the shards they lie in, the stamps go
# with the grow stage, and the hash and free bits are seeded again from the
# carried table (wipe_comp, seed_comp).
#
# an invocation is a word of a slot's entry, a workgroup's row (cellar.layout
# row) for every slot of the smaller capacity, which each meta head holds.

use cellar.layout;
use cellar.layout.Meta;
use cellar.layout.Status;

#[storage(1, 0, "readonly")]
var msrc: Meta;
#[storage(1, 1)]
var mdst: Meta;
#[storage(1, 2, "readonly")]
var ssrc: Status;
#[storage(1, 3)]
var sdst: Status;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = layout.row(gid[1], gid[2], msrc.base[layout.FOLD_AT - layout.BASE_AT]);
    val i:    u32 = gid[0];
    if (i >= layout.ENTRY)                                 { ret; }
    if (slot >= msrc.base[layout.CAP_AT - layout.BASE_AT]) { ret; }
    if (slot >= mdst.base[layout.CAP_AT - layout.BASE_AT]) { ret; }
    mdst.table[slot * layout.ENTRY + i] = msrc.table[slot * layout.ENTRY + i];
    if (slot == 0 && i == 0) {
        sdst.head[layout.CTL_GATE]   = ssrc.head[layout.CTL_GATE];
        sdst.head[layout.CTL_HALT]   = ssrc.head[layout.CTL_HALT];
        sdst.head[layout.CTL_SERIAL] = ssrc.head[layout.CTL_SERIAL];
    }
}
