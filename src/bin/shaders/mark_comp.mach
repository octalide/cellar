# the first stage of a pass: every live chunk asks for the chunks its halo
# needs, and claims a slot for each one that does not exist
#
# a pass runs while the GPU owns the pool (cellar.gpu), between generations,
# often enough that no generation outruns it: it leaves every live chunk with
# the halo of adjacent chunks holding the spread the pass header names
# (cellar.layout.halo), the running rule's ring (cellar.space.ring).
#
# a workgroup is one slot, and a chunk the step left a live cell in at the
# front, stamped with the serial in the pass header, scans its cells for the
# quadrants holding one, an invocation a row, each cell its value in the state
# layer at the width the meta head holds (cellar.layer). a generation an edit
# started over may have stamped the next serial on a chunk live at the front, so
# a stamp of either counts, as the census counts it. the first invocation then
# marks every chunk of the halo that exists as asked for this pass, so the free
# stage keeps it, and claims a slot for each that does not: the lowest free slot
# below the top, its entry stamped with the chunk's coordinates and a new
# incarnation and put in the hash. two live chunks beside the same missing one
# each claim a slot for it; the settle stage keeps one and gives the others
# back. a slot that cannot be claimed, because none below the top is free,
# closes the gate: no pass claims and no step runs until the host has given the
# pool more room.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Layer;
use cellar.layout.Meta;
use cellar.layout.Status;
use at: shader.atomic;
use sy: shader.sync;

#[storage(1, 0, "readonly")]
var cells:  Layer;
#[storage(1, 1)]
var meta:   Meta;
#[storage(1, 2)]
var status: Status;
#[storage(1, 3, "readonly")]
var flags:  Flags;

# the quadrants holding a live cell, and the gate as the workgroup read it
#[shared]
var quads: [2]u32;

#[builtin("workgroup_id")]
var wid: u32x3;
#[builtin("local_invocation_index")]
var lid: u32;

val DEV: u32 = sy.SCOPE_DEVICE;
val BUF: u32 = sy.SEMANTICS_UNIFORM_MEMORY;
val WG:  u32 = sy.SEMANTICS_WORKGROUP_MEMORY;

# the lowest free slot below top, taken from the free bits, or NONE. each
# function here leaves only at its end, which the SPIR-V target asks of a
# loop once it is inlined
fun take_free(top: u32) u32 {
    val words: u32 = (top + 31) / 32;
    var got:   u32 = layout.NONE;
    var done:  u32 = 0;
    var w:     u32 = 0;
    for ((done == 0) & (w < words)) {
        var v: u32 = at.atomic_load_u32(?status.bitmap[w], DEV, sy.SEMANTICS_ACQUIRE | BUF);
        for ((done == 0) & (v != 0)) {
            val low: u32 = v & (~v + 1);
            val old: u32 = at.atomic_and_u32(?status.bitmap[w], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF, ~low);
            if ((old & low) != 0) {
                var b: u32 = 0;
                for (((low >> b) & 1) == 0) { b = b + 1; }
                if (w * 32 + b < top) { got = w * 32 + b; }
                or                    { at.atomic_or_u32(?status.bitmap[w], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF, low); }
                done = 1;
            }
            or { v = old & ~low; }
        }
        w = w + 1;
    }
    ret got;
}

# close the gate: the first to close it notes where. the gather after the pass
# then lists nothing, so the steps the frame recorded after it find nothing to
# step (gather_comp)
fun close() {
    val was: u32 = at.atomic_compare_exchange_u32(?status.head[layout.CTL_GATE], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF,
        sy.SEMANTICS_ACQUIRE | BUF, 1, 0);
    if (was == 0) { status.head[layout.CTL_HALT] = status.head[layout.CTL_GENS]; }
}

# put a claimed slot holding the chunk at biased (bx, by) in the hash, at the
# first bucket of its probe that is empty or a tombstone
fun hash_in(s: u32, bx: u32, by: u32) {
    var b:    u32 = layout.bucket(bx, by);
    var done: u32 = 0;
    for (done == 0) {
        val cur: u32 = at.atomic_load_u32(?status.hash[b], DEV, sy.SEMANTICS_ACQUIRE | BUF);
        if (cur == layout.EMPTY || cur == layout.TOMB) {
            val was: u32 = at.atomic_compare_exchange_u32(?status.hash[b], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF,
                sy.SEMANTICS_ACQUIRE | BUF, s, cur);
            if (was == cur) {
                if (cur == layout.TOMB) { at.atomic_sub_u32(?status.head[layout.CTL_TOMBS], DEV, sy.SEMANTICS_RELAXED, 1); }
                done = 1;
            }
        }
        or { b = (b + 1) & (layout.HASH - 1); }
    }
}

# claim a slot for the chunk at biased (bx, by), unless the gate is closed
fun claim(bx: u32, by: u32, pass: u32) {
    var s: u32 = layout.NONE;
    if (at.atomic_load_u32(?status.head[layout.CTL_GATE], DEV, sy.SEMANTICS_ACQUIRE | BUF) == 0) {
        s = take_free(status.head[layout.CTL_TOP]);
        if (s == layout.NONE) { close(); }
    }
    if (s != layout.NONE) {
        var inc: u32 = at.atomic_add_u32(?status.head[layout.CTL_SERIAL], DEV, sy.SEMANTICS_RELAXED, 1) + 1;
        if (inc == 0) { inc = at.atomic_add_u32(?status.head[layout.CTL_SERIAL], DEV, sy.SEMANTICS_RELAXED, 1) + 1; }
        val e: u32 = s * layout.ENTRY;
        var k: u32 = 0;
        for (k < layout.ENTRY) {
            meta.table[e + k] = 0;
            k                 = k + 1;
        }
        k = 0;
        for (k < 9) {
            meta.table[e + k] = layout.NONE;
            k                 = k + 1;
        }
        meta.table[e + 9]                     = bx;
        meta.table[e + 10]                    = by;
        meta.table[e + layout.INCARNATION_AT] = inc;
        status.asked[s]                       = pass;
        hash_in(s, bx, by);
        val i: u32 = at.atomic_add_u32(?status.head[layout.CTL_FRESH], DEV, sy.SEMANTICS_ACQUIRE_RELEASE | BUF, 1);
        status.fresh[i] = s;
        if ((i & 63) == 0) { at.atomic_add_u32(?status.head[layout.ARGS_SETTLE], DEV, sy.SEMANTICS_RELAXED, 1); }
    }
}

# ask for the adjacent chunks of the halo of the quadrants holding a live
# cell, in the entry's row-major neighbour order: at the narrowest ring,
# north-west asks west, north and their corner, and so on
fun ask(slot: u32, live: u32) {
    val e:    u32 = slot * layout.ENTRY;
    val mask: u32 = layout.halo(live, status.head[layout.CTL_SPAN]);
    var need: u32 = 0;
    var j:    u32 = 0;
    for (j < 9) {
        val bit: u32 = (j / 3 + 1) * layout.HALO_SIDE + j % 3 + 1;
        need = need | (((mask >> bit) & 1) << j);
        j    = j + 1;
    }
    val pass: u32 = status.head[layout.CTL_PASS];
    val bx:   u32 = meta.table[e + 9];
    val by:   u32 = meta.table[e + 10];
    status.asked[slot] = pass;
    var k: u32 = 0;
    for (k < 9) {
        if (((need >> k) & 1) != 0) {
            val n: u32 = meta.table[e + k];
            if (n != layout.NONE) { status.asked[n] = pass; }
            or                    { claim(bx + k % 3 - 1, by + k / 3 - 1, pass); }
        }
        k = k + 1;
    }
}

# the state layer's value of cell i of a slot, at the width the meta head holds
# (cellar.layer)
fun cell(slot: u32, i: u32) u32 {
    val w: u32 = meta.base[layout.WIDTH_AT - layout.BASE_AT];
    ret layer.read(cells.v[layer.cell_at(w, slot, i)], w, i);
}

# the quadrants of a live slot holding a live cell, an invocation a row, then
# its asks. the gate is read once for the workgroup, so all of it skips
# together, though another workgroup may close it meanwhile: while it is
# closed the steps since it closed were voided and the front the header names
# is not the world's, so nothing is marked
fun scan(slot: u32) {
    if (lid == 0) {
        quads[0] = 0;
        quads[1] = at.atomic_load_u32(?status.head[layout.CTL_GATE], DEV, sy.SEMANTICS_ACQUIRE | BUF);
    }
    sy.workgroup_barrier();
    if (quads[1] == 0) {
        val row: u32 = lid * layout.SIDE;
        var q:   u32 = 0;
        var x:   u32 = 0;
        for (x < layout.SIDE) {
            if (layout.live(cell(slot, row + x), meta.live_mask, meta.live_lo, meta.live_hi) != 0) { q = q | layout.quadrant(x, lid); }
            x = x + 1;
        }
        if (q != 0) { at.atomic_or_u32(?quads[0], sy.SCOPE_WORKGROUP, sy.SEMANTICS_RELAXED, q); }
        sy.workgroup_barrier();
        if (lid == 0 && quads[0] != 0) { ask(slot, quads[0]); }
    }
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = wid[1];
    if (slot < status.head[layout.CTL_TOP] && meta.table[slot * layout.ENTRY + layout.INCARNATION_AT] != 0) {
        val now: u32 = status.head[layout.CTL_NOW];
        val f:   u32 = flags.v[slot * 2];
        if (f == now || f == now + 1) { scan(slot); }
    }
}
