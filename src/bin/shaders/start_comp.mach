# start the shown layer a pool just took up from its state layer, in both
# cells, as a view layer starts (cellar.layer): the value a fresh live cell
# holds there (layout.LIT_AT) where the state layer's value is live under the
# rule's sense, else zero
#
# workgroup y names a slot, one below the top, and x a run of 64 words of the
# slot's span of the shown layer, the dispatch's workgroups along x covering
# it. a free slot is left alone: a chunk made there later is cleared in every
# layer. each cell's two values, the front's and the back's, are started from
# the state layer's cells alike, so a chunk the step passes by as cold holds
# zeros in both, as the step expects of it.

use cellar.layer;
use cellar.layout;
use cellar.layout.Meta;

#[storage(1, 0, "readonly")]
var meta: Meta;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[1];
    if (meta.table[slot * layout.ENTRY + layout.INCARNATION_AT] == 0) { ret; }
    val set:    u32 = meta.base[layout.SET_AT - layout.BASE_AT];
    val widths: u32 = meta.base[layout.WIDTHS_AT - layout.BASE_AT];
    val k:      u32 = layer.set_shown(set);
    if (k == 0) { ret; }
    val hw: u32 = layer.width_in(widths, k);
    if (gid[0] >= layer.span_words(hw)) { ret; }
    val w:     u32          = layer.width_in(widths, 0);
    val lit:   u32          = meta.base[layout.LIT_AT - layout.BASE_AT];
    val place: layout.Where = layout.where(slot, meta.base[layout.SHARD_AT - layout.BASE_AT]);
    val per:   u32          = layer.per_word(hw);
    val first: u32          = gid[0] * per;
    var c:     u32          = 0;
    for (c < 2) {
        val s:   layout.Span = layer.span(meta.shards, 0, c, place, w);
        val h:   layout.Span = layer.span(meta.shards, k, c, place, hw);
        var out: u32         = 0;
        var q:   u32         = 0;
        for (q < per) {
            val i: u32 = first + q;
            val v: u32 = layer.read(s.p.v[s.at + layer.cell_word(w, i)], w, i);
            if (layout.live(v, meta.sense.live_mask, meta.sense.live_lo, meta.sense.live_hi) != 0) { out = out | layer.place(hw, i, lit); }
            q = q + 1;
        }
        h.p.v[h.at + gid[0]] = out;
        c                    = c + 1;
    }
}
