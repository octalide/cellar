# the running rule's shown layer (cellar.layer), as the census's and the
# reduce's variants that bind the layers beside the state layer read it: bound
# at its source buffer at layer.SHOWN_BINDING, the state layer's where the set
# has none, and its width named in the meta head's live word at
# layer.SHOWN_SLOT, 0 for none

use cellar.layer;
use cellar.layout.Layer;

$if (layer.SHOWN_BINDING != 7) {
    $error("the shown layer's binding below is not the contract's");
}

#[storage(1, 7, "readonly")]
var shown: Layer;

# the sensed value (cellar.layer sensed) of the cell at address a whose state
# layer's value is c, read at width w
# ---
# code: the meta head's live word
# c:    the cell's value in the state layer
# w:    the state layer's width
# a:    the cell's address
pub fun sensed(code: u32, c: u32, w: u32, a: u32) u32 {
    val hw: u32 = layer.live_width(code, layer.SHOWN_SLOT);
    if (hw == 0) { ret c; }
    ret layer.sensed(c, layer.read(shown.v[layer.addr_word(hw, a)], hw, a), w);
}
