# empty the GPU's hash and free bits, ahead of the seed stage filling them
# again from the page table
#
# an invocation is a bucket, and the first of them also a word of the free
# bits. the tombstones go with the buckets, so their count starts over.

use cellar.layout;
use cellar.layout.Status;

#[storage(1, 0)]
var status: Status;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val i: u32 = gid[0];
    status.hash[i] = layout.EMPTY;
    if (i < layout.MAX_SLOTS / 32) { status.bitmap[i] = 0; }
    if (i == 0)                    { status.head[layout.CTL_TOMBS] = 0; }
}
