# empty the GPU's hash and free bits, ahead of the seed stage filling them
# again from the page table
#
# an invocation is a bucket, a row of 64 of them a workgroup (cellar.layout
# row), and the first of them also a word of the free
# bits. the tombstones go with the buckets, so their count starts over.

use cellar.layout;
use cellar.layout.Meta;
use cellar.layout.Status;

#[storage(1, 0, "readonly")]
var meta:   Meta;
#[storage(1, 1)]
var status: Status;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val i:   u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]) * 64 + gid[0];
    val cap: u32 = meta.base[layout.CAP_AT - layout.BASE_AT];
    if (i < layout.buckets(cap)) { status.v[layout.hash_at(cap) + i] = layout.EMPTY; }
    if (i < (cap + 31) / 32)     { status.v[layout.bitmap_at(cap) + i] = 0; }
    if (i == 0)                  { status.head[layout.CTL_TOMBS] = 0; }
}
