# one generation of the chunks on the active list, under the non-totalistic
# family (cellar.rules.nontotalistic)
#
# a cell is the weighted family's: a bit in the family's state layer
# (word.WIDTH, cellar.layer), a row of 32 to a word, and its display
# channels, age << 8 | heat, in the view layer beside it (word.SHOWN), layer 1
# of its set, where the pool holds it while the view's colour mode reads them.
# the stage reaches both by address, and steps the channels only where the
# meta head's set word names a shown layer.
#
# an invocation is a run of 8 cells in a row, and 8 workgroups of 64 cover a
# chunk, a band of 8 rows each; the workgroup's row (cellar.layout row) names
# the chunk's slot through the active list (cellar.layout.Flags). the four invocations whose runs share a
# word of the state layer leave their bits in workgroup memory, and the first
# writes the word. an invocation writes its own cells' display channels.
#
# a workgroup reads its band and the rows above and below it from the source
# pool once, into a shared tile of bits, a word of the source at a time, as
# the weighted family's stage does, through the chunk's page-table entry, so a
# chunk that does not exist reads as dead. a cell's 3 by 3 block is read from
# the tile, and its live cells, the north-west one the most significant bit,
# index the map in the family's window of the meta head.
#
# whether a chunk is stepped in full is decided once a workgroup, by its first
# invocation, since the tile's barrier must be reached by the whole workgroup
# or none of it. each step stamps, per slot, the step's serial into an alive
# and a warm word when the chunk's result holds a live or a warm cell, as the
# other families' stages do. a chunk with no live cell in its 3 by 3 block only
# cools, and one that is also cold, and was cold the step before, already
# holds zeros in both pools and is skipped.
#
# a rule that births on 0 runs in its form (cellar.rules.weighted.word): the
# pool's background is dead in every form, so no chunk is stepped for it, and
# the step reads its source generation's parity as meta.gen + meta.serial. a
# cell past a plane's dead edge reads as the form holds the edge at that
# parity (word.past).

use cellar.bin.shaders.pool;
use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.rules.nontotalistic.window;
use cellar.rules.weighted.word;
use sy: shader.sync;

#[storage(1, 0, "readonly")]
var meta:  Meta;
#[storage(1, 1)]
var flags: Flags;

#[builtin("global_invocation")]
var gid: u32x3;
#[builtin("local_invocation_index")]
var lid: u32;

# a band's rows and the row above and below it, and the words a row of the
# tile takes, columns -32 to 95
val BAND:       u32 = 8;
val TILE_ROWS:  u32 = BAND + 2;
val TILE_WORDS: u32 = 4;

rec Tile {
    v: [TILE_ROWS * TILE_WORDS]u32;
}

# each invocation's 8 cells one generation on, at their place in their word
rec Runs {
    v: [64]u32;
}

# the band's live cells and its apron's, bit c + 32 of a row's words the cell
# at column c, and a cell past a plane's dead edge as the form holds the edge
#[shared]
var tile: Tile;
#[shared]
var runs: Runs;
# 1 when the workgroup's chunk steps in full, as its first invocation found
#[shared]
var full: u32;

# the shown layer's place in the family's set
val SHOWN_LAYER: u32 = 1;

# the cell at (x, y) of a slot's frame, taken through the links where it lies
# outside the window (cellar.layout), its slot NONE where no chunk holds it,
# or PAST past a plane's dead edge
fun reach(slot: u32, x: i32, y: i32) pool.Spot {
    var sl: u32       = slot;
    var px: i32       = x;
    var py: i32       = y;
    var at: pool.Spot = pool.Spot{slot: layout.NONE, i: 0};
    var h:  u32       = 0;
    for (h <= layout.HOPS) {
        val b: u32 = sl * layout.ENTRY;
        val k: u32 = layout.edge_side(meta.table[b + layout.EDGE_AT], px, py);
        val n: u32 = meta.table[b + k];
        val t: u32 = meta.table[b + layout.LINK_AT + k];
        if (k == 4) {
            at = pool.Spot{slot: sl, i: (py * layout.SIDE::i32 + px)::u32};
            h  = layout.HOPS;
        }
        or (n == layout.NONE) {
            if ((t & layout.LINK_EDGE) != 0) { at = pool.Spot{slot: layout.PAST, i: 0}; }
            h = layout.HOPS;
        }
        or {
            val nx: i32 = layout.hop_x(t, px, py);
            py = layout.hop_y(t, px, py);
            px = nx;
            sl = n;
        }
        h = h + 1;
    }
    ret at;
}

# two cells' display channels, a word of their layer, one generation on with
# neither live: their heat fades and they have no age, a lane at a time
fun cool2(h: u32) u32 {
    val x: u32 = h & 0x00ff00ff;
    val y: u32 = (x | 0x80008000) - ((word.DECAY << 16) | word.DECAY);
    val m: u32 = ((y >> 15) & 0x00010001) * word.HEAT_MASK;
    ret y & m;
}

# the bits of a mask from bit lo to before bit hi, lo below hi
fun span(lo: u32, hi: u32) u32 {
    if (hi - lo >= 32) { ret 0xffffffff; }
    ret ((1 << (hi - lo)) - 1) << lo;
}

# the three cells of a tile row around column c as a neighbourhood's index
# reads them, the westmost the most significant
fun trio(t: u32, c: i32) u32 {
    val p:  u32 = (c + 31)::u32;
    val ws: u32 = p / 32;
    val sh: u32 = p % 32;
    var w:  u32 = tile.v[t + ws] >> sh;
    if (sh > 29) { w = w | (tile.v[t + ws + 1] << (32 - sh)); }
    ret ((w & 1) << 2) | (w & 2) | ((w >> 2) & 1);
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    # the workgroup's row names an entry of the active list past the
    # dispatch's base, and a dispatch may run past the list's end
    val entry: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]) + meta.base[0];
    if (entry >= flags.n) { ret; }
    val slot: u32 = flags.v[layout.list_at(meta.base[layout.CAP_AT - layout.BASE_AT]) + entry];
    val ly:   i32 = (gid[0] / 8)::i32;
    val band: i32 = ((gid[0] / 64) * BAND)::i32;
    val x0:   u32 = (gid[0] % 8) * 8;
    val base: u32 = slot * layout.ENTRY;
    if (meta.table[base + layout.INCARNATION_AT] == 0) { ret; }
    # a seamed chunk reads its block through its links, and holds its cells
    # off the grid at zero
    val edge:   u32 = meta.table[base + layout.EDGE_AT];
    val seamed: u32 = layout.seamed(edge);

    # the serial that produced the source. a stamp this step already wrote
    # may have replaced it, so a stamp of either serial counts as set then; a
    # chunk that is live or warm at the source carries one of the two
    val last: u32 = meta.serial - 1;
    val now:  u32 = meta.serial;
    # the source cells are the last step's, the destination this one's
    # (cellar.layer): the state layer's word holding the run, and the run's
    # first display word
    val sh:    *layout.Shards = meta.shards;
    val m:     u32            = meta.base[layout.SHARD_AT - layout.BASE_AT];
    val src:   u32            = last & 1;
    val place: layout.Where   = layout.where(slot, m);
    val dst:   layout.Span    = layer.span(sh, 0, now & 1, place, word.WIDTH);
    val hsrc:  layout.Span    = layer.span(sh, SHOWN_LAYER, src, place, word.SHOWN);
    val hdst:  layout.Span    = layer.span(sh, SHOWN_LAYER, now & 1, place, word.SHOWN);
    val sw:    u32            = dst.at + ly::u32 * 2 + x0 / 32;
    val hw:    u32            = (ly::u32 * layout.SIDE + x0) / 2;
    val shows: u32            = layer.set_shown(meta.base[layout.SET_AT - layout.BASE_AT]);
    if (lid == 0) {
        var busy: u32 = 0;
        var k:    u32 = 0;
        for (k < 9) {
            val n: u32 = meta.table[base + k];
            if (n != layout.NONE) {
                val f: u32 = flags.v[n * 2];
                if (f == last || f == now) { busy = 1; }
            }
            k = k + 1;
        }
        if (seamed != 0) { busy = 1; }
        full = busy;
    }
    sy.workgroup_barrier();
    val busy: u32 = full;
    var j:    u32 = 0;
    if (busy == 0) {
        # every cell is dead and stays so, and only cools
        val warm: u32 = flags.v[slot * 2 + 1];
        if (warm != last && warm != now) {
            # cold at the source; if it was cold a step earlier too, the
            # destination already holds zeros
            if (warm != last - 1) { ret; }
            if (x0 % 32 == 0)     { dst.p.v[sw] = 0; }
            if (shows != 0) {
                for (j < 4) {
                    hdst.p.v[hdst.at + hw + j] = 0;
                    j                          = j + 1;
                }
            }
            ret;
        }
        if (x0 % 32 == 0) { dst.p.v[sw] = 0; }
        var any: u32 = 0;
        if (shows != 0) {
            for (j < 4) {
                val c: u32 = cool2(hsrc.p.v[hsrc.at + hw + j]);
                hdst.p.v[hdst.at + hw + j] = c;
                any                        = any | c;
                j                          = j + 1;
            }
        }
        if (any != 0) { flags.v[slot * 2 + 1] = now; }
        ret;
    }

    val form:    u32 = meta.rule[window.FORM_AT];
    val gen:     u32 = meta.gen + meta.serial;
    val inv_out: u32 = word.inverted(form, (gen + 1) & 1);
    val past:    u32 = word.past(form, gen & 1);
    var flip:    u32 = 0;
    if (word.inverted(form, gen & 1) != 0) { flip = 511; }

    # the tile's rows from the one above the band's first; a word's columns
    # outside the apron stay clear
    var i: u32 = lid;
    for (i < TILE_ROWS * TILE_WORDS) {
        val y:    i32 = band - 1 + (i / TILE_WORDS)::i32;
        val k:    u32 = i % TILE_WORDS;
        val c0:   i32 = k::i32 * 32 - 32;
        var lo:   i32 = c0;
        var hi:   i32 = c0 + 32;
        var bits: u32 = 0;
        if (lo < -1)                   { lo = -1; }
        if (hi > layout.SIDE::i32 + 1) { hi = layout.SIDE::i32 + 1; }
        if (seamed != 0) {
            var c: i32 = lo;
            for (c < hi) {
                val a:  pool.Spot = reach(slot, c, y);
                var on: u32       = 0;
                if (a.slot == layout.PAST) { on = past; }
                or (a.slot != layout.NONE) { on = pool.cell(sh, m, 0, src, a.slot, word.WIDTH, a.i); }
                bits = bits | (on << (c - c0)::u32);
                c    = c + 1;
            }
        }
        or (lo < hi) {
            var yy: i32 = y;
            var cy: u32 = 1;
            if (yy < 0) {
                yy = yy + layout.SIDE::i32;
                cy = 0;
            }
            or (yy >= layout.SIDE::i32) {
                yy = yy - layout.SIDE::i32;
                cy = 2;
            }
            # words 0 and 3 lie in the west and east neighbours, 1 and 2 in
            # the chunk, and each is one word of that chunk's row
            val cx: u32 = (k + 1) / 2;
            val n:  u32 = meta.table[base + cy * 3 + cx];
            if (n != layout.NONE) {
                val ns: layout.Span = layer.span(sh, 0, src, layout.where(n, m), word.WIDTH);
                val w:  u32         = ns.p.v[ns.at + yy::u32 * 2 + (k + 1) % 2];
                bits = w & span((lo - c0)::u32, (hi - c0)::u32);
            }
        }
        tile.v[i] = bits;
        i         = i + 64;
    }
    sy.workgroup_barrier();

    # the tile rows above, at and below the run
    val up:   u32 = (ly - band)::u32 * TILE_WORDS;
    var next: u32 = 0;
    var c:    u32 = 0;
    for (c < 8) {
        val x: i32 = (x0 + c)::i32;
        # a generation held as the complement reads its neighbourhood complemented
        val nh: u32 = ((trio(up, x) << 6) | (trio(up + TILE_WORDS, x) << 3) | trio(up + 2 * TILE_WORDS, x)) ^ flip;
        var on: u32 = ((meta.rule[window.MAP_AT + nh / 32] >> (nh % 32)) & 1) ^ inv_out;
        # cells off the grid are held at zero
        if (seamed != 0) {
            if (layout.edge_side(edge, x, ly) != 4) { on = 0; }
        }
        next = next | (on << c);
        c    = c + 1;
    }

    # the run's display channels follow its cells, and where the pool holds
    # none a live cell alone is warm
    var warm: u32 = next;
    if (shows != 0) {
        for (j < 4) {
            val h: u32 = hsrc.p.v[hsrc.at + hw + j];
            var v: u32 = word.become(h & 0xffff, (next >> (j * 2)) & 1) | (word.become(h >> 16, (next >> (j * 2 + 1)) & 1) << 16);
            if (seamed != 0) {
                if (layout.edge_side(edge, (x0 + j * 2)::i32, ly) != 4)     { v = v & 0xffff0000; }
                if (layout.edge_side(edge, (x0 + j * 2 + 1)::i32, ly) != 4) { v = v & 0xffff; }
            }
            hdst.p.v[hdst.at + hw + j] = v;
            warm                       = warm | v;
            j                          = j + 1;
        }
    }

    # the run's word of the state layer, from the four runs it holds
    runs.v[lid] = next << (x0 % 32);
    sy.workgroup_barrier();
    if (x0 % 32 == 0) { dst.p.v[sw] = runs.v[lid] | runs.v[lid + 1] | runs.v[lid + 2] | runs.v[lid + 3]; }
    if (next != 0)    { flags.v[slot * 2] = now; }
    if (warm != 0)    { flags.v[slot * 2 + 1] = now; }
}
