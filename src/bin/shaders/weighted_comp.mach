# one generation of every allocated chunk in the pool, under the weighted
# outer-totalistic family (cellar.rules.weighted)
#
# an invocation is a run of 8 cells in a row, and 8 workgroups of 64 cover a
# chunk; workgroup y names the chunk's slot, past the dispatch's base slot. the
# neighbourhood is read straight from the source pool through the chunk's
# page-table entry, which names the slot of each of its eight neighbours, so a
# chunk that does not exist reads as dead. a cell is age << 8 | heat, alive
# while its age is nonzero.
#
# each step stamps, per slot, the step's serial into an alive and a warm word
# when the chunk's result holds a live or a warm cell; every invocation that
# finds one writes the same value, so no atomics are needed. the next step
# reads the stamps of the source: a chunk with no live cell in its 3 by 3 block
# only cools, and one that is also cold, and was cold the step before, already
# holds zeros in both pools and is skipped.
#
# a rule that births on 0 runs in its form (cellar.rules.weighted.word): the
# pool's background is dead in every form, so no chunk is stepped for it, and
# the step reads its source generation's parity as meta.gen + meta.serial. a
# cell past a plane's dead edge reads as the form holds the edge at that
# parity (word.past).
#
# the radius, form, total weight and sums' extent are in the family's window
# of the meta head, and the sets and the weights in the rule buffer at
# layout.TABLE_BINDING, as cellar.rules.weighted pack_table lays them out.

use cellar.layout;
use cellar.layout.Cells;
use cellar.layout.Flags;
use cellar.layout.Meta;
use cellar.layout.Table;
use cellar.rules.weighted.word;

#[storage(1, 0, "readonly")]
var src:   Cells;
#[storage(1, 1)]
var dst:   Cells;
#[storage(1, 2, "readonly")]
var meta:  Meta;
#[storage(1, 3)]
var flags: Flags;
#[storage(1, 4, "readonly")]
var table: Table;

#[builtin("global_invocation")]
var gid: u32x3;

# the index in the source pool of the cell at (x, y) of a slot's frame, taken
# through the links where it lies outside the window (cellar.layout), NONE
# where no chunk holds it, or PAST past a plane's dead edge
fun reach(slot: u32, x: i32, y: i32) u32 {
    var sl: u32 = slot;
    var px: i32 = x;
    var py: i32 = y;
    var at: u32 = layout.NONE;
    var h:  u32 = 0;
    for (h <= layout.HOPS) {
        val b: u32 = sl * layout.ENTRY;
        val k: u32 = layout.edge_side(meta.table[b + layout.EDGE_AT], px, py);
        val n: u32 = meta.table[b + k];
        val t: u32 = meta.table[b + layout.LINK_AT + k];
        if (k == 4) {
            at = sl * layout.CELLS + (py * layout.SIDE::i32 + px)::u32;
            h  = layout.HOPS;
        }
        or (n == layout.NONE) {
            if ((t & layout.LINK_EDGE) != 0) { at = layout.PAST; }
            h = layout.HOPS;
        }
        or {
            val nx: i32 = layout.hop_x(t, px, py);
            py = layout.hop_y(t, px, py);
            px = nx;
            sl = n;
        }
        h = h + 1;
    }
    ret at;
}

fun cool(v: u32) u32 {
    val heat: u32 = v & word.HEAT_MASK;
    if (heat > word.DECAY) { ret heat - word.DECAY; }
    ret 0;
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = gid[1] + meta.base[0];
    val ly:   i32 = (gid[0] / 8)::i32;
    val x0:   u32 = (gid[0] % 8) * 8;
    val base: u32 = slot * layout.ENTRY;
    val row:  u32 = slot * layout.CELLS + (ly * layout.SIDE::i32)::u32;
    if (meta.table[base + layout.INCARNATION_AT] == 0) { ret; }
    # a seamed chunk reads its block through its links, and holds its cells
    # off the grid at zero
    val edge:   u32 = meta.table[base + layout.EDGE_AT];
    val seamed: u32 = layout.seamed(edge);

    # the serial that produced the source. a stamp this step already wrote
    # may have replaced it, so a stamp of either serial counts as set then; a
    # chunk that is live or warm at the source carries one of the two
    val last: u32 = meta.serial - 1;
    val now:  u32 = meta.serial;
    var busy: u32 = 0;
    var k:    u32 = 0;
    for (k < 9) {
        val n: u32 = meta.table[base + k];
        if (n != layout.NONE) {
            val f: u32 = flags.v[n * 2];
            if (f == last || f == now) { busy = 1; }
        }
        k = k + 1;
    }
    if (seamed != 0) { busy = 1; }
    var x: u32 = x0;
    if (busy == 0) {
        val warm: u32 = flags.v[slot * 2 + 1];
        if (warm != last && warm != now) {
            # cold at the source; if it was cold a step earlier too, the
            # destination already holds zeros
            if (warm != last - 1) { ret; }
            for (x < x0 + 8) {
                dst.v[row + x] = 0;
                x              = x + 1;
            }
            ret;
        }
        var any: u32 = 0;
        for (x < x0 + 8) {
            val c: u32 = cool(src.v[row + x]);
            dst.v[row + x] = c;
            any            = any | c;
            x              = x + 1;
        }
        if (any != 0) { flags.v[slot * 2 + 1] = now; }
        ret;
    }

    val r:       i32 = meta.rule[word.RADIUS_AT]::i32;
    val width:   i32 = 2 * r + 1;
    val form:    u32 = meta.rule[word.FORM_AT];
    val total:   i32 = meta.rule[word.TOTAL_AT]:~i32;
    val top:     i32 = meta.rule[word.TOP_AT]::i32;
    val words:   u32 = meta.rule[word.WORDS_AT];
    val gen:     u32 = meta.gen + meta.serial;
    val inv_in:  u32 = word.inverted(form, gen & 1);
    val inv_out: u32 = word.inverted(form, (gen + 1) & 1);
    val past:    u32 = word.past(form, gen & 1);
    var live:    u32 = 0;
    var warm:    u32 = 0;
    for (x < x0 + 8) {
        val lx:  i32 = x::i32;
        var sum: i32 = 0;
        var dy:  i32 = 0 - r;
        for (dy <= r) {
            var y:  i32 = ly + dy;
            var cy: u32 = 1;
            if (y < 0) {
                y  = y + layout.SIDE::i32;
                cy = 0;
            }
            or (y >= layout.SIDE::i32) {
                y  = y - layout.SIDE::i32;
                cy = 2;
            }
            var dx: i32 = 0 - r;
            for (dx <= r) {
                val w: i32 = table.v[2 * words + ((dy + r) * width + dx + r)::u32]:~i32;
                if (w != 0) {
                    var xx: i32 = lx + dx;
                    var cx: u32 = 1;
                    if (xx < 0) {
                        xx = xx + layout.SIDE::i32;
                        cx = 0;
                    }
                    or (xx >= layout.SIDE::i32) {
                        xx = xx - layout.SIDE::i32;
                        cx = 2;
                    }
                    var at: u32 = layout.NONE;
                    if (seamed != 0) { at = reach(slot, lx + dx, ly + dy); }
                    or {
                        val n: u32 = meta.table[base + cy * 3 + cx];
                        if (n != layout.NONE) { at = n * layout.CELLS + (y * layout.SIDE::i32 + xx)::u32; }
                    }
                    if (at == layout.PAST) {
                        if (past != 0) { sum = sum + w; }
                    }
                    or (at != layout.NONE) {
                        if (src.v[at] >= word.LIVE) { sum = sum + w; }
                    }
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }

        # a cell held inverted reads as its complement, its sum as total less the held one
        val cur:   u32 = src.v[row + x];
        var alive: u32 = 0;
        if (cur >= word.LIVE) { alive = 1; }
        if (inv_in != 0) {
            alive = 1 - alive;
            sum   = total - sum;
        }
        var s: u32 = 0;
        if (sum > top) { s = top::u32; }
        or (sum > 0)   { s = sum::u32; }
        var set: u32 = 0;
        if (alive != 0) { set = words; }
        var bit: u32 = (table.v[set + s / 32] >> (s % 32)) & 1;
        bit = bit ^ inv_out;

        var next: u32 = 0;
        if (bit != 0) {
            var age: u32 = (cur >> word.AGE_SHIFT) + 1;
            if (age > word.AGE_MAX) { age = word.AGE_MAX; }
            next = (age << word.AGE_SHIFT) | word.HEAT_MASK;
        }
        or                                                      { next = cool(cur); }
        if (seamed != 0 && layout.edge_side(edge, lx, ly) != 4) { next = 0; }
        if (next >= word.LIVE)                                  { live = 1; }
        warm           = warm | (next & word.HEAT_MASK);
        dst.v[row + x] = next;
        x              = x + 1;
    }
    if (live != 0) { flags.v[slot * 2] = now; }
    if (warm != 0) { flags.v[slot * 2 + 1] = now; }
}
