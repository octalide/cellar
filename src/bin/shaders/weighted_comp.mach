# one generation of the chunks on the active list, under the weighted
# outer-totalistic family (cellar.rules.weighted)
#
# a cell is a bit in the family's state layer (word.WIDTH, cellar.layer), a
# row of 32 to a word, and its display channels, age << 8 | heat, lie in the
# view layer the family keeps beside it (word.SHOWN), bound after the rule
# buffer (layer.binding).
#
# an invocation is a run of 8 cells in a row, and 8 workgroups of 64 cover a
# chunk, a band of 8 rows each; workgroup y names the chunk's slot through the
# active list (cellar.layout.Flags). the four invocations whose runs share a
# word of the state layer leave their bits in workgroup memory, and the first
# writes the word, so no invocation writes a word another does. an invocation
# writes its own cells' display channels, four words of two cells each.
#
# a workgroup reads its band and an apron of the radius around it from the
# source pool once, into a shared tile of bits, a word of the source at a
# time: the tile's words are aligned to the chunk's columns from -32, so each
# is one word of one chunk's row. every neighbourhood is read from the tile
# after a workgroup barrier. the apron is read through the chunk's page-table
# entry, which names the slot of each of its eight neighbours, so a chunk that
# does not exist reads as dead. the tile holds the widest radius
# (word.RADIUS_MAX) in 640 bytes, well inside the 16 KiB of workgroup memory
# every device has.
#
# the kernel's path (cellar.rules.weighted path) picks how a run's sums are
# found. a SLICED kernel, Life's ring of unit weights, adds its eight
# neighbours bit-sliced, the run's 8 cells at once in the lanes of a word. a
# ROWS kernel counts each row of its footprint's run of bits once and slides
# it along the run. any other weighs every cell of its footprint.
#
# whether a chunk is stepped in full is decided once a workgroup, by its first
# invocation, since a neighbour's stamp may change while the dispatch runs and
# the tile's barrier must be reached by the whole workgroup or none of it.
#
# each step stamps, per slot, the step's serial into an alive and a warm word
# when the chunk's result holds a live or a warm cell; every invocation that
# finds one writes the same value, so no atomics are needed. the next step
# reads the stamps of the source: a chunk with no live cell in its 3 by 3 block
# only cools, and one that is also cold, and was cold the step before, already
# holds zeros in both pools and is skipped.
#
# a rule that births on 0 runs in its form (cellar.rules.weighted.word): the
# pool's background is dead in every form, so no chunk is stepped for it, and
# the step reads its source generation's parity as meta.gen + meta.serial. a
# cell past a plane's dead edge reads as the form holds the edge at that
# parity (word.past).
#
# the radius, form, total weight, sums' extent, path and runs are in the
# family's window of the meta head, and the sets and the weights in the rule
# buffer at layout.TABLE_BINDING, as cellar.rules.weighted pack and pack_table
# lay them out.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.Layer;
use cellar.layout.Meta;
use cellar.layout.Table;
use cellar.rules.weighted.word;
use sy: shader.sync;

#[storage(1, 0, "readonly")]
var src:   Layer;
#[storage(1, 1)]
var dst:   Layer;
#[storage(1, 2, "readonly")]
var meta:  Meta;
#[storage(1, 3)]
var flags: Flags;
#[storage(1, 4, "readonly")]
var table: Table;
#[storage(1, 5, "readonly")]
var hsrc:  Layer;
#[storage(1, 6)]
var hdst:  Layer;

#[builtin("global_invocation")]
var gid: u32x3;
#[builtin("local_invocation_index")]
var lid: u32;

# a band's rows and the widest apron above and below it, and the words a row
# of the tile takes: columns -32 to 95 cover the widest apron either side
val BAND:       u32 = 8;
val TILE_ROWS:  u32 = BAND + 2 * word.RADIUS_MAX;
val TILE_WORDS: u32 = 4;

rec Tile {
    v: [TILE_ROWS * TILE_WORDS]u32;
}

# the weighted sums of an invocation's 8 cells
rec Sums {
    v: [8]i32;
}

# each invocation's 8 cells one generation on, at their place in their word
rec Runs {
    v: [64]u32;
}

# the band's live cells and its apron's, bit c + 32 of a row's words the cell
# at column c, and a cell past a plane's dead edge as the form holds the edge
#[shared]
var tile: Tile;
#[shared]
var runs: Runs;
# 1 when the workgroup's chunk steps in full, as its first invocation found
#[shared]
var full: u32;

# the source's bit of the cell at address a (cellar.layer)
fun cell_of(a: u32) u32 {
    ret layer.read(src.v[layer.addr_word(word.WIDTH, a)], word.WIDTH, a);
}

# the address (cellar.layer) of the cell at (x, y) of a slot's frame, taken
# through the links where it lies outside the window (cellar.layout), NONE
# where no chunk holds it, or PAST past a plane's dead edge
fun reach(slot: u32, x: i32, y: i32) u32 {
    var sl: u32 = slot;
    var px: i32 = x;
    var py: i32 = y;
    var at: u32 = layout.NONE;
    var h:  u32 = 0;
    for (h <= layout.HOPS) {
        val b: u32 = sl * layout.ENTRY;
        val k: u32 = layout.edge_side(meta.table[b + layout.EDGE_AT], px, py);
        val n: u32 = meta.table[b + k];
        val t: u32 = meta.table[b + layout.LINK_AT + k];
        if (k == 4) {
            at = layer.addr(sl, (py * layout.SIDE::i32 + px)::u32);
            h  = layout.HOPS;
        }
        or (n == layout.NONE) {
            if ((t & layout.LINK_EDGE) != 0) { at = layout.PAST; }
            h = layout.HOPS;
        }
        or {
            val nx: i32 = layout.hop_x(t, px, py);
            py = layout.hop_y(t, px, py);
            px = nx;
            sl = n;
        }
        h = h + 1;
    }
    ret at;
}

# two cells' display channels, a word of their layer, one generation on with
# neither live: their heat fades and they have no age, a lane at a time
fun cool2(h: u32) u32 {
    val x: u32 = h & 0x00ff00ff;
    val y: u32 = (x | 0x80008000) - ((word.DECAY << 16) | word.DECAY);
    val m: u32 = ((y >> 15) & 0x00010001) * word.HEAT_MASK;
    ret y & m;
}

# the bits of a mask from bit lo to before bit hi, lo below hi
fun span(lo: u32, hi: u32) u32 {
    if (hi - lo >= 32) { ret 0xffffffff; }
    ret ((1 << (hi - lo)) - 1) << lo;
}

# the n bits of a tile row from bit p, p + n at most 64 past the row's word t
fun window(t: u32, p: u32, n: u32) u32 {
    val ws: u32 = p / 32;
    val sh: u32 = p % 32;
    var w:  u32 = tile.v[t + ws] >> sh;
    if (sh + n > 32) { w = w | (tile.v[t + ws + 1] << (32 - sh)); }
    if (n >= 32)     { ret w; }
    ret w & ((1 << n) - 1);
}

# the tile row's bit of column c, from -32
fun at(t: u32, c: i32) u32 {
    val p: u32 = (c + 32)::u32;
    ret (tile.v[t + p / 32] >> (p % 32)) & 1;
}

# the lanes, of 8, whose bit-sliced count s3 s2 s1 s0 a set mask of the sums
# 0 to 8 holds
fun counted(mask: u32, s0: u32, s1: u32, s2: u32, s3: u32) u32 {
    var m: u32 = 0;
    var n: u32 = 0;
    for (n < 9) {
        if (((mask >> n) & 1) != 0) {
            var e: u32 = s0;
            if ((n & 1) == 0) { e = ~s0; }
            if ((n & 2) != 0) { e = e & s1; }
            or                { e = e & ~s1; }
            if ((n & 4) != 0) { e = e & s2; }
            or                { e = e & ~s2; }
            if ((n & 8) != 0) { e = e & s3; }
            or                { e = e & ~s3; }
            m = m | e;
        }
        n = n + 1;
    }
    ret m & 0xff;
}

# the rule's answer as held for a cell held alive or not at a held sum
fun answer(alive: u32, held: i32, total: i32, top: i32, words: u32, inv_in: u32, inv_out: u32) u32 {
    var on:  u32 = alive;
    var sum: i32 = held;
    if (inv_in != 0) {
        on  = 1 - on;
        sum = total - sum;
    }
    var s: u32 = 0;
    if (sum > top) { s = top::u32; }
    or (sum > 0)   { s = sum::u32; }
    var set: u32 = 0;
    if (on != 0) { set = words; }
    ret ((table.v[set + s / 32] >> (s % 32)) & 1) ^ inv_out;
}

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    # workgroup y names an entry of the active list past the dispatch's base,
    # and a dispatch may run past the list's end
    val entry: u32 = gid[1] + meta.base[0];
    if (entry >= flags.args[1]) { ret; }
    val slot: u32 = flags.list[entry];
    val ly:   i32 = (gid[0] / 8)::i32;
    val band: i32 = ((gid[0] / 64) * BAND)::i32;
    val x0:   u32 = (gid[0] % 8) * 8;
    val base: u32 = slot * layout.ENTRY;
    # the state layer's word holding the run, and the run's first display word
    val sw: u32 = layer.span_at(word.WIDTH, slot) + ly::u32 * 2 + x0 / 32;
    val hw: u32 = layer.span_at(word.SHOWN, slot) + (ly::u32 * layout.SIDE + x0) / 2;
    if (meta.table[base + layout.INCARNATION_AT] == 0) { ret; }
    # a seamed chunk reads its block through its links, and holds its cells
    # off the grid at zero
    val edge:   u32 = meta.table[base + layout.EDGE_AT];
    val seamed: u32 = layout.seamed(edge);

    # the serial that produced the source. a stamp this step already wrote
    # may have replaced it, so a stamp of either serial counts as set then; a
    # chunk that is live or warm at the source carries one of the two
    val last: u32 = meta.serial - 1;
    val now:  u32 = meta.serial;
    if (lid == 0) {
        var busy: u32 = 0;
        var k:    u32 = 0;
        for (k < 9) {
            val n: u32 = meta.table[base + k];
            if (n != layout.NONE) {
                val f: u32 = flags.v[n * 2];
                if (f == last || f == now) { busy = 1; }
            }
            k = k + 1;
        }
        if (seamed != 0) { busy = 1; }
        full = busy;
    }
    sy.workgroup_barrier();
    val busy: u32 = full;
    var j:    u32 = 0;
    if (busy == 0) {
        # every cell is dead and stays so, and only cools
        val warm: u32 = flags.v[slot * 2 + 1];
        if (warm != last && warm != now) {
            # cold at the source; if it was cold a step earlier too, the
            # destination already holds zeros
            if (warm != last - 1) { ret; }
            if (x0 % 32 == 0)     { dst.v[sw] = 0; }
            for (j < 4) {
                hdst.v[hw + j] = 0;
                j              = j + 1;
            }
            ret;
        }
        if (x0 % 32 == 0) { dst.v[sw] = 0; }
        var any: u32 = 0;
        for (j < 4) {
            val c: u32 = cool2(hsrc.v[hw + j]);
            hdst.v[hw + j] = c;
            any            = any | c;
            j              = j + 1;
        }
        if (any != 0) { flags.v[slot * 2 + 1] = now; }
        ret;
    }

    val r:       i32 = meta.rule[word.RADIUS_AT]::i32;
    val width:   i32 = 2 * r + 1;
    val form:    u32 = meta.rule[word.FORM_AT];
    val total:   i32 = meta.rule[word.TOTAL_AT]:~i32;
    val top:     i32 = meta.rule[word.TOP_AT]::i32;
    val words:   u32 = meta.rule[word.WORDS_AT];
    val path:    u32 = meta.rule[word.PATH_AT];
    val gen:     u32 = meta.gen + meta.serial;
    val inv_in:  u32 = word.inverted(form, gen & 1);
    val inv_out: u32 = word.inverted(form, (gen + 1) & 1);
    val past:    u32 = word.past(form, gen & 1);

    # the tile's rows from the band's first less the radius; a word's columns
    # outside the apron stay clear
    val rows: u32 = BAND + 2 * r::u32;
    var i:    u32 = lid;
    for (i < rows * TILE_WORDS) {
        val y:    i32 = band - r + (i / TILE_WORDS)::i32;
        val k:    u32 = i % TILE_WORDS;
        val c0:   i32 = k::i32 * 32 - 32;
        var lo:   i32 = c0;
        var hi:   i32 = c0 + 32;
        var bits: u32 = 0;
        if (lo < 0 - r)                { lo = 0 - r; }
        if (hi > layout.SIDE::i32 + r) { hi = layout.SIDE::i32 + r; }
        if (seamed != 0) {
            var c: i32 = lo;
            for (c < hi) {
                val a:  u32 = reach(slot, c, y);
                var on: u32 = 0;
                if (a == layout.PAST) { on = past; }
                or (a != layout.NONE) { on = cell_of(a); }
                bits = bits | (on << (c - c0)::u32);
                c    = c + 1;
            }
        }
        or (lo < hi) {
            var yy: i32 = y;
            var cy: u32 = 1;
            if (yy < 0) {
                yy = yy + layout.SIDE::i32;
                cy = 0;
            }
            or (yy >= layout.SIDE::i32) {
                yy = yy - layout.SIDE::i32;
                cy = 2;
            }
            # words 0 and 3 lie in the west and east neighbours, 1 and 2 in
            # the chunk, and each is one word of that chunk's row
            val cx: u32 = (k + 1) / 2;
            val n:  u32 = meta.table[base + cy * 3 + cx];
            if (n != layout.NONE) {
                val w: u32 = src.v[layer.span_at(word.WIDTH, n) + yy::u32 * 2 + (k + 1) % 2];
                bits = w & span((lo - c0)::u32, (hi - c0)::u32);
            }
        }
        tile.v[i] = bits;
        i         = i + 64;
    }
    sy.workgroup_barrier();

    # the tile row of the run's own cells
    val own:  u32 = (ly - band + r)::u32 * TILE_WORDS;
    var next: u32 = 0;
    if (path == word.SLICED) {
        # the rows above, at and below the run, from the cell west of its first
        # to the one east of its last, as the world holds them: lane c of a
        # word the cell c of the run's west, own or east neighbour
        val fin:  u32 = (0 - inv_in) & 0x3ff;
        val a:    u32 = window(own - TILE_WORDS, x0 + 31, 10) ^ fin;
        val c:    u32 = window(own, x0 + 31, 10) ^ fin;
        val d:    u32 = window(own + TILE_WORDS, x0 + 31, 10) ^ fin;
        val sa:   u32 = a ^ (a >> 1) ^ (a >> 2);
        val ca:   u32 = (a & (a >> 1)) | ((a >> 2) & (a ^ (a >> 1)));
        val sd:   u32 = d ^ (d >> 1) ^ (d >> 2);
        val cd:   u32 = (d & (d >> 1)) | ((d >> 2) & (d ^ (d >> 1)));
        val sc:   u32 = c ^ (c >> 2);
        val cc:   u32 = c & (c >> 2);
        val s0:   u32 = sa ^ sd ^ sc;
        val c0:   u32 = (sa & sd) | (sc & (sa ^ sd));
        val u:    u32 = ca ^ cd ^ cc;
        val v:    u32 = (ca & cd) | (cc & (ca ^ cd));
        val s1:   u32 = u ^ c0;
        val w:    u32 = u & c0;
        val s2:   u32 = v ^ w;
        val s3:   u32 = v & w;
        val me:   u32 = (c >> 1) & 0xff;
        val born: u32 = ~me & counted(table.v[0], s0, s1, s2, s3);
        val kept: u32 = me & counted(table.v[words], s0, s1, s2, s3);
        next = ((born | kept) & 0xff) ^ ((0 - inv_out) & 0xff);
    }
    or (path == word.ROWS) {
        # each footprint row's run of unit weights counted once for the run's
        # first cell, then slid a cell at a time
        var sums: Sums;
        var c:    u32 = 0;
        for (c < 8) {
            sums.v[c] = 0;
            c         = c + 1;
        }
        var dy: i32 = 0 - r;
        for (dy <= r) {
            val q:  u32 = word.RUNS_AT + ((dy + r) * 2)::u32;
            val rl: i32 = meta.rule[q]::i32 - word.RADIUS_MAX::i32;
            val rh: i32 = meta.rule[q + 1]::i32 - word.RADIUS_MAX::i32;
            if (rl < rh) {
                val t: u32 = (ly - band + dy + r)::u32 * TILE_WORDS;
                var n: i32 = 0;
                var e: i32 = x0::i32 + rl;
                for (e < x0::i32 + rh) {
                    n = n + at(t, e)::i32;
                    e = e + 1;
                }
                c = 0;
                for (c < 8) {
                    sums.v[c] = sums.v[c] + n;
                    val x: i32 = x0::i32 + c::i32;
                    n = n + at(t, x + rh)::i32 - at(t, x + rl)::i32;
                    c = c + 1;
                }
            }
            dy = dy + 1;
        }
        val hole: u32 = meta.rule[word.HOLE_AT];
        c = 0;
        for (c < 8) {
            val alive: u32 = at(own, x0::i32 + c::i32);
            var s:     i32 = sums.v[c];
            if (hole != 0) { s = s - alive::i32; }
            next = next | (answer(alive, s, total, top, words, inv_in, inv_out) << c);
            c    = c + 1;
        }
    }
    or {
        # every weight is loaded once and applied to the run's 8 cells: cell
        # c's footprint row starts at bit sh + c of word ws of its tile row
        var sums: Sums;
        var c:    u32 = 0;
        for (c < 8) {
            sums.v[c] = 0;
            c         = c + 1;
        }
        val at0: u32 = (x0::i32 - r + 32)::u32;
        var dy:  i32 = 0 - r;
        for (dy <= r) {
            val t: u32 = (ly - band + dy + r)::u32 * TILE_WORDS;
            var k: i32 = 0;
            for (k < width) {
                val w: i32 = table.v[2 * words + ((dy + r) * width + k)::u32]:~i32;
                if (w != 0) {
                    val run: u32 = window(t, at0 + k::u32, 8);
                    c = 0;
                    for (c < 8) {
                        sums.v[c] = sums.v[c] + w * ((run >> c) & 1)::i32;
                        c         = c + 1;
                    }
                }
                k = k + 1;
            }
            dy = dy + 1;
        }
        c = 0;
        for (c < 8) {
            next = next | (answer(at(own, x0::i32 + c::i32), sums.v[c], total, top, words, inv_in, inv_out) << c);
            c    = c + 1;
        }
    }
    # cells off the grid are held at zero
    if (seamed != 0) {
        var c: u32 = 0;
        for (c < 8) {
            if (layout.edge_side(edge, (x0 + c)::i32, ly) != 4) { next = next & ~(1 << c); }
            c = c + 1;
        }
    }

    # the run's display channels follow its cells
    var warm: u32 = 0;
    for (j < 4) {
        val h: u32 = hsrc.v[hw + j];
        var v: u32 = word.become(h & 0xffff, (next >> (j * 2)) & 1) | (word.become(h >> 16, (next >> (j * 2 + 1)) & 1) << 16);
        if (seamed != 0) {
            if (layout.edge_side(edge, (x0 + j * 2)::i32, ly) != 4)     { v = v & 0xffff0000; }
            if (layout.edge_side(edge, (x0 + j * 2 + 1)::i32, ly) != 4) { v = v & 0xffff; }
        }
        hdst.v[hw + j] = v;
        warm           = warm | v;
        j              = j + 1;
    }

    # the run's word of the state layer, from the four runs it holds
    runs.v[lid] = next << (x0 % 32);
    sy.workgroup_barrier();
    if (x0 % 32 == 0) { dst.v[sw] = runs.v[lid] | runs.v[lid + 1] | runs.v[lid + 2] | runs.v[lid + 3]; }
    if (next != 0)    { flags.v[slot * 2] = now; }
    if (warm != 0)    { flags.v[slot * 2 + 1] = now; }
}
