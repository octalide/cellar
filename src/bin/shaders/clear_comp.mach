# empty the chunks just allocated in every layer, in both cells, and mark them
# cold
#
# workgroup y names an entry of the list, the slot to clear, z a layer of the
# set the meta head names, and x a run of 64 words of the slot's span of it
# (cellar.layer), the dispatch's workgroups along x covering the widest span,
# so a narrower layer's run past its span leaves at once. both cells are
# cleared, reached by address, and the slot's stamps set to zero, a serial no
# step uses, so the step leaves it alone until a neighbour comes alive.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.List;
use cellar.layout.Meta;

#[storage(1, 0, "readonly")]
var meta:  Meta;
#[storage(1, 1, "readonly")]
var list:  List;
#[storage(1, 2)]
var flags: Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot:  u32 = list.v[gid[1]];
    val k:     u32 = gid[2];
    val width: u32 = layer.width_in(meta.base[layout.WIDTHS_AT - layout.BASE_AT], k);
    if (gid[0] >= layer.span_words(width)) { ret; }
    val place: layout.Where = layout.where(slot, meta.base[layout.SHARD_AT - layout.BASE_AT]);
    val a:     layout.Span  = layer.span(meta.shards, k, 0, place, width);
    val b:     layout.Span  = layer.span(meta.shards, k, 1, place, width);
    a.p.v[a.at + gid[0]] = 0;
    b.p.v[b.at + gid[0]] = 0;
    if (gid[0] == 0 && k == 0) {
        flags.v[slot * 2]     = 0;
        flags.v[slot * 2 + 1] = 0;
    }
}
