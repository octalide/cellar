# empty the chunks just allocated in one layer, in both pools, and mark them
# cold
#
# workgroup y names an entry of the list, the slot to clear, and x a run of 64
# words of its span of the layer (cellar.layer), so the dispatch's workgroups
# along x cover a span and say how wide the layer is. a dispatch for each
# layer clears it. both pools are cleared and the slot's stamps set to zero, a
# serial no step uses, so the step leaves it alone until a neighbour comes
# alive.

use cellar.layer;
use cellar.layout.Flags;
use cellar.layout.Layer;
use cellar.layout.List;

#[storage(1, 0)]
var a:     Layer;
#[storage(1, 1)]
var b:     Layer;
#[storage(1, 2, "readonly")]
var list:  List;
#[storage(1, 3)]
var flags: Flags;

#[builtin("global_invocation")]
var gid:    u32x3;
#[builtin("num_workgroups")]
var groups: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot:  u32 = list.v[gid[1]];
    val width: u32 = layer.width_of(groups[0] * 64);
    val at:    u32 = layer.span_at(width, slot) + gid[0];
    a.v[at] = 0;
    b.v[at] = 0;
    if (gid[0] == 0) {
        flags.v[slot * 2]     = 0;
        flags.v[slot * 2 + 1] = 0;
    }
}
