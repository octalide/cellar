# empty the chunks just allocated in every layer, in both cells, and mark them
# cold
#
# the workgroup's row (cellar.layout row) names an entry of the list, the slot
# to clear, and x a run of 64 words of the slot's span of each layer of the
# set the meta head names (cellar.layer), the dispatch's workgroups along x
# covering the widest span, so a narrower layer's run past its span is left
# alone. both cells are cleared, reached by address, and the slot's stamps set
# to zero, a serial no step uses, so the step leaves it alone until a
# neighbour comes alive.

use cellar.layer;
use cellar.layout;
use cellar.layout.Flags;
use cellar.layout.List;
use cellar.layout.Meta;

#[storage(1, 0, "readonly")]
var meta:  Meta;
#[storage(1, 1, "readonly")]
var list:  List;
#[storage(1, 2)]
var flags: Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val e: u32 = layout.row(gid[1], gid[2], meta.base[layout.FOLD_AT - layout.BASE_AT]);
    if (e >= list.n) { ret; }
    val slot:   u32          = list.v[e];
    val widths: u32          = meta.base[layout.WIDTHS_AT - layout.BASE_AT];
    val n:      u32          = layer.set_layers(meta.base[layout.SET_AT - layout.BASE_AT]);
    val place:  layout.Where = layout.where(slot, meta.base[layout.SHARD_AT - layout.BASE_AT]);
    var k:      u32          = 0;
    for (k < n) {
        val width: u32 = layer.width_in(widths, k);
        if (gid[0] < layer.span_words(width)) {
            val a: layout.Span = layer.span(meta.shards, k, 0, place, width);
            val b: layout.Span = layer.span(meta.shards, k, 1, place, width);
            a.p.v[a.at + gid[0]] = 0;
            b.p.v[b.at + gid[0]] = 0;
        }
        k = k + 1;
    }
    if (gid[0] == 0) {
        flags.v[slot * 2]     = 0;
        flags.v[slot * 2 + 1] = 0;
    }
}
