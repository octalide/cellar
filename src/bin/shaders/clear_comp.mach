# empty the chunks just allocated, in both pools, and mark them cold
#
# workgroup y names an entry of the list, the slot to clear, and x a run of 64
# of its cells. both pools are cleared and the slot's stamps set to zero, a
# serial no step uses, so the step leaves it alone until a neighbour comes
# alive.

use cellar.layout;
use cellar.layout.Cells;
use cellar.layout.Flags;
use cellar.layout.List;

#[storage(1, 0)]
var a:     Cells;
#[storage(1, 1)]
var b:     Cells;
#[storage(1, 2, "readonly")]
var list:  List;
#[storage(1, 3)]
var flags: Flags;

#[builtin("global_invocation")]
var gid: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val slot: u32 = list.v[gid[1]];
    a.v[slot * layout.CELLS + gid[0]] = 0;
    b.v[slot * layout.CELLS + gid[0]] = 0;
    if (gid[0] == 0) {
        flags.v[slot * 2]     = 0;
        flags.v[slot * 2 + 1] = 0;
    }
}
