# cellar, an interactive cellular-automata editor and visualizer
#
# brings boom up with a window, hands it the hooks in cellar.game, and tears it
# down once the loop ends. settings, worlds and patterns are saved in the
# platform's user data directory (cellar.paths). `cellar --version` prints the
# version and exits without opening a window. `cellar --capture <file.png>`
# draws a second of frames, saves the last to the file and exits, leaving the
# saved settings alone, which is how the README's screenshots are taken.
# `cellar --bench <gpu|cpu> <dense|sparse|gun|footprint> [seconds [radius
# [speed]]] [--rule <rule>]` runs a world for that long, ten seconds by default, under
# the rule given, Life by default, widened to the radius, one by default, or for footprint a vote over the
# whole square at the radius, uncapped or at speed generations a
# second, prints its generations per second, time per step, cells stepped per
# second and frame time, and exits, leaving the saved settings alone. `--bench <gpu|cpu> pause
# [seconds]` runs Seeds from a soup, pausing it after each run of that long and
# resuming it, and prints how long each pause took to apply; with `--engine
# hashlife` it runs on the tree. `cellar <file>` opens a world, or stamps a pattern in
# any format cellar reads onto an empty world and frames it, with the first
# frame. `--engine <cpu|gpu|hashlife>` runs the world on that engine, and says
# why and exits when the GPU cannot step or HashLife cannot run the rule.
# a rule string naming a rule table (Golly's form, the table's name) is looked
# up as a <name>.rule file in the data directory first (cellar.rules.table.store).
# `cellar run <pattern> --gens <n> [--rule <rule>] [--engine <cpu|hashlife>]
# [--out <file>] [--quiet] [--max-population <n|off>] [--max-pool-memory <MiB|off>]
# [--max-memory <MiB|off>] [--max-step-ms <ms|off>]` steps the file headless on
# the CPU or HashLife through cellar.batch, writes
# the result in the format --out's extension names, RLE on stdout without it,
# and reports the generation and population on stderr, exiting 1 when the run
# fails. it pauses at the ceilings the saved settings keep, each --max-* option
# setting one over them, and a run that crosses one stops there, writes the
# world as it stood, says which and exits 3. no boom context is made for it, so
# no window opens. options come in
# any order and `--` ends them; a command line cellar.args refuses is reported
# with the usage, the run's alone for a refused run, exiting 2 without a window.

use boom.app.App;
use boom.context.Config;
use boom.context.Context;
use boom.context.ContextError;
use boom.context.context_error_message;
use boom.context.context_init;
use boom.context.context_set_user;
use boom.context.context_shutdown;
use boom.engine.EngineError;
use boom.engine.engine_error_message;
use boom.engine.run;
use cellar.args;
use cellar.batch;
use cellar.ceiling;
use cellar.config;
use cellar.game;
use cellar.paths;
use cellar.rules.table.store;
use allo: std.allocator;
use std.allocator.page;
use std.chrono.duration.MILLISECOND;
use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the exit status of a batch run that stopped at a ceiling
val STOPPED: i64 = 3;

# the version this binary was built as, from the manifest
val VERSION: str = $mach.project.version;

# a batch run from its arguments
fun run_batch(r: args.Run) i64 {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) {
        print.eprintln("cellar: out of memory");
        ret 1;
    }
    # a rule string naming a table finds its .rule file in the data directory
    var dirs: paths.Paths;
    paths.init(?dirs);
    if (dirs.ok) { store.search(paths.dir(?dirs)); }
    # the saved ceilings, each option given over them
    var c: ceiling.Ceilings = ceiling.defaults();
    if (dirs.ok) {
        var sp: [1088]u8;
        config.load_ceilings(?a, paths.file(?dirs, paths.SETTINGS, ?sp[0]), ?c);
    }
    var k: usize = 0;
    for (k < ceiling.COUNT) {
        if (r.set[k]) {
            c.on[k] = r.limit[k] != 0;
            if (c.on[k]) { c.limit[k] = r.limit[k]; }
        }
        k = k + 1;
    }
    var msg:  [160]u8;
    var j:    batch.Job                      = batch.Job{pattern: r.pattern, rule: r.rule, gens: r.gens, engine: r.engine, out: r.out, ceil: c};
    val done: res[batch.Report, batch.Error] = batch.run(?a, ?j);
    if (sel done.err) {
        print.eprintlnf("cellar: {}: {}", batch.error_subject(done.err, ?j), batch.error_message(done.err, ?msg[0]));
        ret 1;
    }
    val st: usize = done.ok.stopped;
    if (st != ceiling.COUNT) {
        print.eprintlnf("cellar: {}: stopped at generation {}: {} passed its ceiling of {} {}; {} raises it or turns it off", r.pattern, done.ok.generation, ceiling.name(st), c.limit[st], ceiling.unit(st), ceiling.flag(st));
    }
    if (!r.quiet)            { print.eprintlnf("generation {} population {}", done.ok.generation, done.ok.population); }
    if (st != ceiling.COUNT) { ret STOPPED; }
    ret 0;
}

# the window the saved settings ask for, the default for a run that saves none
fun saved_frame(capturing: bool) config.Frame {
    var f: config.Frame = config.default_frame();
    if (capturing) { ret f; }
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret f; }
    var dirs: paths.Paths;
    paths.init(?dirs);
    if (!dirs.ok) { ret f; }
    var sp: [1088]u8;
    config.load_frame(?a, paths.file(?dirs, paths.SETTINGS, ?sp[0]), ?f);
    ret f;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val parsed: res[args.Args, args.Error] = args.parse(argc, argv);
    if (sel parsed.err) {
        var why: [1100]u8;
        print.eprintlnf("cellar: {}", args.error_message(parsed.err, ?why[0]));
        print.eprintln(args.usage(argc, argv));
        ret 2;
    }
    if (parsed.ok.command == args.COMMAND_RUN) { ret run_batch(parsed.ok.run); }
    if (parsed.ok.version) {
        print.printlnf("cellar {}", VERSION);
        ret 0;
    }

    var g: game.Game;
    g.bench      = parsed.ok.bench;
    g.bench_cpu  = parsed.ok.bench_cpu;
    g.bench_secs = parsed.ok.bench_secs;
    g.bench_r    = parsed.ok.bench_r;
    g.bench_gps  = parsed.ok.bench_gps;
    g.bench_rule = parsed.ok.bench_rule;
    g.bench_mode = parsed.ok.bench_mode;
    g.engine     = parsed.ok.engine;
    g.capture    = nil;
    g.open       = parsed.ok.open;
    if (parsed.ok.capture != nil) { game.capture_after(?g, parsed.ok.capture, 60); }

    var app: App;
    app.f_init = game.on_init;
    app.f_tick = game.on_tick;
    app.f_draw = game.on_draw;
    app.f_dnit = game.on_dnit;

    var ctx:   Context;
    val frame: config.Frame = saved_frame(parsed.ok.bench != args.BENCH_NONE || parsed.ok.capture != nil);
    val cfg:   Config       = Config{
        width:     frame.placement.width,
        height:    frame.placement.height,
        position:  frame.placement.position,
        title:     "cellar",
        fixed_dt:  game.TICK,
        max_frame: 250 * MILLISECOND,
        frame_dt:  0,
        mode:      frame.mode,
    };
    val started: err[ContextError] = context_init(?ctx, cfg);
    if (sel started.err) {
        print.eprintlnf("could not start: {}", context_error_message(started.err));
        ret 1;
    }
    context_set_user(?ctx, (?g)::ptr);
    val ran: res[i64, EngineError] = run(?ctx, ?app);
    # on_dnit released the renderer inside run, so the window is free to close
    val closed: err[ContextError] = context_shutdown(?ctx);
    if (sel closed.err) {
        print.eprintlnf("shutdown refused: {}", context_error_message(closed.err));
        ret 1;
    }
    if (sel ran.err) {
        print.eprintlnf("the frame loop stopped: {}", engine_error_message(ran.err));
        ret 1;
    }
    ret ran.ok;
}
