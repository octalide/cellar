# the fixed update step the input and capped stepping run at
pub val TICK: Duration = SECOND / 60;
# unscaled pixels the view pans per tick while an arrow key is held
val PAN_STEP: f32 = 12.0;
# zoom factor change per scroll notch
val ZOOM_STEP: f32 = 0.1;

# everything cellar holds between hooks, reached through ctx.user
# ---
# a:           allocator backing the world and file buffers
# app:         view and editing state
# sim:         the simulation
# runner:      the simulation thread, and who holds the world
# shown:       what the interface shows of the world, as of the last
#              completed generation it saw
# renderer:    boom's renderer on the window
# srgb:        the swapchain encodes sRGB
# gui:         the interface's blit host
# gui_ok:      gui is set up
# msgs:        the flashed message as the interface shows it, kept while gui is
# world:       what the pointer did to the world this frame, beneath the interface
# paths:       the data directory
# snap:        a screenshot being read back
# capture:     a path to save one screenshot to and quit, or nil
# open:        a world or pattern file to open at startup, or nil
# countdown:   frames left before that screenshot
# sim_ok:      sim holds a pool to release
# renderer_ok: renderer is initialized
# gpu:         the world's side on the GPU
# gpu_ok:      gpu is initialized
# sketches:    the textures large patterns are drawn from
# bench:       the measurement being run, args.BENCH_NONE for a normal session
# bench_cpu:   the measurement steps on the CPU
# bench_secs:  seconds the measurement runs for
# bench_r:     the radius the measured rule reads, Life's weights widened to it, or
#              the radius of the footprint world's kernel
# bench_gps:   generations a second the measurement is capped at, 0 uncapped
# engine:      the args.ENGINE_* the command line named
# saved_tree:  HashLife was wanted by the settings, not the command line, so a
#              world it cannot take stays on the pool
# want_tree:   the world is to move onto HashLife with the first frame, and
#              the run stops if it cannot
# started:     when the measurement began
# frames:      frames drawn since it began, the warmup's included
# gen0:        the generation it began at
# gen_seen:    the generation the last measured frame showed
# cell_gens:   the cells of the chunks the pool held, summed over each
#              generation completed since it began
# pausing:     a measured pause was asked for and has not applied
# pauses:      measured pauses applied
# worst:       the longest a measured pause took to apply, in nanoseconds
pub rec Game {
    a:           allo.Allocator;
    app:         app.App;
    sim:         sim.Sim;
    runner:      runner.Runner;
    shown:       world.Shown;
    renderer:    gfx.Renderer;
    srgb:        bool;
    gui:         gui.Gui;
    gui_ok:      bool;
    msgs:        hud.Messages;
    world:       bint.Hit;
    paths:       paths.Paths;
    snap:        shot.Shot;
    capture:     str;
    open:        str;
    countdown:   i32;
    sim_ok:      bool;
    renderer_ok: bool;
    gpu:         gpu.Gpu;
    gpu_ok:      bool;
    sketches:    sketch.Sketches;
    bench:       u8;
    bench_cpu:   bool;
    bench_secs:  f64;
    bench_r:     usize;
    bench_gps:   usize;
    engine:      u8;
    saved_tree:  bool;
    want_tree:   bool;
    started:     Instant;
    frames:      u64;
    gen0:        u64;
    gen_seen:    u64;
    cell_gens:   f64;
    pausing:     bool;
    pauses:      u64;
    worst:       i64;
}

# frames a measurement lets pass before it starts the clock
val WARMUP: u64 = 30;
# the side of the footprint measurement's square, wide enough that the step
# stage's work outweighs the frame's fixed cost
val FOOTPRINT_SIDE: usize = 1024;
# pauses the pause measurement times
val PAUSES: u64 = 10;

fun game_of(ctx: *Context) *Game {
    ret context_user(ctx)::*Game;
}

fun give_up(ctx: *Context, what: str) {
    print.eprintln(what);
    context_fail(ctx, 1);
}

# the settings file's path into buf
fun settings(g: *Game, buf: *u8) str {
    ret paths.file(?g.paths, paths.SETTINGS, buf);
}

# build the world, the renderer and the interface; a failure stops the run
# ---
# ctx: the running context
pub fun on_init(ctx: *Context) {
    val g: *Game = game_of(ctx);
    g.sim_ok      = false;
    g.renderer_ok = false;
    g.gui_ok      = false;
    val paged: err[allo.Error] = page.make(?g.a);
    if (sel paged.err) {
        give_up(ctx, "could not make the page allocator");
        ret;
    }

    app.init(?g.app);
    val shown: err[format.Error] = app.attach(?g.app, ?g.a);
    if (sel shown.err) {
        give_up(ctx, "could not load the pattern library");
        ret;
    }
    paths.init(?g.paths);
    if (g.paths.ok) {
        # a rule string naming a table finds its .rule file in the data directory
        store.search(paths.dir(?g.paths));
        val prepared: err[fs.FsError] = paths.prepare(?g.a, ?g.paths);
        if (sel prepared.err) { print.eprintlnf("could not make {}", paths.dir(?g.paths)); }
        or {
            val moved: err[persist.Error] = persist.migrate(?g.a, ?g.paths);
            if (sel moved.err) { print.eprintlnf("old saves left as they were: {}", persist.error_message(moved.err)); }
        }
    }
    or { print.eprintln("no user data directory is known, so nothing will be saved"); }

    val made: err[allo.Error] = sim.init(?g.sim, ?g.a);
    if (sel made.err) {
        give_up(ctx, "could not allocate the world");
        ret;
    }
    g.sim_ok = true;
    # restore saved settings and the rule before seeding the world
    if (g.bench == args.BENCH_NONE && g.paths.ok) {
        var sp:     [1088]u8;
        val loaded: err[persist.Error] = config.load(?g.a, ?g.app, ?g.sim, settings(g, ?sp[0]));
        if (sel loaded.err) { print.eprintlnf("settings ignored: {}", persist.error_message(loaded.err)); }
    }

    val rr: err[gfx.Error] = gpu.renderer_init(?g.renderer, ?ctx.window);
    if (sel rr.err) {
        print.eprintlnf("could not start the renderer: {}", gfx.error_message(rr.err));
        context_fail(ctx, 1);
        ret;
    }
    g.renderer_ok = true;
    g.srgb        = gfx.renderer_is_srgb(?g.renderer);
    var info: gfx.DeviceInfo = gfx.renderer_device_info(?g.renderer);
    device.of(?g.app.device, ?info);
    sketch.init(?g.sketches, ?g.a, gfx.renderer_device(?g.renderer));
    g.gui_ok = gui.init(?g.gui, ?g.a, gfx.renderer_device(?g.renderer), ctx);
    if (g.gui_ok) {
        val pe: err[blit.state.Error] = panel.persist(?g.gui.ui);
        g.gui_ok = !(sel pe.err);
    }
    if (!g.gui_ok) {
        gui.dnit(?g.gui);
        give_up(ctx, "could not set up the interface");
        ret;
    }
    panel.restore(?g.gui.ui, ?g.app);
    hud.messages_init(?g.msgs, ?g.a);

    # the palettes are converted once, into the space the window stores
    var heat: [1024]f32;
    var age:  [1024]f32;
    render.palettes(?heat[0], ?age[0], g.srgb);
    val gr: err[gfx.Error] = gpu.init(?g.gpu, ?g.a, ?g.renderer, g.sim.space.cap, ?heat[0], ?age[0]);
    if (sel gr.err) {
        print.eprintlnf("could not set up the world on the GPU: {}", gfx.error_message(gr.err));
        context_fail(ctx, 1);
        ret;
    }
    g.gpu_ok = true;
    # a command-line engine decides this run, else the settings' choice does,
    # but a measurement steps where it was told to
    val soft:   bool = g.app.device.software && g.bench == args.BENCH_NONE;
    val engine: u8   = pick_engine(?g.app, ?g.sim, g.engine, soft);
    if (soft) { say_software(?g.app, engine); }
    g.saved_tree = g.engine == args.ENGINE_ANY && engine == args.ENGINE_HASHLIFE;
    if (g.bench_cpu || engine == args.ENGINE_CPU) { gpu.forgo_compute(?g.gpu); }
    sim.attach(?g.sim, ?g.gpu);
    if (!g.gpu.stepping && engine == args.ENGINE_GPU) {
        give_up(ctx, "cellar: --engine gpu: the GPU here cannot step the world");
        ret;
    }
    if (!g.gpu.stepping && engine != args.ENGINE_CPU) { print.eprintln("the GPU cannot step the world; stepping on the CPU"); }

    # the world is seeded once the GPU has set how far the pool may grow
    g.want_tree = false;
    if (g.bench != args.BENCH_NONE) { bench_world(g); }
    or                              { g.want_tree = start_world(?g.app, ?g.sim, g.open, g.capture != nil, engine); }

    world.observe(?g.sim, ?g.shown);
    val spawned: err[thread.ThreadError] = runner.start(?g.runner, ?g.sim);
    if (sel spawned.err) { give_up(ctx, "could not start the simulation thread"); }
}

# the engine a session runs on: the command line's when it names one, else the
# one the settings chose, which is not changed by the command line's
#
# a saved HashLife that cannot run the loaded rule gives way to the chunk
# engine, with a message. a saved GPU is the default, which steps on the GPU
# where it can, and so is ENGINE_ANY rather than ENGINE_GPU, which a machine
# without one refuses. on a software device that default steps on the CPU,
# which outruns the GPU engine emulated there, and only --engine gpu steps on it.
# ---
# a:        application state, with the settings loaded
# s:        the simulation, with the rule loaded
# cli:      the args.ENGINE_* the command line named
# software: the device is a software one (cellar.device)
# ret:      the args.ENGINE_* to run on
pub fun pick_engine(a: *app.App, s: *sim.Sim, cli: u8, software: bool) u8 {
    if (cli != args.ENGINE_ANY) { ret cli; }
    if (a.engine_tree) {
        if (rule.caps(?s.rule).no_tree == nil) { ret args.ENGINE_HASHLIFE; }
        var rb: [rule.DISPLAY_MAX + 1]u8;
        app.say_why(a, "HashLife cannot run the saved rule", rule.display(?s.rule, ?rb[0]));
        app.say_also(a, "using the chunk engine");
        ret args.ENGINE_ANY;
    }
    if (a.engine_cpu || software) { ret args.ENGINE_CPU; }
    ret args.ENGINE_ANY;
}

# say that the device is a software one, and where the world steps for it
# ---
# a:      application state
# engine: the args.ENGINE_* the session runs on
fun say_software(a: *app.App, engine: u8) {
    var how: str = "stepping on the CPU, --engine gpu steps on the GPU";
    if (engine == args.ENGINE_GPU)      { how = "stepping on the GPU as --engine gpu asked"; }
    or (engine == args.ENGINE_HASHLIFE) { how = "stepping on HashLife"; }
    print.eprintlnf("no hardware GPU was found, so drawing on {} will be slow; {}", ?a.device.name[0], how);
    app.say_why(a, "no hardware GPU was found", "drawing will be slow");
    app.say_also(a, how);
}

# stop the run that asked for HashLife on the command line when it could not
# have it, saying why
fun refuse_tree(ctx: *Context, g: *Game) {
    var rb: [rule.DISPLAY_MAX + 1]u8;
    if (rule.caps(?g.sim.rule).no_tree != nil) {
        print.eprintlnf("cellar: --engine hashlife: HashLife cannot run {}; it runs radius 1 rules without B0 on the unbounded plane", rule.display(?g.sim.rule, ?rb[0]));
    }
    or { print.eprintln("cellar: --engine hashlife: HashLife could not take the world"); }
    context_fail(ctx, 1);
}

# seed the world a session starts with, and queue what its first frame applies
#
# a file named on the command line is opened onto an empty world with the
# first frame, like any other load; with none the world starts random. a
# documentation capture shows the world a few generations in. HashLife, when
# named, is moved onto before the file when it runs the rule the world has, so
# a file built as nodes (Macrocell) opens straight into the tree, and again
# after it, since the file may bring a rule, so the file opens and runs as it
# would without it.
# ---
# a:       application state, attached
# s:       the simulation
# open:    the file to open, or nil
# capture: the session is a capture
# engine:  the args.ENGINE_* named
# ret:     whether the first frame moves the world onto HashLife
pub fun start_world(a: *app.App, s: *sim.Sim, open: str, capture: bool, engine: u8) bool {
    val tree: bool = engine == args.ENGINE_HASHLIFE;
    if (open != nil) {
        val f: opt[command.File] = app.file(a, open);
        if (sel f.some && tree && rule.caps(?s.rule).no_tree == nil) { app.submit(a, command.Command.engine{true}); }
        if (sel f.some)                                              { app.submit(a, command.Command.open{f.some}); }
    }
    or           { world.randomize(s, app.bounds_size(a.bounds_idx)); }
    if (capture) { world.toggle(s); }
    if (!tree)   { ret false; }
    app.submit(a, command.Command.engine{true});
    ret true;
}

# flip between windowed and borderless fullscreen on the current monitor
fun toggle_fullscreen(ctx: *Context) {
    var mode: win.WindowMode = win.WindowMode.borderless{};
    if (!sel ctx.window.mode.windowed) { mode = win.WindowMode.windowed{}; }
    val set: err[win.WindowError] = win.window_set_mode(?ctx.window, mode);
    if (sel set.err) {
        print.eprintlnf("fullscreen refused: {}", win.window_error_message(set.err));
    }
}

# the keys, one edge each
fun keys(ctx: *Context, g: *Game) {
    val in: *inp.Input = ?ctx.input;
    val a:  *app.App   = ?g.app;
    if (inp.key_pressed(in, inp.KEY_ESCAPE)) {
        if (a.help != 0) { a.help = 0; }
        or (a.sizing)    { bounds.cancel(a); }
        or (a.selected)  { app.deselect(a); }
        or               { context_stop(ctx); }
        ret;
    }
    # a chord with ctrl acts on the selection, and never also as the bare key
    val ctrl:  bool = inp.key_down(in, inp.KEY_LEFT_CTRL) || inp.key_down(in, inp.KEY_RIGHT_CTRL);
    val shift: bool = inp.key_down(in, inp.KEY_LEFT_SHIFT) || inp.key_down(in, inp.KEY_RIGHT_SHIFT);
    val del:   bool = inp.key_pressed(in, inp.KEY_DELETE);
    val z:     bool = inp.key_pressed(in, inp.KEY_Z);
    val redo:  bool = ctrl && ((z && shift) || inp.key_pressed(in, inp.KEY_Y));
    if (inp.key_pressed(in, inp.KEY_SPACE))                                { app.submit(a, command.Command.toggle{}); }
    if (inp.key_pressed(in, inp.KEY_S))                                    { app.submit(a, command.Command.step{}); }
    if (inp.key_pressed(in, inp.KEY_BACKSPACE))                            { app.submit(a, command.Command.reset{}); }
    if (inp.key_pressed(in, inp.KEY_C) && !ctrl)                           { app.submit(a, command.Command.clear{}); }
    if (inp.key_pressed(in, inp.KEY_R) && !ctrl)                           { app.submit(a, command.Command.randomize{app.bounds_size(a.bounds_idx)}); }
    if (inp.key_pressed(in, inp.KEY_M))                                    { a.mode = (a.mode + 1) % app.MODE_COUNT; }
    if (inp.key_pressed(in, inp.KEY_G))                                    { a.gutter = 1 - a.gutter; }
    if (inp.key_pressed(in, inp.KEY_F))                                    { app.frame_area(a); }
    if (inp.key_pressed(in, inp.KEY_D))                                    { a.tool = app.TOOL_DRAW; }
    if (inp.key_pressed(in, inp.KEY_E))                                    { a.tool = app.TOOL_ERASE; }
    if (inp.key_pressed(in, inp.KEY_T))                                    { a.tool = app.TOOL_STAMP; }
    if (inp.key_pressed(in, inp.KEY_Q))                                    { app.step_ink(a, rule.states(?g.shown.rule), shift); }
    if (inp.key_pressed(in, inp.KEY_V) && !ctrl)                           { a.tool = app.TOOL_SELECT; }
    if (inp.key_pressed(in, inp.KEY_W))                                    { a.tool = app.TOOL_BOUNDS; }
    if (inp.key_pressed(in, inp.KEY_V) && ctrl)                            { paste(ctx, a, shift); }
    if (z && !ctrl)                                                        { a.orient = pattern.orient_turn(a.orient); }
    if (z && ctrl && !shift)                                               { app.submit(a, command.Command.undo{}); }
    if (redo)                                                              { app.submit(a, command.Command.redo{}); }
    if (inp.key_pressed(in, inp.KEY_X) && !ctrl)                           { a.orient = pattern.orient_flip(a.orient); }
    if (inp.key_pressed(in, inp.KEY_C) && ctrl)                            { app.area(a, command.AREA_COPY); }
    if (inp.key_pressed(in, inp.KEY_X) && ctrl)                            { app.area(a, command.AREA_CUT); }
    if (inp.key_pressed(in, inp.KEY_R) && ctrl)                            { app.area(a, command.AREA_FILL); }
    if (del && !shift)                                                     { app.area(a, command.AREA_CLEAR); }
    if (del && shift)                                                      { app.area(a, command.AREA_CLEAR_OUTSIDE); }
    if (inp.key_pressed(in, inp.KEY_I))                                    { app.area(a, command.AREA_INVERT); }
    if (inp.key_pressed(in, inp.KEY_B))                                    { app.area(a, command.AREA_SHRINK); }
    if (inp.key_pressed(in, inp.KEY_H) || inp.key_pressed(in, inp.KEY_F1)) { a.help = 1 - a.help; }
    if (inp.key_pressed(in, inp.KEY_PAGE_UP))                              { zoom_step(a, true); }
    if (inp.key_pressed(in, inp.KEY_PAGE_DOWN))                            { zoom_step(a, false); }
    if (inp.key_pressed(in, inp.KEY_TAB))                                  { a.panel = 1 - a.panel; }
    if (inp.key_pressed(in, inp.KEY_F11))                                  { toggle_fullscreen(ctx); }
    if (inp.key_pressed(in, inp.KEY_F12))                                  { a.shot = true; }
}

# read the clipboard, on the main thread where the window lives, and ask to
# paste it as the stamp, taking its rule with shift
fun paste(ctx: *Context, a: *app.App, rule: bool) {
    val got: res[str, allo.Error] = win.window_clipboard_get(a.alloc, ?ctx.window);
    if (sel got.err) {
        app.say(a, "out of memory");
        ret;
    }
    app.paste(a, got.ok, rule);
}

# hand the window's queued events, typed text among them, to the interface in
# order, and open a file dropped on the window. a drop's paths live until the
# next poll, so the command takes its own copy here
fun events(q: *EventQueue, h: *gui.Gui, a: *app.App) {
    for {
        val e: opt[Event] = queue_pop(q);
        if (sel e.none)      { brk; }
        if (sel e.some.drop) { app.drop(a, e.some.drop.paths, e.some.drop.count); }
        or                   { gui.fold(h, e.some); }
    }
}

# read the keyboard and pan
fun tick(ctx: *Context) {
    val g:  *Game      = game_of(ctx);
    val in: *inp.Input = ?ctx.input;
    val a:  *app.App   = ?g.app;

    # while a field has the keyboard the key bindings stay quiet, including on
    # the tick whose enter or escape gives it back
    val typing: bool = gui.typing(?g.gui);
    if (!typing)  { keys(ctx, g); }
    if (g.gpu_ok) { gpu.display(?g.gpu, win.window_refresh_hz(?ctx.window)); }

    # the pan is the view centre in cells, moved by pixels at the current zoom
    val ppc:  f32 = render.BASE_PPC * a.zoom;
    val step: f32 = PAN_STEP * app.scale(a.scale_idx) / ppc;
    if (!typing) {
        if (inp.key_down(in, inp.KEY_LEFT))  { a.pan_x = a.pan_x - step::f64; }
        if (inp.key_down(in, inp.KEY_RIGHT)) { a.pan_x = a.pan_x + step::f64; }
        if (inp.key_down(in, inp.KEY_UP))    { a.pan_y = a.pan_y - step::f64; }
        if (inp.key_down(in, inp.KEY_DOWN))  { a.pan_y = a.pan_y + step::f64; }
    }
    # the tick's movement only, so the press that starts a drag never jumps
    if (inp.button_down(in, inp.BUTTON_RIGHT) || inp.button_down(in, inp.BUTTON_MIDDLE)) {
        a.pan_x = a.pan_x - in.mouse_dx / ppc::f64;
        a.pan_y = a.pan_y - in.mouse_dy / ppc::f64;
    }
}

# the camera the view is drawn and edited through
fun camera(a: *app.App, pt: render.Port) render.Camera {
    ret render.camera(a.zoom, a.pan_x, a.pan_y, pt);
}

# zoom by scroll notches, keeping the world point under (mx, my) where it is
fun zoom_at(a: *app.App, pt: render.Port, mx: f32, my: f32, notches: f32) {
    var bx: f64 = 0.0;
    var by: f64 = 0.0;
    render.world_at(camera(a, pt), mx, my, ?bx, ?by);
    # by a factor a notch, so it is as quick far out as close in
    if (notches > 0.0) { a.zoom = a.zoom * (1.0 + notches * ZOOM_STEP); }
    if (notches < 0.0) { a.zoom = a.zoom / (1.0 - notches * ZOOM_STEP); }
    a.zoom = app.clamp_zoom(a, a.zoom);
    var ax: f64 = 0.0;
    var ay: f64 = 0.0;
    render.world_at(camera(a, pt), mx, my, ?ax, ?ay);
    a.pan_x = a.pan_x + bx - ax;
    a.pan_y = a.pan_y + by - ay;
}

# step the zoom to the next power of two of pixels per cell, up or down. the
# camera is centred on the pan, so the point under the view's centre stays put
fun zoom_step(a: *app.App, up: bool) {
    val ppc: f32 = render.pow2_step(render.BASE_PPC * a.zoom, up);
    a.zoom = app.clamp_zoom(a, ppc / render.BASE_PPC);
}

# centre the cells the app asks to frame, the randomize area or an opened
# pattern, and zoom until they just fit
fun frame(a: *app.App, pt: render.Port) {
    val b: space.Box = app.fit_box(a);
    var w: f32       = (b.x1 - b.x0)::f32;
    var h: f32       = (b.y1 - b.y0)::f32;
    if (w < 1.0) { w = 1.0; }
    if (h < 1.0) { h = 1.0; }
    var z: f32 = pt.w / w;
    if (pt.h / h < z) { z = pt.h / h; }
    a.zoom  = app.clamp_zoom(a, z * 0.9 / render.BASE_PPC);
    a.pan_x = (b.x0 + b.x1)::f64 / 2.0;
    a.pan_y = (b.y0 + b.y1)::f64 / 2.0;
}

# whether the held world runs uncapped
fun uncapped(g: *Game) bool {
    ret g.sim.running != 0 && g.app.uncapped != 0;
}

# read input; the world is not touched here
# ---
# ctx: the running context
pub fun on_tick(ctx: *Context) {
    tick(ctx);
}

# whether the pointer is over the world with nothing of the interface on top
fun over_world(g: *Game) bool {
    ret g.world.hot;
}

# apply the tool under the cursor when nothing of the interface is in the way;
# the world takes the pointer only where no interface claim is on top, and a
# press that began on a control stays the control's
fun edit_world(g: *Game, cam: render.Camera) {
    val h: *bint.Hit = ?g.world;
    val a: *app.App  = ?g.app;
    # a drag of the bounds goes on wherever the pointer goes until released
    if (a.tool == app.TOOL_BOUNDS || a.sizing) {
        var gr: topology.Grid = g.shown.rule.grid;
        bounds.tool(a, ?gr, cam, app.scale(a.scale_idx), h.mx, h.my, h.pressed && over_world(g), h.held);
        ret;
    }
    if (!over_world(g)) {
        a.stroke = false;
        ret;
    }
    var cx: i64 = 0;
    var cy: i64 = 0;
    render.cell_at(cam, h.mx, h.my, ?cx, ?cy);
    if (a.tool == app.TOOL_STAMP) {
        if (h.pressed) { arrange.stamp_active(a, cx, cy); }
        ret;
    }
    if (a.tool == app.TOOL_SELECT) {
        if (h.pressed) {
            a.dragging = true;
            a.anchor_x = cx;
            a.anchor_y = cy;
        }
        if (a.dragging && h.held) { app.select(a, a.anchor_x, a.anchor_y, cx, cy); }
        if (!h.held)              { a.dragging = false; }
        ret;
    }
    if (!h.held) {
        a.stroke = false;
        ret;
    }
    val v: u8 = app.pen(a);
    if (a.stroke) { app.submit(a, command.Command.line{command.Line{x0: a.last_x, y0: a.last_y, x1: cx, y1: cy, v: v}}); }
    or            { app.submit(a, command.Command.paint{command.Paint{x: cx, y: cy, v: v}}); }
    a.stroke = true;
    a.last_x = cx;
    a.last_y = cy;
}

# a bounded grid's edge as a thin line, and the space off it as the plain
# backdrop: off the grid is dead, on a frame drawn inverted too
fun grid_edge(g: *Game, d: *paint.Paint, cam: render.Camera) {
    var gr: topology.Grid = g.shown.rule.grid;
    if (!topology.bounded(?gr)) { ret; }
    # an unbounded axis runs past the port
    var x0: f32 = cam.x0 - 2.0;
    var x1: f32 = cam.x0 + cam.sw + 2.0;
    var y0: f32 = cam.y0 - 2.0;
    var y1: f32 = cam.y0 + cam.sh + 2.0;
    if (gr.w != 0) {
        x0 = render.screen_x(cam, topology.left(?gr)::f64);
        x1 = render.screen_x(cam, (topology.left(?gr) + gr.w)::f64);
    }
    if (gr.h != 0) {
        y0 = render.screen_y(cam, topology.top(?gr)::f64);
        y1 = render.screen_y(cam, (topology.top(?gr) + gr.h)::f64);
    }
    val l: f32 = cam.x0;
    val t: f32 = cam.y0;
    val r: f32 = cam.x0 + cam.sw;
    val b: f32 = cam.y0 + cam.sh;
    paint.rect(d, l, t, r, y0, theme.BG, 1.0);
    paint.rect(d, l, y1, r, b, theme.BG, 1.0);
    paint.rect(d, l, y0, x0, y1, theme.BG, 1.0);
    paint.rect(d, x1, y0, r, y1, theme.BG, 1.0);
    paint.frame(d, x0 - 1.0, y0 - 1.0, x1 + 1.0, y1 + 1.0, 1.0, theme.WORLD_EDGE, 1.0);
}

# outline the box the live cells span, just outside it so no cell is covered
fun outline(g: *Game, d: *paint.Paint, cam: render.Camera) {
    val b: opt[space.Box] = world.bounds(?g.shown);
    if (sel b.none) { ret; }
    val r: render.Span = render.span(cam, b.some);
    paint.frame(d, r.x0 - 1.0, r.y0 - 1.0, r.x1 + 1.0, r.y1 + 1.0, 1.0, theme.TEXT_DIM, 0.5);
}

# outline the cell under the cursor when it is big enough to point at
fun hover(g: *Game, d: *paint.Paint, cam: render.Camera) {
    val a: *app.App = ?g.app;
    if (!over_world(g) || cam.ppc < 4.0 || a.tool == app.TOOL_STAMP) { ret; }
    var cx: i64 = 0;
    var cy: i64 = 0;
    render.cell_at(cam, g.world.mx, g.world.my, ?cx, ?cy);
    val x0: f32 = render.screen_x(cam, cx::f64);
    val y0: f32 = render.screen_y(cam, cy::f64);
    paint.frame(d, x0, y0, x0 + cam.ppc, y0 + cam.ppc, 1.0, theme.HOVER_CELL, 0.6);
}

# show where a stamp would land, the pattern's cells over the world under the cursor
#
# only the cells on screen are drawn, a rectangle each while there are few of
# them and from the pattern's texture (cellar.sketch) otherwise
fun ghost(g: *Game, d: *paint.Paint, pt: render.Port, cam: render.Camera) {
    val a: *app.App = ?g.app;
    if (a.tool != app.TOOL_STAMP || !over_world(g)) { ret; }
    var cx: i64 = 0;
    var cy: i64 = 0;
    render.cell_at(cam, g.world.mx, g.world.my, ?cx, ?cy);
    val p:  *pattern.Pattern = arrange.active(a);
    val o:  u8               = a.orient;
    val pw: usize            = pattern.width(p, o);
    val ph: usize            = pattern.height(p, o);
    # the same corner pattern.stamp places it at
    val ox: i64 = pattern.corner(cx, pw);
    val oy: i64 = pattern.corner(cy, ph);
    val x0: f32 = render.screen_x(cam, ox::f64);
    val y0: f32 = render.screen_y(cam, oy::f64);
    val c:  f32 = cam.ppc;
    paint.frame(d, x0 - 1.0, y0 - 1.0, x0 + pw::f32 * c + 1.0, y0 + ph::f32 * c + 1.0, 1.0, theme.ACCENT, 0.5);
    val vx: Shown = shown(x0 - pt.x0, c, pw, pt.w);
    val vy: Shown = shown(y0 - pt.y0, c, ph, pt.h);
    if (vx.lo >= vx.hi || vy.lo >= vy.hi) { ret; }
    if (sketch.large(vx.hi - vx.lo, vy.hi - vy.lo)) {
        sketch.draw(d, ?g.sketches, ?g.sketches.ghost, p, o, x0, y0, c, theme.ACCENT, 0.55);
        ret;
    }
    var y: usize = vy.lo;
    for (y < vy.hi) {
        var x: usize = vx.lo;
        for (x < vx.hi) {
            if (pattern.get_oriented(p, o, x, y) != 0) {
                val qx: f32 = x0 + x::f32 * c;
                val qy: f32 = y0 + y::f32 * c;
                paint.rect(d, qx, qy, qx + c, qy + c, theme.ACCENT, 0.55);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

# the cells of a row or column on screen, [lo, hi)
rec Shown {
    lo: usize;
    hi: usize;
}

# which of n cells from screen position p0, c pixels each, fall within [0, end)
fun shown(p0: f32, c: f32, n: usize, end: f32) Shown {
    var s: Shown = Shown{lo: 0, hi: n};
    if (p0 < 0.0) {
        val first: f32 = -p0 / c;
        if (first >= n::f32) { s.lo = n; }
        or                   { s.lo = first::usize; }
    }
    val last: f32 = (end - p0) / c;
    if (last <= 0.0)         { s.hi = 0; }
    or (last + 1.0 < n::f32) { s.hi = last::usize + 1; }
    ret s;
}

# build the frame and submit it through one overlay pass
# ---
# ctx: the running context
pub fun on_draw(ctx: *Context) {
    val g: *Game = game_of(ctx);
    if (!g.renderer_ok || !g.gpu_ok || !g.gui_ok) { ret; }
    # the window's events reach the interface and open dropped files even on a
    # frame that draws nothing
    gui.open(?g.gui, ctx);
    events(?ctx.events, ?g.gui, ?g.app);

    val br: res[bool, gfx.Error] = gfx.renderer_begin_frame(?g.renderer);
    if (sel br.err) {
        print.eprintlnf("could not begin a frame: {}", gfx.error_message(br.err));
        context_fail(ctx, 1);
        ret;
    }
    if (!br.ok) { ret; }

    # the overlay pass and the cursor are both in framebuffer pixels
    val sw: f32      = gfx.renderer_width(?g.renderer)::f32;
    val sh: f32      = gfx.renderer_height(?g.renderer)::f32;
    val a:  *app.App = ?g.app;

    # the frame holds the world only when the thread is not stepping it, or
    # between steps when commands wait, and releases it before drawing
    runner.pace(?g.runner, a.uncapped != 0, a.speed::f64);
    # a colour mode that reads heat or age has the pool hold the view layer
    # they lie in, and one that does not lets it go (sim.set_views)
    val views: bool = a.mode != render.MODE_SOLID::usize;
    val held:  bool = runner.take(?g.runner, a.queue.items.len != 0 || g.want_tree || world.views(?g.shown) != views);
    if (held) {
        # the world's edits and file actions run first: a save reads the GPU's
        # cells back, which is only valid before the frame records anything
        var deps: exec.Deps = exec.Deps{a: ?g.a};
        exec.run(a, ?g.sim, ?deps);
        # a file just opened may have set the mode
        val want: bool = a.mode != render.MODE_SOLID::usize;
        if (!sim.set_views(?g.sim, want)) {
            # the pool keeps its layers, and the colour mode follows them
            if (want) { a.mode = render.MODE_SOLID::usize; }
            or        { a.mode = render.MODE_HEAT::usize; }
            app.say(a, "the pool could not change its layers for the colour mode");
        }
        if (g.want_tree) {
            g.want_tree = false;
            if (!sim.on_tree(?g.sim) && g.saved_tree) {
                app.say(a, "HashLife could not take the world; using the chunk engine");
            }
            or (!sim.on_tree(?g.sim)) {
                runner.give(?g.runner);
                refuse_tree(ctx, g);
                ret;
            }
        }
        # take the census before this frame's own readback can reuse its slot
        sim.collect(?g.sim);
        world.observe(?g.sim, ?g.shown);
    }
    app.fit_engine(a, world.hashlife(?g.shown));
    if (a.clip_ready) {
        win.window_clipboard_set(?ctx.window, a.clip.data::str);
        a.clip_ready = false;
    }
    app.identify_poll(a);
    app.note_full(a, world.full(?g.shown), world.full_reason(?g.shown));
    app.note_withheld(a, world.withheld(?g.shown));
    val sc: f32 = app.scale(a.scale_idx);

    # the interface's frame comes first, since its toolbar and docks say where
    # the world shows: the world claims its port beneath everything else, so
    # the pointer reaches it only where no control is on top. a capture has no
    # user, so any pointer over its window is not one
    val pointer: bool          = ctx.input.pointer_in && g.capture == nil;
    val bu:      *bctx.Context = ?g.gui.ui;
    gui.begin(?g.gui, sw, sh, sc, pointer);
    var scene: panel.Scene = panel.Scene{l: g.gui.look, a: a, s: ?g.shown, p: ?g.paths, sk: ?g.sketches};
    var pt:    render.Port = render.Port{x0: 0.0, y0: 0.0, w: sw, h: sh};
    if (g.bench == args.BENCH_NONE) { pt = desk.draw(bu, ?scene); }
    if (a.refit) {
        frame(a, pt);
        a.refit = false;
    }
    val seen: render.Camera = camera(a, pt);
    g.world = bint.hit(bu, bctx.id_of(bu, "world"), pt.x0, pt.y0, pt.x0 + pt.w, pt.y0 + pt.h, binp.BUTTON_LEFT);
    hud.selection_size(bu, g.gui.look, a, seen, pt);
    bounds.label(bu, g.gui.look, a, seen, pt);
    if (g.bench == args.BENCH_NONE) {
        hud.readout(bu, g.gui.look, a, ?g.shown, pt);
        val stepped: i32 = hud.position(bu, g.gui.look, seen, pt, over_world(g), g.world.mx, g.world.my);
        if (stepped != 0) { zoom_step(a, stepped > 0); }
        hud.toast(bu, ?g.msgs, a, pt);
        hud.pool_offer(bu, g.gui.look, a, ?g.shown, pt);
        hud.help(bu, a, sw, sh);
        val notches: f32 = gui.notches(?g.gui);
        if (notches != 0.0 && over_world(g)) { zoom_at(a, pt, g.world.mx, g.world.my, notches); }
        edit_world(g, seen);
    }
    gui.end(?g.gui, ctx);
    val cam: render.Camera = camera(a, pt);

    # record the frame's generations and the view, or show the last completed
    # generation while the thread steps the next; edits made after this wait
    # in the queue for a frame that holds the world
    var look: gpu.Look       = render.look(cam, sw, sh, a.mode::u8, a.gutter, a.solid, g.srgb);
    var rec:  err[gfx.Error] = err[gfx.Error].ok{};
    if (held) {
        # the capped generations the thread owes the GPU, while it runs
        val due: u64 = runner.owed(?g.runner);
        var i:   u64 = 0;
        for (i < due && g.sim.running != 0) {
            world.step(?g.sim);
            i = i + 1;
        }
        sim.aim_pyramids(?g.sim, ?look);
        rec = sim.record(?g.sim, uncapped(g), ?look);
        world.observe(?g.sim, ?g.shown);
        runner.give(?g.runner);
    }
    or (runner.view(?g.runner, look)) {
        rec = sim.show(?g.sim, ?look);
        runner.seen(?g.runner, ?g.shown);
        runner.unview(?g.runner);
    }
    or {
        # a step is writing the view: the camera moves over the cells already sent
        if (world.hashlife(?g.shown)) { sim.tree_look(?look, g.shown.shift); }
        rec = gpu.aim(?g.gpu, ?look);
    }
    if (sel rec.err) {
        print.eprintlnf("could not record the world: {}", gfx.error_message(rec.err));
        context_fail(ctx, 1);
        ret;
    }
    if (g.bench != args.BENCH_NONE) { bench_frame(ctx, g); }

    var desc: gfx.PassDesc = gfx.pass_overlay();
    # a world held as its complement is drawn inverted, beyond its chunks too
    var clear: *f32 = ?look.back[0];
    if (g.shown.flipped) { clear = ?look.solid[0]; }
    desc.clear = opt[gm.Vec4].some{gm.vec4(clear[0], clear[1], clear[2], 1.0)};
    var pass: gfx.Pass = gfx.pass_begin(?g.renderer, ?desc);
    gpu.draw(?g.gpu, ?pass);

    # the world's overlays, then the interface over everything
    var d: paint.Paint = paint.Paint{pass: ?pass, srgb: g.srgb};
    grid_edge(g, ?d, cam);
    outline(g, ?d, cam);
    hud.selection(?d, a, cam, sc);
    bounds.overlay(?d, a, cam);
    hover(g, ?d, cam);
    ghost(g, ?d, pt, cam);
    val drew: err[gfx.Error] = gui.draw(?g.gui, ?pass);
    if (sel drew.err) { print.eprintlnf("could not draw the interface: {}", gfx.error_message(drew.err)); }

    gfx.pass_end(?pass);
    val take: bool = want_shot(g);
    if (take) {
        val armed: err[shot.Error] = shot.arm(?g.a, ?g.renderer, ?g.snap);
        if (sel armed.err) { app.say(a, "this window cannot be read back"); }
    }
    val ended: err[gfx.Error] = gfx.renderer_end_frame(?g.renderer);
    if (sel ended.err) {
        print.eprintlnf("could not present a frame: {}", gfx.error_message(ended.err));
        context_fail(ctx, 1);
        ret;
    }
    if (take) { save_shot(ctx, g); }
}

# whether this frame is the one to screenshot
fun want_shot(g: *Game) bool {
    if (g.capture != nil) {
        g.countdown = g.countdown - 1;
        ret g.countdown == 0;
    }
    if (!g.app.shot) { ret false; }
    g.app.shot = false;
    if (!g.paths.ok) {
        app.say(?g.app, "no user data directory to save into");
        ret false;
    }
    ret true;
}

# write the frame just read back, and quit when it was the capture asked for
fun save_shot(ctx: *Context, g: *Game) {
    var name: [1200]u8;
    var path: str = g.capture;
    if (path == nil) { path = shot.name(paths.dir(?g.paths), ?name[0]); }
    val wrote: err[shot.Error] = shot.write(?g.a, ?g.snap, path);
    if (g.capture != nil) {
        if (sel wrote.err) { give_up(ctx, "could not save the capture"); }
        or                 { context_stop(ctx); }
        ret;
    }
    if (sel wrote.err) { app.say(?g.app, "screenshot not saved"); }
    or                 { app.say(?g.app, "screenshot saved"); }
}

# screenshot the given frame to path and quit, for documentation
# ---
# g:      the game, before the run starts
# path:   where the PNG goes
# frames: frames to draw first
pub fun capture_after(g: *Game, path: str, frames: i32) {
    g.capture   = path;
    g.countdown = frames;
}

# save the settings and release everything on_init built, renderer last
# ---
# ctx: the running context
pub fun on_dnit(ctx: *Context) {
    val g: *Game = game_of(ctx);
    runner.stop(?g.runner);
    if (g.sim_ok && g.paths.ok && g.bench == args.BENCH_NONE && g.capture == nil) {
        if (g.gui_ok) { panel.keep(?g.gui.ui, ?g.app); }
        var sp:    [1088]u8;
        val saved: err[persist.Error] = config.save(?g.a, ?g.app, ?g.sim, settings(g, ?sp[0]));
        if (sel saved.err) {
            print.eprintlnf("settings not saved: {}", persist.error_message(saved.err));
        }
    }
    if (g.renderer_ok) {
        gfx.renderer_wait_idle(?g.renderer);
        if (g.gpu_ok) { gpu.dnit(?g.gpu); }
        sketch.dnit(?g.sketches);
        if (g.gui_ok) {
            val freed: err[allo.Error] = hud.messages_dnit(?g.msgs);
            if (sel freed.err) { print.eprintln("the messages' text was not released"); }
            gui.dnit(?g.gui);
        }
        val down: err[gfx.Error] = gfx.renderer_dnit(?g.renderer);
        if (sel down.err) {
            print.eprintlnf("renderer refused to shut down: {}", gfx.error_message(down.err));
            context_fail(ctx, 1);
        }
    }
    if (g.sim_ok) { sim.dnit(?g.sim); }
    app.dnit(?g.app);
}

# seed the measured world and frame it, running uncapped or at the speed asked
#
# a wider radius keeps Life's weights, so the world evolves as Life does while
# each generation spreads by the wider radius, except in the footprint world,
# whose kernel weighs its whole square so the step stage reads all of it
fun bench_world(g: *Game) {
    val s: *sim.Sim = ?g.sim;
    if (g.bench == args.BENCH_FOOTPRINT) {
        sim.set_rule(s, rule.make[weighted.Kernel](?weighted.FAMILY, weighted.vote(g.bench_r)));
    }
    or (rule.is(?s.rule, ?weighted.FAMILY)) {
        var k: weighted.Kernel = @rule.view[weighted.Kernel](?s.rule, ?weighted.FAMILY);
        weighted.set_radius(?k, g.bench_r);
        sim.set_rule(s, rule.make[weighted.Kernel](?weighted.FAMILY, k));
    }
    if (g.bench == args.BENCH_PAUSE) {
        val seeds: res[rule.Rule, str] = rule.parse("B2/S");
        if (sel seeds.ok) { sim.set_rule(s, seeds.ok); }
        sim.randomize(s, sim.DEFAULT_DENSITY, 512);
        if (g.engine == args.ENGINE_HASHLIFE) { sim.use_hashlife(s, true); }
        g.app.zoom = 900.0 / 512.0 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_FOOTPRINT) {
        sim.randomize(s, 1.0, FOOTPRINT_SIDE);
        g.app.zoom = 900.0 / FOOTPRINT_SIDE::f32 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_DENSE) {
        sim.randomize(s, sim.DEFAULT_DENSITY, 512);
        g.app.zoom = 900.0 / 512.0 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_GUN) {
        sim.seed_gun(s);
        g.app.zoom = 900.0 / 512.0 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_TORUS) {
        bench_grid(s, "T512,512");
        sim.randomize(s, sim.DEFAULT_DENSITY, 512);
        g.app.zoom = 900.0 / 512.0 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_PLANE) {
        bench_grid(s, "P1024,512");
        sim.seed_gun(s);
        g.app.zoom = 900.0 / 1024.0 / render.BASE_PPC;
    }
    or (g.bench == args.BENCH_BOX) {
        bench_grid(s, "T8192,8192");
        sim.seed_glider_at(s, -1, -1);
        g.app.zoom = 900.0 / 512.0 / render.BASE_PPC;
    }
    or {
        sim.fill_begin(s);
        var k: i64 = 0;
        for (k < 400) {
            val ox: i64 = (k % 20 - 10) * 1024;
            val oy: i64 = (k / 20 - 10) * 1024;
            var y:  i64 = 0;
            for (y < 48) {
                var x: i64 = 0;
                for (x < 48) {
                    if (rand.range(?s.rng, 0, 1000) < 300) { sim.fill_cell(s, ox + x, oy + y, 1); }
                    x = x + 1;
                }
                y = y + 1;
            }
            k = k + 1;
        }
        sim.fill_end(s);
        g.app.zoom = 900.0 / 20480.0 / render.BASE_PPC;
    }
    g.app.uncapped = 1;
    if (g.bench_gps != 0) {
        g.app.uncapped = 0;
        g.app.speed    = g.bench_gps::f32;
    }
    g.app.panel = 0;
    g.app.refit = false;
    # the pauses are timed on a run played as a person plays it, so the
    # journal holds the world from where the run began, not from the first pause
    if (g.bench == args.BENCH_PAUSE) { app.submit(?g.app, command.Command.toggle{}); }
    or                               { s.running = 1; }
    g.frames    = 0;
    g.gen0      = 0;
    g.gen_seen  = 0;
    g.cell_gens = 0.0;
    g.pausing   = false;
    g.pauses    = 0;
    g.worst     = 0;
}

# put the measured world's rule on the grid a suffix names
fun bench_grid(s: *sim.Sim, suffix: str) {
    val g: res[topology.Grid, str] = topology.parse(suffix);
    if (sel g.err) { ret; }
    var r: rule.Rule = s.rule;
    r.grid = g.ok;
    sim.set_rule(s, r);
}

# count a measured frame, and report and stop once the time is up
fun bench_frame(ctx: *Context, g: *Game) {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret; }
    # the first frames seed the GPU and grow the pool, which is not the rate
    g.frames = g.frames + 1;
    if (g.frames <= WARMUP) { ret; }
    if (g.frames == WARMUP + 1) {
        g.started  = now.ok;
        g.gen0     = g.shown.generation;
        g.gen_seen = g.gen0;
    }
    if (g.bench == args.BENCH_PAUSE) {
        bench_pause(ctx, g, now.ok);
        ret;
    }
    # the generations a frame completed are counted at the pool it shows after them
    val done: u64 = g.shown.generation - g.gen_seen;
    g.cell_gens = g.cell_gens + done::f64 * g.shown.chunks::f64 * space.CELLS::f64;
    g.gen_seen  = g.shown.generation;
    val secs: f64 = time.instant_sub(now.ok, g.started)::f64 / SECOND::f64;
    if (secs < g.bench_secs) { ret; }
    val gens: f64 = (g.shown.generation - g.gen0)::f64;
    # the clock started with the first measured frame, so the frames after it span the seconds
    var spans: u64 = g.frames - WARMUP - 1;
    if (spans == 0) { spans = 1; }
    val frame: f64 = secs * 1000000.0 / spans::f64;
    var step:  f64 = 0.0;
    if (gens > 0.0) { step = secs * 1000000.0 / gens; }
    var engine: str = "gpu";
    if (!g.gpu.stepping)          { engine = "cpu"; }
    if (world.hashlife(?g.shown)) { engine = "hashlife"; }
    # the pool's memory a cell, its layers' widths in the cells stepped from
    # and into
    val bits: u64 = world.cell_bits(?g.shown);
    print.printlnf("bench {} radius {} chunks {} population {} gens/s {} step us {} cells/s {} frame us {} bits/cell {} pool bytes {}", engine,
        rule.radius(?g.shown.rule)::u64, g.shown.chunks::u64, g.shown.population::u64, (gens / secs)::u64, step::u64,
        (g.cell_gens / secs)::u64, frame::u64, bits, g.shown.pool.taken);
    context_stop(ctx);
}

# pause the run once it has run the measurement's seconds, time how long the
# pause takes to reach the world, and resume it, until PAUSES are timed or the
# world stops on its own, full or at a ceiling
fun bench_pause(ctx: *Context, g: *Game, now: Instant) {
    var engine: str = "gpu";
    if (!g.gpu.stepping)          { engine = "cpu"; }
    if (world.hashlife(?g.shown)) { engine = "hashlife"; }
    # a pause or a resume asked for waits in the queue until a frame applies it
    if (g.app.queue.items.len != 0) { ret; }
    if (g.pausing) {
        if (g.shown.running) { ret; }
        val took: i64 = time.instant_sub(now, g.started);
        if (took > g.worst) { g.worst = took; }
        g.pauses  = g.pauses + 1;
        g.pausing = false;
        val gens: u64 = g.shown.generation - g.gen0;
        print.printlnf("pause {} {} generation {} chunks {} population {} gens since resume {} pause ms {}", engine, g.pauses,
            g.shown.generation, g.shown.chunks::u64, g.shown.population::u64, gens, took::f64 / 1000000.0);
        if (g.pauses == PAUSES) {
            print.printlnf("pause {} worst ms {}", engine, g.worst::f64 / 1000000.0);
            context_stop(ctx);
            ret;
        }
        app.submit(?g.app, command.Command.toggle{});
        g.started = now;
        g.gen0    = g.shown.generation;
        ret;
    }
    if (!g.shown.running) {
        print.printlnf("pause {} stopped on its own at generation {}: full {} ceiling {}; worst ms {}", engine, g.shown.generation,
            g.shown.full, sim.tripped(?g.sim)::u64, g.worst::f64 / 1000000.0);
        context_stop(ctx);
        ret;
    }
    if (time.instant_sub(now, g.started)::f64 / SECOND::f64 < g.bench_secs) { ret; }
    app.submit(?g.app, command.Command.toggle{});
    g.pausing = true;
    g.started = now;
}

test events__open_the_first_dropped_file_and_say_the_rest_were_ignored {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 1; }
    val dir: err[fs.FsError] = persist.make_parent(?a, "out/test/drop/x");
    if (sel dir.err) { ret 1; }
    val rle: str = "x = 3, y = 1, rule = B3/S23\n3o!\n";
    fs.write_bytes("out/test/drop/row.rle", rle, string.str_len(rle), persist.FILE_MODE);

    # the drop as the platform delivers it, two files in one event
    var q:     EventQueue = queue_new();
    var names: [2]*u8;
    names[0] = "out/test/drop/row.rle"::*u8;
    names[1] = "out/test/drop/other.rle"::*u8;
    val got: res[DropEvent, allo.Error] = drop_new(2, ?names[0]);
    if (sel got.err) { ret 1; }
    val pushed: err[QueueError] = queue_push(?q, Event.drop{got.ok});
    if (sel pushed.err) { ret 1; }
    var h: gui.Gui;
    events(?q, ?h, ?ap);
    queue_clear(?q);
    if (ap.queue.items.len != 1) { ret 2; }

    var d: exec.Deps = exec.Deps{a: ?a};
    exec.run(?ap, ?s, ?d);
    if (sim.population(?s) != 3 || !sim.alive(?s, -1, 0) || !sim.alive(?s, 1, 0)) { ret 3; }
    val fit: space.Box = app.fit_box(?ap);
    if (!ap.refit || fit.x0 != -1 || fit.x1 != 2)                                              { ret 4; }
    if (!string.str_equals(ap.toast, "row.rle: opened; the other dropped files were ignored")) { ret 5; }

    fs.remove_file("out/test/drop/row.rle");
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

test start_world__a_file_opens_onto_an_empty_world_running_on_either_engine {
    var al: allo.Allocator;
    page.make(?al);
    val body: str             = "x = 3, y = 1, rule = B3/S23\n3o!\n";
    val dir:  err[fs.FsError] = persist.make_parent(?al, "out/test/start_world/row.rle");
    if (sel dir.err) { ret 1; }
    fs.write_bytes("out/test/start_world/row.rle", body, string.str_len(body), persist.FILE_MODE);
    var e: u8 = args.ENGINE_ANY;
    for (e <= args.ENGINE_HASHLIFE) {
        var s:    sim.Sim;
        val made: err[allo.Error] = sim.init(?s, ?al);
        if (sel made.err) { ret 2; }
        var a: app.App;
        app.init(?a);
        val shown: err[format.Error] = app.attach(?a, ?al);
        if (sel shown.err) { ret 3; }
        # a randomize area that would fill four thousand cells a side
        a.bounds_idx = app.BOUNDS_COUNT - 1;
        val tree: bool      = start_world(?a, ?s, "out/test/start_world/row.rle", true, e);
        var d:    exec.Deps = exec.Deps{a: ?al};
        exec.run(?a, ?s, ?d);
        if (tree != (e == args.ENGINE_HASHLIFE) || sim.on_tree(?s) != tree) { ret 4; }
        if (sim.population(?s) != 3 || s.generation != 0 || s.running == 0) { ret 5; }
        if (!sim.alive(?s, -1, 0) || !sim.alive(?s, 1, 0))                  { ret 6; }
        app.dnit(?a);
        sim.dnit(?s);
        e = e + args.ENGINE_HASHLIFE;
    }
    fs.remove_file("out/test/start_world/row.rle");
    ret 0;
}

test start_world__a_macrocell_past_the_pool_opens_straight_into_hashlife_and_undo_takes_it_back {
    var al: allo.Allocator;
    page.make(?al);
    # 65536 blocks, each in a chunk of its own, where the pool holds 32768 chunks
    val body: str             = "[M2]\n#R B3/S23\n**$**$\n4 1 0 0 0\n5 2 0 0 0\n6 3 0 0 0\n7 4 0 0 0\n8 5 5 5 5\n9 6 6 6 6\n10 7 7 7 7\n11 8 8 8 8\n12 9 9 9 9\n13 10 10 10 10\n14 11 11 11 11\n15 12 12 12 12\n";
    val dir:  err[fs.FsError] = persist.make_parent(?al, "out/test/start_tree/blocks.mc");
    if (sel dir.err) { ret 1; }
    fs.write_bytes("out/test/start_tree/blocks.mc", body, string.str_len(body), persist.FILE_MODE);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?al);
    if (sel made.err) { ret 2; }
    var a: app.App;
    app.init(?a);
    val shown: err[format.Error] = app.attach(?a, ?al);
    if (sel shown.err) { ret 3; }
    world.paint(?s, 3, 3, 1);
    val tree: bool      = start_world(?a, ?s, "out/test/start_tree/blocks.mc", false, args.ENGINE_HASHLIFE);
    var d:    exec.Deps = exec.Deps{a: ?al};
    exec.run(?a, ?s, ?d);
    if (!tree || !sim.on_tree(?s))              { ret 4; }
    if (sim.population(?s) != 262145 || s.full) { ret 5; }
    if (!sim.alive(?s, 3, 3))                   { ret 6; }

    # the load is one step, and the cell painted before it is all undo leaves
    app.submit(?a, command.Command.undo{});
    exec.run(?a, ?s, ?d);
    if (sim.population(?s) != 1 || !sim.alive(?s, 3, 3) || !sim.on_tree(?s)) { ret 7; }
    app.submit(?a, command.Command.redo{});
    exec.run(?a, ?s, ?d);
    if (sim.population(?s) != 262145) { ret 8; }
    app.dnit(?a);
    sim.dnit(?s);
    fs.remove_file("out/test/start_tree/blocks.mc");
    ret 0;
}

test pick_engine__the_command_line_overrides_the_saved_engine_and_a_rule_hashlife_cannot_run_falls_back {
    var al: allo.Allocator;
    page.make(?al);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?al);
    if (sel made.err) { ret 1; }
    var a: app.App;
    app.init(?a);

    # nothing saved runs the default, cpu the CPU, and a named engine wins
    if (pick_engine(?a, ?s, args.ENGINE_ANY, false) != args.ENGINE_ANY) { ret 2; }
    # a software device steps the default on the CPU unless the GPU is named
    if (pick_engine(?a, ?s, args.ENGINE_ANY, true) != args.ENGINE_CPU) { ret 12; }
    if (pick_engine(?a, ?s, args.ENGINE_GPU, true) != args.ENGINE_GPU) { ret 13; }
    a.engine_cpu = true;
    if (pick_engine(?a, ?s, args.ENGINE_ANY, false) != args.ENGINE_CPU) { ret 3; }
    a.engine_tree = true;
    if (pick_engine(?a, ?s, args.ENGINE_GPU, false) != args.ENGINE_GPU)      { ret 4; }
    if (pick_engine(?a, ?s, args.ENGINE_ANY, false) != args.ENGINE_HASHLIFE) { ret 5; }
    if (pick_engine(?a, ?s, args.ENGINE_ANY, true) != args.ENGINE_HASHLIFE)  { ret 14; }
    if (a.told != 0)                                                         { ret 6; }
    # the command line's choice is not the saved one
    if (!a.engine_tree || !a.engine_cpu) { ret 7; }

    # a rule HashLife cannot run runs on the pool, saying so
    val b0: res[rule.Rule, str] = rule.parse("B0/S");
    if (sel b0.err) { ret 11; }
    sim.set_rule(?s, b0.ok);
    if (rule.caps(?s.rule).no_tree == nil) { ret 8; }
    val told: u32 = a.told;
    if (pick_engine(?a, ?s, args.ENGINE_ANY, false) != args.ENGINE_ANY || a.told == told) { ret 9; }
    # a named engine is left to the run, which stops when it cannot
    val again: u32 = a.told;
    if (pick_engine(?a, ?s, args.ENGINE_HASHLIFE, false) != args.ENGINE_HASHLIFE || a.told != again) { ret 10; }

    app.dnit(?a);
    sim.dnit(?s);
    ret 0;
}
