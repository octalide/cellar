# a small immediate-mode interface drawn straight into a boom overlay pass
#
# rectangles, triangles and text go into the pass in call order, and the pass
# keeps that order, so whatever is drawn later is on top and nothing needs a
# layer of its own. widgets are placed down a column cursor and report their
# interaction as they are drawn. a press is owned by the widget it began on
# until the button comes up, so a drag that leaves a slider keeps moving it.
# every size is multiplied by the interface scale. a text field takes the
# keyboard while it has focus, which the interface holds, so the caller can
# keep its own key bindings quiet while someone types.

use boom.event.Event;
use boom.event.KeyAction;
use boom.event.KeyEvent;
use boom.event.TextEvent;
use gfx: boom.graphics;
use inp: boom.input;
use gm:  boom.math;
use cellar.theme;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# unscaled row height, gap between rows and panel padding
pub val ROW: f32 = 28.0;
pub val GAP: f32 = 6.0;
pub val PAD: f32 = 14.0;

# the interface for one frame and what carries between frames
# ---
# pass:     the overlay pass being drawn into
# body:     the text face for labels
# small:    the text face for headings and readouts
# srgb:     the swapchain encodes sRGB, so colours are written as linear light
# s:        interface scale
# mx:       cursor x in framebuffer pixels
# my:       cursor y in framebuffer pixels
# down:     the left button is held
# pressed:  the left button went down this frame
# released: the left button came up this frame
# active:   the widget a held press belongs to, 0 for none
# next:     the id the next widget takes
# over:     the cursor is over something the interface drew this frame
# x:        the column's left edge
# y:        the column's cursor, the top of the next row
# w:        the column's width
# focus:    the text field the keyboard goes to, nil for none
# focus_on: the focused field was drawn this frame
pub rec Ui {
    pass:     *gfx.Pass;
    body:     *gfx.Font;
    small:    *gfx.Font;
    srgb:     bool;
    s:        f32;
    mx:       f32;
    my:       f32;
    down:     bool;
    pressed:  bool;
    released: bool;
    active:   u32;
    next:     u32;
    over:     bool;
    x:        f32;
    y:        f32;
    w:        f32;
    focus:    *Field;
    focus_on: bool;
}

# what a widget's rectangle is doing this frame
# ---
# hot:     the cursor is over it and no other widget holds the press
# held:    a press that began on it is still down
# clicked: a press that began on it was released over it
pub rec Hit {
    hot:     bool;
    held:    bool;
    clicked: bool;
}

# one vertex in boom's immediate-mode format
rec Vertex {
    x: f32;
    y: f32;
    u: f32;
    v: f32;
    r: f32;
    g: f32;
    b: f32;
    a: f32;
}

# start a frame
# ---
# u:    the interface
# pass: the overlay pass everything is drawn into
# mx:   cursor x in framebuffer pixels
# my:   cursor y in framebuffer pixels
# down: the left button is held
pub fun begin(u: *Ui, pass: *gfx.Pass, mx: f32, my: f32, down: bool) {
    u.pass     = pass;
    u.mx       = mx;
    u.my       = my;
    u.pressed  = down && !u.down;
    u.released = !down && u.down;
    u.down     = down;
    u.next     = 1;
    u.over     = false;
    u.focus_on = false;
}

# finish a frame, letting go of a press once the button is up, and of the
# keyboard when the focused field was not drawn
pub fun end(u: *Ui) {
    if (!u.down)                       { u.active = 0; }
    if (u.focus != nil && !u.focus_on) { u.focus = nil; }
}

# a scaled length
pub fun px(u: *Ui, v: f32) f32 {
    ret v * u.s;
}

# a hex colour at an opacity, in the swapchain's encoding
pub fun col(u: *Ui, hex: u32, alpha: f32) gm.Vec4 {
    ret gm.vec4(channel(u, theme.red(hex)), channel(u, theme.green(hex)), channel(u, theme.blue(hex)), alpha);
}

# fill a rectangle given by its corners
pub fun rect(u: *Ui, x0: f32, y0: f32, x1: f32, y1: f32, hex: u32, alpha: f32) {
    if (x1 <= x0 || y1 <= y0) { ret; }
    gfx.pass_draw_sprite(u.pass, opt[*gfx.Texture].none{}, gfx.rect(x0, y0, x1 - x0, y1 - y0), col(u, hex, alpha));
}

# outline a rectangle with a border t pixels thick, inside its corners
pub fun frame(u: *Ui, x0: f32, y0: f32, x1: f32, y1: f32, t: f32, hex: u32, alpha: f32) {
    rect(u, x0, y0, x1, y0 + t, hex, alpha);
    rect(u, x0, y1 - t, x1, y1, hex, alpha);
    rect(u, x0, y0 + t, x0 + t, y1 - t, hex, alpha);
    rect(u, x1 - t, y0 + t, x1, y1 - t, hex, alpha);
}

# a channel of a hex colour in the swapchain's encoding
fun channel(u: *Ui, byte: u8) f32 {
    val c: f32 = byte::f32 / 255.0;
    if (u.srgb) { ret theme.linear(c); }
    ret c;
}

# fill a triangle, whichever way its corners wind
pub fun tri(u: *Ui, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, hex: u32, alpha: f32) {
    val r: f32 = channel(u, theme.red(hex));
    val g: f32 = channel(u, theme.green(hex));
    val b: f32 = channel(u, theme.blue(hex));
    var v: [6]Vertex;
    v[0] = Vertex{x: ax, y: ay, u: 0.0, v: 0.0, r: r, g: g, b: b, a: alpha};
    v[1] = Vertex{x: bx, y: by, u: 0.0, v: 0.0, r: r, g: g, b: b, a: alpha};
    v[2] = Vertex{x: cx, y: cy, u: 0.0, v: 0.0, r: r, g: g, b: b, a: alpha};
    v[3] = v[0];
    v[4] = v[2];
    v[5] = v[1];
    gfx.pass_draw_triangles(u.pass, (?v[0])::ptr, 6, opt[*gfx.Texture].none{});
}

# the height of a line of text in a face
pub fun line(f: *gfx.Font) f32 {
    ret gfx.face_line_height(gfx.font_face(f));
}

# the width a string takes in a face
pub fun measure(f: *gfx.Font, s: str) f32 {
    ret gfx.text_measure(f, s);
}

# draw a string with its line box's top-left at (x, y); ret the pen after it
pub fun text(u: *Ui, f: *gfx.Font, s: str, x: f32, y: f32, hex: u32, alpha: f32) f32 {
    ret gfx.text_draw(u.pass, f, s, x, y, col(u, hex, alpha));
}

# draw a string vertically centred in a band from y0 to y1
pub fun text_mid(u: *Ui, f: *gfx.Font, s: str, x: f32, y0: f32, y1: f32, hex: u32, alpha: f32) f32 {
    ret text(u, f, s, x, y0 + (y1 - y0 - line(f)) / 2.0, hex, alpha);
}

# draw a string centred in a rectangle
pub fun text_centre(u: *Ui, f: *gfx.Font, s: str, x0: f32, y0: f32, x1: f32, y1: f32, hex: u32, alpha: f32) {
    text_mid(u, f, s, x0 + (x1 - x0 - measure(f, s)) / 2.0, y0, y1, hex, alpha);
}

# whether the cursor is inside a rectangle
pub fun inside(u: *Ui, x0: f32, y0: f32, x1: f32, y1: f32) bool {
    ret u.mx >= x0 && u.mx < x1 && u.my >= y0 && u.my < y1;
}

# claim a rectangle for the interface, so the world under it is left alone
pub fun block(u: *Ui, x0: f32, y0: f32, x1: f32, y1: f32) {
    if (inside(u, x0, y0, x1, y1)) { u.over = true; }
}

# take the id for the next widget
pub fun id(u: *Ui) u32 {
    val n: u32 = u.next;
    u.next = u.next + 1;
    ret n;
}

# interact with a rectangle as widget n
pub fun hit(u: *Ui, n: u32, x0: f32, y0: f32, x1: f32, y1: f32) Hit {
    var h:    Hit;
    val over: bool = inside(u, x0, y0, x1, y1);
    h.hot = over && (u.active == 0 || u.active == n);
    if (h.hot && u.pressed) { u.active = n; }
    h.held    = u.active == n && u.down;
    h.clicked = u.active == n && u.released && over;
    ret h;
}

# interact with a rectangle as the next widget
pub fun region(u: *Ui, x0: f32, y0: f32, x1: f32, y1: f32) Hit {
    ret hit(u, id(u), x0, y0, x1, y1);
}

# the fill a control takes for its state
pub fun fill(h: Hit, on: bool) u32 {
    if (on)     { ret theme.ACCENT; }
    if (h.held) { ret theme.CONTROL_ON; }
    if (h.hot)  { ret theme.CONTROL_HOT; }
    ret theme.CONTROL;
}

# the ink for text on a control
pub fun ink(on: bool) u32 {
    if (on) { ret theme.ACCENT_INK; }
    ret theme.TEXT;
}

# a labelled button in a rectangle; on draws it selected
pub fun button_at(u: *Ui, label: str, x0: f32, y0: f32, x1: f32, y1: f32, on: bool) bool {
    val h: Hit = region(u, x0, y0, x1, y1);
    rect(u, x0, y0, x1, y1, fill(h, on), 1.0);
    text_centre(u, u.body, label, x0, y0, x1, y1, ink(on), 1.0);
    ret h.clicked;
}

# start a column of rows at (x, y), w wide
pub fun column(u: *Ui, x: f32, y: f32, w: f32) {
    u.x = x;
    u.y = y;
    u.w = w;
}

# leave vertical space in the column
pub fun space(u: *Ui, v: f32) {
    u.y = u.y + px(u, v);
}

# the left edge of cell i of n equal cells across the column
pub fun cell_x0(u: *Ui, i: usize, n: usize) f32 {
    val g: f32 = px(u, GAP);
    val w: f32 = (u.w - g * (n - 1)::f32) / n::f32;
    ret u.x + i::f32 * (w + g);
}

# the right edge of cell i of n equal cells across the column
pub fun cell_x1(u: *Ui, i: usize, n: usize) f32 {
    val g: f32 = px(u, GAP);
    val w: f32 = (u.w - g * (n - 1)::f32) / n::f32;
    ret u.x + i::f32 * (w + g) + w;
}

# move the cursor past a row of height h and the gap below it
pub fun advance(u: *Ui, h: f32) {
    u.y = u.y + h + px(u, GAP);
}

# a row of n buttons; ret the index clicked, or n for none
pub fun buttons(u: *Ui, labels: *str, n: usize) usize {
    val h:   f32   = px(u, ROW);
    var got: usize = n;
    var i:   usize = 0;
    for (i < n) {
        if (button_at(u, labels[i], cell_x0(u, i, n), u.y, cell_x1(u, i, n), u.y + h, false)) { got = i; }
        i = i + 1;
    }
    advance(u, h);
    ret got;
}

# one full-width button
pub fun button(u: *Ui, label: str, on: bool) bool {
    val h:  f32  = px(u, ROW);
    val hi: bool = button_at(u, label, u.x, u.y, u.x + u.w, u.y + h, on);
    advance(u, h);
    ret hi;
}

# a row choosing one of n options; ret true when the choice changed
pub fun segmented(u: *Ui, labels: *str, n: usize, choice: *usize) bool {
    val h:       f32   = px(u, ROW);
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < n) {
        if (button_at(u, labels[i], cell_x0(u, i, n), u.y, cell_x1(u, i, n), u.y + h, @choice == i)) {
            if (@choice != i) { changed = true; }
            @choice = i;
        }
        i = i + 1;
    }
    advance(u, h);
    ret changed;
}

# a labelled on/off switch; ret true when flipped
pub fun toggle(u: *Ui, label: str, v: *u8) bool {
    val h:  f32 = px(u, ROW);
    val y0: f32 = u.y;
    val y1: f32 = u.y + h;
    val hh: Hit = region(u, u.x, y0, u.x + u.w, y1);
    if (hh.hot) { rect(u, u.x - px(u, 6.0), y0, u.x + u.w + px(u, 6.0), y1, theme.CONTROL, 0.5); }
    text_mid(u, u.body, label, u.x, y0, y1, theme.TEXT, 1.0);

    val sw:    f32 = px(u, 34.0);
    val sh:    f32 = px(u, 18.0);
    val sx:    f32 = u.x + u.w - sw;
    val sy:    f32 = y0 + (h - sh) / 2.0;
    var track: u32 = theme.CONTROL_ON;
    if (@v != 0) { track = theme.ACCENT; }
    rect(u, sx, sy, sx + sw, sy + sh, track, 1.0);
    val k:  f32 = sh - px(u, 6.0);
    var kx: f32 = sx + px(u, 3.0);
    if (@v != 0) { kx = sx + sw - px(u, 3.0) - k; }
    var knob: u32 = theme.TEXT_DIM;
    if (@v != 0) { knob = theme.ACCENT_INK; }
    rect(u, kx, sy + px(u, 3.0), kx + k, sy + px(u, 3.0) + k, knob, 1.0);

    advance(u, h);
    if (hh.clicked) {
        @v = 1 - @v;
        ret true;
    }
    ret false;
}

# a dragged value between lo and hi, its label left and its reading right
pub fun slider(u: *Ui, label: str, reading: str, v: *f32, lo: f32, hi: f32) bool {
    val h:       f32  = px(u, ROW);
    val x0:      f32  = u.x;
    val x1:      f32  = u.x + u.w;
    val y0:      f32  = u.y;
    val y1:      f32  = u.y + h;
    val hh:      Hit  = region(u, x0, y0, x1, y1);
    var changed: bool = false;
    if (hh.held) {
        var t: f32 = (u.mx - x0) / (x1 - x0);
        if (t < 0.0) { t = 0.0; }
        if (t > 1.0) { t = 1.0; }
        val nv: f32 = lo + t * (hi - lo);
        if (nv != @v) { changed = true; }
        @v = nv;
    }
    var f: f32 = (@v - lo) / (hi - lo);
    if (f < 0.0) { f = 0.0; }
    if (f > 1.0) { f = 1.0; }
    rect(u, x0, y0, x1, y1, fill(hh, false), 1.0);
    rect(u, x0, y0, x0 + (x1 - x0) * f, y1, theme.ACCENT, 0.28);
    rect(u, x0 + (x1 - x0) * f - px(u, 2.0), y0, x0 + (x1 - x0) * f, y1, theme.ACCENT, 1.0);
    text_mid(u, u.body, label, x0 + px(u, 10.0), y0, y1, theme.TEXT, 1.0);
    text_mid(u, u.body, reading, x1 - px(u, 10.0) - measure(u.body, reading), y0, y1, theme.TEXT_DIM, 1.0);
    advance(u, h);
    ret changed;
}

# a line of small dim text
pub fun note(u: *Ui, s: str) {
    text(u, u.small, s, u.x, u.y, theme.TEXT_DIM, 1.0);
    u.y = u.y + line(u.small) + px(u, 2.0);
}

# a small caret pointing right, or down when open
pub fun caret(u: *Ui, x: f32, y: f32, open: bool, hex: u32) {
    val k: f32 = px(u, 4.0);
    if (open) { tri(u, x - k, y - k / 2.0, x + k, y - k / 2.0, x, y + k, hex, 1.0); }
    or        { tri(u, x - k / 2.0, y - k, x - k / 2.0, y + k, x + k, y, hex, 1.0); }
}

# a collapsible section heading across the column; ret whether it is open
pub fun heading(u: *Ui, title: str, open: *u8) bool {
    val h:  f32 = px(u, 30.0);
    val y0: f32 = u.y;
    val y1: f32 = u.y + h;
    val hh: Hit = region(u, u.x - px(u, PAD), y0, u.x + u.w + px(u, PAD), y1);
    if (hh.clicked) { @open = 1 - @open; }
    var ink: u32 = theme.TEXT_DIM;
    if (hh.hot) { ink = theme.TEXT; }
    caret(u, u.x + px(u, 4.0), y0 + h / 2.0, @open != 0, ink);
    text_mid(u, u.small, title, u.x + px(u, 16.0), y0, y1, ink, 1.0);
    u.y = y1 + px(u, 4.0);
    ret @open != 0;
}

# the most bytes a text field holds, less its terminator: enough for any
# family's rule string (see cellar.rule.FORMAT_MAX)
pub val FIELD_CAP: usize = 24703;

# what a text field did since it was last drawn, the later of two winning
# ---
# FIELD_NONE:    nothing
# FIELD_EDITED:  its text changed
# FIELD_ENTERED: enter ended the edit
# FIELD_ESCAPED: escape ended the edit
pub val FIELD_NONE:    u8 = 0;
pub val FIELD_EDITED:  u8 = 1;
pub val FIELD_ENTERED: u8 = 2;
pub val FIELD_ESCAPED: u8 = 3;

# glfw's modifier bits, which boom's key events carry as they came
val MOD_SHIFT: i32 = 1;
val MOD_CTRL:  i32 = 2;

# an editable line of text
#
# the text is UTF-8 and every offset sits on a character boundary. a field is
# edited through the focus (see feed) and drawn by text_field, which also
# reports what the edits came to.
# ---
# buf:    the text, NUL-terminated
# len:    bytes of text
# caret:  byte offset of the caret
# anchor: the selection's other end, equal to caret when nothing is selected
# first:  byte offset of the first character shown, so the caret stays in view
# max:    the most bytes the text may take, at most FIELD_CAP
# accept: whether a typed codepoint belongs in the field, nil for any printable one
# did:    a FIELD_* the edits came to since text_field last reported
pub rec Field {
    buf:    [FIELD_CAP + 1]u8;
    len:    usize;
    caret:  usize;
    anchor: usize;
    first:  usize;
    max:    usize;
    accept: fun(u32) bool;
    did:    u8;
}

# make an empty field
# ---
# f:      the field
# max:    the most bytes it takes, capped at FIELD_CAP
# accept: which typed codepoints it takes, nil for any printable one
pub fun field_init(f: *Field, max: usize, accept: fun(u32) bool) {
    f.buf[0] = 0;
    f.len    = 0;
    f.caret  = 0;
    f.anchor = 0;
    f.first  = 0;
    f.max    = max;
    if (max > FIELD_CAP) { f.max = FIELD_CAP; }
    f.accept = accept;
    f.did    = FIELD_NONE;
}

# the field's text
pub fun field_text(f: *Field) str {
    ret ?f.buf[0];
}

# replace the text, cut to the field's length on a character boundary, with the caret at its end
pub fun field_set(f: *Field, s: str) {
    var n: usize = 0;
    for (s[n] != 0 && n < f.max) {
        f.buf[n] = s[n];
        n        = n + 1;
    }
    for (n > 0 && (f.buf[n] & 0xc0) == 0x80) { n = n - 1; }
    # a lead byte whose continuation was cut goes too
    if (n > 0 && s[n] != 0 && f.buf[n - 1] >= 0xc0) { n = n - 1; }
    f.buf[n] = 0;
    f.len    = n;
    f.caret  = n;
    f.anchor = n;
    f.first  = 0;
}

# whether some text is selected
pub fun field_selected(f: *Field) bool {
    ret f.caret != f.anchor;
}

fun sel_lo(f: *Field) usize {
    if (f.caret < f.anchor) { ret f.caret; }
    ret f.anchor;
}

fun sel_hi(f: *Field) usize {
    if (f.caret > f.anchor) { ret f.caret; }
    ret f.anchor;
}

# the character boundary before i
fun before(f: *Field, i: usize) usize {
    if (i == 0) { ret 0; }
    var j: usize = i - 1;
    for (j > 0 && (f.buf[j] & 0xc0) == 0x80) { j = j - 1; }
    ret j;
}

# the character boundary after i
fun after(f: *Field, i: usize) usize {
    if (i >= f.len) { ret f.len; }
    var j: usize = i + 1;
    for (j < f.len && (f.buf[j] & 0xc0) == 0x80) { j = j + 1; }
    ret j;
}

# remove the bytes [lo, hi), leaving the caret at lo
fun remove(f: *Field, lo: usize, hi: usize) {
    var i: usize = hi;
    for (i <= f.len) {
        f.buf[lo + i - hi] = f.buf[i];
        i                  = i + 1;
    }
    f.len    = f.len - (hi - lo);
    f.caret  = lo;
    f.anchor = lo;
    if (f.first > lo) { f.first = lo; }
}

# note what an edit came to, a later outcome winning over an earlier one
fun did(f: *Field, r: u8) {
    if (r > f.did) { f.did = r; }
}

# a codepoint as UTF-8 into out; ret its length, 0 for no scalar value
fun utf8(cp: u32, out: *u8) usize {
    if (cp < 0x80) {
        out[0] = cp::u8;
        ret 1;
    }
    if (cp < 0x800) {
        out[0] = (0xc0 | (cp >> 6))::u8;
        out[1] = (0x80 | (cp & 0x3f))::u8;
        ret 2;
    }
    if (cp >= 0xd800 && cp < 0xe000) { ret 0; }
    if (cp < 0x10000) {
        out[0] = (0xe0 | (cp >> 12))::u8;
        out[1] = (0x80 | ((cp >> 6) & 0x3f))::u8;
        out[2] = (0x80 | (cp & 0x3f))::u8;
        ret 3;
    }
    if (cp < 0x110000) {
        out[0] = (0xf0 | (cp >> 18))::u8;
        out[1] = (0x80 | ((cp >> 12) & 0x3f))::u8;
        out[2] = (0x80 | ((cp >> 6) & 0x3f))::u8;
        out[3] = (0x80 | (cp & 0x3f))::u8;
        ret 4;
    }
    ret 0;
}

# whether a codepoint is text rather than a control
fun printable(cp: u32) bool {
    ret cp >= 0x20 && (cp < 0x7f || cp >= 0xa0);
}

# type a codepoint at the caret over any selection
# ---
# f:   the field
# cp:  a unicode scalar value
# ret: whether the text changed; false when the field refuses it or is full
pub fun field_type(f: *Field, cp: u32) bool {
    if (!printable(cp))                   { ret false; }
    if (f.accept != nil && !f.accept(cp)) { ret false; }
    var b: [4]u8;
    val n: usize = utf8(cp, ?b[0]);
    if (n == 0) { ret false; }
    val lo: usize = sel_lo(f);
    val hi: usize = sel_hi(f);
    if (f.len - (hi - lo) + n > f.max) { ret false; }
    if (hi > lo)                       { remove(f, lo, hi); }
    var i: usize = f.len + 1;
    for (i > lo) {
        i            = i - 1;
        f.buf[i + n] = f.buf[i];
    }
    var k: usize = 0;
    for (k < n) {
        f.buf[lo + k] = b[k];
        k             = k + 1;
    }
    f.len    = f.len + n;
    f.caret  = lo + n;
    f.anchor = f.caret;
    did(f, FIELD_EDITED);
    ret true;
}

# move the caret to i, extending the selection when shift is held
fun move_to(f: *Field, i: usize, shift: bool) {
    f.caret = i;
    if (!shift) { f.anchor = i; }
}

# apply an editing key: backspace, delete, left and right (shift selects), ctrl+A
# selects all, and enter and escape end the edit
# ---
# f:    the field
# k:    the key
# mods: glfw modifier bits
# ret:  the FIELD_* it came to
pub fun field_key(f: *Field, k: inp.Key, mods: i32) u8 {
    val shift: bool = (mods & MOD_SHIFT) != 0;
    var r:     u8   = FIELD_NONE;
    if (k == inp.KEY_ENTER)  { r = FIELD_ENTERED; }
    if (k == inp.KEY_ESCAPE) { r = FIELD_ESCAPED; }
    if (k == inp.KEY_A && (mods & MOD_CTRL) != 0) {
        f.anchor = 0;
        f.caret  = f.len;
    }
    if (k == inp.KEY_BACKSPACE || k == inp.KEY_DELETE) {
        var lo: usize = sel_lo(f);
        var hi: usize = sel_hi(f);
        if (lo == hi && k == inp.KEY_BACKSPACE) { lo = before(f, lo); }
        if (lo == hi && k == inp.KEY_DELETE)    { hi = after(f, hi); }
        if (hi > lo) {
            remove(f, lo, hi);
            r = FIELD_EDITED;
        }
    }
    if (k == inp.KEY_LEFT) {
        if (field_selected(f) && !shift) { move_to(f, sel_lo(f), false); }
        or                               { move_to(f, before(f, f.caret), shift); }
    }
    if (k == inp.KEY_RIGHT) {
        if (field_selected(f) && !shift) { move_to(f, sel_hi(f), false); }
        or                               { move_to(f, after(f, f.caret), shift); }
    }
    did(f, r);
    ret r;
}

# give a field the keyboard, or take it away with nil; a field given it after
# it was drawn keeps it past this frame's end
pub fun focus(u: *Ui, f: *Field) {
    u.focus    = f;
    u.focus_on = f != nil;
}

# whether a text field has the keyboard, so other key bindings should stay quiet
pub fun typing(u: *Ui) bool {
    ret u.focus != nil;
}

# hand an input event to the focused field; enter and escape give the keyboard back
# ---
# u: the interface
# e: an event from boom's queue, in the order it arrived
pub fun feed(u: *Ui, e: Event) {
    if (u.focus == nil) { ret; }
    if (sel e.text) {
        field_type(u.focus, e.text.codepoint);
        ret;
    }
    if (!sel e.key)               { ret; }
    if (sel e.key.action.release) { ret; }
    val r: u8 = field_key(u.focus, e.key.key, e.key.mods);
    if (r == FIELD_ENTERED || r == FIELD_ESCAPED) { u.focus = nil; }
}

# the width of the field's bytes [lo, hi) in a face
fun span(fnt: *gfx.Font, f: *Field, lo: usize, hi: usize) f32 {
    if (hi <= lo) { ret 0.0; }
    val keep: u8 = f.buf[hi];
    f.buf[hi] = 0;
    val w: f32 = measure(fnt, ?f.buf[lo]);
    f.buf[hi] = keep;
    ret w;
}

# scroll the shown text so the caret is in view in w pixels, and shows as much as fits
fun keep_in_view(fnt: *gfx.Font, f: *Field, w: f32) {
    if (f.first > f.caret) { f.first = f.caret; }
    for (f.first < f.caret && span(fnt, f, f.first, f.caret) > w) { f.first = after(f, f.first); }
    for (f.first > 0 && span(fnt, f, before(f, f.first), f.len) <= w) { f.first = before(f, f.first); }
}

# a one-line text field across the column
#
# a press on it gives it the keyboard and puts the caret under the cursor; a
# press elsewhere, or a frame it is not drawn in, takes the keyboard back.
# ---
# u:    the interface
# f:    the field
# hint: dim text shown while it is empty and unfocused
# ret:  the FIELD_* its edits came to since it was last drawn
pub fun text_field(u: *Ui, f: *Field, hint: str) u8 {
    val h:   f32 = px(u, ROW);
    val x0:  f32 = u.x;
    val y0:  f32 = u.y;
    val x1:  f32 = u.x + u.w;
    val y1:  f32 = u.y + h;
    val pad: f32 = px(u, 8.0);
    val tx:  f32 = x0 + pad;
    val tw:  f32 = x1 - x0 - pad * 2.0;
    val hh:  Hit = region(u, x0, y0, x1, y1);
    if (u.pressed && hh.hot) {
        u.focus = f;
        keep_in_view(u.body, f, tw);
        var i: usize = f.first;
        for (i < f.len) {
            val n: usize = after(f, i);
            if (u.mx < tx + span(u.body, f, f.first, i) + span(u.body, f, i, n) / 2.0) { brk; }
            i = n;
        }
        move_to(f, i, false);
    }
    or (u.pressed && u.focus == f) { u.focus = nil; }
    val on: bool = u.focus == f;
    if (on) { u.focus_on = true; }

    var back: u32 = theme.WORLD;
    if (hh.hot && !on) { back = theme.CONTROL_HOT; }
    rect(u, x0, y0, x1, y1, back, 1.0);
    if (on) { frame(u, x0, y0, x1, y1, px(u, 1.0), theme.ACCENT, 1.0); }
    or      { frame(u, x0, y0, x1, y1, px(u, 1.0), theme.CONTROL_ON, 1.0); }

    keep_in_view(u.body, f, tw);
    var e: usize = f.len;
    for (e > f.first && span(u.body, f, f.first, e) > tw) { e = before(f, e); }
    if (f.len == 0 && !on) { text_mid(u, u.body, hint, tx, y0, y1, theme.TEXT_FAINT, 1.0); }
    if (on && field_selected(f)) {
        var lo: usize = sel_lo(f);
        var hi: usize = sel_hi(f);
        if (lo < f.first) { lo = f.first; }
        if (hi > e)       { hi = e; }
        val sx0: f32 = tx + span(u.body, f, f.first, lo);
        val sx1: f32 = tx + span(u.body, f, f.first, hi);
        rect(u, sx0, y0 + px(u, 4.0), sx1, y1 - px(u, 4.0), theme.ACCENT, 0.35);
    }
    val keep: u8 = f.buf[e];
    f.buf[e] = 0;
    text_mid(u, u.body, ?f.buf[f.first], tx, y0, y1, theme.TEXT, 1.0);
    f.buf[e] = keep;
    if (on) {
        val cx: f32 = tx + span(u.body, f, f.first, f.caret);
        rect(u, cx, y0 + px(u, 5.0), cx + px(u, 1.5), y1 - px(u, 5.0), theme.TEXT, 1.0);
    }
    advance(u, h);
    val r: u8 = f.did;
    f.did = FIELD_NONE;
    ret r;
}

test hit__a_press_belongs_to_its_widget_until_release {
    var u: Ui;
    u.mx      = 5.0;
    u.my      = 5.0;
    u.pressed = true;
    u.down    = true;
    val a: Hit = hit(?u, 1, 0.0, 0.0, 10.0, 10.0);
    if (!a.held || u.active != 1) { ret 1; }
    # dragged off the widget, it keeps the press and another cannot take it
    u.mx      = 50.0;
    u.pressed = false;
    val b: Hit = hit(?u, 2, 40.0, 0.0, 60.0, 10.0);
    if (b.hot || b.held) { ret 2; }
    val c: Hit = hit(?u, 1, 0.0, 0.0, 10.0, 10.0);
    if (!c.held) { ret 3; }
    # released away from it, it is not clicked
    u.down     = false;
    u.released = true;
    val d: Hit = hit(?u, 1, 0.0, 0.0, 10.0, 10.0);
    if (d.clicked) { ret 4; }
    ret 0;
}

# a field that takes digits only
#[testing]
fun digits(cp: u32) bool {
    ret cp >= '0' && cp <= '9';
}

test field__edits_at_the_caret_within_its_length {
    var f: Field;
    field_init(?f, 6, nil);
    field_type(?f, 'a');
    field_type(?f, 'c');
    field_key(?f, inp.KEY_LEFT, 0);
    field_type(?f, 'b');
    if (!string.str_equals(field_text(?f), "abc") || f.caret != 2) { ret 1; }
    # a two-byte codepoint moves and deletes as one character
    field_type(?f, 0xe9);
    if (f.len != 5 || f.caret != 4) { ret 2; }
    field_key(?f, inp.KEY_LEFT, 0);
    if (f.caret != 2) { ret 3; }
    field_key(?f, inp.KEY_DELETE, 0);
    if (!string.str_equals(field_text(?f), "abc")) { ret 4; }
    # full: the six-byte cap refuses what does not fit
    field_type(?f, 'x');
    field_type(?f, 'y');
    field_type(?f, 'z');
    if (field_type(?f, 'w') || f.len != 6) { ret 5; }
    # shift selects, typing replaces the selection, backspace takes a selection whole
    field_key(?f, inp.KEY_A, MOD_CTRL);
    field_type(?f, 'q');
    if (!string.str_equals(field_text(?f), "q")) { ret 6; }
    field_type(?f, 'r');
    field_key(?f, inp.KEY_LEFT, MOD_SHIFT);
    field_key(?f, inp.KEY_BACKSPACE, 0);
    if (!string.str_equals(field_text(?f), "q"))          { ret 7; }
    if (field_key(?f, inp.KEY_ENTER, 0) != FIELD_ENTERED) { ret 8; }
    if (f.did != FIELD_ENTERED)                           { ret 9; }
    # the filter and control characters are refused
    var d: Field;
    field_init(?d, 8, digits);
    if (field_type(?d, 'a') || field_type(?d, 0x08) || !field_type(?d, '7')) { ret 10; }
    field_set(?d, "123456789");
    if (d.len != 8 || d.caret != 8) { ret 11; }
    ret 0;
}

test feed__enter_and_escape_give_the_keyboard_back {
    var u: Ui;
    var f: Field;
    field_init(?f, 16, nil);
    focus(?u, ?f);
    feed(?u, Event.text{TextEvent{codepoint: 'k'}});
    feed(?u, Event.key{KeyEvent{key: inp.KEY_S, action: KeyAction.release{}, mods: 0}});
    if (!typing(?u) || f.len != 1) { ret 1; }
    feed(?u, Event.key{KeyEvent{key: inp.KEY_ESCAPE, action: KeyAction.press{}, mods: 0}});
    if (typing(?u)) { ret 2; }
    # nothing reaches a field that lost the keyboard
    feed(?u, Event.text{TextEvent{codepoint: 'j'}});
    if (f.len != 1) { ret 3; }
    ret 0;
}
