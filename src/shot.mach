# screenshots of the window, saved as PNG
#
# a screenshot is armed while a frame is open and read back as that frame ends,
# so it holds exactly what was drawn, window only. the bytes come back in the
# swapchain's own order and encoding, which is what the display shows, so they
# are only reordered to RGBA and made opaque before encoding.

use gfx: boom.graphics;
use cellar.persist;
use cellar.text;
use img:  image;
use allo: std.allocator;
use std.chrono.time;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# why a screenshot was not saved
# ---
# gfx:    the window could not be read back
# alloc:  a buffer was refused
# encode: the PNG encoder refused the image
# fs:     the file could not be written
pub tag Error: u8 {
    gfx:    gfx.Error;
    alloc:  allo.Error;
    encode: img.EncodeError;
    fs:     fs.FsError;
}

# a readback in flight
# ---
# buf:   the window's bytes, filled as the frame ends
# len:   buf's size
# w:     width in pixels
# h:     height in pixels
# bgra:  the bytes come blue first
# armed: a readback is in flight
pub rec Shot {
    buf:   *u8;
    len:   usize;
    w:     u32;
    h:     u32;
    bgra:  bool;
    armed: bool;
}

# ask for the frame being drawn; call between begin and end frame
pub fun arm(a: *allo.Allocator, r: *gfx.Renderer, s: *Shot) err[Error] {
    s.armed = false;
    s.len   = gfx.renderer_window_bytes(r);
    if (s.len == 0) { ret err[Error].err{Error.alloc{allo.Error.invalid{}}}; }
    val br: res[*u8, allo.Error] = allo.allocate[u8](a, s.len);
    if (sel br.err) { ret err[Error].err{Error.alloc{br.err}}; }
    s.buf = br.ok;
    val got: err[gfx.Error] = gfx.renderer_capture(r, s.buf, s.len);
    if (sel got.err) {
        allo.deallocate[u8](a, s.buf, s.len);
        ret err[Error].err{Error.gfx{got.err}};
    }
    s.w     = gfx.renderer_width(r)::u32;
    s.h     = gfx.renderer_height(r)::u32;
    s.bgra  = gfx.renderer_window_bgra(r);
    s.armed = true;
    ret err[Error].ok{};
}

# encode an ended frame's readback to path and release it
pub fun write(a: *allo.Allocator, s: *Shot, path: str) err[Error] {
    if (!s.armed) { ret err[Error].ok{}; }
    s.armed = false;
    var i: usize = 0;
    for (i + 3 < s.len) {
        if (s.bgra) {
            val b: u8 = s.buf[i];
            s.buf[i]     = s.buf[i + 2];
            s.buf[i + 2] = b;
        }
        s.buf[i + 3] = 255;
        i            = i + 4;
    }
    var im:    img.Image                   = img.Image{pixels: s.buf, width: s.w, height: s.h, channels: 4, colorspace: img.COLORSPACE_SRGB};
    val bound: res[usize, img.EncodeError] = img.png_encode_bound(s.w, s.h);
    if (sel bound.err) {
        allo.deallocate[u8](a, s.buf, s.len);
        ret err[Error].err{Error.encode{bound.err}};
    }
    val dr: res[*u8, allo.Error] = allo.allocate[u8](a, bound.ok);
    if (sel dr.err) {
        allo.deallocate[u8](a, s.buf, s.len);
        ret err[Error].err{Error.alloc{dr.err}};
    }
    val n: res[usize, img.EncodeError] = img.png_encode(?im, dr.ok, bound.ok);
    allo.deallocate[u8](a, s.buf, s.len);
    if (sel n.err) {
        allo.deallocate[u8](a, dr.ok, bound.ok);
        ret err[Error].err{Error.encode{n.err}};
    }
    val made: err[fs.FsError] = persist.make_parent(a, path);
    if (sel made.err) {
        allo.deallocate[u8](a, dr.ok, bound.ok);
        ret err[Error].err{Error.fs{made.err}};
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, dr.ok, n.ok, persist.FILE_MODE);
    allo.deallocate[u8](a, dr.ok, bound.ok);
    if (sel wrote.err) { ret err[Error].err{Error.fs{wrote.err}}; }
    ret err[Error].ok{};
}

# name a new screenshot in dir, by the time it was taken, into out
# ---
# dir: the data directory
# out: at least 1200 bytes
# ret: out
pub fun name(dir: str, out: *u8) str {
    var sec: i64        = 0;
    val c:   time.Clock = time.now();
    if (sel c.ok) { sec = time.time_unix_sec(c.ok); }
    var o: usize = text.buf_str(out, 0, dir);
    o      = text.buf_str(out, o, "/screenshots/cellar-");
    o      = text.buf_u64(out, o, sec::u64);
    o      = text.buf_str(out, o, ".png");
    out[o] = 0;
    ret out;
}
