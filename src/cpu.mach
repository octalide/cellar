# one generation of the pool on the CPU, split across a team by chunk
#
# the reference the GPU stages are checked against, and the engine where no
# usable GPU exists. each chunk's cells are computed from the front cells of
# its 3 by 3 block into its own back cells by the rule's family, and its census
# is written as it goes, so no two jobs write the same memory.
#
# a chunk with no live cell in its 3 by 3 block as the step began is stepped
# as not busy, which lets its family skip the footprint, and one that is also
# cold only clears. a rule that changes quiescent cells (B0) is always busy.

use cellar.layout;
use cellar.rule;
use cellar.rules.weighted;
use cellar.space;
use cellar.team;
use allo: std.allocator;
use std.allocator.page;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

rec Round {
    sp:   *space.Space;
    r:    *rule.Rule;
    b0:   bool;
    sens: layout.Sense;
}

fun step_slot(arg: *u8, s: usize) {
    val rd: *Round       = arg::*Round;
    val sp: *space.Space = rd.sp;
    val e:  *u32         = ?sp.table[s * space.ENTRY];
    val cn: *u32         = ?sp.census[s * space.CENSUS];
    if (e[11] == 0) { ret; }
    val out: *u32 = ?sp.back[s * space.CELLS];

    # the census as the step began says whether anything nearby is alive
    var b: space.Block;
    b.busy = rd.b0;
    var q: usize = 0;
    for (q < 9) {
        b.nb[q] = nil;
        if (e[q] != space.NONE) {
            b.nb[q] = ?sp.cells[e[q]::usize * space.CELLS];
            if (sp.before[e[q]::usize * space.CENSUS] != 0) { b.busy = true; }
        }
        q = q + 1;
    }
    b.out = out;
    var t: space.Tally = space.tally(rd.sens);
    if (!b.busy && sp.before[s * space.CENSUS + 1] == 0) { mem.zero[u32](out, space.CELLS); }
    or                                                   { rule.step_chunk(rd.r, ?b, ?t); }
    space.tally_census(?t, cn, e[11]);
}

# advance the pool one generation and reshape it around the result
#
# every chunk steps into its back cells, the buffers swap, and the census the
# step wrote settles the pool, so the next generation again finds every live
# chunk surrounded.
# ---
# sp:  the pool, with back cells, whose sense is the rule's
# r:   the rule
# t:   the team to split the chunks across
# ret: false when the pool could not hold a chunk the world grew into
pub fun step(sp: *space.Space, r: *rule.Rule, t: *team.Team) bool {
    var rd: Round;
    rd.sp   = sp;
    rd.r    = r;
    rd.b0   = rule.caps(r).b0;
    rd.sens = sp.sense;
    mem.copy[u32](sp.before, sp.census, sp.hi * space.CENSUS);
    team.run(t, step_slot, (?rd)::*u8, sp.hi);
    val front: *u32 = sp.cells;
    sp.cells = sp.back;
    sp.back  = front;
    ret space.settle(sp, sp.census, sp.hi, true);
}

test step__a_glider_crosses_chunk_borders_and_the_pool_follows {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   space.Space;
    val made: err[allo.Error] = space.init(?sp, ?a, true);
    if (sel made.err) { ret 1; }
    var t: team.Team;
    team.start(?t);
    var r: rule.Rule = rule.Rule.weighted{weighted.life()};
    sp.sense = rule.sense(?r);

    # a south-east glider just west and north of the origin's chunk corner
    val s: usize = space.alloc(?sp, -1, -1)::usize;
    val c: *u32  = ?sp.cells[s * space.CELLS];
    c[60 * 64 + 61] = rule.word(?r, 1);
    c[61 * 64 + 62] = rule.word(?r, 1);
    c[62 * 64 + 60] = rule.word(?r, 1);
    c[62 * 64 + 61] = rule.word(?r, 1);
    c[62 * 64 + 62] = rule.word(?r, 1);
    space.recount(?sp, s);
    space.settle(?sp, sp.census, sp.hi, false);

    # 4 generations move it one cell diagonally; after 40 it lies inside (0, 0)
    var g: usize = 0;
    for (g < 40) {
        if (!step(?sp, ?r, ?t)) { ret 2; }
        g = g + 1;
    }
    if (space.population(?sp) != 5) { ret 3; }
    val o: u32 = space.find(?sp, 0, 0);
    if (o == space.NONE) { ret 4; }
    # the glider's cells shifted by (10, 10) from where it started
    val d: *u32 = ?sp.cells[o::usize * space.CELLS];
    if (!space.live(?sp, d[6 * 64 + 7]) || !space.live(?sp, d[7 * 64 + 8]) || !space.live(?sp, d[8 * 64 + 6])) { ret 5; }
    if (!space.live(?sp, d[8 * 64 + 7]) || !space.live(?sp, d[8 * 64 + 8]))                                    { ret 6; }
    # the chunk it started in is cold and empty by now, and its far corner freed
    if (space.find(?sp, -2, -2) != space.NONE) { ret 7; }
    team.stop(?t);
    space.dnit(?sp);
    ret 0;
}
