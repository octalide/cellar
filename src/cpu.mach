# one generation of the pool on the CPU, split across a team by chunk
#
# the reference the GPU stages are checked against, and the engine where no
# usable GPU exists. each chunk's cells are computed from the front cells of
# its 3 by 3 block into its own back cells by the rule's family, and its census
# is written as it goes, so no two jobs write the same memory.
#
# a chunk with no live cell in its 3 by 3 block as the step began is stepped
# as not busy, which lets its family skip the footprint, and one that is also
# cold only clears. every family keeps the pool's background dead, a rule that
# births on 0 included (see cellar.rule), so this holds under every rule.
#
# a seamed chunk of a bounded grid (cellar.layout) is stepped after the rest,
# one at a time: its 3 by 3 block is gathered through its links into frames
# the family steps as it would any block, busy, and what it writes off the
# grid is cleared before the census is taken. a cell past a plane's dead edge
# is gathered as the rule holds the edge at the generation (rule.outside).
#
# on a pool held whole (cellar.space.cover) only the due chunks are stepped
# (space.plan): those that may hold anything in either cells, and those their
# live cells may spread into. every other chunk holds zeros in both cells with
# nothing alive near it, so its step would write the zeros it holds already,
# as the GPU skips a chunk cold for two steps, and a sparse world in a large
# grid costs what it would in a pool allocated around it.
#
# a chunk whose cells the step changed is marked space.DIRTY_CELLS, since the
# host's cells are the world's, so a GPU that only draws sends only those.
#
# where the pool keeps pyramids for a draw (space.set_pyramids), each chunk the
# draw can see while it reads them has its pyramid built from its back cells
# as it steps, across the team, so the draw sends them as they stand.
#
# a step is two halves. compute writes only the back cells, their pyramids and
# the census, so the front cells and pyramids, the page table and the dirty
# marks stay the last completed generation while it runs, and a draw may read
# them from another thread.
# commit then marks what changed, swaps the buffers and settles the pool, and
# is the only half that changes what a draw reads.
#
# compute can be cancelled part way from another thread through a stop flag,
# which every member of the team looks at before it takes another chunk. the
# back cells it wrote are left for the next compute to overwrite and the census
# is put back as the step found it, so the pool holds the last completed
# generation as if the step had never begun, and nothing is owed to commit.

use cellar.layer;
use cellar.layer.plane;
use cellar.layout;
use cellar.rule;
use cellar.rules.weighted;
use cellar.space;
use cellar.team;
use cellar.topology;
use allo: std.allocator;
use std.allocator.page;
use mem: std.memory;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# a step under way
# ---
# sp:   the pool
# r:    the rule
# gen:  the generation the pool's cells hold
# sens: how a cell is read
# list: the slots it steps, the pool's due ones, or nil for every slot
rec Round {
    sp:   *space.Space;
    r:    *rule.Rule;
    gen:  u64;
    sens: layout.Sense;
    list: *u32;
}

# the slot a step's i-th job steps
fun slot_of(rd: *Round, i: usize) usize {
    if (rd.list == nil) { ret i; }
    ret rd.list[i]::usize;
}

fun step_slot(arg: *u8, i: usize) {
    val rd: *Round       = arg::*Round;
    val sp: *space.Space = rd.sp;
    val s:  usize        = slot_of(rd, i);
    val e:  *u32         = ?sp.table[s * space.ENTRY];
    val cn: *u32         = ?sp.census[s * space.CENSUS];
    if (e[layout.INCARNATION_AT::usize] == 0 || space.seamed(sp, s)) { ret; }

    # the census as the step began says whether anything nearby is alive
    val set: *plane.Set = space.layers(sp);
    var b:   space.Block;
    space.block(?b, set, rd.gen);
    var q: usize = 0;
    for (q < 9) {
        if (e[q] != space.NONE) {
            var k: usize = 0;
            for (k < set.n) {
                b.nb[k * 9 + q] = space.plane_of(sp, k, e[q]::usize).w;
                k               = k + 1;
            }
            if (sp.before[e[q]::usize * space.CENSUS] != 0) { b.busy = true; }
        }
        q = q + 1;
    }
    var k: usize = 0;
    for (k < set.n) {
        b.out[k] = space.back_of(sp, k, s).w;
        k        = k + 1;
    }
    var t: space.Tally = space.tally(rd.sens);
    if (!b.busy && sp.before[s * space.CENSUS + 1] == 0) {
        k = 0;
        for (k < set.n) {
            plane.clear(space.block_out(?b, k));
            k = k + 1;
        }
    }
    or { rule.step_chunk(rd.r, ?b, ?t); }
    space.tally_census(?t, cn, e[layout.INCARNATION_AT::usize]);
    build(sp, s, rd.sens);
}

# build a stepped chunk's pyramid from its back cells, where the pool keeps them
fun build(sp: *space.Space, s: usize, sn: layout.Sense) {
    if (!space.builds_pyramid(sp, s)) { ret; }
    var lv: space.Lives = space.lives_of(sp, s, true);
    space.pyramid(space.back_of(sp, 0, s), sn, ?lv, ?sp.mips_back[s * space.MIP]);
}

# mark every stepped chunk DIRTY_CELLS unless its cells were all zero and stay
# so, from its census before and after the step, so only a changed chunk is
# sent to the draw again, and DIRTY_MIP where its pyramid was built with it
fun note_changes(sp: *space.Space) {
    var n: usize = sp.hi;
    if (sp.whole) { n = sp.ndue; }
    var i: usize = 0;
    for (i < n) {
        var s: usize = i;
        if (sp.whole) { s = sp.due[i]::usize; }
        val was: *u32 = ?sp.before[s * space.CENSUS];
        val now: *u32 = ?sp.census[s * space.CENSUS];
        if (space.used(sp, s) && (was[0] != 0 || was[1] != 0 || now[0] != 0 || now[1] != 0)) {
            sp.dirty[s] = sp.dirty[s] | space.DIRTY_CELLS;
            if (space.builds_pyramid(sp, s)) { sp.dirty[s] = sp.dirty[s] | space.DIRTY_MIP; }
            or                               { sp.dirty[s] = sp.dirty[s] & ~space.DIRTY_MIP; }
        }
        i = i + 1;
    }
}

# the words of a seamed chunk's block of frames under a set: 9 spans of
# each layer, gathered one chunk at a time
fun frame_words(set: *plane.Set) usize {
    var n: usize = 0;
    var k: usize = 0;
    for (k < set.n) {
        n = n + 9 * plane.span_words(set.at[k].width);
        k = k + 1;
    }
    ret n;
}

# step a seamed chunk from its block gathered into frames, frame_words long
fun step_seamed(rd: *Round, s: usize, fr: *u32) {
    val sp:   *space.Space = rd.sp;
    val set:  *plane.Set   = space.layers(sp);
    val side: i32          = space.SIDE::i32;
    val r:    i32          = rule.radius(rd.r)::i32;
    var past: [layer.LAYERS_MAX]u32;
    rule.outside(rd.r, rd.gen, ?past[0]);
    var b: space.Block;
    space.block(?b, set, rd.gen);
    var at: usize = 0;
    var k:  usize = 0;
    for (k < set.n) {
        val n: usize = plane.span_words(set.at[k].width);
        var q: usize = 0;
        for (q < 9) {
            b.nb[k * 9 + q] = ?fr[at];
            at              = at + n;
            q               = q + 1;
        }
        k = k + 1;
    }
    # every cell the family can read, up to the radius around the frame, in
    # every layer: past the dead edge a rule layer holds the edge's word's
    # value there, and a view layer zero
    k = 0;
    for (k < set.n) {
        val d:  *plane.Decl = ?set.at[k];
        var pk: u32         = 0;
        if (k < plane.exact(set)) { pk = past[k]; }
        # a word-wide layer named as such, so its cells are gathered a word each
        if (d.width == layer.WIDTH_MAX) { gather(sp, ?b, k, layer.WIDTH_MAX, s, r, pk); }
        or                              { gather(sp, ?b, k, d.width, s, r, pk); }
        b.out[k] = space.back_of(sp, k, s).w;
        k        = k + 1;
    }
    b.busy = true;
    var t: space.Tally = space.tally(rd.sens);
    rule.step_chunk(rd.r, ?b, ?t);
    val edge: u32         = sp.table[s * space.ENTRY + layout.EDGE_AT::usize];
    var u:    space.Tally = space.tally(rd.sens);
    # what the step wrote off the grid is cleared, in every layer, and the
    # state and live rule layers counted
    k = 0;
    for (k < set.n) {
        if (set.at[k].width == layer.WIDTH_MAX) { off_grid(b.out[k], layer.WIDTH_MAX, edge); }
        or                                      { off_grid(b.out[k], set.at[k].width, edge); }
        k = k + 1;
    }
    var lv: space.Lives = space.lives_of(sp, s, true);
    space.count(?u, space.block_out(?b, 0), ?lv);
    space.tally_census(?u, ?sp.census[s * space.CENSUS], space.incarnation(sp, s));
    build(sp, s, rd.sens);
}

# gather layer k of a seamed chunk's block, at its width, into the block's
# frames: every cell the family can read, up to the radius r around the frame,
# and past the dead edge the value past
#[inline]
fun gather(sp: *space.Space, b: *space.Block, k: usize, width: u32, s: usize, r: i32, past: u32) {
    val side: i32 = space.SIDE::i32;
    var y:    i32 = 0 - r;
    for (y < side + r) {
        val fy: i32 = (y + side) / side;
        var x:  i32 = 0 - r;
        for (x < side + r) {
            val fx: i32 = (x + side) / side;
            val i:  i32 = (y - (fy - 1) * side) * side + x - (fx - 1) * side;
            plane.store(b.nb[k * 9 + (fy * 3 + fx)::usize], width, i::usize, space.resolve_at(sp, k, width, s, x, y, past));
            x = x + 1;
        }
        y = y + 1;
    }
}

# zero a span's cells, of a width, that lie off the grid, by its edge word
#[inline]
fun off_grid(w: *u32, width: u32, edge: u32) {
    var i: usize = 0;
    for (i < space.CELLS) {
        if (layout.edge_side(edge, (i & 63)::i32, (i >> 6)::i32) != 4) { plane.store(w, width, i, 0); }
        i = i + 1;
    }
}

# step every seamed chunk of the pool, after the rest, until stop is raised
# ---
# ret: every seamed chunk was stepped
fun step_seams(rd: *Round, n: usize, stop: *i64) bool {
    val sp: *space.Space = rd.sp;
    var i:  usize        = 0;
    for (i < n && !(space.used(sp, slot_of(rd, i)) && space.seamed(sp, slot_of(rd, i)))) { i = i + 1; }
    if (i == n) { ret true; }
    ret step_seams_from(rd, i, n, stop);
}

# step_seams from the i-th slot, the first seamed one, so the frames are made
# only when a seamed chunk is stepped
fun step_seams_from(rd: *Round, first: usize, n: usize, stop: *i64) bool {
    val sp: *space.Space = rd.sp;
    val fr: *u32         = space.scratch(sp, frame_words(space.layers(sp)));
    # a step that cannot gather its frames is cancelled, as one stopped is
    if (fr == nil) { ret false; }
    var i: usize = first;
    for (i < n) {
        if (stop != nil && atomic.load(stop) != 0) { ret false; }
        val s: usize = slot_of(rd, i);
        if (space.used(sp, s) && space.seamed(sp, s)) { step_seamed(rd, s, fr); }
        i = i + 1;
    }
    ret true;
}

# advance the pool one generation and reshape it around the result
#
# every chunk steps into its back cells, the buffers swap, and the census the
# step wrote settles the pool, so the next generation again finds every live
# chunk surrounded.
# ---
# sp:  the pool, with back cells, whose sense is the rule's
# r:   the rule
# gen: the generation the pool's cells hold
# t:   the team to split the chunks across
# ret: false when the pool could not hold a chunk the world grew into
pub fun step(sp: *space.Space, r: *rule.Rule, gen: u64, t: *team.Team) bool {
    compute(sp, r, gen, t, nil);
    ret commit(sp);
}

# the first half of a step: every chunk steps into its back cells and writes
# its census, leaving the front cells, the page table and the dirty marks alone
# ---
# sp:   the pool, with back cells, whose sense is the rule's
# r:    the rule
# gen:  the generation the pool's cells hold
# t:    the team to split the chunks across
# stop: a flag another thread may raise to cancel the step, or nil
# ret:  the step is complete and owes commit; false when it was cancelled,
#       which leaves the pool as it was
pub fun compute(sp: *space.Space, r: *rule.Rule, gen: u64, t: *team.Team, stop: *i64) bool {
    var rd: Round;
    rd.sp   = sp;
    rd.r    = r;
    rd.gen  = gen;
    rd.sens = sp.sense;
    rd.list = nil;
    var n: usize = sp.hi;
    if (sp.whole) {
        space.plan(sp);
        rd.list = sp.due;
        n       = sp.ndue;
    }
    keep(?rd, n, sp.before, sp.census);
    var done: bool = team.run_until(t, step_slot, (?rd)::*u8, n, stop);
    if (done && topology.bounded(?sp.grid)) { done = step_seams(?rd, n, stop); }
    if (!done) {
        keep(?rd, n, sp.census, sp.before);
        # a slot stepped before the cancel may hold anything in its back cells
        var i: usize = 0;
        for (sp.whole && i < n) {
            space.wake(sp, slot_of(?rd, i));
            i = i + 1;
        }
    }
    ret done;
}

# copy the census of a step's n slots from one array to another
fun keep(rd: *Round, n: usize, to: *u32, from: *u32) {
    if (rd.list == nil) {
        mem.copy[u32](to, from, n * space.CENSUS);
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        val s: usize = rd.list[i]::usize * space.CENSUS;
        mem.copy[u32](?to[s], ?from[s], space.CENSUS);
        i = i + 1;
    }
}

# the second half of a step: the back cells compute wrote become the front, and
# the census settles the pool around them
# ---
# sp:  the pool compute stepped
# ret: false when the pool could not hold a chunk the world grew into
pub fun commit(sp: *space.Space) bool {
    note_changes(sp);
    space.swap(sp);
    val mips: *u32 = sp.mips;
    sp.mips      = sp.mips_back;
    sp.mips_back = mips;
    if (sp.whole) { space.doze(sp); }
    ret space.settle(sp, sp.census, sp.hi, true);
}

test step__a_glider_crosses_chunk_borders_and_the_pool_and_its_pyramids_follow {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   space.Space;
    val made: err[allo.Error] = space.init(?sp, ?a, true);
    if (sel made.err) { ret 1; }
    var t: team.Team;
    team.start(?t);
    var r:    rule.Rule       = rule.make[weighted.Kernel](?weighted.FAMILY, weighted.life());
    var lay:  plane.Set       = rule.layers(?r);
    val laid: err[allo.Error] = space.relayer(?sp, ?lay, nil, nil);
    if (sel laid.err) { ret 1; }
    sp.sense = rule.sense(?r);
    sp.lit   = rule.lit(?r);

    # a south-east glider just west and north of the origin's chunk corner
    val s:    usize = space.alloc(?sp, -1, -1)::usize;
    var live: [1]u32;
    rule.fresh(?r, 1, ?live[0]);
    space.put_word(?sp, s, 60 * 64 + 61, ?live[0]);
    space.put_word(?sp, s, 61 * 64 + 62, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 60, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 61, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 62, ?live[0]);
    space.recount(?sp, s);
    space.settle(?sp, sp.census, sp.hi, false);
    # a draw that reads the pyramids of the chunk at the origin alone
    val kept: err[allo.Error] = space.set_pyramids(?sp, true);
    if (sel kept.err) { ret 8; }
    var box: [4]i64;
    box[0] = 0;
    box[1] = 0;
    box[2] = 0;
    box[3] = 0;
    space.aim_pyramids(?sp, true, ?box[0]);

    # 4 generations move it one cell diagonally; after 40 it lies inside (0, 0)
    var g: usize = 0;
    for (g < 40) {
        if (!step(?sp, ?r, g::u64, ?t)) { ret 2; }
        g = g + 1;
    }
    if (space.population(?sp) != 5) { ret 3; }
    val o: u32 = space.find(?sp, 0, 0);
    if (o == space.NONE) { ret 4; }
    # the glider's cells shifted by (10, 10) from where it started
    val d: usize = o::usize;
    if (!space.live(?sp, space.sensed(?sp, d, 6 * 64 + 7)) || !space.live(?sp, space.sensed(?sp, d, 7 * 64 + 8)) || !space.live(?sp, space.sensed(?sp, d, 8 * 64 + 6))) { ret 5; }
    if (!space.live(?sp, space.sensed(?sp, d, 8 * 64 + 7)) || !space.live(?sp, space.sensed(?sp, d, 8 * 64 + 8)))                                                       { ret 6; }
    # the chunk it started in is cold and empty by now, and its far corner freed
    if (space.find(?sp, -2, -2) != space.NONE) { ret 7; }
    # the step built the pyramid it was aimed at, and only that one
    var want: [space.MIP]u32;
    var lv:   space.Lives = space.lives_of(?sp, d, false);
    space.pyramid(space.plane_of(?sp, 0, d), sp.sense, ?lv, ?want[0]);
    if (!mem.equal[u32](?want[0], ?sp.mips[o::usize * space.MIP], space.MIP)) { ret 9; }
    if ((sp.dirty[o::usize] & space.DIRTY_MIP) == 0)                          { ret 10; }
    val w: u32 = space.find(?sp, -1, -1);
    if (w == space.NONE || (sp.dirty[w::usize] & space.DIRTY_MIP) != 0) { ret 11; }
    team.stop(?t);
    space.dnit(?sp);
    ret 0;
}

test step__a_glider_on_a_grid_held_whole_steps_only_the_chunks_near_it {
    var a: allo.Allocator;
    page.make(?a);
    var sp:   space.Space;
    val made: err[allo.Error] = space.init(?sp, ?a, true);
    if (sel made.err) { ret 1; }
    var t: team.Team;
    team.start(?t);
    var r:    rule.Rule       = rule.make[weighted.Kernel](?weighted.FAMILY, weighted.life());
    var lay:  plane.Set       = rule.layers(?r);
    val laid: err[allo.Error] = space.relayer(?sp, ?lay, nil, nil);
    if (sel laid.err) { ret 1; }
    sp.sense = rule.sense(?r);
    sp.lit   = rule.lit(?r);
    # a 1024 by 1024 torus is held whole, 16 by 16 chunks
    val g: res[topology.Grid, str] = topology.parse("T1024,1024");
    if (sel g.err) { ret 2; }
    space.set_grid(?sp, g.ok);
    if (!sp.whole || sp.live != 256) { ret 3; }
    # a south-east glider just west and north of the origin's chunk corner
    val s:    usize = space.find(?sp, -1, -1)::usize;
    var live: [1]u32;
    rule.fresh(?r, 1, ?live[0]);
    space.put_word(?sp, s, 60 * 64 + 61, ?live[0]);
    space.put_word(?sp, s, 61 * 64 + 62, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 60, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 61, ?live[0]);
    space.put_word(?sp, s, 62 * 64 + 62, ?live[0]);
    space.recount(?sp, s);
    # it never spans more than 2 by 2 chunks, whose ring is 4 by 4
    var n: usize = 0;
    for (n < 40) {
        if (!step(?sp, ?r, n::u64, ?t)) { ret 4; }
        if (sp.ndue > 16)               { ret 5; }
        n = n + 1;
    }
    if (space.population(?sp) != 5 || sp.live != 256) { ret 6; }
    val d: usize = space.find(?sp, 0, 0)::usize;
    if (!space.live(?sp, space.sensed(?sp, d, 6 * 64 + 7)) || !space.live(?sp, space.sensed(?sp, d, 7 * 64 + 8)) || !space.live(?sp, space.sensed(?sp, d, 8 * 64 + 6))) { ret 7; }
    if (!space.live(?sp, space.sensed(?sp, d, 8 * 64 + 7)) || !space.live(?sp, space.sensed(?sp, d, 8 * 64 + 8)))                                                       { ret 8; }
    team.stop(?t);
    space.dnit(?sp);
    ret 0;
}
