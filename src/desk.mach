# the interface around the world: the toolbar across the top, the docks at the
# sides and the panels in them, and what they leave of the window for the world

use blit;
use bctx: blit.context;
use binp: blit.input;
use cellar.app;
use cellar.bounds;
use cellar.format;
use cellar.gesture;
use cellar.look;
use cellar.pages;
use cellar.panel;
use cellar.paths;
use cellar.render;
use cellar.sim;
use cellar.sketch;
use cellar.toolbar;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# draw the toolbar, the docks and the panels, and apply their controls; call
# at the interface's root, first in the frame. while Tab hides the interface
# none of them is drawn and the world takes the whole window
# ---
# ui:  the interface, its frame begun
# sc:  what the panels draw from
# ret: the world's port, what the toolbar and the docks leave of the window
pub fun draw(ui: *bctx.Context, sc: *panel.Scene) render.Port {
    if (sc.a.panel != 0) { toolbar.draw(ui, sc.l, sc.a, sc.s); }
    val pt: render.Port = panel.docks(ui, sc.a);
    panel.draw(ui, sc);
    ret pt;
}

# what the desk test draws
#[testing]
rec Probe {
    sc: panel.Scene;
    p:  paths.Paths;
    sk: sketch.Sketches;
    pt: render.Port;
}

#[testing]
fun probe_ui(ui: *bctx.Context, user: ptr) {
    val pr: *Probe = user::*Probe;
    pr.pt = draw(ui, ?pr.sc);
}

# drop the central node from a kept layout of n bytes in place; ret its new
# length
#[testing]
fun uncentred(doc: *u8, n: usize) usize {
    val key: str   = "central = ";
    var o:   usize = 0;
    var i:   usize = 0;
    for (i < n) {
        var j: usize = 0;
        for (key[j] != 0 && i + j < n && doc[i + j] == key[j]) { j = j + 1; }
        if (key[j] == 0) {
            for (i < n && doc[i] != '\n') { i = i + 1; }
            i = i + 1;
            cnt;
        }
        for (i < n && doc[i] != '\n') {
            doc[o] = doc[i];
            o      = o + 1;
            i      = i + 1;
        }
        if (i < n) {
            doc[o] = '\n';
            o      = o + 1;
            i      = i + 1;
        }
    }
    ret o;
}

test draw__every_panel_draws_and_its_controls_act {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var s:  sim.Sim;
    val sm: err[allo.Error] = sim.init(?s, ?al);
    if (sel sm.err) { ret 1; }
    var a: app.App;
    app.init(?a);
    val at: err[format.Error] = app.attach(?a, ?al);
    if (sel at.err) { ret 1; }
    var shown: world.Shown;
    world.observe(?s, ?shown);

    var pr: Probe;
    pr.p.ok  = false;
    pr.sc.a  = ?a;
    pr.sc.s  = ?shown;
    pr.sc.p  = ?pr.p;
    pr.sc.sk = ?pr.sk;
    sketch.init(?pr.sk, ?al, nil);
    var d:  blit.driver.Driver;
    val di: err[allo.Error] = blit.driver.init(?d, ?al, 1280.0, 800.0, probe_ui, (?pr)::ptr);
    if (sel di.err) { ret 1; }
    val l: opt[look.Look] = look.apply(?d.ctx);
    if (sel l.none) { ret 2; }
    pr.sc.l = l.some;
    val pe: err[blit.state.Error] = panel.persist(?d.ctx);
    if (sel pe.err) { ret 2; }

    # the default layout: the panels at the sides of the world below the
    # toolbar, every panel keyed apart from the rest
    blit.driver.steps(?d, 3);
    if (bctx.collisions(?d.ctx) != 0)                                { ret 3; }
    if (pr.pt.x0 <= 0.0 || pr.pt.y0 <= 0.0)                          { ret 4; }
    if (pr.pt.x0 + pr.pt.w >= 1280.0 || pr.pt.y0 + pr.pt.h != 800.0) { ret 5; }
    if (panel.shown(?d.ctx, panel.SETTINGS))                         { ret 6; }

    if (!blit.driver.click(?d, blit.driver.find(?d, "toolbar/Step"))) { ret 7; }
    if (a.queue.items.len != 1)                                       { ret 8; }
    if (!sel a.queue.items.data[0].step)                              { ret 9; }

    # a rule string no family reads keeps the keyboard, to be put right
    val field: u64 = blit.driver.find(?d, "Rule/rule string");
    if (!blit.driver.click(?d, field)) { ret 10; }
    blit.driver.type_text(?d, "x");
    blit.driver.key(?d, binp.KEY_ENTER, 0);
    blit.driver.step(?d);
    if (!blit.driver.focused(?d, field) || a.rule_text.error == nil) { ret 11; }
    bctx.unfocus(?d.ctx);

    # every panel draws, floating, the settings too
    var i: usize = 0;
    for (i < panel.COUNT) {
        blit.dock.remove(?d.ctx, panel.id(i));
        panel.show(?d.ctx, ?a, i, true);
        i = i + 1;
    }
    blit.driver.steps(?d, 2);
    if (bctx.collisions(?d.ctx) != 0) { ret 12; }

    # closing every panel gives the world the window below the toolbar, and a
    # reset brings the default layout back
    i = 0;
    for (i < panel.COUNT) {
        panel.show(?d.ctx, ?a, i, false);
        i = i + 1;
    }
    blit.driver.steps(?d, 2);
    if (pr.pt.x0 != 0.0 || pr.pt.w != 1280.0) { ret 13; }
    a.relayout = true;
    blit.driver.steps(?d, 2);
    if (pr.pt.x0 <= 0.0 || panel.shown(?d.ctx, panel.SETTINGS) || !panel.shown(?d.ctx, panel.RULE)) { ret 14; }

    # hiding the interface gives the world the whole window, the toolbar too,
    # and showing it again brings the world back to where it was
    val home: f32 = pr.pt.x0;
    a.panel = 0;
    blit.driver.steps(?d, 2);
    if (pr.pt.x0 != 0.0 || pr.pt.y0 != 0.0 || pr.pt.w != 1280.0 || pr.pt.h != 800.0) { ret 25; }
    a.panel = 1;
    blit.driver.steps(?d, 2);
    if (pr.pt.x0 != home || pr.pt.y0 <= 0.0) { ret 27; }

    # the left side widens by its splitter, the world giving way
    val x0: f32 = pr.pt.x0;
    val my: f32 = pr.pt.y0 + pr.pt.h / 2.0;
    if (!blit.driver.drag(?d, blit.driver.at(?d, x0 - 2.0, my), x0 + 100.0, my)) { ret 20; }
    blit.driver.steps(?d, 2);
    val wide: f32 = pr.pt.x0;
    if (wide < x0 + 90.0) { ret 21; }

    # the layout the settings keep comes back in a new interface, its sizes
    # with it and the rule panel closed as it was left
    panel.show(?d.ctx, ?a, panel.RULE, false);
    blit.driver.step(?d);
    panel.keep(?d.ctx, ?a);
    if (a.layout.len == 0 || a.layout.len > 8192) { ret 15; }
    var kept:   [8192]u8;
    val kept_n: usize = a.layout.len - 1;
    var k:      usize = 0;
    for (k < kept_n) {
        kept[k] = a.layout.data[k];
        k       = k + 1;
    }
    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    var e:  blit.driver.Driver;
    val ei: err[allo.Error] = blit.driver.init(?e, ?al, 1280.0, 800.0, probe_ui, (?pr)::ptr);
    if (sel ei.err) { ret 1; }
    look.apply(?e.ctx);
    val pe2: err[blit.state.Error] = panel.persist(?e.ctx);
    if (sel pe2.err) { ret 16; }
    panel.restore(?e.ctx, ?a);
    if (a.relayout) { ret 17; }
    blit.driver.steps(?e, 3);
    if (panel.shown(?e.ctx, panel.RULE) || !panel.shown(?e.ctx, panel.STATS) || pr.pt.x0 != wide) { ret 18; }
    # a layout that does not read gives the default one
    val bad: str = "[dock.1]\nroot = \"x\n";
    app.keep_layout(?a, bad::*u8, string.str_len(bad));
    panel.restore(?e.ctx, ?a);
    if (!a.relayout) { ret 19; }
    val freed2: err[allo.Error] = blit.driver.free(?e);
    if (sel freed2.err) { ret 1; }

    # and so does one whose space has no central node for the world
    app.keep_layout(?a, ?kept[0], uncentred(?kept[0], kept_n));
    var f:  blit.driver.Driver;
    val fi: err[allo.Error] = blit.driver.init(?f, ?al, 1280.0, 800.0, probe_ui, (?pr)::ptr);
    if (sel fi.err) { ret 1; }
    look.apply(?f.ctx);
    val pe3: err[blit.state.Error] = panel.persist(?f.ctx);
    if (sel pe3.err) { ret 22; }
    panel.restore(?f.ctx, ?a);
    if (!a.relayout) { ret 23; }
    blit.driver.steps(?f, 3);
    if (pr.pt.x0 <= 0.0 || pr.pt.x0 + pr.pt.w >= 1280.0 || !panel.shown(?f.ctx, panel.RULE)) { ret 24; }
    val freed3: err[allo.Error] = blit.driver.free(?f);
    if (sel freed3.err) { ret 1; }
    app.dnit(?a);
    sim.dnit(?s);
    ret 0;
}

# a probe of the desk with the world panel in front, in a window tall enough
# to show all of it; ret 0, or the step that failed
#[testing]
fun world_front(d: *blit.driver.Driver, al: *allo.Allocator, pr: *Probe) i32 {
    val di: err[allo.Error] = blit.driver.init(d, al, 1280.0, 1600.0, probe_ui, pr::ptr);
    if (sel di.err) { ret 1; }
    val l: opt[look.Look] = look.apply(?d.ctx);
    if (sel l.none) { ret 1; }
    pr.sc.l = l.some;
    val pe: err[blit.state.Error] = panel.persist(?d.ctx);
    if (sel pe.err) { ret 1; }
    blit.driver.steps(d, 2);
    blit.dock.select(?d.ctx, panel.id(panel.WORLD));
    blit.driver.steps(d, 2);
    ret 0;
}

# click a control by its path; ret whether it took the click
#[testing]
fun press(d: *blit.driver.Driver, path: str) bool {
    val id: u64 = blit.driver.find(d, path);
    if (!blit.driver.drawn(d, id)) { ret false; }
    val ok: bool = blit.driver.click(d, id);
    blit.driver.steps(d, 2);
    ret ok;
}

test draw__the_boundary_and_wall_choices_are_apart_and_each_shows_its_own {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var s:  sim.Sim;
    val sm: err[allo.Error] = sim.init(?s, ?al);
    if (sel sm.err) { ret 1; }
    var a: app.App;
    app.init(?a);
    val at: err[format.Error] = app.attach(?a, ?al);
    if (sel at.err) { ret 1; }
    var shown: world.Shown;
    world.observe(?s, ?shown);
    var pr: Probe;
    pr.p.ok  = false;
    pr.sc.a  = ?a;
    pr.sc.s  = ?shown;
    pr.sc.p  = ?pr.p;
    pr.sc.sk = ?pr.sk;
    sketch.init(?pr.sk, ?al, nil);
    # a selection shows its operations, whose clear is not the world's
    a.selected = true;
    var d: blit.driver.Driver;
    if (world_front(?d, ?al, ?pr) != 0) { ret 1; }

    # every control of the world panel is keyed apart, and with the draw tool
    # neither shape tool's choice is in effect
    if (bctx.collisions(?d.ctx) != 0)                                               { ret 2; }
    if (bounds.lit(?a) != gesture.COUNT + 1 || pages.wall_lit(?a) != gesture.COUNT) { ret 3; }

    # a boundary gesture takes the bounds tool up and leaves the walls' alone
    if (!press(?d, "World/boundary/Ellipse"))                                       { ret 4; }
    if (a.tool != app.TOOL_BOUNDS || a.shape.kind != gesture.ELLIPSE || a.choosing) { ret 5; }
    if (bounds.lit(?a) != gesture.ELLIPSE || pages.wall_lit(?a) != gesture.COUNT)   { ret 6; }

    # a wall gesture takes the wall tool up, and the boundary's shows none
    if (!press(?d, "World/walls/Polygon"))                                            { ret 7; }
    if (a.tool != app.TOOL_WALL || a.walls.kind != gesture.POLYGON)                   { ret 8; }
    if (a.shape.kind != gesture.ELLIPSE)                                              { ret 9; }
    if (bounds.lit(?a) != gesture.COUNT + 1 || pages.wall_lit(?a) != gesture.POLYGON) { ret 10; }

    # switching within each group moves its own choice and no other
    if (!press(?d, "World/boundary/Freehand"))                                     { ret 11; }
    if (a.shape.kind != gesture.FREEHAND || a.walls.kind != gesture.POLYGON)       { ret 12; }
    if (!press(?d, "World/boundary/Pick a region"))                                { ret 13; }
    if (!a.choosing || bounds.lit(?a) != gesture.COUNT)                            { ret 14; }
    if (!press(?d, "World/walls/Rectangle"))                                       { ret 15; }
    if (a.walls.kind != gesture.RECT || a.shape.kind != gesture.FREEHAND)          { ret 16; }
    if (pages.wall_lit(?a) != gesture.RECT || bounds.lit(?a) != gesture.COUNT + 1) { ret 17; }
    if (bctx.collisions(?d.ctx) != 0)                                              { ret 18; }

    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    app.dnit(?a);
    sim.dnit(?s);
    ret 0;
}

test draw__a_tool_taken_up_by_key_brings_its_controls_into_view {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var s:  sim.Sim;
    val sm: err[allo.Error] = sim.init(?s, ?al);
    if (sel sm.err) { ret 1; }
    var a: app.App;
    app.init(?a);
    val at: err[format.Error] = app.attach(?a, ?al);
    if (sel at.err) { ret 1; }
    var shown: world.Shown;
    world.observe(?s, ?shown);
    var pr: Probe;
    pr.p.ok  = false;
    pr.sc.a  = ?a;
    pr.sc.s  = ?shown;
    pr.sc.p  = ?pr.p;
    pr.sc.sk = ?pr.sk;
    sketch.init(?pr.sk, ?al, nil);
    var d:  blit.driver.Driver;
    val di: err[allo.Error] = blit.driver.init(?d, ?al, 1280.0, 800.0, probe_ui, (?pr)::ptr);
    if (sel di.err) { ret 1; }
    val l: opt[look.Look] = look.apply(?d.ctx);
    if (sel l.none) { ret 1; }
    pr.sc.l = l.some;
    val pe: err[blit.state.Error] = panel.persist(?d.ctx);
    if (sel pe.err) { ret 1; }
    blit.driver.steps(?d, 3);

    # the rule panel is in front, and the walls fold away
    if (blit.driver.drawn(?d, blit.driver.find(?d, "World/walls/Rectangle"))) { ret 2; }
    a.world_open[app.SECTION_WALLS] = 0;

    # the wall tool's key brings the world panel to the front, the walls open
    # and in view at its top
    app.pick_tool(?a, app.TOOL_WALL);
    blit.driver.steps(?d, 2);
    blit.driver.settle(?d);
    if (a.world_open[app.SECTION_WALLS] == 0 || a.reveal != app.WORLD_SECTIONS) { ret 3; }
    val wall: opt[bctx.Area] = blit.driver.rect(?d, blit.driver.find(?d, "World/walls/Rectangle"));
    if (sel wall.none)        { ret 4; }
    if (wall.some.y0 > 300.0) { ret 5; }

    # a tool taken up in the panel leaves it where it is
    val off: f32 = blit.state.get[blit.widget.Scroll](?d.ctx, blit.id.child(panel.id(panel.WORLD), "#body")).offset;
    if (!press(?d, "World/walls/Ellipse")) { ret 6; }
    blit.driver.steps(?d, 2);
    if (blit.state.get[blit.widget.Scroll](?d.ctx, blit.id.child(panel.id(panel.WORLD), "#body")).offset != off) { ret 7; }

    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    app.dnit(?a);
    sim.dnit(?s);
    ret 0;
}
