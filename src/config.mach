# interface settings and the active rule, kept between runs
#
# they are a fixed-order line of integers in the data directory, then a line
# naming the selected pattern, then a line naming the rule. every value on the
# first line is a decimal integer, fractional fields scaled (speed x10, colours
# x255), so one integer formatter and one whitespace tokenizer cover it, with
# no float parsing. the world is not part of settings; the files section saves
# it.
#
# the selected pattern is named "library <name>" or "custom", so a library that
# grows or reorders keeps the selection. its old slot in the first line is
# written as 0 and skipped. the rule is "<family> <rule string>": its rule
# family's id and its rule string, as the family writes it.
#
# older versions are still read. versions 1 to 3 kept the rule as a weighted
# kernel's integers inside the first line, weights signed or, before that,
# wrapped. versions 1 and 2, what 0.3.0 and 0.4.0 wrote, kept the index of one
# of seven built-ins in the pattern slot, which is read through the names those
# built-ins have in the library, and version 1 has no window positions.
# version 3 added the selection line, version 4 the rule line, version 5 the
# engine line, and version 6 the ceilings line.
#
# the engine line is "<engine> <exponent>" after the rule line: the engine
# chosen, cpu, gpu or hashlife, and HashLife's step exponent. a file without it
# keeps the defaults. the engine is what the panel chose, which a command-line
# --engine overrides for that run only, so a run that names one saves the choice
# the file held until the panel changes it. cpu and gpu both mean the chunk
# pool, the GPU stepping it where it can unless cpu is saved. a saved hashlife
# whose rule HashLife cannot run is run on the chunk pool, with a message.
#
# the ceilings line follows it: for each ceiling in cellar.ceiling's order, 1
# or 0 for on or off, then its limit. a file without it keeps the defaults, and
# `cellar run` reads it alone (load_ceilings).

use cellar.app;
use cellar.ceiling;
use cellar.format;
use cellar.hashlife;
use cellar.library;
use cellar.persist;
use cellar.rule;
use cellar.rules.weighted;
use cellar.sim;
use cellar.text;
use cellar.theme;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# settings-format version written; versions 1 to 5 are still read
val VERSION: u64 = 6;
# the last version that kept the rule as a weighted kernel's integers
val KERNEL_INTS: usize = 3;
# the first version with the selection line
val SEL_LINE: usize = 3;
# the first version with the engine line
val ENGINE_LINE: usize = 5;
# the first version with the ceilings line
val CEILING_LINE: usize = 6;

# the engine line's words for the engine chosen
val ENGINE_CPU:      str = "cpu";
val ENGINE_GPU:      str = "gpu";
val ENGINE_HASHLIFE: str = "hashlife";

# the second line's selection of the custom pattern
val SEL_CUSTOM: str = "custom";
# the second line's prefix before a library pattern's name
val SEL_LIBRARY: str = "library ";

# the library name of the i-th built-in a version 1 or 2 file selected by
# index, CUSTOM's old index 7 giving "" and any other index the glider
fun old_builtin(i: usize) str {
    if (i == 1) { ret "Blinker"; }
    if (i == 2) { ret "Block"; }
    if (i == 3) { ret "Beehive"; }
    if (i == 4) { ret "Lightweight spaceship"; }
    if (i == 5) { ret "Pulsar"; }
    if (i == 6) { ret "Gosper glider gun"; }
    if (i == 7) { ret ""; }
    ret "Glider";
}

# select what a version 1 or 2 file's pattern index named
fun migrate_sel(ap: *app.App, i: usize) {
    val name: str = old_builtin(i);
    if (name[0] == 0) { app.choose(ap, app.CUSTOM); }
    or                { app.choose_named(ap, name); }
}

# whether s starts with prefix
fun starts(s: str, prefix: str) bool {
    var i: usize = 0;
    for (prefix[i] != 0) {
        if (s[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# select what a selection line names; anything unknown selects the default
fun read_sel(ap: *app.App, b: *Vector[u8], pos: usize) {
    var o: usize = pos;
    for (o < b.len && b.data[o] != '\n') { o = o + 1; }
    o = o + 1;
    var line: [256]u8;
    var n:    usize = 0;
    for (o < b.len && n < 255 && b.data[o] != '\n' && b.data[o] != '\r') {
        line[n] = b.data[o];
        n       = n + 1;
        o       = o + 1;
    }
    line[n] = 0;
    val l: str = ?line[0];
    if (string.str_equals(l, SEL_CUSTOM)) { app.choose(ap, app.CUSTOM); }
    or (starts(l, SEL_LIBRARY))           { app.choose_named(ap, ?line[string.str_len(SEL_LIBRARY)]); }
    or                                    { app.choose_default(ap); }
}

# the engine line's word for the engine ap chose
fun engine_word(ap: *app.App) str {
    if (ap.engine_tree) { ret ENGINE_HASHLIFE; }
    if (ap.engine_cpu)  { ret ENGINE_CPU; }
    ret ENGINE_GPU;
}

# buffer size for the serialized settings, ample for the integers, the
# selection and the longest rule string
val CAP: usize = rule.FORMAT_MAX + 4096;

# append v's decimal digits and a separating space to buf at off; ret the new
# offset.
fun wr(buf: *u8, off: usize, v: u64) usize {
    var o: usize = text.buf_u64(buf, off, v);
    buf[o] = ' ';
    ret o + 1;
}

# append v as signed decimal and a separating space to buf at off
fun wr_int(buf: *u8, off: usize, v: i64) usize {
    var o: usize = text.buf_i64(buf, off, v);
    buf[o] = ' ';
    ret o + 1;
}

# a stored flag as 0 or 1
fun bit(v: usize) u8 {
    if (v != 0) { ret 1; }
    ret 0;
}

# a stored colour channel clamped to a byte
fun byte(v: usize) u32 {
    if (v > 255) { ret 255; }
    ret v::u32;
}

# skip non-digits from pos, parse a run of digits, advance pos past
# them, and return the value (0 at end of input).
fun read_uint(b: *Vector[u8], pos: *usize) usize {
    var o: usize = @pos;
    for (o < b.len && (b.data[o] < '0' || b.data[o] > '9')) { o = o + 1; }
    var v: usize = 0;
    for (text.byte_at(b.data, b.len, o) >= '0' && text.byte_at(b.data, b.len, o) <= '9') {
        v = v * 10 + (b.data[o] - '0')::usize;
        o = o + 1;
    }
    @pos = o;
    ret v;
}

# skip to a number, parse it with an optional leading minus, advance pos past
# it, and return the value (0 at end of input). a weight written as a wrapped
# u64 by older versions parses as a large positive value and narrows to the
# same i32.
fun read_int(b: *Vector[u8], pos: *usize) i64 {
    var o: usize = @pos;
    for (o < b.len && (b.data[o] < '0' || b.data[o] > '9') && b.data[o] != '-') { o = o + 1; }
    var neg: bool = false;
    if (text.byte_at(b.data, b.len, o) == '-') {
        neg = true;
        o   = o + 1;
    }
    @pos = o;
    val v: i64 = read_uint(b, pos)::i64;
    if (neg) { ret 0 - v; }
    ret v;
}

# write the current settings and rule to path
# ---
# a:   allocator backing the transient buffer
# ap:  application state to serialize
# s:   simulation whose rule is serialized
# ret: ok, or why the settings were not written
pub fun save(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) err[persist.Error] {
    val made: err[fs.FsError] = persist.make_parent(a, path);
    if (sel made.err) { ret err[persist.Error].err{persist.Error.fs{made.err}}; }

    val rc: res[*u8, allo.Error] = allo.allocate[u8](a, CAP);
    if (sel rc.err) { ret err[persist.Error].err{persist.Error.alloc{rc.err}}; }
    val buf: *u8 = rc.ok;

    var o: usize = 0;
    o      = wr(buf, o, VERSION);
    o      = wr(buf, o, (ap.speed * 10.0)::u64);
    o      = wr(buf, o, ap.mode::u64);
    o      = wr(buf, o, ap.gutter::u64);
    o      = wr(buf, o, ap.uncapped::u64);
    o      = wr(buf, o, (ap.tool == app.TOOL_ERASE)::u64);
    o      = wr(buf, o, ap.bounds_idx::u64);
    o      = wr(buf, o, (ap.tool == app.TOOL_STAMP)::u64);
    o      = wr(buf, o, 0);
    o      = wr(buf, o, theme.red(ap.solid)::u64);
    o      = wr(buf, o, theme.green(ap.solid)::u64);
    o      = wr(buf, o, theme.blue(ap.solid)::u64);
    o      = wr(buf, o, ap.panel::u64);
    o      = wr(buf, o, ap.open_run::u64);
    o      = wr(buf, o, ap.open_draw::u64);
    o      = wr(buf, o, ap.open_rule::u64);
    o      = wr(buf, o, ap.open_view::u64);
    o      = wr(buf, o, ap.open_files::u64);
    o      = wr(buf, o, ap.scale_idx::u64);
    buf[o] = '\n';
    o      = o + 1;
    if (ap.pattern_sel >= library.count(?ap.library)) { o = text.buf_str(buf, o, SEL_CUSTOM); }
    or {
        o = text.buf_str(buf, o, SEL_LIBRARY);
        o = text.buf_str(buf, o, library.name(?ap.library, ap.pattern_sel));
    }
    buf[o] = '\n';
    o      = text.buf_str(buf, o + 1, rule.family_id(rule.family_of(?s.rule)));
    buf[o] = ' ';
    var rb: [rule.FORMAT_MAX + 1]u8;
    o      = text.buf_str(buf, o + 1, rule.format(?s.rule, ?rb[0]));
    buf[o] = '\n';
    o      = text.buf_str(buf, o + 1, engine_word(ap));
    buf[o] = ' ';
    o      = text.buf_u64(buf, o + 1, sim.exponent(s)::u64);
    buf[o] = '\n';
    o      = o + 1;
    var c: ceiling.Ceilings = sim.ceilings(s);
    var k: usize            = 0;
    for (k < ceiling.COUNT) {
        o = wr(buf, o, c.on[k]::u64);
        o = wr(buf, o, c.limit[k]);
        k = k + 1;
    }
    buf[o - 1] = '\n';

    val wrote: err[fs.FsError] = fs.write_bytes(path, buf, o, persist.FILE_MODE);
    allo.deallocate[u8](a, buf, CAP);
    if (sel wrote.err) { ret err[persist.Error].err{persist.Error.fs{wrote.err}}; }
    ret err[persist.Error].ok{};
}

# read settings from path into ap and s's rule, if the file exists and its
# version is known. a missing file leaves the defaults untouched, and a rule
# this version cannot run leaves the rule as it was.
# ---
# a:   allocator for the read buffer
# ap:  application state to populate
# s:   simulation whose rule is populated
# ret: ok when loaded or absent, or why the file was refused
pub fun load(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) err[persist.Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) {
        if (sel rr.err.io && rr.err.io.kind == io_error.NOT_FOUND) { ret err[persist.Error].ok{}; }
        ret err[persist.Error].err{persist.Error.fs{rr.err}};
    }
    var data: Vector[u8] = rr.ok;

    var p:       usize = 0;
    val version: usize = read_uint(?data, ?p);
    if (version < 1 || version > VERSION::usize) {
        vector.dnit[u8](?data);
        ret err[persist.Error].err{persist.Error.version{}};
    }
    # the integers end with the first line
    val full: usize = data.len;
    var nl:   usize = 0;
    for (nl < full && data.data[nl] != '\n') { nl = nl + 1; }
    if (version > KERNEL_INTS) { data.len = nl; }

    ap.speed = read_uint(?data, ?p)::f32 / 10.0;
    if (ap.speed < 1.0)   { ap.speed = 1.0; }
    if (ap.speed > 120.0) { ap.speed = 120.0; }
    ap.mode = read_uint(?data, ?p);
    if (ap.mode >= app.MODE_COUNT) { ap.mode = 0; }
    ap.gutter   = bit(read_uint(?data, ?p));
    ap.uncapped = bit(read_uint(?data, ?p));
    val erase: usize = read_uint(?data, ?p);
    ap.bounds_idx = read_uint(?data, ?p);
    if (ap.bounds_idx >= app.BOUNDS_COUNT) { ap.bounds_idx = app.DEFAULT_BOUNDS; }
    val stamp: usize = read_uint(?data, ?p);
    ap.tool = app.TOOL_DRAW;
    if (erase != 0) { ap.tool = app.TOOL_ERASE; }
    if (stamp != 0) { ap.tool = app.TOOL_STAMP; }
    val old_sel: usize = read_uint(?data, ?p);
    if (version < SEL_LINE) { migrate_sel(ap, old_sel); }
    val cr: u32 = byte(read_uint(?data, ?p));
    val cg: u32 = byte(read_uint(?data, ?p));
    val cb: u32 = byte(read_uint(?data, ?p));
    ap.solid = (cr << 16) | (cg << 8) | cb;

    if (version <= KERNEL_INTS) { sim.set_rule(s, rule.of(rule.Kind.weighted{read_kernel(?data, ?p)})); }

    if (version >= 2) {
        ap.panel      = bit(read_uint(?data, ?p));
        ap.open_run   = bit(read_uint(?data, ?p));
        ap.open_draw  = bit(read_uint(?data, ?p));
        ap.open_rule  = bit(read_uint(?data, ?p));
        ap.open_view  = bit(read_uint(?data, ?p));
        ap.open_files = bit(read_uint(?data, ?p));
        ap.scale_idx  = read_uint(?data, ?p);
        if (ap.scale_idx >= app.SCALE_COUNT) { ap.scale_idx = 0; }
    }
    data.len = full;
    if (version >= SEL_LINE) { read_sel(ap, ?data, p); }
    if (version > KERNEL_INTS) {
        # the rule is the line after the selection
        var at: usize = nl + 1;
        for (at < full && data.data[at] != '\n') { at = at + 1; }
        if (at < full) { read_rule(?data, at + 1, s); }
        if (version >= ENGINE_LINE) {
            # the engine is the line after the rule
            at = at + 1;
            for (at < full && data.data[at] != '\n') { at = at + 1; }
            if (at < full) { read_engine(?data, at + 1, ap, s); }
        }
        if (version >= CEILING_LINE) {
            # the ceilings are the line after the engine
            at = at + 1;
            for (at < full && data.data[at] != '\n') { at = at + 1; }
            if (at < full) {
                var c: ceiling.Ceilings = sim.ceilings(s);
                read_ceilings(?data, at + 1, ?c);
                sim.set_ceilings(s, c);
            }
        }
    }
    vector.dnit[u8](?data);
    ret err[persist.Error].ok{};
}

# the widest kernel versions 1 to 3 kept, and the weights they wrote for it
val OLD_RADIUS:  usize = 4;
val OLD_WEIGHTS: usize = 81;

# read the weighted kernel versions 1 to 3 kept as integers: its radius, its
# birth and survive masks, saturating at 63, and 81 weights, those past its
# footprint unused
fun read_kernel(b: *Vector[u8], p: *usize) weighted.Kernel {
    var k: weighted.Kernel;
    var r: usize = read_uint(b, p);
    if (r < 1)          { r = 1; }
    if (r > OLD_RADIUS) { r = OLD_RADIUS; }
    k.radius  = r;
    k.birth   = weighted.legacy_sums(read_uint(b, p)::u64);
    k.survive = weighted.legacy_sums(read_uint(b, p)::u64);
    val n: usize = (2 * r + 1) * (2 * r + 1);
    var i: usize = 0;
    for (i < OLD_WEIGHTS) {
        val w: i32 = read_int(b, p)::i32;
        if (i < n) { k.weights[i] = w; }
        i = i + 1;
    }
    ret k;
}

# read the engine line, "<engine> <exponent>", into ap and s's step exponent; a
# word it does not know keeps the default engine
# ---
# b:  the file
# at: where the line starts
# ap: application state
# s:  the simulation
fun read_engine(b: *Vector[u8], at: usize, ap: *app.App, s: *sim.Sim) {
    var word: [16]u8;
    var n:    usize = 0;
    var o:    usize = at;
    for (o < b.len && b.data[o] != ' ' && b.data[o] != '\n' && b.data[o] != '\r') {
        if (n < 15) { word[n] = b.data[o]; }
        n = n + 1;
        o = o + 1;
    }
    if (n > 15) { ret; }
    word[n] = 0;
    val w: str = ?word[0];
    ap.engine_tree = false;
    ap.engine_cpu  = false;
    if (string.str_equals(w, ENGINE_HASHLIFE)) { ap.engine_tree = true; }
    or (string.str_equals(w, ENGINE_CPU))      { ap.engine_cpu = true; }
    var p: usize = o;
    var k: usize = read_uint(b, ?p);
    if (k > hashlife.MAX_EXPONENT::usize) { k = hashlife.MAX_EXPONENT::usize; }
    sim.set_exponent(s, k::u32);
}

# read the ceilings line, an on flag and a limit per ceiling, into c
# ---
# b:  the file
# at: where the line starts
# c:  the ceilings, each one the line holds replaced
fun read_ceilings(b: *Vector[u8], at: usize, c: *ceiling.Ceilings) {
    val full: usize = b.len;
    var end:  usize = at;
    for (end < full && b.data[end] != '\n') { end = end + 1; }
    b.len = end;
    var p: usize = at;
    var k: usize = 0;
    for (k < ceiling.COUNT && p < end) {
        val on:    usize = read_uint(b, ?p);
        val limit: usize = read_uint(b, ?p);
        c.on[k]    = bit(on) != 0;
        c.limit[k] = limit::u64;
        k          = k + 1;
    }
    b.len = full;
}

# read the ceilings the settings at path keep into c, leaving c as it is when
# the file is missing or older than its ceilings line
# ---
# a:    allocator for the read buffer
# path: the settings file
# c:    the ceilings
# ret:  ok when read or absent, or why the file was refused
pub fun load_ceilings(a: *allo.Allocator, path: str, c: *ceiling.Ceilings) err[persist.Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) {
        if (sel rr.err.io && rr.err.io.kind == io_error.NOT_FOUND) { ret err[persist.Error].ok{}; }
        ret err[persist.Error].err{persist.Error.fs{rr.err}};
    }
    var data:    Vector[u8] = rr.ok;
    var p:       usize      = 0;
    val version: usize      = read_uint(?data, ?p);
    if (version < 1 || version > VERSION::usize) {
        vector.dnit[u8](?data);
        ret err[persist.Error].err{persist.Error.version{}};
    }
    if (version >= CEILING_LINE) {
        # the integers, the selection, the rule and the engine come first
        var at:    usize = 0;
        var lines: usize = 0;
        for (at < data.len && lines < 4) {
            if (data.data[at] == '\n') { lines = lines + 1; }
            at = at + 1;
        }
        if (lines == 4) { read_ceilings(?data, at, c); }
    }
    vector.dnit[u8](?data);
    ret err[persist.Error].ok{};
}

# read the rule line, "<family> <rule string>", into s when its family reads it
# ---
# b:  the file
# at: where the line starts
# s:  the simulation
fun read_rule(b: *Vector[u8], at: usize, s: *sim.Sim) {
    var id:   [32]u8;
    var line: [rule.FORMAT_MAX + 1]u8;
    var n:    usize = 0;
    var o:    usize = at;
    for (o < b.len && b.data[o] != ' ' && b.data[o] != '\n' && b.data[o] != '\r') {
        if (n < 31) { id[n] = b.data[o]; }
        n = n + 1;
        o = o + 1;
    }
    if (n > 31) { ret; }
    id[n] = 0;
    if (o < b.len && b.data[o] == ' ') { o = o + 1; }
    var m: usize = 0;
    for (o < b.len && b.data[o] != '\n' && b.data[o] != '\r') {
        if (m == rule.FORMAT_MAX) { ret; }
        line[m] = b.data[o];
        m       = m + 1;
        o       = o + 1;
    }
    line[m] = 0;
    val f: opt[usize] = rule.family_named(?id[0]);
    if (sel f.none) { ret; }
    val r: res[rule.Rule, str] = rule.parse_as(f.some, ?line[0]);
    if (sel r.ok) { sim.set_rule(s, r.ok); }
}

test load__round_trips_settings {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }

    var ap: app.App;
    app.init(?ap);
    ap.speed     = 30.0;
    ap.mode      = 2;
    ap.uncapped  = 1;
    ap.solid     = 0xff0080;
    ap.open_rule = 1;
    ap.tool      = app.TOOL_STAMP;
    sim.set_rule(?s, rule.preset_rule(1));

    val path:  str                = "out/test/test_config.config";
    val saved: err[persist.Error] = save(?a, ?ap, ?s, path);
    if (sel saved.err) { ret 1; }

    var bp: app.App;
    app.init(?bp);
    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 1; }
    val loaded: err[persist.Error] = load(?a, ?bp, ?t, path);
    if (sel loaded.err) { ret 1; }

    if (bp.mode != 2)                 { ret 1; }
    if (bp.uncapped != 1)             { ret 1; }
    if (bp.open_rule != 1)            { ret 1; }
    if (bp.solid != 0xff0080)         { ret 1; }
    if (bp.tool != app.TOOL_STAMP)    { ret 1; }
    if (!rule.same(?t.rule, ?s.rule)) { ret 1; }
    # speed x10 and color x255 round-trip within the quantization step
    if (bp.speed < 29.0 || bp.speed > 31.0) { ret 1; }

    fs.remove_file(path);
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

test load__round_trips_negative_weights_and_reads_wrapped_ones {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    # a kernel wider than versions 1 to 3 could keep, with a sum past their 63
    if (sel s.rule.kind.weighted) {
        weighted.set_radius(?s.rule.kind.weighted, 10);
        s.rule.kind.weighted.weights[0] = -3;
        s.rule.kind.weighted.weights[1] = 5;
        weighted.set(?s.rule.kind.weighted.survive, 200);
    }

    val path:  str                = "out/test/test_config_weights.config";
    val saved: err[persist.Error] = save(?a, ?ap, ?s, path);
    if (sel saved.err) { ret 1; }

    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 1; }
    val loaded: err[persist.Error] = load(?a, ?ap, ?t, path);
    if (sel loaded.err)               { ret 1; }
    if (!rule.same(?t.rule, ?s.rule)) { ret 2; }

    # the file holds -3 as text, not a wrapped u64
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, path);
    if (sel rr.err) { ret 3; }
    var data:      Vector[u8] = rr.ok;
    var has_minus: bool       = false;
    var k:         usize      = 0;
    for (k < data.len) {
        if (data.data[k] == '-') { has_minus = true; }
        k = k + 1;
    }
    vector.dnit[u8](?data);
    if (!has_minus) { ret 3; }

    # a version 2 file, as 0.3.0 wrote, keeps the kernel as integers, and one
    # written before that stores -3 as a wrapped u64
    var buf: [CAP]u8;
    var o:   usize = 0;
    o = wr(?buf[0], o, 2);
    var j: usize = 0;
    for (j < 14) {
        o = wr(?buf[0], o, 1);
        j = j + 1;
    }
    var w: usize = 0;
    for (w < 81) {
        o = wr(?buf[0], o, (-3::i32)::u64);
        w = w + 1;
    }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?buf[0], o, persist.FILE_MODE);
    if (sel wrote.err) { ret 4; }
    val loaded2: err[persist.Error] = load(?a, ?ap, ?t, path);
    if (sel loaded2.err)           { ret 5; }
    if (!sel t.rule.kind.weighted) { ret 6; }
    if (sel t.rule.kind.weighted) {
        if (t.rule.kind.weighted.weights[0] != -3 || t.rule.kind.weighted.weights[8] != -3 || t.rule.kind.weighted.weights[9] != 0) { ret 6; }
    }

    # a rule line naming a family this version does not run keeps the rule
    val later: str             = "4 10 0 0 0 0 0 0 0 255 255 255 1 1 1 1 1 1 0\ncustom\nlenia R13,T10\n";
    val w3:    err[fs.FsError] = fs.write_bytes(path, later::*u8, string.str_len(later), persist.FILE_MODE);
    if (sel w3.err) { ret 7; }
    var before:  rule.Rule          = t.rule;
    val loaded3: err[persist.Error] = load(?a, ?ap, ?t, path);
    if (sel loaded3.err)              { ret 8; }
    if (!rule.same(?t.rule, ?before)) { ret 9; }
    if (ap.panel != 1)                { ret 10; }

    fs.remove_file(path);
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}

# write a version 2 settings file whose pattern slot holds sel
fun write_v2(path: str, sel_idx: u64) bool {
    var buf: [CAP]u8;
    var o:   usize = 0;
    o = wr(?buf[0], o, 2);
    o = wr(?buf[0], o, 120);
    var j: usize = 0;
    for (j < 6) {
        o = wr(?buf[0], o, 0);
        j = j + 1;
    }
    o = wr(?buf[0], o, sel_idx);
    j = 0;
    for (j < 3 + 3 + 81 + 7) {
        o = wr(?buf[0], o, 1);
        j = j + 1;
    }
    buf[o] = '\n';
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?buf[0], o + 1, persist.FILE_MODE);
    ret !(sel wrote.err);
}

# whether settings save to path
fun saves_ok(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) bool {
    val r: err[persist.Error] = save(a, ap, s, path);
    ret !(sel r.err);
}

# whether settings load from path
fun loads_ok(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) bool {
    val r: err[persist.Error] = load(a, ap, s, path);
    ret !(sel r.err);
}

test load__keeps_the_selected_pattern_by_name_and_migrates_old_indices {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 2; }
    val l:    *library.Library = ?ap.library;
    val path: str              = "out/test/test_config_sel.config";

    # a library pattern and the custom one round-trip by name
    app.choose_named(?ap, "Pulsar");
    val pulsar: usize = ap.pattern_sel;
    if (pulsar >= library.count(l))   { ret 3; }
    if (!saves_ok(?a, ?ap, ?s, path)) { ret 4; }
    app.choose_default(?ap);
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != pulsar) { ret 5; }
    app.choose(?ap, app.CUSTOM);
    if (!saves_ok(?a, ?ap, ?s, path)) { ret 6; }
    app.choose_default(?ap);
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != app.CUSTOM) { ret 7; }

    # an older file's index names the built-in it had, 7 the custom pattern, and
    # anything else the glider
    if (!write_v2(path, 7))                                                                         { ret 8; }
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != app.CUSTOM)                               { ret 9; }
    if (!write_v2(path, 4))                                                                         { ret 10; }
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != library.find(l, "Lightweight spaceship")) { ret 11; }
    if (!write_v2(path, 6))                                                                         { ret 12; }
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != library.find(l, "Gosper glider gun"))     { ret 13; }
    if (!write_v2(path, 42))                                                                        { ret 14; }
    if (!loads_ok(?a, ?ap, ?s, path) || ap.pattern_sel != library.find(l, "Glider"))                { ret 15; }
    # the old file's other fields still read
    if (ap.panel != 1 || ap.speed < 11.9 || ap.speed > 12.1) { ret 16; }

    fs.remove_file(path);
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}

# write a settings file of a version before 4, its rule the Life-like kernel
# with birth mask birth and survive mask 12, its pattern slot 0 and, from
# version 3, a selection line naming the pulsar
fun write_old(path: str, version: u64, birth: u64) bool {
    var buf: [CAP]u8;
    var o:   usize = 0;
    o = wr(?buf[0], o, version);
    o = wr(?buf[0], o, 120);
    var j: usize = 0;
    for (j < 7) {
        o = wr(?buf[0], o, 0);
        j = j + 1;
    }
    o = wr(?buf[0], o, 1);
    o = wr(?buf[0], o, 1);
    o = wr(?buf[0], o, 1);
    o = wr(?buf[0], o, 1);
    o = wr(?buf[0], o, birth);
    o = wr(?buf[0], o, 12);
    j = 0;
    for (j < 81) {
        var w: u64 = 0;
        if (j < 9 && j != 4) { w = 1; }
        o = wr(?buf[0], o, w);
        j = j + 1;
    }
    j = 0;
    for (version >= 2 && j < 7) {
        o = wr(?buf[0], o, 1);
        j = j + 1;
    }
    buf[o] = '\n';
    o      = o + 1;
    if (version >= 3) { o = text.buf_str(?buf[0], o, "library Pulsar\n"); }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?buf[0], o, persist.FILE_MODE);
    ret !(sel wrote.err);
}

# rewrite the settings file at path as a version 4 one, which ends with the
# rule line
fun as_v4(a: *allo.Allocator, path: str) bool {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) { ret false; }
    var data:  Vector[u8] = rr.ok;
    var lines: usize      = 0;
    var n:     usize      = 0;
    for (n < data.len && lines < 3) {
        if (data.data[n] == '\n') { lines = lines + 1; }
        n = n + 1;
    }
    data.data[0] = '4';
    val wrote: err[fs.FsError] = fs.write_bytes(path, data.data::*u8, n, persist.FILE_MODE);
    vector.dnit[u8](?data);
    ret lines == 3 && !(sel wrote.err);
}

test load__reads_every_version {
    var a: allo.Allocator;
    page.make(?a);
    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }
    var ap: app.App;
    app.init(?ap);
    val shown: err[format.Error] = app.attach(?ap, ?a);
    if (sel shown.err) { ret 2; }
    val l:    *library.Library = ?ap.library;
    val path: str              = "out/test/test_config_versions.config";

    # versions 1 to 3 keep the rule as a kernel's integers: each loads its own
    var v: u64 = 1;
    for (v <= 3) {
        val birth: u64 = (1::u64 << 3) | (1::u64 << (v + 3));
        if (!write_old(path, v, birth))   { ret 10 + v::i32; }
        if (!loads_ok(?a, ?ap, ?s, path)) { ret 20 + v::i32; }
        var want: rule.Rule = rule.of(rule.Kind.weighted{weighted.moore(weighted.sums(birth), weighted.sums(12))});
        if (!rule.same(?s.rule, ?want)) { ret 30 + v::i32; }
        # version 3 names its pattern, and older ones migrate slot 0 to the glider
        var sel_want: usize = library.find(l, "Glider");
        if (v == 3)                     { sel_want = library.find(l, "Pulsar"); }
        if (ap.pattern_sel != sel_want) { ret 40 + v::i32; }
        v = v + 1;
    }
    if (ap.panel != 1) { ret 50; }

    # version 4 kept the pattern and the rule by name, through the family, and
    # has no engine line: the engine and exponent keep what they were
    sim.set_rule(?s, rule.preset_rule(3));
    app.choose_named(?ap, "Pulsar");
    if (!saves_ok(?a, ?ap, ?s, path)) { ret 55; }
    if (!as_v4(?a, path))             { ret 56; }
    sim.set_rule(?s, rule.preset_rule(0));
    app.choose_default(?ap);
    ap.engine_tree = true;
    sim.set_exponent(?s, 6);
    if (!loads_ok(?a, ?ap, ?s, path)) { ret 57; }
    var life: rule.Rule = rule.preset_rule(3);
    if (!rule.same(?s.rule, ?life) || ap.pattern_sel != library.find(l, "Pulsar")) { ret 58; }
    if (!ap.engine_tree || sim.exponent(?s) != 6)                                  { ret 59; }
    ap.engine_tree = false;
    sim.set_exponent(?s, 0);

    # version 5 keeps the pattern, the rule, the engine and the exponent
    app.choose_named(?ap, "Block");
    val block: usize = ap.pattern_sel;
    sim.set_rule(?s, rule.preset_rule(3));
    if (!saves_ok(?a, ?ap, ?s, path)) { ret 60; }
    app.choose_default(?ap);
    sim.set_rule(?s, rule.preset_rule(0));
    if (!loads_ok(?a, ?ap, ?s, path)) { ret 61; }
    var dn: rule.Rule = rule.preset_rule(3);
    if (!rule.same(?s.rule, ?dn) || ap.pattern_sel != block) { ret 62; }

    # each engine comes back, the exponent with it even off the tree, and a
    # word it does not know keeps the default engine
    var e: usize = 0;
    for (e < 3) {
        ap.engine_tree = e == 2;
        ap.engine_cpu  = e == 0;
        sim.set_exponent(?s, 5 + e::u32);
        if (!saves_ok(?a, ?ap, ?s, path)) { ret 63; }
        ap.engine_tree = e != 2;
        ap.engine_cpu  = e != 0;
        sim.set_exponent(?s, 0);
        if (!loads_ok(?a, ?ap, ?s, path))                                                              { ret 64; }
        if (ap.engine_tree != (e == 2) || ap.engine_cpu != (e == 0) || sim.exponent(?s) != 5 + e::u32) { ret 65; }
        e = e + 1;
    }
    val odd:  str             = "5 10 0 0 0 0 0 0 0 255 255 255 1 1 1 1 1 1 0\nlibrary Pulsar\nlife B3/S23\nquantum 99\n";
    val wodd: err[fs.FsError] = fs.write_bytes(path, odd::*u8, string.str_len(odd), persist.FILE_MODE);
    if (sel wodd.err) { ret 66; }
    ap.engine_tree = true;
    if (!loads_ok(?a, ?ap, ?s, path) || ap.engine_tree || ap.engine_cpu) { ret 67; }
    if (sim.exponent(?s) != hashlife.MAX_EXPONENT)                       { ret 68; }

    # version 6 keeps the ceilings, which load_ceilings reads alone, and a
    # version 5 file leaves them as they were
    var c: ceiling.Ceilings = ceiling.defaults();
    c.on[ceiling.POPULATION]    = true;
    c.limit[ceiling.POPULATION] = 12345;
    c.on[ceiling.MEMORY]        = false;
    sim.set_ceilings(?s, c);
    if (!saves_ok(?a, ?ap, ?s, path)) { ret 69; }
    sim.set_ceilings(?s, ceiling.defaults());
    if (!loads_ok(?a, ?ap, ?s, path)) { ret 70; }
    var got: ceiling.Ceilings = sim.ceilings(?s);
    if (!got.on[ceiling.POPULATION] || got.limit[ceiling.POPULATION] != 12345 || got.on[ceiling.MEMORY] || got.limit[ceiling.MEMORY] != 500) { ret 71; }
    var alone: ceiling.Ceilings   = ceiling.defaults();
    val read:  err[persist.Error] = load_ceilings(?a, path, ?alone);
    if (sel read.err || alone.limit[ceiling.POPULATION] != 12345 || alone.on[ceiling.MEMORY]) { ret 72; }
    val w5: err[fs.FsError] = fs.write_bytes(path, odd::*u8, string.str_len(odd), persist.FILE_MODE);
    if (sel w5.err)                   { ret 73; }
    if (!loads_ok(?a, ?ap, ?s, path)) { ret 74; }
    got = sim.ceilings(?s);
    if (got.limit[ceiling.POPULATION] != 12345) { ret 75; }

    fs.remove_file(path);
    app.dnit(?ap);
    sim.dnit(?s);
    ret 0;
}
