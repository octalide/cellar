# UI settings, the active kernel, and window layout kept between runs
#
# they are one fixed-order line of integers under arrangements/. every value is
# stored as a non-negative integer, fractional fields scaled (speed x10, colors
# x255) and floats truncated, so one integer formatter and
# one whitespace tokenizer cover the whole file, with no float parsing. the world
# contents are not part of settings; use the arrangements window to save a world.

use cellar.app;
use cellar.kernel;
use cellar.persist;
use cellar.sim;
use cellar.text;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# settings file, under the (gitignored) arrangements/ data directory
pub val PATH: str = "arrangements/cellar.config";

# settings-format version; a file with a different version is ignored
val VERSION: u64 = 1;
# buffer size for the serialized settings line, ample for ~105 integers
val CAP: usize = 4096;

# append v's decimal digits and a separating space to buf at off; ret the new
# offset.
fun wr(buf: *u8, off: usize, v: u64) usize {
    var o: usize = text.buf_u64(buf, off, v);
    buf[o] = ' ';
    ret o + 1;
}

# skip non-digits from pos, parse a run of digits, advance pos past
# them, and return the value (0 at end of input).
fun read_uint(b: *Vector[u8], pos: *usize) usize {
    var o: usize = @pos;
    for (o < b.len && (b.data[o] < '0' || b.data[o] > '9')) { o = o + 1; }
    var v: usize = 0;
    for (text.byte_at(b.data, b.len, o) >= '0' && text.byte_at(b.data, b.len, o) <= '9') {
        v = v * 10 + (b.data[o] - '0')::usize;
        o = o + 1;
    }
    @pos = o;
    ret v;
}

# write the current settings, kernel, and window layout to path
# ---
# a:   allocator backing the transient buffer
# ap:  application state to serialize
# s:   simulation whose kernel is serialized
# ret: ok, or why the settings were not written
pub fun save(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) err[persist.Error] {
    val made: err[fs.FsError] = fs.create_dir_all(a, persist.DIR, persist.DIR_MODE);
    if (sel made.err) { ret err[persist.Error].err{persist.Error.fs{made.err}}; }

    val rc: res[*u8, allo.Error] = allo.allocate[u8](a, CAP);
    if (sel rc.err) { ret err[persist.Error].err{persist.Error.alloc{rc.err}}; }
    val buf: *u8 = rc.ok;

    var o: usize = 0;
    o = wr(buf, o, VERSION);
    o = wr(buf, o, (ap.speed * 10.0)::u64);
    o = wr(buf, o, ap.mode::u64);
    o = wr(buf, o, ap.gutter::u64);
    o = wr(buf, o, ap.uncapped::u64);
    o = wr(buf, o, ap.erase::u64);
    o = wr(buf, o, ap.bounds_idx::u64);
    o = wr(buf, o, ap.stamp_mode::u64);
    o = wr(buf, o, ap.pattern_sel::u64);
    o = wr(buf, o, (ap.solid_r * 255.0)::u64);
    o = wr(buf, o, (ap.solid_g * 255.0)::u64);
    o = wr(buf, o, (ap.solid_b * 255.0)::u64);
    o = wr(buf, o, s.kernel.radius::u64);
    o = wr(buf, o, s.kernel.birth);
    o = wr(buf, o, s.kernel.survive);
    var i: usize = 0;
    for (i < 81) {
        o = wr(buf, o, s.kernel.weights[i]::u64);
        i = i + 1;
    }
    o      = wr(buf, o, ap.world.x::u64);
    o      = wr(buf, o, ap.world.y::u64);
    o      = wr(buf, o, ap.world.open::u64);
    o      = wr(buf, o, ap.kedit.x::u64);
    o      = wr(buf, o, ap.kedit.y::u64);
    o      = wr(buf, o, ap.kedit.open::u64);
    o      = wr(buf, o, ap.arrange.x::u64);
    o      = wr(buf, o, ap.arrange.y::u64);
    o      = wr(buf, o, ap.arrange.open::u64);
    buf[o] = '\n';
    o      = o + 1;

    val wrote: err[fs.FsError] = fs.write_bytes(path, buf, o, persist.FILE_MODE);
    allo.deallocate[u8](a, buf, CAP);
    if (sel wrote.err) { ret err[persist.Error].err{persist.Error.fs{wrote.err}}; }
    ret err[persist.Error].ok{};
}

# read settings from path into ap and s.kernel, if the file exists and its
# version matches. a missing file leaves the defaults untouched.
# ---
# a:   allocator for the read buffer
# ap:  application state to populate
# s:   simulation whose kernel is populated
# ret: ok when loaded or absent, or why the file was refused
pub fun load(a: *allo.Allocator, ap: *app.App, s: *sim.Sim, path: str) err[persist.Error] {
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel rr.err) {
        if (sel rr.err.io && rr.err.io.kind == io_error.NOT_FOUND) { ret err[persist.Error].ok{}; }
        ret err[persist.Error].err{persist.Error.fs{rr.err}};
    }
    var data: Vector[u8] = rr.ok;

    var p: usize = 0;
    if (read_uint(?data, ?p) != VERSION::usize) {
        vector.dnit[u8](?data);
        ret err[persist.Error].err{persist.Error.version{}};
    }

    ap.speed      = read_uint(?data, ?p)::f32 / 10.0;
    ap.mode       = read_uint(?data, ?p);
    ap.gutter     = read_uint(?data, ?p)::u8;
    ap.uncapped   = read_uint(?data, ?p)::u8;
    ap.erase      = read_uint(?data, ?p)::u8;
    ap.bounds_idx = read_uint(?data, ?p);
    if (ap.bounds_idx >= app.BOUNDS_COUNT) { ap.bounds_idx = app.DEFAULT_BOUNDS; }
    ap.stamp_mode  = read_uint(?data, ?p)::u8;
    ap.pattern_sel = read_uint(?data, ?p);
    ap.solid_r     = read_uint(?data, ?p)::f32 / 255.0;
    ap.solid_g     = read_uint(?data, ?p)::f32 / 255.0;
    ap.solid_b     = read_uint(?data, ?p)::f32 / 255.0;

    var r: usize = read_uint(?data, ?p);
    if (r < 1)                 { r = 1; }
    if (r > kernel.MAX_RADIUS) { r = kernel.MAX_RADIUS; }
    s.kernel.radius  = r;
    s.kernel.birth   = read_uint(?data, ?p)::u64;
    s.kernel.survive = read_uint(?data, ?p)::u64;
    var i: usize = 0;
    for (i < 81) {
        s.kernel.weights[i] = read_uint(?data, ?p)::i32;
        i                   = i + 1;
    }
    # a saved rule that matches a preset keeps that preset's name and selection
    s.kernel.name = "custom";
    val match: opt[usize] = kernel.match_preset(?s.kernel);
    if (sel match.some) {
        s.kernel.name = kernel.preset(match.some).name;
        ap.preset_sel = match.some;
    }

    ap.world.x      = read_uint(?data, ?p)::f32;
    ap.world.y      = read_uint(?data, ?p)::f32;
    ap.world.open   = read_uint(?data, ?p)::u8;
    ap.kedit.x      = read_uint(?data, ?p)::f32;
    ap.kedit.y      = read_uint(?data, ?p)::f32;
    ap.kedit.open   = read_uint(?data, ?p)::u8;
    ap.arrange.x    = read_uint(?data, ?p)::f32;
    ap.arrange.y    = read_uint(?data, ?p)::f32;
    ap.arrange.open = read_uint(?data, ?p)::u8;

    vector.dnit[u8](?data);
    ret err[persist.Error].ok{};
}

test load__round_trips_settings {
    var a: allo.Allocator;
    page.make(?a);

    var s:    sim.Sim;
    val made: err[allo.Error] = sim.init(?s, ?a);
    if (sel made.err) { ret 1; }

    var ap: app.App;
    app.init(?ap);
    ap.speed       = 30.0;
    ap.mode        = 2;
    ap.uncapped    = 1;
    ap.solid_r     = 1.0;
    ap.solid_g     = 0.0;
    ap.solid_b     = 0.5;
    ap.kedit.open  = 1;
    s.kernel.birth = 42;

    val path:  str                = "arrangements/test_config.cells";
    val saved: err[persist.Error] = save(?a, ?ap, ?s, path);
    if (sel saved.err) { ret 1; }

    var bp: app.App;
    app.init(?bp);
    var t:     sim.Sim;
    val made2: err[allo.Error] = sim.init(?t, ?a);
    if (sel made2.err) { ret 1; }
    val loaded: err[persist.Error] = load(?a, ?bp, ?t, path);
    if (sel loaded.err) { ret 1; }

    if (bp.mode != 2)         { ret 1; }
    if (bp.uncapped != 1)     { ret 1; }
    if (bp.kedit.open != 1)   { ret 1; }
    if (t.kernel.birth != 42) { ret 1; }
    # speed x10 and color x255 round-trip within the quantization step
    if (bp.speed < 29.0 || bp.speed > 31.0) { ret 1; }

    fs.remove_file(path);
    sim.dnit(?s);
    sim.dnit(?t);
    ret 0;
}
