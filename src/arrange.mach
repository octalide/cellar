# the draw section: the tool, the pattern library, and the custom-pattern editor
#
# the tool says what a press on the world does: paint live cells, erase them,
# or stamp the selected pattern, or drag out a selection. a rule of more than
# two states offers its live states to pick the one the pen paints, each in
# the rule's colour for it, and picking one arms the draw tool. picking a
# pattern arms the stamp. the library is browsed a category at a time, or searched by
# name across all of them, and listed a page at a time. the custom pattern is
# drawn in place in a small grid editor while it is small enough to edit, and
# the select tool offers the operations on the selection. a large pattern is
# previewed from a texture (cellar.sketch) rather than a rectangle a cell.

use blit;
use bctx: blit.context;
use binp: blit.input;
use bint: blit.interact;
use blay: blit.layout;
use bw:   blit.widget;
use cellar.app;
use cellar.command;
use cellar.library;
use cellar.look;
use cellar.pattern;
use cellar.rule;
use cellar.sketch;
use cellar.text;
use cellar.theme;
use cellar.world;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# unscaled height of the pattern preview
val PREVIEW: f32 = 96.0;
# patterns the list shows a page at a time
val PAGE_ROWS: usize = 10;
# the longest side the custom pattern's grid editor shows
pub val EDIT_SIDE: usize = 64;
# state swatches the picker lays in a row
val INKS_ROW: usize = 8;

# the selected pattern, from the library or custom
pub fun active(a: *app.App) *pattern.Pattern {
    ret app.chosen(a);
}

# ask to stamp the selected pattern in the current orientation centred on world (x, y)
pub fun stamp_active(a: *app.App, x: i64, y: i64) {
    app.stamp(a, active(a), a.orient, x, y);
}

# a pattern's live cells scaled into a box across the column, PREVIEW tall
fun preview(ui: *bctx.Context, sk: *sketch.Sketches, p: *pattern.Pattern) {
    val ph: f32       = bctx.px(ui, PREVIEW);
    val r:  bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(ph), 0.0, ph);
    bctx.quad(ui, r.x0, r.y0, r.x1, r.y1, look.colour(theme.WORLD, 1.0));
    var span: usize = p.w;
    if (p.h > span) { span = p.h; }
    if (span == 0)  { span = 1; }
    val m:  f32 = bctx.px(ui, 12.0);
    var cs: f32 = (r.y1 - r.y0 - m) / span::f32;
    if ((r.x1 - r.x0 - m) / span::f32 < cs) { cs = (r.x1 - r.x0 - m) / span::f32; }
    val ox:   f32             = r.x0 + (r.x1 - r.x0 - p.w::f32 * cs) / 2.0;
    val oy:   f32             = r.y0 + (r.y1 - r.y0 - p.h::f32 * cs) / 2.0;
    val live: blit.draw.Color = look.colour(theme.ACCENT, 1.0);
    if (sketch.large(p.w, p.h)) {
        val img: opt[blit.draw.Image] = sketch.image(sk, ?sk.preview, p, 0, cs);
        if (sel img.some) { bctx.image_at(ui, img.some, ox, oy, ox + p.w::f32 * cs, oy + p.h::f32 * cs, live); }
        ret;
    }
    var gap: f32 = 0.0;
    if (cs >= 4.0) { gap = 1.0; }
    var y: usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            if (pattern.get(p, x, y) != 0) {
                val qx: f32 = ox + x::f32 * cs;
                val qy: f32 = oy + y::f32 * cs;
                bctx.quad(ui, qx, qy, qx + cs - gap, qy + cs - gap, live);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

# whether the grid editor shows a pattern
pub fun editable(p: *pattern.Pattern) bool {
    ret p.w <= EDIT_SIDE && p.h <= EDIT_SIDE;
}

# the colour a live state is shown in: the rule's for it, or the view's solid colour
fun ink_colour(a: *app.App, r: *rule.Rule, state: u32) u32 {
    val c: opt[u32] = rule.colour(r, state);
    if (sel c.some) { ret c.some; }
    ret a.solid;
}

# the custom pattern as a grid across the column, each cell in its state's
# colour; a press paints the cell under it in the ink, or clears it when it
# holds the ink
fun editor(ui: *bctx.Context, a: *app.App, r: *rule.Rule, p: *pattern.Pattern) {
    val av: bctx.Area = bw.avail(ui);
    val c:  f32       = (av.x1 - av.x0) / p.w::f32;
    val g:  bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(c * p.h::f32), 0.0, c * p.h::f32);
    val h:  bint.Hit  = bint.hit(ui, bctx.id_of(ui, "editor"), g.x0, g.y0, g.x0 + c * p.w::f32, g.y1, binp.BUTTON_LEFT);
    bctx.quad(ui, g.x0, g.y0, g.x0 + c * p.w::f32, g.y1, look.colour(theme.WORLD, 1.0));
    var y: usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            val cx0: f32 = g.x0 + x::f32 * c;
            val cy0: f32 = g.y0 + y::f32 * c;
            val st:  u8  = pattern.get(p, x, y);
            var col: u32 = theme.CONTROL;
            if (st != 0 && st::u32 < rule.states(r)) { col = ink_colour(a, r, st::u32); }
            or (st != 0)                             { col = theme.ACCENT; }
            bctx.quad(ui, cx0 + 1.0, cy0 + 1.0, cx0 + c, cy0 + c, look.colour(col, 1.0));
            x = x + 1;
        }
        y = y + 1;
    }
    # toggle on the press, so one click flips exactly one cell
    if (h.pressed) {
        val ux: usize = ((h.mx - g.x0) / c)::usize;
        val uy: usize = ((h.my - g.y0) / c)::usize;
        if (ux < p.w && uy < p.h) {
            var v: u8 = a.ink;
            if (pattern.get(p, ux, uy) == a.ink) { v = 0; }
            pattern.set(p, ux, uy, v);
        }
    }
}

# pick a pattern to stamp
fun pick(a: *app.App, i: usize) {
    a.pattern_sel = i;
    a.tool        = app.TOOL_STAMP;
}

# the categories to browse, and the custom pattern, two to a row
fun categories(ui: *bctx.Context, a: *app.App) {
    val h: f32       = bw.control_height(ui);
    val n: usize     = library.CATEGORY_COUNT + 1;
    var r: bctx.Area = bctx.Area{x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0};
    var i: usize     = 0;
    for (i < n) {
        val col: usize = i % 2;
        if (col == 0) { r = bw.place(ui, blay.fill(1.0), blay.fixed(h), 0.0, h); }
        var name: str  = "Custom";
        var on:   bool = a.pattern_sel == app.CUSTOM && a.tool == app.TOOL_STAMP;
        if (i < library.CATEGORY_COUNT) {
            name = library.category(i).name;
            on   = a.browse == i;
        }
        if (bw.button_at(ui, name, bw.cell_x0(ui, col, 2), r.y0, bw.cell_x1(ui, col, 2), r.y1, on)) {
            if (i < library.CATEGORY_COUNT) {
                a.browse = i;
                a.page   = 0;
            }
            or { pick(a, app.CUSTOM); }
        }
        i = i + 1;
    }
}

# the listed patterns, a page at a time, with the pages to turn
fun list(ui: *bctx.Context, l: look.Look, a: *app.App, query: str) {
    val lib:   *library.Library = ?a.library;
    var total: usize            = 0;
    var i:     usize            = 0;
    for (i < library.count(lib)) {
        if (library.listed(lib, i, query, a.browse)) { total = total + 1; }
        i = i + 1;
    }
    if (total == 0) {
        look.note(ui, l, "No pattern has that in its name");
        ret;
    }
    val pages: usize = (total + PAGE_ROWS - 1) / PAGE_ROWS;
    if (a.page >= pages) { a.page = pages - 1; }
    val first: usize = a.page * PAGE_ROWS;
    var k:     usize = 0;
    i = 0;
    for (i < library.count(lib) && k < first + PAGE_ROWS) {
        if (library.listed(lib, i, query, a.browse)) {
            if (k >= first) {
                var name: [1]str;
                name[0] = library.name(lib, i);
                var on: usize = 1;
                if (a.pattern_sel == i && a.tool == app.TOOL_STAMP) { on = 0; }
                bctx.push_id_int(ui, i::u64);
                if (bw.button_grid(ui, ?name[0], 1, 1, on) == 0) { pick(a, i); }
                bctx.pop_id(ui);
            }
            k = k + 1;
        }
        i = i + 1;
    }
    if (pages == 1) { ret; }
    var at: [48]u8;
    var o:  usize = text.buf_str(?at[0], 0, "Page ");
    o     = text.buf_u64(?at[0], o, (a.page + 1)::u64);
    o     = text.buf_str(?at[0], o, " of ");
    o     = text.buf_u64(?at[0], o, pages::u64);
    at[o] = 0;
    look.note(ui, l, ?at[0]);
    var turn: [2]str;
    turn[0] = "Previous";
    turn[1] = "Next";
    val t: usize = bw.buttons(ui, ?turn[0], 2);
    if (t == 0 && a.page > 0)         { a.page = a.page - 1; }
    if (t == 1 && a.page + 1 < pages) { a.page = a.page + 1; }
}

# the label of an area operation's button
fun area_label(op: u8) str {
    if (op == command.AREA_COPY)          { ret "Copy"; }
    if (op == command.AREA_CUT)           { ret "Cut"; }
    if (op == command.AREA_CLEAR)         { ret "Clear"; }
    if (op == command.AREA_CLEAR_OUTSIDE) { ret "Clear outside"; }
    if (op == command.AREA_FILL)          { ret "Random fill"; }
    if (op == command.AREA_INVERT)        { ret "Invert"; }
    if (op == command.AREA_IDENTIFY)      { ret "Identify"; }
    ret "Shrink to fit";
}

# the operations on the selection, two to a row
fun selection(ui: *bctx.Context, l: look.Look, a: *app.App) {
    if (!a.selected) {
        look.note(ui, l, "Drag on the world to select");
        ret;
    }
    var labels: [command.AREA_COUNT]str;
    var op:     u8 = 0;
    for (op < command.AREA_COUNT) {
        labels[op] = area_label(op);
        op         = op + 1;
    }
    val hit: usize = bw.button_grid(ui, ?labels[0], command.AREA_COUNT::usize, 2, command.AREA_COUNT::usize);
    if (hit < command.AREA_COUNT::usize) { app.area(a, hit::u8); }
}

# the rule's live states as swatches, INKS_ROW to a row, the ink framed; a
# click picks the ink and arms the draw tool. a rule of two states has only
# the one live state, and shows nothing
fun inks(ui: *bctx.Context, l: look.Look, a: *app.App, r: *rule.Rule) {
    val n: u32 = rule.states(r);
    if (n <= 2) { ret; }
    var rd: [48]u8;
    var o:  usize = text.buf_str(?rd[0], 0, "Pen paints state ");
    o     = text.buf_u64(?rd[0], o, a.ink::u64);
    o     = text.buf_str(?rd[0], o, ", Q steps");
    rd[o] = 0;
    look.note(ui, l, ?rd[0]);
    val av:  bctx.Area = bw.avail(ui);
    val g:   f32       = bctx.px(ui, 4.0);
    val sz:  f32       = (av.x1 - av.x0 - g * (INKS_ROW - 1)::f32) / INKS_ROW::f32;
    val t:   f32       = bctx.px(ui, 2.0);
    val in:  f32       = bctx.px(ui, 4.0);
    var row: bctx.Area = bctx.Area{x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0};
    var st:  u32       = 1;
    bctx.push_style(ui, l.small);
    for (st < n) {
        val i: usize = ((st - 1) % INKS_ROW::u32)::usize;
        if (i == 0) { row = bw.place(ui, blay.fill(1.0), blay.fixed(sz), 0.0, sz); }
        val x0: f32 = row.x0 + i::f32 * (sz + g);
        val y0: f32 = row.y0;
        bctx.push_id_int(ui, st::u64);
        val h: bint.Hit = bint.hit(ui, bctx.id_of(ui, "ink"), x0, y0, x0 + sz, y0 + sz, binp.BUTTON_LEFT);
        bctx.pop_id(ui);
        val on: bool = st == a.ink::u32;
        if (on)    { bctx.frame(ui, x0, y0, x0 + sz, y0 + sz, t, look.colour(theme.TEXT, 1.0)); }
        or (h.hot) { bctx.frame(ui, x0, y0, x0 + sz, y0 + sz, t, look.colour(theme.TEXT_DIM, 1.0)); }
        val c: u32 = ink_colour(a, r, st);
        bctx.quad(ui, x0 + in, y0 + in, x0 + sz - in, y0 + sz - in, look.colour(c, 1.0));
        var num: [4]u8;
        num[text.buf_u64(?num[0], 0, st::u64)] = 0;
        look.text_centre(ui, ?num[0], x0, y0, x0 + sz, y0 + sz, look.colour(label_ink(c), 1.0));
        if (h.clicked) {
            a.ink  = st::u8;
            a.tool = app.TOOL_DRAW;
        }
        st = st + 1;
    }
    bctx.pop_style(ui);
}

# the text colour that reads over a fill: dark over a light one, light otherwise
fun label_ink(c: u32) u32 {
    val lum: u32 = theme.red(c)::u32 * 299 + theme.green(c)::u32 * 587 + theme.blue(c)::u32 * 114;
    if (lum > 140000) { ret theme.ACCENT_INK; }
    ret theme.TEXT;
}

# draw the draw section and apply its controls
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown, whose rule gives the states
# sk: the sketches large patterns are previewed from
pub fun section(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown, sk: *sketch.Sketches) {
    if (!look.heading(ui, l, "DRAW", ?a.open_draw)) { ret; }
    var tools: [5]str;
    tools[0] = "Draw";
    tools[1] = "Erase";
    tools[2] = "Stamp";
    tools[3] = "Select";
    tools[4] = "Bounds";
    # five do not fit a row of the panel
    val picked: usize = bw.button_grid(ui, ?tools[0], app.TOOL_COUNT, 3, a.tool);
    if (picked == app.TOOL_BOUNDS) { a.open_bounds = 1; }
    if (picked < app.TOOL_COUNT)   { a.tool = picked; }
    if (a.tool == app.TOOL_BOUNDS) {
        look.note(ui, l, "Drag a box in the world to bound it there, or drag the grid's edges; BOUNDS sets them by value");
        ret;
    }
    inks(ui, l, a, ?s.rule);
    if (a.tool == app.TOOL_SELECT) {
        selection(ui, l, a);
        ret;
    }

    if ((bw.text_field(ui, "search", ?a.search, "Search patterns") & blit.field.EDITED) != 0) { a.page = 0; }
    val query: str = blit.field.text(?a.search);
    if (query[0] == 0) { categories(ui, a); }
    bctx.push_id_str(ui, "patterns");
    list(ui, l, a, query);
    bctx.pop_id(ui);

    val p: *pattern.Pattern = active(a);
    if (p == ?a.custom) {
        if (editable(p)) {
            look.note(ui, l, "Custom pattern, click cells to edit");
            editor(ui, a, ?s.rule, p);
        }
        or {
            var at: [128]u8;
            var o:  usize = text.buf_str(?at[0], 0, "Custom pattern, ");
            o     = text.buf_u64(?at[0], o, p.w::u64);
            o     = text.buf_str(?at[0], o, " x ");
            o     = text.buf_u64(?at[0], o, p.h::u64);
            o     = text.buf_str(?at[0], o, ", too large to edit here: the editor takes ");
            o     = text.buf_u64(?at[0], o, EDIT_SIDE::u64);
            o     = text.buf_str(?at[0], o, " x ");
            o     = text.buf_u64(?at[0], o, EDIT_SIDE::u64);
            o     = text.buf_str(?at[0], o, " at most");
            at[o] = 0;
            look.note(ui, l, ?at[0]);
            preview(ui, sk, p);
        }
        if (bw.button(ui, "Clear pattern")) { pattern.clear(p); }
        ret;
    }
    look.note(ui, l, pattern.name(p));
    preview(ui, sk, p);
}
