# the draw section: the tool, the pattern library, and the custom-pattern editor
#
# the tool says what a press on the world does: paint live cells, erase them,
# or stamp the selected pattern, or drag out a selection. picking a pattern
# arms the stamp. the library is browsed a category at a time, or searched by
# name across all of them, and listed a page at a time. the custom pattern is
# drawn in place in a small grid editor, and the select tool offers the
# operations on the selection.

use cellar.app;
use cellar.command;
use cellar.library;
use cellar.pattern;
use cellar.text;
use cellar.theme;
use cellar.ui;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

# unscaled height of the pattern preview
val PREVIEW: f32 = 96.0;
# patterns the list shows a page at a time
val PAGE_ROWS: usize = 10;

# the selected pattern, from the library or custom
pub fun active(a: *app.App) *pattern.Pattern {
    ret app.chosen(a);
}

# ask to stamp the selected pattern in the current orientation centred on world (x, y)
pub fun stamp_active(a: *app.App, x: i64, y: i64) {
    app.stamp(a, active(a), a.orient, x, y);
}

# draw a pattern's live cells scaled into a box
fun preview(u: *ui.Ui, p: *pattern.Pattern, x0: f32, y0: f32, x1: f32, y1: f32) {
    ui.rect(u, x0, y0, x1, y1, theme.WORLD, 1.0);
    var span: usize = p.w;
    if (p.h > span) { span = p.h; }
    if (span == 0)  { span = 1; }
    var cs: f32 = (y1 - y0 - ui.px(u, 12.0)) / span::f32;
    if ((x1 - x0 - ui.px(u, 12.0)) / span::f32 < cs) { cs = (x1 - x0 - ui.px(u, 12.0)) / span::f32; }
    val ox:  f32 = x0 + (x1 - x0 - p.w::f32 * cs) / 2.0;
    val oy:  f32 = y0 + (y1 - y0 - p.h::f32 * cs) / 2.0;
    var gap: f32 = 0.0;
    if (cs >= 4.0) { gap = 1.0; }
    var y: usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            if (pattern.get(p, x, y) != 0) {
                val qx: f32 = ox + x::f32 * cs;
                val qy: f32 = oy + y::f32 * cs;
                ui.rect(u, qx, qy, qx + cs - gap, qy + cs - gap, theme.ACCENT, 1.0);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

# the custom pattern as a clickable grid; a press toggles the cell under it
fun editor(u: *ui.Ui, p: *pattern.Pattern) {
    val c:  f32    = u.w / p.w::f32;
    val x0: f32    = u.x;
    val y0: f32    = u.y;
    val x1: f32    = x0 + c * p.w::f32;
    val y1: f32    = y0 + c * p.h::f32;
    val hh: ui.Hit = ui.region(u, x0, y0, x1, y1);
    ui.rect(u, x0, y0, x1, y1, theme.WORLD, 1.0);
    var y: usize = 0;
    for (y < p.h) {
        var x: usize = 0;
        for (x < p.w) {
            val cx0: f32 = x0 + x::f32 * c;
            val cy0: f32 = y0 + y::f32 * c;
            var col: u32 = theme.CONTROL;
            if (pattern.get(p, x, y) != 0) { col = theme.ACCENT; }
            ui.rect(u, cx0 + 1.0, cy0 + 1.0, cx0 + c, cy0 + c, col, 1.0);
            x = x + 1;
        }
        y = y + 1;
    }
    # toggle on the press, so one click flips exactly one cell
    if (hh.hot && u.pressed) {
        val ux: usize = ((u.mx - x0) / c)::usize;
        val uy: usize = ((u.my - y0) / c)::usize;
        if (ux < p.w && uy < p.h) {
            var v: u8 = 1;
            if (pattern.get(p, ux, uy) != 0) { v = 0; }
            pattern.set(p, ux, uy, v);
        }
    }
    ui.advance(u, y1 - y0);
}

# pick a pattern to stamp
fun pick(a: *app.App, i: usize) {
    a.pattern_sel = i;
    a.tool        = app.TOOL_STAMP;
}

# the categories to browse, and the custom pattern, two to a row
fun categories(u: *ui.Ui, a: *app.App) {
    val h: f32   = ui.px(u, ui.ROW);
    val n: usize = library.CATEGORY_COUNT + 1;
    var i: usize = 0;
    for (i < n) {
        val col:  usize = i % 2;
        var name: str   = "Custom";
        var on:   bool  = a.pattern_sel == app.CUSTOM && a.tool == app.TOOL_STAMP;
        if (i < library.CATEGORY_COUNT) {
            name = library.category(i).name;
            on   = a.browse == i;
        }
        if (ui.button_at(u, name, ui.cell_x0(u, col, 2), u.y, ui.cell_x1(u, col, 2), u.y + h, on)) {
            if (i < library.CATEGORY_COUNT) {
                a.browse = i;
                a.page   = 0;
            }
            or { pick(a, app.CUSTOM); }
        }
        if (col == 1 || i + 1 == n) { ui.advance(u, h); }
        i = i + 1;
    }
}

# the listed patterns, a page at a time, with the pages to turn
fun list(u: *ui.Ui, a: *app.App, query: str) {
    val l:     *library.Library = ?a.library;
    var total: usize            = 0;
    var i:     usize            = 0;
    for (i < library.count(l)) {
        if (library.listed(l, i, query, a.browse)) { total = total + 1; }
        i = i + 1;
    }
    if (total == 0) {
        ui.note(u, "No pattern has that in its name");
        ret;
    }
    val pages: usize = (total + PAGE_ROWS - 1) / PAGE_ROWS;
    if (a.page >= pages) { a.page = pages - 1; }
    val first: usize = a.page * PAGE_ROWS;
    var k:     usize = 0;
    i = 0;
    for (i < library.count(l) && k < first + PAGE_ROWS) {
        if (library.listed(l, i, query, a.browse)) {
            val on: bool = a.pattern_sel == i && a.tool == app.TOOL_STAMP;
            if (k >= first && ui.button(u, library.name(l, i), on)) { pick(a, i); }
            k = k + 1;
        }
        i = i + 1;
    }
    if (pages == 1) { ret; }
    var at: [48]u8;
    var o:  usize = text.buf_str(?at[0], 0, "Page ");
    o     = text.buf_u64(?at[0], o, (a.page + 1)::u64);
    o     = text.buf_str(?at[0], o, " of ");
    o     = text.buf_u64(?at[0], o, pages::u64);
    at[o] = 0;
    ui.note(u, ?at[0]);
    var turn: [2]str;
    turn[0] = "Previous";
    turn[1] = "Next";
    val t: usize = ui.buttons(u, ?turn[0], 2);
    if (t == 0 && a.page > 0)         { a.page = a.page - 1; }
    if (t == 1 && a.page + 1 < pages) { a.page = a.page + 1; }
}

# the label of an area operation's button
fun area_label(op: u8) str {
    if (op == command.AREA_COPY)          { ret "Copy"; }
    if (op == command.AREA_CUT)           { ret "Cut"; }
    if (op == command.AREA_CLEAR)         { ret "Clear"; }
    if (op == command.AREA_CLEAR_OUTSIDE) { ret "Clear outside"; }
    if (op == command.AREA_FILL)          { ret "Random fill"; }
    if (op == command.AREA_INVERT)        { ret "Invert"; }
    ret "Shrink to fit";
}

# the operations on the selection, two to a row
fun selection(u: *ui.Ui, a: *app.App) {
    if (!a.selected) {
        ui.note(u, "Drag on the world to select");
        ret;
    }
    val h:  f32 = ui.px(u, ui.ROW);
    var op: u8  = 0;
    for (op < command.AREA_COUNT) {
        val col: usize = (op % 2)::usize;
        if (ui.button_at(u, area_label(op), ui.cell_x0(u, col, 2), u.y, ui.cell_x1(u, col, 2), u.y + h, false)) {
            app.area(a, op);
        }
        if (col == 1 || op + 1 == command.AREA_COUNT) { ui.advance(u, h); }
        op = op + 1;
    }
}

# draw the draw section and apply its controls
# ---
# u: the interface
# a: application state
pub fun section(u: *ui.Ui, a: *app.App) {
    if (!ui.heading(u, "DRAW", ?a.open_draw)) { ret; }
    var tools: [4]str;
    tools[0] = "Draw";
    tools[1] = "Erase";
    tools[2] = "Stamp";
    tools[3] = "Select";
    ui.segmented(u, ?tools[0], app.TOOL_COUNT, ?a.tool);
    if (a.tool == app.TOOL_SELECT) {
        selection(u, a);
        ret;
    }

    if (ui.text_field(u, ?a.search, "Search patterns") == ui.FIELD_EDITED) { a.page = 0; }
    val query: str = ui.field_text(?a.search);
    if (query[0] == 0) { categories(u, a); }
    list(u, a, query);

    val p: *pattern.Pattern = active(a);
    if (p == ?a.custom) {
        ui.note(u, "Custom pattern, click cells to edit");
        editor(u, ?a.custom);
        if (ui.button(u, "Clear pattern", false)) { pattern.clear(?a.custom); }
        ret;
    }
    ui.note(u, pattern.name(p));
    val ph: f32 = ui.px(u, PREVIEW);
    preview(u, p, u.x, u.y, u.x + u.w, u.y + ph);
    ui.advance(u, ph);
}
