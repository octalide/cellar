# the narrow surface the interface reads and drives the simulation through
#
# the panels and the readout touch the simulation only here: its generation,
# population and its recent history, the box its live cells span, its rule,
# whether it runs, and painting and stamping by world coordinate. the camera and the cells' draw live in cellar.render and
# cellar.gpu, and the world has no edge, so nothing here names one.

use cellar.history;
use cellar.pattern;
use rules: cellar.rule;
use cellar.sim;
use cellar.space;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# completed generations since the last clear or randomize
pub fun generation(s: *sim.Sim) u64 {
    ret s.generation;
}

# live cells in the world
pub fun population(s: *sim.Sim) usize {
    ret sim.population(s);
}

# recent populations by generation, oldest first
pub fun recent(s: *sim.Sim) *history.History {
    ret ?s.history;
}

# the smallest box holding every live cell, or none when nothing is alive
pub fun bounds(s: *sim.Sim) opt[space.Box] {
    ret sim.bounds(s);
}

# whether the simulation is stepping on its own
pub fun running(s: *sim.Sim) bool {
    ret s.running != 0;
}

# whether the world outgrew its pool and stepping stopped until it is cleared
pub fun full(s: *sim.Sim) bool {
    ret s.full;
}

# start or pause stepping
pub fun toggle(s: *sim.Sim) {
    sim.toggle_running(s);
}

# advance one generation
pub fun step(s: *sim.Sim) {
    sim.step(s);
}

# kill every cell
pub fun clear(s: *sim.Sim) {
    sim.clear(s);
}

# replace the world with a random square side cells across, centred on the origin
pub fun randomize(s: *sim.Sim, side: usize) {
    sim.randomize(s, sim.DEFAULT_DENSITY, side);
}

# the rule being run, for the rule editor
pub fun rule(s: *sim.Sim) *rules.Rule {
    ret ?s.rule;
}

# the preset the rule matches, or none for a custom rule
pub fun rule_preset(s: *sim.Sim) opt[usize] {
    ret rules.match_preset(?s.rule);
}

# the rule's display name: its preset's label, or "custom"
pub fun rule_label(s: *sim.Sim) str {
    ret rules.label(?s.rule);
}

# write the rule's short form for the readout into buf, NUL-terminated
# ---
# s:   the simulation
# buf: at least rules.DISPLAY_MAX + 1 bytes
# ret: buf
pub fun rule_string(s: *sim.Sim, buf: *u8) str {
    ret rules.display(?s.rule, buf);
}

# set the cell at world (x, y) live (v = 1) or dead (v = 0)
pub fun paint(s: *sim.Sim, x: i64, y: i64, v: u8) {
    sim.paint(s, x, y, v);
}

# set every cell on the line from (x0, y0) to (x1, y1), ends included
pub fun line(s: *sim.Sim, x0: i64, y0: i64, x1: i64, y1: i64, v: u8) {
    var dx: i64 = x1 - x0;
    var dy: i64 = y1 - y0;
    var sx: i64 = 1;
    var sy: i64 = 1;
    if (dx < 0) {
        dx = 0 - dx;
        sx = -1;
    }
    if (dy < 0) {
        dy = 0 - dy;
        sy = -1;
    }
    var e: i64 = dx - dy;
    var x: i64 = x0;
    var y: i64 = y0;
    for {
        sim.paint(s, x, y, v);
        if (x == x1 && y == y1) { brk; }
        val e2: i64 = e * 2;
        if (e2 > 0 - dy) {
            e = e - dy;
            x = x + sx;
        }
        if (e2 < dx) {
            e = e + dx;
            y = y + sy;
        }
    }
}

# overlay a pattern's live cells centred on world (x, y)
pub fun stamp(s: *sim.Sim, p: *pattern.Pattern, x: i64, y: i64) {
    pattern.stamp(s, p, x, y);
}

test rule_string__writes_life_and_wide_rules {
    var b: [200]u8;
    var s: sim.Sim;
    sim.set_rule(?s, rules.preset_rule(0));
    rule_string(?s, ?b[0]);
    if (b[0] != 'B' || b[1] != '3' || b[2] != '/' || b[3] != 'S' || b[4] != '2' || b[5] != '3' || b[6] != 0) { ret 1; }
    if (sel s.rule.weighted)                                                                                 { s.rule.weighted.birth = (1::u64 << 3) | (1::u64 << 12); }
    rule_string(?s, ?b[0]);
    # B3,12/S23
    if (b[2] != ',' || b[3] != '1' || b[4] != '2' || b[5] != '/') { ret 2; }
    # survive 23 must take the commas birth needs: B3,12/S2,3
    if (b[6] != 'S' || b[7] != '2' || b[8] != ',' || b[9] != '3' || b[10] != 0) { ret 3; }
    ret 0;
}
