# the narrow surface the interface reads and drives the simulation through
#
# the panels and the readout touch the simulation only here: its generation,
# population and rule, whether it runs, and painting and stamping by world
# coordinate. the camera and the cells' draw live in cellar.render and
# cellar.gpu, and the world has no edge, so nothing here names one.

use cellar.kernel;
use cellar.pattern;
use cellar.sim;
use cellar.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# completed generations since the last clear or randomize
pub fun generation(s: *sim.Sim) u64 {
    ret s.generation;
}

# live cells in the world
pub fun population(s: *sim.Sim) usize {
    ret sim.population(s);
}

# whether the simulation is stepping on its own
pub fun running(s: *sim.Sim) bool {
    ret s.running != 0;
}

# start or pause stepping
pub fun toggle(s: *sim.Sim) {
    sim.toggle_running(s);
}

# advance one generation
pub fun step(s: *sim.Sim) {
    sim.step(s);
}

# kill every cell
pub fun clear(s: *sim.Sim) {
    sim.clear(s);
}

# replace the world with a random square side cells across, centred on the origin
pub fun randomize(s: *sim.Sim, side: usize) {
    sim.randomize(s, sim.DEFAULT_DENSITY, side);
}

# the rule being run, for the kernel editor
pub fun rule(s: *sim.Sim) *kernel.Kernel {
    ret ?s.kernel;
}

# the preset the rule matches, or none for a custom rule
pub fun rule_preset(s: *sim.Sim) opt[usize] {
    ret kernel.match_preset(?s.kernel);
}

# the display name of preset i
pub fun preset_label(i: usize) str {
    if (i == 1) { ret "HighLife"; }
    if (i == 2) { ret "Seeds"; }
    if (i == 3) { ret "Day & Night"; }
    ret "Life";
}

# append a mask's set sums, comma separated once any exceeds nine
fun buf_mask(buf: *u8, off: usize, mask: u64) usize {
    var wide:  bool  = mask >= (1::u64 << 10);
    var o:     usize = off;
    var n:     usize = 0;
    var first: bool  = true;
    for (n < 64) {
        if (kernel.has_bit(mask, n) != 0) {
            if (wide && !first) { o = text.buf_str(buf, o, ","); }
            o     = text.buf_u64(buf, o, n::u64);
            first = false;
        }
        n = n + 1;
    }
    ret o;
}

# write the rule as B.../S... notation into buf, NUL-terminated
# ---
# s:   the simulation
# buf: at least 200 bytes
# ret: buf
pub fun rule_string(s: *sim.Sim, buf: *u8) str {
    var o: usize = text.buf_str(buf, 0, "B");
    o      = buf_mask(buf, o, s.kernel.birth);
    o      = text.buf_str(buf, o, "/S");
    o      = buf_mask(buf, o, s.kernel.survive);
    buf[o] = 0;
    ret buf;
}

# set the cell at world (x, y) live (v = 1) or dead (v = 0)
pub fun paint(s: *sim.Sim, x: i64, y: i64, v: u8) {
    sim.paint(s, x, y, v);
}

# overlay a pattern's live cells centred on world (x, y)
pub fun stamp(s: *sim.Sim, p: *pattern.Pattern, x: i64, y: i64) {
    pattern.stamp(s, p, x, y);
}

test rule_string__writes_life_and_wide_rules {
    var b: [200]u8;
    var s: sim.Sim;
    s.kernel = kernel.life();
    rule_string(?s, ?b[0]);
    if (b[0] != 'B' || b[1] != '3' || b[2] != '/' || b[3] != 'S' || b[4] != '2' || b[5] != '3' || b[6] != 0) { ret 1; }
    s.kernel.birth = (1::u64 << 3) | (1::u64 << 12);
    rule_string(?s, ?b[0]);
    # B3,12/S23
    if (b[2] != ',' || b[3] != '1' || b[4] != '2' || b[5] != '/') { ret 2; }
    ret 0;
}
