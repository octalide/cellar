# the narrow surface the interface reads and drives the simulation through
#
# the panels and the readout read the world only here, from a Shown: its
# generation, population and its recent history, the box its live cells span,
# its rule, the engine holding it and what that can do, and whether it runs, as
# of the last completed generation published to them (cellar.runner). the
# commands drive it through the rest: running, stepping, clearing, and painting
# and stamping by world coordinate. the camera and the cells' draw live in
# cellar.render and cellar.gpu, and the world has no edge, so nothing here
# names one.

use cellar.boundary;
use cellar.ceiling;
use cellar.command;
use cellar.fill;
use cellar.history;
use cellar.pattern;
use rules: cellar.rule;
#[testing]
use cellar.rules.weighted;
use cellar.sim;
use cellar.space;
use allo: std.allocator;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# what the interface shows of the world: one completed generation, copied
# from the simulation by whichever thread holds it (observe), so the panels and
# the readout never read the simulation while it steps
# ---
# generation: completed generations since the last clear or randomize
# population: live cells in the world
# history:    recent populations by generation
# bounds:     the smallest box holding every live cell, or none
# regions:    the world's boundary's regions, and the boxes to frame
# running:    the simulation is stepping on its own
# full:       the world outgrew its pool or the tree's table, and stepping
#             stopped until it is cleared
# reason:     what the world being full means, for a message
# withheld:   why the GPU keeps a pool the host could not take back, which
#             paused the run, or none
# tree:       HashLife holds the world
# caps:       what the engine holding the world can do
# exponent:   the step exponent: a HashLife step advances 2^k generations
# rule:       the rule being run
# flipped:    the pool holds the complement of the world this generation
# chunks:     chunks the pool holds
# shift:      the level of the squares of the tree a drawn cell stands for
# ceilings:   the ceilings a run pauses at
# paused_at:  the ceiling the run is paused at, ceiling.COUNT for none
# pool:       the memory the pool takes and may take
# views:      the pool holds the view layers a colour mode reads, or will
#             once the world leaves the tree (sim.set_views)
# bits:       bits a cell takes in the pool's layers, in the cells stepped
#             from and into
pub rec Shown {
    generation: u64;
    population: usize;
    history:    history.History;
    bounds:     opt[space.Box];
    regions:    sim.Regions;
    running:    bool;
    full:       bool;
    reason:     str;
    withheld:   opt[str];
    tree:       bool;
    caps:       sim.Caps;
    exponent:   u32;
    rule:       rules.Rule;
    flipped:    bool;
    chunks:     usize;
    shift:      u32;
    ceilings:   ceiling.Ceilings;
    paused_at:  usize;
    pool:       sim.PoolMemory;
    views:      bool;
    bits:       u64;
}

# copy what the interface shows of the world, by the thread that holds it
# ---
# s:   the simulation, not stepping
# out: receives the world as it stands
pub fun observe(s: *sim.Sim, out: *Shown) {
    out.generation = s.generation;
    out.population = sim.population(s);
    out.history    = s.history;
    out.bounds     = sim.bounds(s);
    out.regions    = sim.region_view(s);
    out.running    = s.running != 0;
    out.full       = s.full;
    out.reason     = sim.full_reason(s);
    out.withheld   = sim.withheld(s);
    out.tree       = sim.on_tree(s);
    out.caps       = sim.caps(s);
    out.exponent   = sim.exponent(s);
    out.rule       = s.rule;
    out.flipped    = sim.flipped(s);
    out.chunks     = sim.chunks_held(s);
    out.shift      = sim.shown_shift(s);
    out.ceilings   = sim.ceilings(s);
    out.paused_at  = sim.tripped(s);
    out.pool       = sim.pool_memory(s);
    out.views      = sim.views(s);
    out.bits       = sim.cell_bits(s);
}

# the ceiling the run is paused at, ceiling.COUNT for none
pub fun paused_at(v: *Shown) usize {
    ret v.paused_at;
}

# the memory the pool takes and may take
pub fun pool(v: *Shown) sim.PoolMemory {
    ret v.pool;
}

# completed generations since the last clear or randomize
pub fun generation(v: *Shown) u64 {
    ret v.generation;
}

# live cells in the world
pub fun population(v: *Shown) usize {
    ret v.population;
}

# recent populations by generation, oldest first
pub fun recent(v: *Shown) *history.History {
    ret ?v.history;
}

# the smallest box holding every live cell, or none when nothing is alive
pub fun bounds(v: *Shown) opt[space.Box] {
    ret v.bounds;
}

# whether the simulation is stepping on its own
pub fun running(v: *Shown) bool {
    ret v.running;
}

# whether the world outgrew its pool or the tree's table and stepping stopped
# until it is cleared
pub fun full(v: *Shown) bool {
    ret v.full;
}

# the ceilings a run pauses at
pub fun ceilings(v: *Shown) ceiling.Ceilings {
    ret v.ceilings;
}

# why the GPU keeps a pool the host could not take back, or none
pub fun withheld(v: *Shown) opt[str] {
    ret v.withheld;
}

# what the world being full means, for a message
pub fun full_reason(v: *Shown) str {
    ret v.reason;
}

# whether HashLife holds the world
pub fun hashlife(v: *Shown) bool {
    ret v.tree;
}

# whether HashLife can run the rule
pub fun hashlife_runs(v: *Shown) bool {
    ret rules.caps(?v.rule).no_tree == nil;
}

# what the engine holding the world can do
pub fun caps(v: *Shown) sim.Caps {
    ret v.caps;
}

# whether the pool holds the view layers a colour mode reads (sim.set_views)
pub fun views(v: *Shown) bool {
    ret v.views;
}

# bits a cell takes in the pool's layers, in the cells stepped from and into
pub fun cell_bits(v: *Shown) u64 {
    ret v.bits;
}

# the step exponent: a HashLife step advances 2^k generations
pub fun exponent(v: *Shown) u32 {
    ret v.exponent;
}

# the rule being run, for the rule editor
pub fun rule(v: *Shown) *rules.Rule {
    ret ?v.rule;
}

# the preset the rule matches, or none for a custom rule
pub fun rule_preset(v: *Shown) opt[usize] {
    ret rules.match_preset(?v.rule);
}

# the rule's display name: its preset's label, or "custom"
pub fun rule_label(v: *Shown) str {
    ret rules.label(?v.rule);
}

# write the rule's short form for the readout into buf, NUL-terminated
# ---
# v:   the world as shown
# buf: at least rules.DISPLAY_MAX + 1 bytes
# ret: buf
pub fun rule_string(v: *Shown, buf: *u8) str {
    ret rules.display(?v.rule, buf);
}

# start or pause stepping
pub fun toggle(s: *sim.Sim) {
    sim.toggle_running(s);
}

# advance one generation
pub fun step(s: *sim.Sim) {
    sim.step(s);
}

# kill every cell
pub fun clear(s: *sim.Sim) {
    sim.clear(s);
}

# replace the world with a random fill
# ---
# ret: false when the fill is the grid of a world without one
pub fun randomize(s: *sim.Sim, f: *fill.Fill) bool {
    ret sim.randomize_shape(s, f);
}

# choose the boundary region holding a cell, which a region fill fills
pub fun choose_region(s: *sim.Sim, x: i64, y: i64) {
    sim.choose_region(s, x, y);
}

# the mode the pen paints a state in: a dead cell is the eraser's, which takes
# a wall away with the cell, and any other is drawn past the walls
fun pen_mode(v: u8) u8 {
    if (v == 0) { ret sim.EDIT_ERASE; }
    ret sim.EDIT_CELLS;
}

# set the cell at world (x, y) to a state, live (v = 1) or dead (v = 0), a
# dead one erasing a wall there too
pub fun paint(s: *sim.Sim, x: i64, y: i64, v: u8) {
    sim.paint_as(s, x, y, v, pen_mode(v));
}

# set every cell on the line from (x0, y0) to (x1, y1), ends included, as
# paint sets one
pub fun line(s: *sim.Sim, x0: i64, y0: i64, x1: i64, y1: i64, v: u8) {
    line_as(s, x0, y0, x1, y1, v, pen_mode(v));
}

# draw walls with the wall tool: a brush stroke along a line, or a rectangle
# or the ellipse inscribed in one, each wall holding the command's state
# ---
# s:   simulation
# c:   the walls
# ret: why they were not drawn, the world then as it was
pub fun walls(s: *sim.Sim, c: *command.Walls) opt[str] {
    if (c.shape == command.WALLS_LINE) {
        val held: opt[str] = sim.hold_walls(s);
        if (sel held.some) { ret held; }
        line_as(s, c.x0, c.y0, c.x1, c.y1, c.v, sim.EDIT_WALLS);
        ret opt[str].none{};
    }
    var x0: i64 = c.x0;
    var x1: i64 = c.x1;
    var y0: i64 = c.y0;
    var y1: i64 = c.y1;
    if (x1 < x0) {
        x0 = c.x1;
        x1 = c.x0;
    }
    if (y1 < y0) {
        y0 = c.y1;
        y1 = c.y0;
    }
    var r: boundary.Region = boundary.init(s.space.a);
    fin { boundary.dnit(?r); }
    var made: err[allo.Error] = err[allo.Error].ok{};
    if (c.shape == command.WALLS_RECT) { made = boundary.rect(?r, x0, y0, x1 + 1, y1 + 1); }
    or                                 { made = boundary.ellipse(?r, x0, y0, x1 + 1, y1 + 1); }
    if (sel made.err)                  { ret opt[str].some{"the shape could not be held"}; }
    ret sim.paint_region(s, ?r, c.v, sim.EDIT_WALLS);
}

# set every cell on a line as paint does, each write doing mode to walls
fun line_as(s: *sim.Sim, x0: i64, y0: i64, x1: i64, y1: i64, v: u8, mode: u8) {
    var dx: i64 = x1 - x0;
    var dy: i64 = y1 - y0;
    var sx: i64 = 1;
    var sy: i64 = 1;
    if (dx < 0) {
        dx = 0 - dx;
        sx = -1;
    }
    if (dy < 0) {
        dy = 0 - dy;
        sy = -1;
    }
    var e: i64 = dx - dy;
    var x: i64 = x0;
    var y: i64 = y0;
    for {
        sim.paint_as(s, x, y, v, mode);
        if (x == x1 && y == y1) { brk; }
        val e2: i64 = e * 2;
        if (e2 > 0 - dy) {
            e = e - dy;
            x = x + sx;
        }
        if (e2 < dx) {
            e = e + dx;
            y = y + sy;
        }
    }
}

# overlay a pattern's live cells centred on world (x, y)
pub fun stamp(s: *sim.Sim, p: *pattern.Pattern, x: i64, y: i64) {
    pattern.stamp(s, p, x, y);
}

test rule_string__writes_life_and_wide_rules {
    var b: [rules.DISPLAY_MAX + 1]u8;
    var s: Shown;
    s.rule = rules.preset_rule(0);
    rule_string(?s, ?b[0]);
    if (b[0] != 'B' || b[1] != '3' || b[2] != '/' || b[3] != 'S' || b[4] != '2' || b[5] != '3' || b[6] != 0) { ret 1; }
    val k: *weighted.Kernel = rules.view[weighted.Kernel](?s.rule, ?weighted.FAMILY);
    if (k == nil) { ret 1; }
    k.birth.w[0] = (1::u64 << 3) | (1::u64 << 12);
    rule_string(?s, ?b[0]);
    # sums past 8 are named as comma-separated runs, both halves alike
    if (!string.str_equals(?b[0], "B3,12/S2-3")) { ret 2; }
    ret 0;
}
