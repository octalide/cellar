# the panels: every group of controls is a blit window, docked by default into
# a dock space at the window's left or right edge
#
# a panel is data: a title, which is also its window's key, where the default
# layout puts it, whether it starts closed, the size it floats at and the
# page it draws. each one docks, floats, tabs with another and closes through
# blit, and the panels menu (cellar.toolbar) reopens a closed one. one dock
# space fills the window below the toolbar, and its central node is the
# world's: it holds no panel, shows the world through and takes its share of
# the space as the panels around it give theirs up or are dragged wider.
#
# the layout lives in blit's state store, which the settings keep (persist,
# keep) and restore at startup (restore), the docks' sizes with it. with no
# layout to restore, or on reset, the default one is built: patterns and files
# tabbed left of the world, rule, world and view tabbed right of it over the
# stats, and the settings floating, closed.

use blit;
use bctx:  blit.context;
use bdock: blit.dock;
use bid:   blit.id;
use bst:   blit.state;
use bw:    blit.widget;
use cellar.app;
use cellar.arrange;
use cellar.kedit;
use cellar.look;
use cellar.pages;
use cellar.paths;
use cellar.render;
use cellar.sketch;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use std.data.toml;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# unscaled width of a side of the default layout
val WIDTH: f32 = 300.0;
# the most of the space's width a side of the default layout takes
val WIDTH_SHARE: f32 = 0.3;
# the stats' share of the right side's height in the default layout
val STATS_SHARE: f32 = 0.3;
# the dock space's key
val SPACE: str = "dock";

# where a panel goes in the default layout
pub val HOME_LEFT:  u8 = 0;
pub val HOME_RIGHT: u8 = 1;
pub val HOME_STATS: u8 = 2;
pub val HOME_FLOAT: u8 = 3;

# the panels, in the order the menu lists them and the default layout tabs them
pub val PATTERNS: usize = 0;
pub val FILES:    usize = 1;
pub val RULE:     usize = 2;
pub val WORLD:    usize = 3;
pub val VIEW:     usize = 4;
pub val STATS:    usize = 5;
pub val SETTINGS: usize = 6;
pub val COUNT:    usize = 7;

# what a panel draws from
# ---
# l:  cellar's look
# a:  application state
# s:  the world as shown
# p:  the data directory
# sk: the sketches large patterns are drawn from
pub rec Scene {
    l:  look.Look;
    a:  *app.App;
    s:  *world.Shown;
    p:  *paths.Paths;
    sk: *sketch.Sketches;
}

# a panel
# ---
# title: its window's title and key
# home:  where the default layout puts it, a HOME_*
# shut:  it starts closed
# w:     unscaled width it floats at
# h:     unscaled height it floats at
# page:  draws its content into its padded column
pub rec Panel {
    title: str;
    home:  u8;
    shut:  bool;
    w:     f32;
    h:     f32;
    page:  fun(*bctx.Context, *Scene);
}

fun patterns_page(ui: *bctx.Context, sc: *Scene) {
    arrange.patterns(ui, sc.l, sc.a, sc.s, sc.sk);
}

fun files_page(ui: *bctx.Context, sc: *Scene) {
    pages.files_page(ui, sc.l, sc.a, sc.p);
}

fun rule_page(ui: *bctx.Context, sc: *Scene) {
    kedit.panel(ui, sc.l, sc.a, sc.s);
}

fun world_page(ui: *bctx.Context, sc: *Scene) {
    pages.world_page(ui, sc.l, sc.a, sc.s);
}

fun view_page(ui: *bctx.Context, sc: *Scene) {
    pages.view_page(ui, sc.l, sc.a, sc.s);
}

fun stats_page(ui: *bctx.Context, sc: *Scene) {
    pages.stats_page(ui, sc.l, sc.a, sc.s);
}

fun settings_page(ui: *bctx.Context, sc: *Scene) {
    pages.settings_page(ui, sc.l, sc.a, sc.s);
}

# the panel at index i, below COUNT
pub fun panel(i: usize) Panel {
    if (i == FILES)    { ret Panel{title: "Files", home: HOME_LEFT, shut: false, w: WIDTH, h: 480.0, page: files_page}; }
    if (i == RULE)     { ret Panel{title: "Rule", home: HOME_RIGHT, shut: false, w: WIDTH, h: 480.0, page: rule_page}; }
    if (i == WORLD)    { ret Panel{title: "World", home: HOME_RIGHT, shut: false, w: WIDTH, h: 360.0, page: world_page}; }
    if (i == VIEW)     { ret Panel{title: "View", home: HOME_RIGHT, shut: false, w: WIDTH, h: 240.0, page: view_page}; }
    if (i == STATS)    { ret Panel{title: "Stats", home: HOME_STATS, shut: false, w: WIDTH, h: 300.0, page: stats_page}; }
    if (i == SETTINGS) { ret Panel{title: "Settings", home: HOME_FLOAT, shut: true, w: 320.0, h: 500.0, page: settings_page}; }
    ret Panel{title: "Patterns", home: HOME_LEFT, shut: false, w: WIDTH, h: 560.0, page: patterns_page};
}

# a panel's window id, which its title keys at the interface's root
pub fun id(i: usize) u64 {
    ret bid.of_label(bid.ROOT, panel(i).title);
}

# whether a panel is open
pub fun shown(ui: *bctx.Context, i: usize) bool {
    ret bst.get[bw.WindowState](ui, id(i)).closed == 0;
}

# open or close a panel; opening one shows the panels if Tab hid them
pub fun show(ui: *bctx.Context, a: *app.App, i: usize, on: bool) {
    val st: *bw.WindowState = bst.get[bw.WindowState](ui, id(i));
    st.closed = 1;
    if (on) {
        st.closed = 0;
        a.panel   = 1;
    }
    bctx.redraw(ui);
}

# keep every panel's window state while the panels are hidden, so the layout
# the settings save holds them all
fun hold(ui: *bctx.Context) {
    var i: usize = 0;
    for (i < COUNT) {
        bst.pin[bw.WindowState](ui, id(i), 1);
        i = i + 1;
    }
}

# build the default layout in a space laid over an area, undocking every
# panel and opening each as it starts
fun relayout(ui: *bctx.Context, sid: u64, area: bctx.Area) {
    var i: usize = 0;
    for (i < COUNT) {
        bdock.remove(ui, id(i));
        val st: *bw.WindowState = bst.get[bw.WindowState](ui, id(i));
        st.placed    = 0;
        st.collapsed = 0;
        st.closed    = 0;
        if (panel(i).shut) { st.closed = 1; }
        i = i + 1;
    }
    hold(ui);
    # every leaf but the central node collapsed as its last panel left, so the
    # central node is all the tree holds, unless a layout from elsewhere had
    # none: then the space is forgotten and starts over from a new root
    var mid: u64 = bdock.central(ui, sid);
    if (mid == 0) {
        bst.drop[bdock.SpaceState](ui, sid);
        mid = bdock.central(ui, sid);
    }
    val aw:     f32 = area.x1 - area.x0;
    val w:      f32 = side_width(bctx.scale_of(ui), aw);
    val left:   u64 = bdock.split(ui, mid, bctx.Side.left{}, w / aw);
    val right:  u64 = bdock.split(ui, mid, bctx.Side.right{}, w / (aw - w));
    val stats:  u64 = bdock.split(ui, right, bctx.Side.bottom{}, STATS_SHARE);
    var leaves: [3]u64;
    leaves[HOME_LEFT]  = left;
    leaves[HOME_RIGHT] = right;
    leaves[HOME_STATS] = stats;
    var first: [3]bool;
    first[0] = true;
    first[1] = true;
    first[2] = true;
    i        = 0;
    for (i < COUNT) {
        val h: u8 = panel(i).home;
        if (h != HOME_FLOAT) { bdock.add(ui, leaves[h], id(i)); }
        i = i + 1;
    }
    # each leaf shows its first tab, which adding the rest moved off
    i = 0;
    for (i < COUNT) {
        val h: u8 = panel(i).home;
        if (h != HOME_FLOAT && first[h]) {
            bdock.select(ui, id(i));
            first[h] = false;
        }
        i = i + 1;
    }
}

# make the layout persist with the interface's state store: the dock spaces,
# where each panel docks, and each window's place and open state
# ---
# ui:  the interface
# ret: ok, or the registry's refusal
pub fun persist(ui: *bctx.Context) err[bst.Error] {
    val d: err[bst.Error] = bdock.persist(ui);
    if (sel d.err) { ret d; }
    val w: err[bst.Error] = bw.persist_windows(ui);
    if (sel w.err) { ret w; }
    bst.keep[bw.WindowState](ui, 1);
    ret err[bst.Error].ok{};
}

# restore the layout the settings kept, or ask for the default one when they
# kept none, it does not read or it has no place for the world
# ---
# ui: the interface, persisting (see persist)
# a:  application state, its settings loaded
pub fun restore(ui: *bctx.Context, a: *app.App) {
    a.relayout = true;
    if (a.layout.len == 0) { ret; }
    val read: err[toml.TomlError] = bst.load(ui, a.layout.data::str);
    if (sel read.err) { ret; }
    # a layout whose space has no central node leaves the world no place
    if (bdock.central(ui, bctx.id_of(ui, SPACE)) == 0) { ret; }
    hold(ui);
    a.relayout = false;
}

# keep the layout for the settings to save
# ---
# ui: the interface, persisting
# a:  application state
pub fun keep(ui: *bctx.Context, a: *app.App) {
    val doc: res[str, allo.Error] = bst.save(ui);
    if (sel doc.err) { ret; }
    app.keep_layout(a, doc.ok::*u8, string.str_len(doc.ok));
}

# the width of a side of the default layout at interface scale s in a space
# sw wide
fun side_width(s: f32, sw: f32) f32 {
    var w: f32 = WIDTH * s;
    if (w > sw * WIDTH_SHARE) { w = sw * WIDTH_SHARE; }
    ret w;
}

# the whole pixels inside an area
fun inside(r: bctx.Area) render.Port {
    val x0: f32 = (r.x0 + 0.999)::i64::f32;
    val y0: f32 = (r.y0 + 0.999)::i64::f32;
    var w:  f32 = r.x1::i64::f32 - x0;
    var h:  f32 = r.y1::i64::f32 - y0;
    if (w < 1.0) { w = 1.0; }
    if (h < 1.0) { h = 1.0; }
    ret render.Port{x0: x0, y0: y0, w: w, h: h};
}

# lay the dock space over what the toolbar left, and give its central node to
# the world; call at the interface's root after the toolbar. while Tab hides
# the interface the world takes all the window
# ---
# ui:  the interface, its frame begun
# a:   application state
# ret: the world's port
pub fun docks(ui: *bctx.Context, a: *app.App) render.Port {
    val free: bctx.Area = bctx.free_area(ui);
    val sid:  u64       = bctx.id_of(ui, SPACE);
    if (a.relayout) {
        relayout(ui, sid, free);
        a.relayout = false;
    }
    if (a.panel == 0) { ret inside(free); }
    bdock.space(ui, SPACE, free);
    val mid: opt[bctx.Area] = bdock.central_area(ui, sid);
    if (sel mid.some) { ret inside(mid.some); }
    ret inside(free);
}

# draw the panels and apply their controls; call after docks
# ---
# ui: the interface
# sc: what the panels draw from
pub fun draw(ui: *bctx.Context, sc: *Scene) {
    val a:     *app.App = sc.a;
    var drawn: [COUNT]bool;
    var i:     usize    = 0;
    for (i < COUNT) {
        drawn[i] = false;
        i        = i + 1;
    }
    i = 0;
    for (a.panel != 0 && i < COUNT) {
        val p:   Panel         = panel(i);
        val s:   f32           = bctx.scale_of(ui);
        val w:   f32           = p.w * s;
        val h:   f32           = p.h * s;
        var win: bw.Window     = bw.window(p.title, (ui.sw - w) / 2.0, (ui.sh - h) / 3.0, w, h);
        val wa:  bw.WindowArea = bw.begin_window(ui, win);
        if (wa.body != 0) {
            p.page(ui, sc);
            drawn[i] = true;
        }
        bw.end_window(ui, wa);
        i = i + 1;
    }
    if (!drawn[RULE]) { kedit.idle(a); }
    a.files_seen = drawn[FILES];
}
