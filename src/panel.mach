# the side panel: every control, grouped by task into collapsible sections
#
# run for stepping, speed and the population graph, draw for the tool and the patterns, rule for the
# kernel, view for colour and the camera, and files for the named worlds and
# patterns in the data directory.
# the panel is docked to the right edge and scrolls when its sections are
# taller than the window. on a narrow window it floats over the world rather
# than squeezing it.

use gfx: boom.graphics;
use cellar.app;
use cellar.arrange;
use cellar.command;
use cellar.hashlife;
use cellar.history;
use cellar.kedit;
use cellar.paths;
use cellar.pattern;
use cellar.render;
use cellar.saves;
use cellar.sim;
use cellar.text;
use cellar.theme;
use cellar.ui;
use cellar.world;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# unscaled panel width and header height
val WIDTH:  f32 = 300.0;
val HEADER: f32 = 48.0;
# below this many unscaled pixels of window, the panel floats over the world
val DOCK_MIN: f32 = 760.0;
# unscaled height of the population graph
val GRAPH: f32 = 64.0;
# the version shown in the header
val VERSION: str = $mach.project.version;

# the panel's width in pixels for a window sw wide
fun width(u: *ui.Ui, sw: f32) f32 {
    var w: f32 = ui.px(u, WIDTH);
    if (w > sw * 0.85) { w = sw * 0.85; }
    ret w;
}

# the panel's left edge, or sw when it is hidden
pub fun left(u: *ui.Ui, a: *app.App, sw: f32) f32 {
    if (a.panel == 0) { ret sw; }
    ret sw - width(u, sw);
}

# the part of the window the world shows through
pub fun port(u: *ui.Ui, a: *app.App, sw: f32, sh: f32) render.Port {
    var w: f32 = left(u, a, sw);
    if (sw < ui.px(u, DOCK_MIN)) { w = sw; }
    ret render.Port{w: w, h: sh};
}

# the areas randomize can fill, in two rows of four
fun areas(u: *ui.Ui, a: *app.App) {
    var names: [8]str;
    names[0] = "32";
    names[1] = "64";
    names[2] = "128";
    names[3] = "256";
    names[4] = "512";
    names[5] = "1k";
    names[6] = "2k";
    names[7] = "4k";
    val h: f32   = ui.px(u, ui.ROW);
    var i: usize = 0;
    for (i < app.BOUNDS_COUNT) {
        val c: usize = i % 4;
        if (ui.button_at(u, names[i], ui.cell_x0(u, c, 4), u.y, ui.cell_x1(u, c, 4), u.y + h, a.bounds_idx == i)) {
            a.bounds_idx = i;
        }
        if (c == 3) { ui.advance(u, h); }
        i = i + 1;
    }
}

# the population over the recent samples, each held until the generation of
# the next, and scaled so the largest fills the height
fun graph(u: *ui.Ui, s: *sim.Sim) {
    val h:  *history.History = world.recent(s);
    val x0: f32              = u.x;
    val x1: f32              = u.x + u.w;
    val y0: f32              = u.y;
    val y1: f32              = u.y + ui.px(u, GRAPH);
    ui.rect(u, x0, y0, x1, y1, theme.WORLD, 1.0);
    val peak: u64 = history.peak(h);
    if (h.len != 0 && peak != 0) {
        val pad:   f32   = ui.px(u, 4.0);
        val first: u64   = history.gen_at(h, 0);
        val span:  f32   = (history.gen_at(h, h.len - 1) - first + 1)::f32;
        val gw:    f32   = (x1 - x0 - pad * 2.0) / span;
        val gh:    f32   = y1 - y0 - pad * 2.0;
        var i:     usize = 0;
        for (i < h.len) {
            var end: f32 = span;
            if (i + 1 < h.len) { end = (history.gen_at(h, i + 1) - first)::f32; }
            val l:   f32 = x0 + pad + (history.gen_at(h, i) - first)::f32 * gw;
            val r:   f32 = x0 + pad + end * gw;
            val top: f32 = y1 - pad - gh * history.pop_at(h, i)::f32 / peak::f32;
            ui.rect(u, l, top, r, y1 - pad, theme.ACCENT, 0.8);
            i = i + 1;
        }
    }
    ui.advance(u, y1 - y0);
    var rd: [48]u8;
    var o:  usize = text.buf_str(?rd[0], 0, "Population, peak ");
    o     = text.buf_u64(?rd[0], o, peak);
    rd[o] = 0;
    ui.note(u, ?rd[0]);
}

fun run(u: *ui.Ui, a: *app.App, s: *sim.Sim) {
    if (!ui.heading(u, "RUN", ?a.open_run)) { ret; }
    val h:  f32 = ui.px(u, ui.ROW);
    var go: str = "Play";
    if (world.running(s))                                                                              { go = "Pause"; }
    if (ui.button_at(u, go, ui.cell_x0(u, 0, 3), u.y, ui.cell_x1(u, 0, 3), u.y + h, world.running(s))) { app.submit(a, command.Command.toggle{}); }
    if (ui.button_at(u, "Step", ui.cell_x0(u, 1, 3), u.y, ui.cell_x1(u, 1, 3), u.y + h, false))        { app.submit(a, command.Command.step{}); }
    if (ui.button_at(u, "Reset", ui.cell_x0(u, 2, 3), u.y, ui.cell_x1(u, 2, 3), u.y + h, false))       { app.submit(a, command.Command.reset{}); }
    ui.advance(u, h);
    graph(u, s);

    var rd: [32]u8;
    var o:  usize = 0;
    if (a.uncapped != 0) { o = text.buf_str(?rd[0], 0, "as fast as it goes"); }
    or {
        o = text.buf_u64(?rd[0], 0, (a.speed + 0.5)::u64);
        o = text.buf_str(?rd[0], o, " gen/s");
    }
    rd[o] = 0;
    ui.slider(u, "Speed", ?rd[0], ?a.speed, 1.0, 120.0);
    ui.toggle(u, "Uncapped", ?a.uncapped);

    var acts: [2]str;
    acts[0] = "Randomize";
    acts[1] = "Clear";
    val hit: usize = ui.buttons(u, ?acts[0], 2);
    if (hit == 0) { app.submit(a, command.Command.randomize{app.bounds_size(a.bounds_idx)}); }
    if (hit == 1) { app.submit(a, command.Command.clear{}); }
    ui.note(u, "Randomize fills a square this wide");
    areas(u, a);
    engine(u, a, s);
}

# the engine choice, and on HashLife the step exponent and going to a generation
fun engine(u: *ui.Ui, a: *app.App, s: *sim.Sim) {
    ui.note(u, "Engine");
    val on: bool = world.hashlife(s);
    if (!on && !world.hashlife_runs(s)) {
        ui.note(u, "HashLife runs radius 1 rules without B0, unbounded");
        ret;
    }
    var names: [2]str;
    names[0] = "Chunks";
    names[1] = "HashLife";
    var pick: usize = 0;
    if (on)                                   { pick = 1; }
    if (ui.segmented(u, ?names[0], 2, ?pick)) { app.submit(a, command.Command.engine{pick == 1}); }
    if (!on)                                  { ret; }

    val k:  u32   = world.exponent(s);
    var rd: [32]u8;
    var o:  usize = text.buf_str(?rd[0], 0, "2^");
    o     = text.buf_u64(?rd[0], o, k::u64);
    o     = text.buf_str(?rd[0], o, " gens");
    rd[o] = 0;
    var v: f32 = k::f32;
    if (ui.slider(u, "Step", ?rd[0], ?v, 0.0, hashlife.MAX_EXPONENT::f32)) {
        val nk: u32 = (v + 0.5)::u32;
        if (nk != k) { app.submit(a, command.Command.exponent{nk}); }
    }

    val typed: u8   = ui.text_field(u, ?a.go_to, "Generation to go to");
    val go:    bool = ui.button(u, "Go to generation", false);
    if (go || typed == ui.FIELD_ENTERED) {
        val t:   str   = ui.field_text(?a.go_to);
        var gen: u64   = 0;
        var i:   usize = 0;
        for (t[i] != 0) {
            gen = gen * 10 + (t[i] - '0')::u64;
            i   = i + 1;
        }
        if (i == 0) { app.say(a, "type a generation to go to"); }
        or          { app.submit(a, command.Command.jump{gen}); }
    }
}

fun look(u: *ui.Ui, a: *app.App, s: *sim.Sim) {
    if (!ui.heading(u, "VIEW", ?a.open_view)) { ret; }
    # the colour modes are what the engine keeps: trails need heat and age needs age
    val c:     sim.Caps = world.caps(s);
    val solid: bool     = a.mode == render.MODE_SOLID::usize || !c.heat || !c.age;
    if (c.heat && c.age) {
        var modes: [3]str;
        modes[0] = "Solid";
        modes[1] = "Trails";
        modes[2] = "Age";
        ui.segmented(u, ?modes[0], app.MODE_COUNT, ?a.mode);
    }
    or { ui.note(u, "HashLife keeps no heat or age, so draws solid"); }

    if (solid) {
        val n:  usize = theme.SWATCH_COUNT;
        val g:  f32   = ui.px(u, 4.0);
        val sz: f32   = (u.w - g * (n - 1)::f32) / n::f32;
        var i:  usize = 0;
        for (i < n) {
            val x0: f32    = u.x + i::f32 * (sz + g);
            val hh: ui.Hit = ui.region(u, x0, u.y, x0 + sz, u.y + sz);
            val c:  u32    = theme.swatch(i);
            if (c == a.solid) { ui.frame(u, x0, u.y, x0 + sz, u.y + sz, ui.px(u, 2.0), theme.TEXT, 1.0); }
            or (hh.hot)       { ui.frame(u, x0, u.y, x0 + sz, u.y + sz, ui.px(u, 2.0), theme.TEXT_DIM, 1.0); }
            val inset: f32 = ui.px(u, 4.0);
            ui.rect(u, x0 + inset, u.y + inset, x0 + sz - inset, u.y + sz - inset, c, 1.0);
            if (hh.clicked) { a.solid = c; }
            i = i + 1;
        }
        ui.advance(u, sz);
    }
    ui.toggle(u, "Grid lines", ?a.gutter);

    ui.note(u, "Interface size");
    var scales: [4]str;
    scales[0] = "100%";
    scales[1] = "125%";
    scales[2] = "150%";
    scales[3] = "200%";
    ui.segmented(u, ?scales[0], app.SCALE_COUNT, ?a.scale_idx);

    if (ui.button(u, "Frame the randomize area", false)) { app.frame_area(a); }
}

# show as much of the end of a long string as fits in w pixels
fun tail(f: *gfx.Font, s: str, w: f32) str {
    var t: str = s;
    for (t[0] != 0 && ui.measure(f, t) > w) { t = ?t[1]; }
    ret t;
}

# save the world or the custom pattern under the typed name
fun save(a: *app.App, p: *paths.Paths, kind: u8) {
    val name: str = ui.field_text(?a.name);
    if (!saves.usable(name)) {
        app.say(a, "type a name to save under");
        ret;
    }
    var fname: [80]u8;
    var path:  [1152]u8;
    paths.file(p, saves.file_name(name, kind, ?fname[0]), ?path[0]);
    val f: opt[command.File] = app.file(a, ?path[0]);
    if (sel f.none)               { ret; }
    if (kind == saves.KIND_WORLD) { app.submit(a, command.Command.save_world{f.some}); }
    or                            { app.submit(a, command.Command.save_pattern{f.some}); }
}

# load a listed file, a world as the world and a pattern as the custom pattern,
# and take its name as the one to save under
fun load(a: *app.App, p: *paths.Paths, e: *saves.Entry) {
    var name: [80]u8;
    ui.field_set(?a.name, saves.stem(e.name, ?name[0]));
    var path: [1152]u8;
    paths.file(p, e.name, ?path[0]);
    val f: opt[command.File] = app.file(a, ?path[0]);
    if (sel f.none)                 { ret; }
    if (e.kind == saves.KIND_WORLD) { app.submit(a, command.Command.load_world{f.some}); }
    or                              { app.submit(a, command.Command.load_pattern{f.some}); }
}

# a listed file as a row, its kind at the right; ret whether it was clicked
fun entry(u: *ui.Ui, e: *saves.Entry) bool {
    val h:    f32    = ui.px(u, 24.0);
    val x0:   f32    = u.x;
    val y0:   f32    = u.y;
    val x1:   f32    = u.x + u.w;
    val y1:   f32    = u.y + h;
    val hh:   ui.Hit = ui.region(u, x0, y0, x1, y1);
    val pad:  f32    = ui.px(u, 8.0);
    var kind: str    = "pattern";
    if (e.kind == saves.KIND_WORLD) { kind = "world"; }
    if (hh.hot || hh.held)          { ui.rect(u, x0, y0, x1, y1, ui.fill(hh, false), 1.0); }
    val kw: f32 = ui.measure(u.small, kind);
    ui.text_mid(u, u.body, tail(u.body, e.name, x1 - x0 - kw - pad * 3.0), x0 + pad, y0, y1, theme.TEXT, 1.0);
    ui.text_mid(u, u.small, kind, x1 - pad - kw, y0, y1, theme.TEXT_DIM, 1.0);
    u.y = y1 + ui.px(u, 2.0);
    ret hh.clicked;
}

fun files(u: *ui.Ui, a: *app.App, p: *paths.Paths) {
    val was: u8 = a.open_files;
    if (!ui.heading(u, "FILES", ?a.open_files)) { ret; }
    if (!p.ok) {
        ui.note(u, "no user data directory is known");
        ret;
    }
    # read the directory as the section opens and after each save
    if (was == 0) { a.saves.stale = true; }
    if (a.saves.stale) {
        val listed: err[fs.FsError] = saves.refresh(?a.saves, paths.dir(p));
        if (sel listed.err) { app.say(a, "the data directory could not be read"); }
    }

    ui.text_field(u, ?a.name, "Name to save as");
    var sl: [2]str;
    sl[0] = "Save world";
    sl[1] = "Save pattern";
    val w: usize = ui.buttons(u, ?sl[0], 2);
    if (w == 0) { save(a, p, saves.KIND_WORLD); }
    if (w == 1) { save(a, p, saves.KIND_PATTERN); }

    if (a.saves.items.len == 0) { ui.note(u, "No saved worlds or patterns yet"); }
    or                          { ui.note(u, "Click a world to load it, a pattern to edit it"); }
    var i: usize = 0;
    for (i < a.saves.items.len) {
        if (entry(u, ?a.saves.items.data[i])) { load(a, p, ?a.saves.items.data[i]); }
        i = i + 1;
    }
    ui.space(u, 4.0);
    if (ui.button(u, "Screenshot", false)) { a.shot = true; }
    ui.note(u, tail(u.small, paths.dir(p), u.w));
}

# the header: name, version, and the help and hide buttons
fun header(u: *ui.Ui, a: *app.App, x0: f32, x1: f32) {
    val h: f32 = ui.px(u, HEADER);
    ui.rect(u, x0, 0.0, x1, h, theme.HEADER, 1.0);
    ui.rect(u, x0, h - 1.0, x1, h, theme.PANEL_EDGE, 1.0);
    val pad: f32 = ui.px(u, ui.PAD);
    val pen: f32 = ui.text_mid(u, u.body, "cellar", x0 + pad, 0.0, h, theme.TEXT, 1.0);
    ui.text_mid(u, u.small, VERSION, pen + ui.px(u, 8.0), 0.0, h, theme.TEXT_FAINT, 1.0);

    val b:  f32 = ui.px(u, 28.0);
    val by: f32 = (h - b) / 2.0;
    val hx: f32 = x1 - pad - b;
    if (ui.button_at(u, "»", hx, by, hx + b, by + b, false))                                       { a.panel = 0; }
    if (ui.button_at(u, "?", hx - b - ui.px(u, 6.0), by, hx - ui.px(u, 6.0), by + b, a.help != 0)) { a.help = 1 - a.help; }
}

# the tab that brings a hidden panel back
fun restore(u: *ui.Ui, a: *app.App, sw: f32) {
    val b: f32 = ui.px(u, 28.0);
    val m: f32 = ui.px(u, 10.0);
    ui.block(u, sw - m - b, m, sw - m, m + b);
    if (ui.button_at(u, "«", sw - m - b, m, sw - m, m + b, false)) { a.panel = 1; }
}

# draw the panel and apply its controls
# ---
# u:  the interface
# a:  application state
# s:  the simulation, locked by the caller
# p:  the data directory
# sw: window width in pixels
# sh: window height in pixels
pub fun draw(u: *ui.Ui, a: *app.App, s: *sim.Sim, p: *paths.Paths, sw: f32, sh: f32) {
    if (a.panel == 0) {
        a.side_x0 = sw;
        restore(u, a, sw);
        ret;
    }
    val x0: f32 = left(u, a, sw);
    a.side_x0 = x0;
    ui.block(u, x0, 0.0, sw, sh);
    ui.rect(u, x0, 0.0, sw, sh, theme.PANEL, 1.0);
    ui.rect(u, x0, 0.0, x0 + 1.0, sh, theme.PANEL_EDGE, 1.0);

    val top:  f32 = ui.px(u, HEADER);
    var most: f32 = a.content - (sh - top);
    if (most < 0.0)      { most = 0.0; }
    if (a.scroll > most) { a.scroll = most; }
    if (a.scroll < 0.0)  { a.scroll = 0.0; }

    val pad: f32 = ui.px(u, ui.PAD);
    val y0:  f32 = top + ui.px(u, 8.0) - a.scroll;
    ui.column(u, x0 + pad, y0, sw - x0 - pad * 2.0);
    run(u, a, s);
    arrange.section(u, a);
    kedit.section(u, a, s);
    look(u, a, s);
    files(u, a, p);
    a.content = u.y - y0 + ui.px(u, 12.0);

    # drawn last, so content scrolled up passes under it
    header(u, a, x0, sw);
}
