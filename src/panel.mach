# the side panel: every control, grouped by task into collapsible sections
#
# run for stepping, speed, the population graph, the engine and the ceilings a
# run pauses at, draw for the tool and the patterns, rule for the kernel, view
# for colour and the camera, and files for the named worlds and patterns in
# the data directory. the panel is a blit side panel docked to the window's
# right edge, its body scrolling when its sections are taller than the
# window, under a header pinned over its top. on a narrow window the world
# runs on under it rather than squeezing beside it (see port).

use blit;
use bctx:  blit.context;
use bdock: blit.dock;
use binp:  blit.input;
use bint:  blit.interact;
use blay:  blit.layout;
use bov:   blit.overlay;
use bth:   blit.theme;
use bw:    blit.widget;
use cellar.app;
use cellar.arrange;
use cellar.ceiling;
use cellar.command;
use cellar.hashlife;
use cellar.history;
use cellar.kedit;
use cellar.look;
use cellar.paths;
use cellar.render;
use cellar.saves;
use cellar.sim;
use cellar.sketch;
use cellar.text;
use cellar.theme;
use cellar.world;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# unscaled panel width
val WIDTH: f32 = 300.0;
# below this many unscaled pixels of window, the world runs on under the panel
val DOCK_MIN: f32 = 760.0;
# unscaled height of the population graph
val GRAPH: f32 = 64.0;
# unscaled side of the header's buttons and the restore button
val BUTTON: f32 = 28.0;
# the version shown in the header
val VERSION: str = $mach.project.version;

# the panel's width in pixels for a window sw wide at interface scale s
fun width(s: f32, sw: f32) f32 {
    var w: f32 = WIDTH * s;
    if (w > sw * 0.85) { w = sw * 0.85; }
    ret w;
}

# the part of the window the world shows through, at interface scale s
# ---
# a:   application state
# s:   the interface scale
# sw:  window width in pixels
# sh:  window height in pixels
# ret: the port, the whole window while the panel is hidden or the window narrow
pub fun port(a: *app.App, s: f32, sw: f32, sh: f32) render.Port {
    var w: f32 = sw;
    if (a.panel != 0 && sw >= DOCK_MIN * s) { w = sw - width(s, sw); }
    ret render.Port{w: w, h: sh};
}

# the population over the recent samples, each held until the generation of
# the next, and scaled so the largest fills the height
fun graph(ui: *bctx.Context, l: look.Look, s: *world.Shown) {
    val h:  *history.History = world.recent(s);
    val gh: f32              = bctx.px(ui, GRAPH);
    val r:  bctx.Area        = bw.place(ui, blay.fill(1.0), blay.fixed(gh), 0.0, gh);
    bctx.quad(ui, r.x0, r.y0, r.x1, r.y1, look.colour(theme.WORLD, 1.0));
    val peak: u64 = history.peak(h);
    if (h.len != 0 && peak != 0) {
        val pad:   f32             = bctx.px(ui, 4.0);
        val first: u64             = history.gen_at(h, 0);
        val span:  f32             = (history.gen_at(h, h.len - 1) - first + 1)::f32;
        val gw:    f32             = (r.x1 - r.x0 - pad * 2.0) / span;
        val ht:    f32             = r.y1 - r.y0 - pad * 2.0;
        val bar:   blit.draw.Color = look.colour(theme.ACCENT, 0.8);
        var i:     usize           = 0;
        for (i < h.len) {
            var end: f32 = span;
            if (i + 1 < h.len) { end = (history.gen_at(h, i + 1) - first)::f32; }
            val x0:  f32 = r.x0 + pad + (history.gen_at(h, i) - first)::f32 * gw;
            val x1:  f32 = r.x0 + pad + end * gw;
            val top: f32 = r.y1 - pad - ht * history.pop_at(h, i)::f32 / peak::f32;
            bctx.quad(ui, x0, top, x1, r.y1 - pad, bar);
            i = i + 1;
        }
    }
    var rd: [48]u8;
    var o:  usize = text.buf_str(?rd[0], 0, "Population, peak ");
    o     = text.buf_u64(?rd[0], o, peak);
    rd[o] = 0;
    look.note(ui, l, ?rd[0]);
}

fun run(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    if (!look.heading(ui, l, "RUN", ?a.open_run)) { ret; }
    var acts: [3]str;
    acts[0] = "Play###go";
    acts[1] = "Step";
    acts[2] = "Reset";
    var on: usize = 3;
    if (world.running(s)) {
        acts[0] = "Pause###go";
        on      = 0;
    }
    val hit: usize = bw.button_grid(ui, ?acts[0], 3, 3, on);
    if (hit == 0) { app.submit(a, command.Command.toggle{}); }
    if (hit == 1) { app.submit(a, command.Command.step{}); }
    if (hit == 2) { app.submit(a, command.Command.reset{}); }
    graph(ui, l, s);

    var rd: [32]u8;
    var o:  usize = 0;
    if (a.uncapped != 0) { o = text.buf_str(?rd[0], 0, "as fast as it goes"); }
    or {
        o = text.buf_u64(?rd[0], 0, (a.speed + 0.5)::u64);
        o = text.buf_str(?rd[0], o, " gen/s");
    }
    rd[o] = 0;
    bw.slider(ui, "Speed", ?rd[0], ?a.speed, 1.0, 120.0);
    bw.toggle(ui, "Uncapped", ?a.uncapped);

    var more: [2]str;
    more[0] = "Randomize";
    more[1] = "Clear";
    val act: usize = bw.buttons(ui, ?more[0], 2);
    if (act == 0) { app.submit(a, command.Command.randomize{app.bounds_size(a.bounds_idx)}); }
    if (act == 1) { app.submit(a, command.Command.clear{}); }
    look.note(ui, l, "Randomize fills a square this wide");
    var areas: [8]str;
    areas[0] = "32";
    areas[1] = "64";
    areas[2] = "128";
    areas[3] = "256";
    areas[4] = "512";
    areas[5] = "1k";
    areas[6] = "2k";
    areas[7] = "4k";
    val area: usize = bw.button_grid(ui, ?areas[0], app.BOUNDS_COUNT, 4, a.bounds_idx);
    if (area < app.BOUNDS_COUNT) { a.bounds_idx = area; }
    engine(ui, l, a, s);
    ceilings(ui, l, a, s);
}

# the ceilings a run pauses at, each switched on or off, its limit dragged along
# 1, 2 and 5 times the powers of ten
fun ceilings(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    look.note(ui, l, "Pause a run that passes");
    var c:       ceiling.Ceilings = world.ceilings(s);
    var changed: bool             = false;
    var k:       usize            = 0;
    for (k < ceiling.COUNT) {
        bctx.push_id_int(ui, k::u64);
        var on: u8 = 0;
        if (c.on[k]) { on = 1; }
        if (bw.toggle(ui, ceiling.label(k), ?on)) {
            c.on[k] = on != 0;
            changed = true;
        }
        if (c.on[k]) {
            var rd: [48]u8;
            var o:  usize = text.buf_grouped(?rd[0], 0, c.limit[k]);
            o     = text.buf_str(?rd[0], o, " ");
            o     = text.buf_str(?rd[0], o, ceiling.unit(k));
            rd[o] = 0;
            var v: f32 = ceiling.notch_of(c.limit[k])::f32;
            if (bw.slider(ui, "Limit", ?rd[0], ?v, ceiling.notch_lo(k)::f32, ceiling.notch_hi(k)::f32)) {
                val n: u64 = ceiling.notch((v + 0.5)::usize);
                if (n != c.limit[k]) {
                    c.limit[k] = n;
                    changed    = true;
                }
            }
        }
        bctx.pop_id(ui);
        k = k + 1;
    }
    if (changed) { app.submit(a, command.Command.ceilings{c}); }
}

# the engine choice, and on HashLife the step exponent and going to a generation
fun engine(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    look.note(ui, l, "Engine");
    val on: bool = world.hashlife(s);
    if (!on && !world.hashlife_runs(s)) {
        look.note(ui, l, "HashLife runs radius 1 rules without B0 on the unbounded plane");
        ret;
    }
    var names: [2]str;
    names[0] = "Chunks";
    names[1] = "HashLife";
    var pick: usize = 0;
    if (on) { pick = 1; }
    if (bw.segmented(ui, ?names[0], 2, ?pick)) {
        a.engine_tree = pick == 1;
        app.submit(a, command.Command.engine{pick == 1});
    }
    if (!on) { ret; }

    val k:  u32   = world.exponent(s);
    var rd: [32]u8;
    var o:  usize = text.buf_str(?rd[0], 0, "2^");
    o     = text.buf_u64(?rd[0], o, k::u64);
    o     = text.buf_str(?rd[0], o, " gens");
    rd[o] = 0;
    var v: f32 = k::f32;
    if (bw.slider(ui, "Step###exponent", ?rd[0], ?v, 0.0, hashlife.MAX_EXPONENT::f32)) {
        val nk: u32 = (v + 0.5)::u32;
        if (nk != k) { app.submit(a, command.Command.exponent{nk}); }
    }

    val typed: u8   = bw.text_field(ui, "go to", ?a.go_to, "Generation to go to");
    val go:    bool = bw.button(ui, "Go to generation");
    if (go || (typed & blit.field.ENTERED) != 0) {
        val t:   str   = blit.field.text(?a.go_to);
        var gen: u64   = 0;
        var i:   usize = 0;
        for (t[i] != 0) {
            gen = gen * 10 + (t[i] - '0')::u64;
            i   = i + 1;
        }
        if (i == 0) { app.say(a, "type a generation to go to"); }
        or          { app.submit(a, command.Command.jump{gen}); }
    }
}

# the solid colours as swatches across the column, the chosen one framed
fun swatches(ui: *bctx.Context, a: *app.App) {
    val n:  usize     = theme.SWATCH_COUNT;
    val av: bctx.Area = bw.avail(ui);
    val g:  f32       = bctx.px(ui, 4.0);
    val sz: f32       = (av.x1 - av.x0 - g * (n - 1)::f32) / n::f32;
    val r:  bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(sz), 0.0, sz);
    val t:  f32       = bctx.px(ui, 2.0);
    val in: f32       = bctx.px(ui, 4.0);
    var i:  usize     = 0;
    for (i < n) {
        val x0: f32 = r.x0 + i::f32 * (sz + g);
        bctx.push_id_int(ui, i::u64);
        val h: bint.Hit = bint.hit(ui, bctx.id_of(ui, "swatch"), x0, r.y0, x0 + sz, r.y0 + sz, binp.BUTTON_LEFT);
        bctx.pop_id(ui);
        val c: u32 = theme.swatch(i);
        if (c == a.solid) { bctx.frame(ui, x0, r.y0, x0 + sz, r.y0 + sz, t, look.colour(theme.TEXT, 1.0)); }
        or (h.hot)        { bctx.frame(ui, x0, r.y0, x0 + sz, r.y0 + sz, t, look.colour(theme.TEXT_DIM, 1.0)); }
        bctx.quad(ui, x0 + in, r.y0 + in, x0 + sz - in, r.y0 + sz - in, look.colour(c, 1.0));
        if (h.clicked) { a.solid = c; }
        i = i + 1;
    }
}

fun view(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown) {
    if (!look.heading(ui, l, "VIEW", ?a.open_view)) { ret; }
    # the colour modes are what the engine keeps: trails need heat and age needs age
    val c:     sim.Caps = world.caps(s);
    val solid: bool     = a.mode == render.MODE_SOLID::usize || !c.heat || !c.age;
    if (c.heat && c.age) {
        var modes: [3]str;
        modes[0] = "Solid";
        modes[1] = "Trails";
        modes[2] = "Age";
        bw.segmented(ui, ?modes[0], app.MODE_COUNT, ?a.mode);
    }
    or         { look.note(ui, l, "HashLife keeps no heat or age, so draws solid"); }
    if (solid) { swatches(ui, a); }
    bw.toggle(ui, "Grid lines", ?a.gutter);

    look.note(ui, l, "Interface size");
    var scales: [4]str;
    scales[0] = "100%";
    scales[1] = "125%";
    scales[2] = "150%";
    scales[3] = "200%";
    bw.segmented(ui, ?scales[0], app.SCALE_COUNT, ?a.scale_idx);

    if (bw.button(ui, "Frame the randomize area")) { app.frame_area(a); }
}

# save the world or the custom pattern under the typed name
fun save(a: *app.App, p: *paths.Paths, kind: u8) {
    val name: str = blit.field.text(?a.name);
    if (!saves.usable(name)) {
        app.say(a, "type a name to save under");
        ret;
    }
    var fname: [80]u8;
    var path:  [1152]u8;
    paths.file(p, saves.file_name(name, kind, ?fname[0]), ?path[0]);
    val f: opt[command.File] = app.file(a, ?path[0]);
    if (sel f.none)               { ret; }
    if (kind == saves.KIND_WORLD) { app.submit(a, command.Command.save_world{f.some}); }
    or                            { app.submit(a, command.Command.save_pattern{f.some}); }
}

# load a listed file, a world as the world and a pattern as the custom pattern,
# taking its name as the one to save under, or run a rule table on the world
fun load(a: *app.App, p: *paths.Paths, e: *saves.Entry) {
    var path: [1152]u8;
    paths.file(p, e.name, ?path[0]);
    val f: opt[command.File] = app.file(a, ?path[0]);
    if (sel f.none) { ret; }
    if (e.kind == saves.KIND_RULE) {
        app.submit(a, command.Command.open{f.some});
        ret;
    }
    var name: [80]u8;
    blit.field.set(?a.name, saves.stem(e.name, ?name[0]));
    if (e.kind == saves.KIND_WORLD) { app.submit(a, command.Command.load_world{f.some}); }
    or                              { app.submit(a, command.Command.load_pattern{f.some}); }
}

# a file's kind as the list shows it
fun kind_name(e: *saves.Entry) str {
    if (e.kind == saves.KIND_WORLD) { ret "world"; }
    if (e.kind == saves.KIND_RULE)  { ret "rule"; }
    ret "pattern";
}

# a listed file as a row, its name cut from the front to fit and its kind at
# the right; ret whether it was clicked
fun entry(ui: *bctx.Context, l: look.Look, e: *saves.Entry) bool {
    val rh:   f32        = bctx.px(ui, 24.0);
    val r:    bctx.Area  = bw.place(ui, blay.fill(1.0), blay.fixed(rh), 0.0, rh);
    val h:    bint.Hit   = bint.hit(ui, bctx.id_of(ui, "file"), r.x0, r.y0, r.x1, r.y1, binp.BUTTON_LEFT);
    val st:   u8         = bth.pick(h.hot, h.active, false, false);
    val ink:  *bth.Paint = bctx.paint_of(ui, bth.LIST_ITEM, st);
    val pad:  f32        = bctx.px(ui, 8.0);
    val kind: str        = kind_name(e);
    bctx.box(ui, bth.LIST_ITEM, st, r.x0, r.y0, r.x1, r.y1);
    bctx.push_style(ui, l.small);
    val kw: f32 = bctx.text_width(ui, kind);
    look.text_mid(ui, kind, r.x1 - pad - kw, r.y0, r.y1, ink.mark);
    bctx.pop_style(ui);
    val ty: f32 = r.y0 + (rh - bctx.line_height(ui)) / 2.0;
    blit.text.fit_at(ui, e.name, r.x0 + pad, ty, r.x1 - r.x0 - kw - pad * 3.0, blit.text.CUT_START, ink.text);
    ret h.clicked;
}

# the end of a path that fits across the column, in the small face
fun path_line(ui: *bctx.Context, l: look.Look, s: str) {
    bctx.push_style(ui, l.small);
    val lh: f32       = bctx.line_height(ui);
    val r:  bctx.Area = bw.place(ui, blay.fill(1.0), blay.fixed(lh), 0.0, lh);
    blit.text.fit_at(ui, s, r.x0, r.y0, r.x1 - r.x0, blit.text.CUT_START, look.colour(theme.TEXT_DIM, 1.0));
    bctx.pop_style(ui);
}

fun files(ui: *bctx.Context, l: look.Look, a: *app.App, p: *paths.Paths) {
    val was: u8 = a.open_files;
    if (!look.heading(ui, l, "FILES", ?a.open_files)) { ret; }
    if (!p.ok) {
        look.note(ui, l, "no user data directory is known");
        ret;
    }
    # read the directory as the section opens and after each save
    if (was == 0) { a.saves.stale = true; }
    if (a.saves.stale) {
        val listed: err[fs.FsError] = saves.refresh(?a.saves, paths.dir(p));
        if (sel listed.err) { app.say(a, "the data directory could not be read"); }
    }

    bw.text_field(ui, "name", ?a.name, "Name to save as");
    var sl: [2]str;
    sl[0] = "Save world";
    sl[1] = "Save pattern";
    val w: usize = bw.buttons(ui, ?sl[0], 2);
    if (w == 0) { save(a, p, saves.KIND_WORLD); }
    if (w == 1) { save(a, p, saves.KIND_PATTERN); }

    if (a.saves.items.len == 0) { look.note(ui, l, "No saved worlds or patterns yet"); }
    or {
        look.note(ui, l, "Click a world to load it, a pattern to edit it, a rule to run it");
        var i: usize = 0;
        for (i < a.saves.items.len) {
            bctx.push_id_int(ui, i::u64);
            val clicked: bool = entry(ui, l, ?a.saves.items.data[i]);
            bctx.pop_id(ui);
            if (clicked) { load(a, p, ?a.saves.items.data[i]); }
            i = i + 1;
        }
    }
    bw.space(ui, bctx.px(ui, 4.0));
    if (bw.button(ui, "Screenshot")) { a.shot = true; }
    path_line(ui, l, paths.dir(p));
}

# the header pinned over the panel's top: name, version, and the help and
# hide buttons; it claims its strip, so the sections scrolled under it are
# out of reach there
fun header(ui: *bctx.Context, l: look.Look, a: *app.App, r: bctx.Area) {
    val s: bov.Shown = bov.begin(ui, "header", bov.on_rect(r, bov.TOP_LEFT, bov.TOP_LEFT));
    val w: f32       = r.x1 - r.x0;
    val h: f32       = bctx.px(ui, look.HEADER);
    val b: bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    bint.hit(ui, 0, b.x0, b.y0, b.x1, b.y1, 0);
    bctx.quad(ui, b.x0, b.y0, b.x1, b.y1, look.colour(theme.HEADER, 1.0));
    bctx.quad(ui, b.x0, b.y1 - 1.0, b.x1, b.y1, look.colour(theme.PANEL_EDGE, 1.0));
    val pad: f32 = bctx.px(ui, look.PAD);
    val pen: f32 = look.text_mid(ui, "cellar", b.x0 + pad, b.y0, b.y1, look.colour(theme.TEXT, 1.0));
    bctx.push_style(ui, l.small);
    look.text_mid(ui, VERSION, pen + bctx.px(ui, 8.0), b.y0, b.y1, look.colour(theme.TEXT_FAINT, 1.0));
    bctx.pop_style(ui);

    val bs: f32 = bctx.px(ui, BUTTON);
    val by: f32 = b.y0 + (h - bs) / 2.0;
    val hx: f32 = b.x1 - pad - bs;
    val gx: f32 = hx - bs - bctx.px(ui, 6.0);
    if (bw.button_at(ui, "»", hx, by, hx + bs, by + bs, false))       { a.panel = 0; }
    if (bw.button_at(ui, "?", gx, by, gx + bs, by + bs, a.help != 0)) { a.help = 1 - a.help; }
    bov.end(ui, s);
}

# the button that brings a hidden panel back, in the window's top right corner
fun restore(ui: *bctx.Context, a: *app.App) {
    var o: bov.Overlay = bov.on_surface(bov.TOP_RIGHT);
    o.dx = 0.0 - bctx.px(ui, 10.0);
    o.dy = bctx.px(ui, 10.0);
    val s:  bov.Shown = bov.begin(ui, "restore", o);
    val bs: f32       = bctx.px(ui, BUTTON);
    val b:  bctx.Area = bw.place(ui, blay.fixed(bs), blay.fixed(bs), bs, bs);
    if (bw.button_at(ui, "«", b.x0, b.y0, b.x1, b.y1, false)) { a.panel = 1; }
    bov.end(ui, s);
}

# draw the panel and apply its controls
# ---
# ui: the interface, its frame begun
# l:  cellar's look
# a:  application state
# s:  the world as shown
# p:  the data directory
# sk: the sketches large patterns are drawn from
# sw: window width in pixels
pub fun draw(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown, p: *paths.Paths, sk: *sketch.Sketches, sw: f32) {
    if (a.panel == 0) {
        restore(ui, a);
        ret;
    }
    a.side.size = width(bctx.scale_of(ui), sw);
    val d: bdock.DockArea = bdock.begin_dock(ui, "panel", ?a.side);
    bctx.push_id_str(ui, "run");
    run(ui, l, a, s);
    bctx.pop_id(ui);
    bctx.push_id_str(ui, "draw");
    arrange.section(ui, l, a, s, sk);
    bctx.pop_id(ui);
    bctx.push_id_str(ui, "rule");
    kedit.section(ui, l, a, s);
    bctx.pop_id(ui);
    bctx.push_id_str(ui, "view");
    view(ui, l, a, s);
    bctx.pop_id(ui);
    bctx.push_id_str(ui, "files");
    files(ui, l, a, p);
    bctx.pop_id(ui);
    bdock.end_dock(ui, ?a.side, d);
    header(ui, l, a, d.area);
}
