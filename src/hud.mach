# the heads-up readout, flashed messages and the key reference
#
# the readout sits in the top-left corner of the world's port in small type: whether the
# world runs, its generation, population, the size of the box its live cells
# span, rule and speed. it fades back as the cursor comes near, so it never
# hides the cells under it. the cell under the cursor and the zoom sit in the
# bottom-left corner, messages flash at the bottom centre of the world, and
# the key reference opens over everything. each is a blit overlay, which
# claims nothing of its own, so the world under them stays in reach; the key
# reference lies over a scrim that takes every press and closes it. what
# belongs to the world (the readout, the position and the selection's size)
# lies in the base band with the world, beneath the docks and the windows.

use blit;
use blit.band;
use bctx:   blit.context;
use binp:   blit.input;
use bint:   blit.interact;
use blay:   blit.layout;
use bov:    blit.overlay;
use bstyle: blit.style;
use btoast: blit.toast;
use bw:     blit.widget;
use cellar.app;
use cellar.look;
use cellar.paint;
use cellar.render;
use rules: cellar.rule;
use cellar.space;
use cellar.text;
use cellar.theme;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# the key reference and its scrim stack above every other overlay
val HELP_ORDER: u32 = 10;
# the key the flashed message is posted under
val MESSAGE: str = "message";
# seconds a held message is posted for, longer than any wait it stands for
val HELD: f64 = 86400.0;

# the world's port as an area of the interface
fun area(pt: render.Port) bctx.Area {
    ret bctx.Area{x0: pt.x0, y0: pt.y0, x1: pt.x0 + pt.w, y1: pt.y0 + pt.h};
}

# one label and value pair of the readout in the small face; ret the pen after it
fun pair(ui: *bctx.Context, x: f32, y0: f32, y1: f32, label: str, value: str) f32 {
    var pen: f32 = look.text_mid(ui, label, x, y0, y1, look.colour(theme.TEXT_FAINT, 1.0));
    pen = look.text_mid(ui, value, pen + bctx.px(ui, 5.0), y0, y1, look.colour(theme.TEXT, 1.0));
    ret pen + bctx.px(ui, 14.0);
}

# the readout of the world's state
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown
# pt: the world's port
pub fun readout(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown, pt: render.Port) {
    var gen: [32]u8;
    gen[text.buf_grouped(?gen[0], 0, world.generation(s))] = 0;
    var pop: [32]u8;
    pop[text.buf_grouped(?pop[0], 0, world.population(s)::u64)] = 0;
    var bx: [64]u8;
    var bo: usize          = text.buf_str(?bx[0], 0, "-");
    val b:  opt[space.Box] = world.bounds(s);
    if (sel b.some) {
        bo = text.buf_grouped(?bx[0], 0, (b.some.x1 - b.some.x0)::u64);
        bo = text.buf_str(?bx[0], bo, " x ");
        bo = text.buf_grouped(?bx[0], bo, (b.some.y1 - b.some.y0)::u64);
    }
    bx[bo] = 0;
    var rb:   [rules.DISPLAY_MAX + 1]u8;
    val rule: str   = world.rule_string(s, ?rb[0]);
    val name: str   = world.rule_label(s);
    var sp:   [32]u8;
    var so:   usize = 0;
    if (a.uncapped != 0) { so = text.buf_str(?sp[0], 0, "max"); }
    or {
        so = text.buf_u64(?sp[0], 0, (a.speed + 0.5)::u64);
        so = text.buf_str(?sp[0], so, "/s");
    }
    if (world.hashlife(s) && world.exponent(s) != 0) {
        so = text.buf_str(?sp[0], so, " x2^");
        so = text.buf_u64(?sp[0], so, world.exponent(s)::u64);
    }
    sp[so] = 0;
    var extra: str = "";
    if (world.full(s) && world.hashlife(s)) { extra = "table full"; }
    or (world.full(s))                      { extra = "pool full"; }

    var o: bov.Overlay = bov.on_rect(area(pt), bov.TOP_LEFT, bov.TOP_LEFT);
    o.dx   = bctx.px(ui, 12.0);
    o.dy   = bctx.px(ui, 12.0);
    o.fade = bov.Fade{dist: bctx.px(ui, 36.0), near: 0.25, far: 1.0};
    o.band = band.BASE;
    bstyle.push_class(ui, l.hud);
    val shown: bov.Shown = bov.begin(ui, "readout", o);
    bctx.push_style(ui, l.small);

    val pd: f32 = bctx.px(ui, 12.0);
    var w:  f32 = pd * 2.0 + bctx.px(ui, 22.0) + bctx.px(ui, 5.0 * 5.0 + 14.0 * 4.0);
    w = w + bctx.text_width(ui, "gen") + bctx.text_width(ui, ?gen[0]);
    w = w + bctx.text_width(ui, "pop") + bctx.text_width(ui, ?pop[0]);
    w = w + bctx.text_width(ui, "box") + bctx.text_width(ui, ?bx[0]);
    w = w + bctx.text_width(ui, name) + bctx.text_width(ui, rule);
    w = w + bctx.text_width(ui, "speed") + bctx.text_width(ui, ?sp[0]);
    if (world.full(s)) { w = w + bctx.text_width(ui, extra) + bctx.px(ui, 14.0); }
    val h: f32       = bctx.px(ui, 30.0);
    val r: bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);

    val cy: f32 = (r.y0 + r.y1) / 2.0;
    val k:  f32 = bctx.px(ui, 4.0);
    var x:  f32 = r.x0 + pd;
    if (world.running(s)) { bctx.tri(ui, x, cy - k * 1.2, x, cy + k * 1.2, x + k * 2.0, cy, look.colour(theme.ACCENT, 1.0)); }
    or {
        val dim: blit.draw.Color = look.colour(theme.TEXT_DIM, 1.0);
        bctx.quad(ui, x, cy - k * 1.1, x + k * 0.7, cy + k * 1.1, dim);
        bctx.quad(ui, x + k * 1.3, cy - k * 1.1, x + k * 2.0, cy + k * 1.1, dim);
    }
    x = x + bctx.px(ui, 22.0);
    x = pair(ui, x, r.y0, r.y1, "gen", ?gen[0]);
    x = pair(ui, x, r.y0, r.y1, "pop", ?pop[0]);
    x = pair(ui, x, r.y0, r.y1, "box", ?bx[0]);
    x = pair(ui, x, r.y0, r.y1, name, rule);
    x = pair(ui, x, r.y0, r.y1, "speed", ?sp[0]);
    if (world.full(s)) { look.text_mid(ui, extra, x, r.y0, r.y1, look.colour(theme.ACCENT, 1.0)); }

    bctx.pop_style(ui);
    bov.end(ui, shown);
    bstyle.pop(ui);
}

# the cell under the cursor and the zoom, in the bottom-left corner
# ---
# ui:   the interface
# l:    cellar's look
# cam:  the camera the world is drawn through
# pt:   the world's port
# over: the cursor is over the world, at (mx, my)
# mx:   cursor x in screen pixels
# my:   cursor y in screen pixels
pub fun position(ui: *bctx.Context, l: look.Look, cam: render.Camera, pt: render.Port, over: bool, mx: f32, my: f32) {
    var b: [96]u8;
    var o: usize = 0;
    if (over) {
        var cx: i64 = 0;
        var cy: i64 = 0;
        render.cell_at(cam, mx, my, ?cx, ?cy);
        o = signed(?b[0], o, cx);
        o = text.buf_str(?b[0], o, ", ");
        o = signed(?b[0], o, cy);
        o = text.buf_str(?b[0], o, "    ");
    }
    val z: f32 = cam.ppc;
    if (z >= 1.0) {
        o = text.buf_u64(?b[0], o, z::u64);
        if (z < 10.0) {
            o = text.buf_str(?b[0], o, ".");
            o = text.buf_u64(?b[0], o, ((z - z::u64::f32) * 10.0)::u64);
        }
        o = text.buf_str(?b[0], o, " px per cell");
    }
    or {
        o = text.buf_str(?b[0], o, "1 px per ");
        o = text.buf_u64(?b[0], o, (1.0 / z + 0.5)::u64);
        o = text.buf_str(?b[0], o, " cells");
    }
    b[o] = 0;

    var ov: bov.Overlay = bov.on_rect(area(pt), bov.BOTTOM_LEFT, bov.BOTTOM_LEFT);
    ov.dx   = bctx.px(ui, 6.0);
    ov.dy   = 0.0 - bctx.px(ui, 6.0);
    ov.band = band.BASE;
    bstyle.push_class(ui, l.hud);
    val shown: bov.Shown = bov.begin(ui, "position", ov);
    bctx.push_style(ui, l.small);
    val pd: f32       = bctx.px(ui, 6.0);
    val w:  f32       = bctx.text_width(ui, ?b[0]) + pd * 2.0;
    val h:  f32       = bctx.line_height(ui) + pd * 2.0;
    val r:  bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    bctx.text_at(ui, ?b[0], r.x0 + pd, r.y0 + pd, look.colour(theme.TEXT_DIM, 1.0));
    bctx.pop_style(ui);
    bov.end(ui, shown);
    bstyle.pop(ui);
}

# append a signed integer
fun signed(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret text.buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret text.buf_u64(buf, off, v::u64);
}

# the selection, tinted and outlined over the cells
# ---
# d:     the world's pass
# a:     application state
# cam:   the camera the world is drawn through
# scale: the interface scale, which the outline's width follows
pub fun selection(d: *paint.Paint, a: *app.App, cam: render.Camera, scale: f32) {
    if (!a.selected) { ret; }
    val r: render.Span = render.span(cam, a.area);
    paint.rect(d, r.x0, r.y0, r.x1, r.y1, theme.ACCENT, 0.12);
    paint.frame(d, r.x0 - 1.0, r.y0 - 1.0, r.x1 + 1.0, r.y1 + 1.0, 1.5 * scale, theme.ACCENT, 0.9);
}

# the selection's size, just above its top-left corner
# ---
# ui:  the interface
# l:   cellar's look
# a:   application state
# cam: the camera the world is drawn through
pub fun selection_size(ui: *bctx.Context, l: look.Look, a: *app.App, cam: render.Camera) {
    if (!a.selected) { ret; }
    val r: render.Span = render.span(cam, a.area);
    var b: [64]u8;
    var o: usize       = text.buf_u64(?b[0], 0, (a.area.x1 - a.area.x0)::u64);
    o    = text.buf_str(?b[0], o, " x ");
    o    = text.buf_u64(?b[0], o, (a.area.y1 - a.area.y0)::u64);
    b[o] = 0;
    var ov: bov.Overlay = bov.on_rect(bctx.Area{x0: r.x0, y0: r.y0, x1: r.x1, y1: r.y1}, bov.TOP_LEFT, bov.BOTTOM_LEFT);
    ov.dy   = 0.0 - bctx.px(ui, 4.0);
    ov.band = band.BASE;
    val shown: bov.Shown = bov.begin(ui, "selection", ov);
    bctx.push_alpha(ui, 0.9);
    look.line(ui, l.small, ?b[0], theme.ACCENT);
    bctx.pop_alpha(ui);
    bov.end(ui, shown);
}

# the flashed message as blit shows it: one keyed toast, replaced in place by
# each message the application says
# ---
# stack: the toasts, of which the message is the one
# seen:  the application's told count the stack last took a message at
pub rec Messages {
    stack: btoast.Toasts;
    seen:  u32;
}

# start with no message shown
# ---
# m: the messages
# a: allocator behind the toasts' text
pub fun messages_init(m: *Messages, a: *allo.Allocator) {
    btoast.init(?m.stack, a);
    m.seen = 0;
}

# release the messages' text
pub fun messages_dnit(m: *Messages) err[allo.Error] {
    ret btoast.free(?m.stack);
}

# the flashed message at the bottom centre of the world, a card in the theme's
# toast style. a new message replaces the one shown, and a held one stays up
# until the next replaces it
# ---
# ui: the interface
# m:  the messages
# a:  application state
# pt: the world's viewport
pub fun toast(ui: *bctx.Context, m: *Messages, a: *app.App, pt: render.Port) {
    if (a.told != m.seen) {
        var secs: f64 = app.TOAST_SECONDS;
        if (a.toast_held) { secs = HELD; }
        # a refused copy leaves the message to be posted on the next frame
        val posted: err[allo.Error] = btoast.post_keyed(?m.stack, MESSAGE, a.toast, secs);
        if (sel posted.ok) { m.seen = a.told; }
    }
    btoast.show_in(ui, "toast", ?m.stack, area(pt), bov.BOTTOM);
}

# the key reference, over everything; a click anywhere closes it
# ---
# ui: the interface
# a:  application state
# sw: window width in pixels
# sh: window height in pixels
pub fun help(ui: *bctx.Context, a: *app.App, sw: f32, sh: f32) {
    if (a.help == 0) { ret; }
    # the scrim takes every press over the window, the reference's included
    var so: bov.Overlay = bov.on_surface(bov.TOP_LEFT);
    so.order = HELP_ORDER;
    val scrim: bov.Shown = bov.begin(ui, "scrim", so);
    val all:   bctx.Area = bw.place(ui, blay.fixed(sw), blay.fixed(sh), sw, sh);
    val hit:   bint.Hit  = bint.hit(ui, bctx.id_of(ui, "close"), all.x0, all.y0, all.x1, all.y1, binp.BUTTON_LEFT);
    bctx.quad(ui, all.x0, all.y0, all.x1, all.y1, look.colour(theme.BG, 0.7));
    bov.end(ui, scrim);
    if (hit.clicked) { a.help = 0; }

    var keys: [30]str;
    var what: [30]str;
    keys[0]  = "Space";
    what[0]  = "play or pause";
    keys[1]  = "S";
    what[1]  = "step one generation";
    keys[2]  = "R";
    what[2]  = "randomize";
    keys[3]  = "C";
    what[3]  = "clear";
    keys[4]  = "D  E  T  V  W";
    what[4]  = "draw, erase, stamp, select, bounds";
    keys[5]  = "Z  X";
    what[5]  = "rotate or flip the stamp";
    keys[6]  = "Left mouse";
    what[6]  = "use the tool";
    keys[7]  = "Right drag";
    what[7]  = "pan (middle drag too)";
    keys[8]  = "Arrows";
    what[8]  = "pan";
    keys[9]  = "Scroll";
    what[9]  = "zoom toward the cursor";
    keys[10] = "F";
    what[10] = "fit the world to the view";
    keys[11] = "M";
    what[11] = "next colour mode";
    keys[12] = "G";
    what[12] = "grid lines";
    keys[13] = "Tab";
    what[13] = "show or hide the panels";
    keys[14] = "F11";
    what[14] = "fullscreen";
    keys[15] = "F12";
    what[15] = "screenshot";
    keys[16] = "H  F1";
    what[16] = "this reference";
    keys[17] = "Ctrl C  Ctrl X";
    what[17] = "copy or cut to the stamp, as RLE";
    keys[18] = "Delete";
    what[18] = "clear the selection";
    keys[19] = "Shift Delete";
    what[19] = "clear outside it";
    keys[20] = "Ctrl R";
    what[20] = "fill it at random";
    keys[21] = "I";
    what[21] = "invert it";
    keys[22] = "B";
    what[22] = "shrink it to live cells";
    keys[23] = "Esc";
    what[23] = "close this, deselect, or quit";
    keys[24] = "Backspace";
    what[24] = "reset to where play started";
    keys[25] = "Ctrl V";
    what[25] = "paste a pattern as the stamp";
    keys[26] = "Ctrl Shift V";
    what[26] = "paste, taking its rule";
    keys[27] = "Ctrl Z";
    what[27] = "undo";
    keys[28] = "Ctrl Shift Z";
    what[28] = "redo (Ctrl Y too)";
    keys[29] = "Q  Shift Q";
    what[29] = "next or previous state to draw";
    val n: usize = 30;

    # the reference claims nothing, so a press on it reaches the scrim
    var co: bov.Overlay = bov.on_surface(bov.CENTER);
    co.order = HELP_ORDER + 1;
    co.keep  = 1;
    val card: bov.Shown = bov.begin(ui, "keys", co);
    val lh:   f32       = bctx.line_height(ui);
    val step: f32       = lh + bctx.px(ui, 6.0);
    val pd:   f32       = bctx.px(ui, 24.0);
    val kw:   f32       = bctx.px(ui, 120.0);
    val w:    f32       = bctx.px(ui, 400.0);
    val h:    f32       = pd * 2.0 + lh + bctx.px(ui, 12.0) + step * n::f32;
    val r:    bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    bctx.quad(ui, r.x0, r.y0, r.x1, r.y1, look.colour(theme.PANEL, 1.0));
    bctx.frame(ui, r.x0, r.y0, r.x1, r.y1, 1.0, look.colour(theme.PANEL_EDGE, 1.0));
    bctx.text_at(ui, "Keys and mouse", r.x0 + pd, r.y0 + pd, look.colour(theme.TEXT, 1.0));
    var y: f32   = r.y0 + pd + lh + bctx.px(ui, 12.0);
    var i: usize = 0;
    for (i < n) {
        bctx.text_at(ui, keys[i], r.x0 + pd, y, look.colour(theme.ACCENT, 1.0));
        bctx.text_at(ui, what[i], r.x0 + pd + kw, y, look.colour(theme.TEXT, 1.0));
        y = y + step;
        i = i + 1;
    }
    bov.end(ui, card);
}

# the flashed message over a world filling the surface
#[testing]
rec ToastProbe {
    m: Messages;
    a: *app.App;
}

#[testing]
fun toast_ui(ui: *bctx.Context, user: ptr) {
    val tp: *ToastProbe = user::*ToastProbe;
    toast(ui, ?tp.m, tp.a, render.Port{x0: 0.0, y0: 0.0, w: 400.0, h: 300.0});
}

# whether the surface shows the message s and no other
#[testing]
fun shows(d: *blit.driver.Driver, tp: *ToastProbe, s: str) bool {
    ret btoast.count(?tp.m.stack) == 1 && string.str_equals(blit.driver.text_in(d, 0.0, 0.0, 400.0, 300.0), s);
}

test toast__a_message_replaces_the_last_and_a_held_one_waits_for_the_next {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var a: app.App;
    app.init(?a);
    var tp: ToastProbe;
    tp.a = ?a;
    messages_init(?tp.m, ?al);
    var d:  blit.driver.Driver;
    val di: err[allo.Error] = blit.driver.init(?d, ?al, 400.0, 300.0, toast_ui, (?tp)::ptr);
    if (sel di.err) { ret 1; }
    look.apply(?d.ctx);

    app.say(?a, "bounds removed");
    blit.driver.steps(?d, 2);
    if (!shows(?d, ?tp, "bounds removed")) { ret 2; }

    # the running identification replaces it, and stays past a message's time
    app.say(?a, app.IDENTIFYING);
    a.toast_held = true;
    blit.driver.steps(?d, 240);
    if (!shows(?d, ?tp, app.IDENTIFYING)) { ret 3; }

    # until its result replaces it, which goes in its own time
    app.say(?a, "selection: a glider");
    blit.driver.steps(?d, 2);
    if (!shows(?d, ?tp, "selection: a glider")) { ret 4; }
    blit.driver.steps(?d, 240);
    if (btoast.count(?tp.m.stack) != 0) { ret 5; }

    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    val dropped: err[allo.Error] = messages_dnit(?tp.m);
    if (sel dropped.err) { ret 1; }
    ret 0;
}
