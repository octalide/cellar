# the heads-up readout, flashed messages and the key reference
#
# the readout sits in the top-left corner of the world's port in small type: whether the
# world runs, its generation, population, the size of the box its live cells
# span, rule and speed, which reads the measured rate against the set one. it fades back as the cursor comes near, so it never
# hides the cells under it. the zoom sits in the bottom-left corner with the
# cell under the cursor beside it, messages flash at the bottom centre of the world, and
# the key reference opens over everything. each is a blit overlay, which
# claims nothing of its own, so the world under them stays in reach; the key
# reference lies over a scrim that takes every press and closes it. what
# belongs to the world (the readout, the position and the selection's size)
# lies in the base band with the world, beneath the docks and the windows.

use blit;
use blit.band;
use bctx:   blit.context;
use binp:   blit.input;
use bint:   blit.interact;
use blay:   blit.layout;
use bov:    blit.overlay;
use bstyle: blit.style;
use btext:  blit.text;
use btoast: blit.toast;
use bw:     blit.widget;
use cellar.app;
use cellar.ceiling;
use cellar.command;
use cellar.look;
use cellar.pace;
use cellar.paint;
use cellar.render;
use rules: cellar.rule;
use cellar.sim;
use cellar.space;
use cellar.text;
use cellar.theme;
use cellar.world;
use allo: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# the key reference and its scrim stack above every other overlay
val HELP_ORDER: u32 = 10;
# the key the flashed message is posted under
val MESSAGE: str = "message";
# seconds a held message is posted for, longer than any wait it stands for
val HELD: f64 = 86400.0;

# the world's port as an area of the interface
fun area(pt: render.Port) bctx.Area {
    ret bctx.Area{x0: pt.x0, y0: pt.y0, x1: pt.x0 + pt.w, y1: pt.y0 + pt.h};
}

# the gap kept between a heads-up box and the edge of the world's port
val HUD_MARGIN: f32 = 12.0;

fun maxf(a: f32, b: f32) f32 {
    if (a > b) { ret a; }
    ret b;
}

fun minf(a: f32, b: f32) f32 {
    if (a < b) { ret a; }
    ret b;
}

# the readout of the world's state
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown
# pt: the world's port
pub fun readout(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown, pt: render.Port) {
    var gen: [32]u8;
    gen[text.buf_grouped(?gen[0], 0, world.generation(s))] = 0;
    var pop: [32]u8;
    pop[text.buf_grouped(?pop[0], 0, world.population(s)::u64)] = 0;
    var bx: [64]u8;
    var bo: usize          = text.buf_str(?bx[0], 0, "-");
    val b:  opt[space.Box] = world.bounds(s);
    if (sel b.some) {
        bo = text.buf_grouped(?bx[0], 0, (b.some.x1 - b.some.x0)::u64);
        bo = text.buf_str(?bx[0], bo, " x ");
        bo = text.buf_grouped(?bx[0], bo, (b.some.y1 - b.some.y0)::u64);
    }
    bx[bo] = 0;
    var rb:   [rules.DISPLAY_MAX + 1]u8;
    val rule: str = world.rule_string(s, ?rb[0]);
    val name: str = world.rule_label(s);
    # the measured rate against the set speed: "41 of 60/s", or "41/s max" when uncapped
    var sp: [48]u8;
    var so: usize = pace.rate_text(?sp[0], 0, ?a.rate);
    if (a.uncapped != 0) { so = text.buf_str(?sp[0], so, "/s max"); }
    or {
        so = text.buf_str(?sp[0], so, " of ");
        so = text.buf_u64(?sp[0], so, (a.speed + 0.5)::u64);
        so = text.buf_str(?sp[0], so, "/s");
    }
    if (world.hashlife(s) && world.exponent(s) != 0) {
        so = text.buf_str(?sp[0], so, " x2^");
        so = text.buf_u64(?sp[0], so, world.exponent(s)::u64);
    }
    sp[so] = 0;
    var extra: str = "";
    if (world.full(s) && world.hashlife(s)) { extra = "table full"; }
    or (world.full(s))                      { extra = "pool full"; }

    var ls: [6]str;
    var vs: [6]str;
    var n:  usize = 0;
    ls[0] = "gen";
    vs[0] = ?gen[0];
    ls[1] = "pop";
    vs[1] = ?pop[0];
    ls[2] = "box";
    vs[2] = ?bx[0];
    ls[3] = name;
    vs[3] = rule;
    ls[4] = "speed";
    vs[4] = ?sp[0];
    n     = 5;
    if (world.full(s)) {
        ls[5] = nil;
        vs[5] = extra;
        n     = 6;
    }

    var o: bov.Overlay = bov.on_rect(area(pt), bov.TOP_LEFT, bov.TOP_LEFT);
    o.dx   = bctx.px(ui, HUD_MARGIN);
    o.dy   = bctx.px(ui, HUD_MARGIN);
    o.fade = bov.Fade{dist: bctx.px(ui, 36.0), near: 0.25, far: 1.0};
    o.band = band.BASE;
    bstyle.push_class(ui, l.hud);
    bstyle.push_class(ui, l.pad);
    val shown: bov.Shown = bov.begin(ui, "readout", o);
    bctx.push_style(ui, l.small);

    # the fields flow into rows no wider than the world's port leaves, the
    # least important last. one wider than a row on its own is cut to it
    val lh:   f32       = bctx.line_height(ui);
    val room: f32       = maxf(pt.w - bctx.px(ui, HUD_MARGIN) * 2.0 - bctx.px(ui, look.READOUT_PAD_X) * 2.0, 0.0);
    var fo:   blay.Flow = bw.flow(ui);
    fo.gap     = bctx.px(ui, 14.0);
    fo.row_gap = bctx.px(ui, 4.0);
    bw.size_next(ui, blay.limit(blay.fit(), 0.0, room), blay.fit());
    bw.begin_flow(ui, "readout", fo);

    # the state's icon is 2k wide, the flow's gap setting the first field off it
    val k:  f32       = bctx.px(ui, 4.0);
    val r:  bctx.Area = bw.place(ui, blay.fixed(k * 2.0), blay.fixed(lh), k * 2.0, lh);
    val cy: f32       = r.y0 + lh / 2.0;
    val x0: f32       = r.x0;
    if (world.running(s)) { bctx.tri(ui, x0, cy - k * 1.2, x0, cy + k * 1.2, x0 + k * 2.0, cy, look.colour(theme.ACCENT, 1.0)); }
    or {
        val dim: blit.draw.Color = look.colour(theme.TEXT_DIM, 1.0);
        bctx.quad(ui, x0, cy - k * 1.1, x0 + k * 0.7, cy + k * 1.1, dim);
        bctx.quad(ui, x0 + k * 1.3, cy - k * 1.1, x0 + k * 2.0, cy + k * 1.1, dim);
    }
    var i: usize = 0;
    for (i < n) {
        var nat: f32 = bctx.text_width(ui, vs[i]);
        if (ls[i] != nil) { nat = nat + bctx.text_width(ui, ls[i]) + bctx.px(ui, 5.0); }
        val b:  bctx.Area       = bw.place(ui, blay.fit(), blay.fixed(lh), nat, lh);
        var lc: blit.draw.Color = look.colour(theme.TEXT_FAINT, 1.0);
        var vc: blit.draw.Color = look.colour(theme.TEXT, 1.0);
        var ln: usize           = 0;
        if (ls[i] != nil) { ln = string.str_len(ls[i]); }
        or                { vc = look.colour(theme.ACCENT, 1.0); }
        btext.fit_pair(ui, bov.KIND_OVERLAY, ls[i], ln, lc, vs[i], vc, bctx.px(ui, 5.0), b.y0, b);
        i = i + 1;
    }
    bw.end_flow(ui);

    bctx.pop_style(ui);
    bov.end(ui, shown);
    bstyle.pop(ui);
    bstyle.pop(ui);
}

# append a zoom's scale to the second place, its trailing zeros dropped
fun scale(buf: *u8, off: usize, v: f32) usize {
    if (v >= 1000.0) { ret text.buf_grouped(buf, off, (v + 0.5)::u64); }
    ret text.buf_decimal(buf, off, ((v * 100.0 + 0.5)::u64) * (text.DECIMAL / 100));
}

# the zoom as text, in pixels per cell, or cells per pixel past one pixel to a cell
fun zoom_text(buf: *u8, ppc: f32) usize {
    if (ppc >= 1.0) {
        val o: usize = scale(buf, 0, ppc);
        ret text.buf_str(buf, o, " px per cell");
    }
    val o: usize = scale(buf, 0, 1.0 / ppc);
    ret text.buf_str(buf, o, " cells per px");
}

# the zoom's text keeps the width of the widest of these, so its buttons hold
# still as it changes; only HashLife's deepest zooms read wider
val ZOOM_WIDEST_IN:  str = "888.88 px per cell";
val ZOOM_WIDEST_OUT: str = "88.88 cells per px";

# a cell's coordinate keeps the width of this many digits and a sign, wider
# only past it
val CELL_DIGITS: usize = 7;

# the zoom in the bottom-left corner, with a button each side of it that steps
# it by a power of two, and the cell under the cursor right of it, x and y
# each in a box of its own. each box keeps its width as its text changes, and
# none moves with the cursor, so a button stays under the cursor that is on it
# ---
# ui:   the interface
# l:    cellar's look
# cam:  the camera the world is drawn through
# pt:   the world's port
# over: the cursor is over the world, at (mx, my)
# mx:   cursor x in screen pixels
# my:   cursor y in screen pixels
# ret:  1 when the zoom button was pressed to zoom in, -1 to zoom out, else 0
pub fun position(ui: *bctx.Context, l: look.Look, cam: render.Camera, pt: render.Port, over: bool, mx: f32, my: f32) i32 {
    var zb: [48]u8;
    zb[zoom_text(?zb[0], cam.ppc)] = 0;

    bstyle.push_class(ui, l.hud);
    bctx.push_style(ui, l.small);
    val pd:  f32             = bctx.px(ui, 6.0);
    val lh:  f32             = bctx.line_height(ui);
    val bh:  f32             = lh + bctx.px(ui, 4.0);
    val gap: f32             = bctx.px(ui, 6.0);
    val h:   f32             = bh + pd * 2.0;
    val tw:  f32             = maxf(maxf(bctx.text_width(ui, ZOOM_WIDEST_IN), bctx.text_width(ui, ZOOM_WIDEST_OUT)), bctx.text_width(ui, ?zb[0]));
    val zw:  f32             = bh * 2.0 + gap * 2.0 + tw + pd * 2.0;
    val dim: blit.draw.Color = look.colour(theme.TEXT_DIM, 1.0);

    var ov: bov.Overlay = bov.on_rect(area(pt), bov.BOTTOM_LEFT, bov.BOTTOM_LEFT);
    ov.dx   = bctx.px(ui, 6.0);
    ov.dy   = 0.0 - bctx.px(ui, 6.0);
    ov.band = band.BASE;
    val shown: bov.Shown = bov.begin(ui, "position", ov);
    val r:     bctx.Area = bw.place(ui, blay.fixed(zw), blay.fixed(h), zw, h);
    val y:     f32       = r.y0 + pd;
    val zx:    f32       = r.x0 + pd;
    var step:  i32       = 0;
    if (bw.button_at(ui, "-###zoom_out", zx, y, zx + bh, y + bh, false)) { step = -1; }
    val tx: f32 = zx + bh + gap;
    btext.fit_at(ui, ?zb[0], tx + (tw - bctx.text_width(ui, ?zb[0])) / 2.0, y + (bh - lh) / 2.0, tw, btext.CUT_END, dim);
    if (bw.button_at(ui, "+###zoom_in", tx + tw + gap, y, tx + tw + gap + bh, y + bh, false)) { step = 1; }
    bov.end(ui, shown);

    var cx: i64 = 0;
    var cy: i64 = 0;
    if (over) { render.cell_at(cam, mx, my, ?cx, ?cy); }
    ov.dx = ov.dx + zw + gap;
    ov.dx = ov.dx + coordinate(ui, "cell_x", ov, "x", cx, over, pd, h) + gap;
    coordinate(ui, "cell_y", ov, "y", cy, over, pd, h);
    bctx.pop_style(ui);
    bstyle.pop(ui);
    ret step;
}

# one coordinate of the cell under the cursor, its name and value in a box
# that holds CELL_DIGITS digits and a sign, the value blank when the cursor is
# off the world
# ---
# ui:   the interface, in the small style
# key:  the box's key
# ov:   where the box goes
# name: the coordinate's name
# v:    its value
# over: the cursor is over the world, so v names a cell
# pd:   the box's padding
# h:    the box's height
# ret:  the box's width
fun coordinate(ui: *bctx.Context, key: str, ov: bov.Overlay, name: str, v: i64, over: bool, pd: f32, h: f32) f32 {
    var vb: [24]u8;
    var vn: usize = 0;
    if (over) { vn = signed(?vb[0], 0, v); }
    vb[vn] = 0;
    var wb: [24]u8;
    var wn: usize = 0;
    wb[0] = '-';
    for (wn < CELL_DIGITS || wn + 1 < vn) {
        wb[wn + 1] = '8';
        wn         = wn + 1;
    }
    wb[wn + 1] = 0;
    val sp: f32 = bctx.px(ui, 5.0);
    val w:  f32 = bctx.text_width(ui, name) + sp + bctx.text_width(ui, ?wb[0]) + pd * 2.0;

    val shown: bov.Shown = bov.begin(ui, key, ov);
    val r:     bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    val b:     bctx.Area = bctx.Area{x0: r.x0 + pd, y0: r.y0, x1: r.x1 - pd, y1: r.y1};
    var value: str       = nil;
    if (over) { value = ?vb[0]; }
    btext.fit_pair(ui, bov.KIND_OVERLAY, name, string.str_len(name), look.colour(theme.TEXT_FAINT, 1.0), value, look.colour(theme.TEXT_DIM, 1.0), sp, r.y0 + (h - bctx.line_height(ui)) / 2.0, b);
    bov.end(ui, shown);
    ret w;
}

# append a signed integer
fun signed(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret text.buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret text.buf_u64(buf, off, v::u64);
}

# the selection, tinted and outlined over the cells
# ---
# d:     the world's pass
# a:     application state
# cam:   the camera the world is drawn through
# scale: the interface scale, which the outline's width follows
pub fun selection(d: *paint.Paint, a: *app.App, cam: render.Camera, scale: f32) {
    if (!a.selected) { ret; }
    val r: render.Span = render.span(cam, a.area);
    paint.rect(d, r.x0, r.y0, r.x1, r.y1, theme.ACCENT, 0.12);
    paint.frame(d, r.x0 - 1.0, r.y0 - 1.0, r.x1 + 1.0, r.y1 + 1.0, 1.5 * scale, theme.ACCENT, 0.9);
}

# a line of small accent text just above the top-left corner of a rect on the
# world, kept inside the world's port and not drawn when the rect lies wholly
# outside it
# ---
# ui:  the interface
# l:   cellar's look
# key: the overlay's key
# s:   the text
# r:   the rect, in screen pixels
# pt:  the world's port
pub fun tag(ui: *bctx.Context, l: look.Look, key: str, s: str, r: render.Span, pt: render.Port) {
    if (r.x1 < pt.x0 || r.x0 > pt.x0 + pt.w || r.y1 < pt.y0 || r.y0 > pt.y0 + pt.h) { ret; }
    bctx.push_style(ui, l.small);
    val w:  f32 = minf(bctx.text_width(ui, s), pt.w);
    val lh: f32 = bctx.line_height(ui);
    bctx.pop_style(ui);
    val x:  f32         = maxf(minf(r.x0, pt.x0 + pt.w - w), pt.x0);
    val y:  f32         = maxf(minf(r.y0 - bctx.px(ui, 4.0) - lh, pt.y0 + pt.h - lh), pt.y0);
    var ov: bov.Overlay = bov.on_rect(bctx.Area{x0: x, y0: y, x1: x, y1: y}, bov.TOP_LEFT, bov.TOP_LEFT);
    ov.band = band.BASE;
    val shown: bov.Shown = bov.begin(ui, key, ov);
    bctx.push_alpha(ui, 0.9);
    bctx.push_style(ui, l.small);
    val box: bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(lh), w, lh);
    btext.fit_at(ui, s, box.x0, box.y0, w, btext.CUT_END, look.colour(theme.ACCENT, 1.0));
    bctx.pop_style(ui);
    bctx.pop_alpha(ui);
    bov.end(ui, shown);
}

# the selection's size, just above its top-left corner, kept inside the world's port
# ---
# ui:  the interface
# l:   cellar's look
# a:   application state
# cam: the camera the world is drawn through
# pt:  the world's port
pub fun selection_size(ui: *bctx.Context, l: look.Look, a: *app.App, cam: render.Camera, pt: render.Port) {
    if (!a.selected) { ret; }
    var b: [64]u8;
    var o: usize = text.buf_u64(?b[0], 0, (a.area.x1 - a.area.x0)::u64);
    o    = text.buf_str(?b[0], o, " x ");
    o    = text.buf_u64(?b[0], o, (a.area.y1 - a.area.y0)::u64);
    b[o] = 0;
    tag(ui, l, "selection", ?b[0], render.span(cam, a.area), pt);
}

# the flashed message as blit shows it: one keyed toast, replaced in place by
# each message the application says
# ---
# stack: the toasts, of which the message is the one
# seen:  the application's told count the stack last took a message at
pub rec Messages {
    stack: btoast.Toasts;
    seen:  u32;
}

# start with no message shown
# ---
# m: the messages
# a: allocator behind the toasts' text
pub fun messages_init(m: *Messages, a: *allo.Allocator) {
    btoast.init(?m.stack, a);
    m.seen = 0;
}

# release the messages' text
pub fun messages_dnit(m: *Messages) err[allo.Error] {
    ret btoast.free(?m.stack);
}

# the flashed message at the bottom centre of the world, a card in the theme's
# toast style. a new message replaces the one shown, and a held one stays up
# until the next replaces it
# ---
# ui: the interface
# m:  the messages
# a:  application state
# pt: the world's viewport
pub fun toast(ui: *bctx.Context, m: *Messages, a: *app.App, pt: render.Port) {
    if (a.told != m.seen) {
        var secs: f64 = app.TOAST_SECONDS;
        if (a.toast_held) { secs = HELD; }
        # a refused copy leaves the message to be posted on the next frame
        val posted: err[allo.Error] = btoast.post_keyed(?m.stack, MESSAGE, a.toast, secs);
        if (sel posted.ok) { m.seen = a.told; }
    }
    btoast.show_in(ui, "toast", ?m.stack, area(pt), bov.BOTTOM);
}

# the pool's memory a run paused at its ceiling is offered: twice what it may
# take now, no more than the device holds, or none once it may take all of
# that
# ---
# p:   the memory the pool takes and may take
# ret: the limit offered in MiB, 0 for none
pub fun pool_raise(p: sim.PoolMemory) u64 {
    val now:  u64 = (p.bound + 1048575) / 1048576;
    var next: u64 = now * 2;
    if (p.heap != 0 && next > p.heap / 1048576) { next = p.heap / 1048576; }
    if (next <= now)                            { ret 0; }
    ret next;
}

# while the run is paused at the pool's ceiling, a button over the world that
# raises it (pool_raise) and runs on
# ---
# ui: the interface
# l:  cellar's look
# a:  application state
# s:  the world as shown
# pt: the world's viewport
pub fun pool_offer(ui: *bctx.Context, l: look.Look, a: *app.App, s: *world.Shown, pt: render.Port) {
    if (world.paused_at(s) != ceiling.POOL) { ret; }
    val next: u64 = pool_raise(world.pool(s));
    if (next == 0) { ret; }
    var lb: [80]u8;
    var o:  usize = text.buf_str(?lb[0], 0, "Raise the pool to ");
    o     = text.buf_grouped(?lb[0], o, next);
    o     = text.buf_str(?lb[0], o, " MiB and run on###pool_raise");
    lb[o] = 0;
    var ov: bov.Overlay = bov.on_rect(area(pt), bov.TOP, bov.TOP);
    ov.dy   = bctx.px(ui, HUD_MARGIN);
    ov.band = band.BASE;
    bstyle.push_class(ui, l.hud);
    val shown: bov.Shown = bov.begin(ui, "pool_offer", ov);
    val pd:    f32       = bctx.px(ui, 6.0);
    val w:     f32       = bctx.text_width(ui, ?lb[0]) + pd * 4.0;
    val h:     f32       = bctx.line_height(ui) + pd * 2.0;
    val r:     bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    if (bw.button_at(ui, ?lb[0], r.x0, r.y0, r.x1, r.y1, false)) {
        var c: ceiling.Ceilings = world.ceilings(s);
        c.on[ceiling.POOL]    = true;
        c.limit[ceiling.POOL] = next;
        app.submit(a, command.Command.ceilings{c});
        app.submit(a, command.Command.toggle{});
    }
    bov.end(ui, shown);
    bstyle.pop(ui);
}

# the key reference, over everything; a click anywhere closes it
# ---
# ui: the interface
# a:  application state
# sw: window width in pixels
# sh: window height in pixels
pub fun help(ui: *bctx.Context, a: *app.App, sw: f32, sh: f32) {
    if (a.help == 0) { ret; }
    # the scrim takes every press over the window, the reference's included
    var so: bov.Overlay = bov.on_surface(bov.TOP_LEFT);
    so.order = HELP_ORDER;
    val scrim: bov.Shown = bov.begin(ui, "scrim", so);
    val all:   bctx.Area = bw.place(ui, blay.fixed(sw), blay.fixed(sh), sw, sh);
    val hit:   bint.Hit  = bint.hit(ui, bctx.id_of(ui, "close"), all.x0, all.y0, all.x1, all.y1, binp.BUTTON_LEFT);
    bctx.quad(ui, all.x0, all.y0, all.x1, all.y1, look.colour(theme.BG, 0.7));
    bov.end(ui, scrim);
    if (hit.clicked) { a.help = 0; }

    var keys: [31]str;
    var what: [31]str;
    keys[0]  = "Space";
    what[0]  = "play or pause";
    keys[1]  = "S";
    what[1]  = "step one generation";
    keys[2]  = "R";
    what[2]  = "randomize";
    keys[3]  = "C";
    what[3]  = "clear";
    keys[4]  = "D  E  T  V  W  L";
    what[4]  = "draw, erase, stamp, select, bounds, walls";
    keys[5]  = "Z  X";
    what[5]  = "rotate or flip the stamp";
    keys[6]  = "Left mouse";
    what[6]  = "use the tool";
    keys[7]  = "Right drag";
    what[7]  = "pan (middle drag too)";
    keys[8]  = "Arrows";
    what[8]  = "pan";
    keys[9]  = "Scroll";
    what[9]  = "zoom toward the cursor";
    keys[10] = "F";
    what[10] = "frame the fill randomize would make";
    keys[11] = "M";
    what[11] = "next colour mode";
    keys[12] = "G";
    what[12] = "grid lines";
    keys[13] = "Tab";
    what[13] = "show or hide the toolbar and panels";
    keys[14] = "F11";
    what[14] = "fullscreen";
    keys[15] = "F12";
    what[15] = "screenshot";
    keys[16] = "H  F1";
    what[16] = "this reference";
    keys[17] = "Ctrl C  Ctrl X";
    what[17] = "copy or cut to the stamp, as RLE";
    keys[18] = "Delete";
    what[18] = "clear the selection";
    keys[19] = "Shift Delete";
    what[19] = "clear outside it";
    keys[20] = "Ctrl R";
    what[20] = "fill it at random";
    keys[21] = "I";
    what[21] = "invert it";
    keys[22] = "B";
    what[22] = "shrink it to live cells";
    keys[23] = "Esc";
    what[23] = "close this, deselect, or quit";
    keys[24] = "Backspace";
    what[24] = "reset to where play started";
    keys[25] = "Ctrl V";
    what[25] = "paste a pattern as the stamp";
    keys[26] = "Ctrl Shift V";
    what[26] = "paste, taking its rule";
    keys[27] = "Ctrl Z";
    what[27] = "undo";
    keys[28] = "Ctrl Shift Z";
    what[28] = "redo (Ctrl Y too)";
    keys[29] = "Q  Shift Q";
    what[29] = "next or previous state to draw";
    keys[30] = "PgUp  PgDn";
    what[30] = "zoom in or out by a power of two";
    val n: usize = 31;

    # the reference claims nothing, so a press on it reaches the scrim
    var co: bov.Overlay = bov.on_surface(bov.CENTER);
    co.order = HELP_ORDER + 1;
    co.keep  = 1;
    val card: bov.Shown = bov.begin(ui, "keys", co);
    val lh:   f32       = bctx.line_height(ui);
    val step: f32       = lh + bctx.px(ui, 6.0);
    val pd:   f32       = bctx.px(ui, 24.0);
    val kw:   f32       = bctx.px(ui, 120.0);
    val w:    f32       = bctx.px(ui, 400.0);
    val h:    f32       = pd * 2.0 + lh + bctx.px(ui, 12.0) + step * n::f32;
    val r:    bctx.Area = bw.place(ui, blay.fixed(w), blay.fixed(h), w, h);
    bctx.quad(ui, r.x0, r.y0, r.x1, r.y1, look.colour(theme.PANEL, 1.0));
    bctx.frame(ui, r.x0, r.y0, r.x1, r.y1, 1.0, look.colour(theme.PANEL_EDGE, 1.0));
    bctx.text_at(ui, "Keys and mouse", r.x0 + pd, r.y0 + pd, look.colour(theme.TEXT, 1.0));
    var y: f32   = r.y0 + pd + lh + bctx.px(ui, 12.0);
    var i: usize = 0;
    for (i < n) {
        bctx.text_at(ui, keys[i], r.x0 + pd, y, look.colour(theme.ACCENT, 1.0));
        bctx.text_at(ui, what[i], r.x0 + pd + kw, y, look.colour(theme.TEXT, 1.0));
        y = y + step;
        i = i + 1;
    }
    bov.end(ui, card);
}

# the flashed message over a world filling the surface
#[testing]
rec ToastProbe {
    m: Messages;
    a: *app.App;
}

#[testing]
fun toast_ui(ui: *bctx.Context, user: ptr) {
    val tp: *ToastProbe = user::*ToastProbe;
    toast(ui, ?tp.m, tp.a, render.Port{x0: 0.0, y0: 0.0, w: 400.0, h: 300.0});
}

# whether the surface shows the message s and no other
#[testing]
fun shows(d: *blit.driver.Driver, tp: *ToastProbe, s: str) bool {
    ret btoast.count(?tp.m.stack) == 1 && string.str_equals(blit.driver.text_in(d, 0.0, 0.0, 400.0, 300.0), s);
}

test toast__a_message_replaces_the_last_and_a_held_one_waits_for_the_next {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var a: app.App;
    app.init(?a);
    var tp: ToastProbe;
    tp.a = ?a;
    messages_init(?tp.m, ?al);
    var d:  blit.driver.Driver;
    val di: err[allo.Error] = blit.driver.init(?d, ?al, 400.0, 300.0, toast_ui, (?tp)::ptr);
    if (sel di.err) { ret 1; }
    look.apply(?d.ctx);

    app.say(?a, "bounds removed");
    blit.driver.steps(?d, 2);
    if (!shows(?d, ?tp, "bounds removed")) { ret 2; }

    # the running identification replaces it, and stays past a message's time
    app.say(?a, app.IDENTIFYING);
    a.toast_held = true;
    blit.driver.steps(?d, 240);
    if (!shows(?d, ?tp, app.IDENTIFYING)) { ret 3; }

    # until its result replaces it, which goes in its own time
    app.say(?a, "selection: a glider");
    blit.driver.steps(?d, 2);
    if (!shows(?d, ?tp, "selection: a glider")) { ret 4; }
    blit.driver.steps(?d, 240);
    if (btoast.count(?tp.m.stack) != 0) { ret 5; }

    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    val dropped: err[allo.Error] = messages_dnit(?tp.m);
    if (sel dropped.err) { ret 1; }
    ret 0;
}

test pool_raise__doubles_the_pool_until_the_device_holds_no_more {
    val mib: u64 = 1048576;
    if (pool_raise(sim.PoolMemory{taken: 0, bound: 1000 * mib, heap: 8192 * mib, share: 0}) != 2000) { ret 1; }
    if (pool_raise(sim.PoolMemory{taken: 0, bound: 6144 * mib, heap: 8192 * mib, share: 0}) != 8192) { ret 2; }
    if (pool_raise(sim.PoolMemory{taken: 0, bound: 8192 * mib, heap: 8192 * mib, share: 0}) != 0)    { ret 3; }
    # a host's pool, with no device to hold it to, doubles
    if (pool_raise(sim.PoolMemory{taken: 0, bound: 600 * mib, heap: 0, share: 0}) != 1200) { ret 4; }
    ret 0;
}

# the world filling the surface, with the cell under the cursor and the zoom
#[testing]
rec PositionProbe {
    l:    look.Look;
    cam:  render.Camera;
    pt:   render.Port;
    step: i32;
}

#[testing]
fun position_ui(ui: *bctx.Context, user: ptr) {
    val pp: *PositionProbe = user::*PositionProbe;
    val pt: render.Port    = pp.pt;
    val w:  bint.Hit       = bint.hit(ui, bctx.id_of(ui, "world"), pt.x0, pt.y0, pt.x0 + pt.w, pt.y0 + pt.h, binp.BUTTON_LEFT);
    val s:  i32            = position(ui, pp.l, pp.cam, pt, w.hot, w.mx, w.my);
    if (s != 0) { pp.step = s; }
}

# the rect the last frame drew a widget in, empty when it was not drawn
#[testing]
fun rect_of(d: *blit.driver.Driver, id: u64) bctx.Area {
    val r: opt[bctx.Area] = blit.driver.rect(d, id);
    if (sel r.some) { ret r.some; }
    ret bctx.Area{x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0};
}

# whether a widget was drawn in the rect r
#[testing]
fun drawn_in(d: *blit.driver.Driver, id: u64, r: bctx.Area) bool {
    val a: bctx.Area = rect_of(d, id);
    ret r.x1 > r.x0 && a.x0 == r.x0 && a.y0 == r.y0 && a.x1 == r.x1 && a.y1 == r.y1;
}

test position__the_zoom_holds_still_under_the_cursor_and_the_cell_reads_beside_it {
    var al:   allo.Allocator;
    val made: err[allo.Error] = page.make(?al);
    if (sel made.err) { ret 1; }
    var pp: PositionProbe;
    pp.pt   = render.Port{x0: 0.0, y0: 0.0, w: 600.0, h: 300.0};
    pp.cam  = render.Camera{x: 0.0, y: 0.0, ppc: 1.0, x0: 0.0, y0: 0.0, sw: 600.0, sh: 300.0};
    pp.step = 0;
    var d:  blit.driver.Driver;
    val di: err[allo.Error] = blit.driver.init(?d, ?al, 600.0, 300.0, position_ui, (?pp)::ptr);
    if (sel di.err) { ret 1; }
    val l: opt[look.Look] = look.apply(?d.ctx);
    if (sel l.none) { ret 1; }
    pp.l = l.some;

    # with the cursor over the world, the cell under it reads right of the zoom
    blit.driver.move(?d, 590.0, 10.0);
    blit.driver.steps(?d, 2);
    val out: u64       = blit.driver.find(?d, "position/-###zoom_out");
    val inn: u64       = blit.driver.find(?d, "position/+###zoom_in");
    val ro:  bctx.Area = rect_of(?d, out);
    val zr:  bctx.Area = rect_of(?d, inn);
    if (ro.x1 <= ro.x0 || zr.x1 <= zr.x0)                                                               { ret 2; }
    if (!string.str_equals(blit.driver.text_in(?d, zr.x1, zr.y0 - 20.0, 600.0, 300.0), "x 290 y -140")) { ret 3; }

    # the cursor on a zoom button holds it in place frame after frame
    if (!blit.driver.hover(?d, out)) { ret 4; }
    var i: usize = 0;
    for (i < 8) {
        blit.driver.step(?d);
        if (!drawn_in(?d, out, ro))    { ret 6; }
        if (!blit.driver.hot(?d, out)) { ret 7; }
        i = i + 1;
    }
    blit.driver.press(?d, binp.BUTTON_LEFT);
    blit.driver.release(?d, binp.BUTTON_LEFT);
    if (pp.step != -1)               { ret 8; }
    if (!blit.driver.click(?d, inn)) { ret 9; }
    if (pp.step != 1)                { ret 10; }

    # a cell of fewer digits moves neither the zoom nor the cell's boxes
    blit.driver.move(?d, 305.0, 152.0);
    blit.driver.steps(?d, 2);
    if (!drawn_in(?d, inn, zr))                                                                    { ret 11; }
    if (!string.str_equals(blit.driver.text_in(?d, zr.x1, zr.y0 - 20.0, 600.0, 300.0), "x 5 y 2")) { ret 12; }

    val freed: err[allo.Error] = blit.driver.free(?d);
    if (sel freed.err) { ret 1; }
    ret 0;
}
