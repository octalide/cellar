# the heads-up readout, flashed messages and the key reference
#
# the readout sits in the world's top-left corner in small type: whether the
# world runs, its generation, population, the size of the box its live cells
# span, rule and speed. it fades back when
# the cursor comes near, so it never hides the cells under it. the cell under
# the cursor and the zoom sit in the bottom-left corner, messages flash at the
# bottom centre, and the key reference opens over everything.

use cellar.app;
use cellar.render;
use cellar.sim;
use cellar.space;
use cellar.text;
use cellar.theme;
use cellar.ui;
use cellar.world;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# append a number with thousands separators
fun buf_grouped(buf: *u8, off: usize, v: u64) usize {
    var digits: [24]u8;
    val n:      usize = text.buf_u64(?digits[0], 0, v);
    var o:      usize = off;
    var i:      usize = 0;
    for (i < n) {
        if (i > 0 && (n - i) % 3 == 0) {
            buf[o] = ',';
            o      = o + 1;
        }
        buf[o] = digits[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# one label and value pair of the readout; ret the pen after it
fun pair(u: *ui.Ui, x: f32, y0: f32, y1: f32, label: str, value: str, alpha: f32) f32 {
    var pen: f32 = ui.text_mid(u, u.small, label, x, y0, y1, theme.TEXT_FAINT, alpha);
    pen = ui.text_mid(u, u.small, value, pen + ui.px(u, 5.0), y0, y1, theme.TEXT, alpha);
    ret pen + ui.px(u, 14.0);
}

# the readout of the world's state
# ---
# u:  the interface
# a:  application state
# s:  the simulation, locked by the caller
# pt: the world's viewport
pub fun readout(u: *ui.Ui, a: *app.App, s: *sim.Sim, pt: render.Port) {
    var gen: [32]u8;
    gen[buf_grouped(?gen[0], 0, world.generation(s))] = 0;
    var pop: [32]u8;
    pop[buf_grouped(?pop[0], 0, world.population(s)::u64)] = 0;
    var bx: [64]u8;
    var bo: usize          = text.buf_str(?bx[0], 0, "-");
    val b:  opt[space.Box] = world.bounds(s);
    if (sel b.some) {
        bo = buf_grouped(?bx[0], 0, (b.some.x1 - b.some.x0)::u64);
        bo = text.buf_str(?bx[0], bo, " x ");
        bo = buf_grouped(?bx[0], bo, (b.some.y1 - b.some.y0)::u64);
    }
    bx[bo] = 0;
    var rb:   [200]u8;
    val rule: str        = world.rule_string(s, ?rb[0]);
    var name: str        = "custom";
    val m:    opt[usize] = world.rule_preset(s);
    if (sel m.some) { name = world.preset_label(m.some); }
    var sp: [32]u8;
    var so: usize = 0;
    if (a.uncapped != 0) { so = text.buf_str(?sp[0], 0, "max"); }
    or {
        so = text.buf_u64(?sp[0], 0, (a.speed + 0.5)::u64);
        so = text.buf_str(?sp[0], so, "/s");
    }
    sp[so] = 0;
    var extra: str = "";
    if (world.full(s)) { extra = "pool full"; }

    val m0: f32 = ui.px(u, 12.0);
    val h:  f32 = ui.px(u, 30.0);
    val pd: f32 = ui.px(u, 12.0);
    val y0: f32 = m0;
    val y1: f32 = y0 + h;
    val x0: f32 = m0;
    var w:  f32 = pd * 2.0 + ui.px(u, 22.0);
    w = w + ui.measure(u.small, "gen") + ui.measure(u.small, ?gen[0]);
    w = w + ui.measure(u.small, "pop") + ui.measure(u.small, ?pop[0]);
    w = w + ui.measure(u.small, "box") + ui.measure(u.small, ?bx[0]);
    w = w + ui.measure(u.small, rule) + ui.measure(u.small, name);
    w = w + ui.measure(u.small, "speed") + ui.measure(u.small, ?sp[0]);
    w = w + ui.px(u, 5.0 * 5.0 + 14.0 * 5.0) - ui.px(u, 14.0);
    if (world.full(s)) { w = w + ui.measure(u.small, extra) + ui.px(u, 14.0); }
    val x1: f32 = x0 + w;

    # fade back while the cursor is near, so the cells under it stay visible
    var alpha: f32 = 1.0;
    if (ui.inside(u, x0 - m0, y0 - m0, x1 + m0 * 3.0, y1 + m0 * 3.0)) { alpha = 0.25; }
    ui.rect(u, x0, y0, x1, y1, theme.PANEL, 0.88 * alpha);
    ui.frame(u, x0, y0, x1, y1, 1.0, theme.PANEL_EDGE, alpha);

    val cy: f32 = (y0 + y1) / 2.0;
    val k:  f32 = ui.px(u, 4.0);
    var x:  f32 = x0 + pd;
    if (world.running(s)) { ui.tri(u, x, cy - k * 1.2, x, cy + k * 1.2, x + k * 2.0, cy, theme.ACCENT, alpha); }
    or {
        ui.rect(u, x, cy - k * 1.1, x + k * 0.7, cy + k * 1.1, theme.TEXT_DIM, alpha);
        ui.rect(u, x + k * 1.3, cy - k * 1.1, x + k * 2.0, cy + k * 1.1, theme.TEXT_DIM, alpha);
    }
    x = x + ui.px(u, 22.0);
    x = pair(u, x, y0, y1, "gen", ?gen[0], alpha);
    x = pair(u, x, y0, y1, "pop", ?pop[0], alpha);
    x = pair(u, x, y0, y1, "box", ?bx[0], alpha);
    x = pair(u, x, y0, y1, name, rule, alpha);
    x = pair(u, x, y0, y1, "speed", ?sp[0], alpha);
    if (world.full(s)) { ui.text_mid(u, u.small, extra, x, y0, y1, theme.ACCENT, alpha); }
}

# the cell under the cursor and the zoom, in the bottom-left corner
pub fun position(u: *ui.Ui, cam: render.Camera, pt: render.Port, over: bool) {
    var b: [96]u8;
    var o: usize = 0;
    if (over) {
        var cx: i64 = 0;
        var cy: i64 = 0;
        render.cell_at(cam, u.mx, u.my, ?cx, ?cy);
        o = signed(?b[0], o, cx);
        o = text.buf_str(?b[0], o, ", ");
        o = signed(?b[0], o, cy);
        o = text.buf_str(?b[0], o, "    ");
    }
    val z: f32 = cam.ppc;
    if (z >= 1.0) {
        o = text.buf_u64(?b[0], o, z::u64);
        if (z < 10.0) {
            o = text.buf_str(?b[0], o, ".");
            o = text.buf_u64(?b[0], o, ((z - z::u64::f32) * 10.0)::u64);
        }
        o = text.buf_str(?b[0], o, " px per cell");
    }
    or {
        o = text.buf_str(?b[0], o, "1 px per ");
        o = text.buf_u64(?b[0], o, (1.0 / z + 0.5)::u64);
        o = text.buf_str(?b[0], o, " cells");
    }
    b[o] = 0;
    val m: f32 = ui.px(u, 12.0);
    ui.text(u, u.small, ?b[0], m, pt.h - m - ui.line(u.small), theme.TEXT_DIM, 1.0);
}

# append a signed integer
fun signed(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret text.buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret text.buf_u64(buf, off, v::u64);
}

# the selection, tinted and outlined over the cells with its size beside it
pub fun selection(u: *ui.Ui, a: *app.App, cam: render.Camera) {
    if (!a.selected) { ret; }
    val r: render.Span = render.span(cam, a.area);
    ui.rect(u, r.x0, r.y0, r.x1, r.y1, theme.ACCENT, 0.12);
    ui.frame(u, r.x0 - 1.0, r.y0 - 1.0, r.x1 + 1.0, r.y1 + 1.0, ui.px(u, 1.5), theme.ACCENT, 0.9);
    var b: [64]u8;
    var o: usize = text.buf_u64(?b[0], 0, (a.area.x1 - a.area.x0)::u64);
    o    = text.buf_str(?b[0], o, " x ");
    o    = text.buf_u64(?b[0], o, (a.area.y1 - a.area.y0)::u64);
    b[o] = 0;
    val m: f32 = ui.px(u, 4.0);
    ui.text(u, u.small, ?b[0], r.x0, r.y0 - m - ui.line(u.small), theme.ACCENT, 0.9);
}

# the flashed message, fading out over its last half second
pub fun toast(u: *ui.Ui, a: *app.App, pt: render.Port) {
    if (a.toast_t <= 0 || a.toast[0] == 0) { ret; }
    var alpha: f32 = 1.0;
    if (a.toast_t < 30) { alpha = a.toast_t::f32 / 30.0; }
    val pd: f32 = ui.px(u, 14.0);
    val w:  f32 = ui.measure(u.body, a.toast) + pd * 2.0;
    val h:  f32 = ui.px(u, 34.0);
    val x0: f32 = (pt.w - w) / 2.0;
    val y0: f32 = pt.h - h - ui.px(u, 40.0);
    ui.rect(u, x0, y0, x0 + w, y0 + h, theme.CONTROL, 0.95 * alpha);
    ui.rect(u, x0, y0, x0 + ui.px(u, 3.0), y0 + h, theme.ACCENT, alpha);
    ui.text_mid(u, u.body, a.toast, x0 + pd, y0, y0 + h, theme.TEXT, alpha);
}

# the key reference, over everything; a click anywhere closes it
pub fun help(u: *ui.Ui, a: *app.App, sw: f32, sh: f32) {
    if (a.help == 0) { ret; }
    ui.block(u, 0.0, 0.0, sw, sh);
    val hh: ui.Hit = ui.region(u, 0.0, 0.0, sw, sh);
    if (hh.clicked) { a.help = 0; }
    ui.rect(u, 0.0, 0.0, sw, sh, theme.BG, 0.7);

    var keys: [25]str;
    var what: [25]str;
    keys[0]  = "Space";
    what[0]  = "play or pause";
    keys[1]  = "S";
    what[1]  = "step one generation";
    keys[2]  = "R";
    what[2]  = "randomize";
    keys[3]  = "C";
    what[3]  = "clear";
    keys[4]  = "D  E  T  V";
    what[4]  = "draw, erase, stamp, select";
    keys[5]  = "Z  X";
    what[5]  = "rotate or flip the stamp";
    keys[6]  = "Left mouse";
    what[6]  = "use the tool";
    keys[7]  = "Right drag";
    what[7]  = "pan (middle drag too)";
    keys[8]  = "Arrows";
    what[8]  = "pan";
    keys[9]  = "Scroll";
    what[9]  = "zoom toward the cursor";
    keys[10] = "F";
    what[10] = "fit the world to the view";
    keys[11] = "M";
    what[11] = "next colour mode";
    keys[12] = "G";
    what[12] = "grid lines";
    keys[13] = "Tab";
    what[13] = "show or hide the panel";
    keys[14] = "F11";
    what[14] = "fullscreen";
    keys[15] = "F12";
    what[15] = "screenshot";
    keys[16] = "H  F1";
    what[16] = "this reference";
    keys[17] = "Ctrl C  Ctrl X";
    what[17] = "copy or cut to the stamp";
    keys[18] = "Delete";
    what[18] = "clear the selection";
    keys[19] = "Shift Delete";
    what[19] = "clear outside it";
    keys[20] = "Ctrl R";
    what[20] = "fill it at random";
    keys[21] = "I";
    what[21] = "invert it";
    keys[22] = "B";
    what[22] = "shrink it to live cells";
    keys[23] = "Esc";
    what[23] = "close this, deselect, or quit";
    keys[24] = "Backspace";
    what[24] = "reset to where play started";
    val n: usize = 25;

    val lh: f32 = ui.line(u.body) + ui.px(u, 6.0);
    val pd: f32 = ui.px(u, 24.0);
    val kw: f32 = ui.px(u, 120.0);
    val w:  f32 = ui.px(u, 400.0);
    val h:  f32 = pd * 2.0 + ui.line(u.body) + ui.px(u, 12.0) + lh * n::f32;
    val x0: f32 = (sw - w) / 2.0;
    var y0: f32 = (sh - h) / 2.0;
    if (y0 < 0.0) { y0 = 0.0; }
    ui.rect(u, x0, y0, x0 + w, y0 + h, theme.PANEL, 1.0);
    ui.frame(u, x0, y0, x0 + w, y0 + h, 1.0, theme.PANEL_EDGE, 1.0);
    ui.text(u, u.body, "Keys and mouse", x0 + pd, y0 + pd, theme.TEXT, 1.0);
    var y: f32   = y0 + pd + ui.line(u.body) + ui.px(u, 12.0);
    var i: usize = 0;
    for (i < n) {
        ui.text(u, u.body, keys[i], x0 + pd, y, theme.ACCENT, 1.0);
        ui.text(u, u.body, what[i], x0 + pd + kw, y, theme.TEXT, 1.0);
        y = y + lh;
        i = i + 1;
    }
}
