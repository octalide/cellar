# the grid a world runs on: the unbounded plane, or a bounded grid in Golly's
# rule suffix notation
#
#   :Pw,h    a plane, whose edges are dead
#   :Tw,h    a torus, each pair of opposite edges joined
#   :Kw*,h   a Klein bottle, the top and bottom edges joined with a twist, and
#   :Kw,h*   the left and right edges joined with one
#   :Cw,h    a cross-surface, both pairs joined with a twist
#
# a lone width gives a square, and on a plane or a torus a size of 0 leaves
# that axis unbounded. the grid's cells are the w by h box whose top-left cell
# is (-(w / 2), -(h / 2)), where Golly puts it. Golly's shifted tori and its
# sphere are not run.
#
# a bounded grid is kept in the pool's page table (see cellar.layout): a
# chunk's window is the part of its frame on the grid, and its links take a
# position outside the window to the chunk holding it, through the seam where
# it crosses one. both come from trace, which takes a cell off the grid back
# onto it the way the grid's seams join, as the affine map it applied, so a
# link's transform and a halo's image are that map read locally.

use cellar.layout;
use cellar.text;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the unbounded plane
pub val OPEN: u8 = 0;
# a plane of dead edges
pub val PLANE: u8 = 1;
# a torus
pub val TORUS: u8 = 2;
# a Klein bottle
pub val KLEIN: u8 = 3;
# a cross-surface
pub val CROSS: u8 = 4;

# the largest size Golly takes along an axis
pub val SIZE_MAX: i64 = 2000000000;

# the longest suffix format writes, less its NUL: ":K2000000000*,2000000000"
pub val FORMAT_MAX: usize = 24;

# a grid
# ---
# shape:   OPEN, PLANE, TORUS, KLEIN or CROSS
# w:       width in cells, 0 for an unbounded axis
# h:       height in cells, 0 for an unbounded axis
# twist_w: a Klein bottle's top and bottom edges are the twisted ones, its
#          width starred; else its left and right edges are
pub rec Grid {
    shape:   u8;
    w:       i64;
    h:       i64;
    twist_w: bool;
}

# the unbounded plane
pub fun open() Grid {
    ret Grid{shape: OPEN, w: 0, h: 0, twist_w: false};
}

# whether a grid is bounded
pub fun bounded(g: *Grid) bool {
    ret g.shape != OPEN;
}

# whether two grids are the same
pub fun same(a: *Grid, b: *Grid) bool {
    ret a.shape == b.shape && a.w == b.w && a.h == b.h && a.twist_w == b.twist_w;
}

# whether a grid holds finitely many cells: bounded along both axes
pub fun finite(g: *Grid) bool {
    ret bounded_x(g) && bounded_y(g);
}

fun bounded_x(g: *Grid) bool {
    ret g.shape != OPEN && g.w != 0;
}

fun bounded_y(g: *Grid) bool {
    ret g.shape != OPEN && g.h != 0;
}

# the first column of a bounded x axis
pub fun left(g: *Grid) i64 {
    ret 0 - g.w / 2;
}

# the first row of a bounded y axis
pub fun top(g: *Grid) i64 {
    ret 0 - g.h / 2;
}

# crossing the left or right edge mirrors y
fun twists_x(g: *Grid) bool {
    ret g.shape == CROSS || (g.shape == KLEIN && !g.twist_w);
}

# crossing the top or bottom edge mirrors x
fun twists_y(g: *Grid) bool {
    ret g.shape == CROSS || (g.shape == KLEIN && g.twist_w);
}

# whether a grid wraps a rule reaching r cells without a cell meeting itself
# twice over: every joined axis is at least r cells long
pub fun reaches(g: *Grid, r: usize) bool {
    if (g.shape == OPEN || g.shape == PLANE) { ret true; }
    if (g.w != 0 && g.w < r::i64)            { ret false; }
    if (g.h != 0 && g.h < r::i64)            { ret false; }
    ret true;
}

# whether the cell (x, y) is on the grid
pub fun holds(g: *Grid, x: i64, y: i64) bool {
    if (bounded_x(g) && (x < left(g) || x >= left(g) + g.w)) { ret false; }
    if (bounded_y(g) && (y < top(g) || y >= top(g) + g.h))   { ret false; }
    ret true;
}

# clip the run of cells [x0, x1) of row y to the grid
# ---
# ret: false when nothing of the run is on the grid
pub fun clip(g: *Grid, y: i64, x0: *i64, x1: *i64) bool {
    if (bounded_y(g) && (y < top(g) || y >= top(g) + g.h)) { ret false; }
    if (bounded_x(g)) {
        if (@x0 < left(g))       { @x0 = left(g); }
        if (@x1 > left(g) + g.w) { @x1 = left(g) + g.w; }
    }
    ret @x0 < @x1;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

# read a size at s[i], moving i past it
fun size_at(s: str, i: *usize, out: *i64) bool {
    var v: i64   = 0;
    var n: usize = 0;
    for (s[@i] >= '0' && s[@i] <= '9') {
        v = v * 10 + (s[@i] - '0')::i64;
        if (v > SIZE_MAX) { ret false; }
        @i = @i + 1;
        n  = n + 1;
    }
    @out = v;
    ret n != 0;
}

# read the suffix after a rule's colon: a shape letter, then its sizes
# ---
# s:   NUL-terminated suffix text, the colon left out
# ret: the grid, or what is wrong with s
pub fun parse(s: str) res[Grid, str] {
    var g: Grid  = open();
    var i: usize = 0;
    val c: u8    = lower(s[0]);
    if (c == 'p') { g.shape = PLANE; }
    or (c == 't') { g.shape = TORUS; }
    or (c == 'k') { g.shape = KLEIN; }
    or (c == 'c') { g.shape = CROSS; }
    or (c == 's') { ret res[Grid, str].err{"the sphere (:S) is not run"}; }
    or            { ret res[Grid, str].err{"a grid is :P, :T, :K or :C"}; }
    i = 1;
    val sizes: str = "the grid needs a width, and a height after a comma";
    if (!size_at(s, ?i, ?g.w)) { ret res[Grid, str].err{sizes}; }
    var star_w: bool = false;
    var star_h: bool = false;
    if (s[i] == '*') {
        star_w = true;
        i      = i + 1;
    }
    g.h = g.w;
    if (s[i] == ',') {
        i = i + 1;
        if (!size_at(s, ?i, ?g.h)) { ret res[Grid, str].err{sizes}; }
        if (s[i] == '*') {
            star_h = true;
            i      = i + 1;
        }
    }
    if (s[i] == '+' || s[i] == '-') { ret res[Grid, str].err{"a shifted grid is not run"}; }
    if (s[i] != 0)                  { ret res[Grid, str].err{"text follows the grid"}; }
    if (g.shape == KLEIN) {
        if (star_w == star_h) { ret res[Grid, str].err{"a Klein bottle stars its one twisted edge"}; }
        g.twist_w = star_w;
    }
    or (star_w || star_h) { ret res[Grid, str].err{"only a Klein bottle stars an edge"}; }
    if ((g.w == 0 || g.h == 0) && g.shape != PLANE && g.shape != TORUS) {
        ret res[Grid, str].err{"only a plane or a torus may be unbounded along an axis"};
    }
    ret res[Grid, str].ok{g};
}

# write a grid's suffix, colon first, as parse reads it back; the unbounded
# plane has none
# ---
# g:   the grid
# buf: at least off + FORMAT_MAX + 1 bytes
# off: where the suffix goes
# ret: the offset past it, where a NUL is written
pub fun format(g: *Grid, buf: *u8, off: usize) usize {
    var o: usize = off;
    if (g.shape != OPEN) {
        buf[o] = ':';
        if (g.shape == PLANE) { buf[o + 1] = 'P'; }
        or (g.shape == TORUS) { buf[o + 1] = 'T'; }
        or (g.shape == KLEIN) { buf[o + 1] = 'K'; }
        or                    { buf[o + 1] = 'C'; }
        o = text.buf_u64(buf, o + 2, g.w::u64);
        if (g.shape == KLEIN && g.twist_w) {
            buf[o] = '*';
            o      = o + 1;
        }
        buf[o] = ',';
        o      = text.buf_u64(buf, o + 1, g.h::u64);
        if (g.shape == KLEIN && !g.twist_w) {
            buf[o] = '*';
            o      = o + 1;
        }
    }
    buf[o] = 0;
    ret o;
}

# the part of a chunk's frame on the grid, [x0, x1) by [y0, y1), empty when
# the chunk lies off it
pub rec Window {
    x0: i64;
    x1: i64;
    y0: i64;
    y1: i64;
}

fun clamp(v: i64) i64 {
    if (v < 0)                { ret 0; }
    if (v > layout.SIDE::i64) { ret layout.SIDE::i64; }
    ret v;
}

# the window of the chunk at (cx, cy)
pub fun window(g: *Grid, cx: i64, cy: i64) Window {
    val side: i64    = layout.SIDE::i64;
    var wn:   Window = Window{x0: 0, x1: side, y0: 0, y1: side};
    if (bounded_x(g)) {
        wn.x0 = clamp(left(g) - cx * side);
        wn.x1 = clamp(left(g) + g.w - cx * side);
    }
    if (bounded_y(g)) {
        wn.y0 = clamp(top(g) - cy * side);
        wn.y1 = clamp(top(g) + g.h - cy * side);
    }
    ret wn;
}

# whether any cell of the chunk at (cx, cy) is on the grid
pub fun inside(g: *Grid, cx: i64, cy: i64) bool {
    val wn: Window = window(g, cx, cy);
    ret wn.x0 < wn.x1 && wn.y0 < wn.y1;
}

fun whole(g: *Grid, cx: i64, cy: i64) bool {
    val wn: Window = window(g, cx, cy);
    val s:  i64    = layout.SIDE::i64;
    ret wn.x0 == 0 && wn.x1 == s && wn.y0 == 0 && wn.y1 == s;
}

# whether a step must read the chunk at (cx, cy) through its links: its 3 by 3
# block does not lie whole on the grid
pub fun seamed(g: *Grid, cx: i64, cy: i64) bool {
    if (g.shape == OPEN) { ret false; }
    var k: i64 = 0;
    for (k < 9) {
        if (!whole(g, cx + k % 3 - 1, cy + k / 3 - 1)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the edge word of the chunk at (cx, cy) (cellar.layout.edge)
pub fun edge_word(g: *Grid, cx: i64, cy: i64) u32 {
    val wn: Window = window(g, cx, cy);
    var s:  u32    = 0;
    if (seamed(g, cx, cy)) { s = 1; }
    ret layout.edge(wn.x0::u32, wn.x1::u32, wn.y0::u32, wn.y1::u32, s);
}

# an affine map of cells, x' = fx * x + ox and y' = fy * y + oy
pub rec Map {
    fx: i64;
    fy: i64;
    ox: i64;
    oy: i64;
}

# take the cell (x, y) onto the grid the way its seams join, as the map that
# does it; a cell on the grid is taken by the identity
# ---
# m:   receives the map
# ret: false when the cell lies past a plane's dead edge, or further off a
#      joined axis than the axis is long
pub fun trace(g: *Grid, x: i64, y: i64, m: *Map) bool {
    @m = Map{fx: 1, fy: 1, ox: 0, oy: 0};
    var px: i64 = x;
    var py: i64 = y;
    val mx: i64 = 2 * left(g) + g.w - 1;
    val my: i64 = 2 * top(g) + g.h - 1;
    var n:  i64 = 0;
    for (n < 4) {
        var ex: i64 = 0;
        var ey: i64 = 0;
        if (bounded_x(g) && px < left(g))        { ex = 1; }
        or (bounded_x(g) && px >= left(g) + g.w) { ex = -1; }
        or (bounded_y(g) && py < top(g))         { ey = 1; }
        or (bounded_y(g) && py >= top(g) + g.h)  { ey = -1; }
        or                                       { ret true; }
        if (g.shape == PLANE)                    { ret false; }
        if (ex != 0) {
            px   = px + ex * g.w;
            m.ox = m.ox + ex * g.w;
            if (twists_x(g)) {
                py   = my - py;
                m.fy = 0 - m.fy;
                m.oy = my - m.oy;
            }
        }
        or {
            py   = py + ey * g.h;
            m.oy = m.oy + ey * g.h;
            if (twists_y(g)) {
                px   = mx - px;
                m.fx = 0 - m.fx;
                m.ox = mx - m.ox;
            }
        }
        n = n + 1;
    }
    ret false;
}

# a chunk's link toward one side of its window
# ---
# any:  a chunk lies that way, else the side is past a dead edge
# cx:   its chunk column
# cy:   its chunk row
# word: the link word taking the chunk's frame into that chunk's, or
#       layout.LINK_EDGE past a plane's dead edge
pub rec Link {
    any:  bool;
    cx:   i64;
    cy:   i64;
    word: u32;
}

# the cell standing for one side of a window along an axis: the one just
# before it, its middle, or the one just past it
fun stand(side: i64, lo: i64, hi: i64) i64 {
    if (side == 0) { ret lo - 1; }
    if (side == 2) { ret hi; }
    ret (lo + hi - 1) / 2;
}

# the link of the chunk at (cx, cy) toward side k of its window (cellar.layout.edge_side)
#
# the chunk linked is the one the cell standing for that side is taken into,
# and the link word the map that takes it, read in the two frames. a side's
# cells are taken by the one map, since they cross the same seams, and they
# land within a cell of the linked chunk's window on either side where a twist
# mirrors an odd size and within a rule's radius past it elsewhere, which a
# second hop takes on.
pub fun link(g: *Grid, cx: i64, cy: i64, k: u32) Link {
    val side: i64    = layout.SIDE::i64;
    val wn:   Window = window(g, cx, cy);
    val px:   i64    = cx * side + stand((k % 3)::i64, wn.x0, wn.x1);
    val py:   i64    = cy * side + stand((k / 3)::i64, wn.y0, wn.y1);
    var m:    Map;
    if (!trace(g, px, py, ?m)) {
        var edge: u32 = 0;
        if (g.shape == PLANE) { edge = layout.LINK_EDGE; }
        ret Link{any: false, cx: 0, cy: 0, word: edge};
    }
    val tx:   i64 = (m.fx * px + m.ox) >> 6;
    val ty:   i64 = (m.fy * py + m.oy) >> 6;
    var bits: u32 = 0;
    if (m.fx < 0)                                         { bits = bits | layout.LINK_FLIP_X; }
    if (m.fy < 0)                                         { bits = bits | layout.LINK_FLIP_Y; }
    if (m.fx != 1 || m.fy != 1 || m.ox != 0 || m.oy != 0) { bits = bits | layout.LINK_SEAM; }
    val ox: i64 = m.fx * cx * side + m.ox - tx * side;
    val oy: i64 = m.fy * cy * side + m.oy - ty * side;
    ret Link{any: true, cx: tx, cy: ty, word: layout.link(bits, ox::i32, oy::i32)};
}

# the parts of the span [a, b) along an axis starting at lo of n cells: before,
# on and past it, each part off it no longer than the axis, since the rest of
# it would only land on cells the nearer part does
fun parts(on: bool, lo: i64, n: i64, a: i64, b: i64, out: *i64) usize {
    if (!on) {
        out[0] = a;
        out[1] = b;
        ret 1;
    }
    var c: usize = 0;
    var s: [6]i64;
    s[0] = a;
    s[1] = b;
    if (s[0] < lo - n) { s[0] = lo - n; }
    if (s[1] > lo)     { s[1] = lo; }
    s[2] = a;
    s[3] = b;
    if (s[2] < lo)     { s[2] = lo; }
    if (s[3] > lo + n) { s[3] = lo + n; }
    s[4] = a;
    s[5] = b;
    if (s[4] < lo + n)     { s[4] = lo + n; }
    if (s[5] > lo + n + n) { s[5] = lo + n + n; }
    var p: usize = 0;
    for (p < 3) {
        if (s[p * 2] < s[p * 2 + 1]) {
            out[c * 2]     = s[p * 2];
            out[c * 2 + 1] = s[p * 2 + 1];
            c              = c + 1;
        }
        p = p + 1;
    }
    ret c;
}

# the most chunks images names for one box: nine parts of it, each landing on
# at most 2 by 2 chunks
pub val IMAGES_MAX: usize = 36;

# the chunks holding the cells of the box [x0, x1) by [y0, y1) once taken onto
# the grid, each part of the box off the grid by the seam it crosses, and none
# past a dead edge. a chunk may be named twice.
# ---
# g:   the grid
# out: IMAGES_MAX pairs of chunk column and row
# ret: the pairs written
pub fun images(g: *Grid, x0: i64, y0: i64, x1: i64, y1: i64, out: *i64) usize {
    var xs: [6]i64;
    var ys: [6]i64;
    val nx: usize = parts(bounded_x(g), left(g), g.w, x0, x1, ?xs[0]);
    val ny: usize = parts(bounded_y(g), top(g), g.h, y0, y1, ?ys[0]);
    var c:  usize = 0;
    var j:  usize = 0;
    for (j < ny) {
        var i: usize = 0;
        for (i < nx) {
            var m: Map;
            if (trace(g, xs[i * 2], ys[j * 2], ?m)) {
                var ax: i64 = m.fx * xs[i * 2] + m.ox;
                var bx: i64 = m.fx * (xs[i * 2 + 1] - 1) + m.ox;
                var ay: i64 = m.fy * ys[j * 2] + m.oy;
                var by: i64 = m.fy * (ys[j * 2 + 1] - 1) + m.oy;
                if (bx < ax) {
                    val t: i64 = ax;
                    ax = bx;
                    bx = t;
                }
                if (by < ay) {
                    val t: i64 = ay;
                    ay = by;
                    by = t;
                }
                var cy: i64 = ay >> 6;
                for (cy <= by >> 6) {
                    var cx: i64 = ax >> 6;
                    for (cx <= bx >> 6) {
                        out[c * 2]     = cx;
                        out[c * 2 + 1] = cy;
                        c              = c + 1;
                        cx             = cx + 1;
                    }
                    cy = cy + 1;
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    ret c;
}

fun parsed(s: str) Grid {
    val r: res[Grid, str] = parse(s);
    if (sel r.ok) { ret r.ok; }
    ret open();
}

test parse__reads_golly_suffixes_and_format_writes_them_back {
    var b:     [25]u8;
    val cases: [6]str = [6]str{"T100,100", "P30,20", "K30*,20", "K30,20*", "C7,9", "T0,40"};
    var i:     usize  = 0;
    for (i < 6) {
        val r: res[Grid, str] = parse(cases[i]);
        if (sel r.err) { ret 1; }
        var g: Grid  = r.ok;
        val n: usize = format(?g, ?b[0], 0);
        if (b[0] != ':' || n == 0) { ret 2; }
        val again: res[Grid, str] = parse(?b[1]);
        if (sel again.err)        { ret 3; }
        if (!same(?again.ok, ?g)) { ret 4; }
        i = i + 1;
    }
    # a lone width is a square, in either case of letter
    var sq: Grid = parsed("t64");
    if (sq.shape != TORUS || sq.w != 64 || sq.h != 64) { ret 5; }
    var kw: Grid = parsed("K30*,20");
    if (!kw.twist_w) { ret 6; }
    val bad: [8]str = [8]str{"S10", "T", "T10+2,10", "K10,10", "K10*,10*", "T10*,10", "K0*,10", "Q10"};
    i = 0;
    for (i < 8) {
        val r: res[Grid, str] = parse(bad[i]);
        if (sel r.ok) { ret 7 + i::i32; }
        i = i + 1;
    }
    var o: Grid = open();
    if (format(?o, ?b[0], 0) != 0 || b[0] != 0) { ret 20; }
    ret 0;
}

test trace__joins_each_shape_edges_the_way_golly_does {
    # a 10 by 6 grid spans columns -5..4 and rows -3..2
    var m: Map;
    var t: Grid = parsed("T10,6");
    if (!trace(?t, 5, -4, ?m))                          { ret 1; }
    if (m.fx * 5 + m.ox != -5 || m.fy * -4 + m.oy != 2) { ret 2; }
    var p: Grid = parsed("P10,6");
    if (trace(?p, 5, 0, ?m) || !trace(?p, 4, 0, ?m)) { ret 3; }
    # the starred width twists the top and bottom: leaving the bottom mirrors x
    var k: Grid = parsed("K10*,6");
    if (!trace(?k, -5, 3, ?m))                          { ret 4; }
    if (m.fx * -5 + m.ox != 4 || m.fy * 3 + m.oy != -3) { ret 5; }
    if (!trace(?k, 5, 0, ?m))                           { ret 6; }
    if (m.fx * 5 + m.ox != -5 || m.fy * 0 + m.oy != 0)  { ret 7; }
    # a cross-surface's corner cell is its own diagonal neighbour
    var c: Grid = parsed("C10,6");
    if (!trace(?c, 5, -4, ?m))                          { ret 8; }
    if (m.fx * 5 + m.ox != 4 || m.fy * -4 + m.oy != -3) { ret 9; }
    ret 0;
}

test link__takes_a_side_across_the_seam_into_the_chunk_holding_it {
    # a 100 by 100 torus spans -50..49: chunk -1 holds columns 14..63 of its
    # frame, chunk 0 columns 0..49
    var t:  Grid   = parsed("T100,100");
    val wn: Window = window(?t, -1, 0);
    if (wn.x0 != 14 || wn.x1 != 64 || !seamed(?t, 0, 0)) { ret 1; }
    # east of chunk 0 is past column 49, so it wraps to chunk -1's column 14
    val e: Link = link(?t, 0, 0, 5);
    if (!e.any || e.cx != -1 || e.cy != 0)                                     { ret 2; }
    if ((e.word & layout.LINK_SEAM) == 0)                                      { ret 3; }
    if (layout.hop_x(e.word, 50, 7) != 14 || layout.hop_y(e.word, 50, 7) != 7) { ret 4; }
    # west of chunk 0 is plain, chunk -1 one frame to the left
    val w: Link = link(?t, 0, 0, 3);
    if (w.cx != -1 || w.word != layout.plain_link(3)) { ret 5; }
    # on a Klein bottle twisted top and bottom, leaving chunk 0 upward lands
    # mirrored in the bottom row
    var k: Grid = parsed("K128*,128");
    val n: Link = link(?k, 0, -1, 1);
    if (!n.any || n.cx != -1 || n.cy != 0) { ret 6; }
    # column 5 of chunk 0 (x 5) crossing up lands at x -6, column 58 of chunk -1
    if (layout.hop_x(n.word, 5, -1) != 58 || layout.hop_y(n.word, 5, -1) != 63) { ret 7; }
    var p: Grid = parsed("P100,100");
    if (link(?p, 0, 0, 5).any) { ret 8; }
    ret 0;
}

test images__lands_a_box_off_the_grid_on_the_chunks_across_the_seam {
    var t:   Grid = parsed("T100,100");
    var out: [72]i64;
    # east of chunk 0, columns 64..99 wrap onto -36..-1 and 100..127 onto
    # 0..27, so chunks -1 and 0
    val n:     usize = images(?t, 64, 0, 128, 50, ?out[0]);
    var hit_a: bool  = false;
    var hit_b: bool  = false;
    var i:     usize = 0;
    for (i < n) {
        if (out[i * 2 + 1] != 0) { ret 1; }
        if (out[i * 2] == -1)    { hit_a = true; }
        or (out[i * 2] == 0)     { hit_b = true; }
        or                       { ret 2; }
        i = i + 1;
    }
    if (!hit_a || !hit_b) { ret 3; }
    var p: Grid = parsed("P100,100");
    if (images(?p, 64, 0, 128, 64, ?out[0]) != 0) { ret 4; }
    var o: Grid = open();
    if (images(?o, 64, 0, 128, 64, ?out[0]) != 1 || out[0] != 1 || out[1] != 0) { ret 5; }
    ret 0;
}
