# the command line, read into what the run should do
#
# options may come in any order, before or after the file. `--` ends the
# options, so a file whose name starts with a dash can still be named. an
# unknown option, an option missing its value, a bad value, an option given
# twice or a second file is refused, and the binary says why and exits rather
# than starting.
#
#   cellar [--version] [--capture <file.png>] [--bench <gpu|cpu> <dense|sparse|pause> [seconds [radius [speed]]]]
#          [--engine <cpu|gpu|hashlife>] [--] [file]
#   cellar run <pattern> --gens <n> [--rule <rule>] [--engine <cpu|hashlife>] [--out <file>] [--quiet]
#              [--max-population <n|off>] [--max-chunks <n|off>] [--max-memory <MiB|off>] [--max-step-ms <ms|off>] [--]
#
# --engine names the engine the world runs on: the chunk pool stepped by the
# CPU or by the GPU, or HashLife. left out, the pool runs on the GPU where it
# can. a batch run has no GPU, and on HashLife --gens goes straight to the
# generation by powers of two, so it needs no step size of its own.
#
# the --max-* options set a batch run's ceilings (cellar.ceiling) to a limit in
# the ceiling's unit, or off, over what the saved settings keep.
#
# a first argument of exactly "run" names the batch command, whose options are
# its own, and anything else is the session's command line. a file named run is
# opened as ./run or after --.

use cellar.ceiling;
use cellar.rules.weighted;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# the usage printed with a refusal of the session's command line, both forms
pub val USAGE: str = "usage: cellar [--version] [--capture <file.png>] [--bench <gpu|cpu> <dense|sparse|pause> [seconds [radius [speed]]]]\n              [--engine <cpu|gpu|hashlife>] [--] [file]\n       cellar run <pattern> --gens <n> [--rule <rule>] [--engine <cpu|hashlife>] [--out <file>] [--quiet]\n                  [--max-population <n|off>] [--max-chunks <n|off>] [--max-memory <MiB|off>] [--max-step-ms <ms|off>] [--]";

# the usage printed with a refusal of a batch run, its form alone
pub val RUN_USAGE: str = "usage: cellar run <pattern> --gens <n> [--rule <rule>] [--engine <cpu|hashlife>] [--out <file>] [--quiet]\n                  [--max-population <n|off>] [--max-chunks <n|off>] [--max-memory <MiB|off>] [--max-step-ms <ms|off>] [--]";

# an interactive session
pub val COMMAND_APP: u8 = 0;
# a headless batch run, see cellar.batch
pub val COMMAND_RUN: u8 = 1;

# no engine named: the pool, on the GPU where it can step
pub val ENGINE_ANY: u8 = 0;
# the pool, stepped by the CPU
pub val ENGINE_CPU: u8 = 1;
# the pool, stepped by the GPU
pub val ENGINE_GPU: u8 = 2;
# HashLife
pub val ENGINE_HASHLIFE: u8 = 3;

# the most generations a batch run takes, so the count never overflows
pub val GENS_MAX: u64 = 1000000000000000;

# no measurement: a normal session
pub val BENCH_NONE: u8 = 0;
# a 512 by 512 random soup
pub val BENCH_DENSE: u8 = 1;
# 400 small soups a thousand cells apart, a world twenty thousand cells across
pub val BENCH_SPARSE: u8 = 2;
# Seeds from a 512 by 512 soup, paused and resumed, timing each pause
pub val BENCH_PAUSE: u8 = 3;

# seconds a measurement runs when none are given
pub val BENCH_SECS: f64 = 10.0;

# what a batch run asks for
# ---
# pattern: the world or pattern file to run
# rule:    the rule to run it under, or nil for the file's
# gens:    generations to step
# engine:  ENGINE_ANY, ENGINE_CPU or ENGINE_HASHLIFE
# out:     the file to write the result to, its format by its extension, or
#          nil for RLE on stdout
# quiet:   leave the generation and population off stderr
# set:     each ceiling an option set
# limit:   each ceiling's limit as set, 0 for off
pub rec Run {
    pattern: str;
    rule:    str;
    gens:    u64;
    engine:  u8;
    out:     str;
    quiet:   bool;
    set:     [4]bool;
    limit:   [4]u64;
}

# what the command line asks for
# ---
# command:    COMMAND_APP, or COMMAND_RUN with run filled
# run:        the batch run's arguments
# version:    print the version and exit
# capture:    save a screenshot here after a second and exit, or nil
# bench:      the measurement to run, BENCH_NONE for a normal session
# bench_cpu:  the measurement steps on the CPU
# bench_secs: seconds the measurement runs for
# bench_r:    the radius the measured rule reads, Life's weights widened to it
# bench_gps:  generations a second the measurement is capped at, 0 uncapped
# engine:     the ENGINE_* the world runs on
# open:       a world or pattern file to open, or nil
pub rec Args {
    command:    u8;
    run:        Run;
    version:    bool;
    capture:    str;
    bench:      u8;
    bench_cpu:  bool;
    bench_secs: f64;
    bench_r:    usize;
    bench_gps:  usize;
    engine:     u8;
    open:       str;
}

# why a command line was refused, each naming the argument at fault
# ---
# unknown: an option cellar does not have
# missing: an option at the end without the value it takes
# value:   an option's value is not one it accepts
# twice:   an option given more than once
# extra:   a second file
# absent:  something the command needs was not given
pub tag Error: u8 {
    unknown: str;
    missing: str;
    value:   str;
    twice:   str;
    extra:   str;
    absent:  str;
}

# the refusal as a line of text into buf
# ---
# e:   the refusal
# buf: at least 64 bytes more than the argument it names
# ret: buf
pub fun error_message(e: Error, buf: *u8) str {
    var what: str = "";
    var arg:  str = "";
    if (sel e.unknown) {
        what = "unknown option ";
        arg  = e.unknown;
    }
    if (sel e.missing) {
        what = "a value is missing after ";
        arg  = e.missing;
    }
    if (sel e.value) {
        what = "not a value that option takes: ";
        arg  = e.value;
    }
    if (sel e.twice) {
        what = "given more than once: ";
        arg  = e.twice;
    }
    if (sel e.extra) {
        what = "only one file can be opened, not also ";
        arg  = e.extra;
    }
    if (sel e.absent) {
        what = "run needs ";
        arg  = e.absent;
    }
    var o: usize = 0;
    var i: usize = 0;
    for (what[i] != 0) {
        buf[o] = what[i];
        o      = o + 1;
        i      = i + 1;
    }
    i = 0;
    for (arg[i] != 0 && i < 1024) {
        buf[o] = arg[i];
        o      = o + 1;
        i      = i + 1;
    }
    buf[o] = 0;
    ret buf;
}

# whether an argument is an option rather than a file
fun is_option(s: str) bool {
    ret s[0] == '-' && s[1] != 0;
}

# whether an argument is a whole number of seconds
fun is_seconds(s: str) bool {
    if (s[0] == 0) { ret false; }
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret false; }
        i = i + 1;
    }
    ret true;
}

# a whole number from its digits
fun whole(s: str) usize {
    var v: usize = 0;
    var i: usize = 0;
    for (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (s[i] - '0')::usize;
        i = i + 1;
    }
    ret v;
}

# a whole number of seconds from its digits, at least one
fun seconds(s: str) f64 {
    var v: f64   = 0.0;
    var i: usize = 0;
    for (s[i] >= '0' && s[i] <= '9') {
        v = v * 10.0 + (s[i] - '0')::f64;
        i = i + 1;
    }
    if (v < 1.0) { ret 1.0; }
    ret v;
}

# a whole number of generations, or false when s is not one GENS_MAX holds
fun gens(s: str, out: *u64) bool {
    if (s[0] == 0) { ret false; }
    var v: u64   = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] < '0' || s[i] > '9') { ret false; }
        v = v * 10 + (s[i] - '0')::u64;
        if (v > GENS_MAX) { ret false; }
        i = i + 1;
    }
    @out = v;
    ret true;
}

# a ceiling's limit, off as 0, or false when s is neither off nor a whole
# number GENS_MAX holds
fun limit_of(s: str, out: *u64) bool {
    if (str_equals(s, "off")) {
        @out = 0;
        ret true;
    }
    ret gens(s, out) && @out != 0;
}

# the value after an option taking one, or why there is none
fun value(argc: i64, argv: *str, i: *i64, taken: bool, name: str, out: *str) opt[Error] {
    if (taken)      { ret opt[Error].some{Error.twice{name}}; }
    if (@i >= argc) { ret opt[Error].some{Error.missing{name}}; }
    @out = argv[@i];
    @i   = @i + 1;
    ret opt[Error].none{};
}

# the engine an --engine value names, or ENGINE_ANY for none it knows
fun engine_named(s: str) u8 {
    if (str_equals(s, "cpu"))      { ret ENGINE_CPU; }
    if (str_equals(s, "gpu"))      { ret ENGINE_GPU; }
    if (str_equals(s, "hashlife")) { ret ENGINE_HASHLIFE; }
    ret ENGINE_ANY;
}

# read an --engine value into out, refusing one it does not know and, without
# gpu, the GPU's
fun engine_value(argc: i64, argv: *str, i: *i64, out: *u8, gpu: bool) opt[Error] {
    var n: str        = nil;
    val e: opt[Error] = value(argc, argv, i, @out != ENGINE_ANY, "--engine", ?n);
    if (sel e.some) { ret e; }
    val k: u8 = engine_named(n);
    if (k == ENGINE_ANY || (k == ENGINE_GPU && !gpu)) { ret opt[Error].some{Error.value{n}}; }
    @out = k;
    ret opt[Error].none{};
}

# read a batch run's arguments, those after "run"
fun parse_run(argc: i64, argv: *str, r: *Args) opt[Error] {
    val o: *Run = ?r.run;
    r.command = COMMAND_RUN;
    o.pattern = nil;
    o.rule    = nil;
    o.gens    = 0;
    o.engine  = ENGINE_ANY;
    o.out     = nil;
    o.quiet   = false;
    var k: usize = 0;
    for (k < ceiling.COUNT) {
        o.set[k]   = false;
        o.limit[k] = 0;
        k          = k + 1;
    }
    var counted: bool = false;
    var flags:   bool = true;
    var i:       i64  = 2;
    for (i < argc) {
        val s: str = argv[i];
        i = i + 1;
        if (!flags || !is_option(s)) {
            if (o.pattern != nil) { ret opt[Error].some{Error.extra{s}}; }
            o.pattern = s;
            cnt;
        }
        if (str_equals(s, "--")) {
            flags = false;
            cnt;
        }
        if (str_equals(s, "--quiet")) {
            o.quiet = true;
            cnt;
        }
        var e: opt[Error] = opt[Error].none{};
        if (str_equals(s, "--rule"))   { e = value(argc, argv, ?i, o.rule != nil, s, ?o.rule); }
        or (str_equals(s, "--out"))    { e = value(argc, argv, ?i, o.out != nil, s, ?o.out); }
        or (str_equals(s, "--engine")) { e = engine_value(argc, argv, ?i, ?o.engine, false); }
        or (str_equals(s, "--gens")) {
            var n: str = nil;
            e = value(argc, argv, ?i, counted, s, ?n);
            if (sel e.none && !gens(n, ?o.gens)) { e = opt[Error].some{Error.value{n}}; }
            counted = true;
        }
        or (ceiling.of_flag(s) != ceiling.COUNT) {
            val c: usize = ceiling.of_flag(s);
            var n: str   = nil;
            e = value(argc, argv, ?i, o.set[c], s, ?n);
            if (sel e.none && !limit_of(n, ?o.limit[c])) { e = opt[Error].some{Error.value{n}}; }
            o.set[c] = true;
        }
        or              { e = opt[Error].some{Error.unknown{s}}; }
        if (sel e.some) { ret e; }
    }
    if (o.pattern == nil) { ret opt[Error].some{Error.absent{"a pattern file"}}; }
    if (!counted)         { ret opt[Error].some{Error.absent{"--gens"}}; }
    ret opt[Error].none{};
}

# whether a command line names the batch run
fun is_run(argc: i64, argv: *str) bool {
    ret argc > 1 && str_equals(argv[1], "run");
}

# the usage to print beside a refusal of a command line: the batch run's form
# when it names the run, both forms otherwise
# ---
# argc: arguments, the program's name first
# argv: the arguments
pub fun usage(argc: i64, argv: *str) str {
    if (is_run(argc, argv)) { ret RUN_USAGE; }
    ret USAGE;
}

# read a command line
# ---
# argc: arguments, the program's name first
# argv: the arguments
# ret:  what they ask for, or why they were refused
pub fun parse(argc: i64, argv: *str) res[Args, Error] {
    var r: Args;
    r.command    = COMMAND_APP;
    r.version    = false;
    r.capture    = nil;
    r.bench      = BENCH_NONE;
    r.bench_cpu  = false;
    r.bench_secs = BENCH_SECS;
    r.bench_r    = 1;
    r.bench_gps  = 0;
    r.engine     = ENGINE_ANY;
    r.open       = nil;
    if (is_run(argc, argv)) {
        val bad: opt[Error] = parse_run(argc, argv, ?r);
        if (sel bad.some) { ret res[Args, Error].err{bad.some}; }
        ret res[Args, Error].ok{r};
    }
    var flags: bool = true;
    var i:     i64  = 1;
    for (i < argc) {
        val s: str = argv[i];
        i = i + 1;
        if (!flags || !is_option(s)) {
            if (r.open != nil) { ret res[Args, Error].err{Error.extra{s}}; }
            r.open = s;
            cnt;
        }
        if (str_equals(s, "--")) {
            flags = false;
            cnt;
        }
        if (str_equals(s, "--version")) {
            r.version = true;
            cnt;
        }
        if (str_equals(s, "--capture")) {
            if (r.capture != nil) { ret res[Args, Error].err{Error.twice{s}}; }
            if (i >= argc)        { ret res[Args, Error].err{Error.missing{s}}; }
            r.capture = argv[i];
            i         = i + 1;
            cnt;
        }
        if (str_equals(s, "--engine")) {
            val bad: opt[Error] = engine_value(argc, argv, ?i, ?r.engine, true);
            if (sel bad.some) { ret res[Args, Error].err{bad.some}; }
            cnt;
        }
        if (str_equals(s, "--bench")) {
            if (r.bench != BENCH_NONE) { ret res[Args, Error].err{Error.twice{s}}; }
            if (i + 1 >= argc)         { ret res[Args, Error].err{Error.missing{s}}; }
            val engine: str = argv[i];
            val world:  str = argv[i + 1];
            if (str_equals(engine, "cpu"))   { r.bench_cpu = true; }
            or (!str_equals(engine, "gpu"))  { ret res[Args, Error].err{Error.value{engine}}; }
            if (str_equals(world, "dense"))  { r.bench = BENCH_DENSE; }
            or (str_equals(world, "sparse")) { r.bench = BENCH_SPARSE; }
            or (str_equals(world, "pause"))  { r.bench = BENCH_PAUSE; }
            or                               { ret res[Args, Error].err{Error.value{world}}; }
            i = i + 2;
            if (i < argc && is_seconds(argv[i])) {
                r.bench_secs = seconds(argv[i]);
                i            = i + 1;
                # a radius may follow the seconds
                if (i < argc && is_seconds(argv[i])) {
                    r.bench_r = seconds(argv[i])::usize;
                    if (r.bench_r > weighted.MAX_RADIUS) { ret res[Args, Error].err{Error.value{argv[i]}}; }
                    i = i + 1;
                    # and a capped speed the radius
                    if (i < argc && is_seconds(argv[i])) {
                        r.bench_gps = whole(argv[i]);
                        i           = i + 1;
                    }
                }
            }
            cnt;
        }
        ret res[Args, Error].err{Error.unknown{s}};
    }
    ret res[Args, Error].ok{r};
}

# parse a line of arguments, the program's name left off
#[testing]
fun line(va: ...) res[Args, Error] {
    var v: [12]str;
    v[0] = "cellar";
    var n: i64 = 1;
    $each s in va {
        v[n] = s;
        n    = n + 1;
    }
    ret parse(n, ?v[0]);
}

test parse__takes_options_in_any_order_around_the_file {
    val a: res[Args, Error] = line("gun.rle", "--capture", "shot.png");
    if (!sel a.ok)                                                                  { ret 1; }
    if (!str_equals(a.ok.open, "gun.rle") || !str_equals(a.ok.capture, "shot.png")) { ret 2; }
    val b: res[Args, Error] = line("--capture", "shot.png", "gun.rle");
    if (!sel b.ok)                                                                  { ret 3; }
    if (!str_equals(b.ok.open, "gun.rle") || !str_equals(b.ok.capture, "shot.png")) { ret 4; }
    val c: res[Args, Error] = line("--bench", "cpu", "sparse", "--version");
    if (!sel c.ok)                                                                                       { ret 5; }
    if (c.ok.bench != BENCH_SPARSE || !c.ok.bench_cpu || !c.ok.version || c.ok.bench_secs != BENCH_SECS) { ret 6; }
    # the seconds are taken only when they are a number, so a file may follow
    val d: res[Args, Error] = line("--bench", "gpu", "dense", "3", "soup.cellar");
    if (!sel d.ok)                                                                                              { ret 7; }
    if (d.ok.bench_secs != 3.0 || d.ok.bench_cpu || d.ok.bench_r != 1 || !str_equals(d.ok.open, "soup.cellar")) { ret 8; }
    val f: res[Args, Error] = line("--bench", "gpu", "dense", "3", "4");
    if (!sel f.ok)                                                          { ret 11; }
    if (f.ok.bench_secs != 3.0 || f.ok.bench_r != 4 || f.ok.bench_gps != 0) { ret 12; }
    val h: res[Args, Error] = line("--bench", "gpu", "sparse", "3", "1", "60");
    if (!sel h.ok)                                 { ret 13; }
    if (h.ok.bench_r != 1 || h.ok.bench_gps != 60) { ret 14; }
    val e: res[Args, Error] = line();
    if (!sel e.ok)                                                           { ret 9; }
    if (e.ok.open != nil || e.ok.capture != nil || e.ok.bench != BENCH_NONE) { ret 10; }
    ret 0;
}

test parse__refuses_unknown_options_missing_values_and_a_second_file {
    val a: res[Args, Error] = line("gun.rle", "--capure", "shot.png");
    if (!(sel a.err && sel a.err.unknown)) { ret 1; }
    val b: res[Args, Error] = line("gun.rle", "--capture");
    if (!(sel b.err && sel b.err.missing)) { ret 2; }
    val c: res[Args, Error] = line("--bench", "cpu");
    if (!(sel c.err && sel c.err.missing)) { ret 3; }
    val d: res[Args, Error] = line("--bench", "tpu", "dense");
    if (!(sel d.err && sel d.err.value)) { ret 4; }
    val e: res[Args, Error] = line("a.rle", "b.rle");
    if (!(sel e.err && sel e.err.extra)) { ret 5; }
    val f: res[Args, Error] = line("--capture", "a.png", "--capture", "b.png");
    if (!(sel f.err && sel f.err.twice)) { ret 6; }
    val g: res[Args, Error] = line("-x");
    if (!(sel g.err && sel g.err.unknown)) { ret 7; }
    val h: res[Args, Error] = line("--bench", "gpu", "dense", "3", "17");
    if (!(sel h.err && sel h.err.value)) { ret 9; }
    var buf: [128]u8;
    if (sel a.err && !str_equals(error_message(a.err, ?buf[0]), "unknown option --capure")) { ret 8; }
    ret 0;
}

test parse__takes_everything_after_a_double_dash_as_the_file {
    val a: res[Args, Error] = line("--capture", "shot.png", "--", "-x");
    if (!sel a.ok)                                                             { ret 1; }
    if (!str_equals(a.ok.open, "-x") || !str_equals(a.ok.capture, "shot.png")) { ret 2; }
    val b: res[Args, Error] = line("--", "--version");
    if (!sel b.ok)                                           { ret 3; }
    if (b.ok.version || !str_equals(b.ok.open, "--version")) { ret 4; }
    val c: res[Args, Error] = line("--", "a.rle", "b.rle");
    if (!(sel c.err && sel c.err.extra)) { ret 5; }
    ret 0;
}

test parse__reads_a_batch_run_and_keeps_run_as_a_file_otherwise {
    val a: res[Args, Error] = line("run", "gun.rle", "--gens", "90", "--rule", "B36/S23", "--out", "o.cells", "--quiet");
    if (!sel a.ok)                   { ret 1; }
    if (a.ok.command != COMMAND_RUN) { ret 1; }
    val o: Run = a.ok.run;
    if (!str_equals(o.pattern, "gun.rle") || o.gens != 90 || !str_equals(o.rule, "B36/S23") || !str_equals(o.out, "o.cells") || !o.quiet) { ret 2; }
    val b: res[Args, Error] = line("run", "--gens", "0", "--", "--x.rle");
    if (!sel b.ok)                                                                               { ret 3; }
    if (b.ok.command != COMMAND_RUN)                                                             { ret 3; }
    if (!str_equals(b.ok.run.pattern, "--x.rle") || b.ok.run.rule != nil || b.ok.run.out != nil) { ret 4; }
    # only the first argument names the command
    val c: res[Args, Error] = line("--capture", "s.png", "run");
    if (!sel c.ok)                                                    { ret 5; }
    if (c.ok.command != COMMAND_APP || !str_equals(c.ok.open, "run")) { ret 5; }
    val d: res[Args, Error] = line("--", "run");
    if (!sel d.ok)                                                    { ret 6; }
    if (d.ok.command != COMMAND_APP || !str_equals(d.ok.open, "run")) { ret 6; }
    # a ceiling set to a limit or off, the others left to the settings
    val e: res[Args, Error] = line("run", "gun.rle", "--gens", "9", "--max-population", "5000", "--max-memory", "off");
    if (!sel e.ok)                                                                       { ret 7; }
    if (!e.ok.run.set[ceiling.POPULATION] || e.ok.run.limit[ceiling.POPULATION] != 5000) { ret 8; }
    if (!e.ok.run.set[ceiling.MEMORY] || e.ok.run.limit[ceiling.MEMORY] != 0)            { ret 9; }
    if (e.ok.run.set[ceiling.POOL] || e.ok.run.set[ceiling.STEP])                        { ret 10; }
    val f: res[Args, Error] = line("run", "gun.rle", "--gens", "9", "--max-chunks", "0");
    if (!(sel f.err && sel f.err.value)) { ret 11; }
    val g: res[Args, Error] = line("run", "gun.rle", "--gens", "9", "--max-step-ms", "5", "--max-step-ms", "6");
    if (!(sel g.err && sel g.err.twice)) { ret 12; }
    ret 0;
}

test parse__refuses_a_batch_run_missing_or_misgiving_its_arguments {
    val a: res[Args, Error] = line("run", "gun.rle");
    if (!(sel a.err && sel a.err.absent)) { ret 1; }
    var buf: [128]u8;
    if (sel a.err && !str_equals(error_message(a.err, ?buf[0]), "run needs --gens")) { ret 2; }
    val b: res[Args, Error] = line("run", "--gens", "4");
    if (!(sel b.err && sel b.err.absent)) { ret 3; }
    val c: res[Args, Error] = line("run", "gun.rle", "--gens", "four");
    if (!(sel c.err && sel c.err.value)) { ret 4; }
    val d: res[Args, Error] = line("run", "gun.rle", "--gens", "99999999999999999999");
    if (!(sel d.err && sel d.err.value)) { ret 5; }
    val e: res[Args, Error] = line("run", "gun.rle", "--gens", "4", "--gens", "5");
    if (!(sel e.err && sel e.err.twice)) { ret 6; }
    val f: res[Args, Error] = line("run", "gun.rle", "--gens");
    if (!(sel f.err && sel f.err.missing)) { ret 7; }
    val g: res[Args, Error] = line("run", "a.rle", "b.rle", "--gens", "4");
    if (!(sel g.err && sel g.err.extra)) { ret 8; }
    # the session's options are not the batch run's
    val h: res[Args, Error] = line("run", "gun.rle", "--gens", "4", "--capture", "s.png");
    if (!(sel h.err && sel h.err.unknown)) { ret 9; }
    val i: res[Args, Error] = line("run", "gun.rle", "--gens", "4", "--rule");
    if (!(sel i.err && sel i.err.missing)) { ret 10; }
    # a refused run is shown the run's usage, and anything else both forms
    var v: [3]str;
    v[0] = "cellar";
    v[1] = "run";
    v[2] = "--capture";
    if (!str_equals(usage(3, ?v[0]), RUN_USAGE)) { ret 11; }
    v[1] = "--capture";
    v[2] = "run";
    if (!str_equals(usage(3, ?v[0]), USAGE)) { ret 12; }
    if (!str_equals(usage(1, ?v[0]), USAGE)) { ret 13; }
    ret 0;
}

test parse__names_an_engine_for_the_session_and_the_batch_run {
    val a: res[Args, Error] = line("--engine", "hashlife", "--capture", "shot.png", "gun.rle");
    if (!sel a.ok)                                                           { ret 1; }
    if (a.ok.engine != ENGINE_HASHLIFE || !str_equals(a.ok.open, "gun.rle")) { ret 2; }
    val b: res[Args, Error] = line("gun.rle", "--engine", "gpu");
    if (!sel b.ok)                 { ret 3; }
    if (b.ok.engine != ENGINE_GPU) { ret 4; }
    val c: res[Args, Error] = line("gun.rle");
    if (!sel c.ok)                 { ret 5; }
    if (c.ok.engine != ENGINE_ANY) { ret 6; }
    val d: res[Args, Error] = line("run", "gun.rle", "--gens", "1000", "--engine", "hashlife");
    if (!sel d.ok)                                                         { ret 7; }
    if (d.ok.command != COMMAND_RUN || d.ok.run.engine != ENGINE_HASHLIFE) { ret 8; }
    val e: res[Args, Error] = line("run", "--engine", "cpu", "gun.rle", "--gens", "4");
    if (!sel e.ok)                     { ret 9; }
    if (e.ok.run.engine != ENGINE_CPU) { ret 10; }
    # an engine cellar lacks, the GPU for a run, one twice and none at all are refused
    val f: res[Args, Error] = line("--engine", "tpu");
    if (!(sel f.err && sel f.err.value)) { ret 11; }
    val g: res[Args, Error] = line("run", "gun.rle", "--gens", "4", "--engine", "gpu");
    if (!(sel g.err && sel g.err.value)) { ret 12; }
    val h: res[Args, Error] = line("--engine", "cpu", "--engine", "hashlife");
    if (!(sel h.err && sel h.err.twice)) { ret 13; }
    val k: res[Args, Error] = line("run", "gun.rle", "--gens", "4", "--engine");
    if (!(sel k.err && sel k.err.missing)) { ret 14; }
    ret 0;
}
