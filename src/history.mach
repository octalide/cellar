# the population over recent generations, a ring the panel draws as a graph
#
# a sample is a generation and the live cells counted at it. a census that
# lands for a generation already sampled replaces that sample, so a paused
# world holds one point however long it sits, and an edit shows in it.

use std.types.size.usize;

# samples the ring holds
pub val CAP: usize = 512;

# the population at a generation
# ---
# gen: the generation
# pop: live cells
pub rec Sample {
    gen: u64;
    pop: u32;
}

# recent samples, oldest overwritten first
# ---
# v:    the samples
# head: where the next one goes
# len:  samples held
pub rec Ring {
    v:    [512]Sample;
    head: usize;
    len:  usize;
}

# forget every sample
pub fun clear(r: *Ring) {
    r.head = 0;
    r.len  = 0;
}

# how many samples the ring holds
pub fun count(r: *Ring) usize {
    ret r.len;
}

# the i-th sample from the oldest
pub fun at(r: *Ring, i: usize) Sample {
    ret r.v[(r.head + CAP - r.len + i) % CAP];
}

# record the population at a generation
#
# a generation at or before the newest sample's replaces it, since a
# generation only moves back with a clear, which empties the ring first.
# ---
# r:   the ring
# gen: the generation
# pop: live cells
pub fun push(r: *Ring, gen: u64, pop: usize) {
    val s: Sample = Sample{gen: gen, pop: pop::u32};
    if (r.len != 0) {
        val last: usize = (r.head + CAP - 1) % CAP;
        if (r.v[last].gen >= gen) {
            r.v[last] = s;
            ret;
        }
    }
    r.v[r.head] = s;
    r.head      = (r.head + 1) % CAP;
    if (r.len < CAP) { r.len = r.len + 1; }
}

test push__keeps_the_newest_and_replaces_a_repeated_generation {
    var r: Ring;
    clear(?r);
    var g: u64 = 0;
    for (g < 600) {
        push(?r, g, (g * 2)::usize);
        g = g + 1;
    }
    if (count(?r) != CAP)                { ret 1; }
    if (at(?r, 0).gen != 600 - CAP::u64) { ret 2; }
    if (at(?r, CAP - 1).gen != 599)      { ret 3; }
    push(?r, 599, 7);
    if (count(?r) != CAP || at(?r, CAP - 1).pop != 7) { ret 4; }
    ret 0;
}
