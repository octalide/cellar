# the recent population, as a ring of (generation, population) samples
#
# the simulation adds a sample as it learns a generation's population: each
# step on the CPU, and each census on either engine. a sample for the
# generation the newest one already holds replaces it, so a paused world
# edited in place keeps one sample rather than filling the ring.

use std.types.size.usize;

# samples the ring holds
pub val SAMPLES: usize = 256;

# the ring
# ---
# gen:  each sample's generation
# pop:  each sample's population
# head: where the next sample goes
# len:  samples held, at most SAMPLES
pub rec History {
    gen:  [256]u64;
    pop:  [256]u64;
    head: usize;
    len:  usize;
}

# forget every sample
pub fun clear(h: *History) {
    h.head = 0;
    h.len  = 0;
}

# the ring index of sample i, oldest first
fun index(h: *History, i: usize) usize {
    ret (h.head + SAMPLES - h.len + i) % SAMPLES;
}

# record a generation's population
# ---
# h:   the ring
# gen: the generation
# pop: its live cells
pub fun add(h: *History, gen: u64, pop: u64) {
    if (h.len != 0) {
        val last: usize = index(h, h.len - 1);
        if (h.gen[last] == gen) {
            h.pop[last] = pop;
            ret;
        }
    }
    h.gen[h.head] = gen;
    h.pop[h.head] = pop;
    h.head        = (h.head + 1) % SAMPLES;
    if (h.len < SAMPLES) { h.len = h.len + 1; }
}

# the generation of sample i, oldest first
pub fun gen_at(h: *History, i: usize) u64 {
    ret h.gen[index(h, i)];
}

# the population of sample i, oldest first
pub fun pop_at(h: *History, i: usize) u64 {
    ret h.pop[index(h, i)];
}

# the largest population held, 0 when empty
pub fun peak(h: *History) u64 {
    var m: u64   = 0;
    var i: usize = 0;
    for (i < h.len) {
        if (h.pop[i] > m) { m = h.pop[i]; }
        i = i + 1;
    }
    ret m;
}

test add__keeps_the_newest_samples_and_merges_a_repeated_generation {
    var h: History;
    clear(?h);
    add(?h, 0, 5);
    add(?h, 0, 7);
    if (h.len != 1 || pop_at(?h, 0) != 7) { ret 1; }
    var g: u64 = 1;
    for (g < 300) {
        add(?h, g, g * 2);
        g = g + 1;
    }
    if (h.len != SAMPLES)                                                 { ret 2; }
    if (gen_at(?h, 0) != 300 - SAMPLES::u64)                              { ret 3; }
    if (gen_at(?h, SAMPLES - 1) != 299 || pop_at(?h, SAMPLES - 1) != 598) { ret 4; }
    if (peak(?h) != 598)                                                  { ret 5; }
    clear(?h);
    if (h.len != 0 || peak(?h) != 0) { ret 6; }
    ret 0;
}
