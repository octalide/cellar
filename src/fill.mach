# what a random fill covers: a shape around a point, or the world's whole grid
#
# a shape is a box to scan and a test of which cells of it count, so a new
# target, such as a boundary region, is one more variant and one more arm of
# bounds and covers, and nothing downstream of them changes. the grid's box
# is the world's, which only the simulation knows, so it resolves there, and so
# does a boundary region, handed in as a Domain.

use cellar.boundary;
use cellar.space;
use cellar.topology;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

# live-cell probability a fill starts with
pub val DENSITY: f32 = 0.30;

# a point and a size
# ---
# x:    the centre column
# y:    the centre row
# size: the side of a square, the diameter of a circle, in cells
pub rec Around {
    x:    i64;
    y:    i64;
    size: usize;
}

# the cells a fill covers
# ---
# square: a square around a point
# circle: a circle around a point
# grid:   every cell of the world's bounded grid, or of every region of its
#         boundary
# region: every cell of the boundary's chosen region (sim.choose_region)
pub tag Shape: u8 {
    square: Around;
    circle: Around;
    grid;
    region;
}

# what the world resolves a grid or a region to
# ---
# box:  the box spanning it, half-open
# area: the cells of the box it covers, or nil for all of them
pub rec Domain {
    box:  space.Box;
    area: *boundary.Region;
}

# a domain that is no cells, for a shape that needs none
pub fun nowhere() Domain {
    ret Domain{box: space.Box{x0: 0, y0: 0, x1: 0, y1: 0}, area: nil};
}

# a fill, the cells it covers and how densely they are seeded
# ---
# shape:   where
# density: live-cell probability in [0, 1], which continuous rules take as a
#          chance of a random value
pub rec Fill {
    shape:   Shape;
    density: f32;
}

# a square fill around a point
pub fun square(x: i64, y: i64, size: usize, density: f32) Fill {
    ret Fill{shape: Shape.square{Around{x: x, y: y, size: size}}, density: density};
}

# a circular fill around a point
pub fun circle(x: i64, y: i64, size: usize, density: f32) Fill {
    ret Fill{shape: Shape.circle{Around{x: x, y: y, size: size}}, density: density};
}

# the cells of a grid as a box
# ---
# g:   the grid
# ret: the box, or none for a grid with an unbounded axis
pub fun grid_box(g: *topology.Grid) opt[space.Box] {
    if (!topology.finite(g)) { ret opt[space.Box].none{}; }
    val x0: i64 = topology.left(g);
    val y0: i64 = topology.top(g);
    ret opt[space.Box].some{space.Box{x0: x0, y0: y0, x1: x0 + g.w, y1: y0 + g.h}};
}

# the box a shape around a point spans
fun around(c: Around) space.Box {
    val x0: i64 = c.x - (c.size / 2)::i64;
    val y0: i64 = c.y - (c.size / 2)::i64;
    ret space.Box{x0: x0, y0: y0, x1: x0 + c.size::i64, y1: y0 + c.size::i64};
}

# the box a shape spans, which holds every cell it covers
# ---
# sh:  the shape
# dom: what the grid or the region is, for a shape that is one
# ret: the box, half-open
pub fun bounds(sh: *Shape, dom: *Domain) space.Box {
    if (sel sh.square) { ret around(sh.square); }
    if (sel sh.circle) { ret around(sh.circle); }
    ret dom.box;
}

# whether a cell of a shape's bounds is one it covers
pub fun covers(sh: *Shape, dom: *Domain, x: i64, y: i64) bool {
    if (sel sh.grid || sel sh.region) {
        if (dom.area == nil) { ret true; }
        ret boundary.contains(dom.area, x, y);
    }
    if (!sel sh.circle) { ret true; }
    # a cell's centre against the radius, in doubled units to stay whole
    val b:  space.Box = around(sh.circle);
    val dx: i64       = x + x + 1 - (b.x0 + b.x1);
    val dy: i64       = y + y + 1 - (b.y0 + b.y1);
    val d:  i64       = sh.circle.size::i64;
    ret dx * dx + dy * dy <= d * d;
}

test covers__a_circle_is_round_and_a_square_whole {
    val sq: Shape     = Shape.square{Around{x: 0, y: 0, size: 10}};
    val ci: Shape     = Shape.circle{Around{x: 0, y: 0, size: 10}};
    val d:  Domain    = nowhere();
    val b:  space.Box = bounds(?ci, ?d);
    if (b.x0 != -5 || b.x1 != 5 || b.y0 != -5 || b.y1 != 5)                           { ret 1; }
    if (!covers(?sq, ?d, -5, -5))                                                     { ret 2; }
    if (covers(?ci, ?d, -5, -5))                                                      { ret 3; }
    if (!covers(?ci, ?d, 0, 0) || !covers(?ci, ?d, -5, 0) || !covers(?ci, ?d, 4, -1)) { ret 4; }
    ret 0;
}
