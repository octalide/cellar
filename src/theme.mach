# cellar's palette: interface colours, cell swatches and the trail and age ramps
#
# every colour is authored as an sRGB hex value, the way it looks on screen.
# interface colours are converted to linear light for an sRGB swapchain, which
# encodes on write, and cell colours are written as sRGB bytes into a texture
# sampled as sRGB, so both land on screen as authored.

use std.types.size.usize;

pub val BG:          u32 = 0x0d1015;
pub val WORLD:       u32 = 0x12161c;
pub val WORLD_EDGE:  u32 = 0x262d38;
pub val GRID:        u32 = 0x1c222b;
pub val PANEL:       u32 = 0x161a21;
pub val PANEL_EDGE:  u32 = 0x252b35;
pub val HEADER:      u32 = 0x1b2029;
pub val CONTROL:     u32 = 0x222833;
pub val CONTROL_HOT: u32 = 0x2b3240;
pub val CONTROL_ON:  u32 = 0x343d4d;
pub val TEXT:        u32 = 0xdde2ea;
pub val TEXT_DIM:    u32 = 0x8a94a3;
pub val TEXT_FAINT:  u32 = 0x5b6472;
pub val ACCENT:      u32 = 0x5fd4a0;
pub val ACCENT_INK:  u32 = 0x0d1015;
pub val WARN:        u32 = 0xe8806a;
pub val HOVER_CELL:  u32 = 0xffffff;

# solid-colour swatches for live cells
pub val SWATCH_COUNT: usize = 8;

# the sRGB hex of swatch i
pub fun swatch(i: usize) u32 {
    if (i == 1) { ret 0xe8ecf2; }
    if (i == 2) { ret 0xffb347; }
    if (i == 3) { ret 0xff6f61; }
    if (i == 4) { ret 0x5ab8ff; }
    if (i == 5) { ret 0xa78bfa; }
    if (i == 6) { ret 0xc3f35c; }
    if (i == 7) { ret 0xff7ac6; }
    ret 0x5fd4a0;
}

# red, green or blue byte of a hex colour
pub fun red(c: u32) u8 {
    ret ((c >> 16) & 0xff)::u8;
}

pub fun green(c: u32) u8 {
    ret ((c >> 8) & 0xff)::u8;
}

pub fun blue(c: u32) u8 {
    ret (c & 0xff)::u8;
}

# the hex colour of three channels in [0, 1]
pub fun pack(r: f32, g: f32, b: f32) u32 {
    ret ((r * 255.0 + 0.5)::u32 << 16) | ((g * 255.0 + 0.5)::u32 << 8) | (b * 255.0 + 0.5)::u32;
}

# the fifth root of a in [0, 1], by Newton's method
fun root5(a: f32) f32 {
    if (a <= 0.0) { ret 0.0; }
    var y: f32   = 1.0;
    var i: usize = 0;
    for (i < 40) {
        val y4: f32 = y * y * y * y;
        y = y - (y4 * y - a) / (5.0 * y4);
        i = i + 1;
    }
    ret y;
}

# an sRGB-encoded channel in [0, 1] in linear light
pub fun linear(c: f32) f32 {
    if (c <= 0.04045) { ret c / 12.92; }
    val x: f32 = (c + 0.055) / 1.055;
    # x^2.4 is x^2 times the fifth root of x^2
    ret x * x * root5(x * x);
}

# one stop of a colour ramp
rec Stop {
    at:  u32;
    hex: u32;
}

fun mix(a: u8, b: u8, t: f32) u8 {
    ret (a::f32 + (b::f32 - a::f32) * t + 0.5)::u8;
}

# fill a 256-entry RGB ramp between stops at ascending positions 0..255
fun ramp(out: *u8, stops: *Stop, n: usize) {
    var i: usize = 0;
    for (i < 256) {
        var k: usize = 0;
        for (k + 2 < n && i::u32 > stops[k + 1].at) { k = k + 1; }
        val a: Stop = stops[k];
        val b: Stop = stops[k + 1];
        var t: f32  = 0.0;
        if (b.at > a.at) { t = (i::f32 - a.at::f32) / (b.at::f32 - a.at::f32); }
        if (t < 0.0)     { t = 0.0; }
        if (t > 1.0)     { t = 1.0; }
        out[i * 3]     = mix(red(a.hex), red(b.hex), t);
        out[i * 3 + 1] = mix(green(a.hex), green(b.hex), t);
        out[i * 3 + 2] = mix(blue(a.hex), blue(b.hex), t);
        i              = i + 1;
    }
}

# the cell ramps, built once
# ---
# trail: RGB by heat, from a cooled ember up to the white-hot live head
# age:   RGB by age up to 255 generations, from a newborn glow through teal
#        and indigo to violet
pub rec Ramps {
    trail: [768]u8;
    age:   [768]u8;
}

# build both ramps
pub fun ramps(r: *Ramps) {
    var t: [6]Stop;
    t[0] = Stop{at: 0, hex: BG};
    t[1] = Stop{at: 60, hex: 0x4a1a5e};
    t[2] = Stop{at: 130, hex: 0xc22f5d};
    t[3] = Stop{at: 190, hex: 0xf5753b};
    t[4] = Stop{at: 235, hex: 0xffc463};
    t[5] = Stop{at: 255, hex: 0xfff6dc};
    ramp(?r.trail[0], ?t[0], 6);

    var a: [5]Stop;
    a[0] = Stop{at: 0, hex: 0xeafff4};
    a[1] = Stop{at: 12, hex: 0x5fd4a0};
    a[2] = Stop{at: 48, hex: 0x2c9fc7};
    a[3] = Stop{at: 130, hex: 0x5a5fd8};
    a[4] = Stop{at: 255, hex: 0xa34fd0};
    ramp(?r.age[0], ?a[0], 5);
}

test ramps__end_on_their_last_stop_and_linear_is_monotonic {
    var r: Ramps;
    ramps(?r);
    if (r.trail[765] != 0xff || r.trail[766] != 0xf6 || r.trail[767] != 0xdc) { ret 1; }
    if (r.age[0] != 0xea)                                                     { ret 2; }
    if (linear(0.0) != 0.0)                                                   { ret 3; }
    if (linear(1.0) < 0.99 || linear(1.0) > 1.01)                             { ret 4; }
    # 0.5 encoded is 0.2140 linear
    if (linear(0.5) < 0.2135 || linear(0.5) > 0.2145) { ret 5; }
    ret 0;
}
