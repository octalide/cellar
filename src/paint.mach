# cellar's own drawing over the cells, straight into boom's overlay pass
#
# the GPU draws the cells (cellar.gpu). what belongs to the world over them, a
# bounded grid's edge, the box the live cells span, the selection, the cell
# under the cursor and the stamp's ghost, is drawn here in the same pass, in
# call order, before the interface is drawn over all of it. colours are
# authored as sRGB hex and written in the swapchain's encoding.

use gfx: boom.graphics;
use gm:  boom.math;
use cellar.theme;
use std.types.bool.bool;
use std.types.option.opt;

# the pass the world's overlays are drawn into
# ---
# pass: the overlay pass, open
# srgb: the swapchain encodes sRGB, so colours are written as linear light
pub rec Paint {
    pass: *gfx.Pass;
    srgb: bool;
}

# a channel of a hex colour in the swapchain's encoding
fun channel(p: *Paint, byte: u8) f32 {
    val c: f32 = byte::f32 / 255.0;
    if (p.srgb) { ret theme.linear(c); }
    ret c;
}

# a hex colour at an opacity, in the swapchain's encoding
pub fun col(p: *Paint, hex: u32, alpha: f32) gm.Vec4 {
    ret gm.vec4(channel(p, theme.red(hex)), channel(p, theme.green(hex)), channel(p, theme.blue(hex)), alpha);
}

# fill a rectangle given by its corners
pub fun rect(p: *Paint, x0: f32, y0: f32, x1: f32, y1: f32, hex: u32, alpha: f32) {
    if (x1 <= x0 || y1 <= y0) { ret; }
    gfx.pass_draw_sprite(p.pass, opt[*gfx.Texture].none{}, gfx.rect(x0, y0, x1 - x0, y1 - y0), col(p, hex, alpha));
}

# outline a rectangle with a border t pixels thick, inside its corners
pub fun frame(p: *Paint, x0: f32, y0: f32, x1: f32, y1: f32, t: f32, hex: u32, alpha: f32) {
    rect(p, x0, y0, x1, y0 + t, hex, alpha);
    rect(p, x0, y1 - t, x1, y1, hex, alpha);
    rect(p, x0, y0 + t, x0 + t, y1 - t, hex, alpha);
    rect(p, x1 - t, y0 + t, x1, y1 - t, hex, alpha);
}
