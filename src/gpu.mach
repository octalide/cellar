# the pool on the GPU: stepped by a compute stage and drawn from where it lies
#
# each layer of the cells (cellar.layer) lives in two storage buffers stepped
# back and forth, and the page table and the rule in a third, laid out as
# cellar.space keeps them, so the host's pool is mirrored rather than
# translated. the layers are the host's: a pool whose layers change, under a
# rule that stores its cells otherwise, is made again in the next frame and
# filled from the host's cells, which are current whenever the layers change.
# the host's cells are a staging copy: whole chunks it filled or allocated,
# and single cells it painted, are uploaded at the start of the next frame's
# recording, and everything else about them is only on the GPU. pull brings
# the GPU's cells back when the host needs to read them, for a save or a test.
#
# each frame records its generations, then a census stage that counts every
# chunk, then a readback of the census. the readback lands a couple of frames
# later, and collect settles the host's pool from it: chunks that came alive
# get their halo and dead ones are freed. that lag is why the generations a
# frame may record are budgeted. a pattern spreads at most the rule's radius a
# generation, and a census that gave every live chunk its halo
# (cellar.space.halo) leaves room for that halo's reach of spread before
# anything can reach past it, so no generation is recorded that could outrun
# the last census the pool was settled from.
#
# a frame steps no more than its span of slots, counting every generation's
# slots, so one generation over a large pool is dispatched in ranges of its
# active list across several frames. the span is what fits a share of the
# display's refresh interval at what a slot costs on the GPU, timed by the
# device's timestamps and smoothed, so it follows the cost both ways with no
# band where an overrun is let stand. a device without timestamps falls back
# to the frame time: a frame over the interval cuts the span in proportion to
# its overrun, and frames on time that the span cut short let it grow. while a
# generation is part way through, its finished
# ranges lie in the back cells, so the draw, the census and the pyramids read
# the front, the last completed generation, and only a frame that completes
# one counts and reduces it again. an edit, a growth or another rule since the
# generation began starts it over from the front, under the same serial.
#
# the halo is the rule's ring of adjacent chunks (cellar.space.ring), the
# chunks its live cells lean toward and 32 cells of reach for a rule reaching
# no further, every adjacent chunk and 64 cells for one reaching further,
# unless uncapped stepping keeps running into the budget, when it widens by a
# chunk, toward chunks two away, at nearly three times the slots. the budget
# rises only once a census taken with the wider halo has settled, so every live
# chunk holds it, and before the first census of a narrower halo, the ring's
# or a rule's reaching less, can free the far chunks the budget drops to what
# that halo holds.
#
# on the unbounded plane the GPU allocates and frees chunks itself, and the
# census round trip no longer bounds the generations a frame may record. while
# it steps there it owns the pool: the page table, the hash from coordinates to
# slots, the free slots and the incarnations are written by its stages alone
# (cellar.layout.Status), and the host's pool is a mirror of them that take
# brings level, once the device is idle, before the host reads or changes it.
# the host hands it back by changing it: the next flush uploads what it wrote
# and seeds the GPU's hash and free bits from the table again. between the two
# the host writes only its own words of the status head, in order with the
# GPU's work, so the two never write the same word at once. the pool grows
# while the GPU owns it without the host: the capacity grows ahead of the top,
# the GPU carries its own page table and allocator's words into the larger
# buffers (carry_comp) and keeps owning the pool, and the host's mirror, its
# cells with it, grows only once take next brings it level.
#
# a pass runs between generations, before the spread recorded since the last
# would pass what the halo it left holds: each live chunk asks for the rule's
# ring of chunks and claims a slot for any missing (mark_comp), the
# first pass of a frame frees the chunks nothing asked for (free_comp), twins
# claimed for one chunk give way to the lowest and the rest are linked in
# (settle_comp), and the new chunks are cleared. so no generation outruns the halo the last pass
# left, and only the dispatches a frame may record bound the generations it
# records. every slot below a top the host keeps above the GPU's highest is
# covered by the stages; a pass that finds no free slot below it closes a gate
# that stops every pass and step after it (mark_comp, gate_comp), and the host,
# seeing it in a census, takes the pool, rewinds its count of the generations
# to where the gate closed, makes room and reopens it. a bounded grid's seams
# are the host's to link, so there the host allocates, as below, unless the
# grid fits the pool whole: then every chunk of it was allocated when it was
# set (cellar.space.cover), nothing is allocated or freed as it steps, and no
# budget bounds the generations a frame records.
#
# a chunk allocated empty is cleared on the GPU by a stage of its own rather
# than uploaded, and each step stamps which chunks it left alive or warm, so the
# next can skip the chunks with nothing alive nearby. whatever the host uploads
# is stamped alive and warm, so it is stepped in full at least once.
#
# the steps are dispatched over an active list rather than every slot below
# the top: a gather stage lists, from the stamps, the slots live or warm and
# those a live one is within reach of, through the seams too, and the steps
# read their slots from it (gather_comp, cellar.layout.Flags). a list holds
# every slot that can change before the spread since it was gathered passes
# layout.LIST_SPREAD, so a gather runs ahead of the first generation after the
# host changed the pool or the rule, after every pass, and once the spread
# would pass that, on the unbounded plane and on a grid alike. the host never
# reads a list's length in time to plan by it, so a step covers the list to
# its end, its workgroups past the end leaving at once, and the span counts
# what the last census found the list held.
#
# below a pixel per cell the draw reads each chunk's coverage pyramid
# (cellar.layout.Mip), which a reduce stage builds after the frame's last
# generation, skipping the chunks the steps left cold.
#
# a rule family whose rule does not fit its window of the meta head keeps it
# in a rule buffer of its own (see cellar.rule), bound after the four buffers
# every step binds. it is packed and uploaded, in order with the frame's
# dispatches, only when the rule it holds is not the one running, and made
# larger, waiting for the device, only when a rule needs more words than it
# holds. a family whose stage binds more storage buffers than the device's
# dispatches can is not built, and its rules cannot be stepped here (steps).
#
# where the compute stages cannot be built, the CPU steps and this only draws,
# uploading the chunks in view whose cells changed since they were last sent,
# with their pyramids. the CPU steps on the simulation thread (cellar.runner),
# so a growth it asks for there is only noted, and the next frame makes the
# buffers on the thread that owns the device. where the world is not in the
# pool at all, the host fills the pool with what is to be drawn and show
# uploads it, stepping nothing.

use gfx: boom.graphics;
use gm:  boom.math;
use cellar.layer;
use cellar.layer.plane;
use cellar.layout;
use cellar.rule;
use cellar.space;
use cellar.theme;
use cellar.topology;
use allo: std.allocator;
use std.chrono.duration.Duration;
use std.chrono.time;
use std.chrono.time.Instant;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;
use mem: std.memory;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

#[embed("{artifact.stage-clear_comp.out}")]
val CLEAR_SPV:  [_]u8;
#[embed("{artifact.stage-grow_comp.out}")]
val GROW_SPV:   [_]u8;
#[embed("{artifact.stage-carry_comp.out}")]
val CARRY_SPV:  [_]u8;
#[embed("{artifact.stage-census_comp.out}")]
val CENSUS_SPV: [_]u8;
#[embed("{artifact.stage-reduce_comp.out}")]
val REDUCE_SPV: [_]u8;
#[embed("{artifact.stage-mark_comp.out}")]
val MARK_SPV:   [_]u8;
#[embed("{artifact.stage-free_comp.out}")]
val FREE_SPV:   [_]u8;
#[embed("{artifact.stage-settle_comp.out}")]
val SETTLE_SPV: [_]u8;
#[embed("{artifact.stage-gate_comp.out}")]
val GATE_SPV:   [_]u8;
#[embed("{artifact.stage-wipe_comp.out}")]
val WIPE_SPV:   [_]u8;
#[embed("{artifact.stage-seed_comp.out}")]
val SEED_SPV:   [_]u8;
#[embed("{artifact.stage-gather_comp.out}")]
val GATHER_SPV: [_]u8;
#[embed("{artifact.stage-edit_comp.out}")]
val EDIT_SPV:   [_]u8;
#[embed("{artifact.stage-cells_vert.out}")]
val VERT_SPV:   [_]u8;
#[embed("{artifact.stage-cells_frag.out}")]
val FRAG_SPV:   [_]u8;

# words of the meta buffer ahead of the page table: the shared words and the rule
pub val HEAD: usize = layout.HEAD::usize;
# words of the view buffer ahead of the palettes: the look, then the heat, age
# and rule palettes of SHADES entries of four floats each
pub val LOOK: usize = 24;
# the words of the view buffer where the rule palette starts
val INK_AT: usize = LOOK + SHADES * 8;
# words of a slot's coverage pyramid
pub val MIP: usize = layout.MIP::usize;
# entries in each palette
pub val SHADES: usize = 256;
# storage binding sets a frame keeps for the dispatches and draws after its
# generations': the gate, the census, the reduction and the draw. what the
# frame's flush records ahead of them, the clears, the growth and the edits of
# each layer and the seeding's two, comes out of what its generations have
# (sets)
val FRAME_SETS: usize = 4;
# dispatches one frame's generations may record, its steps, its passes and its
# gathers, in the storage binding sets the frame has left besides FRAME_SETS
# when its flush records none, which also bounds the generations it records
pub val MAX_STEPS: usize = 252;
# dispatches a pass records besides a clear of each layer, the mark and the
# settle, and one more for the first of a frame, which frees
pub val PASS_CALLS: usize = 2;
# the span a frame starts with, before a frame has been measured
val FIRST_SPAN: usize = 4096;
# the least a span shrinks to
val MIN_SPAN: usize = 64;
# the most a span grows to: every generation a frame may record of the largest
# pool
pub val MAX_SPAN: usize = layout.MAX_SLOTS::usize * MAX_STEPS;
# the share of the refresh interval a frame's stepping may take on the GPU,
# STEP_SHARE over SHARE_OF, the rest left to the draw, the census and the
# compositor
val STEP_SHARE: u64 = 7;
val SHARE_OF:   u64 = 8;
# timers a frame's stepping is measured by in turn, one more than the frames in
# flight, so a timer's last range has always finished by its next turn
val TIMERS: usize = 3;
# a slot's measured cost moves toward a dearer measure by this share of the
# difference and toward a cheaper one by the other, so an overrun is followed
# within a frame or two and a single cheap frame does not undo it
val RISE: u64 = 2;
val FALL: u64 = 16;
# frames recorded before a late one is seen, whose lateness the span was
# already cut for, when the frame time paces it
val CALM: u32 = 2;
# the share a span grows by each frame on time it cut short, until a frame
# first comes late and after, when the frame time paces it
val GROW_FAST: usize = 8;
val GROW_SLOW: usize = 64;
# consecutive uncapped frames the budget cut short before the halo widens
val WIDEN_AFTER: u32 = 8;
# the most that grows to while widening keeps failing to pay off
val WIDEN_MAX: u32 = 512;
# consecutive uncapped frames that fell behind the display, or that the ring
# would have held, before the halo narrows
val NARROW_AFTER: u32 = 8;
# a hold on the limit that is not in effect
val NO_HOLD: u64 = 0xffffffffffffffff;
# the refresh rate assumed when the display's cannot be read
val FALLBACK_HZ: f32 = 60.0;
# censuses in flight a frame can look back over
val RING: usize = 8;
# the refresh interval divides by this for the time a frame spends sending the
# CPU's chunks: more than that stretches the frame that follows a step
val VIEW_SHARE: u64 = 32;
# picoseconds a byte of the CPU's chunks is taken to cost to send before an
# upload has measured it, a copy at 10 GB/s
val SEND_PS: u64 = 100;
# a held slot's pyramid was sent
val SENT_MIP: u8 = 1;
# a held slot's cells were sent
val SENT_CELLS: u8 = 2;
# a held slot's pyramid on the host was built from its cells, so it is sent
# as it stands rather than built in the frame
val BUILT: u8 = 4;
# a list length no census has found since the pool or the world was replaced,
# which counts as every slot below the top
val UNKNOWN: usize = 0xffffffffffffffff;

# the camera and colours the draw reads, uploaded each frame
# ---
# base_cx: the chunk column holding the view centre, biased by space.BIAS
# base_cy: the chunk row holding the view centre, biased
# mode:    colour mode: 0 solid, 1 heat, 2 age
# gutter:  1 to show grid lines
# frac_x:  the centre's column inside its chunk, in cells
# frac_y:  the centre's row inside its chunk, in cells
# ppc:     pixels per cell
# half_w:  half the port's width in pixels
# half_h:  half the port's height in pixels
# shift:   0 when a drawn cell is a cell; else it stands for a square of
#          2^shift cells a side and holds its summary (layout.SUMMARY_LIVE)
# ink:     1 when a live cell is drawn in the rule's colour for its heat
#          rather than the solid colour, as the GPU side sets it (sync_ink)
# pad:     keeps what follows four-float aligned
# org_x:   the port's left in window pixels, the first of the shaders' port
# org_y:   the port's top in window pixels
# win_w:   the window width in pixels
# win_h:   the window height in pixels
# solid:   the solid live colour, in the target's space
# back:    the backdrop, in the target's space
pub rec Look {
    base_cx: u32;
    base_cy: u32;
    mode:    u32;
    gutter:  u32;
    frac_x:  f32;
    frac_y:  f32;
    ppc:     f32;
    half_w:  f32;
    half_h:  f32;
    shift:   u32;
    ink:     u32;
    pad:     u32;
    org_x:   f32;
    org_y:   f32;
    win_w:   f32;
    win_h:   f32;
    solid:   [4]f32;
    back:    [4]f32;
}

# what the pool was when a census was recorded
# ---
# id:     the census id
# spread: cells of spread recorded up to it
# seq:    censuses recorded up to and including it, which never wraps
# gens:   generations recorded up to it
# bulk:   the bulk-edit count then
# edits:  the edit count then
# cap:    slots the readback covers
# hi:     slots the census counted
# span:   cells of spread the halo settling it asks for holds
# owned:  the GPU owned the pool, so the host's settles nothing from it
rec Snap {
    id:     u32;
    seq:    u64;
    spread: u64;
    gens:   u64;
    bulk:   u64;
    edits:  u64;
    cap:    usize;
    hi:     usize;
    span:   u32;
    owned:  bool;
}

# a dispatch a frame planned, recorded in order once its planning is done
# ---
# pass:   a pass rather than a step
# gather: a gather rather than a step
# free:   the pass frees, as the frame's first does
# tail:   the step covers the list from lo to its end, whatever its length,
#         rather than n entries
# src:    the cells the step reads, or the pass marks from
# lo:     a step's first entry of the list
# n:      a step's entries, when it is no tail
# now:    a step's serial, for a pass the serial of the step that left the
#         front, and for a gather the serial of the step after it
# id:     a pass's id
# gens:   generations recorded before a pass, low bits
# span:   cells of spread the halo a pass leaves holds
# bits:   a gather's header bits (layout.GATHER_GATED, layout.GATHER_RIM)
rec Op {
    pass:   bool;
    gather: bool;
    free:   bool;
    tail:   bool;
    src:    usize;
    lo:     u32;
    n:      u32;
    now:    u32;
    id:     u32;
    gens:   u32;
    span:   u32;
    bits:   u32;
}

# a painted cell's value in one layer, waiting to be uploaded
# ---
# k:    the layer
# slot: its slot
# i:    the cell
# v:    its value in the layer
rec Write {
    k:    u32;
    slot: u32;
    i:    u32;
    v:    u32;
}

# the buffers sized to the pool's capacity
#
# the device is the render thread's. it alone creates and deletes these
# buffers, reads them back and records and submits work on them, since boom
# records every dispatch into the frame's one command buffer on the one queue
# that thread submits, with no locking across threads. the host's pool may
# change on the simulation thread whenever the GPU does not step the world
# (cellar.runner), so a growth asked there touches nothing here but one atomic
# word: it is owed (owe), and the next frame takes what is owed with an
# exchange and makes the buffers (flush). a growth is made at once
# (reserve) only while the GPU steps the world, when the render thread holds
# the world for every change. while the GPU owns the pool, which it does only
# while it steps the world, the render thread grows it on its own (make_room)
# and the host's pool does not grow with it, and the pool is handed back
# (take) only then.
# ---
# set:    the layers the cells are stored in
# cells:  each layer's two cell pools stepped between, layer k's at k * 2
#         and k * 2 + 1 (cells_of)
# meta:   the rule and the page table
# flags:  per slot the serials of the last step that left it alive and warm,
#         then the active list the steps are dispatched over
# list:   the slots the clear stage empties
# mip:    every slot's coverage pyramid
# status: the census stage's output
# rb:     the census readback
# got:    where a landed census is copied
# landed: the landed census unpacked to space.CENSUS words per slot
# held:   per slot, while the CPU steps, SENT_MIP and SENT_CELLS for what was
#         sent of it since it last changed on the host, and BUILT while the
#         host's pyramid of it is current
# cap:    slots the buffers hold
rec Pool {
    set:    plane.Set;
    cells:  [layer.LAYERS_MAX * 2]gfx.StorageBuffer;
    meta:   gfx.StorageBuffer;
    flags:  gfx.StorageBuffer;
    list:   gfx.StorageBuffer;
    mip:    gfx.StorageBuffer;
    status: gfx.StorageBuffer;
    rb:     gfx.Readback;
    got:    *u32;
    landed: *u32;
    held:   *u8;
    cap:    usize;
}

# pool c, 0 or 1, of a pool's layer k
fun cells_of(p: *Pool, k: usize, c: usize) *gfx.StorageBuffer {
    ret ?p.cells[k * 2 + c];
}

# pool c of a pool's shown layer (cellar.layer), which the census, the
# reduction and the draw bind beside its state layer, or its state layer's
# where it has none, which they then never read
fun shown_cells(p: *Pool, c: usize) *gfx.StorageBuffer {
    val k: opt[usize] = plane.shown(?p.set);
    if (sel k.none) { ret cells_of(p, 0, c); }
    ret cells_of(p, k.some, c);
}

# the bytes of a slot's span of a pool's layer k
fun span_bytes(p: *Pool, k: usize) usize {
    ret plane.span_words(p.set.at[k].width) * 4;
}

# the byte where a slot's span of a pool's layer k starts in its buffers
fun span_offset(p: *Pool, k: usize, s: usize) usize {
    ret layer.span_at(p.set.at[k].width, s::u32)::usize * 4;
}

# the GPU's side of the world
# ---
# a:        allocator for host buffers
# r:        the renderer
# d:        its device
# slots:    the most slots the device's storage buffers hold, the pool's ceiling
# p:        the buffers sized to the pool
# next:     the buffers a growth made room in, swapped in by the next frame
# reserved: next holds buffers
# old:      the buffers a growth replaced, kept until the frame copying out of
#           them has run
# retired:  old holds buffers
# view:     the look and the palettes
# steps:    each rule family's step stage
# ready:    which families' step stages were built
# most:     the storage buffers the device's dispatches bind
# table:    the running family's rule buffer, once one needed it
# words:    words table holds, 0 before it is made
# tabled:   table holds the rule in shown
# shown:    the rule table was last packed from
# packed:   the rule buffer staged for upload
# inked:    the view's rule palette holds ink_rule's colours
# ink_rule: the rule the rule palette was last built from
# ink:      ink_rule has colours of its own, so the draw uses the palette
# srgb:     the renderer's target encodes sRGB, so colours go up linear
# clear:    the clear stage
# grow:     the stage that carries the world into larger buffers
# carry:    the stage that carries the page table and the allocator's words
#           into larger buffers while the GPU owns the pool
# edit:     the stage that writes painted cells into a layer narrower than a word
# sets:     storage binding sets the frame's flush recorded, which its
#           generations do not have
# edited:   the edits it reads, made larger as a frame paints more
# room:     the edits edited holds
# edit_at:  the frame's edits of a layer, as edited holds them
# census:   the census stage
# reduce:   the stage that builds the coverage pyramids
# draw:     the cell shader
# mat:      the draw's material
# xf:       the draw's transform
# hi:       slots the GPU's page table covers
# front:    which of cells holds the world
# stepping: the compute stages built, so the GPU steps
# owed:     slots a growth asked for while the GPU does not step the world,
#           which the next frame makes the buffers for, atomic: the one word
#           another thread writes (owe)
# drawn:    the sense the held pyramids were built with
# serial:   the serial of the last step recorded; stamps equal to it are current
# ring:     recent censuses
# id:       the last census id
# spread:   cells of spread recorded since the world was made
# gens:     generations recorded since the world was made
# limit:    the spread the last settled census allows
# wide:     censuses are recorded asking for the wide halo
# want:     the halo the next census should ask for is the wide one
# halo:     cells of spread the halo censuses are recorded asking for holds
# streak:   consecutive uncapped frames that argue for changing the halo
# patience: budget-bound frames in a row the halo next widens after
# hold:     the most limit may be until a census recorded since the halo
#           narrowed settles, NO_HOLD when none is owed
# seq:      censuses recorded
# held:     the seq of the first census recorded once the halo narrowed
# settled:  the seq of the last census settled
# lag:      spread recorded since the last census settled, as it landed
# stepped:  spread the last frame recorded
# cut:      the budget cut the last frame's generations short
# bulk:     bulk edits: clears, fills
# edits:    every edit, bulk or painted
# writes:   painted cells to upload
# zeros:    slots to clear this frame
# sent:     slots whose layers the frame's upload of the CPU's chunks sends
# stamped:  slots whose stamps to set current this frame
# batch:    the writes of one buffer a frame records as one copy (send)
# keys:     painted cells ordered by cell, then by when they were painted
# stamp:    the current serial, twice for every slot a run of stamps covers
# pyrs:     pyramids built in the frame, staged for upload
# span:     slots the next frame may step, over every generation it records
# fixed:    span is held where it was set rather than following what frames cost
# cost:     picoseconds of GPU time a slot is measured to cost, smoothed, 0
#           before the first measure
# clocks:   the timers measuring each frame's stepping in turn
# clocked:  the device writes timestamps and clocks are held, so cost paces
#           the span rather than the frame time
# paid:     slots the frame each clock last measured stepped, 0 for none
# turn:     the clock the next frame measures with
# found:    a frame came late since the frame time began pacing the span
# calm:     frames left before lateness cuts the span again
# worked:   slots the last frame stepped
# limited:  the span cut the last frame's steps short
# quick:    the last frame kept up with the display
# last:     when the last frame was recorded
# timed:    last holds a frame
# pace_us:  the refresh interval and the frame-time threshold for the display
# going:    a generation is part way through: front holds the one before it and
#           the back the ranges finished so far
# at:       the slot the generation going resumes from
# began:    the edit count when the generation going began
# rule:     the rule the generation going began under
# counted:  the last census and reduction read the front as it stands
# cursor:   the slot the next frame's upload of the CPU's chunks starts from
# send_ps:  picoseconds a byte of the CPU's chunks has cost to send, as the
#           last uploads measured it
# head:     the meta header staged for upload
# built:    a pyramid built on the host, staged for upload
# mark:     a pass's stage that asks for halos and claims slots
# free:     a pass's stage that frees what nothing asked for
# settle:   a pass's stage that keeps one twin and links it in
# gate:     the stage that zeroes the frame's steps while the gate is closed
# wipe:     the stage that empties the GPU's hash and free bits
# seed:     the stage that fills them again from the page table
# sp:       the host's pool this mirrors, once attached
# owns:     the GPU allocates and frees chunks itself, while it steps the
#           unbounded plane, and the host's page table mirrors its own
# moved:    a pass was recorded since the host last took the pool back
# reseed:   the next flush hands the pool back: the host changed it or reopens
#           the gate, so the allocator's words are written and the hash seeded
# rehash:   tombstones piled up in the hash, which the next flush seeds again
# top:      while owned, the slots every stage covers and below which a pass claims
# aim:      the top the newest census asked for, which a growth under way
#           lets the next flush reach
# pass:     the last pass id
# grouped:  cells of spread recorded since the last pass
# passed:   cells of spread the halo the last pass left holds
# rewound:  generations a closed gate voided, not yet taken from the world's count
# pop:      live cells the newest census found while owned
# box:      the box around them
# boxed:    box holds one
# used:     slots in use the newest census found while owned
# tallied:  pop, box and used are the world's, no edit having come since
# squeeze:  a test's hold on the top, until the pool is next taken, 0 for none
# listed:   the active list holds every slot the next generation may change,
#           gathered since the pool and the rule last changed
# gathered: cells of spread recorded since the list was gathered
# est:      the list's length as the newest census found it, UNKNOWN before one
# parts:    a test's hold on the span, a share of the next generation's
#           estimate, 0 for none
# gather:   the stage that gathers the active list
# ops:      the frame's planned dispatches
# nops:     how many
# ctl:      the status head's first words, as take read them
# untaken:  why the last take that failed left the pool the GPU's
pub rec Gpu {
    a:        *allo.Allocator;
    r:        *gfx.Renderer;
    d:        *gfx.Device;
    slots:    usize;
    p:        Pool;
    next:     Pool;
    reserved: bool;
    old:      Pool;
    retired:  bool;
    view:     gfx.StorageBuffer;
    steps:    [rule.FAMILIES_MAX]gfx.Compute;
    ready:    [rule.FAMILIES_MAX]bool;
    most:     usize;
    table:    gfx.StorageBuffer;
    words:    usize;
    tabled:   bool;
    shown:    rule.Rule;
    packed:   Vector[u32];
    inked:    bool;
    ink_rule: rule.Rule;
    ink:      bool;
    srgb:     bool;
    clear:    gfx.Compute;
    grow:     gfx.Compute;
    carry:    gfx.Compute;
    edit:     gfx.Compute;
    sets:     usize;
    edited:   gfx.StorageBuffer;
    room:     usize;
    edit_at:  Vector[u32];
    census:   gfx.Compute;
    reduce:   gfx.Compute;
    draw:     gfx.Shader;
    mat:      gfx.Material;
    xf:       gm.Transform;
    hi:       usize;
    front:    usize;
    stepping: bool;
    owed:     i64;
    drawn:    layout.Sense;
    serial:   u32;
    ring:     [8]Snap;
    id:       u32;
    spread:   u64;
    gens:     u64;
    limit:    u64;
    wide:     bool;
    want:     bool;
    halo:     u32;
    streak:   u32;
    patience: u32;
    hold:     u64;
    seq:      u64;
    held:     u64;
    settled:  u64;
    lag:      u64;
    stepped:  u64;
    cut:      bool;
    bulk:     u64;
    edits:    u64;
    writes:   Vector[Write];
    zeros:    Vector[u32];
    sent:     Vector[u32];
    stamped:  Vector[u32];
    batch:    Vector[gfx.BufferWrite];
    keys:     Vector[u64];
    stamp:    Vector[u32];
    pyrs:     Vector[u32];
    span:     usize;
    fixed:    bool;
    cost:     u64;
    clocks:   [3]gfx.GpuTimer;
    clocked:  bool;
    paid:     [3]usize;
    turn:     usize;
    found:    bool;
    calm:     u32;
    worked:   usize;
    limited:  bool;
    quick:    bool;
    last:     Instant;
    timed:    bool;
    pace_us:  Pace;
    going:    bool;
    at:       usize;
    began:    u64;
    rule:     rule.Rule;
    counted:  bool;
    cursor:   usize;
    send_ps:  u64;
    head:     [128]u32;
    built:    [layout.MIP]u32;
    mark:     gfx.Compute;
    free:     gfx.Compute;
    settle:   gfx.Compute;
    gate:     gfx.Compute;
    wipe:     gfx.Compute;
    seed:     gfx.Compute;
    sp:       *space.Space;
    owns:     bool;
    moved:    bool;
    reseed:   bool;
    rehash:   bool;
    top:      usize;
    aim:      usize;
    pass:     u32;
    grouped:  usize;
    passed:   usize;
    rewound:  u64;
    pop:      usize;
    box:      space.Box;
    boxed:    bool;
    used:     usize;
    tallied:  bool;
    squeeze:  usize;
    listed:   bool;
    gathered: usize;
    est:      usize;
    parts:    usize;
    gather:   gfx.Compute;
    ops:      [MAX_STEPS]Op;
    nops:     usize;
    ctl:      [16]u32;
    untaken:  str;
}

# how long frames may take against the display's refresh interval
#
# interval_us: the display's refresh interval in microseconds
# quick_us:    a frame no more than this many microseconds apart from the last
#              kept up with the display, and one further apart missed it
pub rec Pace {
    interval_us: u64;
    quick_us:    u64;
}

# the frame-time thresholds for a display refreshing at hz, which fall back to
# 60 Hz when hz is not a rate. a frame that keeps up is within 1.08 refresh
# intervals, the slack a frame's timing jitters by
# ---
# hz: the display's refresh rate in hertz, zero or less when unknown
pub fun pace_for(hz: f32) Pace {
    var rate: f32 = FALLBACK_HZ;
    if (hz > 0.0) { rate = hz; }
    val interval: u64 = (1000000.0 / rate + 0.5)::u64;
    ret Pace{interval_us: interval, quick_us: interval * 27 / 25};
}

# follow the display's refresh rate, which a window can change by moving to
# another monitor
# ---
# g:  the GPU side
# hz: the display's refresh rate in hertz, zero or less when unknown
pub fun display(g: *Gpu, hz: f32) {
    g.pace_us = pace_for(hz);
}

# the status buffer's head and the census rows of cap slots, what a frame reads back
fun status_bytes(cap: usize) usize {
    ret (layout.STATUS_HEAD::usize + cap * layout.ROW::usize) * 4;
}

# slots kept above n in use, so the GPU seldom runs out below the top
fun slack(n: usize) usize {
    val q: usize = n / 4;
    if (q < 64) { ret 64; }
    ret q;
}

fun make(d: *gfx.Device, size: usize, out: *gfx.StorageBuffer) err[gfx.Error] {
    val made: res[gfx.StorageBuffer, gfx.Error] = gfx.storage_buffer(d, size);
    if (sel made.err) { ret err[gfx.Error].err{made.err}; }
    @out = made.ok;
    ret err[gfx.Error].ok{};
}

# n, or fewer: the most slots a buffer of words words holds, with head words
# ahead of them and per words a slot
fun fit(n: usize, words: usize, head: usize, per: usize) usize {
    if (words < head) { ret 0; }
    val m: usize = (words - head) / per;
    if (m < n) { ret m; }
    ret n;
}

# the most slots a pool may hold on a device with these limits
#
# every storage buffer make_pool creates is bound whole, so each must fit the
# device's storage buffer range, and the tightest sets the ceiling, which is
# a layer's cells at their widest, a 32-bit layer's span a slot. the status
# and flags buffers are the same size for every pool, and a device too small
# for them holds none. the stages' arrays are declared for layout.MAX_SLOTS,
# which caps it on a device that allows more.
# ---
# l:   the device's limits
# ret: the ceiling, zero when the limits were never read
pub fun ceiling(l: gfx.Limits) usize {
    val words: usize = l.max_storage_buffer_range / 4;
    var n:     usize = layout.MAX_SLOTS::usize;
    # the cells, the pyramids, the meta, the status and flags, and the list
    n = fit(n, words, 0, plane.span_words(layer.WIDTH_MAX));
    n = fit(n, words, 0, MIP);
    n = fit(n, words, HEAD, space.ENTRY);
    if (words < layout.STATUS_WORDS::usize || words < layout.FLAGS_WORDS::usize) { ret 0; }
    n = fit(n, words, 0, 1);
    ret n;
}

# forget every census in flight: a readback of an old pool's size may still
# land, and nothing recorded before is wanted
fun forget_censuses(g: *Gpu) {
    var i: usize = 0;
    for (i < RING) {
        g.ring[i].id = 0;
        i            = i + 1;
    }
}

# a pool's buffer, made inside the frame when framed so nothing waits for the
# device, else outside one, which drains the queue
fun make_framed(g: *Gpu, framed: bool, size: usize, out: *gfx.StorageBuffer) err[gfx.Error] {
    if (!framed) { ret make(g.d, size, out); }
    val made: res[gfx.StorageBuffer, gfx.Error] = gfx.renderer_storage_buffer(g.r, size);
    if (sel made.err) { ret err[gfx.Error].err{made.err}; }
    @out = made.ok;
    ret err[gfx.Error].ok{};
}

# the buffers sized for cap slots and a set of layers, into pp, made inside
# the frame when framed
fun make_pool(g: *Gpu, pp: *Pool, cap: usize, framed: bool, set: *plane.Set) err[gfx.Error] {
    pp.got    = nil;
    pp.landed = nil;
    pp.held   = nil;
    pp.cap    = 0;
    pp.set    = @set;
    # each layer's two pools, then the rest, each made undone if one is refused
    var made: usize = 0;
    for (made < set.n * 2) {
        val e: err[gfx.Error] = make_framed(g, framed, cap * span_bytes(pp, made / 2), ?pp.cells[made]);
        if (sel e.err) {
            drop_cells(g, pp, made);
            ret e;
        }
        made = made + 1;
    }
    val e3: err[gfx.Error] = make_framed(g, framed, (HEAD + cap * space.ENTRY) * 4, ?pp.meta);
    if (sel e3.err) {
        drop_cells(g, pp, made);
        ret e3;
    }
    val e4: err[gfx.Error] = make_framed(g, framed, layout.STATUS_WORDS::usize * 4, ?pp.status);
    if (sel e4.err) {
        drop_cells(g, pp, made);
        gfx.storage_buffer_delete(g.d, ?pp.meta);
        ret e4;
    }
    val e5: err[gfx.Error] = gfx.readback(?pp.rb, g.d, status_bytes(cap));
    if (sel e5.err) {
        drop_cells(g, pp, made);
        gfx.storage_buffer_delete(g.d, ?pp.meta);
        gfx.storage_buffer_delete(g.d, ?pp.status);
        ret e5;
    }
    val e5f: err[gfx.Error] = make_framed(g, framed, layout.FLAGS_WORDS::usize * 4, ?pp.flags);
    if (sel e5f.err) {
        gfx.readback_delete(?pp.rb, g.d);
        drop_cells(g, pp, made);
        gfx.storage_buffer_delete(g.d, ?pp.meta);
        gfx.storage_buffer_delete(g.d, ?pp.status);
        ret e5f;
    }
    val e5l: err[gfx.Error] = make_framed(g, framed, cap * 4, ?pp.list);
    if (sel e5l.err) {
        gfx.storage_buffer_delete(g.d, ?pp.flags);
        gfx.readback_delete(?pp.rb, g.d);
        drop_cells(g, pp, made);
        gfx.storage_buffer_delete(g.d, ?pp.meta);
        gfx.storage_buffer_delete(g.d, ?pp.status);
        ret e5l;
    }
    val e5m: err[gfx.Error] = make_framed(g, framed, cap * MIP * 4, ?pp.mip);
    if (sel e5m.err) {
        gfx.storage_buffer_delete(g.d, ?pp.list);
        gfx.storage_buffer_delete(g.d, ?pp.flags);
        gfx.readback_delete(?pp.rb, g.d);
        drop_cells(g, pp, made);
        gfx.storage_buffer_delete(g.d, ?pp.meta);
        gfx.storage_buffer_delete(g.d, ?pp.status);
        ret e5m;
    }
    val rg: res[*u32, allo.Error] = allo.allocate[u32](g.a, status_bytes(cap) / 4);
    if (sel rg.err) {
        drop_pool(g, pp);
        ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.empty{}}};
    }
    pp.got = rg.ok;
    val ru: res[*u32, allo.Error] = allo.zallocate[u32](g.a, cap * space.CENSUS);
    if (sel ru.err) {
        drop_pool(g, pp);
        ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.empty{}}};
    }
    pp.landed = ru.ok;
    val rh: res[*u8, allo.Error] = allo.zallocate[u8](g.a, cap);
    if (sel rh.err) {
        drop_pool(g, pp);
        ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.empty{}}};
    }
    pp.held = rh.ok;
    pp.cap  = cap;
    ret err[gfx.Error].ok{};
}

# delete the first n of a pool's cell buffers
fun drop_cells(g: *Gpu, p: *Pool, n: usize) {
    var i: usize = n;
    for (i > 0) {
        i = i - 1;
        gfx.storage_buffer_delete(g.d, ?p.cells[i]);
    }
}

fun drop_pool(g: *Gpu, p: *Pool) {
    gfx.storage_buffer_delete(g.d, ?p.mip);
    gfx.storage_buffer_delete(g.d, ?p.list);
    gfx.storage_buffer_delete(g.d, ?p.flags);
    gfx.readback_delete(?p.rb, g.d);
    gfx.storage_buffer_delete(g.d, ?p.status);
    gfx.storage_buffer_delete(g.d, ?p.meta);
    drop_cells(g, p, p.set.n * 2);
    if (p.got != nil)    { allo.deallocate[u32](g.a, p.got, status_bytes(p.cap) / 4); }
    if (p.landed != nil) { allo.deallocate[u32](g.a, p.landed, p.cap * space.CENSUS); }
    if (p.held != nil)   { allo.deallocate[u8](g.a, p.held, p.cap); }
    p.got    = nil;
    p.landed = nil;
    p.held   = nil;
    p.cap    = 0;
}

# build the stages and buffers on a renderer
#
# stepping is false afterwards when the compute stages were refused, and the
# CPU must step; the draw still works.
# ---
# g:    the GPU side to build
# a:    allocator for host buffers
# r:    the renderer, initialized
# cap:  slots to size the pool for, at least the host pool's capacity and no
#       more than the device's ceiling
# heat: SHADES entries of four floats, the heat palette
# age:  SHADES entries of four floats, the age palette
# ret:  ok, or why the pool or the draw could not be made
pub fun init(g: *Gpu, a: *allo.Allocator, r: *gfx.Renderer, cap: usize, heat: *f32, age: *f32) err[gfx.Error] {
    g.a        = a;
    g.r        = r;
    g.d        = gfx.renderer_device(r);
    g.slots    = ceiling(gfx.renderer_limits(r));
    g.p.got    = nil;
    g.p.landed = nil;
    g.p.held   = nil;
    g.p.cap    = 0;
    g.owed     = 0;
    g.reserved = false;
    mem.zero[u8]((?g.drawn)::*u8, $size_of(layout.Sense));
    g.retired  = false;
    g.hi       = 0;
    g.front    = 0;
    g.id       = 0;
    g.spread   = 0;
    g.gens     = 0;
    g.limit    = space.SPREAD_RING::u64;
    g.wide     = false;
    g.want     = false;
    g.halo     = space.SPREAD_RING;
    g.streak   = 0;
    g.patience = WIDEN_AFTER;
    g.hold     = NO_HOLD;
    g.seq      = 0;
    g.held     = 0;
    g.settled  = 0;
    g.lag      = 0;
    g.stepped  = 0;
    g.bulk     = 0;
    g.edits    = 0;
    g.mat      = gfx.material();
    g.xf       = gm.transform_identity();
    g.writes   = vector.init[Write](a);
    g.zeros    = vector.init[u32](a);
    g.sent     = vector.init[u32](a);
    g.stamped  = vector.init[u32](a);
    g.batch    = vector.init[gfx.BufferWrite](a);
    g.keys     = vector.init[u64](a);
    g.stamp    = vector.init[u32](a);
    g.pyrs     = vector.init[u32](a);
    g.edit_at  = vector.init[u32](a);
    g.room     = 0;
    g.sets     = 0;
    g.cut      = false;
    g.span     = FIRST_SPAN;
    g.fixed    = false;
    g.cost     = 0;
    g.clocked  = false;
    g.turn     = 0;
    g.found    = false;
    g.calm     = 0;
    g.worked   = 0;
    g.limited  = false;
    g.quick    = false;
    g.timed    = false;
    g.going    = false;
    g.at       = 0;
    g.counted  = false;
    g.pace_us  = pace_for(0.0);
    g.cursor   = 0;
    g.send_ps  = SEND_PS;
    g.sp       = nil;
    g.owns     = false;
    g.moved    = false;
    g.reseed   = false;
    g.rehash   = false;
    g.top      = 0;
    g.aim      = 0;
    g.pass     = 0;
    g.grouped  = 0;
    g.passed   = 0;
    g.rewound  = 0;
    g.pop      = 0;
    g.boxed    = false;
    g.used     = 0;
    g.tallied  = false;
    g.squeeze  = 0;
    g.untaken  = "";
    g.listed   = false;
    g.gathered = 0;
    g.est      = UNKNOWN;
    g.parts    = 0;
    g.nops     = 0;
    g.words    = 0;
    g.tabled   = false;
    g.packed   = vector.init[u32](a);
    g.inked    = false;
    g.ink      = false;
    g.srgb     = gfx.renderer_is_srgb(r);
    # stamps start at zero, which neither of the first two serials matches
    g.serial = 2;

    val e6: err[gfx.Error] = gfx.shader(?g.draw, ?VERT_SPV[0], $length_of(VERT_SPV), ?FRAG_SPV[0], $length_of(FRAG_SPV));
    if (sel e6.err) { ret e6; }
    gfx.shader_set_state(?g.draw, gfx.pipeline_desc_2d());

    g.stepping = false;
    if (build_steps(g)) {
        if (build_stages(g)) { g.stepping = true; }
        or                   { drop_steps(g, rule.FAMILIES_MAX); }
    }
    if (g.stepping) { hold_clocks(g); }

    val e7: err[gfx.Error] = make(g.d, (INK_AT + SHADES * 4) * 4, ?g.view);
    if (sel e7.err) { ret e7; }
    val e8: err[gfx.Error] = gfx.storage_buffer_upload(g.d, ?g.view, LOOK * 4, heat::*u8, SHADES * 16);
    if (sel e8.err) { ret e8; }
    val e9: err[gfx.Error] = gfx.storage_buffer_upload(g.d, ?g.view, (LOOK + SHADES * 4) * 4, age::*u8, SHADES * 16);
    if (sel e9.err)    { ret e9; }
    if (cap > g.slots) { ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.overrun{(cap * plane.span_words(layer.WIDTH_MAX) * 4)::u64}}}; }
    forget_censuses(g);
    # a 32-bit state layer until the host's pool names its own, which the
    # first flush takes up
    var set: plane.Set = plane.state("cells", layer.WIDTH_MAX);
    ret make_pool(g, ?g.p, cap, false, ?set);
}

# the shared compute stages, in the order build_stages makes them
fun stage_of(g: *Gpu, i: usize, spv: **u8, len: *usize) *gfx.Compute {
    if (i == 0) {
        @spv = ?CLEAR_SPV[0];
        @len = $length_of(CLEAR_SPV);
        ret ?g.clear;
    }
    if (i == 1) {
        @spv = ?GROW_SPV[0];
        @len = $length_of(GROW_SPV);
        ret ?g.grow;
    }
    if (i == 2) {
        @spv = ?CENSUS_SPV[0];
        @len = $length_of(CENSUS_SPV);
        ret ?g.census;
    }
    if (i == 3) {
        @spv = ?REDUCE_SPV[0];
        @len = $length_of(REDUCE_SPV);
        ret ?g.reduce;
    }
    if (i == 4) {
        @spv = ?MARK_SPV[0];
        @len = $length_of(MARK_SPV);
        ret ?g.mark;
    }
    if (i == 5) {
        @spv = ?FREE_SPV[0];
        @len = $length_of(FREE_SPV);
        ret ?g.free;
    }
    if (i == 6) {
        @spv = ?SETTLE_SPV[0];
        @len = $length_of(SETTLE_SPV);
        ret ?g.settle;
    }
    if (i == 7) {
        @spv = ?GATE_SPV[0];
        @len = $length_of(GATE_SPV);
        ret ?g.gate;
    }
    if (i == 8) {
        @spv = ?WIPE_SPV[0];
        @len = $length_of(WIPE_SPV);
        ret ?g.wipe;
    }
    if (i == 9) {
        @spv = ?SEED_SPV[0];
        @len = $length_of(SEED_SPV);
        ret ?g.seed;
    }
    if (i == 10) {
        @spv = ?GATHER_SPV[0];
        @len = $length_of(GATHER_SPV);
        ret ?g.gather;
    }
    if (i == 11) {
        @spv = ?CARRY_SPV[0];
        @len = $length_of(CARRY_SPV);
        ret ?g.carry;
    }
    @spv = ?EDIT_SPV[0];
    @len = $length_of(EDIT_SPV);
    ret ?g.edit;
}

# the shared compute stages
val STAGES: usize = 13;

# hold the clocks a frame's stepping is timed by, all of them or none, none on
# a device whose queue writes no timestamps, which leaves the frame time to
# pace the span
fun hold_clocks(g: *Gpu) {
    g.clocked = false;
    var i: usize = 0;
    for (i < TIMERS) {
        val e: err[gfx.Error] = gfx.renderer_timer(g.r, ?g.clocks[i]);
        if (sel e.err) {
            drop_clocks(g, i);
            ret;
        }
        g.paid[i] = 0;
        i         = i + 1;
    }
    g.clocked = true;
}

# give the first n clocks back
fun drop_clocks(g: *Gpu, n: usize) {
    var i: usize = 0;
    for (i < n) {
        gfx.renderer_timer_delete(g.r, ?g.clocks[i]);
        i = i + 1;
    }
    g.clocked = false;
}

# build every shared compute stage, all of them or none
fun build_stages(g: *Gpu) bool {
    var i: usize = 0;
    for (i < STAGES) {
        var spv: *u8            = nil;
        var len: usize          = 0;
        val c:   *gfx.Compute   = stage_of(g, i, ?spv, ?len);
        val e:   err[gfx.Error] = gfx.compute(c, g.d, spv, len);
        if (sel e.err) {
            drop_stages(g, i);
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# delete the first n shared compute stages
fun drop_stages(g: *Gpu, n: usize) {
    var spv: *u8   = nil;
    var len: usize = 0;
    var i:   usize = 0;
    for (i < n) {
        gfx.compute_delete(stage_of(g, i, ?spv, ?len), g.d);
        i = i + 1;
    }
}

# build the step stage of every rule family that has one and whose bindings
# the device's dispatches hold, all of those or none. a family registered
# later has none built, and the CPU steps it
fun build_steps(g: *Gpu) bool {
    val most: usize = gfx.renderer_limits(g.r).max_dispatch_bindings;
    g.most = most;
    var i: usize = 0;
    for (i < rule.FAMILIES_MAX) {
        g.ready[i] = false;
        i          = i + 1;
    }
    i = 0;
    for (i < rule.families()) {
        var len: usize = 0;
        val spv: *u8   = rule.stage(i, ?len);
        if (spv != nil && rule.bindings(i) <= most) {
            val sc: err[gfx.Error] = gfx.compute(?g.steps[i], g.d, spv, len);
            if (sel sc.err) {
                drop_steps(g, i);
                ret false;
            }
            g.ready[i] = true;
        }
        i = i + 1;
    }
    ret true;
}

# delete the built step stages of the first n families
fun drop_steps(g: *Gpu, n: usize) {
    var i: usize = 0;
    for (i < n) {
        if (g.ready[i]) { gfx.compute_delete(?g.steps[i], g.d); }
        g.ready[i] = false;
        i          = i + 1;
    }
}

# whether the GPU steps rules of family f
pub fun steps(g: *Gpu, f: usize) bool {
    ret g.stepping && g.ready[f];
}

# why the GPU cannot step a rule, or nil when it can or does not step: its
# family has no stage built, or its family's stage, or the layers the rule
# stores its cells in, bind more storage buffers than the device's
# dispatches can
pub fun refusal(g: *Gpu, r: *rule.Rule) str {
    if (!g.stepping) { ret nil; }
    val f:   usize     = rule.family_of(r);
    var set: plane.Set = rule.layers(r);
    var tab: u32       = 0;
    if (rule.table(f)) { tab = 1; }
    var len: usize = 0;
    if (rule.stage(f, ?len) == nil) { ret "this rule's family has no GPU stage, so it cannot run while the GPU steps the world"; }
    # a family's stage was built only where its state layer's bindings fit
    if (g.ready[f] && (set.n == 1 || layer.bindings(set.n::u32, tab)::usize <= g.most)) { ret nil; }
    ret "this GPU's compute stages bind too few storage buffers for the rule buffer and layers this rule needs, so it cannot run while it steps the world";
}

# add a write to the batch the next send records
fun queue(g: *Gpu, offset: usize, src: *u8, len: usize) err[gfx.Error] {
    val pushed: res[usize, allo.Error] = vector.push[gfx.BufferWrite](?g.batch, gfx.BufferWrite{offset: offset, src: src, len: len});
    if (sel pushed.err) { ret err[gfx.Error].err{gfx.Error.alloc{pushed.err}}; }
    ret err[gfx.Error].ok{};
}

# record the batched writes into b as one copy, with one barrier pair around
# them all, and empty the batch. the bytes are staged as this returns, so their
# sources may change at once. the writes must not overlap
fun send(g: *Gpu, b: *gfx.StorageBuffer) err[gfx.Error] {
    if (g.batch.len == 0) { ret err[gfx.Error].ok{}; }
    val e: err[gfx.Error] = gfx.renderer_buffer_update_batch(g.r, b, g.batch.data, g.batch.len);
    vector.clear[gfx.BufferWrite](?g.batch);
    ret e;
}

# bring the rule buffer level with the rule running, ahead of the frame's steps
#
# the rule buffer changes only when the rule does, and a rule table's tree can
# run to megabytes, so it goes up through the frame's staging memory as one
# recorded copy, in order with the frame's dispatches: the steps recorded after
# it read it, and the frames in flight still reading the old one finish first.
# a rule needing more words than the buffer holds makes a larger one inside
# the frame, as a growing pool makes its buffers, and frees the old one once
# the frames reading it have run. nothing waits for the queue.
fun sync_table(g: *Gpu, r: *rule.Rule) err[gfx.Error] {
    if (g.tabled && rule.same(r, ?g.shown)) { ret err[gfx.Error].ok{}; }
    val n: usize = rule.table_words(r);
    if (n == 0) { ret err[gfx.Error].ok{}; }
    if (n > g.words) {
        if (g.words != 0) { gfx.storage_buffer_delete(g.d, ?g.table); }
        g.words  = 0;
        g.tabled = false;
        var want: usize = 1024;
        for (want < n) { want = want * 2; }
        val e: err[gfx.Error] = make_framed(g, true, want * 4, ?g.table);
        if (sel e.err) { ret e; }
        g.words = want;
    }
    vector.clear[u32](?g.packed);
    val room: res[usize, allo.Error] = vector.ensure[u32](?g.packed, n);
    if (sel room.err) { ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.overrun{(n * 4)::u64}}}; }
    rule.pack_table(r, g.packed.data);
    val queued: err[gfx.Error] = queue(g, 0, g.packed.data::*u8, n * 4);
    if (sel queued.err) { ret queued; }
    val up: err[gfx.Error] = send(g, ?g.table);
    if (sel up.err) { ret up; }
    g.shown  = @r;
    g.tabled = true;
    ret err[gfx.Error].ok{};
}

# a colour channel as the target stores it
fun channel(byte: u8, srgb: bool) f32 {
    val c: f32 = byte::f32 / 255.0;
    if (srgb) { ret theme.linear(c); }
    ret c;
}

# bring the view's rule palette level with the rule, and say in the look
# whether the draw uses it
#
# the palette is indexed by heat, where every family's word shows the state's
# place in the palette (cellar.layout.Sense), so the draw finds a live cell's
# colour as it finds its trail colour, at every zoom. it is built again only
# when the rule changes.
fun sync_ink(g: *Gpu, r: *rule.Rule, look: *Look) err[gfx.Error] {
    if (!g.inked || !rule.same(r, ?g.ink_rule)) {
        var pal: [1024]f32;
        mem.zero[f32](?pal[0], SHADES * 4);
        val sn:  layout.Sense = rule.sense(r);
        var ink: bool         = false;
        var st:  u32          = 1;
        for (st < rule.states(r)) {
            val c: opt[u32] = rule.colour(r, st);
            if (sel c.some) {
                val h: usize = layout.texel_heat(rule.sensed(r, st), sn.heat_shift, sn.heat_mask)::usize;
                pal[h * 4]     = channel(theme.red(c.some), g.srgb);
                pal[h * 4 + 1] = channel(theme.green(c.some), g.srgb);
                pal[h * 4 + 2] = channel(theme.blue(c.some), g.srgb);
                pal[h * 4 + 3] = 1.0;
                ink            = true;
            }
            st = st + 1;
        }
        if (ink) {
            fill_shades(?pal[0]);
            val up: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.view, INK_AT * 4, (?pal[0])::*u8, SHADES * 16);
            if (sel up.err) { ret up; }
        }
        g.ink      = ink;
        g.ink_rule = @r;
        g.inked    = true;
    }
    look.ink = 0;
    if (g.ink) { look.ink = 1; }
    ret err[gfx.Error].ok{};
}

# give every heat of a rule palette no state's word lands on the colour of the
# nearest heat below it that one does, or the lowest one's below them all, so a
# continuous rule's cell between its states' levels, a faint one under the
# first included, is drawn in its neighbour's colour
fun fill_shades(pal: *f32) {
    var first: usize = SHADES;
    var h:     usize = 0;
    for (h < SHADES) {
        if (pal[h * 4 + 3] != 0.0) {
            if (first == SHADES) { first = h; }
        }
        or (first != SHADES) { mem.copy[f32](?pal[h * 4], ?pal[(h - 1) * 4], 4); }
        h = h + 1;
    }
    h = 0;
    for (h < first && first < SHADES) {
        mem.copy[f32](?pal[h * 4], ?pal[first * 4], 4);
        h = h + 1;
    }
}

# make room for a pool of cap slots now, ahead of the host's pool growing to
# it, where a refusal can still turn the growth down, and the next frame moves
# the world into the buffers. only the render thread may call it, while the GPU
# steps the world (see Pool)
# ---
# g:   the GPU side
# cap: slots the host's pool grows to
# ret: false when the device refused the buffers
pub fun reserve(g: *Gpu, cap: usize) bool {
    if (cap <= g.p.cap || (g.reserved && cap <= g.next.cap)) { ret true; }
    var set: *plane.Set = ?g.p.set;
    if (g.sp != nil) { set = space.layers(g.sp); }
    ret make_next(g, cap, false, set);
}

# owe room for a pool of cap slots to the next frame, ahead of the host's pool
# growing to it, without calling the device, so whichever thread holds the
# world may grow the pool through it (see Pool). the next frame makes the
# buffers, failing if the device refuses them
# ---
# g:   the GPU side
# cap: slots the host's pool grows to
# ret: false when cap is past the device's ceiling
pub fun owe(g: *Gpu, cap: usize) bool {
    if (cap > g.slots) { ret false; }
    var was: i64 = atomic.load(?g.owed);
    for (cap::i64 > was && !atomic.cas(?g.owed, ?was, cap::i64)) {}
    ret true;
}

# make the buffers a growth to cap slots, or a change of layers, moves the
# world into, inside the frame when framed
fun make_next(g: *Gpu, cap: usize, framed: bool, set: *plane.Set) bool {
    # nothing has been recorded into a pool made since the last frame
    if (g.reserved) {
        drop_pool(g, ?g.next);
        g.reserved = false;
    }
    val made: err[gfx.Error] = make_pool(g, ?g.next, cap, framed, set);
    if (sel made.err) { ret false; }
    g.reserved = true;
    ret true;
}

# have the GPU side mirror the host's pool, which then makes room through
# reserve or owe before it grows, as the world's holder decides, and hands the
# pool back through take before the host reads or changes it
# ---
# g:  the GPU side
# sp: the host's pool, which must not move while it is mirrored
pub fun mirror(g: *Gpu, sp: *space.Space) {
    g.sp = sp;
}

# leave stepping to the CPU even though the compute stages were built, to
# measure the CPU engine against the GPU's
pub fun forgo_compute(g: *Gpu) {
    if (!g.stepping) { ret; }
    drop_steps(g, rule.FAMILIES_MAX);
    drop_stages(g, STAGES);
    g.stepping = false;
}

# release everything, waiting for the device first
pub fun dnit(g: *Gpu) {
    gfx.renderer_wait_idle(g.r);
    if (g.retired)  { drop_pool(g, ?g.old); }
    if (g.reserved) { drop_pool(g, ?g.next); }
    drop_pool(g, ?g.p);
    gfx.storage_buffer_delete(g.d, ?g.view);
    gfx.shader_delete(?g.draw, g.d);
    if (g.words != 0) { gfx.storage_buffer_delete(g.d, ?g.table); }
    vector.dnit[u32](?g.packed);
    if (g.stepping) {
        drop_steps(g, rule.FAMILIES_MAX);
        drop_stages(g, STAGES);
    }
    if (g.clocked) { drop_clocks(g, TIMERS); }
    vector.dnit[Write](?g.writes);
    vector.dnit[u32](?g.zeros);
    vector.dnit[u32](?g.sent);
    vector.dnit[u32](?g.stamped);
    vector.dnit[gfx.BufferWrite](?g.batch);
    vector.dnit[u64](?g.keys);
    vector.dnit[u32](?g.stamp);
    vector.dnit[u32](?g.pyrs);
    vector.dnit[u32](?g.edit_at);
    if (g.room != 0) { gfx.storage_buffer_delete(g.d, ?g.edited); }
}

# note an edit, which a census recorded before it cannot free chunks around
pub fun note_edit(g: *Gpu) {
    g.edits   = g.edits + 1;
    g.tallied = false;
}

# note a clear or fill: the pool was rebuilt whole and settled on the host,
# which gives every live chunk the halo in effect, so every census recorded
# before it is stale and that halo's reach is free again
pub fun note_bulk(g: *Gpu) {
    g.bulk    = g.bulk + 1;
    g.edits   = g.edits + 1;
    g.tallied = false;
    g.halo    = space.span(g.sp);
    g.limit   = g.spread + g.halo::u64;
    g.hold    = NO_HOLD;
    g.settled = g.seq;
    g.est     = UNKNOWN;
    vector.clear[Write](?g.writes);
    vector.clear[u32](?g.stamped);
}

# queue a painted cell, already written to the host's staging cells: its
# value in each layer an edit writes, the state and rule layers, and the shown
# layer it starts over (cellar.layer)
pub fun note_write(g: *Gpu, sp: *space.Space, s: usize, i: usize) {
    if ((sp.dirty[s] & space.DIRTY_CELLS) != 0) { ret; }
    val set: *plane.Set = space.layers(sp);
    val sh:  opt[usize] = plane.shown(set);
    var n:   usize      = plane.exact(set);
    if (sel sh.some) { n = sh.some + 1; }
    var k: usize = 0;
    for (k < n) {
        val v: u32 = plane.get(space.plane_of(sp, k, s), i);
        vector.push[Write](?g.writes, Write{k: k::u32, slot: s::u32, i: i::u32, v: v});
        k = k + 1;
    }
    vector.push[u32](?g.stamped, s::u32);
}

# hold the span at slots, rather than following the frame time, so a test
# can force a generation across frames in ranges as small as it likes
#[testing]
pub fun fix_span(g: *Gpu, slots: usize) {
    g.span  = slots;
    g.fixed = true;
}

# hold the span at a share of what the next generation is estimated to step,
# rather than following the frame time, so a test can force a generation
# across about parts frames however few slots its list holds
#[testing]
pub fun split_span(g: *Gpu, parts: usize) {
    g.parts = parts;
    g.fixed = true;
}

# hold the top at slots, no lower than the slots in use, until the pool is
# next taken back, so a test can run the passes out of free slots and close
# the gate
#[testing]
pub fun squeeze(g: *Gpu, slots: usize) {
    g.squeeze = slots;
}

# time the frame against the last, and pace the span by what frames cost
#
# with clocks, the span is what fits the stepping's share of the refresh
# interval at a slot's measured cost, refitted every frame. without, the frame
# time paces it (pace_by_frame).
fun follow(g: *Gpu) {
    val now: time.InstantClock = time.instant();
    if (sel now.err) { ret; }
    var us: u64 = 0;
    if (g.timed) { us = (time.instant_sub(now.ok, g.last) / 1000)::u64; }
    val late: bool = g.timed && us > g.pace_us.quick_us;
    g.quick = g.timed && !late;
    g.last  = now.ok;
    g.timed = true;
    if (g.fixed) { ret; }
    if (g.clocked) {
        measure(g);
        if (g.cost != 0) { g.span = fit_span(g.pace_us.interval_us * 1000 * STEP_SHARE / SHARE_OF, g.cost); }
        ret;
    }
    pace_by_frame(g, late, us);
}

# take what the clocks measured since the last frame into a slot's cost
fun measure(g: *Gpu) {
    var i: usize = 0;
    for (i < TIMERS) {
        val took: opt[Duration] = gfx.renderer_timer_take(g.r, ?g.clocks[i]);
        if (sel took.some) {
            if (g.paid[i] != 0) {
                var ps: u64 = took.some::u64 * 1000 / g.paid[i]::u64;
                if (ps == 0) { ps = 1; }
                g.cost = smooth(g.cost, ps);
            }
        }
        i = i + 1;
    }
}

# pace the span by the frame time, where the device writes no timestamps
#
# a frame later than the display cuts the span to the share of what the last
# frame stepped that would have fit the refresh interval, in proportion to how
# late it came, then waits out the frames already recorded before another cut.
# a frame on time that the span cut short grows it by an eighth until the
# first late frame and by a sixty-fourth after, since a frame on time shows no
# room to spare when the display paces it.
# ---
# late: the frame came later than the display
# us:   microseconds since the frame before
fun pace_by_frame(g: *Gpu, late: bool, us: u64) {
    if (g.calm > 0) {
        g.calm = g.calm - 1;
        ret;
    }
    if (late && g.worked != 0) {
        var was: usize = g.span;
        if (g.worked < was) { was = g.worked; }
        g.span  = cut_span(was, us, g.pace_us.interval_us);
        g.calm  = CALM;
        g.found = true;
    }
    or (g.quick && g.limited) {
        var share: usize = GROW_FAST;
        if (g.found) { share = GROW_SLOW; }
        g.span = g.span + g.span / share + 1;
        if (g.span > MAX_SPAN) { g.span = MAX_SPAN; }
    }
}

# the span that steps what fits budget_ns of GPU time at cost_ps a slot
fun fit_span(budget_ns: u64, cost_ps: u64) usize {
    if (cost_ps == 0) { ret MAX_SPAN; }
    val n: u64 = budget_ns * 1000 / cost_ps;
    if (n < MIN_SPAN::u64) { ret MIN_SPAN; }
    if (n > MAX_SPAN::u64) { ret MAX_SPAN; }
    ret n::usize;
}

# a slot's cost moved toward a measure of it: most of the way toward a dearer
# one, a little toward a cheaper one, and all the way from no cost yet
fun smooth(cost_ps: u64, measure_ps: u64) u64 {
    if (cost_ps == 0)         { ret measure_ps; }
    if (measure_ps > cost_ps) { ret cost_ps + (measure_ps - cost_ps + RISE - 1) / RISE; }
    ret cost_ps - (cost_ps - measure_ps) / FALL;
}

# the slots of worked that would have fit interval_us in a frame us long
fun cut_span(worked: usize, us: u64, interval_us: u64) usize {
    var n: u64 = worked::u64;
    if (us > interval_us)  { n = worked::u64 * interval_us / us; }
    if (n < MIN_SPAN::u64) { ret MIN_SPAN; }
    ret n::usize;
}

# follow how the uncapped frames are running with the halo, once per uncapped
# frame
#
# the halo widens once the budget cut several frames in a row short that kept
# up with the display, reach rather than frame time bounding them, and narrows
# once several in a row fell behind the display or would have fit the rule's
# ring.
# each such narrowing doubles how many frames the next widening waits for,
# until stepping stops being uncapped.
# ---
# g: the GPU side, after the frame
pub fun tune(g: *Gpu) {
    var argues: bool = g.cut && g.quick;
    if (g.wide) { argues = !g.quick || (!g.cut && g.lag + g.stepped <= space.ring(g.sp.reach)::u64); }
    if (argues) { g.streak = g.streak + 1; }
    or          { g.streak = 0; }
    if (!g.wide && g.streak >= g.patience) {
        g.want   = true;
        g.streak = 0;
    }
    or (g.wide && g.streak >= NARROW_AFTER) {
        # the wide halo slowed the frames more than its reach helped, so the
        # next widening waits twice as long
        g.want     = false;
        g.streak   = 0;
        g.patience = g.patience * 2;
        if (g.patience > WIDEN_MAX) { g.patience = WIDEN_MAX; }
    }
}

# forget the wide halo once stepping is no longer uncapped
pub fun rest(g: *Gpu) {
    g.want     = false;
    g.streak   = 0;
    g.patience = WIDEN_AFTER;
}

# how many generations may be recorded before the next census lands: any
# number over a pool held whole (cellar.space.cover), where no census makes room
# ---
# g:      the GPU side
# radius: the rule's radius, the spread of one generation
pub fun budget(g: *Gpu, radius: usize) usize {
    if (g.sp != nil && g.sp.whole) { ret MAX_STEPS; }
    val r: u64 = radius::u64;
    if (r == 0 || g.spread + r > g.limit) { ret 0; }
    val n: u64 = (g.limit - g.spread) / r;
    if (n > MAX_STEPS::u64) { ret MAX_STEPS; }
    ret n::usize;
}

# what collect found
# ---
# fresh:  a census landed and the host's pool was settled from it, or while
#         the GPU owns the pool, its count taken
# fits:   the pool held every chunk the world grew into
# behind: generations recorded since that census was taken
# kept:   the gate closed, and the pool could not be taken back to reopen it
#         (take), so it stays the GPU's and stepping stops
pub rec Landed {
    fresh:  bool;
    fits:   bool;
    behind: u64;
    kept:   bool;
}

# settle the host's pool from the newest census that has landed, or while the
# GPU owns the pool, count what it found and make the room it needs
#
# call once a frame after the frame begins and before anything is recorded, so
# a finished copy is taken before the frame's own readback reuses its slot,
# and so a pool taken back here is taken with the device idle.
# ---
# g:   the GPU side
# sp:  the host's pool
# ret: whether a census was settled, how far behind it is, and whether it fit
pub fun collect(g: *Gpu, sp: *space.Space) Landed {
    val none: Landed = Landed{fresh: false, fits: true, behind: 0, kept: false};
    if (!g.stepping || g.p.cap == 0) { ret none; }
    val len: usize = status_bytes(g.p.cap);
    if (!gfx.renderer_readback_take(g.r, ?g.p.rb, g.p.got::*u8, len)) { ret none; }
    val id:   u32   = g.p.got[layout.CTL_CENSUS::usize];
    val snap: *Snap = ?g.ring[id::usize % RING];
    if (snap.id != id || id == 0 || snap.cap != g.p.cap || snap.bulk != g.bulk || snap.seq < g.settled) { ret none; }
    if (snap.owned != g.owns)                                                                           { ret none; }
    g.est = g.p.got[layout.CTL_LISTED::usize]::usize;
    var n: usize = snap.hi;
    if (!snap.owned && n > sp.hi) { n = sp.hi; }
    val rows: *u32  = ?g.p.got[layout.STATUS_HEAD::usize];
    val row:  usize = layout.ROW::usize;
    # a slot matches its report when the incarnation bits agree. fewer than
    # 2^18 allocations happen between a census and its landing, since no frame
    # makes more than the pool holds, so bits that agree name the same chunk
    var pop:  usize = 0;
    var used: usize = 0;
    var high: usize = 0;
    var box:  space.Box;
    var any:  bool  = false;
    var s:    usize = 0;
    for (s < n) {
        val w: u32  = rows[s * row];
        val c: *u32 = ?g.p.landed[s * space.CENSUS];
        c[0] = w & 0x1fff;
        c[1] = (w >> 13) & 1;
        c[2] = w >> 14;
        c[4] = rows[s * row + 1];
        c[3] = 0;
        if (c[0] != 0) { c[3] = space.halo_of(c[4], snap.span); }
        if (!snap.owned) {
            val inc: u32 = space.incarnation(sp, s);
            c[2] = 0;
            if (inc != 0 && (w >> 14) == (inc & space.TAG)) { c[2] = inc; }
        }
        or (rows[s * row + 2] != 0) {
            used = used + 1;
            high = s + 1;
            pop  = pop + c[0]::usize;
            if (c[0] != 0) {
                val ox: i64 = (rows[s * row + 2]::i64 - space.BIAS) * space.SIDE;
                val oy: i64 = (rows[s * row + 3]::i64 - space.BIAS) * space.SIDE;
                val x0: i64 = ox + (c[4] & 63)::i64;
                val y0: i64 = oy + ((c[4] >> layout.EXTENT_Y0) & 63)::i64;
                val x1: i64 = ox + ((c[4] >> layout.EXTENT_X1) & 63)::i64 + 1;
                val y1: i64 = oy + ((c[4] >> layout.EXTENT_Y1) & 63)::i64 + 1;
                if (!any || x0 < box.x0) { box.x0 = x0; }
                if (!any || y0 < box.y0) { box.y0 = y0; }
                if (!any || x1 > box.x1) { box.x1 = x1; }
                if (!any || y1 > box.y1) { box.y1 = y1; }
                any = true;
            }
        }
        s = s + 1;
    }
    if (snap.owned) {
        val gate: bool = g.p.got[layout.CTL_GATE::usize] != 0;
        if (g.p.got[layout.CTL_TOMBS::usize] > layout.HASH / 8) { g.rehash = true; }
        # a census taken while the gate was closed read cells no step since
        # has touched, so it is no count of the world
        if (gate) {
            if (!take(g, sp)) { ret Landed{fresh: false, fits: true, behind: 0, kept: true}; }
            make_room(g, sp, g.top + slack(g.top));
            # a pool at its ceiling with no slot free below the top, and no
            # growth coming, cannot hold the world
            ret Landed{fresh: false, fits: sp.live < g.top || g.reserved, behind: 0, kept: false};
        }
        # a census taken before an edit is no count of the world after it
        if (snap.edits == g.edits) {
            g.pop     = pop;
            g.used    = used;
            g.box     = box;
            g.boxed   = any;
            g.tallied = true;
        }
        g.settled = snap.seq;
        if (high + slack(high) / 2 > g.top) { make_room(g, sp, high + slack(high)); }
        ret Landed{fresh: true, fits: true, behind: g.gens - snap.gens, kept: false};
    }
    val ok: bool = space.settle(sp, g.p.landed, n, snap.edits == g.edits);
    g.settled = snap.seq;
    g.lag     = g.spread - snap.spread;
    # a census recorded since the halo narrowed has freed what the narrower
    # halo leaves out
    if (snap.seq >= g.held) { g.hold = NO_HOLD; }
    # a census the pool could not be settled from leaves the limit where it was
    var to: u64 = snap.spread + snap.span::u64;
    if (to > g.hold)        { to = g.hold; }
    if (ok && to > g.limit) { g.limit = to; }
    ret Landed{fresh: true, fits: ok, behind: g.gens - snap.gens, kept: false};
}

# raise the top toward want slots while the GPU owns the pool, and make
# larger buffers ahead of it, when the buffers would leave less than its slack
# above it
#
# a raised top only lets the passes claim higher, since every free slot of the
# capacity has its free bit, so it takes no seeding. the next flush moves the
# pool into the larger buffers on the GPU (carry_comp), so a growth neither
# takes the pool back nor grows the host's, and the top passes the old
# capacity once the next flush has moved the pool, as aim keeps it.
fun make_room(g: *Gpu, sp: *space.Space, want: usize) {
    val ahead: usize = want + slack(want);
    if (ahead > g.p.cap) {
        var cap: usize = g.p.cap;
        for (cap < ahead && cap < sp.max_slots) { cap = cap * 2; }
        if (cap > sp.max_slots) { cap = sp.max_slots; }
        # made in the frame, so nothing waits for the device. a refusal leaves
        # the pool its buffers, the top held below them
        if (cap > g.p.cap && !(g.reserved && cap <= g.next.cap)) { make_next(g, cap, true, ?g.p.set); }
    }
    if (want > g.aim) { g.aim = want; }
    var top: usize = want;
    if (top > g.p.cap) { top = g.p.cap; }
    if (top > g.top)   { g.top = top; }
}

# take the pool back from the GPU while it owns it, so the host's page table
# is the GPU's: a stall, which reads the page table and the allocator's words,
# first growing the host's pool to the GPU's capacity, which grew without it
#
# a host refused the memory for that, or a read that fails, leaves the pool
# the GPU's as it was, the host's mirror stale, and why in untaken: nothing
# that needs the host's pool may go on.
# a closed gate voided every step recorded after the pass that closed it, so
# the count of generations, the serial and the front go back to that pass,
# and the generations taken back wait in rewound for the world's count. the
# GPU keeps owning the pool until the host changes it.
# call outside a frame, or in one before frame has recorded anything.
# ---
# g:   the GPU side
# sp:  the host's pool
# ret: the host's pool is the world's, false when the GPU keeps it
pub fun take(g: *Gpu, sp: *space.Space) bool {
    if (!g.owns || !g.moved) { ret true; }
    var n: usize = g.top;
    if (n > sp.cap && !space.grow(sp, g.p.cap)) {
        g.untaken = "there is not enough memory to bring the world back from the GPU";
        ret false;
    }
    val eh: err[gfx.Error] = gfx.storage_buffer_read(g.d, ?g.p.status, 0, (?g.ctl[0])::*u8, 64);
    if (sel eh.err) {
        g.untaken = "the GPU's pool could not be read back";
        ret false;
    }
    if (n != 0) {
        val et: err[gfx.Error] = gfx.storage_buffer_read(g.d, ?g.p.meta, HEAD * 4, sp.table::*u8, n * space.ENTRY * 4);
        if (sel et.err) {
            g.untaken = "the GPU's pool could not be read back";
            ret false;
        }
    }
    if (g.ctl[layout.CTL_GATE::usize] != 0) {
        val v: u64 = ((g.gens & 0xffffffff) + 0x100000000 - g.ctl[layout.CTL_HALT::usize]::u64) & 0xffffffff;
        g.gens    = g.gens - v;
        g.serial  = ((g.serial::u64 + 0x100000000 - (v & 0xffffffff)) & 0xffffffff)::u32;
        g.rewound = g.rewound + v;
        if ((v & 1) != 0) { g.front = 1 - g.front; }
        g.going   = false;
        g.counted = false;
        g.listed  = false;
        g.reseed  = true;
    }
    sp.serial = g.ctl[layout.CTL_SERIAL::usize];
    space.adopt(sp, n, g.p.landed);
    g.moved   = false;
    g.squeeze = 0;
    g.top     = sp.hi + slack(sp.hi);
    g.aim     = 0;
    if (g.top > g.p.cap) { g.top = g.p.cap; }
    ret true;
}

# why the last take the GPU kept the pool through could not take it back
pub fun untaken(g: *Gpu) str {
    ret g.untaken;
}

# generations a closed gate voided since this was last asked, which the
# world's count goes back by
pub fun rewound(g: *Gpu) u64 {
    val v: u64 = g.rewound;
    g.rewound = 0;
    ret v;
}

# whether the GPU owns the pool, so the host's census is not the world's and
# the counts come from it
pub fun owned(g: *Gpu) bool {
    ret g.stepping && g.owns;
}

# whether the counts the newest census found while the GPU owns the pool are
# the world's: none was taken since the last edit, when the host's census is
# the world's instead
pub fun tallied(g: *Gpu) bool {
    ret owned(g) && g.tallied;
}

# read the GPU's cells into the host's staging cells, taking the pool back
# first while the GPU owns it
#
# a stall. chunks whose staging is newer than the GPU's, filled or painted and
# not yet uploaded, keep their staging. call outside a frame, or in one before
# frame has recorded anything.
# ---
# g:   the GPU side
# sp:  the host's pool
# ret: ok, or why the read failed
pub fun pull(g: *Gpu, sp: *space.Space) err[gfx.Error] {
    if (!g.stepping)  { ret err[gfx.Error].ok{}; }
    if (!take(g, sp)) { ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.empty{}}}; }
    # one read per run of slots whose staging is not newer; a free slot's
    # staging is unused, so it may ride along in a run
    var top: usize = g.hi;
    if (sp.hi < top) { top = sp.hi; }
    val newer: u8    = space.DIRTY_CELLS | space.DIRTY_ZERO;
    var s:     usize = 0;
    for (s < top) {
        if ((sp.dirty[s] & newer) != 0) {
            s = s + 1;
            cnt;
        }
        var run: usize = 1;
        for (s + run < top && (sp.dirty[s + run] & newer) == 0) { run = run + 1; }
        val e: err[gfx.Error] = read_run(g, sp, s, run);
        if (sel e.err) { ret e; }
        s = s + run;
    }
    # a painted cell not yet uploaded is newer than what was just read
    var i: usize = 0;
    for (i < g.writes.len) {
        val w: Write = g.writes.data[i];
        plane.put(space.plane_of(sp, w.k::usize, w.slot::usize), w.i::usize, w.v);
        i = i + 1;
    }
    ret err[gfx.Error].ok{};
}

# read the GPU's cells of a run of slots into the host's staging cells, ahead
# of reading or editing them there, taking the pool back first while the GPU
# owns it, so the slots are the host's to name
#
# a stall. a slot whose staging is newer than the GPU's keeps it, and painted
# cells not yet uploaded for the run's slots are applied to the staging and
# kept for the upload. call outside a frame, or in one before frame has
# recorded anything.
# ---
# g:   the GPU side
# sp:  the host's pool
# lo:  first slot of the run
# n:   slots in the run
# ret: ok, or why the read failed
pub fun pull_chunks(g: *Gpu, sp: *space.Space, lo: usize, n: usize) err[gfx.Error] {
    if (!g.stepping)  { ret err[gfx.Error].ok{}; }
    if (!take(g, sp)) { ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.empty{}}}; }
    var top: usize = lo + n;
    if (g.hi < top)  { top = g.hi; }
    if (sp.hi < top) { top = sp.hi; }
    val newer: u8    = space.DIRTY_CELLS | space.DIRTY_ZERO;
    var s:     usize = lo;
    for (s < top) {
        if ((sp.dirty[s] & newer) != 0) {
            s = s + 1;
            cnt;
        }
        var run: usize = 1;
        for (s + run < top && (sp.dirty[s + run] & newer) == 0) { run = run + 1; }
        val e: err[gfx.Error] = read_run(g, sp, s, run);
        if (sel e.err) { ret e; }
        s = s + run;
    }
    var i: usize = 0;
    for (i < g.writes.len) {
        val w:    Write = g.writes.data[i];
        val slot: usize = w.slot::usize;
        if (slot >= lo && slot < lo + n) { plane.put(space.plane_of(sp, w.k::usize, slot), w.i::usize, w.v); }
        i = i + 1;
    }
    ret err[gfx.Error].ok{};
}

# drop the painted cells not yet uploaded for a run of slots the host now
# uploads whole, since a late replay would undo what the host wrote after them
# ---
# g:  the GPU side
# lo: first slot of the run
# n:  slots in the run
pub fun forget_writes(g: *Gpu, lo: usize, n: usize) {
    var keep: usize = 0;
    var i:    usize = 0;
    for (i < g.writes.len) {
        val w:    Write = g.writes.data[i];
        val slot: usize = w.slot::usize;
        if (slot < lo || slot >= lo + n) {
            g.writes.data[keep] = w;
            keep                = keep + 1;
        }
        i = i + 1;
    }
    g.writes.len = keep;
}

# read every layer of the GPU's front cells of a run of slots into the host's
# staging cells, which the GPU's layers must match, as every flush leaves them
fun read_run(g: *Gpu, sp: *space.Space, s: usize, run: usize) err[gfx.Error] {
    # layers changed since the last flush leave every slot's staging newer
    if (!plane.same_shape(?g.p.set, space.layers(sp))) { ret err[gfx.Error].ok{}; }
    var k: usize = 0;
    for (k < g.p.set.n) {
        val e: err[gfx.Error] = gfx.storage_buffer_read(g.d, cells_of(?g.p, k, g.front), span_offset(?g.p, k, s),
            space.span_run(sp, k, s)::*u8, run * span_bytes(?g.p, k));
        if (sel e.err) { ret e; }
        k = k + 1;
    }
    ret err[gfx.Error].ok{};
}

# whether the host filled slot s since the last flush, so it goes up whole
fun refilled(sp: *space.Space, s: usize) bool {
    ret (sp.dirty[s] & space.DIRTY_CELLS) != 0 && space.used(sp, s);
}

# batch the words of a word-wide layer l holding painted cells, as the host's
# cells hold them now, once each, and none in a chunk going up whole (filled),
# whose cells the host has written since. a layer narrower than a word has its
# painted cells written on the GPU instead (edit_painted)
fun queue_painted(g: *Gpu, sp: *space.Space, filled: bool, l: usize) err[gfx.Error] {
    vector.clear[u64](?g.keys);
    val width: u32 = g.p.set.at[l].width;
    if (width < layer.WIDTH_MAX) { ret err[gfx.Error].ok{}; }
    var i: usize = 0;
    for (i < g.writes.len) {
        val w: *Write = ?g.writes.data[i];
        if (w.k::usize == l && (!filled || !refilled(sp, w.slot::usize))) {
            val pushed: res[usize, allo.Error] = vector.push[u64](?g.keys, (layer.cell_at(width, w.slot, w.i)::u64 << 32) | i::u64);
            if (sel pushed.err) { ret err[gfx.Error].err{gfx.Error.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    sort.sort[u64](g.keys.data, g.keys.len);
    i = 0;
    for (i < g.keys.len) {
        val k: u64 = g.keys.data[i];
        if (i + 1 < g.keys.len && (g.keys.data[i + 1] >> 32) == (k >> 32)) {
            i = i + 1;
            cnt;
        }
        val w:  *Write         = ?g.writes.data[(k & 0xffffffff)::usize];
        val at: *u32           = ?space.plane_of(sp, l, w.slot::usize).w[layer.cell_word(width, w.i)::usize];
        val e:  err[gfx.Error] = queue(g, (k >> 32)::usize * 4, at::*u8, 4);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret err[gfx.Error].ok{};
}

# record a dispatch of the frame's flush, counting the storage binding set it
# takes from those its generations have (sets)
fun dispatch(g: *Gpu, c: *gfx.Compute, bufs: **gfx.StorageBuffer, n: usize, x: u32, y: u32, z: u32) err[gfx.Error] {
    g.sets = g.sets + 1;
    ret gfx.renderer_dispatch(g.r, c, bufs, n, x, y, z);
}

# write the painted cells of a layer l narrower than a word into the GPU's
# front, none in a chunk going up whole (filled): each cell's last edit goes up
# as the bits it takes in its word and its value in them, and the edit stage
# writes them there with atomics, so the word's other cells stay as the GPU
# holds them and the host need not pull them first (cellar.sim edit_begin)
fun edit_painted(g: *Gpu, sp: *space.Space, filled: bool, l: usize) err[gfx.Error] {
    val width: u32 = g.p.set.at[l].width;
    if (width >= layer.WIDTH_MAX || !g.stepping) { ret err[gfx.Error].ok{}; }
    vector.clear[u64](?g.keys);
    var i: usize = 0;
    for (i < g.writes.len) {
        val w: *Write = ?g.writes.data[i];
        if (w.k::usize == l && (!filled || !refilled(sp, w.slot::usize))) {
            val pushed: res[usize, allo.Error] = vector.push[u64](?g.keys, (layer.addr(w.slot, w.i)::u64 << 32) | i::u64);
            if (sel pushed.err) { ret err[gfx.Error].err{gfx.Error.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    if (g.keys.len == 0) { ret err[gfx.Error].ok{}; }
    sort.sort[u64](g.keys.data, g.keys.len);
    vector.clear[u32](?g.edit_at);
    val room: res[usize, allo.Error] = vector.ensure[u32](?g.edit_at, 4 + g.keys.len * 3);
    if (sel room.err) { ret err[gfx.Error].err{gfx.Error.alloc{room.err}}; }
    g.edit_at.len = 4;
    var n: u32 = 0;
    i = 0;
    for (i < g.keys.len) {
        val k: u64 = g.keys.data[i];
        # a cell's last edit alone
        if (i + 1 < g.keys.len && (g.keys.data[i + 1] >> 32) == (k >> 32)) {
            i = i + 1;
            cnt;
        }
        val w:  *Write = ?g.writes.data[(k & 0xffffffff)::usize];
        val a:  u32    = (k >> 32)::u32;
        val sh: u32    = layer.cell_shift(width, w.i);
        g.edit_at.data[g.edit_at.len]     = layer.addr_word(width, a);
        g.edit_at.data[g.edit_at.len + 1] = layer.mask(width) << sh;
        g.edit_at.data[g.edit_at.len + 2] = (w.v & layer.mask(width)) << sh;
        g.edit_at.len                     = g.edit_at.len + 3;
        n                                 = n + 1;
        i                                 = i + 1;
    }
    g.edit_at.data[0] = n;
    g.edit_at.data[1] = 0;
    g.edit_at.data[2] = 0;
    g.edit_at.data[3] = 0;
    # the edits' buffer grows inside the frame, as the rule buffer does
    if (g.edit_at.len > g.room) {
        if (g.room != 0) { gfx.storage_buffer_delete(g.d, ?g.edited); }
        g.room = 0;
        var want: usize = 1024;
        for (want < g.edit_at.len) { want = want * 2; }
        val e: err[gfx.Error] = make_framed(g, true, want * 4, ?g.edited);
        if (sel e.err) { ret e; }
        g.room = want;
    }
    val eu: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.edited, 0, g.edit_at.data::*u8, g.edit_at.len * 4);
    if (sel eu.err) { ret eu; }
    var eb: [2]*gfx.StorageBuffer;
    eb[0] = cells_of(?g.p, l, g.front);
    eb[1] = ?g.edited;
    ret dispatch(g, ?g.edit, ?eb[0], 2, (n + 63) / 64, 1, 1);
}

# batch the stamps that mark the slots in stamped alive and warm as of the
# current serial, a write for each run of them
fun queue_stamps(g: *Gpu) err[gfx.Error] {
    val n: usize = g.stamped.len;
    if (n == 0) { ret err[gfx.Error].ok{}; }
    sort.sort[u32](g.stamped.data, n);
    vector.clear[u32](?g.stamp);
    val room: res[usize, allo.Error] = vector.ensure[u32](?g.stamp, n * 2);
    if (sel room.err) { ret err[gfx.Error].err{gfx.Error.alloc{room.err}}; }
    mem.fill[u32](g.stamp.data, g.serial, n * 2);
    g.stamp.len = n * 2;
    var i: usize = 0;
    for (i < n) {
        val lo:  u32   = g.stamped.data[i];
        var run: usize = 1;
        i = i + 1;
        for (i < n && g.stamped.data[i] <= lo + run::u32) {
            if (g.stamped.data[i] == lo + run::u32) { run = run + 1; }
            i = i + 1;
        }
        val e: err[gfx.Error] = queue(g, lo::usize * 8, g.stamp.data::*u8, run * 8);
        if (sel e.err) { ret e; }
    }
    ret err[gfx.Error].ok{};
}

# bring the GPU's pool level with the host's: grow it, then upload changed
# page-table entries, whole chunks and painted cells. chunks are uploaded where
# the GPU steps, or with whole where the host fills them for the draw. owns
# says whether the GPU is to own the pool from here on: taking it on, or the
# host having changed it, hands it back (hand_back)
fun flush(g: *Gpu, sp: *space.Space, whole: bool, owns: bool) err[gfx.Error] {
    # buffers a growth replaced are freed once the frame that copied out of
    # them has run, which deleting waits for
    if (g.retired) {
        drop_pool(g, ?g.old);
        g.retired = false;
    }
    # the GPU owned the pool before this frame, so its page table is the one
    # a growth carries
    var held: bool = g.owns;
    # a pool that cannot be taken back stays the GPU's
    if (g.owns && !owns && take(g, sp)) {
        g.owns = false;
        held   = false;
    }
    if (!g.owns && owns) {
        # the host's halo is the rule's ring from here on, as the passes keep it
        g.owns   = true;
        g.moved  = false;
        g.reseed = true;
        g.top    = 0;
        g.aim    = 0;
        g.want   = false;
        g.wide   = false;
        sp.wide  = false;
        g.listed = false;
    }
    val owed: usize = atomic.exchange(?g.owed, 0)::usize;
    if (owed > g.p.cap && !(g.reserved && owed <= g.next.cap) && !make_next(g, owed, true, space.layers(sp))) {
        ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.overrun{(owed * plane.span_words(layer.WIDTH_MAX) * 4)::u64}}};
    }
    # buffers made for other layers than the host's are made again for them,
    # at the capacity they were to have, and filled from the host's cells
    var aim: *Pool = ?g.p;
    if (g.reserved) { aim = ?g.next; }
    val relaid: bool = !plane.same_shape(?aim.set, space.layers(sp));
    if (relaid && !make_next(g, aim.cap, true, space.layers(sp))) {
        ret err[gfx.Error].err{gfx.Error.buffer{gfx.BufferError.overrun{(aim.cap * plane.span_words(layer.WIDTH_MAX) * 4)::u64}}};
    }
    val grew: bool = g.reserved;
    if (grew && relaid) {
        # the host's cells and page table are the world's, and go up whole
        g.old      = g.p;
        g.retired  = true;
        g.p        = g.next;
        g.reserved = false;
        g.est      = UNKNOWN;
        forget_censuses(g);
        var t: usize = 0;
        for (t < sp.hi) {
            sp.dirty[t] = sp.dirty[t] | space.DIRTY_ENTRY;
            if (space.used(sp, t)) { sp.dirty[t] = sp.dirty[t] | space.DIRTY_CELLS; }
            t = t + 1;
        }
        if (g.owns) { g.reseed = true; }
    }
    or (grew) {
        # the world moves into the larger buffers reserve made
        g.old      = g.p;
        g.retired  = true;
        g.p        = g.next;
        g.reserved = false;
        g.est      = UNKNOWN;
        forget_censuses(g);
        # a gate closed in a frame no census has shown yet voided steps the
        # front was turned for, so while the GPU owned the pool either cells may
        # hold the world, and both go
        var pools: usize = 1;
        if (held) { pools = 2; }
        # a dispatch a layer, its workgroups along x covering a slot's span
        var k: usize = 0;
        for (g.hi != 0 && g.stepping && k < pools * g.p.set.n) {
            val c:  usize = (g.front + k % pools) % 2;
            val l:  usize = k / pools;
            var gb: [4]*gfx.StorageBuffer;
            gb[0] = cells_of(?g.old, l, c);
            gb[1] = cells_of(?g.p, l, c);
            gb[2] = ?g.old.flags;
            gb[3] = ?g.p.flags;
            val eg: err[gfx.Error] = dispatch(g, ?g.grow, ?gb[0], 4, (span_bytes(?g.p, l) / 256)::u32, g.hi::u32, 1);
            if (sel eg.err) { ret eg; }
            k = k + 1;
        }
        if (held) {
            # the GPU carries its own page table, which the host's may lag, and
            # keeps owning the pool, its hash and free bits seeded again for
            # the larger capacity
            var cb: [4]*gfx.StorageBuffer;
            cb[0] = ?g.old.meta;
            cb[1] = ?g.p.meta;
            cb[2] = ?g.old.status;
            cb[3] = ?g.p.status;
            val ec: err[gfx.Error] = dispatch(g, ?g.carry, ?cb[0], 4, 1, g.old.cap::u32, 1);
            if (sel ec.err) { ret ec; }
            g.rehash = true;
        }
        or {
            # the host's page table is the world's, and goes up again
            var t: usize = 0;
            for (t < sp.hi) {
                sp.dirty[t] = sp.dirty[t] | space.DIRTY_ENTRY;
                t           = t + 1;
            }
            if (g.owns) { g.reseed = true; }
        }
    }

    # the GPU's top may lie past the host's capacity, which did not grow with it
    var top: usize = sp.hi;
    if (g.hi > top)   { top = g.hi; }
    if (top > sp.cap) { top = sp.cap; }
    var entries: usize = 0;
    var chunks:  usize = 0;
    var s:       usize = 0;
    for (s < top) {
        if ((sp.dirty[s] & space.DIRTY_ENTRY) != 0) { entries = entries + 1; }
        if ((sp.dirty[s] & space.DIRTY_CELLS) != 0) { chunks = chunks + 1; }
        s = s + 1;
    }
    # cells the host changed land in the front, under the ranges a generation
    # part way through already stepped, and a growth leaves its back cells
    # behind, so it starts over. chunks a census settled are not among them:
    # the budget keeps any generation from reaching one it allocates or frees
    if (entries != 0 && g.owns)                                   { g.reseed = true; }
    if (grew || chunks != 0 || g.writes.len != 0)                 { g.going = false; }
    if (grew || chunks != 0 || entries != 0 || g.writes.len != 0) { g.counted = false; }
    # a list gathered before read the page table and the stamps as they were
    if (grew || chunks != 0 || entries != 0 || g.writes.len != 0 || g.stamped.len != 0) { g.listed = false; }

    # every write below is recorded into the frame, in order with the growth
    # copy and the steps, so nothing waits on the GPU, and each buffer's go up
    # as one batch with one barrier pair, a write for each run of changed
    # entries or chunks
    s = 0;
    for (entries != 0 && s < top) {
        if ((sp.dirty[s] & space.DIRTY_ENTRY) == 0) {
            s = s + 1;
            cnt;
        }
        var run: usize = 1;
        for (s + run < top && (sp.dirty[s + run] & space.DIRTY_ENTRY) != 0) { run = run + 1; }
        val e10: err[gfx.Error] = queue(g, (HEAD + s * space.ENTRY) * 4, (?sp.table[s * space.ENTRY])::*u8, run * space.ENTRY * 4);
        if (sel e10.err) { ret e10; }
        s = s + run;
    }
    val e11: err[gfx.Error] = send(g, ?g.p.meta);
    if (sel e11.err) { ret e11; }

    if (g.stepping) {
        # chunks allocated empty are cleared on the GPU, in both pools
        vector.clear[u32](?g.zeros);
        s = 0;
        for (s < top) {
            if ((sp.dirty[s] & (space.DIRTY_ZERO | space.DIRTY_CELLS)) == space.DIRTY_ZERO && space.used(sp, s)) {
                vector.push[u32](?g.zeros, s::u32);
            }
            s = s + 1;
        }
        if (g.zeros.len != 0) {
            val el: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.list, 0, g.zeros.data::*u8, g.zeros.len * 4);
            if (sel el.err) { ret el; }
            # a dispatch a layer, its workgroups along x covering a slot's span
            var k: usize = 0;
            for (k < g.p.set.n) {
                var zb: [4]*gfx.StorageBuffer;
                zb[0] = cells_of(?g.p, k, 0);
                zb[1] = cells_of(?g.p, k, 1);
                zb[2] = ?g.p.list;
                zb[3] = ?g.p.flags;
                val ez: err[gfx.Error] = dispatch(g, ?g.clear, ?zb[0], 4, (span_bytes(?g.p, k) / 256)::u32, g.zeros.len::u32, 1);
                if (sel ez.err) { ret ez; }
                k = k + 1;
            }
        }
    }

    # chunks the host filled are uploaded, where the GPU steps or with whole,
    # and stamped so they step in full. painted cells go up after the clear,
    # which may have emptied the chunk they lie in
    val filled: bool  = g.stepping || whole;
    var l:      usize = 0;
    for (l < g.p.set.n) {
        s = 0;
        for (filled && chunks != 0 && s < top) {
            if (!refilled(sp, s)) {
                s = s + 1;
                cnt;
            }
            var run: usize = 1;
            for (s + run < top && refilled(sp, s + run)) { run = run + 1; }
            val e12: err[gfx.Error] = queue(g, span_offset(?g.p, l, s), space.span_run(sp, l, s)::*u8, run * span_bytes(?g.p, l));
            if (sel e12.err) { ret e12; }
            var k: usize = 0;
            for (g.stepping && l == 0 && k < run) {
                vector.push[u32](?g.stamped, (s + k)::u32);
                k = k + 1;
            }
            s = s + run;
        }
        val e13: err[gfx.Error] = queue_painted(g, sp, filled, l);
        if (sel e13.err) { ret e13; }
        val e14: err[gfx.Error] = send(g, cells_of(?g.p, l, g.front));
        if (sel e14.err) { ret e14; }
        val e15: err[gfx.Error] = edit_painted(g, sp, filled, l);
        if (sel e15.err) { ret e15; }
        l = l + 1;
    }
    vector.clear[Write](?g.writes);
    if (g.stepping) {
        val es: err[gfx.Error] = queue_stamps(g);
        if (sel es.err) { ret es; }
        val ef: err[gfx.Error] = send(g, ?g.p.flags);
        if (sel ef.err) { ret ef; }
    }
    vector.clear[u32](?g.stamped);

    # while the CPU steps, a chunk the host changed is sent again with its
    # pyramid, which the step built unless something else changed it since
    s = 0;
    for (s < top) {
        val d: u8 = sp.dirty[s];
        if (!g.stepping && (d & (space.DIRTY_CELLS | space.DIRTY_ZERO)) != 0) {
            g.p.held[s] = 0;
            if ((d & space.DIRTY_MIP) != 0 && sp.mips != nil) { g.p.held[s] = BUILT; }
        }
        sp.dirty[s] = 0;
        s           = s + 1;
    }
    g.hi = sp.hi;
    if (g.owns) {
        var want: usize = sp.hi + slack(sp.hi);
        if (want < g.aim)                                              { want = g.aim; }
        if (g.top < want)                                              { g.top = want; }
        if (g.top > g.p.cap)                                           { g.top = g.p.cap; }
        if (g.squeeze != 0 && g.top > g.squeeze && g.squeeze >= sp.hi) { g.top = g.squeeze; }
        g.hi = g.top;
        if (g.reseed) {
            val eb: err[gfx.Error] = hand_back(g, sp);
            if (sel eb.err) { ret eb; }
        }
        or (g.rehash) {
            val er: err[gfx.Error] = rehash(g);
            if (sel er.err) { ret er; }
        }
    }
    ret err[gfx.Error].ok{};
}

# hand the pool the host changed back to the GPU: the gate reopened, the
# incarnations going on from the host's, the top and the capacity written, and
# the hash and the free bits seeded from the page table just uploaded. the next
# generation waits for a pass, which gives the host's chunks their halo
fun hand_back(g: *Gpu, sp: *space.Space) err[gfx.Error] {
    var w: [4]u32;
    w[0] = 0;
    w[1] = 0;
    w[2] = 0;
    w[3] = sp.serial;
    val ew: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.status, layout.CTL_GATE::usize * 4, (?w[0])::*u8, 16);
    if (sel ew.err) { ret ew; }
    g.reseed  = false;
    g.grouped = MAX_SPAN;
    ret rehash(g);
}

# seed the GPU's hash and free bits from its page table again, for the top
# and the capacity written ahead of it, which also clears the tombstones out of
# the hash
fun rehash(g: *Gpu) err[gfx.Error] {
    var w: [2]u32;
    w[0] = g.top::u32;
    w[1] = g.p.cap::u32;
    val et: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.status, layout.CTL_TOP::usize * 4, (?w[0])::*u8, 8);
    if (sel et.err) { ret et; }
    var wb: [1]*gfx.StorageBuffer;
    wb[0] = ?g.p.status;
    val ew: err[gfx.Error] = dispatch(g, ?g.wipe, ?wb[0], 1, layout.HASH / 64, 1, 1);
    if (sel ew.err) { ret ew; }
    var sb: [2]*gfx.StorageBuffer;
    sb[0] = ?g.p.meta;
    sb[1] = ?g.p.status;
    val es: err[gfx.Error] = dispatch(g, ?g.seed, ?sb[0], 2, ((g.p.cap + 63) / 64)::u32, 1, 1);
    if (sel es.err) { ret es; }
    g.rehash = false;
    ret err[gfx.Error].ok{};
}

# the chunks a look can see, a chunk beyond each side: columns and rows x0, y0,
# x1, y1, inclusive
# ---
# look: the camera
# out:  receives the four
pub fun view_chunks(look: *Look, out: *i64) {
    val bx: i64 = look.base_cx::i64 - space.BIAS;
    val by: i64 = look.base_cy::i64 - space.BIAS;
    val hw: f32 = look.half_w / look.ppc;
    val hh: f32 = look.half_h / look.ppc;
    out[0] = bx + ((look.frac_x - hw) / 64.0 - 1.0)::i64;
    out[1] = by + ((look.frac_y - hh) / 64.0 - 1.0)::i64;
    out[2] = bx + ((look.frac_x + hw) / 64.0 + 1.0)::i64;
    out[3] = by + ((look.frac_y + hh) / 64.0 + 1.0)::i64;
}

# whether a look draws from the coverage pyramids rather than the cells: at
# half a pixel per cell or less (see cells_frag)
pub fun reads_pyramids(look: *Look) bool {
    ret look.ppc > 0.0 && look.ppc <= 0.5;
}

# while the CPU steps, upload the chunks the view can see that changed since
# they were last sent, as one batch, for as long as the refresh interval over
# VIEW_SHARE allows: the time spent choosing them and what the last batches
# measured their bytes to cost to send (send_ps). it goes on from where the
# last frame stopped so every chunk takes its turn. what does not fit is sent by the frames after, so the view may lag the
# world a generation but the frame never waits on it. the pyramids come built
# from the step (space.pyramid), and only a chunk changed some other way has its
# own built here. the draw reads either the cells or, at half a pixel per cell
# or less, the pyramids, so only the one it reads is sent
fun upload_view(g: *Gpu, sp: *space.Space, look: *Look) err[gfx.Error] {
    # a pyramid reads its cells through the rule's sense
    if (!mem.equal[u8]((?g.drawn)::*u8, (?sp.sense)::*u8, $size_of(layout.Sense))) {
        mem.zero[u8](g.p.held, g.p.cap);
        g.drawn = sp.sense;
    }
    if (look.ppc <= 0.0 || sp.hi == 0) { ret err[gfx.Error].ok{}; }
    var box: [4]i64;
    view_chunks(look, ?box[0]);
    var want: u8 = SENT_CELLS;
    if (reads_pyramids(look)) { want = SENT_MIP; }
    vector.clear[u32](?g.pyrs);
    vector.clear[u32](?g.sent);
    val t0: time.InstantClock = time.instant();
    if (sel t0.err) { ret err[gfx.Error].ok{}; }
    # the draw reads a chunk's state layer and its view layers
    var drawn: usize = 0;
    var k:     usize = 0;
    for (k < g.p.set.n) {
        if (k == 0 || g.p.set.at[k].role == layer.VIEW) { drawn = drawn + span_bytes(?g.p, k); }
        k = k + 1;
    }
    val budget: u64   = g.pace_us.quick_us * 1000 / VIEW_SHARE;
    var s:      usize = g.cursor;
    if (s >= sp.hi) { s = 0; }
    var bytes: usize = 0;
    var n:     usize = 0;
    for (n < sp.hi) {
        val h: u8 = g.p.held[s];
        if (space.used(sp, s) && (h & want) != want) {
            val x: i64 = space.slot_x(sp, s);
            val y: i64 = space.slot_y(sp, s);
            if (x >= box[0] && x <= box[2] && y >= box[1] && y <= box[3]) {
                var len: usize = MIP * 4;
                if (want == SENT_CELLS) { len = drawn; }
                val now: time.InstantClock = time.instant();
                if (sel now.ok) {
                    val spent: u64 = time.instant_sub(now.ok, t0.ok)::u64 + ((bytes + len)::u64 * g.send_ps) / 1000;
                    if (spent > budget) { brk; }
                }
                bytes = bytes + len;
                var e: err[gfx.Error] = err[gfx.Error].ok{};
                if (want == SENT_CELLS) {
                    # the slots whose layers go up, once the choosing is done
                    val pushed: res[usize, allo.Error] = vector.push[u32](?g.sent, s::u32);
                    if (sel pushed.err) { e = err[gfx.Error].err{gfx.Error.alloc{pushed.err}}; }
                }
                or ((h & BUILT) != 0) {
                    e = queue(g, s * MIP * 4, (?sp.mips[s * MIP])::*u8, MIP * 4);
                }
                or {
                    # staged in pyrs, which may move as it grows, so the write
                    # finds its bytes once every pyramid is built
                    val room: res[usize, allo.Error] = vector.reserve[u32](?g.pyrs, MIP);
                    if (sel room.err) { e = err[gfx.Error].err{gfx.Error.alloc{room.err}}; }
                    or {
                        space.pyramid(space.plane_of(sp, 0, s), space.shown_of(sp, s), sp.sense, ?g.pyrs.data[g.pyrs.len]);
                        g.pyrs.len = g.pyrs.len + MIP;
                        e          = queue(g, s * MIP * 4, nil, MIP * 4);
                    }
                }
                if (sel e.err) {
                    vector.clear[gfx.BufferWrite](?g.batch);
                    vector.clear[u32](?g.sent);
                    ret e;
                }
                g.p.held[s] = h | want;
            }
        }
        s = s + 1;
        if (s >= sp.hi) { s = 0; }
        n = n + 1;
    }
    g.cursor = s;
    if (bytes == 0) { ret err[gfx.Error].ok{}; }
    val t1: time.InstantClock = time.instant();
    var e:  err[gfx.Error]    = err[gfx.Error].ok{};
    if (want == SENT_MIP) {
        var m: usize = 0;
        var i: usize = 0;
        for (i < g.batch.len) {
            if (g.batch.data[i].src == nil) {
                g.batch.data[i].src = (?g.pyrs.data[m * MIP])::*u8;
                m                   = m + 1;
            }
            i = i + 1;
        }
        e = send(g, ?g.p.mip);
    }
    or {
        e = send_drawn(g, sp);
        vector.clear[u32](?g.sent);
        if (sel e.err) { vector.clear[gfx.BufferWrite](?g.batch); }
    }
    val t2: time.InstantClock = time.instant();
    if (sel t1.ok) {
        if (sel t2.ok) {
            # what the batch's bytes cost to send, for the next frame's budget
            val ps: u64 = time.instant_sub(t2.ok, t1.ok)::u64 * 1000 / bytes::u64;
            g.send_ps = (g.send_ps * 3 + ps) / 4;
        }
    }
    ret e;
}

# send the layers the draw reads of the slots in sent, each layer as one batch
fun send_drawn(g: *Gpu, sp: *space.Space) err[gfx.Error] {
    var k: usize = 0;
    for (k < g.p.set.n) {
        if (k == 0 || g.p.set.at[k].role == layer.VIEW) {
            var i: usize = 0;
            for (i < g.sent.len) {
                val sl: usize          = g.sent.data[i]::usize;
                val eq: err[gfx.Error] = queue(g, span_offset(?g.p, k, sl), space.span_run(sp, k, sl)::*u8, span_bytes(?g.p, k));
                if (sel eq.err) { ret eq; }
                i = i + 1;
            }
            val es: err[gfx.Error] = send(g, cells_of(?g.p, k, g.front));
            if (sel es.err) { ret es; }
        }
        k = k + 1;
    }
    ret err[gfx.Error].ok{};
}

# whether the GPU's pyramid of every chunk the host's staging holds as the GPU
# does is the one its cells give; call after a pull, outside a frame
#[testing]
pub fun pyramids_hold(g: *Gpu, sp: *space.Space) bool {
    var got: [layout.MIP]u32;
    var s:   usize = 0;
    for (s < g.hi && s < sp.hi) {
        if (space.used(sp, s) && sp.dirty[s] == 0) {
            val e: err[gfx.Error] = gfx.storage_buffer_read(g.d, ?g.p.mip, s * MIP * 4, (?got[0])::*u8, MIP * 4);
            if (sel e.err) { ret false; }
            space.pyramid(space.plane_of(sp, 0, s), space.shown_of(sp, s), sp.sense, ?g.built[0]);
            var i: usize = 0;
            for (i < MIP) {
                if (got[i] != g.built[i]) { ret false; }
                i = i + 1;
            }
        }
        s = s + 1;
    }
    ret true;
}

# read a slot's span of the GPU's front cells of layer k into out, its
# plane.span_words words; call outside a frame
#[testing]
pub fun read_front(g: *Gpu, k: usize, s: usize, out: *u32) bool {
    val e: err[gfx.Error] = gfx.storage_buffer_read(g.d, cells_of(?g.p, k, g.front), span_offset(?g.p, k, s), out::*u8, span_bytes(?g.p, k));
    ret sel e.ok;
}

# stage the meta head: the shared words, then the rule in its family's window
# ---
# g:   the GPU side
# r:   the rule
# gen: the generation the cells hold as the frame begins
fun write_head(g: *Gpu, r: *rule.Rule, gen: u64) {
    val sn: layout.Sense = rule.sense(r);
    mem.zero[u32](?g.head[0], HEAD);
    g.head[0]  = g.id;
    g.head[1]  = g.hi::u32;
    g.head[2]  = g.serial;
    g.head[3]  = sn.live_mask;
    g.head[4]  = sn.live_lo;
    g.head[5]  = sn.live_hi;
    g.head[6]  = sn.warm_mask;
    g.head[7]  = sn.heat_shift;
    g.head[8]  = sn.heat_mask;
    g.head[9]  = sn.age_shift;
    g.head[10] = sn.age_mask;
    # the frame's first step, of serial g.serial + 1, reads generation gen
    g.head[layout.GEN_AT::usize] = (((gen & 0xffffffff) + 0x200000000 - g.serial::u64 - 1) & 0xffffffff)::u32;
    if (rule.caps(r).b0) { g.head[layout.STROBE_AT::usize] = 1; }
    # the shared stages read the pool's state layer at its width, and its
    # shown layer at its own
    g.head[layout.WIDTH_AT::usize] = g.p.set.at[0].width;
    g.head[layout.SHOWN_AT::usize] = plane.shown_width(?g.p.set);
    rule.pack(r, ?g.head[layout.SHARED]);
}

# plan a step of the generation going over the list from entry lo: n entries,
# or to its end when tail. the step serial is the one past the last completed,
# reading the front
fun plan_step(g: *Gpu, lo: usize, n: usize, tail: bool) {
    val op: *Op = ?g.ops[g.nops];
    op.pass   = false;
    op.gather = false;
    op.free   = false;
    op.tail   = tail;
    op.src    = g.front;
    op.lo     = lo::u32;
    op.n      = n::u32;
    op.now    = g.serial + 1;
    g.nops    = g.nops + 1;
}

# plan a pass ahead of the next generation, over the front, leaving every live
# chunk a halo holding span cells of spread
fun plan_pass(g: *Gpu, free: bool, span: u32) {
    g.pass = g.pass + 1;
    if (g.pass == 0) { g.pass = 1; }
    val op: *Op = ?g.ops[g.nops];
    op.pass   = true;
    op.gather = false;
    op.free   = free;
    op.src    = g.front;
    op.now    = g.serial;
    op.id     = g.pass;
    op.gens   = (g.gens & 0xffffffff)::u32;
    op.span   = span;
    g.nops    = g.nops + 1;
    g.moved   = true;
}

# plan a gather of the active list ahead of the next generation, under rule r
fun plan_gather(g: *Gpu, r: *rule.Rule) {
    val op: *Op = ?g.ops[g.nops];
    op.pass   = false;
    op.gather = true;
    op.now    = g.serial + 1;
    op.bits   = 0;
    if (g.owns)         { op.bits = op.bits | layout.GATHER_GATED; }
    if (rule.rimmed(r)) { op.bits = op.bits | layout.GATHER_RIM; }
    g.nops = g.nops + 1;
}

# record a planned step: its serial and first entry into the head, then the
# dispatch, over the list's length from the arguments its gather left for a
# tail, else over its n entries
fun record_step(g: *Gpu, step: *gfx.Compute, bound: usize, tab: u32, op: *Op) err[gfx.Error] {
    val es: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.meta, layout.SERIAL_AT::usize * 4, (?op.now)::*u8, 4);
    if (sel es.err) { ret es; }
    val eb: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.meta, layout.BASE_AT::usize * 4, (?op.lo)::*u8, 4);
    if (sel eb.err) { ret eb; }
    # every layer's source and destination where its stage binds them
    # (cellar.layer binding), after a rule buffer it binds
    var bufs: [layer.LAYERS_MAX * 2 + 3]*gfx.StorageBuffer;
    bufs[2]                           = ?g.p.meta;
    bufs[3]                           = ?g.p.flags;
    bufs[layout.TABLE_BINDING::usize] = ?g.table;
    var k: usize = 0;
    for (k < g.p.set.n) {
        val at: usize = layer.binding(k::u32, tab)::usize;
        bufs[at]     = cells_of(?g.p, k, op.src);
        bufs[at + 1] = cells_of(?g.p, k, 1 - op.src);
        k            = k + 1;
    }
    if (op.tail) { ret gfx.renderer_dispatch_indirect(g.r, step, ?bufs[0], bound, ?g.p.flags, layout.FLAGS_ARGS::usize * 4); }
    ret gfx.renderer_dispatch(g.r, step, ?bufs[0], bound, 8, op.n, 1);
}

# record a planned gather: the list emptied and its header bits set, the meta
# serial the next step's, then a slot an invocation below the top
fun record_gather(g: *Gpu, op: *Op) err[gfx.Error] {
    var args: [4]u32;
    args[0] = 8;
    args[1] = 0;
    args[2] = 1;
    args[3] = op.bits;
    val ea: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.flags, layout.FLAGS_ARGS::usize * 4, (?args[0])::*u8, 16);
    if (sel ea.err) { ret ea; }
    val es: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.meta, layout.SERIAL_AT::usize * 4, (?op.now)::*u8, 4);
    if (sel es.err) { ret es; }
    var bufs: [3]*gfx.StorageBuffer;
    bufs[0] = ?g.p.meta;
    bufs[1] = ?g.p.flags;
    bufs[2] = ?g.p.status;
    var groups: u32 = ((g.hi + 63) / 64)::u32;
    if (groups == 0) { groups = 1; }
    ret gfx.renderer_dispatch(g.r, ?g.gather, ?bufs[0], 3, groups, 1, 1);
}

# record a planned pass: its header into the status head, then the mark, the
# free in the frame's first, the settle and the clear (cellar.layout.Status)
fun record_pass(g: *Gpu, op: *Op) err[gfx.Error] {
    var h: [17]u32;
    mem.zero[u32](?h[0], 17);
    h[0]  = g.top::u32;
    h[1]  = g.p.cap::u32;
    h[3]  = 0;
    h[4]  = op.id;
    h[5]  = op.now;
    h[6]  = op.gens;
    h[8]  = op.span;
    h[11] = 0;
    h[12] = 1;
    h[13] = 1;
    # the clear of the state layer covers its span, 64 words a workgroup
    h[14] = (span_bytes(?g.p, 0) / 256)::u32;
    h[15] = 0;
    h[16] = 1;
    val eh: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.status, layout.CTL_TOP::usize * 4, (?h[0])::*u8, 17 * 4);
    if (sel eh.err) { ret eh; }
    var mb: [4]*gfx.StorageBuffer;
    mb[0] = cells_of(?g.p, 0, op.src);
    mb[1] = ?g.p.meta;
    mb[2] = ?g.p.status;
    mb[3] = ?g.p.flags;
    val em: err[gfx.Error] = gfx.renderer_dispatch(g.r, ?g.mark, ?mb[0], 4, 1, g.top::u32, 1);
    if (sel em.err) { ret em; }
    if (op.free) {
        var fb: [3]*gfx.StorageBuffer;
        fb[0] = ?g.p.meta;
        fb[1] = ?g.p.status;
        fb[2] = ?g.p.flags;
        val ef: err[gfx.Error] = gfx.renderer_dispatch(g.r, ?g.free, ?fb[0], 3, ((g.top + 63) / 64)::u32, 1, 1);
        if (sel ef.err) { ret ef; }
    }
    var sb: [3]*gfx.StorageBuffer;
    sb[0] = ?g.p.meta;
    sb[1] = ?g.p.status;
    sb[2] = ?g.p.list;
    val es: err[gfx.Error] = gfx.renderer_dispatch_indirect(g.r, ?g.settle, ?sb[0], 3, ?g.p.status, layout.ARGS_SETTLE::usize * 4);
    if (sel es.err) { ret es; }
    # a clear a layer, the arguments' workgroups along x covering its span
    var k: usize = 0;
    for (k < g.p.set.n) {
        if (k != 0) {
            val x:  u32            = (span_bytes(?g.p, k) / 256)::u32;
            val ex: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.status, layout.ARGS_CLEAR::usize * 4, (?x)::*u8, 4);
            if (sel ex.err) { ret ex; }
        }
        var zb: [4]*gfx.StorageBuffer;
        zb[0] = cells_of(?g.p, k, 0);
        zb[1] = cells_of(?g.p, k, 1);
        zb[2] = ?g.p.list;
        zb[3] = ?g.p.flags;
        val ez: err[gfx.Error] = gfx.renderer_dispatch_indirect(g.r, ?g.clear, ?zb[0], 4, ?g.p.status, layout.ARGS_CLEAR::usize * 4);
        if (sel ez.err) { ret ez; }
        k = k + 1;
    }
    ret err[gfx.Error].ok{};
}

# record the frame's planned dispatches: the gate stage first while the GPU
# owns the pool, which empties the list while the gate is closed, then each in
# turn
fun record_ops(g: *Gpu, step: *gfx.Compute, bound: usize, tab: u32) err[gfx.Error] {
    if (g.nops == 0) { ret err[gfx.Error].ok{}; }
    if (g.owns) {
        var gb: [2]*gfx.StorageBuffer;
        gb[0] = ?g.p.status;
        gb[1] = ?g.p.flags;
        val eg: err[gfx.Error] = gfx.renderer_dispatch(g.r, ?g.gate, ?gb[0], 2, 1, 1, 1);
        if (sel eg.err) { ret eg; }
    }
    var k: usize = 0;
    for (k < g.nops) {
        val op: *Op = ?g.ops[k];
        if (op.pass) {
            val ep: err[gfx.Error] = record_pass(g, op);
            if (sel ep.err) { ret ep; }
        }
        or (op.gather) {
            val eg: err[gfx.Error] = record_gather(g, op);
            if (sel eg.err) { ret eg; }
        }
        or {
            val es: err[gfx.Error] = record_step(g, step, bound, tab, op);
            if (sel es.err) { ret es; }
        }
        k = k + 1;
    }
    g.nops = 0;
    ret err[gfx.Error].ok{};
}

# record the frame's planned dispatches, timed by the frame's turn of the
# clocks when it steps any slots, for what a slot costs (measure)
fun timed_ops(g: *Gpu, step: *gfx.Compute, bound: usize, tab: u32) err[gfx.Error] {
    if (!g.clocked) { ret record_ops(g, step, bound, tab); }
    val c: usize = g.turn;
    g.turn    = (c + 1) % TIMERS;
    g.paid[c] = 0;
    if (g.worked == 0) { ret record_ops(g, step, bound, tab); }
    val eb: err[gfx.Error] = gfx.renderer_timer_begin(g.r, ?g.clocks[c]);
    if (sel eb.err) { ret eb; }
    val eo: err[gfx.Error] = record_ops(g, step, bound, tab);
    if (sel eo.err) { ret eo; }
    val ee: err[gfx.Error] = gfx.renderer_timer_end(g.r, ?g.clocks[c]);
    if (sel ee.err) { ret ee; }
    g.paid[c] = g.worked;
    ret err[gfx.Error].ok{};
}

# record a frame's work: bring the pool level, step, count, and set the view
#
# call once a frame between renderer_begin_frame and the first pass, after
# collect and after anything that reads the GPU's cells with a stall.
# ---
# g:     the GPU side
# sp:    the host's pool
# r:     the rule
# gen:   the generation the cells hold as the frame begins
# steps: generations wanted; fewer are completed when the budget, the
#        dispatches or the span is short, and the last may be left part way
#        for the next frame
# look:  the camera and colours for the draw
# ret:   the generations completed, or why recording failed
pub fun frame(g: *Gpu, sp: *space.Space, r: *rule.Rule, gen: u64, steps: usize, look: *Look) res[usize, gfx.Error] {
    g.sets = 0;
    val e14: err[gfx.Error] = flush(g, sp, false, g.stepping && !topology.bounded(?sp.grid));
    if (sel e14.err) { ret res[usize, gfx.Error].err{e14.err}; }
    val ei: err[gfx.Error] = sync_ink(g, r, look);
    if (sel ei.err) { ret res[usize, gfx.Error].err{ei.err}; }
    val e15: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.view, 0, look::*u8, LOOK * 4);
    if (sel e15.err) { ret res[usize, gfx.Error].err{e15.err}; }
    if (g.stepping) {
        g.id  = g.id + 1;
        g.seq = g.seq + 1;
        if (g.id == 0) { g.id = 1; }
    }
    # the draw reads the rule's sense from the head, whichever engine steps
    write_head(g, r, gen);
    val e17: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.meta, 0, (?g.head[0])::*u8, HEAD * 4);
    if (sel e17.err) { ret res[usize, gfx.Error].err{e17.err}; }
    if (!g.stepping) {
        val e16: err[gfx.Error] = upload_view(g, sp, look);
        if (sel e16.err) { ret res[usize, gfx.Error].err{e16.err}; }
        ret res[usize, gfx.Error].ok{0};
    }

    follow(g);
    val radius: usize = rule.radius(r);
    val fam:    usize = rule.family_of(r);
    # an edit or another rule since the generation in flight began leaves the
    # ranges it finished stale
    if (g.going && (g.edits != g.began || !rule.same(r, ?g.rule))) {
        g.going   = false;
        g.counted = false;
    }
    val step: *gfx.Compute = ?g.steps[fam];
    var tab:  u32          = 0;
    if (rule.table(fam)) { tab = 1; }
    # the stage binds every layer of the pool (cellar.layer binding)
    val bound: usize = layer.bindings(g.p.set.n::u32, tab)::usize;
    # the list holds no more than the slots below the top, and what the newest
    # census found it held is what a generation is expected to step
    var est: usize = g.est;
    if (est > g.hi) { est = g.hi; }
    var room: usize = g.span;
    if (g.parts != 0) { room = est / g.parts + 1; }
    var calls: usize = 0;
    var first: bool  = true;
    var n:     usize = 0;
    # the dispatches the generations may record, less what the flush took
    var most: usize = 0;
    if (g.sets < MAX_STEPS) { most = MAX_STEPS - g.sets; }
    g.cut     = false;
    g.limited = false;
    g.worked  = 0;
    g.nops    = 0;
    for (n < steps) {
        if (!g.going) {
            # a family the device could not build a stage for is refused before
            # it runs (cellar.sim), so it is never asked to step here
            if (!g.ready[fam]) { brk; }
            if (!g.owns && budget(g, radius) == 0) {
                g.cut = true;
                brk;
            }
            # no live cell reaches a chunk the last pass left out within the
            # spread its halo holds, whatever the radius of the rules on the
            # way, and a pass leaves the ring of the rule about to step, which
            # holds a generation of it
            val pass: bool = g.owns && g.grouped + radius > g.passed;
            # a list holds what the generations within its spread may change,
            # under the rule it was gathered for, and a pass reshapes the pool
            if (g.listed && !rule.same(r, ?g.rule)) { g.listed = false; }
            val gather: bool  = pass || !g.listed || g.gathered + radius > layout.LIST_SPREAD::usize;
            var cost:   usize = 0;
            if (pass) {
                cost = PASS_CALLS + g.p.set.n;
                if (first) { cost = cost + 1; }
            }
            if (gather) { cost = cost + 1; }
            if (calls + cost >= most) {
                g.limited = true;
                brk;
            }
            if (pass) {
                plan_pass(g, first, space.ring(radius));
                first     = false;
                g.grouped = 0;
                g.passed  = space.ring(radius)::usize;
            }
            if (gather) {
                plan_gather(g, r);
                g.listed   = true;
                g.gathered = 0;
            }
            calls = calls + cost;
            if (g.hi != 0 && rule.table(fam)) {
                val et: err[gfx.Error] = sync_table(g, r);
                if (sel et.err) { ret res[usize, gfx.Error].err{et.err}; }
            }
            g.going = true;
            g.at    = 0;
            g.began = g.edits;
            g.rule  = @r;
        }
        if (g.at < g.hi) {
            # the entries past the list's end find no slot and leave, so the
            # span is spent on what the list is expected to hold, and a step
            # the span does not cut covers the list to its end, however long
            var left: usize = 0;
            if (g.at < est) { left = est - g.at; }
            if ((room == 0 && left != 0) || calls >= most) {
                g.limited = true;
                brk;
            }
            var run:  usize = g.hi - g.at;
            var paid: usize = left;
            if (left > room) {
                run  = room;
                paid = room;
            }
            plan_step(g, g.at, run, g.at + run == g.hi);
            g.at     = g.at + run;
            g.worked = g.worked + paid;
            room     = room - paid;
            calls    = calls + 1;
            if (g.at < g.hi) {
                g.limited = true;
                brk;
            }
        }
        # the generation is complete, and the back cells become the world
        if (g.at != 0) {
            g.serial = g.serial + 1;
            g.front  = 1 - g.front;
        }
        g.going    = false;
        g.counted  = false;
        g.spread   = g.spread + radius::u64;
        g.gens     = g.gens + 1;
        g.grouped  = g.grouped + radius;
        g.gathered = g.gathered + radius;
        n          = n + 1;
    }
    g.stepped = n::u64 * radius::u64;
    val eo: err[gfx.Error] = timed_ops(g, step, bound, tab);
    if (sel eo.err) { ret res[usize, gfx.Error].err{eo.err}; }
    if (g.going) {
        # the census, the reduction and the draw read the completed generation
        val ec: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.p.meta, layout.SERIAL_AT::usize * 4, (?g.serial)::*u8, 4);
        if (sel ec.err) { ret res[usize, gfx.Error].err{ec.err}; }
    }

    # a narrower halo, the ring after the wide one or the ring of a rule
    # reaching less, frees chunks the budget may already have spread into, so
    # the budget drops to what it holds from this census on, and stays there
    # until a census recorded from now on has settled. while the GPU owns the
    # pool the halo is always the ring its passes keep
    if (g.owns) { g.want = false; }
    g.wide  = g.want;
    sp.wide = g.wide;
    val halo: u32 = space.span(sp);
    if (halo < g.halo) {
        g.hold = g.spread + halo::u64;
        g.held = g.seq;
        if (g.limit > g.hold) { g.limit = g.hold; }
    }
    g.halo = halo;

    # while a generation is part way through, the front is counted and reduced
    # again only once it changed
    if (g.going && g.counted) { ret res[usize, gfx.Error].ok{n}; }
    g.counted = true;
    if (g.hi != 0) {
        var rb: [5]*gfx.StorageBuffer;
        rb[0] = cells_of(?g.p, 0, g.front);
        rb[1] = ?g.p.meta;
        rb[2] = ?g.p.flags;
        rb[3] = ?g.p.mip;
        rb[4] = shown_cells(?g.p, g.front);
        val er: err[gfx.Error] = gfx.renderer_dispatch(g.r, ?g.reduce, ?rb[0], 5, 1, g.hi::u32, 1);
        if (sel er.err) { ret res[usize, gfx.Error].err{er.err}; }
    }

    # a workgroup a slot, and one even with none, to write the census id
    var groups: u32 = g.hi::u32;
    if (groups == 0) { groups = 1; }
    var cb: [5]*gfx.StorageBuffer;
    cb[0] = cells_of(?g.p, 0, g.front);
    cb[1] = ?g.p.meta;
    cb[2] = ?g.p.status;
    cb[3] = ?g.p.flags;
    cb[4] = shown_cells(?g.p, g.front);
    val e19: err[gfx.Error] = gfx.renderer_dispatch(g.r, ?g.census, ?cb[0], 5, 1, groups, 1);
    if (sel e19.err) { ret res[usize, gfx.Error].err{e19.err}; }
    val e20: err[gfx.Error] = gfx.renderer_readback(g.r, ?g.p.rb, ?g.p.status, 0);
    if (sel e20.err) { ret res[usize, gfx.Error].err{e20.err}; }
    val snap: *Snap = ?g.ring[g.id::usize % RING];
    snap.id     = g.id;
    snap.spread = g.spread;
    snap.seq    = g.seq;
    snap.gens   = g.gens;
    snap.bulk   = g.bulk;
    snap.edits  = g.edits;
    snap.cap    = g.p.cap;
    snap.hi     = g.hi;
    snap.span   = g.halo;
    snap.owned  = g.owns;
    ret res[usize, gfx.Error].ok{n};
}

# ready a draw of a pool the host filled with what is to be seen, stepping nothing
#
# for a world held outside the pool: its chunks marked DIRTY_CELLS are
# uploaded whole, whether or not the GPU could step. call where frame would be.
# ---
# g:    the GPU side
# sp:   the pool, holding what is drawn
# r:    the rule, whose sense the draw reads
# gen:  the world's generation, whose phase the draw reads
# look: the camera and colours
# ret:  ok, or why the upload failed
pub fun show(g: *Gpu, sp: *space.Space, r: *rule.Rule, gen: u64, look: *Look) err[gfx.Error] {
    val ef: err[gfx.Error] = flush(g, sp, true, false);
    if (sel ef.err) { ret ef; }
    val ei: err[gfx.Error] = sync_ink(g, r, look);
    if (sel ei.err) { ret ei; }
    val ev: err[gfx.Error] = gfx.renderer_buffer_update(g.r, ?g.view, 0, look::*u8, LOOK * 4);
    if (sel ev.err) { ret ev; }
    write_head(g, r, gen);
    ret gfx.renderer_buffer_update(g.r, ?g.p.meta, 0, (?g.head[0])::*u8, HEAD * 4);
}

# move the camera of the draw alone, over the cells already on the GPU, for a
# frame that cannot reach the world's to send any
# ---
# g:    the GPU side
# look: the camera and colours
# ret:  ok, or why the upload failed
pub fun aim(g: *Gpu, look: *Look) err[gfx.Error] {
    ret gfx.renderer_buffer_update(g.r, ?g.view, 0, look::*u8, LOOK * 4);
}

# draw every chunk into an open pass
pub fun draw(g: *Gpu, p: *gfx.Pass) {
    if (g.hi == 0) { ret; }
    var bufs: [5]*gfx.StorageBuffer;
    bufs[0] = cells_of(?g.p, 0, g.front);
    bufs[1] = ?g.p.meta;
    bufs[2] = ?g.view;
    bufs[3] = ?g.p.mip;
    bufs[4] = shown_cells(?g.p, g.front);
    gfx.pass_draw_storage(p, ?bufs[0], 5, 6, g.hi::u32, ?g.mat, ?g.xf, ?g.draw);
}

test pace_for__follows_the_refresh_interval_and_falls_back_to_sixty {
    val slow: Pace = pace_for(30.0);
    if (slow.interval_us != 33333 || slow.quick_us != 35999) { ret 1; }
    val base: Pace = pace_for(60.0);
    if (base.interval_us != 16667 || base.quick_us != 18000) { ret 2; }
    val fast: Pace = pace_for(144.0);
    if (fast.interval_us != 6944 || fast.quick_us != 7499) { ret 3; }
    val none: Pace = pace_for(0.0);
    if (none.interval_us != base.interval_us || none.quick_us != base.quick_us) { ret 4; }
    ret 0;
}

test fit_span__steps_what_the_budget_holds_at_the_cost {
    # 8 ms at 50 ns a slot
    if (fit_span(8000000, 50000) != 160000)  { ret 1; }
    if (fit_span(8000000, 0) != MAX_SPAN)    { ret 2; }
    if (fit_span(1000, 50000) != MIN_SPAN)   { ret 3; }
    if (fit_span(0xffffffff, 1) != MAX_SPAN) { ret 4; }
    ret 0;
}

test smooth__follows_a_dearer_cost_fast_and_a_cheaper_one_slowly {
    if (smooth(0, 700) != 700) { ret 1; }
    # half of a rise at once, a sixteenth of a fall
    if (smooth(1000, 3000) != 2000) { ret 2; }
    if (smooth(1600, 0) != 1500)    { ret 3; }
    # a single frame over the cost moves it, however little over
    if (smooth(1000, 1001) != 1001) { ret 4; }
    if (smooth(1000, 1000) != 1000) { ret 5; }
    ret 0;
}

test cut_span__is_in_proportion_to_any_overrun {
    # a frame of twice the interval halves what it stepped
    if (cut_span(10000, 33334, 16667) != 5000) { ret 1; }
    # a frame barely over is cut barely
    if (cut_span(10000, 18334, 16667) != 9090)   { ret 2; }
    if (cut_span(10000, 16000, 16667) != 10000)  { ret 3; }
    if (cut_span(100, 33334, 16667) != MIN_SPAN) { ret 4; }
    ret 0;
}

test timers__outnumber_the_frames_in_flight {
    if (TIMERS != gfx.MAX_FRAMES_IN_FLIGHT + 1) { ret 1; }
    ret 0;
}

test max_steps__fills_the_frames_storage_binding_sets {
    if (MAX_STEPS + FRAME_SETS != gfx.MAX_STORAGE_SETS) { ret 1; }
    ret 0;
}

test ceiling__is_the_cells_share_of_the_storage_range {
    var l: gfx.Limits;
    mem.zero[u8]((?l)::*u8, $size_of(gfx.Limits));
    if (ceiling(l) != 0) { ret 1; }
    # the 128 MiB every device guarantees holds 8192 chunks of 16 KiB
    l.max_storage_buffer_range = 134217728;
    if (ceiling(l) != 8192) { ret 2; }
    l.max_storage_buffer_range = 100 * 1048576;
    if (ceiling(l) != 6400) { ret 3; }
    # past what the stages' arrays are declared for, those cap it
    l.max_storage_buffer_range = 4294967295;
    if (ceiling(l) != layout.MAX_SLOTS::usize) { ret 4; }
    ret 0;
}
