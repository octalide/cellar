# the world-controls window
#
# run state, speed, randomize and its area, color mode and grid lines. it both
# displays and drives the simulation.

use bc: blit.context;
use bd: blit.draw;
use bw: blit.widget;
use cellar.app;
use cellar.sim;
use cellar.text;
use std.types.size.usize;
use std.types.string.str;

# the lowercase ascii hex digit for a nibble in [0, 15]
fun hex_digit(n: u8) u8 {
    if (n < 10) { ret '0' + n; }
    ret 'a' + (n - 10);
}

# write the two hex digits of v into buf at off; ret the new offset
fun hex_byte(buf: *u8, off: usize, v: u8) usize {
    buf[off]     = hex_digit(v / 16);
    buf[off + 1] = hex_digit(v % 16);
    ret off + 2;
}

# RGB sliders, a #rrggbb readout, and a swatch for the solid color
fun color_picker(ctx: *bc.Context, a: *app.App) {
    bw.slider_f(ctx, "R", ?a.solid_r, 0.0, 1.0);
    bw.slider_f(ctx, "G", ?a.solid_g, 0.0, 1.0);
    bw.slider_f(ctx, "B", ?a.solid_b, 0.0, 1.0);

    var hx: [10]u8;
    var o:  usize = text.buf_str(?hx[0], 0, "#");
    o     = hex_byte(?hx[0], o, (a.solid_r * 255.0)::u8);
    o     = hex_byte(?hx[0], o, (a.solid_g * 255.0)::u8);
    o     = hex_byte(?hx[0], o, (a.solid_b * 255.0)::u8);
    hx[o] = 0;
    bw.text(ctx, ?hx[0]);

    val sy: f32 = ctx.cy;
    bc.quad(ctx, ctx.cx, sy, ctx.cx + ctx.pw, sy + 12.0, bd.rgba(a.solid_r, a.solid_g, a.solid_b, 1.0));
    ctx.cy = sy + 16.0;
    ctx.cx = ctx.ox;
}

# lay out the world window and apply its controls to the simulation
# ---
# ctx: blit context for this frame
# a:   application state
# s:   simulation the controls drive
pub fun draw(ctx: *bc.Context, a: *app.App, s: *sim.Sim) {
    val handle: bw.Block = bw.begin_window(ctx, ?a.world);

    if (a.world.open != 0) {
        # the generation and the active rule, so a run can be read at a glance
        var gl: [96]u8;
        var go: usize = text.buf_str(?gl[0], 0, "gen ");
        go     = text.buf_u64(?gl[0], go, s.generation);
        go     = text.buf_str(?gl[0], go, "  ");
        go     = text.buf_str(?gl[0], go, s.kernel.name);
        gl[go] = 0;
        bw.text(ctx, ?gl[0]);

        var play: str = "play";
        if (s.running != 0)         { play = "pause"; }
        if (bw.button(ctx, play))   { sim.toggle_running(s); }
        if (bw.button(ctx, "step")) { sim.step(s); }

        var sl: [24]u8;
        var so: usize = text.buf_str(?sl[0], 0, "speed ");
        so     = text.buf_u64(?sl[0], so, a.speed::u64);
        so     = text.buf_str(?sl[0], so, "/s");
        sl[so] = 0;
        bw.slider_f(ctx, ?sl[0], ?a.speed, 1.0, 120.0);
        bw.checkbox(ctx, "uncapped", ?a.uncapped);

        if (bw.button(ctx, "clear"))     { sim.clear(s); }
        if (bw.button(ctx, "randomize")) { sim.randomize(s, sim.DEFAULT_DENSITY, app.bounds_size(a.bounds_idx)); }

        bw.checkbox(ctx, "erase", ?a.erase);
        bw.checkbox(ctx, "grid lines", ?a.gutter);

        var modes: [3]str;
        modes[0] = "color solid";
        modes[1] = "color heat";
        modes[2] = "color age";
        bw.dropdown(ctx, "", ?a.mode, ?modes[0], app.MODE_COUNT);
        # mode 0 is render.MODE_SOLID: expose its color
        if (a.mode == 0) { color_picker(ctx, a); }

        # the square randomize seeds; the world itself has no edge
        var sizes: [8]str;
        sizes[0] = "area 32";
        sizes[1] = "area 64";
        sizes[2] = "area 128";
        sizes[3] = "area 256";
        sizes[4] = "area 512";
        sizes[5] = "area 1024";
        sizes[6] = "area 2048";
        sizes[7] = "area 4096";
        bw.dropdown(ctx, "", ?a.bounds_idx, ?sizes[0], app.BOUNDS_COUNT);
    }

    bw.end_window(ctx, ?a.world, handle);
}
