# small byte-buffer text helpers shared by the windows and the file formats
#
# labels and file bodies are built into caller-owned buffers, so formatting a
# number never allocates.

use std.format;
use std.io.writer;
use std.io.writer.WriteError;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# where buf_f64's writer puts its bytes
rec Into {
    buf: *u8;
    off: usize;
}

# copy a NUL-terminated string into buf at off
# ---
# buf: destination buffer
# off: write offset
# s:   NUL-terminated source string
# ret: offset just past the copied bytes
pub fun buf_str(buf: *u8, off: usize, s: str) usize {
    var i: usize = 0;
    var o: usize = off;
    for (s[i] != 0) {
        buf[o] = s[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# write a decimal integer into buf at off
# ---
# buf: destination buffer
# off: write offset
# v:   value to format
# ret: offset just past the digits
pub fun buf_u64(buf: *u8, off: usize, v: u64) usize {
    if (v == 0) {
        buf[off] = '0';
        ret off + 1;
    }
    var tmp: [20]u8;
    var n:   usize = 0;
    var x:   u64   = v;
    for (x > 0) {
        tmp[n] = '0' + (x % 10)::u8;
        x      = x / 10;
        n      = n + 1;
    }
    var o: usize = off;
    for (n > 0) {
        n      = n - 1;
        buf[o] = tmp[n];
        o      = o + 1;
    }
    ret o;
}

# write a decimal integer into buf at off with a comma between each three digits
# ---
# buf: destination buffer, with 26 bytes free past off
# off: write offset
# v:   value to format
# ret: offset just past the digits
pub fun buf_grouped(buf: *u8, off: usize, v: u64) usize {
    var digits: [24]u8;
    val n:      usize = buf_u64(?digits[0], 0, v);
    var o:      usize = off;
    var i:      usize = 0;
    for (i < n) {
        if (i > 0 && (n - i) % 3 == 0) {
            buf[o] = ',';
            o      = o + 1;
        }
        buf[o] = digits[i];
        o      = o + 1;
        i      = i + 1;
    }
    ret o;
}

# write a signed decimal integer into buf at off, with a leading minus when negative
# ---
# buf: destination buffer
# off: write offset
# v:   value to format
# ret: offset just past the digits
pub fun buf_i64(buf: *u8, off: usize, v: i64) usize {
    if (v < 0) {
        buf[off] = '-';
        ret buf_u64(buf, off + 1, (0 - v)::u64);
    }
    ret buf_u64(buf, off, v::u64);
}

# a decimal fraction's units: buf_decimal and read_decimal keep a value to the
# ninth place, in units of 10^-9
pub val DECIMAL: u64 = 1000000000;

# write a value in units of 10^-9 as a decimal, its trailing zeros dropped
# ---
# buf: destination buffer
# off: write offset
# v:   value to format, in units of 10^-9
# ret: offset just past the text
pub fun buf_decimal(buf: *u8, off: usize, v: u64) usize {
    var o: usize = buf_u64(buf, off, v / DECIMAL);
    var f: u64   = v % DECIMAL;
    if (f == 0) { ret o; }
    buf[o] = '.';
    o      = o + 1;
    var scale: u64 = DECIMAL / 10;
    for (f != 0) {
        buf[o] = '0' + (f / scale)::u8;
        o      = o + 1;
        f      = f % scale;
        scale  = scale / 10;
    }
    ret o;
}

# read a whole number at s[@i], moving @i past it
# ---
# s:   NUL-terminated text
# i:   the offset to read from
# max: the largest value taken
# out: receives the value
# ret: false when no digit is at @i or the value passes max
pub fun read_u64(s: str, i: *usize, max: u64, out: *u64) bool {
    if (s[@i] < '0' || s[@i] > '9') { ret false; }
    var v: u64 = 0;
    for (s[@i] >= '0' && s[@i] <= '9') {
        v  = v * 10 + (s[@i] - '0')::u64;
        @i = @i + 1;
        if (v > max) { ret false; }
    }
    @out = v;
    ret true;
}

# read a decimal at s[@i] to the ninth place, moving @i past it
# ---
# s:   NUL-terminated text
# i:   the offset to read from
# max: the largest value taken, in units of 10^-9
# out: receives the value, in units of 10^-9
# ret: false when no decimal is at @i, it has more than nine places or it
#      passes max
pub fun read_decimal(s: str, i: *usize, max: u64, out: *u64) bool {
    var whole: u64  = 0;
    var any:   bool = false;
    if (s[@i] >= '0' && s[@i] <= '9') {
        if (!read_u64(s, i, max / DECIMAL, ?whole)) { ret false; }
        any = true;
    }
    var frac:  u64 = 0;
    var scale: u64 = DECIMAL;
    if (s[@i] == '.') {
        @i = @i + 1;
        for (s[@i] >= '0' && s[@i] <= '9') {
            if (scale == 1) { ret false; }
            scale = scale / 10;
            frac  = frac + (s[@i] - '0')::u64 * scale;
            @i    = @i + 1;
            any   = true;
        }
    }
    if (!any) { ret false; }
    val v: u64 = whole * DECIMAL + frac;
    if (v > max) { ret false; }
    @out = v;
    ret true;
}

# append the bytes a writer is handed to an Into
fun into_write(ctx: ptr, p: *u8, len: usize) res[usize, WriteError] {
    val t: *Into = ctx::*Into;
    var i: usize = 0;
    for (i < len) {
        t.buf[t.off] = p[i];
        t.off        = t.off + 1;
        i            = i + 1;
    }
    ret res[usize, WriteError].ok{len};
}

# write a float into buf at off as the shortest decimal that reads back exactly
# ---
# buf: destination buffer, with at least 48 bytes free past off
# off: write offset
# v:   value to format
# ret: offset just past the text
pub fun buf_f64(buf: *u8, off: usize, v: f64) usize {
    var t: Into = Into{buf: buf, off: off};
    var w: writer.Writer;
    w.ctx     = (?t)::ptr;
    w.f_write = into_write;
    format.write_f64(?w, v);
    ret t.off;
}

# the byte at i of a len-byte buffer, or 0 past its end
#
# lets a parser walk file contents by their real length while still reading a
# zero where the text runs out, whatever bytes the file itself holds.
# ---
# s:   the buffer
# len: its length in bytes
# i:   the offset to read
# ret: the byte, or 0 when i is at or past len
pub fun byte_at(s: *u8, len: usize, i: usize) u8 {
    if (i >= len) { ret 0; }
    ret s[i];
}

test buf_u64__formats_zero_and_multi_digit_values {
    var b: [24]u8;
    var o: usize = buf_u64(?b[0], 0, 0);
    if (o != 1 || b[0] != '0') { ret 1; }
    o = buf_u64(?b[0], 0, 4096);
    if (o != 4 || b[0] != '4' || b[3] != '6') { ret 2; }
    ret 0;
}

test buf_i64__formats_negative_values {
    var b: [24]u8;
    var o: usize = buf_i64(?b[0], 0, -30);
    if (o != 3 || b[0] != '-' || b[1] != '3' || b[2] != '0') { ret 1; }
    o = buf_i64(?b[0], 0, 7);
    if (o != 1 || b[0] != '7') { ret 2; }
    ret 0;
}
