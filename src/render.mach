# the world view: a camera mapping cells to pixels, and the grid painter
#
# the camera also answers the inverse, the cell under a cursor, for the editor.
# all geometry is emitted through blit as pixel-space quads, so the cell grid and
# the control windows share one vertex stream, one pipeline, and one texture. cells
# default to solid fills; a color mode picks how each cell is tinted (flat live
# color, a fading heat trail, or an age-driven sin palette).

use bc: blit.context;
use bd: blit.draw;
use cellar.grid;
use cellar.sim;
use std.types.size.usize;

# minimum gap in pixels between the fitted grid and the window edge
val MARGIN: f32 = 16.0;

# constants for the sin approximation driving the age palette
val PI:  f32 = 3.1415927;
val TAU: f32 = 6.2831855;

# live cells in a flat color, dead cells unpainted
pub val MODE_SOLID: u8 = 0;
# every cell with nonzero heat tinted through a fire palette, so trails fade
pub val MODE_HEAT: u8 = 1;
# live cells colored by a sin-wave palette over age
pub val MODE_AGE_SIN: u8 = 2;

# places the grid as a square of `cell`-pixel cells with its top-left
# corner at (ox, oy) in screen space.
# ---
# cell: side length of one cell in pixels
# ox:   screen x of the grid's left edge
# oy:   screen y of the grid's top edge
pub rec Camera {
    cell: f32;
    ox:   f32;
    oy:   f32;
}

# absolute value of an f32
# ---
# v:   value
# ret: |v|
fun fabs(v: f32) f32 {
    if (v < 0.0) { ret 0.0 - v; }
    ret v;
}

# clamp an f32 into [0, 1]
# ---
# v:   value
# ret: v clamped to [0, 1]
fun clamp01(v: f32) f32 {
    if (v < 0.0) { ret 0.0; }
    if (v > 1.0) { ret 1.0; }
    ret v;
}

# low-precision sine via the classic parabolic approximation
# defined for non-negative radians; the age palette only ever feeds it x >= 0.
# ---
# x:   angle in radians, x >= 0
# ret: an approximation of sin(x) in [-1, 1]
fun sin_approx(x: f32) f32 {
    # range-reduce into [0, TAU) without a loop, then shift to [-PI, PI)
    val k: f32 = (x / TAU)::i64::f32;
    var t: f32 = x - k * TAU;
    if (t > PI) { t = t - TAU; }
    # y = (4/PI) t - (4/PI^2) t|t|
    ret 1.2732395 * t - 0.40528473 * t * fabs(t);
}

# map a heat value to a black-red-orange-yellow-white fire ramp
# ---
# heat: trail value in [1, 255]
# ret:  the fill color
fun heat_color(heat: u8) bd.Color {
    val t: f32 = heat::f32 / 255.0;
    val r: f32 = clamp01(t * 3.0);
    val g: f32 = clamp01(t * 3.0 - 1.0);
    val b: f32 = clamp01(t * 3.0 - 2.0);
    ret bd.rgba(r, g, b, 1.0);
}

# map a cell age to a smoothly cycling sin-wave palette
# ---
# age: generations the cell has been continuously alive
# ret: the fill color
fun age_color(age: u32) bd.Color {
    val p: f32 = age::f32 * 0.15;
    val r: f32 = 0.5 + 0.5 * sin_approx(p);
    val g: f32 = 0.5 + 0.5 * sin_approx(p + 2.094395);
    val b: f32 = 0.5 + 0.5 * sin_approx(p + 4.188790);
    ret bd.rgba(r, g, b, 1.0);
}

# a camera that scales the grid to fill the window (minus a margin),
# centers it, then applies the user's zoom and pan.
# ---
# g:     the grid being viewed
# sw:    window width in pixels
# sh:    window height in pixels
# zoom:  user zoom multiplier (1.0 = fit)
# pan_x: horizontal pan offset in pixels
# pan_y: vertical pan offset in pixels
# ret:   the camera for this frame
pub fun fit(g: *grid.Grid, sw: f32, sh: f32, zoom: f32, pan_x: f32, pan_y: f32) Camera {
    val gw: f32 = g.w::f32;
    val gh: f32 = g.h::f32;

    var avail_w: f32 = sw - MARGIN * 2.0;
    var avail_h: f32 = sh - MARGIN * 2.0;
    if (avail_w < 1.0) { avail_w = 1.0; }
    if (avail_h < 1.0) { avail_h = 1.0; }

    var base: f32 = avail_w / gw;
    if (avail_h / gh < base) { base = avail_h / gh; }

    var cell: f32 = base * zoom;
    if (cell < 1.0) { cell = 1.0; }

    var cam: Camera;
    cam.cell = cell;
    cam.ox   = (sw - gw * cell) / 2.0 + pan_x;
    cam.oy   = (sh - gh * cell) / 2.0 + pan_y;
    ret cam;
}

# the grid cell under screen pixel (px, py). writes (cx, cy) and returns
# 1 when the pixel lands on a cell, else returns 0 and leaves the outputs alone.
# ---
# cam: the current camera
# g:   the grid being viewed
# px:  screen x in pixels
# py:  screen y in pixels
# cx:  receives the column of the hit cell
# cy:  receives the row of the hit cell
# ret: 1 if (px, py) is over a cell, else 0
pub fun cell_at(cam: Camera, g: *grid.Grid, px: f32, py: f32, cx: *usize, cy: *usize) u8 {
    if (cam.cell <= 0.0) { ret 0; }
    val fx: f32 = (px - cam.ox) / cam.cell;
    val fy: f32 = (py - cam.oy) / cam.cell;
    if (fx < 0.0) { ret 0; }
    if (fy < 0.0) { ret 0; }
    val ix: usize = fx::usize;
    val iy: usize = fy::usize;
    if (ix >= g.w) { ret 0; }
    if (iy >= g.h) { ret 0; }
    @cx = ix;
    @cy = iy;
    ret 1;
}

# paint the dead-field backdrop and the cells for this frame
#
# walks the grid's live list rather than every cell, rebuilding it first when an
# edit left it stale.
# ---
# ctx:    blit context accumulating the frame's geometry
# s:      simulation whose grid is drawn
# cam:    the camera mapping cells to pixels
# mode:   color mode (MODE_SOLID, MODE_HEAT, or MODE_AGE_SIN)
# gutter: 1 to leave a 1px gap between cells, 0 for solid fills
# sr:     solid-mode live-cell red in [0, 1]
# sg:     solid-mode live-cell green in [0, 1]
# sb:     solid-mode live-cell blue in [0, 1]
pub fun draw_grid(ctx: *bc.Context, s: *sim.Sim, cam: Camera, mode: u8, gutter: u8, sr: f32, sg: f32, sb: f32) {
    val g:  *grid.Grid = ?s.grid;
    val gw: f32        = g.w::f32;
    val gh: f32        = g.h::f32;

    val bg: bd.Color = bd.rgba(0.08, 0.09, 0.11, 1.0);
    bc.quad(ctx, cam.ox, cam.oy, cam.ox + gw * cam.cell, cam.oy + gh * cam.cell, bg);

    var gap: f32 = 0.0;
    if (gutter != 0) { gap = 1.0; }

    # only listed cells can be painted, so the walk scales with them, not the world
    if (g.stale) { grid.live_rebuild(g); }
    val live: bd.Color = bd.rgba(sr, sg, sb, 1.0);
    var k:    usize    = 0;
    for (k < g.count) {
        val i:     usize = g.live[k]::usize;
        var paint: u8    = 0;
        var col:   bd.Color;
        if (mode == MODE_HEAT) {
            if (g.heat[i] != 0) {
                paint = 1;
                col   = heat_color(g.heat[i]);
            }
        }
        or (g.cells[i] != 0) {
            paint = 1;
            col   = live;
            if (mode == MODE_AGE_SIN) { col = age_color(g.age[i]); }
        }
        if (paint != 0) {
            val x0: f32 = cam.ox + (i % g.w)::f32 * cam.cell;
            val y0: f32 = cam.oy + (i / g.w)::f32 * cam.cell;
            bc.quad(ctx, x0, y0, x0 + cam.cell - gap, y0 + cam.cell - gap, col);
        }
        k = k + 1;
    }
}
