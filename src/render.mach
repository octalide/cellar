# the world view: a camera over the unbounded plane, and the colours cells
# are drawn in
#
# the camera is a world point at the centre of the window and a zoom in pixels
# per cell, so panning and zooming never meet an edge, and it answers the
# inverse, the cell under a cursor, for the editor. cells are drawn by the GPU
# straight from the pool (cellar.gpu); this builds what that draw reads: the
# camera as the chunk the centre lies in plus an offset, so it stays exact far
# from the origin, and the palettes of the colour modes, converted once into
# the space the window stores.

use gfx: boom.graphics;
use cellar.gpu;
use cellar.space;
use std.types.bool.bool;
use std.types.size.usize;

# pixels per cell at zoom 1
pub val BASE_PPC: f32 = 7.0;

# live cells in a flat color, dead cells unpainted
pub val MODE_SOLID: u8 = 0;
# every cell with nonzero heat tinted through a fire palette, so trails fade
pub val MODE_HEAT: u8 = 1;
# live cells colored by a sin-wave palette over age
pub val MODE_AGE_SIN: u8 = 2;

# the backdrop dead cells and empty space show, as authored
val BACK_R: f32 = 0.08;
val BACK_G: f32 = 0.09;
val BACK_B: f32 = 0.11;

# constants for the sin approximation driving the age palette
val PI:  f32 = 3.1415927;
val TAU: f32 = 6.2831855;

# the view for one frame
# ---
# x:   world column at the window's centre, in cells
# y:   world row at the window's centre, in cells
# ppc: pixels per cell
# sw:  window width in pixels
# sh:  window height in pixels
pub rec Camera {
    x:   f64;
    y:   f64;
    ppc: f32;
    sw:  f32;
    sh:  f32;
}

# the camera the user's zoom and pan give
# ---
# zoom:  zoom multiplier, BASE_PPC pixels per cell at 1
# pan_x: world column at the window's centre
# pan_y: world row at the window's centre
# sw:    window width in pixels
# sh:    window height in pixels
# ret:   the camera for this frame
pub fun camera(zoom: f32, pan_x: f32, pan_y: f32, sw: f32, sh: f32) Camera {
    var cam: Camera;
    cam.x   = pan_x::f64;
    cam.y   = pan_y::f64;
    cam.ppc = BASE_PPC * zoom;
    cam.sw  = sw;
    cam.sh  = sh;
    ret cam;
}

fun floor64(v: f64) i64 {
    val t: i64 = v::i64;
    if (t::f64 > v) { ret t - 1; }
    ret t;
}

# the world cell under screen pixel (px, py)
# ---
# cam: the current camera
# px:  screen x in pixels
# py:  screen y in pixels
# cx:  receives the column
# cy:  receives the row
pub fun cell_at(cam: Camera, px: f32, py: f32, cx: *i64, cy: *i64) {
    @cx = floor64(cam.x + ((px - cam.sw / 2.0) / cam.ppc)::f64);
    @cy = floor64(cam.y + ((py - cam.sh / 2.0) / cam.ppc)::f64);
}

fun fabs(v: f32) f32 {
    if (v < 0.0) { ret 0.0 - v; }
    ret v;
}

fun clamp01(v: f32) f32 {
    if (v < 0.0) { ret 0.0; }
    if (v > 1.0) { ret 1.0; }
    ret v;
}

# low-precision sine via the classic parabolic approximation, for x >= 0
fun sin_approx(x: f32) f32 {
    val k: f32 = (x / TAU)::i64::f32;
    var t: f32 = x - k * TAU;
    if (t > PI) { t = t - TAU; }
    ret 1.2732395 * t - 0.40528473 * t * fabs(t);
}

# the fifth root of a in [0, 1], by Newton's method
fun root5(a: f32) f32 {
    if (a <= 0.0) { ret 0.0; }
    var y: f32   = 1.0;
    var i: usize = 0;
    for (i < 40) {
        val y4: f32 = y * y * y * y;
        y = y - (y4 * y - a) / (5.0 * y4);
        i = i + 1;
    }
    ret y;
}

# an sRGB-encoded channel as linear light
fun decode(c: f32) f32 {
    if (c <= 0.04045) { ret c / 12.92; }
    val x: f32 = (c + 0.055) / 1.055;
    # x^2.4 is x^2 times the fifth root of x^2
    ret x * x * root5(x * x);
}

fun put(out: *f32, r: f32, g: f32, b: f32, srgb: bool) {
    out[0] = r;
    out[1] = g;
    out[2] = b;
    out[3] = 1.0;
    if (srgb) {
        out[0] = decode(r);
        out[1] = decode(g);
        out[2] = decode(b);
    }
}

# the backdrop, in the space the window stores
# ---
# out:  four floats
# srgb: whether the window encodes sRGB, so colours must arrive linear
pub fun backdrop(out: *f32, srgb: bool) {
    put(out, BACK_R, BACK_G, BACK_B, srgb);
}

# the heat and age palettes, gpu.SHADES entries of four floats each
#
# heat runs black, red, orange, yellow to white over [0, 255]; age is a
# sin-wave palette over one period of 0.15 radians a generation.
# ---
# heat: receives the heat palette
# age:  receives the age palette
# srgb: whether the window encodes sRGB
pub fun palettes(heat: *f32, age: *f32, srgb: bool) {
    var i: usize = 0;
    for (i < gpu.SHADES) {
        val t: f32 = i::f32 / 255.0;
        put(?heat[i * 4], clamp01(t * 3.0), clamp01(t * 3.0 - 1.0), clamp01(t * 3.0 - 2.0), srgb);
        val p: f32 = i::f32 / gpu.SHADES::f32 * TAU;
        put(?age[i * 4], 0.5 + 0.5 * sin_approx(p), 0.5 + 0.5 * sin_approx(p + 2.094395),
            0.5 + 0.5 * sin_approx(p + 4.188790), srgb);
        i = i + 1;
    }
}

# what the draw reads this frame
# ---
# cam:    the camera
# mode:   colour mode, a MODE_*
# gutter: 1 to show grid lines
# sr:     solid-mode live-cell red in [0, 1]
# sg:     solid-mode live-cell green in [0, 1]
# sb:     solid-mode live-cell blue in [0, 1]
# srgb:   whether the window encodes sRGB
# ret:    the look
pub fun look(cam: Camera, mode: u8, gutter: u8, sr: f32, sg: f32, sb: f32, srgb: bool) gpu.Look {
    var l:  gpu.Look;
    val bx: i64 = floor64(cam.x / 64.0);
    val by: i64 = floor64(cam.y / 64.0);
    l.base_cx = (bx + space.BIAS)::u32;
    l.base_cy = (by + space.BIAS)::u32;
    l.mode    = mode::u32;
    l.gutter  = gutter::u32;
    l.frac_x  = (cam.x - (bx * 64)::f64)::f32;
    l.frac_y  = (cam.y - (by * 64)::f64)::f32;
    l.ppc     = cam.ppc;
    l.half_w  = cam.sw / 2.0;
    l.half_h  = cam.sh / 2.0;
    l.pad0    = 0;
    l.pad1    = 0;
    l.pad2    = 0;
    put(?l.solid[0], sr, sg, sb, srgb);
    backdrop(?l.back[0], srgb);
    ret l;
}

test cell_at__maps_pixels_to_signed_cells_either_side_of_the_origin {
    var cam: Camera;
    cam.x   = 0.0;
    cam.y   = 0.0;
    cam.ppc = 10.0;
    cam.sw  = 100.0;
    cam.sh  = 100.0;
    var cx: i64 = 0;
    var cy: i64 = 0;
    cell_at(cam, 51.0, 49.0, ?cx, ?cy);
    if (cx != 0 || cy != -1) { ret 1; }
    cell_at(cam, 5.0, 95.0, ?cx, ?cy);
    if (cx != -5 || cy != 4) { ret 2; }
    ret 0;
}

test decode__matches_the_srgb_curve {
    # 0.5 encoded is 0.2140 linear
    val v: f32 = decode(0.5);
    if (v < 0.2135 || v > 0.2145)                   { ret 1; }
    if (decode(1.0) < 0.999 || decode(1.0) > 1.001) { ret 2; }
    ret 0;
}
