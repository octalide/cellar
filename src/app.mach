# application state and the constants the control windows read
#
# the simulation owns the grid and kernel. this owns everything about how the
# user is currently viewing and editing them.

use bw: blit.widget;
use cellar.pattern;
use cellar.render;
use std.types.size.usize;
use std.types.string.str;

# number of color modes (kept in step with render.MODE_*)
pub val MODE_COUNT: usize = 3;
# number of selectable power-of-two randomize areas
pub val BOUNDS_COUNT: usize = 8;
# bounds-table index used at startup (128)
pub val DEFAULT_BOUNDS: usize = 2;

# all interactive state not owned by the simulation itself
# ---
# speed:       steps per second when not uncapped
# zoom:        camera zoom multiplier (1.0 = render.BASE_PPC pixels per cell)
# pan_x:       world column at the view's centre, in cells
# pan_y:       world row at the view's centre, in cells
# mode:        color mode index (render.MODE_*)
# gutter:      1 to draw 1px grid lines between cells
# uncapped:    1 to step as fast as the frame budget allows
# erase:       1 to paint dead cells, 0 to paint live cells
# bounds_idx:  index into the power-of-two randomize-area table
# ui_visible:  1 to show the windows, 0 to hide them behind the restore icon
# world:       the world-controls window
# kedit:       the kernel-editor window
# preset_sel:  kernel-preset dropdown selection
# arrange:     the arrangement (pattern/persistence) window
# pattern_sel: arrangement dropdown selection; BUILTIN_COUNT selects the custom pattern
# stamp_mode:  1 to stamp the active pattern on click, 0 to paint single cells
# custom:      the user-drawn custom pattern
# solid_r:     solid-mode live-cell red in [0, 1]
# solid_g:     solid-mode live-cell green in [0, 1]
# solid_b:     solid-mode live-cell blue in [0, 1]
# status:      last persistence message, shown in the arrangements window
pub rec App {
    speed:       f32;
    zoom:        f32;
    pan_x:       f32;
    pan_y:       f32;
    mode:        usize;
    gutter:      u8;
    uncapped:    u8;
    erase:       u8;
    bounds_idx:  usize;
    ui_visible:  u8;
    world:       bw.Window;
    kedit:       bw.Window;
    preset_sel:  usize;
    arrange:     bw.Window;
    pattern_sel: usize;
    stamp_mode:  u8;
    custom:      pattern.Pattern;
    solid_r:     f32;
    solid_g:     f32;
    solid_b:     f32;
    status:      str;
}

# the randomize area's side length (cells) for a bounds-table index
# ---
# i:   index in [0, BOUNDS_COUNT)
# ret: a power-of-two side length, 32 up to 4096
pub fun bounds_size(i: usize) usize {
    if (i >= BOUNDS_COUNT) { ret 4096; }
    ret (32::usize) << (i::u64);
}

# seed the application state and place the world window
# ---
# a: state to initialize
pub fun init(a: *App) {
    a.speed         = 12.0;
    a.zoom          = 1.0;
    a.pan_x         = 0.0;
    a.pan_y         = 0.0;
    a.mode          = render.MODE_SOLID::usize;
    a.gutter        = 0;
    a.uncapped      = 0;
    a.erase         = 0;
    a.bounds_idx    = DEFAULT_BOUNDS;
    a.ui_visible    = 1;
    a.world.x       = 8.0;
    a.world.y       = 8.0;
    a.world.w       = 190.0;
    a.world.open    = 1;
    a.world.title   = "world";
    a.kedit.x       = 210.0;
    a.kedit.y       = 8.0;
    a.kedit.w       = 200.0;
    a.kedit.open    = 0;
    a.kedit.title   = "kernel";
    a.preset_sel    = 0;
    a.arrange.x     = 210.0;
    a.arrange.y     = 240.0;
    a.arrange.w     = 200.0;
    a.arrange.open  = 0;
    a.arrange.title = "arrangements";
    a.pattern_sel   = 0;
    a.stamp_mode    = 0;
    pattern.init(?a.custom, 16, 16, "custom");
    a.solid_r = 1.0;
    a.solid_g = 1.0;
    a.solid_b = 1.0;
    a.status  = "";
}
