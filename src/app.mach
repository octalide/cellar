# everything about how the user is viewing and editing the world
#
# the simulation owns the cells and the rule. this owns the camera, the tool,
# the colours, the panel and what it shows, and the messages it flashes.

use cellar.command;
use cellar.pattern;
use cellar.render;
use cellar.theme;
use allo: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

# number of colour modes (kept in step with render.MODE_*)
pub val MODE_COUNT: usize = 3;
# number of selectable power-of-two randomize areas
pub val BOUNDS_COUNT: usize = 8;
# bounds-table index used at startup (128)
pub val DEFAULT_BOUNDS: usize = 2;

# paint live cells
pub val TOOL_DRAW: usize = 0;
# paint dead cells
pub val TOOL_ERASE: usize = 1;
# stamp the selected pattern
pub val TOOL_STAMP: usize = 2;

# number of interface scales offered
pub val SCALE_COUNT: usize = 4;

# ticks a message stays up
pub val TOAST_TICKS: i32 = 150;

# clamp on the user zoom multiplier, from a whole large world to a few cells.
# at the least a pixel stays well under a chunk wide, which the coverage draw
# needs (cellar.gpu)
pub val ZOOM_MIN: f32 = 0.005;
pub val ZOOM_MAX: f32 = 16.0;

# all interactive state not owned by the simulation
# ---
# speed:       generations per second when not uncapped
# mode:        colour mode (render.MODE_*)
# gutter:      1 to draw grid lines when zoomed in
# uncapped:    1 to step as fast as the machine allows
# tool:        what a left press does to the world (TOOL_*)
# bounds_idx:  index into the power-of-two randomize-area table
# pattern_sel: selected pattern; pattern.BUILTIN_COUNT selects the custom one
# custom:      the user-drawn custom pattern
# orient:      how the stamp is laid down (pattern.ORIENT_*)
# solid:       live-cell colour in solid mode, sRGB hex
# zoom:        zoom multiplier, render.BASE_PPC pixels per cell at 1
# pan_x:       world column at the view's centre
# pan_y:       world row at the view's centre
# refit:       frame the randomize area on the next frame
# panel:       1 while the side panel is shown
# open_run:    the run section is expanded
# open_draw:   the draw section is expanded
# open_rule:   the rule section is expanded
# open_view:   the view section is expanded
# open_files:  the files section is expanded
# scale_idx:   index into the interface scales
# scroll:      how far the panel's content is scrolled up, in pixels
# content:     the panel content's height last frame
# side_x0:     the panel's left edge last frame, or the window width when hidden
# help:        1 while the key reference is shown
# full_said:   the full pool was reported, until the world is cleared
# toast:       the message being flashed
# toast_t:     ticks it has left
# stroke:      a paint stroke is under way
# last_x:      the cell the stroke last painted
# last_y:      the cell the stroke last painted
# shot:        a screenshot of the next frame is wanted
# alloc:       allocator behind the patterns and the queue, once attach has run
# queue:       edits to the world, applied at the start of the next frame
pub rec App {
    speed:       f32;
    mode:        usize;
    gutter:      u8;
    uncapped:    u8;
    tool:        usize;
    bounds_idx:  usize;
    pattern_sel: usize;
    library:     [7]pattern.Pattern;
    custom:      pattern.Pattern;
    orient:      u8;
    solid:       u32;
    zoom:        f32;
    pan_x:       f64;
    pan_y:       f64;
    refit:       bool;
    panel:       u8;
    open_run:    u8;
    open_draw:   u8;
    open_rule:   u8;
    open_view:   u8;
    open_files:  u8;
    scale_idx:   usize;
    scroll:      f32;
    content:     f32;
    side_x0:     f32;
    help:        u8;
    full_said:   bool;
    toast:       str;
    toast_t:     i32;
    stroke:      bool;
    last_x:      i64;
    last_y:      i64;
    shot:        bool;
    alloc:       *allo.Allocator;
    queue:       command.Queue;
}

# the randomize area's side length (cells) for a bounds-table index
# ---
# i:   index in [0, BOUNDS_COUNT)
# ret: a power-of-two side length, 32 up to 4096
pub fun bounds_size(i: usize) usize {
    if (i >= BOUNDS_COUNT) { ret 4096; }
    ret (32::usize) << (i::u64);
}

# the interface scale for a scale index
pub fun scale(i: usize) f32 {
    if (i == 1) { ret 1.25; }
    if (i == 2) { ret 1.5; }
    if (i == 3) { ret 2.0; }
    ret 1.0;
}

# a zoom multiplier brought within ZOOM_MIN and ZOOM_MAX
pub fun clamp_zoom(z: f32) f32 {
    if (z < ZOOM_MIN) { ret ZOOM_MIN; }
    if (z > ZOOM_MAX) { ret ZOOM_MAX; }
    ret z;
}

# flash a message
pub fun say(a: *App, s: str) {
    a.toast   = s;
    a.toast_t = TOAST_TICKS;
}

# flash the full pool once per fill, and rearm when the world is cleared
pub fun note_full(a: *App, full: bool) {
    if (!full) {
        a.full_said = false;
        ret;
    }
    if (a.full_said) { ret; }
    a.full_said = true;
    say(a, "the world outgrew its pool of chunks; clear it to run again");
}

# make the patterns the interface offers, once the allocator is up
# ---
# a:     application state
# alloc: allocator backing the patterns, outliving the application
# ret:   ok, or the allocator's refusal
pub fun attach(a: *App, alloc: *allo.Allocator) err[allo.Error] {
    a.alloc = alloc;
    command.init(?a.queue, alloc);
    var i: usize = 0;
    for (i < pattern.BUILTIN_COUNT) {
        val e: err[allo.Error] = pattern.builtin(?a.library[i], alloc, i);
        if (sel e.err) { ret e; }
        i = i + 1;
    }
    ret pattern.init(?a.custom, alloc, 16, 16, "custom");
}

# release the patterns attach made
pub fun dnit(a: *App) {
    var i: usize = 0;
    for (i < pattern.BUILTIN_COUNT) {
        pattern.dnit(?a.library[i]);
        i = i + 1;
    }
    pattern.dnit(?a.custom);
    command.dnit(?a.queue);
}

# ask for a change to the world, applied at the start of the next frame
# ---
# a: application state, which owns the queue and takes ownership of c
# c: the command
pub fun submit(a: *App, c: command.Command) {
    var own:    command.Command = c;
    val pushed: err[allo.Error] = command.push(?a.queue, own);
    if (sel pushed.err) {
        command.release(?own);
        say(a, "out of memory");
    }
}

# ask to stamp a pattern laid down in orientation o, centred on world (x, y), the
# command keeping its own oriented copy
pub fun stamp(a: *App, p: *pattern.Pattern, o: u8, x: i64, y: i64) {
    var s: command.Stamp;
    s.x = x;
    s.y = y;
    val cloned: err[allo.Error] = pattern.orient(?s.p, a.alloc, p, o);
    if (sel cloned.err) {
        say(a, "out of memory");
        ret;
    }
    submit(a, command.Command.stamp{s});
}

# seed the application state
pub fun init(a: *App) {
    a.speed       = 12.0;
    a.mode        = render.MODE_SOLID::usize;
    a.gutter      = 0;
    a.uncapped    = 0;
    a.tool        = TOOL_DRAW;
    a.bounds_idx  = DEFAULT_BOUNDS;
    a.pattern_sel = 0;
    a.orient      = 0;
    a.solid       = theme.swatch(0);
    a.zoom        = 1.0;
    a.pan_x       = 0.0;
    a.pan_y       = 0.0;
    a.refit       = true;
    a.panel       = 1;
    a.open_run    = 1;
    a.open_draw   = 1;
    a.open_rule   = 0;
    a.open_view   = 1;
    a.open_files  = 0;
    a.scale_idx   = 0;
    a.scroll      = 0.0;
    a.content     = 0.0;
    a.side_x0     = 0.0;
    a.help        = 0;
    a.full_said   = false;
    a.toast       = "";
    a.toast_t     = 0;
    a.stroke      = false;
    a.last_x      = 0;
    a.last_y      = 0;
    a.shot        = false;
    a.alloc       = nil;
}

test zoom_min__keeps_a_pixel_within_a_chunks_neighbours {
    # a pixel the draw colours lies at most a pixel outside its chunk, and its
    # footprint reaches half a pixel further, which must stay in the next chunk
    val cells: f32 = 1.0 / (render.BASE_PPC * ZOOM_MIN);
    if (cells * 1.5 >= 64.0) { ret 1; }
    ret 0;
}
