# everything about how the user is viewing and editing the world
#
# the simulation owns the cells and the rule. this owns the camera, the tool,
# the colours, the panels and what they show, and the messages it flashes.

use blit;
use cellar.boundary;
use cellar.brush;
use cellar.ceiling;
use cellar.command;
use cellar.device;
use cellar.fill;
use cellar.format;
use cellar.gesture;
use cellar.identify;
use cellar.identify.worker;
use cellar.journal;
use cellar.library;
use cellar.pace;
use cellar.pattern;
use cellar.render;
use cellar.rule;
use cellar.ruletext;
use cellar.saves;
use cellar.snapshot;
use cellar.space;
use cellar.sumlist;
use cellar.text;
use cellar.theme;
use cellar.topology;
use allo: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;

# number of colour modes (kept in step with render.MODE_*)
pub val MODE_COUNT: usize = 3;
# number of selectable power-of-two randomize areas
pub val BOUNDS_COUNT: usize = 8;
# bounds-table index used at startup (128)
pub val DEFAULT_BOUNDS: usize = 2;

# randomize fills a square around the view's centre
pub val FILL_SQUARE: usize = 0;
# randomize fills a circle around the view's centre
pub val FILL_CIRCLE: usize = 1;
# randomize fills the whole of a bounded grid
pub val FILL_GRID: usize = 2;
# randomize fills the boundary region last chosen with a click
pub val FILL_REGION: usize = 3;
# randomize fills the selection, leaving the rest of the world as it is
pub val FILL_SELECTION: usize = 4;
# number of things randomize fills
pub val FILL_COUNT: usize = 5;

# the pattern_sel that selects the custom pattern rather than a library one
pub val CUSTOM: usize = 0xffffffffffffffff;
# the library pattern selected at startup
val DEFAULT_PATTERN: str = "Glider";

# the most bytes the pattern search holds
pub val SEARCH_MAX: usize = 255;
# the most digits a generation to go to has
pub val GO_TO_MAX: usize = 19;

# paint live cells
pub val TOOL_DRAW: usize = 0;
# paint dead cells
pub val TOOL_ERASE: usize = 1;
# stamp the selected pattern
pub val TOOL_STAMP: usize = 2;
# drag out a rectangle to operate on
pub val TOOL_SELECT: usize = 3;
# draw the world's boundary, or a grid's bounds, and act on its regions
pub val TOOL_BOUNDS: usize = 4;
# draw walls, with any of the gestures (cellar.gesture)
pub val TOOL_WALL: usize = 5;
# number of tools
pub val TOOL_COUNT: usize = 6;
# the toolbar's tool buttons: one a tool, but one for the two shape tools,
# the bounds tool and the wall tool, which draw with the same gestures
# (cellar.gesture). it is named for the one it takes up, the last used, and a
# press on it while that is the tool takes up the other
pub val TOOL_BUTTONS: usize = 5;
# the button the shape tools share
pub val SHAPES_BUTTON: usize = 4;

# a wall drawn holds no live state
pub val WALL_DEAD: usize = 0;
# a wall drawn holds the pen's state: alive, or a fixed value of a
# continuous rule, a source or a sink
pub val WALL_INK: usize = 1;

# the most digits a bound's size has
pub val SIZE_DIGITS: usize = 10;

# a tool's name
pub fun tool_name(t: usize) str {
    if (t == TOOL_ERASE)  { ret "Erase"; }
    if (t == TOOL_STAMP)  { ret "Stamp"; }
    if (t == TOOL_SELECT) { ret "Select"; }
    if (t == TOOL_BOUNDS) { ret "Bounds"; }
    if (t == TOOL_WALL)   { ret "Walls"; }
    ret "Draw";
}

# a toolbar button's label (TOOL_BUTTONS): the shapes button is named for
# the shape tool it takes up
pub fun button_name(a: *App, i: usize) str {
    if (i == SHAPES_BUTTON) { ret tool_name(a.shape_tool); }
    ret tool_name(i);
}

# whether a tool is one of the shape tools
pub fun shaping(t: usize) bool {
    ret t == TOOL_BOUNDS || t == TOOL_WALL;
}

# the toolbar button a tool is under
pub fun button_of(t: usize) usize {
    if (shaping(t)) { ret SHAPES_BUTTON; }
    ret t;
}

# take a tool up, a shape tool becoming the one the shapes button takes
pub fun pick_tool(a: *App, t: usize) {
    a.tool = t;
    if (shaping(t)) { a.shape_tool = t; }
}

# take up the tool under a toolbar button: the shape tool last used for the
# shapes button, or the other one where that is the tool already
pub fun pick_button(a: *App, i: usize) {
    if (i != SHAPES_BUTTON) {
        a.tool = i;
        ret;
    }
    if (a.tool == TOOL_BOUNDS) { pick_tool(a, TOOL_WALL); }
    or (a.tool == TOOL_WALL)   { pick_tool(a, TOOL_BOUNDS); }
    or                         { a.tool = a.shape_tool; }
}

# number of interface scales offered
pub val SCALE_COUNT: usize = 4;

# seconds a message stays up, its fades included
pub val TOAST_SECONDS: f64 = 2.5;

# clamp on the user zoom multiplier, from a whole large world to a few cells.
# at the least a pixel stays well under a chunk wide, which the coverage draw
# needs (cellar.gpu)
pub val ZOOM_MIN: f32 = 0.005;
pub val ZOOM_MAX: f32 = 16.0;
# the least zoom while HashLife holds the world, which draws a square of cells
# a pixel however far out, so a pixel may stand for 2^37 cells
pub val ZOOM_TREE_MIN: f32 = 0.000000000001;

# all interactive state not owned by the simulation
# ---
# speed:        generations per second when not uncapped
# mode:         colour mode (render.MODE_*)
# gutter:       1 to draw grid lines when zoomed in
# uncapped:     1 to step as fast as the machine allows
# rate:         the rate the world measures at (cellar.pace)
# tool:         what a left press does to the world (TOOL_*)
# ink:          the state the draw tool paints, below the rule's states
# bounds_idx:   index into the power-of-two randomize-area table, the size of a
#               shape fill
# fill_target:  what randomize fills (FILL_*), which the randomize key repeats
# picking:      the next click in the world chooses the region to fill
# inks_open:    the pen's states popup is open (cellar.toolbar)
# fill_density: the live-cell probability of a fill, in [0, 1]
# pattern_sel:  the selected library pattern's index, or CUSTOM
# library:      the bundled patterns, once attach has run
# picked:       the selected library pattern, decoded
# picked_at:    the library index picked holds, or CUSTOM for none
# custom:       the user-drawn custom pattern
# search:       the draw section's pattern search
# search_buf:   its text
# browse:       the library category listed while the search is empty
# page:         the page of the pattern list shown
# orient:       how the stamp is laid down (pattern.ORIENT_*)
# solid:        live-cell colour in solid mode, sRGB hex
# zoom:         zoom multiplier, render.BASE_PPC pixels per cell at 1
# zoom_min:     the least zoom the engine holding the world draws
# pan_x:        world column at the view's centre
# pan_y:        world row at the view's centre
# refit:        frame fit, or the randomize area, on the next frame
# fit:          the cells to frame, none for the randomize area
# panel:        1 while the panels are shown
# rule_text:    the rule section's rule string field
# birth_list:   the wide kernel editor's birth sums
# survive_list: the wide kernel editor's survive sums
# brush:        the wide kernel editor's brush and view
# scale_idx:    index into the interface scales
# engine_tree:  the chosen engine is HashLife, which the settings keep
# engine_cpu:   the chosen pool engine is the CPU rather than the GPU
# device:       the graphics device drawing the window, once the renderer runs
# layout:       the panels' layout as the settings keep it, blit's store
#               document NUL-terminated, empty for none; once attach has run
# relayout:     the panels are to return to the default layout on the next frame
# files_seen:   the files panel was drawn last frame
# help:         1 while the key reference is shown
# full_said:    the full pool was reported, until the world is cleared
# ceil_said:    the ceiling the run paused at was reported, until it resumes
# kept_said:    the pool the GPU kept was reported, until the host takes it
# toast:        the message being flashed
# toast_held:   the message stays up until another replaces it
# told:         messages flashed so far, which a wrap count compares
# said:         the text of a message built at run time
# go_to:        the generation the run section goes to on HashLife
# go_to_buf:    its text
# name:         the name the files section saves under
# name_buf:     its text
# saves:        the worlds and patterns in the data directory
# stroke:       a paint stroke is under way
# last_x:       the cell the stroke last painted
# last_y:       the cell the stroke last painted
# shot:         a screenshot of the next frame is wanted
# selected:     a rectangle of the world is selected
# area:         the selection, half-open
# copy_bound:   a copy or cut of the selection keeps the boundary inside it
# dragging:     the selection is being dragged out
# anchor_x:     the cell the drag started on
# anchor_y:     the cell the drag started on
# shape_tool:   the shape tool the shapes button takes up, the last used
# wall_kind:    what a wall drawn holds (WALL_DEAD, WALL_INK)
# walls:        the shape the wall tool is drawing (cellar.gesture)
# sizing:       the bounds are being dragged
# edges:        the grid's edges the drag moves (cellar.bounds), 0 for a new box
# sized:        the bounds as dragged so far, half-open
# grid_shape:   the grid a drawn or typed box makes (cellar.bounds), and the
#               shape the world's bounded grid is on
# size_w:       the bounds section's width
# size_w_buf:   its text
# size_h:       the bounds section's height
# size_h_buf:   its text
# sized_grid:   the grid the size fields last showed
# domain:       the world's boundary as last seen (cellar.exec), which the
#               bounds tool and the draw read
# dom_on:       the world has a boundary, which domain holds
# dom_drawn:    it was drawn, rather than the plane the rule names
# dom_seen:     the change to the boundary domain was copied at (sim.bound_revision)
# dom_parts:    regions it holds
# shape:        the shape the bounds tool is drawing (cellar.gesture)
# choosing:     a press of the bounds tool picks a region rather than drawing
# bound_op:     how a drawn shape combines with the boundary (boundary.ADD,
#               SUBTRACT or INTERSECT)
# part_on:      a region of the boundary is picked
# part_x:       the column of a cell it holds
# part_y:       its row
# part:         the region, as last seen
# moving:       the picked region is being dragged
# move_dx:      columns it is dragged by so far
# move_dy:      rows it is dragged by so far
# shade_tmp:    spans the draw of a region works out (cellar.shade)
# fill_on:      a region is chosen for a region fill, which fill_part holds
# fill_x:       the column of the cell that chose it
# fill_y:       its row
# fill_part:    the region, as the boundary was last seen
# alloc:        allocator behind the patterns and the queue, once attach has run
# queue:        edits to the world, applied at the start of the next frame
# start:        the world reset returns to, once attach has run
# log:          the changes undo and redo walk, once attach has run
# clip:         text the frame is to put on the clipboard, once attach has run
# clip_ready:   clip holds text not yet put on the clipboard
# copied:       the pattern clip was last written from when it holds words,
#               walls or a boundary the clipboard's RLE cannot, empty
#               otherwise, so a paste of that same text takes it whole
#               (cellar.exec)
# identifier:   classifies a selection off the frame
# id_limits:    the limits a selection is classified under
# identified:   the last classification of a selection, empty for none
pub rec App {
    speed:        f32;
    mode:         usize;
    gutter:       u8;
    uncapped:     u8;
    rate:         pace.Rate;
    tool:         usize;
    ink:          u8;
    bounds_idx:   usize;
    fill_target:  usize;
    picking:      bool;
    inks_open:    bool;
    fill_density: f32;
    pattern_sel:  usize;
    library:      library.Library;
    picked:       pattern.Pattern;
    picked_at:    usize;
    custom:       pattern.Pattern;
    search:       blit.field.Field;
    search_buf:   [SEARCH_MAX + 1]u8;
    browse:       usize;
    page:         usize;
    orient:       u8;
    solid:        u32;
    zoom:         f32;
    zoom_min:     f32;
    pan_x:        f64;
    pan_y:        f64;
    refit:        bool;
    fit:          opt[space.Box];
    panel:        u8;
    rule_text:    ruletext.RuleText;
    birth_list:   sumlist.SumList;
    survive_list: sumlist.SumList;
    brush:        brush.Brush;
    scale_idx:    usize;
    engine_tree:  bool;
    engine_cpu:   bool;
    device:       device.Device;
    layout:       Vector[u8];
    relayout:     bool;
    files_seen:   bool;
    help:         u8;
    full_said:    bool;
    ceil_said:    bool;
    kept_said:    bool;
    toast:        str;
    toast_held:   bool;
    told:         u32;
    said:         [256]u8;
    go_to:        blit.field.Field;
    go_to_buf:    [GO_TO_MAX + 1]u8;
    name:         blit.field.Field;
    name_buf:     [saves.NAME_MAX + 1]u8;
    saves:        saves.Saves;
    stroke:       bool;
    last_x:       i64;
    last_y:       i64;
    shot:         bool;
    selected:     bool;
    area:         space.Box;
    copy_bound:   u8;
    dragging:     bool;
    anchor_x:     i64;
    anchor_y:     i64;
    shape_tool:   usize;
    wall_kind:    usize;
    walls:        gesture.Gesture;
    sizing:       bool;
    edges:        u8;
    sized:        space.Box;
    grid_shape:   usize;
    size_w:       blit.field.Field;
    size_w_buf:   [SIZE_DIGITS + 1]u8;
    size_h:       blit.field.Field;
    size_h_buf:   [SIZE_DIGITS + 1]u8;
    sized_grid:   topology.Grid;
    domain:       boundary.Region;
    dom_on:       bool;
    dom_drawn:    bool;
    dom_seen:     u64;
    dom_parts:    usize;
    shape:        gesture.Gesture;
    choosing:     bool;
    bound_op:     u32;
    part_on:      bool;
    part_x:       i64;
    part_y:       i64;
    part:         boundary.Region;
    moving:       bool;
    move_dx:      i64;
    move_dy:      i64;
    shade_tmp:    Vector[i64];
    fill_on:      bool;
    fill_x:       i64;
    fill_y:       i64;
    fill_part:    boundary.Region;
    alloc:        *allo.Allocator;
    queue:        command.Queue;
    start:        snapshot.Snapshot;
    log:          journal.Journal;
    clip:         Vector[u8];
    clip_ready:   bool;
    copied:       pattern.Pattern;
    identifier:   worker.Worker;
    id_limits:    identify.Limits;
    identified:   [641]u8;
}

# the message shown while a selection is being identified
pub val IDENTIFYING: str = "identifying...";

# the randomize area's side length (cells) for a bounds-table index
# ---
# i:   index in [0, BOUNDS_COUNT)
# ret: a power-of-two side length, 32 up to 4096
pub fun bounds_size(i: usize) usize {
    if (i >= BOUNDS_COUNT) { ret 4096; }
    ret (32::usize) << (i::u64);
}

# randomize as last chosen: a fill of the target and density in the world panel
# ---
# a: application state
pub fun randomize(a: *App) {
    if (a.fill_target == FILL_SELECTION) {
        area(a, command.AREA_FILL);
        ret;
    }
    submit(a, command.Command.randomize{fill_of(a)});
}

# the fill a shape target makes with the view: around its centre, or the grid
pub fun fill_of(a: *App) fill.Fill {
    val side: usize     = bounds_size(a.bounds_idx);
    val cx:   i64       = render.floor64(a.pan_x);
    val cy:   i64       = render.floor64(a.pan_y);
    var f:    fill.Fill = fill.square(cx, cy, side, a.fill_density);
    if (a.fill_target == FILL_CIRCLE) { f = fill.circle(cx, cy, side, a.fill_density); }
    if (a.fill_target == FILL_GRID)   { f.shape = fill.Shape.grid{}; }
    if (a.fill_target == FILL_REGION) { f.shape = fill.Shape.region{}; }
    ret f;
}

# the interface scale for a scale index
pub fun scale(i: usize) f32 {
    if (i == 1) { ret 1.25; }
    if (i == 2) { ret 1.5; }
    if (i == 3) { ret 2.0; }
    ret 1.0;
}

# a zoom multiplier brought within the least the engine draws and ZOOM_MAX
pub fun clamp_zoom(a: *App, z: f32) f32 {
    if (z < a.zoom_min) { ret a.zoom_min; }
    if (z > ZOOM_MAX)   { ret ZOOM_MAX; }
    ret z;
}

# take the least zoom of the engine holding the world, HashLife's with tree,
# bringing the zoom within it
pub fun fit_engine(a: *App, tree: bool) {
    a.zoom_min = ZOOM_MIN;
    if (tree) { a.zoom_min = ZOOM_TREE_MIN; }
    a.zoom = clamp_zoom(a, a.zoom);
}

# frame the fill randomize would make now: its target around the view's centre
# at its size, the grid, the chosen region or the selection
# ---
# a:      application state
# grid:   the world's grid
# bound:  the box of the world's boundary, which holds its grid's place
# region: the box of the chosen region, or none
pub fun frame_area(a: *App, grid: *topology.Grid, bound: opt[space.Box], region: opt[space.Box]) {
    if (a.fill_target == FILL_REGION) {
        if (sel region.some) { frame_box(a, region.some); }
        or                   { say(a, "no region is chosen to frame"); }
        ret;
    }
    if (a.fill_target == FILL_GRID) {
        var b: opt[space.Box] = bound;
        if (!sel b.some) { b = fill.grid_box(grid); }
        if (sel b.some)  { frame_box(a, b.some); }
        or               { say(a, "the world has no bounded grid to frame"); }
        ret;
    }
    if (a.fill_target == FILL_SELECTION) {
        if (a.selected) { frame_box(a, a.area); }
        or              { say(a, "nothing is selected"); }
        ret;
    }
    val f:    fill.Fill   = fill_of(a);
    val none: fill.Domain = fill.nowhere();
    frame_box(a, fill.bounds(?f.shape, ?none));
}

# frame the origin square of the randomize size, as a launch does
fun frame_start(a: *App) {
    a.fit   = opt[space.Box].none{};
    a.refit = true;
}

# frame a box of cells on the next frame
pub fun frame_box(a: *App, b: space.Box) {
    a.fit   = opt[space.Box].some{b};
    a.refit = true;
}

# the cells the next framing shows: the box asked for, or at launch the
# randomize size's square around the origin
pub fun fit_box(a: *App) space.Box {
    if (sel a.fit.some) { ret a.fit.some; }
    val h: i64 = (bounds_size(a.bounds_idx) / 2)::i64;
    ret space.Box{x0: 0 - h, y0: 0 - h, x1: h, y1: h};
}

# flash a message for TOAST_SECONDS, replacing the one shown
pub fun say(a: *App, s: str) {
    a.toast      = s;
    a.toast_held = false;
    a.told       = a.told + 1;
}

# flash a message about something, as "what: why"
# ---
# a:    application state
# what: what the message is about, such as a file name
# why:  what happened to it
pub fun say_why(a: *App, what: str, why: str) {
    var o: usize = 0;
    var i: usize = 0;
    for (what[i] != 0 && o < 180) {
        a.said[o] = what[i];
        o         = o + 1;
        i         = i + 1;
    }
    o = text.buf_str(?a.said[0], o, ": ");
    i = 0;
    for (why[i] != 0 && o < 254) {
        a.said[o] = why[i];
        o         = o + 1;
        i         = i + 1;
    }
    a.said[o] = 0;
    say(a, ?a.said[0]);
}

# add to the message being flashed, as "message; more"
pub fun say_also(a: *App, more: str) {
    var was: [256]u8;
    var o:   usize = 0;
    for (a.toast[o] != 0 && o < 255) {
        was[o] = a.toast[o];
        o      = o + 1;
    }
    was[o] = 0;
    o      = 0;
    for (was[o] != 0 && o < 200) {
        a.said[o] = was[o];
        o         = o + 1;
    }
    o = text.buf_str(?a.said[0], o, "; ");
    var i: usize = 0;
    for (more[i] != 0 && o < 254) {
        a.said[o] = more[i];
        o         = o + 1;
        i         = i + 1;
    }
    a.said[o] = 0;
    say(a, ?a.said[0]);
}

# flash the full world once per fill, and rearm when the world is cleared
# ---
# a:    application state
# full: the world is full
# why:  what that means, for the message
pub fun note_full(a: *App, full: bool, why: str) {
    if (!full) {
        a.full_said = false;
        ret;
    }
    if (a.full_said) { ret; }
    a.full_said = true;
    say(a, why);
}

# flash once that the run paused because the GPU keeps a pool the host could
# not take back, and rearm once the host takes it
# ---
# a:   application state
# why: why it could not, or none while the host holds the pool
pub fun note_withheld(a: *App, why: opt[str]) {
    if (sel why.none) {
        a.kept_said = false;
        ret;
    }
    if (a.kept_said) { ret; }
    a.kept_said = true;
    say_why(a, "paused", why.some);
}

# flash the ceiling a run paused at once per pause, and rearm once it resumes
# ---
# a:       application state
# k:       the ceiling the run is paused at, ceiling.COUNT for none
# limit:   the limit crossed, in the ceiling's unit
# smaller: a smaller HashLife step may fit under it
pub fun note_ceiling(a: *App, k: usize, limit: u64, smaller: bool) {
    if (k == ceiling.COUNT) {
        a.ceil_said = false;
        ret;
    }
    if (a.ceil_said) { ret; }
    a.ceil_said = true;
    var o: usize = text.buf_str(?a.said[0], 0, "paused: ");
    o = text.buf_str(?a.said[0], o, ceiling.name(k));
    if (k == ceiling.POOL) { o = text.buf_str(?a.said[0], o, " reached its ceiling of "); }
    or                     { o = text.buf_str(?a.said[0], o, " passed its ceiling of "); }
    o = text.buf_grouped(?a.said[0], o, limit);
    o = text.buf_str(?a.said[0], o, " ");
    o = text.buf_str(?a.said[0], o, ceiling.unit(k));
    # only a higher ceiling carries a run past the pool's (hud pool_offer)
    if (k == ceiling.POOL) { o = text.buf_str(?a.said[0], o, "; raise it to run on"); }
    or                     { o = text.buf_str(?a.said[0], o, "; play runs past it"); }
    if (smaller)           { o = text.buf_str(?a.said[0], o, ", or a smaller step may fit"); }
    a.said[o] = 0;
    say(a, ?a.said[0]);
}

# make the patterns the interface offers, once the allocator is up, selecting
# the default one
# ---
# a:     application state
# alloc: allocator backing the patterns, outliving the application
# ret:   ok, or why the library or a pattern could not be made
pub fun attach(a: *App, alloc: *allo.Allocator) err[format.Error] {
    a.alloc = alloc;
    command.init(?a.queue, alloc);
    saves.init(?a.saves, alloc);
    snapshot.init(?a.start, alloc);
    journal.init(?a.log, alloc);
    a.clip       = vector.init[u8](alloc);
    a.clip_ready = false;
    a.layout     = vector.init[u8](alloc);
    a.domain     = boundary.init(alloc);
    a.part       = boundary.init(alloc);
    a.shade_tmp  = vector.init[i64](alloc);
    a.fill_part  = boundary.init(alloc);
    gesture.init(?a.shape, alloc);
    gesture.init(?a.walls, alloc);
    a.walls.kind   = gesture.FREEHAND;
    a.walls.radius = 0.0;
    val l: err[format.Error] = library.init(?a.library, alloc);
    if (sel l.err) { ret l; }
    val p: err[allo.Error] = pattern.init(?a.picked, alloc, 0, 0, "");
    if (sel p.err) { ret err[format.Error].err{format.Error.alloc{p.err}}; }
    val c: err[allo.Error] = pattern.init(?a.custom, alloc, 16, 16, "custom");
    if (sel c.err) { ret err[format.Error].err{format.Error.alloc{c.err}}; }
    val k: err[allo.Error] = pattern.init(?a.copied, alloc, 0, 0, "");
    if (sel k.err) { ret err[format.Error].err{format.Error.alloc{k.err}}; }
    choose_default(a);
    ret err[format.Error].ok{};
}

# release the patterns attach made
pub fun dnit(a: *App) {
    library.dnit(?a.library);
    pattern.dnit(?a.picked);
    pattern.dnit(?a.custom);
    pattern.dnit(?a.copied);
    command.dnit(?a.queue);
    saves.dnit(?a.saves);
    snapshot.dnit(?a.start);
    journal.dnit(?a.log);
    vector.dnit[u8](?a.clip);
    vector.dnit[u8](?a.layout);
    boundary.dnit(?a.domain);
    boundary.dnit(?a.part);
    vector.dnit[i64](?a.shade_tmp);
    boundary.dnit(?a.fill_part);
    gesture.dnit(?a.shape);
    gesture.dnit(?a.walls);
    worker.cancel(?a.identifier);
}

# keep a layout for the settings, n bytes of blit's store document, or none
# when n is 0
# ---
# a:   application state, attached
# s:   the document
# n:   its length, less any NUL
# ret: false when there was no room, leaving no layout
pub fun keep_layout(a: *App, s: *u8, n: usize) bool {
    vector.clear[u8](?a.layout);
    if (n == 0) { ret true; }
    val room: res[usize, allo.Error] = vector.reserve[u8](?a.layout, n + 1);
    if (sel room.err) { ret false; }
    var i: usize = 0;
    for (i < n) {
        a.layout.data[i] = s[i];
        i                = i + 1;
    }
    a.layout.data[n] = 0;
    a.layout.len     = n + 1;
    ret true;
}

# choose a library pattern to stamp and browse its category, or the custom pattern
# ---
# a: application state
# i: a library index or CUSTOM; anything else selects the default pattern
pub fun choose(a: *App, i: usize) {
    val n: usize = library.count(?a.library);
    var s: usize = i;
    if (s != CUSTOM && s >= n) { s = library.find(?a.library, DEFAULT_PATTERN); }
    if (s != CUSTOM && s >= n) { s = 0; }
    a.pattern_sel = s;
    if (s < n) { a.browse = library.category_of(?a.library, s); }
}

# choose the library pattern with a name, or the default when the library has none by it
pub fun choose_named(a: *App, name: str) {
    choose(a, library.find(?a.library, name));
}

# choose the default library pattern
pub fun choose_default(a: *App) {
    choose(a, library.count(?a.library));
}

# the selected pattern, the custom one or the library one, decoded on first use
pub fun chosen(a: *App) *pattern.Pattern {
    if (a.pattern_sel == CUSTOM || a.pattern_sel >= library.count(?a.library)) { ret ?a.custom; }
    if (a.picked_at != a.pattern_sel) {
        val r: err[format.Error] = library.load(?a.library, a.pattern_sel, ?a.picked);
        if (sel r.err) {
            say(a, format.error_message(r.err));
            pattern.resize(?a.picked, 0, 0);
        }
        a.picked_at = a.pattern_sel;
    }
    ret ?a.picked;
}

# ask for a change to the world, applied at the start of the next frame
# ---
# a: application state, which owns the queue and takes ownership of c
# c: the command
pub fun submit(a: *App, c: command.Command) {
    var own:    command.Command = c;
    val pushed: err[allo.Error] = command.push(?a.queue, own);
    if (sel pushed.err) {
        command.release(?own);
        say(a, "out of memory");
    }
}

# draw the walls of the shape the wall tool's gesture just finished, holding
# the wall tool's state, as one change
pub fun draw_walls(a: *App) {
    var r:      boundary.Region = boundary.init(a.alloc);
    val copied: err[allo.Error] = boundary.copy(?r, ?a.walls.shape);
    if (sel copied.err) {
        boundary.dnit(?r);
        say(a, "out of memory");
        ret;
    }
    submit(a, command.Command.walls{command.Walls{shape: r, v: wall_state(a)}});
}

# a file command's copy of a path, saying so when there is no memory for it
pub fun file(a: *App, path: str) opt[command.File] {
    val f: res[command.File, allo.Error] = command.file(a.alloc, path);
    if (sel f.err) {
        say(a, "out of memory");
        ret opt[command.File].none{};
    }
    ret opt[command.File].some{f.ok};
}

# ask to stamp a pattern laid down in orientation o, centred on world (x, y), the
# command keeping its own oriented copy
pub fun stamp(a: *App, p: *pattern.Pattern, o: u8, x: i64, y: i64) {
    var s: command.Stamp;
    s.x = x;
    s.y = y;
    val cloned: err[allo.Error] = pattern.orient(?s.p, a.alloc, p, o);
    if (sel cloned.err) {
        say(a, "out of memory");
        ret;
    }
    submit(a, command.Command.stamp{s});
}

# ask to paste clipboard text as the stamp
# ---
# a:    application state
# text: the clipboard's text, a copy from a.alloc that this takes ownership of
# rule: also take the pattern's rule
pub fun paste(a: *App, text: str, rule: bool) {
    val n: usize              = string.str_len(text);
    var o: string.OwnedString = string.owned_adopt(a.alloc, text, n, n + 1);
    if (n == 0) {
        string.owned_release(?o);
        say(a, "the clipboard holds no text");
        ret;
    }
    submit(a, command.Command.paste{command.Paste{text: o, rule: rule}});
}

# ask to make a library pattern the stamp
# ---
# a:    application state
# i:    the pattern's library index
# rule: also take the pattern's rule
pub fun pick(a: *App, i: usize, rule: bool) {
    submit(a, command.Command.pick{command.Pick{index: i, rule: rule}});
}

# ask to open the first of the files dropped on the window
# ---
# a:     application state
# paths: the dropped paths, borrowed for the call
# count: how many
pub fun drop(a: *App, paths: *str, count: usize) {
    if (count == 0) { ret; }
    val f: opt[command.File] = file(a, paths[0]);
    if (sel f.some) { submit(a, command.Command.drop{command.Drop{file: f.some, ignored: count - 1}}); }
}

# select the rectangle with corner cells (x0, y0) and (x1, y1), both inside it
pub fun select(a: *App, x0: i64, y0: i64, x1: i64, y1: i64) {
    a.selected = true;
    a.area.x0  = x0;
    a.area.x1  = x1 + 1;
    a.area.y0  = y0;
    a.area.y1  = y1 + 1;
    if (x1 < x0) {
        a.area.x0 = x1;
        a.area.x1 = x0 + 1;
    }
    if (y1 < y0) {
        a.area.y0 = y1;
        a.area.y1 = y0 + 1;
    }
}

# drop the selection
pub fun deselect(a: *App) {
    a.selected = false;
    a.dragging = false;
}

# pick the region of the boundary holding a cell, as the boundary was last
# seen, or none where no region holds it
# ---
# ret: whether a region holds the cell
pub fun pick_part(a: *App, x: i64, y: i64) bool {
    a.part_on = false;
    a.moving  = false;
    boundary.clear(?a.part);
    if (!a.dom_on) { ret false; }
    val at: res[usize, allo.Error] = boundary.region_at(?a.domain, x, y);
    if (!sel at.ok)                  { ret false; }
    if (at.ok == boundary.NO_REGION) { ret false; }
    val got: err[allo.Error] = boundary.region(?a.domain, at.ok, ?a.part);
    if (sel got.err) { ret false; }
    a.part_on = true;
    a.part_x  = x;
    a.part_y  = y;
    ret true;
}

# take up the world's boundary as it now stands, once it has changed since
# last seen, keeping the picked region picked where a region still holds its
# cell
# ---
# a:       application state, attached
# changes: the boundary's changes so far (sim.bound_revision)
# b:       the boundary, or nil for none
# drawn:   it was drawn, rather than the plane the rule names
pub fun see_domain(a: *App, changes: u64, b: *boundary.Region, drawn: bool) {
    if (changes == a.dom_seen) { ret; }
    a.dom_seen  = changes;
    a.dom_on    = false;
    a.dom_drawn = false;
    a.dom_parts = 0;
    boundary.clear(?a.domain);
    if (b != nil) {
        val copied: err[allo.Error] = boundary.copy(?a.domain, b);
        a.dom_on    = sel copied.ok;
        a.dom_drawn = a.dom_on && drawn;
    }
    if (a.dom_on) {
        val n: res[usize, allo.Error] = boundary.count(?a.domain);
        if (sel n.ok) { a.dom_parts = n.ok; }
    }
    if (a.part_on) { pick_part(a, a.part_x, a.part_y); }
    see_fill(a, a.fill_on, a.fill_x, a.fill_y, true);
}

# take up the cell that chooses the region a region fill takes, finding the
# region in the boundary as last seen when the cell or the boundary changed
# ---
# a:     application state, attached
# on:    a cell is chosen
# x:     its column
# y:     its row
# again: the boundary changed, so the region is found again
pub fun see_fill(a: *App, on: bool, x: i64, y: i64, again: bool) {
    if (!again && on == a.fill_on && x == a.fill_x && y == a.fill_y) { ret; }
    a.fill_on = on;
    a.fill_x  = x;
    a.fill_y  = y;
    boundary.clear(?a.fill_part);
    if (!on || !a.dom_on) { ret; }
    val at: res[usize, allo.Error] = boundary.region_at(?a.domain, x, y);
    if (!sel at.ok)                  { ret; }
    if (at.ok == boundary.NO_REGION) { ret; }
    boundary.region(?a.domain, at.ok, ?a.fill_part);
}

# ask for an operation on the selection, when there is one
# ---
# a:  application state
# op: the operation (command.AREA_*)
pub fun area(a: *App, op: u8) {
    if (!a.selected) {
        say(a, "nothing is selected");
        ret;
    }
    submit(a, command.Command.area{command.Area{op: op, box: a.area}});
}

# whether a character may be typed into a generation
fun digit(c: u32) bool {
    ret c >= '0' && c <= '9';
}

# the state a press of the tool paints: dead for erase, the ink otherwise
pub fun pen(a: *App) u8 {
    if (a.tool == TOOL_ERASE) { ret 0; }
    ret a.ink;
}

# the state a wall the wall tool draws holds: none, or the pen's ink
pub fun wall_state(a: *App) u8 {
    if (a.wall_kind == WALL_DEAD) { ret 0; }
    ret a.ink;
}

# bring the ink within a rule of n states, which has live states 1 to n - 1
pub fun fit_ink(a: *App, n: u32) {
    if (a.ink == 0)      { a.ink = 1; }
    if (a.ink::u32 >= n) { a.ink = (n - 1)::u8; }
}

# step the ink to the next live state of a rule of n states, or with back the
# one before, wrapping round, and arm the draw tool
pub fun step_ink(a: *App, n: u32, back: bool) {
    fit_ink(a, n);
    val live: u32 = n - 1;
    var i:    u32 = a.ink::u32 - 1;
    if (back) { i = i + live - 1; }
    or        { i = i + 1; }
    a.ink  = (i % live + 1)::u8;
    a.tool = TOOL_DRAW;
}

# seed the application state
pub fun init(a: *App) {
    a.speed    = 12.0;
    a.mode     = render.MODE_SOLID::usize;
    a.gutter   = 0;
    a.uncapped = 0;
    pace.init(?a.rate);
    a.tool         = TOOL_DRAW;
    a.ink          = 1;
    a.bounds_idx   = DEFAULT_BOUNDS;
    a.fill_target  = FILL_SQUARE;
    a.picking      = false;
    a.inks_open    = false;
    a.fill_density = fill.DENSITY;
    a.pattern_sel  = 0;
    library.empty(?a.library);
    a.picked_at = CUSTOM;
    blit.field.init(?a.search, ?a.search_buf[0], SEARCH_MAX + 1, 0, nil);
    a.browse   = 0;
    a.page     = 0;
    a.orient   = 0;
    a.solid    = theme.swatch(0);
    a.zoom     = 1.0;
    a.zoom_min = ZOOM_MIN;
    a.pan_x    = 0.0;
    a.pan_y    = 0.0;
    frame_start(a);
    a.panel = 1;
    ruletext.init(?a.rule_text);
    sumlist.init(?a.birth_list);
    sumlist.init(?a.survive_list);
    brush.init(?a.brush);
    a.scale_idx   = 0;
    a.engine_tree = false;
    a.engine_cpu  = false;
    a.layout      = vector.init[u8](nil);
    a.relayout    = true;
    a.files_seen  = false;
    a.help        = 0;
    a.full_said   = false;
    a.kept_said   = false;
    a.ceil_said   = false;
    a.toast       = "";
    a.toast_held  = false;
    a.told        = 0;
    a.said[0]     = 0;
    device.none(?a.device);
    blit.field.init(?a.name, ?a.name_buf[0], saves.NAME_MAX + 1, 0, saves.name_char);
    blit.field.init(?a.go_to, ?a.go_to_buf[0], GO_TO_MAX + 1, 0, digit);
    a.stroke     = false;
    a.last_x     = 0;
    a.last_y     = 0;
    a.shot       = false;
    a.selected   = false;
    a.copy_bound = 0;
    a.dragging   = false;
    a.sizing     = false;
    a.wall_kind  = WALL_DEAD;
    a.shape_tool = TOOL_BOUNDS;
    a.edges      = 0;
    a.grid_shape = 0;
    blit.field.init(?a.size_w, ?a.size_w_buf[0], SIZE_DIGITS + 1, 0, digit);
    blit.field.init(?a.size_h, ?a.size_h_buf[0], SIZE_DIGITS + 1, 0, digit);
    a.sized_grid = topology.open();
    a.domain     = boundary.init(nil);
    a.dom_on     = false;
    a.dom_drawn  = false;
    a.dom_seen   = 0;
    a.dom_parts  = 0;
    gesture.init(?a.shape, nil);
    gesture.init(?a.walls, nil);
    a.walls.kind   = gesture.FREEHAND;
    a.walls.radius = 0.0;
    a.choosing     = false;
    a.bound_op     = boundary.ADD;
    a.part_on      = false;
    a.part_x       = 0;
    a.part_y       = 0;
    a.part         = boundary.init(nil);
    a.moving       = false;
    a.move_dx      = 0;
    a.move_dy      = 0;
    a.shade_tmp    = vector.init[i64](nil);
    a.fill_on      = false;
    a.fill_x       = 0;
    a.fill_y       = 0;
    a.fill_part    = boundary.init(nil);
    a.alloc        = nil;
    worker.init(?a.identifier);
    a.id_limits     = identify.limits();
    a.identified[0] = 0;
}

# classify a pattern off the frame under a rule, replacing a classification
# still running, and say so while it runs
# ---
# a: application state
# r: the rule
# p: the pattern, which the worker copies, so the caller keeps it
pub fun identify_start(a: *App, r: rule.Rule, p: *pattern.Pattern) {
    if (!worker.start(?a.identifier, r, p, a.id_limits)) {
        say(a, "the selection could not be identified: out of memory or threads");
        ret;
    }
    say(a, IDENTIFYING);
    a.toast_held = true;
}

# flash a finished classification in place of the running message, which
# stays up until then; the frame calls this once a frame
pub fun identify_poll(a: *App) {
    val c: worker.Collected = worker.collect(?a.identifier);
    if (sel c.idle) { ret; }
    if (sel c.failed) {
        say(a, "out of memory");
        ret;
    }
    if (sel c.ready) {
        var r: identify.Result = c.ready;
        say_why(a, "selection", identify.describe(?r, ?a.identified[0]));
    }
}

test zoom_min__keeps_a_pixel_within_a_chunks_neighbours {
    # a pixel the draw colours lies at most a pixel outside its chunk, and its
    # footprint reaches half a pixel further, which must stay in the next chunk
    val cells: f32 = 1.0 / (render.BASE_PPC * ZOOM_MIN);
    if (cells * 1.5 >= 64.0) { ret 1; }
    ret 0;
}

test step_ink__cycles_the_live_states_and_fit_ink_clamps_them {
    var a: App;
    a.tool = TOOL_ERASE;
    a.ink  = 1;
    if (pen(?a) != 0) { ret 1; }
    step_ink(?a, 4, false);
    if (a.ink != 2 || a.tool != TOOL_DRAW || pen(?a) != 2) { ret 2; }
    step_ink(?a, 4, false);
    step_ink(?a, 4, false);
    if (a.ink != 1) { ret 3; }
    step_ink(?a, 4, true);
    if (a.ink != 3) { ret 4; }
    # a rule of fewer states brings the ink within them, and two states hold it at 1
    fit_ink(?a, 3);
    if (a.ink != 2) { ret 5; }
    step_ink(?a, 2, true);
    if (a.ink != 1) { ret 6; }
    a.ink = 255;
    fit_ink(?a, 256);
    if (a.ink != 255) { ret 7; }
    ret 0;
}

test frame_area__frames_the_fill_around_the_view_floored_for_negative_centres {
    var a: App;
    a.bounds_idx   = 0;
    a.fill_density = 0.5;
    a.fill_target  = FILL_SQUARE;
    a.pan_x        = -0.5;
    a.pan_y        = -100.5;
    a.selected     = false;
    val f: fill.Fill = fill_of(?a);
    if (!sel f.shape.square)                                { ret 1; }
    if (f.shape.square.x != -1 || f.shape.square.y != -101) { ret 1; }
    var g:  topology.Grid  = topology.Grid{shape: topology.PLANE, w: 40, h: 30, twist_w: false};
    val no: opt[space.Box] = opt[space.Box].none{};
    frame_area(?a, ?g, no, no);
    if (!a.refit || !sel a.fit.some) { ret 2; }
    val b: space.Box = fit_box(?a);
    if (b.x0 != -17 || b.x1 != 15 || b.y0 != -117 || b.y1 != -85) { ret 3; }
    a.fill_target = FILL_GRID;
    frame_area(?a, ?g, no, no);
    val c: space.Box = fit_box(?a);
    if (c.x0 != -20 || c.x1 != 20 || c.y0 != -15 || c.y1 != 15) { ret 4; }
    a.fill_target = FILL_REGION;
    frame_area(?a, ?g, no, opt[space.Box].some{space.Box{x0: 7, y0: 8, x1: 9, y1: 12}});
    val r: space.Box = fit_box(?a);
    if (r.x0 != 7 || r.x1 != 9 || r.y1 != 12) { ret 6; }
    a.fill_target = FILL_SELECTION;
    a.selected    = true;
    a.area        = space.Box{x0: 3, y0: 4, x1: 9, y1: 8};
    frame_area(?a, ?g, no, no);
    val d: space.Box = fit_box(?a);
    if (d.x0 != 3 || d.x1 != 9 || d.y1 != 8) { ret 5; }
    ret 0;
}

test pick_button__one_button_holds_both_shape_tools_and_switches_between_them {
    var a: App;
    a.tool       = TOOL_DRAW;
    a.shape_tool = TOOL_BOUNDS;
    # the keys take each tool up, and the shapes button follows the last one
    pick_tool(?a, TOOL_WALL);
    if (button_of(a.tool) != SHAPES_BUTTON || !string.str_equals(button_name(?a, SHAPES_BUTTON), "Walls")) { ret 1; }
    pick_button(?a, TOOL_DRAW);
    if (a.tool != TOOL_DRAW) { ret 2; }
    pick_button(?a, SHAPES_BUTTON);
    if (a.tool != TOOL_WALL) { ret 3; }
    # pressed again it takes up the other shape tool
    pick_button(?a, SHAPES_BUTTON);
    if (a.tool != TOOL_BOUNDS || !string.str_equals(button_name(?a, SHAPES_BUTTON), "Bounds")) { ret 4; }
    pick_button(?a, SHAPES_BUTTON);
    if (a.tool != TOOL_WALL) { ret 5; }
    ret 0;
}
