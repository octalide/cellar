# a weighted kernel's birth or survive set as an editable sum list
#
# a wide kernel's sets run to about 1089 sums, too many for a toggle each, so
# the rule section edits them as text like "34-45, 58". without the keyboard
# the field shows the running set, and shows it again whenever the set or the
# greatest sum the kernel reaches changes. typing checks the text at once,
# saying what is wrong with it, and enter applies it when it reads as a set.
# escape, or taking the keyboard away, goes back to the running set.

use kernel: cellar.rules.weighted;
use cellar.ui;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the field and what it shows
# ---
# field: the text
# shown: the set the text was last set from
# most:  the greatest sum the kernel reached when it was set
# dirty: the text is not shown's, being typed or refused
# error: what is wrong with the text, nil for nothing
pub rec SumList {
    field: ui.Field;
    shown: kernel.Sums;
    most:  usize;
    dirty: bool;
    error: str;
}

# whether a typed codepoint belongs in a sum list
fun list_char(cp: u32) bool {
    ret (cp >= '0' && cp <= '9') || cp == '-' || cp == ',' || cp == ' ';
}

# make an empty field, which shows the running set once synced
pub fun init(l: *SumList) {
    ui.field_init(?l.field, kernel.LIST_MAX, list_char);
    l.most  = 0;
    l.dirty = true;
    l.error = nil;
}

# show a set
fun show(l: *SumList, m: *kernel.Sums, most: usize) {
    var b: [kernel.LIST_MAX + 1]u8;
    ui.field_set(?l.field, kernel.list(m, ?b[0]));
    l.shown = @m;
    l.most  = most;
    l.dirty = false;
    l.error = nil;
}

# follow the running set while the field is not being typed in
# ---
# l:    the field
# m:    the running set
# most: the greatest sum the running kernel reaches
pub fun sync(l: *SumList, m: *kernel.Sums, most: usize) {
    if (l.dirty || l.most != most || !kernel.same_sums(?l.shown, m)) { show(l, m, most); }
}

# check the text as it was typed
# ---
# l:    the field
# most: the greatest sum the kernel reaches
pub fun edited(l: *SumList, most: usize) {
    l.dirty = true;
    val r: res[kernel.Sums, str] = kernel.list_parse(ui.field_text(?l.field), most);
    if (sel r.err) { l.error = r.err; }
    or             { l.error = nil; }
}

# read the text as a set, as enter asks
#
# a set that reads is written back as list writes it, and a refused text stays
# as typed with what is wrong.
# ---
# l:    the field
# most: the greatest sum the kernel reaches
# ret:  the set to apply, or none when the text was refused
pub fun enter(l: *SumList, most: usize) opt[kernel.Sums] {
    val r: res[kernel.Sums, str] = kernel.list_parse(ui.field_text(?l.field), most);
    if (sel r.err) {
        l.dirty = true;
        l.error = r.err;
        ret opt[kernel.Sums].none{};
    }
    var got: kernel.Sums = r.ok;
    show(l, ?got, most);
    ret opt[kernel.Sums].some{got};
}
