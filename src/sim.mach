# the simulation: a grid, the active kernel, and the controls that advance,
# edit, and reset it
#
# stepping convolves the kernel footprint over the front buffer with toroidal
# wrap, applies next_state into the back buffer, updates the per-cell age and
# heat fields, then swaps. painting, randomize, and clear edit the front buffer
# directly and keep the aux fields consistent.

use cellar.grid;
use cellar.kernel;
use allo: std.allocator;
use std.allocator.page;
use std.rand;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

# default grid width in cells
pub val DEFAULT_W: usize = 120;
# default grid height in cells
pub val DEFAULT_H: usize = 120;
# live-cell probability randomize uses when none is given
pub val DEFAULT_DENSITY: f32 = 0.30;
# heat a dead cell loses per step, giving fading trails
pub val DECAY: u8 = 12;

# cellular-automaton simulation state
# ---
# grid:       the double-buffered cell grid with aux fields
# kernel:     the active weighted outer-totalistic kernel
# rng:        generator randomize draws from
# generation: completed steps since the last clear or randomize
# running:    1 while auto-stepping, else 0
# preset:     index of the active kernel preset
pub rec Sim {
    grid:       grid.Grid;
    kernel:     kernel.Kernel;
    rng:        rand.Rng;
    generation: u64;
    running:    u8;
    preset:     usize;
}

# allocate the grid and seed the simulation with the default kernel
# ---
# s:   simulation to initialize
# a:   allocator backing the grid
# w:   grid width in cells
# h:   grid height in cells
# ret: ok, or the allocator's refusal
pub fun init(s: *Sim, a: *allo.Allocator, w: usize, h: usize) err[allo.Error] {
    val e: err[allo.Error] = grid.init(?s.grid, a, w, h);
    if (sel e.err) { ret e; }
    s.kernel     = kernel.preset(0);
    s.preset     = 0;
    s.rng        = rand.init();
    s.generation = 0;
    s.running    = 0;
    ret e;
}

# release the simulation's grid
# ---
# s:   simulation to deinitialize
# ret: ok, or the first release the allocator refused
pub fun dnit(s: *Sim) err[allo.Error] {
    ret grid.dnit(?s.grid);
}

# refresh the age and heat of (x, y) for its next state
# ---
# g:  grid carrying the aux fields
# x:  column
# y:  row
# ns: the cell's next state, 0 or 1
fun update_aux(g: *grid.Grid, x: usize, y: usize, ns: u8) {
    if (ns != 0) {
        grid.set_age(g, x, y, grid.age_at(g, x, y) + 1);
        grid.set_heat(g, x, y, 255);
        ret;
    }
    grid.set_age(g, x, y, 0);
    var nh: i32 = grid.heat_at(g, x, y)::i32 - DECAY::i32;
    if (nh < 0) { nh = 0; }
    grid.set_heat(g, x, y, nh::u8);
}

# advance one generation
#
# convolves the kernel into the back buffer, updates the aux fields, then swaps.
# ---
# s: simulation
pub fun step(s: *Sim) {
    val g:     *grid.Grid     = ?s.grid;
    val k:     *kernel.Kernel = ?s.kernel;
    val r:     i64            = k.radius::i64;
    val width: i64            = (2 * k.radius + 1)::i64;
    val w:     i64            = g.w::i64;
    val h:     i64            = g.h::i64;
    var y:     usize          = 0;
    grid.live_reset(g);
    for (y < g.h) {
        var x: usize = 0;
        for (x < g.w) {
            var sum: i32 = 0;
            var dy:  i64 = 0 - r;
            for (dy <= r) {
                var ny: i64 = (y::i64 + dy) % h;
                if (ny < 0) { ny = ny + h; }
                var dx: i64 = 0 - r;
                for (dx <= r) {
                    val wt: i32 = k.weights[((dy + r) * width + (dx + r))::usize];
                    if (wt != 0) {
                        var nx: i64 = (x::i64 + dx) % w;
                        if (nx < 0) { nx = nx + w; }
                        val al: u8 = g.cells[(ny * w + nx)::usize];
                        sum = sum + wt * al::i32;
                    }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            val alive: u8 = grid.get(g, x, y);
            val ns:    u8 = kernel.next_state(k, alive, sum);
            grid.set_back(g, x, y, ns);
            update_aux(g, x, y, ns);
            if (ns != 0 || grid.heat_at(g, x, y) != 0) { grid.live_push(g, y * g.w + x); }
            x = x + 1;
        }
        y = y + 1;
    }
    grid.swap(g);
    s.generation = s.generation + 1;
}

# empty the grid and reset the generation counter
# ---
# s: simulation
pub fun clear(s: *Sim) {
    grid.clear(?s.grid);
    s.generation = 0;
}

# reallocate the grid to a new size, clearing it and resetting the count
#
# a refusal leaves the grid and the count as they were.
# ---
# s:   simulation
# w:   new width in cells
# h:   new height in cells
# ret: ok, or the allocator's refusal
pub fun resize(s: *Sim, w: usize, h: usize) err[allo.Error] {
    val e: err[allo.Error] = grid.resize(?s.grid, w, h);
    if (sel e.err) { ret e; }
    s.generation = 0;
    ret e;
}

# fill the grid with live cells at the given density and reset the count
# ---
# s:       simulation
# density: live-cell probability in [0, 1]
pub fun randomize(s: *Sim, density: f32) {
    val g:      *grid.Grid = ?s.grid;
    var thresh: i64        = (density * 1000.0)::i64;
    if (thresh < 0)    { thresh = 0; }
    if (thresh > 1000) { thresh = 1000; }
    var y: usize = 0;
    for (y < g.h) {
        var x: usize = 0;
        for (x < g.w) {
            var v: u8 = 0;
            if (rand.range(?s.rng, 0, 1000) < thresh) { v = 1; }
            paint(s, x, y, v);
            x = x + 1;
        }
        y = y + 1;
    }
    s.generation = 0;
}

# set the cell at (x, y) to v, keeping its aux fields consistent
# ---
# s: simulation
# x: column; out of range is ignored
# y: row; out of range is ignored
# v: value to write, 0 or 1
pub fun paint(s: *Sim, x: usize, y: usize, v: u8) {
    if (x >= s.grid.w || y >= s.grid.h) { ret; }
    val g:   *grid.Grid = ?s.grid;
    val i:   usize      = y * g.w + x;
    val was: bool       = grid.drawable(g, i);
    grid.set(g, x, y, v);
    if (v != 0) {
        grid.set_age(g, x, y, 1);
        grid.set_heat(g, x, y, 255);
        if (!was) { grid.live_push(g, i); }
        ret;
    }
    grid.set_age(g, x, y, 0);
    grid.set_heat(g, x, y, 0);
    # the index stays listed, and painting it again would list it twice
    if (was) { g.stale = true; }
}

# flip between running and paused
# ---
# s: simulation
pub fun toggle_running(s: *Sim) {
    s.running = 1 - s.running;
}

test step__blinker_oscillates_with_period_two {
    var a: allo.Allocator;
    page.make(?a);

    var s:    Sim;
    val made: err[allo.Error] = init(?s, ?a, 5, 5);
    if (sel made.err) { ret 1; }

    # a horizontal three-cell row at the center
    paint(?s, 1, 2, 1);
    paint(?s, 2, 2, 1);
    paint(?s, 3, 2, 1);

    step(?s);
    if (grid.get(?s.grid, 2, 1) != 1) { ret 2; }
    if (grid.get(?s.grid, 2, 2) != 1) { ret 3; }
    if (grid.get(?s.grid, 2, 3) != 1) { ret 4; }
    if (grid.get(?s.grid, 1, 2) != 0) { ret 5; }

    step(?s);
    if (grid.get(?s.grid, 1, 2) != 1) { ret 6; }
    if (grid.get(?s.grid, 3, 2) != 1) { ret 7; }

    dnit(?s);
    ret 0;
}

test step__age_accumulates_and_heat_decays {
    var a: allo.Allocator;
    page.make(?a);

    var s:     Sim;
    val made2: err[allo.Error] = init(?s, ?a, 5, 5);
    if (sel made2.err) { ret 1; }

    # a block is still life under Life, so its cells stay alive every step
    paint(?s, 1, 1, 1);
    paint(?s, 2, 1, 1);
    paint(?s, 1, 2, 1);
    paint(?s, 2, 2, 1);

    step(?s);
    step(?s);
    if (grid.age_at(?s.grid, 1, 1) != 3)    { ret 2; }
    if (grid.heat_at(?s.grid, 1, 1) != 255) { ret 3; }

    # an isolated cell dies, and its heat decays rather than vanishing
    paint(?s, 4, 4, 1);
    step(?s);
    if (grid.get(?s.grid, 4, 4) != 0)               { ret 4; }
    if (grid.age_at(?s.grid, 4, 4) != 0)            { ret 5; }
    if (grid.heat_at(?s.grid, 4, 4) != 255 - DECAY) { ret 6; }

    dnit(?s);
    ret 0;
}

test step__live_list_holds_exactly_the_drawable_cells {
    var a: allo.Allocator;
    page.make(?a);

    var s:    Sim;
    val made: err[allo.Error] = init(?s, ?a, 6, 6);
    if (sel made.err) { ret 1; }
    paint(?s, 1, 2, 1);
    paint(?s, 2, 2, 1);
    paint(?s, 3, 2, 1);
    if (s.grid.count != 3 || s.grid.stale) { ret 2; }

    # the blinker turns vertical and its two dead ends stay warm
    step(?s);
    if (s.grid.count != 5 || s.grid.stale) { ret 3; }
    var i: usize = 0;
    for (i < s.grid.count) {
        if (!grid.drawable(?s.grid, s.grid.live[i]::usize)) { ret 4; }
        i = i + 1;
    }

    # erasing a listed cell leaves it listed, so the list is marked for a rebuild
    paint(?s, 2, 2, 0);
    if (!s.grid.stale) { ret 5; }
    grid.live_rebuild(?s.grid);
    if (s.grid.count != 4 || s.grid.stale) { ret 6; }

    dnit(?s);
    ret 0;
}
